      const text = document.createElement('span');
      text.className = mini
        ? 'translation-setting-text settings-preference-tile-text d-flex flex-column'
        : 'd-flex flex-column flex-grow-1';
      const title = document.createElement(mini ? 'span' : 'a');
      title.className = mini ? 'translation-setting-title settings-book-tooltip' : 'translation-setting-title';
      const shortName = book.shortName_en || book.name_en || book.alias;
