        if (!currentUser || saving || book.builtinDefault || row.getAttribute('data-translation-disabled') === '1') {
          event.preventDefault();
          return;
        }
        draggedTranslationRow = row;
        dragPreviousSettings = normalizeSettings(currentSettings);
        dragDropped = false;
        row.dataset.dragStartOrder = translationOrderSignature();
        row.classList.add('is-dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', book.alias);
      });
      row.addEventListener('dragend', () => {
        row.classList.remove('is-dragging');
        if (!dragDropped && dragPreviousSettings)
          renderTranslationList(currentTranslationBooks);
        draggedTranslationRow = null;
        dragPreviousSettings = null;
        dragDropped = false;
