<!doctype html>
<html lang="en">

<head>
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (req.admin);
    site.editMode = false;
%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %>

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %>

  <div class="container col-lg-8 mx-auto">
    <main class="search-results">
      <div class="mb-3">
        <h1 class="fs-4 mb-0">My Settings</h1>
        <p class="text-muted small mb-0" id="settings-account-status">Loading account settings...</p>
      </div>
      <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-3">
        <span class="text-muted small">Settings view</span>
        <div class="btn-group btn-group-sm settings-view-toggle" role="group" aria-label="Settings view">
          <button type="button" class="btn btn-outline-secondary" data-settings-view="tile">Tile</button>
          <button type="button" class="btn btn-outline-secondary" data-settings-view="full">Full</button>
        </div>
      </div>

      <section class="border-top pt-3">
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
          <div>
            <h2 class="fs-5 fw-bold mb-1">Quran Translations</h2>
            <p class="text-muted small mb-0" id="settings-translation-status">Loading translation settings...</p>
          </div>
          <button type="button" class="btn btn-outline-secondary btn-sm" id="settings-translation-enable-all">Enable all</button>
        </div>
        <div id="settings-translation-list" class="d-flex flex-column gap-2"></div>
      </section>

      <section class="border-top pt-3 mt-3">
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
          <div>
            <h2 class="fs-5 fw-bold mb-1">Quran Tafsirs</h2>
            <p class="text-muted small mb-0" id="settings-tafsir-status">Loading tafsir settings...</p>
          </div>
          <button type="button" class="btn btn-outline-secondary btn-sm" id="settings-tafsir-enable-all">Enable all</button>
        </div>
        <div id="settings-tafsir-list" class="d-flex flex-column gap-2"></div>
      </section>
    </main>
  </div>

<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

<script>
  (function () {
    const statusEl = document.getElementById('settings-account-status');
    const tafsirStatusEl = document.getElementById('settings-tafsir-status');
    const tafsirListEl = document.getElementById('settings-tafsir-list');
    const enableAllBtn = document.getElementById('settings-tafsir-enable-all');
    const translationStatusEl = document.getElementById('settings-translation-status');
    const translationListEl = document.getElementById('settings-translation-list');
    const translationEnableAllBtn = document.getElementById('settings-translation-enable-all');
    const viewButtons = Array.from(document.querySelectorAll('[data-settings-view]'));
    const SETTINGS_VIEW_KEY = 'hadithdb:settings:view';
    const settingsView = () => currentSettingsView === 'full' ? 'full' : 'tile';
    const readSettingsView = () => {
      try {
        return window.localStorage && window.localStorage.getItem(SETTINGS_VIEW_KEY) === 'full' ? 'full' : 'tile';
      } catch (_err) {
        return 'tile';
      }
    };
    let currentUser = null;
    let currentSettings = {};
    let currentTafsirBooks = [];
    let currentTranslationBooks = [];
    let currentSettingsView = readSettingsView();
    let draggedTafsirRow = null;
    let draggedTranslationRow = null;
    let dragPreviousSettings = null;
    let dragDropped = false;
    let saving = false;

    const settingsCacheUser = () => currentUser
      ? {
        uid: currentUser.uid || currentUser.userId || '',
        email: currentUser.email || ''
      }
      : null;

    const renderSignedOut = () => {
      statusEl.textContent = 'Sign in to view account settings.';
      tafsirStatusEl.textContent = 'Sign in to choose which tafsirs appear on Quran pages.';
      translationStatusEl.textContent = 'Sign in to choose which translations appear on Quran pages.';
      enableAllBtn.disabled = true;
      translationEnableAllBtn.disabled = true;
    };

    const updateSettingsViewControls = () => {
      viewButtons.forEach(button => {
        const active = button.getAttribute('data-settings-view') === settingsView();
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    };

    const waitForHadithAuth = () => new Promise(resolve => {
      if (window.hadithAuth && window.hadithAuth.getToken) return resolve(window.hadithAuth);
      let attempts = 0;
      const timer = window.setInterval(() => {
        attempts += 1;
        if (window.hadithAuth && window.hadithAuth.getToken) {
          window.clearInterval(timer);
          resolve(window.hadithAuth);
        } else if (attempts >= 50) {
          window.clearInterval(timer);
          resolve(null);
        }
      }, 100);
    });

    const normalizeSettings = (settings) => {
      const source = settings && typeof settings === 'object' && !Array.isArray(settings) ? settings : {};
      const tafsirs = source.tafsirs && typeof source.tafsirs === 'object' && !Array.isArray(source.tafsirs)
        ? source.tafsirs
        : {};
      const translations = source.translations && typeof source.translations === 'object' && !Array.isArray(source.translations)
        ? source.translations
        : {};
      const translationDisabledAliases = Array.from(new Set((Array.isArray(translations.disabledAliases) ? translations.disabledAliases : [])
        .map(alias => (alias || '').toString().trim())
        .filter(alias => /^[A-Za-z0-9_-]+$/.test(alias))));
      const translationDisabled = new Set(translationDisabledAliases);
      return {
        ...source,
        tafsirs: {
          disabledAliases: Array.from(new Set((Array.isArray(tafsirs.disabledAliases) ? tafsirs.disabledAliases : [])
            .map(alias => (alias || '').toString().trim())
            .filter(alias => /^[A-Za-z0-9_-]+$/.test(alias)))),
          order: {
            en: Array.from(new Set((tafsirs.order && Array.isArray(tafsirs.order.en) ? tafsirs.order.en : [])
              .map(alias => (alias || '').toString().trim())
              .filter(alias => /^[A-Za-z0-9_-]+$/.test(alias)))),
            ar: Array.from(new Set((tafsirs.order && Array.isArray(tafsirs.order.ar) ? tafsirs.order.ar : [])
              .map(alias => (alias || '').toString().trim())
              .filter(alias => /^[A-Za-z0-9_-]+$/.test(alias))))
          }
        },
        translations: {
          disabledAliases: translationDisabledAliases,
          order: Array.from(new Set((Array.isArray(translations.order) ? translations.order : [])
            .map(alias => (alias || '').toString().trim())
            .filter(alias => /^[A-Za-z0-9_-]+$/.test(alias) && !translationDisabled.has(alias)))),
          preferredAlias: /^[A-Za-z0-9_-]+$/.test((translations.preferredAlias || '').toString().trim())
            ? translations.preferredAlias.toString().trim()
            : ''
        }
      };
    };

    const getOptionalToken = async () => {
      const auth = await waitForHadithAuth();
      return auth && auth.getToken ? auth.getToken() : null;
    };

    const requireSaveToken = async () => {
      const auth = await waitForHadithAuth();
      if (auth && auth.requireToken)
        return auth.requireToken('Please sign in once to refresh your local session.');
      return auth && auth.getToken ? auth.getToken() : null;
    };

    const loadUserSettings = async () => {
      const cacheUser = settingsCacheUser();
      const cachedSettings = window.hadithUserSettingsCache && window.hadithUserSettingsCache.read
        ? window.hadithUserSettingsCache.read(cacheUser)
        : null;
      if (cachedSettings) return normalizeSettings(cachedSettings);
      const token = await getOptionalToken();
      const res = await fetch(quranApiPath('/user-settings'), {
        credentials: 'same-origin',
        headers: token ? { 'Authorization': `Bearer ${token}` } : {}
      });
      if (!res.ok) throw new Error('Unable to load settings.');
      const data = await res.json();
      const settings = normalizeSettings(data.settings || {});
      if (window.hadithUserSettingsCache && window.hadithUserSettingsCache.write)
        window.hadithUserSettingsCache.write(cacheUser, settings);
      return settings;
    };

    const clearCachedUserSettings = async () => {
      const cacheUser = settingsCacheUser();
      if (window.hadithUserSettingsCache && window.hadithUserSettingsCache.clear)
        window.hadithUserSettingsCache.clear(cacheUser);
      window.hadithQuranUserSettingsOverride = null;
      await Promise.all([
        window.clearHadithDomainUserSettingsCache
          ? window.clearHadithDomainUserSettingsCache(cacheUser).catch(() => {})
          : Promise.resolve(null),
        window.clearQuranDomainUserSettingsCache
          ? window.clearQuranDomainUserSettingsCache(cacheUser).catch(() => {})
          : Promise.resolve(null)
      ]);
    };

    const saveSettings = async (options = {}) => {
      const token = await requireSaveToken();
      if (!currentUser)
        throw new Error('Please sign in to save settings.');
      if (!token)
        throw new Error('Please sign in once to refresh your local session.');
      saving = true;
      tafsirStatusEl.textContent = 'Saving tafsir settings...';
      translationStatusEl.textContent = 'Saving translation settings...';
      const settingsToSave = normalizeSettings(currentSettings);
      delete settingsToSave.personalized;
      try {
        const res = await fetch(quranApiPath('/user-settings'), {
          method: 'PUT',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({ settings: settingsToSave })
        });
        if (!res.ok) {
          let message = 'Unable to save settings.';
          try {
            const text = await res.text();
            if (text) {
              try {
                const data = JSON.parse(text);
                if (data && (data.error || data.message)) message = data.error || data.message;
              } catch (_jsonErr) {
                message = text.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() || message;
              }
            }
          } catch (_err) {}
          throw new Error(message);
        }
        const data = await res.json();
        currentSettings = normalizeSettings(data.settings || settingsToSave);
        if (options.invalidateSessionCache) {
          await clearCachedUserSettings();
        } else if (window.updateCachedQuranUserSettings)
          window.updateCachedQuranUserSettings(currentUser, currentSettings);
        else {
          const cacheUser = settingsCacheUser();
          if (window.hadithUserSettingsCache && window.hadithUserSettingsCache.write)
            window.hadithUserSettingsCache.write(cacheUser, currentSettings);
          if (window.writeQuranDomainUserSettingsCache)
            window.writeQuranDomainUserSettingsCache(cacheUser, currentSettings).catch(() => {});
        }
      } finally {
        saving = false;
        updateTafsirStatus();
        updateTranslationStatus();
      }
    };

    const updateTafsirStatus = () => {
      const total = tafsirListEl.querySelectorAll('[data-tafsir-setting-toggle]').length;
      const disabled = currentSettings.tafsirs.disabledAliases.length;
      if (!currentUser) {
        tafsirStatusEl.textContent = 'Sign in to choose which tafsirs appear on Quran pages.';
        enableAllBtn.disabled = true;
        return;
      }
      tafsirStatusEl.textContent = total
        ? `${total - disabled} of ${total} tafsirs enabled on Quran pages.`
        : 'No tafsirs are available.';
      enableAllBtn.disabled = !currentUser || disabled === 0 || saving;
    };

    const updateTranslationStatus = () => {
      const total = translationListEl.querySelectorAll('[data-translation-setting-toggle]').length;
      const disabled = currentSettings.translations.disabledAliases.length;
      if (!currentUser) {
        translationStatusEl.textContent = 'Sign in to choose which translations appear on Quran pages.';
        translationEnableAllBtn.disabled = true;
        return;
      }
      translationStatusEl.textContent = total
        ? `${total - disabled} of ${total} translations enabled.`
        : 'No translations are available.';
      translationEnableAllBtn.disabled = !currentUser || disabled === 0 || saving;
    };

    const orderedBooks = (books, lang) => {
      let order = currentSettings.tafsirs.order[lang] || [];
      const disabled = new Set(currentSettings.tafsirs.disabledAliases || []);
      if (lang === 'ar' && order.length < 1) {
        order = [
          'en-tafsir-jalalayn',
          'en-tafsir-mokhtasar',
          'en-tafsir-ibn-kathir'
        ];
      }
      const index = new Map(order.map((alias, idx) => [alias, idx]));
      const deathYear = (book) => {
        const match = (book.death || '').toString().match(/\d+/);
        return match ? Number(match[0]) : NaN;
      };
      return books
        .filter(book => book.lang === lang)
        .map((book, originalIndex) => ({ book, originalIndex }))
        .sort((a, b) => {
          const aDisabled = disabled.has(a.book.alias);
          const bDisabled = disabled.has(b.book.alias);
          if (aDisabled !== bDisabled) return aDisabled ? 1 : -1;
          const aIndex = index.has(a.book.alias) ? index.get(a.book.alias) : Number.MAX_SAFE_INTEGER;
          const bIndex = index.has(b.book.alias) ? index.get(b.book.alias) : Number.MAX_SAFE_INTEGER;
          if (aIndex !== bIndex) return aIndex - bIndex;
          const aDeath = deathYear(a.book);
          const bDeath = deathYear(b.book);
          const aHasDeath = Number.isFinite(aDeath) && aDeath > 0;
          const bHasDeath = Number.isFinite(bDeath) && bDeath > 0;
          if (aHasDeath && bHasDeath && aDeath !== bDeath) return aDeath - bDeath;
          if (aHasDeath !== bHasDeath) return aHasDeath ? -1 : 1;
          return a.originalIndex - b.originalIndex;
        })
        .map(entry => entry.book);
    };

    const orderedTranslations = (books) => {
      const order = currentSettings.translations.order || [];
      const disabled = new Set(currentSettings.translations.disabledAliases || []);
      const index = new Map(order.map((alias, idx) => [alias, idx]));
      return books
        .map((book, originalIndex) => ({ book, originalIndex }))
        .sort((a, b) => {
          const aDisabled = disabled.has(a.book.alias);
          const bDisabled = disabled.has(b.book.alias);
          if (aDisabled !== bDisabled) return aDisabled ? 1 : -1;
          const aIndex = index.has(a.book.alias) ? index.get(a.book.alias) : Number.MAX_SAFE_INTEGER;
          const bIndex = index.has(b.book.alias) ? index.get(b.book.alias) : Number.MAX_SAFE_INTEGER;
          if (aIndex !== bIndex) return aIndex - bIndex;
          const ordinal = Number(a.book.ordinal || 0) - Number(b.book.ordinal || 0);
          if (ordinal !== 0) return ordinal;
          return a.originalIndex - b.originalIndex;
        })
        .map(entry => entry.book);
    };

    let defaultTranslationBook = {
      alias: '',
      shortName_en: 'Abdel Haleem',
      name_en: 'Abdel Haleem Translation',
      author_en: 'M. A. S. Abdel Haleem',
      builtinDefault: true
    };

    const updateOrderFromDom = () => {
      const disabled = new Set(currentSettings.tafsirs.disabledAliases || []);
      currentSettings = normalizeSettings({
        ...currentSettings,
        tafsirs: {
          ...currentSettings.tafsirs,
          order: {
            en: Array.from(tafsirListEl.querySelectorAll('[data-tafsir-setting-row][data-tafsir-lang="en"]'))
              .map(row => row.getAttribute('data-tafsir-alias'))
              .filter(alias => alias && !disabled.has(alias)),
            ar: Array.from(tafsirListEl.querySelectorAll('[data-tafsir-setting-row][data-tafsir-lang="ar"]'))
              .map(row => row.getAttribute('data-tafsir-alias'))
              .filter(alias => alias && !disabled.has(alias))
          }
        }
      });
    };

    const updateTranslationOrderFromDom = () => {
      const disabled = new Set(currentSettings.translations.disabledAliases || []);
      currentSettings = normalizeSettings({
        ...currentSettings,
        translations: {
          ...currentSettings.translations,
          order: Array.from(translationListEl.querySelectorAll('[data-translation-setting-row]:not([data-translation-builtin])'))
            .map(row => row.getAttribute('data-translation-alias'))
            .filter(alias => alias && !disabled.has(alias))
        }
      });
    };

    const saveTafsirOrder = async (previousSettings) => {
      updateOrderFromDom();
      try {
        await saveSettings({ invalidateSessionCache: true });
      } catch (err) {
        currentSettings = previousSettings;
        renderTafsirList(currentTafsirBooks);
        if (window.toastr) toastr.error(err.message || 'Unable to save tafsir order.', 'Settings');
      }
    };

    const saveTranslationOrder = async (previousSettings) => {
      updateTranslationOrderFromDom();
      try {
        await saveSettings({ invalidateSessionCache: true });
      } catch (err) {
        currentSettings = previousSettings;
        renderTranslationList(currentTranslationBooks);
        if (window.toastr) toastr.error(err.message || 'Unable to save translation order.', 'Settings');
      }
    };

    const orderSignature = () => JSON.stringify({
      en: Array.from(tafsirListEl.querySelectorAll('[data-tafsir-setting-row][data-tafsir-lang="en"]'))
        .filter(row => row.getAttribute('data-tafsir-disabled') !== '1')
        .map(row => row.getAttribute('data-tafsir-alias')),
      ar: Array.from(tafsirListEl.querySelectorAll('[data-tafsir-setting-row][data-tafsir-lang="ar"]'))
        .filter(row => row.getAttribute('data-tafsir-disabled') !== '1')
        .map(row => row.getAttribute('data-tafsir-alias'))
    });

    const translationOrderSignature = () => JSON.stringify(
      Array.from(translationListEl.querySelectorAll('[data-translation-setting-row]:not([data-translation-builtin])'))
        .filter(row => row.getAttribute('data-translation-disabled') !== '1')
        .map(row => row.getAttribute('data-translation-alias'))
    );

    const dropTargetFor = (list, x, y, selector) => {
      const rows = Array.from(list.querySelectorAll(`${selector}:not(.is-dragging)`));
      if (list.classList.contains('settings-preference-list-mini')) {
        let sameRow = false;
        for (const row of rows) {
          const box = row.getBoundingClientRect();
          if (y >= box.top && y <= box.bottom) {
            sameRow = true;
            if (x < box.left + (box.width / 2)) return row;
            continue;
          }
          if (sameRow && y < box.top) return row;
          if (!sameRow && y < box.top + (box.height / 2)) return row;
        }
        return null;
      }
      return rows.reduce((closest, row) => {
        const box = row.getBoundingClientRect();
        const offset = y - box.top - (box.height / 2);
        if (offset < 0 && offset > closest.offset) return { offset, row };
        return closest;
      }, { offset: Number.NEGATIVE_INFINITY, row: null }).row;
    };

    const bindTafsirDragList = (list, lang) => {
      list.addEventListener('dragover', event => {
        if (!draggedTafsirRow || draggedTafsirRow.getAttribute('data-tafsir-lang') !== lang) return;
        event.preventDefault();
        const target = dropTargetFor(list, event.clientX, event.clientY, '[data-tafsir-setting-row]:not([data-tafsir-disabled="1"])');
        if (target) list.insertBefore(draggedTafsirRow, target);
        else {
          const firstDisabled = list.querySelector('[data-tafsir-setting-row][data-tafsir-disabled="1"]');
          if (firstDisabled) list.insertBefore(draggedTafsirRow, firstDisabled);
          else list.appendChild(draggedTafsirRow);
        }
      });
      list.addEventListener('drop', async event => {
        if (!draggedTafsirRow || draggedTafsirRow.getAttribute('data-tafsir-lang') !== lang) return;
        event.preventDefault();
        dragDropped = true;
        if (draggedTafsirRow.dataset.dragStartOrder !== orderSignature())
          await saveTafsirOrder(dragPreviousSettings || normalizeSettings(currentSettings));
      });
    };

    const bindTranslationDragList = (list) => {
      list.addEventListener('dragover', event => {
        if (!draggedTranslationRow) return;
        event.preventDefault();
        const target = dropTargetFor(list, event.clientX, event.clientY, '[data-translation-setting-row]:not([data-translation-builtin]):not([data-translation-disabled="1"])');
        if (target) list.insertBefore(draggedTranslationRow, target);
        else {
          const firstDisabled = list.querySelector('[data-translation-setting-row][data-translation-disabled="1"]');
          if (firstDisabled) list.insertBefore(draggedTranslationRow, firstDisabled);
          else list.appendChild(draggedTranslationRow);
        }
      });
      list.addEventListener('drop', async event => {
        if (!draggedTranslationRow) return;
        event.preventDefault();
        dragDropped = true;
        if (draggedTranslationRow.dataset.dragStartOrder !== translationOrderSignature())
          await saveTranslationOrder(dragPreviousSettings || normalizeSettings(currentSettings));
      });
    };

    const tafsirSizeLabel = (size) => {
      if (size === 'lg') return 'Large tafsir';
      if (size === 'md') return 'Medium tafsir';
      if (size === 'sm') return 'Small tafsir';
      return '';
    };

    const renderTafsirSizeIndicator = (book) => {
      const size = (book && book.size || '').toString();
      const label = tafsirSizeLabel(size);
      if (!label) return null;
      const indicator = document.createElement('span');
      indicator.className = `tafsir-size-indicator tafsir-size-tooltip tafsir-size-indicator-${size}`;
      indicator.title = label;
      indicator.setAttribute('data-tafsir-size-tooltip', label);
      indicator.setAttribute('aria-label', label);
      indicator.setAttribute('role', 'img');
      return indicator;
    };

    const settingBookTooltip = (book, deathSuffix) => {
      const title = book && (book.name_en || book.title || book.shortName_en || book.shortName || book.alias);
      const author = book && (book.author_en || book.author);
      return [
        title,
        author,
        settingBookDeathLabel(book, deathSuffix),
        book && book.published_year ? `Pub. ${book.published_year}` : '',
        book && book.publisher
      ].filter(Boolean).join('\n');
    };

    const settingBookDeathLabel = (book, suffix) => {
      let death = (book && book.death || '').toString().trim();
      if (!death) return '';
      if (suffix && !/\b(?:AH|CE|H)\b/i.test(death) && !/هـ/u.test(death))
        death = `${death} ${suffix}`;
      return /^d\./i.test(death) ? death : `d. ${death}`;
    };

    const settingBookMeta = (book, shortName, deathSuffix) => {
      const longName = book && (book.name_en || book.title || '');
      return [
        longName && longName !== shortName ? longName : '',
        book && (book.author_en || book.author),
        settingBookDeathLabel(book, deathSuffix),
        book && book.published_year ? `Pub. ${book.published_year}` : '',
        book && book.publisher
      ].filter(Boolean).join(', ');
    };

    const tafsirSettingsSlug = (book) => {
      return (book && (book.slug || book.alias) || '').toString().replace(/^(?:(?:en|ar)-)?(?:tafsir-)?/, '');
    };

    const tafsirSettingsHref = (book) => {
      const slug = tafsirSettingsSlug(book);
      if (!slug) return '';
      const hasLanguageCollision = currentTafsirBooks.some(other => {
        return other && other !== book && other.lang !== book.lang && tafsirSettingsSlug(other) === slug;
      });
      const query = hasLanguageCollision && (book.lang === 'ar' || book.lang === 'en')
        ? `?lang=${encodeURIComponent(book.lang)}`
        : '';
      return quranUrl(`/quran/tafsir/${encodeURIComponent(slug)}${query}`);
    };

    const translationSettingsHref = (book) => {
      const alias = (book && book.alias || '').toString();
      const query = alias ? `?translation=${encodeURIComponent(alias)}` : '';
      return quranUrl(`/quran/translations/1/1${query}`);
    };

    const translationPreferenceAlias = (book) => {
      return book && book.source === 'default' ? '' : (book && book.alias || '').toString();
    };

    const renderTranslationPreferenceButton = (book, isDisabled, label) => {
      const alias = translationPreferenceAlias(book);
      const isPreferred = (currentSettings.translations.preferredAlias || '') === alias;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = `translation-preference-heart btn btn-link p-0${isPreferred ? ' is-preferred' : ''}`;
      button.innerHTML = `<i class="bi ${isPreferred ? 'bi-heart-fill' : 'bi-heart'}" aria-hidden="true"></i>`;
      button.title = isPreferred
        ? `${label} is the default hero translation`
        : `Use ${label} as the default hero translation`;
      button.setAttribute('aria-label', button.title);
      button.setAttribute('aria-pressed', isPreferred ? 'true' : 'false');
      button.disabled = !currentUser || saving || isDisabled;
      button.addEventListener('mousedown', event => event.stopPropagation());
      button.addEventListener('click', async event => {
        event.preventDefault();
        event.stopPropagation();
        if (button.disabled) return;
        const previousSettings = normalizeSettings(currentSettings);
        currentSettings = normalizeSettings({
          ...currentSettings,
          translations: { ...currentSettings.translations, preferredAlias: alias }
        });
        updateTranslationStatus();
        renderTranslationList(currentTranslationBooks);
        try {
          await saveSettings();
          renderTranslationList(currentTranslationBooks);
        } catch (err) {
          currentSettings = previousSettings;
          renderTranslationList(currentTranslationBooks);
          if (window.toastr) toastr.error(err.message || 'Unable to save default translation.', 'Settings');
        }
      });
      return button;
    };

    const renderTafsirRow = (book, disabled) => {
      const row = document.createElement('div');
      const isDisabled = disabled.has(book.alias);
      const mini = settingsView() === 'tile';
      row.className = mini
        ? 'tafsir-setting-row settings-preference-tile d-flex flex-column gap-2'
        : 'tafsir-setting-row d-flex align-items-start justify-content-between gap-3 border-bottom py-2';
      row.draggable = !!currentUser && !book.builtinDefault && !isDisabled;
      row.setAttribute('data-tafsir-setting-row', '1');
      row.setAttribute('data-tafsir-lang', book.lang);
      row.setAttribute('data-tafsir-alias', book.alias);
      row.setAttribute('data-tafsir-disabled', isDisabled ? '1' : '0');
      row.classList.toggle('is-disabled', isDisabled);
      row.addEventListener('dragstart', event => {
        if (!currentUser || saving || book.builtinDefault || row.getAttribute('data-tafsir-disabled') === '1') {
          event.preventDefault();
          return;
        }
        draggedTafsirRow = row;
        dragPreviousSettings = normalizeSettings(currentSettings);
        dragDropped = false;
        row.dataset.dragStartOrder = orderSignature();
        row.classList.add('is-dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', book.alias);
      });
      row.addEventListener('dragend', () => {
        row.classList.remove('is-dragging');
        if (!dragDropped && dragPreviousSettings)
          renderTafsirList(currentTafsirBooks);
        draggedTafsirRow = null;
        dragPreviousSettings = null;
        dragDropped = false;
      });

      const text = document.createElement('span');
      text.className = mini
        ? 'translation-setting-text settings-preference-tile-text d-flex flex-column'
        : 'translation-setting-text d-flex flex-column flex-grow-1';
      const title = document.createElement(mini ? 'span' : 'a');
      title.className = mini ? 'translation-setting-title settings-book-tooltip' : 'translation-setting-title';
      const shortName = book.shortName_en || book.shortName || book.author_en || book.author || book.alias;
      title.textContent = shortName;
      if (mini) {
        title.setAttribute('data-settings-book-tooltip', settingBookTooltip(book, 'AH'));
        title.tabIndex = 0;
      } else {
        title.href = tafsirSettingsHref(book);
      }
      const sizeIndicator = renderTafsirSizeIndicator(book);
      if (sizeIndicator)
        title.appendChild(sizeIndicator);
      const meta = document.createElement('small');
      meta.className = 'text-muted';
      meta.textContent = settingBookMeta(book, shortName, 'AH');
      text.appendChild(title);
      if (!mini)
        text.appendChild(meta);

      const controls = document.createElement('span');
      controls.className = mini
        ? 'translation-setting-controls settings-preference-tile-controls d-flex align-items-center justify-content-between gap-2'
        : 'translation-setting-controls d-flex align-items-center gap-2';

      const dragHandle = document.createElement('span');
      dragHandle.className = 'tafsir-setting-drag-handle text-muted';
      dragHandle.title = 'Drag to reorder';
      dragHandle.innerHTML = '<i class="bi bi-grip-vertical" aria-hidden="true"></i>';

      const toggle = document.createElement('input');
      toggle.type = 'checkbox';
      toggle.className = 'form-check-input';
      toggle.setAttribute('role', 'switch');
      toggle.setAttribute('aria-label', `Enable ${shortName}`);
      toggle.checked = !isDisabled;
      toggle.disabled = !currentUser || book.builtinDefault;
      toggle.setAttribute('data-tafsir-setting-toggle', book.alias);
      toggle.addEventListener('change', async () => {
        const previousSettings = normalizeSettings(currentSettings);
        const disabledAliases = new Set(currentSettings.tafsirs.disabledAliases);
        if (toggle.checked) disabledAliases.delete(book.alias);
        else disabledAliases.add(book.alias);
        const order = {
          en: Array.from(tafsirListEl.querySelectorAll('[data-tafsir-setting-row][data-tafsir-lang="en"]'))
            .map(row => row.getAttribute('data-tafsir-alias'))
            .filter(alias => alias && !disabledAliases.has(alias)),
          ar: Array.from(tafsirListEl.querySelectorAll('[data-tafsir-setting-row][data-tafsir-lang="ar"]'))
            .map(row => row.getAttribute('data-tafsir-alias'))
            .filter(alias => alias && !disabledAliases.has(alias))
        };
        currentSettings = normalizeSettings({
          ...currentSettings,
          tafsirs: { ...currentSettings.tafsirs, disabledAliases: Array.from(disabledAliases), order }
        });
        updateTafsirStatus();
        renderTafsirList(currentTafsirBooks);
        try {
          await saveSettings();
        } catch (err) {
          if (window.toastr) toastr.error(err.message || 'Unable to save tafsir settings.', 'Settings');
          currentSettings = previousSettings;
          renderTafsirList(currentTafsirBooks);
        }
      });

      const toggleWrap = document.createElement('span');
      toggleWrap.className = 'form-check form-switch m-0';
      toggleWrap.appendChild(toggle);

      controls.appendChild(dragHandle);
      controls.appendChild(toggleWrap);
      row.appendChild(text);
      row.appendChild(controls);
      return row;
    };

    const renderTranslationRow = (book, disabled) => {
      const row = document.createElement('div');
      const isDisabled = disabled.has(book.alias);
      const mini = settingsView() === 'tile';
      row.className = mini
        ? 'tafsir-setting-row settings-preference-tile d-flex flex-column gap-2'
        : 'tafsir-setting-row d-flex align-items-start justify-content-between gap-3 border-bottom py-2';
      row.draggable = !!currentUser && !book.builtinDefault && !isDisabled;
      row.setAttribute('data-translation-setting-row', '1');
      row.setAttribute('data-translation-alias', book.alias);
      row.setAttribute('data-translation-disabled', isDisabled ? '1' : '0');
      row.classList.toggle('is-disabled', isDisabled);
      if (book.builtinDefault)
        row.setAttribute('data-translation-builtin', '1');
      row.addEventListener('dragstart', event => {
        if (!currentUser || saving || book.builtinDefault || row.getAttribute('data-translation-disabled') === '1') {
          event.preventDefault();
          return;
        }
        draggedTranslationRow = row;
        dragPreviousSettings = normalizeSettings(currentSettings);
        dragDropped = false;
        row.dataset.dragStartOrder = translationOrderSignature();
        row.classList.add('is-dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', book.alias);
      });
      row.addEventListener('dragend', () => {
        row.classList.remove('is-dragging');
        if (!dragDropped && dragPreviousSettings)
          renderTranslationList(currentTranslationBooks);
        draggedTranslationRow = null;
        dragPreviousSettings = null;
        dragDropped = false;
      });

      const text = document.createElement('span');
      text.className = mini
        ? 'translation-setting-text settings-preference-tile-text d-flex flex-column'
        : 'd-flex flex-column flex-grow-1';
      const title = document.createElement(mini ? 'span' : 'a');
      title.className = mini ? 'translation-setting-title settings-book-tooltip' : 'translation-setting-title';
      const shortName = book.shortName_en || book.name_en || book.alias;
      title.textContent = shortName;
      if (mini) {
        title.setAttribute('data-settings-book-tooltip', settingBookTooltip(book, 'CE'));
        title.tabIndex = 0;
      } else {
        title.href = translationSettingsHref(book);
      }
      const meta = document.createElement('small');
      meta.className = 'translation-setting-author text-muted';
      meta.textContent = settingBookMeta(book, shortName, 'CE');
      text.appendChild(title);
      if (!mini)
        text.appendChild(meta);

      const controls = document.createElement('span');
      controls.className = mini
        ? 'translation-setting-controls settings-preference-tile-controls d-flex align-items-center justify-content-between gap-2'
        : 'd-flex align-items-center gap-2';

      const dragHandle = document.createElement('span');
      dragHandle.className = 'tafsir-setting-drag-handle text-muted';
      dragHandle.title = 'Drag to reorder';
      dragHandle.innerHTML = '<i class="bi bi-grip-vertical" aria-hidden="true"></i>';

      const toggle = document.createElement('input');
      toggle.type = 'checkbox';
      toggle.className = 'form-check-input';
      toggle.setAttribute('role', 'switch');
      toggle.setAttribute('aria-label', `Enable ${title.textContent}`);
      toggle.checked = !isDisabled;
      toggle.disabled = !currentUser || book.builtinDefault;
      toggle.setAttribute('data-translation-setting-toggle', book.alias);
      toggle.addEventListener('change', async () => {
        const previousSettings = normalizeSettings(currentSettings);
        const disabledAliases = new Set(currentSettings.translations.disabledAliases);
        if (toggle.checked) disabledAliases.delete(book.alias);
        else disabledAliases.add(book.alias);
        const preferredAlias = disabledAliases.has(currentSettings.translations.preferredAlias) ? '' : currentSettings.translations.preferredAlias;
        const order = Array.from(translationListEl.querySelectorAll('[data-translation-setting-row]:not([data-translation-builtin])'))
          .map(row => row.getAttribute('data-translation-alias'))
          .filter(alias => alias && !disabledAliases.has(alias));
        currentSettings = normalizeSettings({
          ...currentSettings,
          translations: { ...currentSettings.translations, disabledAliases: Array.from(disabledAliases), order, preferredAlias }
        });
        updateTranslationStatus();
        renderTranslationList(currentTranslationBooks);
        try {
          await saveSettings();
        } catch (err) {
          currentSettings = previousSettings;
          renderTranslationList(currentTranslationBooks);
          if (window.toastr) toastr.error(err.message || 'Unable to save translation settings.', 'Settings');
        }
      });

      if (!book.builtinDefault)
        controls.appendChild(dragHandle);
      controls.appendChild(renderTranslationPreferenceButton(book, isDisabled, shortName));
      const toggleWrap = document.createElement('span');
      toggleWrap.className = 'form-check form-switch m-0';
      toggleWrap.appendChild(toggle);

      controls.appendChild(toggleWrap);
      row.appendChild(text);
      row.appendChild(controls);
      return row;
    };

    const renderSettingsSubsection = (section, id, title) => {
      const heading = document.createElement('h3');
      heading.className = 'fs-6 fw-bold mb-2';

      const toggle = document.createElement('button');
      toggle.className = 'book-catalog-section-toggle settings-subsection-toggle';
      toggle.type = 'button';
      toggle.setAttribute('data-bs-toggle', 'collapse');
      toggle.setAttribute('data-bs-target', `#${id}`);
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-controls', id);

      const icon = document.createElement('i');
      icon.className = 'bi bi-chevron-down';
      icon.setAttribute('aria-hidden', 'true');

      const text = document.createElement('span');
      text.textContent = title;

      toggle.appendChild(icon);
      toggle.appendChild(text);
      heading.appendChild(toggle);
      section.appendChild(heading);

      const body = document.createElement('div');
      body.id = id;
      body.className = 'collapse show';
      section.appendChild(body);
      return body;
    };

    const renderTafsirList = (books) => {
      currentTafsirBooks = books;
      const disabled = new Set(currentSettings.tafsirs.disabledAliases);
      tafsirListEl.innerHTML = '';
      [
        { lang: 'en', title: 'English Tafsirs' },
        { lang: 'ar', title: 'Arabic Tafsirs' }
      ].forEach(group => {
        const groupBooks = orderedBooks(books, group.lang);
        if (!groupBooks.length) return;
        const section = document.createElement('section');
        section.className = 'mb-3';
        const body = renderSettingsSubsection(section, `settings-tafsir-${group.lang}`, group.title);
        const list = document.createElement('div');
        list.className = settingsView() === 'tile'
          ? 'settings-preference-list settings-preference-list-mini'
          : 'settings-preference-list settings-preference-list-full d-flex flex-column';
        list.setAttribute('data-tafsir-setting-list', group.lang);
        groupBooks.forEach(book => list.appendChild(renderTafsirRow(book, disabled)));
        bindTafsirDragList(list, group.lang);
        body.appendChild(list);
        tafsirListEl.appendChild(section);
      });
      updateTafsirStatus();
    };

    const renderTranslationList = (books) => {
      currentTranslationBooks = books;
      const disabled = new Set(currentSettings.translations.disabledAliases);
      translationListEl.innerHTML = '';
      const section = document.createElement('section');
      section.className = 'mb-3';
      const body = renderSettingsSubsection(section, 'settings-translations-en', 'English Translations');
      const list = document.createElement('div');
      list.className = settingsView() === 'tile'
        ? 'settings-preference-list settings-preference-list-mini'
        : 'settings-preference-list settings-preference-list-full d-flex flex-column';
      list.appendChild(renderTranslationRow(defaultTranslationBook, disabled));
      orderedTranslations(books.filter(book => book.source !== 'default')).forEach(book => list.appendChild(renderTranslationRow(book, disabled)));
      bindTranslationDragList(list);
      body.appendChild(list);
      translationListEl.appendChild(section);
      updateTranslationStatus();
    };

    const renderSettings = async () => {
      const auth = await waitForHadithAuth();
      currentUser = auth && auth.getUser ? await auth.getUser() : null;
      if (!currentUser) {
        renderSignedOut();
        currentSettings = normalizeSettings({});
      } else {
        statusEl.textContent = currentUser.email || currentUser.displayName || 'Signed in';
        currentSettings = await loadUserSettings();
      }

      try {
        const res = await fetch(quranApiPath('/proxy/tafsir/books'));
        if (!res.ok) throw new Error('Unable to load tafsir list.');
        const books = await res.json();
        renderTafsirList(books);
      } catch (err) {
        tafsirStatusEl.textContent = err.message || 'Unable to load tafsir settings.';
        if (window.toastr) toastr.error(tafsirStatusEl.textContent, 'Settings');
      }

      try {
        const res = await fetch(quranApiPath('/proxy/translations/books'));
        if (!res.ok) throw new Error('Unable to load translation list.');
        const books = await res.json();
        const defaultBook = (Array.isArray(books) ? books : []).find(book => book && book.source === 'default');
        if (defaultBook)
          defaultTranslationBook = { ...defaultBook, alias: '', builtinDefault: true };
        renderTranslationList(books);
      } catch (err) {
        translationStatusEl.textContent = err.message || 'Unable to load translation settings.';
        if (window.toastr) toastr.error(translationStatusEl.textContent, 'Settings');
      }
    };

    if (enableAllBtn) {
      enableAllBtn.addEventListener('click', async () => {
        if (!currentUser) {
          renderSignedOut();
          return;
        }
        currentSettings = normalizeSettings({
          ...currentSettings,
          tafsirs: { ...currentSettings.tafsirs, disabledAliases: [] }
        });
        renderTafsirList(currentTafsirBooks);
        updateTafsirStatus();
        try {
          await saveSettings();
        } catch (err) {
          if (window.toastr) toastr.error(err.message || 'Unable to save tafsir settings.', 'Settings');
        }
      });
    }

    if (translationEnableAllBtn) {
      translationEnableAllBtn.addEventListener('click', async () => {
        if (!currentUser) {
          renderSignedOut();
          return;
        }
        currentSettings = normalizeSettings({
          ...currentSettings,
          translations: { ...currentSettings.translations, disabledAliases: [] }
        });
        renderTranslationList(currentTranslationBooks);
        updateTranslationStatus();
        try {
          await saveSettings();
        } catch (err) {
          if (window.toastr) toastr.error(err.message || 'Unable to save translation settings.', 'Settings');
        }
      });
    }

    viewButtons.forEach(button => {
      button.addEventListener('click', () => {
        const nextView = button.getAttribute('data-settings-view') === 'full' ? 'full' : 'tile';
        if (nextView === currentSettingsView) return;
        currentSettingsView = nextView;
        try {
          if (window.localStorage)
            window.localStorage.setItem(SETTINGS_VIEW_KEY, currentSettingsView);
        } catch (_err) {}
        updateSettingsViewControls();
        renderTafsirList(currentTafsirBooks);
        renderTranslationList(currentTranslationBooks);
      });
    });

    const load = async () => {
      try {
        updateSettingsViewControls();
        await renderSettings();
      } catch (err) {
        renderSignedOut();
        tafsirStatusEl.textContent = err.message || 'Unable to load settings.';
        translationStatusEl.textContent = err.message || 'Unable to load settings.';
        return;
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', load);
    } else {
      load();
    }
  })();
</script>

</body>
</html>
