<!doctype html>
<html lang="en">

<head>
  <%
    var site = Object.assign({}, global.settings.site);
    var isSearchResultsPage = (q && q != '');
    var isQuranSearchProxy = locals.quranSearchProxy || locals.searchAction === '/quran';
    site.admin = (req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;
    if (isSearchResultsPage)
      site.editMode = false;
    
    var page = {
        menu: 'Search'
    };
    if (q) {
        page.menu = 'Search';
        page.title_en = `${isQuranSearchProxy ? 'Quran Unlocked' : site.shortName} | Search Results for [${q}]`;
        page.title = '';
        page.subtitle_en = 'Search Results';
        page.subtitle = '';
    } else if (results.length > 0 && typeof book !== 'undefined') {
        page.canonical = `/${book.alias}:${results[0].num}`;
        var pageTitlePrefix = book.alias === 'quran' ? site.shortName : utils.hadithBookTitle(book);
        page.title_en = `${pageTitlePrefix} | ${book.shortName_en} (${book.shortName}) ${book.alias}:${results[0].num}`;
        if (results[0].title_en)
          page.title_en = `${pageTitlePrefix} | ${book.alias}:${results[0].num} ${results[0].title_en}`;
        page.title = `${book.title} ${results[0].num_ar}`;
        page.subtitle_en = `${book.shortName_en}`;
        page.subtitle = `${book.shortName}`;
    } else {
      page.title_en = `${site.shortName}`;
      page.title = '';
      page.subtitle_en = 'Home';
      page.subtitle = '';
    }

    page.context = {
      fromSearch: isSearchResultsPage,
      quranSearchProxy: isQuranSearchProxy
    };
    if (typeof book !== 'undefined') {
      page.context.book = book;
      if (book.alias === 'quran' && req.query.ayat !== undefined)
        page.noindex = true;
    }
    if (typeof chapter !== 'undefined')
      page.context.chapter = chapter;
    var displayResultCount = (typeof totalResults !== 'undefined' && totalResults > 0) ? totalResults : results.length;
    if (utils.isFalsey(q) && results.length > 0) {
      page.context.chapter = results[0].chapter;
      page.context.section = results[0].section;
      page.context.hadiths = results;
      if (results[0].prev_ref)
          page.prev = `/${results[0].prev_ref}`;
      if (results[results.length-1].next_ref)
          page.next = `/${results[results.length-1].next_ref}`;
    } else if (results.length > 0) {
      var searchAction = locals.searchAction || '/';
      function searchResultsPath(offset) {
        var params = new URLSearchParams();
        params.append('q', q);
        (Array.isArray(b) ? b : [b]).filter(Boolean).forEach(function (filter) {
          params.append('b', filter);
        });
        (locals.tafsirFilters || []).forEach(function (tafsirAlias) {
          params.append('tafsir', tafsirAlias);
        });
        params.append('o', offset);
        return `${searchAction}?${params.toString()}`;
      }
      if (results.prev) {
        if (results.prev != '0' && results.prev != 0)
          page.prev = searchResultsPath(results.prev);
      }
      if (results.next)
        page.next = searchResultsPath(results.next);
    }
%>
  
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
  
</head>

<body>
  
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  
  <div class="container col-lg-8 mx-auto">
    
    <main class="search-results">
      
      <form class="form-group" action="<%= locals.searchAction || '/' %>">
        <search class="search container pt-3 mb-3">
          <div class="row justify-content-md-center">
            <div class="col-md-8">
              
              <% var showSearchFilterPills = q && (locals.searchFilterPills || []).length > 0; %>
              <div class="input-group mb-1">
                <input role="search" id="search-bar" name="q" type="text" class="search-bar form-control" value="<%= q %>" placeholder="<%= isQuranSearchProxy ? 'Search the Qurʿān or tafāsīr...' : 'Search hadīth...' %>">
                <button class="btn btn-outline-secondary dropdown-toggle search-filter-toggle" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-search-filter-toggle>
                  <span class="search-filter-icon-wrap">
                    <i class="bi bi-book"></i>
                    <span class="search-filter-count-badge badge rounded-pill d-none" data-search-filter-count>0</span>
                  </span>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                  <% if (isQuranSearchProxy) { %>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="quran" <%=(b.indexOf('quran') >= 0) ? 'checked' : ''%>>
                    <label class="form-check-label">Quran</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="tafsir" <%= (b.indexOf('commentaries') >= 0 || b.indexOf('tafsir') >= 0) ? 'checked' : '' %>>
                    <label class="form-check-label">Tafsir</label>
                  </div>
                  <% if ((locals.tafsirFilterOptions || []).length > 0) { %>
                  <div class="filter-list-search-wrap px-3 pb-2" data-filter-list-search>
                    <input type="search" class="form-control form-control-sm filter-list-search" placeholder="Find book" aria-label="Find tafsir book">
                  </div>
                  <% locals.tafsirFilterOptions.forEach(function (tafsirOption) { %>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="tafsir" value="<%= tafsirOption.alias %>" <%= tafsirOption.selected ? 'checked' : '' %>>
                    <label class="form-check-label"><%= tafsirOption.label %></label>
                  </div>
                  <% }); %>
                  <% } %>
                  <% } else { %>
                  <div class="filter-list-search-wrap px-3 pb-2" data-filter-list-search>
                    <input type="search" class="form-control form-control-sm filter-list-search" placeholder="Find book" aria-label="Find hadith book">
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="toc" <%= (b.indexOf('toc') >= 0) ? 'checked' : '' %>>
                    <label class="form-check-label">Chapter Headings</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="sahihayn" <%= (b.indexOf('sahihayn') >= 0) ? 'checked' : '' %>>
                    <label class="form-check-label">Sahihayn</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="kutubarbaah" <%= (b.indexOf('kutubarbaah') >= 0) ? 'checked' : '' %>>
                    <label class="form-check-label">Kutub Arbaah</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="sixbooks" <%= (b.indexOf('sixbooks') >= 0) ? 'checked' : '' %>>
                    <label class="form-check-label">Kutub Sittah</label>
                  </div>
                  <% global.books.filter(b => {
                    return !b.virtual
                      && !b.hidden
                      && b.alias !== 'quran'
                      && (b.type || b.book_type || b.book_model || 'hadith') === 'hadith';
                  }).sort((a, b) => Number(a.ordinal || 0) - Number(b.ordinal || 0)).forEach(bk => { %>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="<%= bk.alias %>" <%=(b.indexOf(bk.alias) >= 0) ? 'checked' : ''%>>
                    <label class="form-check-label"><%=bk.shortName_en%></label>
                  </div>
                  <% }); %>
                  <% } %>
                  
                </div>
              </div>
              <% if (showSearchFilterPills) { %>
              <div class="search-filter-pills search-filter-pills-underbar" data-search-filter-pills>
                <% locals.searchFilterPills.forEach(function (pill) { %>
                <span class="search-filter-pill badge rounded-pill text-bg-light border" data-search-filter-pill>
                  <span><%= pill.label %></span>
                  <button type="button" class="btn-close" aria-label="Remove <%= pill.label %> filter" data-search-filter-remove data-filter-param="<%= pill.param %>" data-filter-value="<%= pill.value %>" <%- pill.removeTafsir ? 'data-remove-tafsir="1"' : '' %>></button>
                </span>
                <% }); %>
              </div>
              <% } else if (!isQuranSearchProxy && !q) { %>
                <div class="caution partial l2" lang="en">
                  <strong>Caution:</strong>
                  Translations of Quran and Ḥadīth may lead to possible misapplications and misinterpretations.  
                  This site is intended for students of sacred knowledge that are proficient in comprehending 
                  classical Arabic and have a strong foundation in Islamic sciences. Also note that religious 
                  injunctions rely on several aspects beyond what one may glean through reading individual aḥādīth.
                  </footnote>
                </div>
              <% } %>
            </div>
          </div>
        </search>
      </form>
      
      <%- include('sub-views/bookNav.ejs'); %> 

      <% if (results.length != 1 && q) { %>
      <div class="text-center">
        Found <%= displayResultCount %> results in <%= bookFilterLabels.length > 0 ? bookFilterLabels.join(', ') : 'all books' %>
      </div>
      <% } else if (results.length != 1) { %>
      <div class="text-center">
        Showing <%= displayResultCount %> results
      </div>
      <% } %>
      
        <% for (var i = 0; i < results.length; i++) { 
        var main = !q; %>
        
        <% if (results[i].doctype == 'suggestion') { %>
          <%- include('sub-views/search_suggestion_result.ejs', { suggestion: results[i] }); %>
        <% } else if (!results[i].doctype || results[i].doctype == 'hadith') { %>
          <%- include('sub-views/hadith.ejs', { site: site, page: page, i: results[i], title: true, main: main, searchResult: q }); %>
        <% } else if (results[i].doctype == 'translation') { %>
          <%- include('sub-views/translation_search_result.ejs', { translation: results[i] }); %>
        <% } else if (results[i].doctype == 'commentary') { %>
          <%- include('sub-views/commentary_search_result.ejs', { commentary: results[i] }); %>
        <% } else { %>
          <%- include('sub-views/toc.ejs', { site: site, page: page, toc: results[i], title: true, main: main, searchResult: q }); %>
        <% } %>

        <% if (!q && results[i].similar && results[i].similar.length > 0) { %>
        <div class="row similar-list">
          
          <hr>
          <div class="col-12">
            <h4 class="fs-5">See similar narrations below:</h4>
            <small><a title="أخرجه">Collected by</a>
              <% for (var j = 0; results[i].similarBooks && j < results[i].similarBooks.length; j++) { %>
              <span title="<%- results[i].similarBooks[j].name %>"><%- results[i].similarBooks[j].shortName_en + ((j < results[i].similarBooks.length-1) ? ', ' : '') %></span>
              <% } %> %></small>
          </div>
          
          <div class="col-12">
          <% for (var j = 0; j < results[i].similar.length; j++) { 
            results[i].similar[j].rating = Math.round((results[i].similar[j].rating - 0.5)*100/50*100/25);
          %>
          
          <%- include('sub-views/hadith.ejs', { site: site, page: page, i: results[i].similar[j], main: true, title: true, searchResult: false, similarSection: true }); %>
          
          <% } %>
          </div>
          
        </div>
        <% } %>
        
        <% } %>
        
    </main>
  </div>
  
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  
</body>

</html>
