<!doctype html>
<html lang="en">

<head>
  <%
    var site = Object.assign({}, global.settings.site);
    var isSearchResultsPage = (q && q != '');
    var isQuranSearchProxy = locals.quranSearchProxy || locals.searchAction === '/quran';
    var showQuranSearchSort = locals.showQuranSearchSort === true;
    var searchAction = locals.searchAction || '/';
    site.admin = (req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;
    if (isSearchResultsPage)
      site.editMode = false;
    
    var page = {
        menu: 'Search'
    };
    if (q) {
        page.menu = 'Search';
        page.title_en = `Search Results for ${q}`;
        page.description_en = `Search results for “${q}”${isQuranSearchProxy ? ' across the Quran and tafsir' : ' across Hadith, Sharh, History, Tafsir, Quran, Blog, and Community articles'}.`;
        page.canonical = searchAction;
        page.noindex = true;
        page.title = '';
        page.subtitle_en = 'Search Results';
        page.subtitle = '';
    } else if (results.length > 0 && typeof book !== 'undefined') {
        var canonicalReference = results[0].actual
          ? (results[0].ref_ref || `${results[0].book_alias_ref}:${results[0].num_ref}`)
          : `${book.alias}:${results[0].num}`;
        page.canonical = `/${canonicalReference}`;
        var hadithHeadingTitle = (results[0].en && results[0].en.title) || results[0].title_en
          || (results[0].section && (results[0].section.title_en || results[0].section.h2_title_en))
          || results[0].h2_title_en
          || '';
        var hadithMetaHeadingTitle = utils.truncate(hadithHeadingTitle, 65, true);
        page.title_en = utils.socialMetadata().qualifiedTitle(utils.socialMetadata().label(book.name_en || book.shortName_en, results[0].num), hadithHeadingTitle);
        page.description_en = `Read ${book.shortName_en} ${results[0].num}${hadithMetaHeadingTitle ? `, ${hadithMetaHeadingTitle}` : ''}, with Arabic text, English translation, source references, and related narrations.`;
        page.description_en = utils.socialMetadata().description(`${book.shortName_en || book.name_en} ${results[0].num}`, [utils.socialMetadata().body(results[0])], page.description_en);
        page.title = `${book.title} ${results[0].num_ar}`;
        page.subtitle_en = `${book.shortName_en}`;
        page.subtitle = `${book.shortName}`;
    } else {
      page.title_en = `${site.shortName}`;
      page.description_en = site.desc;
      page.title = '';
      page.subtitle_en = 'Home';
      page.subtitle = '';
    }

    page.context = {
      fromSearch: isSearchResultsPage,
      quranSearchProxy: isQuranSearchProxy
    };
    if (typeof book !== 'undefined') {
      page.context.book = book;
      if (book.alias === 'quran' && req.query.ayat !== undefined)
        page.noindex = true;
    }
    if (typeof chapter !== 'undefined')
      page.context.chapter = chapter;
    var displayResultCount = (typeof totalResults !== 'undefined' && totalResults > 0) ? totalResults : results.length;
    var sirahDetailItem = !isSearchResultsPage ? results.find(function (item) { return item.single && (['sirah', 'history'].includes(item.doctype) || ['sirah', 'history'].includes(item.book_type)); }) : null;
    var detailHadithItem = !isSearchResultsPage ? (results.find(function (item) { return item.single && item.book_alias !== 'quran' && item !== sirahDetailItem; }) || null) : null;
    if (utils.isFalsey(q) && results.length > 0) {
      page.context.chapter = results[0].chapter;
      page.context.section = results[0].section;
      page.context.hadiths = results;
      page.dateModified = utils.pageFreshness().readers(results);
      if (results[0].prev_ref)
          page.prev = `/${results[0].prev_ref}`;
      if (results[results.length-1].next_ref)
          page.next = `/${results[results.length-1].next_ref}`;
    } else if (results.length > 0) {
      function searchResultsPath(offset) {
        var params = new URLSearchParams();
        params.append('q', q);
        (Array.isArray(b) ? b : [b]).filter(Boolean).forEach(function (filter) {
          params.append('b', filter);
        });
        (locals.tafsirFilters || []).forEach(function (tafsirAlias) {
          params.append('tafsir', tafsirAlias);
        });
        if (req.query.mode === 'mushaf' || req.query.mode === 'study' || req.query.mode === 'tafsir')
          params.append('mode', req.query.mode);
        if (req.query.mode === 'tafsir' && req.query.tafsirMode)
          params.append('tafsirMode', req.query.tafsirMode);
        if (showQuranSearchSort && locals.searchSort === 'canonical')
          params.append('sort', 'canonical');
        params.append('o', offset);
        return `${searchAction}?${params.toString()}`;
      }
      if (results.prev) {
        if (results.prev != '0' && results.prev != 0)
          page.prev = searchResultsPath(results.prev);
      }
      if (results.next)
        page.next = searchResultsPath(results.next);
    }
%>
  
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
  
</head>

<body>
  
  <%- include('sub-views/header.ejs', { site: site, page: page, hadithDetailSectionItem: detailHadithItem }); %>
  
  <div class="<%= isSearchResultsPage ? 'container-fluid hadith-heading-layout search-results-layout ux-system' : (detailHadithItem ? 'container-fluid hadith-heading-layout hadith-metadata-page-layout' : 'container col-lg-8 mx-auto') %>">
    <% if (detailHadithItem) { %><div class="container col-lg-8 mx-auto hadith-heading-content"><% } %>
    
    <% if (sirahDetailItem) { %><%- include('sub-views/bookNav.ejs'); %><% } %>
    <main class="search-results<%= isSearchResultsPage ? ' container col-lg-8 mx-auto hadith-heading-content' : '' %>"<% if (isSearchResultsPage) { %> data-search-infinite="1" data-search-current-url="<%= req.originalUrl || req.url || searchAction %>"<% if (page.prev) { %> data-search-prev-url="<%= page.prev %>"<% } %><% if (page.next) { %> data-search-next-url="<%= page.next %>"<% } %><% } %>>
      <% if (isSearchResultsPage) { %>
        <header class="ux-page-heading search-results-heading">
          <h1 class="ux-page-title text-break">Search results for “<bdi><%= q %></bdi>”</h1>
          <button type="button" class="ux-secondary-action" data-command-search-open data-edit-search-query="<%= q %>" data-edit-search-mode="<%= isQuranSearchProxy ? 'quran' : 'hadith' %>" aria-haspopup="dialog" aria-controls="global-search-dialog">Edit search</button>
        </header>
      <% } %>
      <% var showSearchFilterPills = q && (locals.searchFilterPills || []).length > 0; %>
      <% if (isSearchResultsPage) { %>
      <nav class="recent-searches mb-3" aria-label="Recent searches" data-recent-searches hidden>
        <span class="small text-body-secondary">Recent searches</span>
        <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0"></ul>
      </nav>
      <div class="search-results-summary">
        <div class="search-results-filter-pills command-search-pills" data-search-filter-pills aria-label="Active search filters">
        <% if (showSearchFilterPills) { %>
        <% locals.searchFilterPills.forEach(function (pill) { %>
          <button type="button" class="ux-pill ux-pill-removable" data-search-filter-pill aria-label="Remove <%= pill.label %> filter" data-search-filter-remove data-filter-param="<%= pill.param %>" data-filter-value="<%= pill.value %>" <%- pill.removeTafsir ? 'data-remove-tafsir="1"' : '' %>><span><%= pill.label %></span></button>
        <% }); %>
          <button type="button" class="ux-text-action" data-search-filter-clear aria-label="Clear all search filters">Clear all</button>
        <% } %>
        </div>
        <div class="search-results-meta">
        <% if (showQuranSearchSort) {
          function searchSortPath(sort) {
            var sortParams = new URL(req.originalUrl || req.url || searchAction, 'http://localhost').searchParams;
            sortParams.delete('o');
            sortParams.delete('sort');
            if (sort === 'canonical') sortParams.set('sort', 'canonical');
            return `${searchAction}?${sortParams.toString()}`;
          }
        %>
          <div class="ux-view-selector search-results-sort" role="group" aria-label="Sort search results">
            <a class="ux-view-option<%= locals.searchSort !== 'canonical' ? ' active' : '' %>" href="<%= searchSortPath('relevance') %>"<% if (locals.searchSort !== 'canonical') { %> aria-current="page"<% } %>>Relevance</a>
            <a class="ux-view-option<%= locals.searchSort === 'canonical' ? ' active' : '' %>" href="<%= searchSortPath('canonical') %>"<% if (locals.searchSort === 'canonical') { %> aria-current="page"<% } %>>Quran order</a>
          </div>
        <% } %>
          <div class="search-results-count"><%= displayResultCount %> results found</div>
        </div>
      </div>
      <% } %>



      <% if (!isSearchResultsPage && !sirahDetailItem && !detailHadithItem) { %>
      <%- include('sub-views/bookNav.ejs'); %>
      <% } %>

      <% if (!isSearchResultsPage && results.length != 1) { %>
      <div class="text-center">
        Showing <%= displayResultCount %> results
      </div>
      <% } %>

      <% if (isSearchResultsPage) { %>
      <section class="search-results-page" data-search-results-page="1" aria-label="Search results">
      <% } %>
        <% for (var i = 0; i < results.length; i++) { 
        var main = !q; %>
        
        <% if (['blog', 'community'].includes(results[i].doctype)) { %>
          <%- include('sub-views/blog_search_result.ejs', { article: results[i] }); %>
        <% } else if (results[i].doctype == 'suggestion') { %>
          <%- include('sub-views/search_suggestion_result.ejs', { suggestion: results[i] }); %>
        <% } else if (!results[i].doctype || results[i].doctype == 'hadith' || results[i].doctype == 'sirah') { %>
          <%- include('sub-views/hadith.ejs', { site: site, page: page, i: results[i], detailIdentity: detailHadithItem, title: true, main: main, searchResult: q }); %>
        <% } else if (results[i].doctype == 'sharh') { %>
          <%- include('sub-views/sharh_search_result.ejs', { commentary: results[i] }); %>
        <% } else if (results[i].doctype == 'translation') { %>
          <%- include('sub-views/translation_search_result.ejs', { translation: results[i] }); %>
        <% } else if (results[i].doctype == 'commentary') { %>
          <%- include('sub-views/commentary_search_result.ejs', { commentary: results[i] }); %>
        <% } else { %>
          <%- include('sub-views/toc.ejs', { site: site, page: page, toc: results[i], title: true, main: main, searchResult: q }); %>
        <% } %>

        <% } %>

      <% if (isSearchResultsPage) { %>
      </section>
      <div class="search-infinite-status text-muted small" data-search-infinite-status aria-live="polite"></div>
      <div class="search-infinite-sentinel" data-search-infinite-sentinel aria-hidden="true"></div>
      <% } %>

    </main>
    <% if (isSearchResultsPage) { %>
    <aside class="search-filter-rail hadith-heading-toc d-none d-lg-block" aria-labelledby="search-rail-title">
      <div class="hadith-heading-toc-sticky"><div class="hadith-heading-toc-nav">
      <%- include('sub-views/rail_title.ejs', { titleId: 'search-rail-title', title: 'Search filters' }) %>
      <div data-search-filter-rail-container>
        <form method="get" action="<%= searchAction %>" class="search-filter-controls" data-search-filter-rail-form>
          <input type="hidden" name="q" value="<%= q %>">
          <% ['mode', 'tafsirMode', 'sort'].forEach(function (key) { if (req.query[key]) { %>
          <input type="hidden" name="<%= key %>" value="<%= req.query[key] %>">
          <% } }); %>
          <%- include('sub-views/rail_search.ejs', { inputId: 'search-filter-source', placeholder: 'Filter books and sources', label: 'Filter books and sources', clearLabel: 'Clear source filter', resultsId: 'search-filter-options' }) %>
          <div id="search-filter-options" data-search-filter-rail-options></div>
        </form>
      </div>
      </div></div>
    </aside>
    <% } %>
    <% if (detailHadithItem) { %></div><%- include('sub-views/hadith_metadata_rail.ejs', { i: detailHadithItem, mobile: false }); %><% } %>
  </div>
  
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
  <%- include('sub-views/page_end.ejs', { site, page }); %>
  
</body>

</html>
