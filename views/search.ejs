<!doctype html>
<html lang="en">

<head>
  <%
    var site = Object.assign({}, global.settings.site);
    var isSearchResultsPage = (q && q != '');
    var isQuranSearchProxy = locals.quranSearchProxy || locals.searchAction === '/quran';
    var searchAction = locals.searchAction || '/';
    site.admin = (req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;
    if (isSearchResultsPage)
      site.editMode = false;
    
    var page = {
        menu: 'Search'
    };
    if (q) {
        page.menu = 'Search';
        page.title_en = `Search Results for ${q}`;
        page.description_en = `Search results for “${q}”${isQuranSearchProxy ? ' across the Quran and tafsir' : ' across the hadith collection'}.`;
        page.canonical = searchAction;
        page.noindex = true;
        page.title = '';
        page.subtitle_en = 'Search Results';
        page.subtitle = '';
    } else if (results.length > 0 && typeof book !== 'undefined') {
        page.canonical = `/${book.alias}:${results[0].num}`;
        var hadithHeadingTitle = results[0].title_en
          || (results[0].section && (results[0].section.title_en || results[0].section.h2_title_en))
          || results[0].h2_title_en
          || '';
        var hadithMetaHeadingTitle = utils.truncate(hadithHeadingTitle, 65, true);
        page.title_en = `${book.shortName_en} ${results[0].num}${hadithHeadingTitle ? ` | ${hadithHeadingTitle}` : ''}`;
        page.description_en = `Read ${book.shortName_en} ${results[0].num}${hadithMetaHeadingTitle ? `, ${hadithMetaHeadingTitle}` : ''}, with Arabic text, English translation, source references, and related narrations.`;
        page.title = `${book.title} ${results[0].num_ar}`;
        page.subtitle_en = `${book.shortName_en}`;
        page.subtitle = `${book.shortName}`;
    } else {
      page.title_en = `${site.shortName}`;
      page.description_en = site.desc;
      page.title = '';
      page.subtitle_en = 'Home';
      page.subtitle = '';
    }

    page.context = {
      fromSearch: isSearchResultsPage,
      quranSearchProxy: isQuranSearchProxy
    };
    if (typeof book !== 'undefined') {
      page.context.book = book;
      if (book.alias === 'quran' && req.query.ayat !== undefined)
        page.noindex = true;
    }
    if (typeof chapter !== 'undefined')
      page.context.chapter = chapter;
    var displayResultCount = (typeof totalResults !== 'undefined' && totalResults > 0) ? totalResults : results.length;
    if (utils.isFalsey(q) && results.length > 0) {
      page.context.chapter = results[0].chapter;
      page.context.section = results[0].section;
      page.context.hadiths = results;
      if (results[0].prev_ref)
          page.prev = `/${results[0].prev_ref}`;
      if (results[results.length-1].next_ref)
          page.next = `/${results[results.length-1].next_ref}`;
    } else if (results.length > 0) {
      function searchResultsPath(offset) {
        var params = new URLSearchParams();
        params.append('q', q);
        (Array.isArray(b) ? b : [b]).filter(Boolean).forEach(function (filter) {
          params.append('b', filter);
        });
        (locals.tafsirFilters || []).forEach(function (tafsirAlias) {
          params.append('tafsir', tafsirAlias);
        });
        if (req.query.mode === 'mushaf' || req.query.mode === 'study' || req.query.mode === 'tafsir')
          params.append('mode', req.query.mode);
        if (req.query.mode === 'tafsir' && req.query.tafsirMode)
          params.append('tafsirMode', req.query.tafsirMode);
        params.append('o', offset);
        return `${searchAction}?${params.toString()}`;
      }
      if (results.prev) {
        if (results.prev != '0' && results.prev != 0)
          page.prev = searchResultsPath(results.prev);
      }
      if (results.next)
        page.next = searchResultsPath(results.next);
    }
%>
  
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
  
</head>

<body>
  
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  
  <div class="container col-lg-8 mx-auto">
    
    <main class="search-results">

      <% var showSearchFilterPills = q && (locals.searchFilterPills || []).length > 0; %>
      <% if (isSearchResultsPage) { %>
      <div class="search-results-summary">
        <div class="search-results-filter-pills command-search-pills" data-search-filter-pills aria-label="Active search filters">
        <% if (showSearchFilterPills) { %>
        <% locals.searchFilterPills.forEach(function (pill) { %>
          <span class="command-search-pill badge rounded-pill" data-search-filter-pill>
            <span><%= pill.label %></span>
            <button type="button" class="btn-close" aria-label="Remove <%= pill.label %> filter" data-search-filter-remove data-filter-param="<%= pill.param %>" data-filter-value="<%= pill.value %>" <%- pill.removeTafsir ? 'data-remove-tafsir="1"' : '' %>></button>
          </span>
        <% }); %>
        <% } %>
        </div>
        <div class="search-results-count"><%= displayResultCount %> results found</div>
      </div>
      <% } %>

      <% if (!isSearchResultsPage) { %>
      <%- include('sub-views/bookNav.ejs'); %>
      <% } %>

      <% if (!isSearchResultsPage && results.length != 1) { %>
      <div class="text-center">
        Showing <%= displayResultCount %> results
      </div>
      <% } %>
      
        <% for (var i = 0; i < results.length; i++) { 
        var main = !q; %>
        
        <% if (results[i].doctype == 'suggestion') { %>
          <%- include('sub-views/search_suggestion_result.ejs', { suggestion: results[i] }); %>
        <% } else if (!results[i].doctype || results[i].doctype == 'hadith') { %>
          <%- include('sub-views/hadith.ejs', { site: site, page: page, i: results[i], title: true, main: main, searchResult: q }); %>
        <% } else if (results[i].doctype == 'translation') { %>
          <%- include('sub-views/translation_search_result.ejs', { translation: results[i] }); %>
        <% } else if (results[i].doctype == 'commentary') { %>
          <%- include('sub-views/commentary_search_result.ejs', { commentary: results[i] }); %>
        <% } else { %>
          <%- include('sub-views/toc.ejs', { site: site, page: page, toc: results[i], title: true, main: main, searchResult: q }); %>
        <% } %>

        <% if (!q && results[i].similar && results[i].similar.length > 0) { %>
        <div class="row similar-list">
          
          <hr>
          <div class="col-12">
            <h4 class="fs-5">See similar narrations below:</h4>
            <small><a title="أخرجه">Collected by</a>
              <% for (var j = 0; results[i].similarBooks && j < results[i].similarBooks.length; j++) { %>
              <span title="<%- results[i].similarBooks[j].name %>"><%- results[i].similarBooks[j].shortName_en + ((j < results[i].similarBooks.length-1) ? ', ' : '') %></span>
              <% } %> %></small>
          </div>
          
          <div class="col-12">
          <% for (var j = 0; j < results[i].similar.length; j++) { 
            results[i].similar[j].rating = Math.round((results[i].similar[j].rating - 0.5)*100/50*100/25);
          %>
          
          <%- include('sub-views/hadith.ejs', { site: site, page: page, i: results[i].similar[j], main: true, title: true, searchResult: false, similarSection: true }); %>
          
          <% } %>
          </div>
          
        </div>
        <% } %>
        
        <% } %>
        
    </main>
  </div>
  
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  
</body>

</html>
