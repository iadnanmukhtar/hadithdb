<% if (items.length < 1) { %>
  <div class="rag-empty">No matching hadith sources found.</div>
<% } %>

<% for (var i = 0; i < items.length; i++) { 
  var item = items[i];
  var main = false;
%>
  <% if (!item.doctype || item.doctype == 'hadith') { %>
    <div class="rag-result-item">
      <%- include('sub-views/hadith.ejs', { site: site, page: page, i: item, title: true, main: main, searchResult: true }); %>
      <div class="rag-result-actions text-end">
        <button class="btn btn-sm btn-outline-primary rag-similar-btn" type="button" data-hadith-id="<%= item.hId || item.id %>">
          <i class="bi bi-intersect"></i> Find Similar
        </button>
      </div>
    </div>
  <% } else { %>
    <div class="rag-result-item">
      <%- include('sub-views/toc.ejs', { site: site, page: page, toc: item, title: true, main: main, searchResult: true }); %>
      <div class="rag-result-actions text-end">
        <button class="btn btn-sm btn-outline-primary rag-similar-btn" type="button" data-doctype="toc" data-toc-id="<%= item.tId || item.id || item.hId %>">
          <i class="bi bi-intersect"></i> Find Similar
        </button>
      </div>
    </div>
  <% } %>
<% } %>
