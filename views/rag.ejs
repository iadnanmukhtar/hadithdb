<!doctype html>
<html lang="en">

<head>
<%
  var site = new Object(global.settings.site);
  site.admin = (req.cookies.admin == admin.key);
  site.editMode = false;
  var page = {
    menu: 'RAG',
    title_en: `${site.shortName} | Hadith RAG Search`,
    subtitle_en: 'Hadith RAG Search',
    subtitle: null,
    canonical: '/rag',
    context: {}
  };
%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %>
<meta name="robots" content="noindex">

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %>

  <div class="container col-lg-8 mx-auto">
    <main class="rag-tool">

      <form id="rag-form" class="rag-search" autocomplete="off">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-stars"></i></span>
          <input id="rag-question" name="q" type="search" class="form-control" value="<%= q %>" placeholder="Ask about a hadith topic or wording...">
          <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Search</button>
        </div>
      </form>

      <section id="rag-status" class="rag-status" hidden></section>

      <section id="rag-answer-panel" class="rag-answer-panel" hidden>
        <h2>Answer</h2>
        <div id="rag-answer"></div>
      </section>

      <section class="rag-layout">
        <div>
          <div class="rag-section-heading">
            <h2>Retrieved Hadith</h2>
            <span id="rag-count"></span>
          </div>
          <div id="rag-results" class="rag-results"></div>
        </div>
      </section>

    </main>
  </div>

  <aside id="rag-similar-panel" class="offcanvas offcanvas-end rag-similar-panel" tabindex="-1">
    <div class="offcanvas-header">
      <div>
        <h2 class="offcanvas-title">RAG Similar Narrations</h2>
        <div id="rag-similar-count" class="rag-panel-count"></div>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
      <div id="rag-similar-empty" class="rag-empty">Select a hadith result to retrieve narrations with similar wording or meaning.</div>
      <div id="rag-similar-results"></div>
    </div>
  </aside>

  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

  <script>
    (() => {
      const initialQuestion = <%- JSON.stringify(q || '') %>;
      const form = document.getElementById('rag-form');
      const questionInput = document.getElementById('rag-question');
      const statusEl = document.getElementById('rag-status');
      const answerPanel = document.getElementById('rag-answer-panel');
      const answerEl = document.getElementById('rag-answer');
      const resultsEl = document.getElementById('rag-results');
      const countEl = document.getElementById('rag-count');
      const similarEmptyEl = document.getElementById('rag-similar-empty');
      const similarResultsEl = document.getElementById('rag-similar-results');
      const similarCountEl = document.getElementById('rag-similar-count');

      const escapeHtml = (value) => (value || '').toString().replace(/[&<>"']/g, ch => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[ch]));
      const setStatus = (message, busy) => {
        statusEl.hidden = !message;
        statusEl.innerHTML = busy ? `<span class="spinner-border spinner-border-sm"></span> ${escapeHtml(message)}` : escapeHtml(message);
      };
      const renderMarkdown = (value) => {
        value = value || '';
        if (window.marked && window.marked.parse)
          return window.marked.parse(value);
        return escapeHtml(value).replace(/\n/g, '<br>');
      };

      const renderAnswer = (data) => {
        answerPanel.hidden = !data.answer;
        answerEl.innerHTML = renderMarkdown(data.answer || '');
      };

      const renderResults = (data) => {
        countEl.textContent = data.count ? `${data.count} sources` : '';
        resultsEl.innerHTML = data.html || '<div class="rag-empty">No matching hadith sources found.</div>';
      };

      const search = async () => {
        const question = questionInput.value.trim();
        if (!question) {
          questionInput.focus();
          return;
        }
        setStatus('Searching HadithDB...', true);
        answerPanel.hidden = true;
        similarEmptyEl.hidden = false;
        similarResultsEl.innerHTML = '';
        similarCountEl.textContent = '';
        const response = await fetch('/rag/html', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question,
            generate: true
          })
        });
        const data = await response.json();
        if (!response.ok)
          throw new Error(data.message || data.error || 'Search failed');
        renderAnswer(data);
        renderResults(data);
        setStatus('', false);
      };

      const loadSimilar = async (button) => {
        setStatus('Finding similar narrations...', true);
        similarEmptyEl.hidden = true;
        similarResultsEl.innerHTML = '';
        similarCountEl.textContent = '';
        const params = new URLSearchParams();
        if (button.dataset.doctype === 'toc') {
          params.set('doctype', 'toc');
          params.set('tocId', button.dataset.tocId);
        } else {
          params.set('id', button.dataset.hadithId);
        }
        const panel = bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('rag-similar-panel'));
        panel.show();
        const response = await fetch(`/rag/similar-html?${params.toString()}`);
        const data = await response.json();
        if (!response.ok)
          throw new Error(data.message || data.error || 'Similar lookup failed');
        similarCountEl.textContent = data.count ? `${data.count} matches` : '';
        similarResultsEl.innerHTML = data.html || '<div class="rag-empty">No similar narrations were found by the Arabic RAG search.</div>';
        setStatus('', false);
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        try {
          await search();
        } catch (err) {
          setStatus(err.message, false);
        }
      });

      resultsEl.addEventListener('click', async (event) => {
        const button = event.target.closest('.rag-similar-btn');
        if (!button)
          return;
        try {
          await loadSimilar(button);
        } catch (err) {
          setStatus(err.message, false);
        }
      });

      if (initialQuestion)
        search().catch(err => setStatus(err.message, false));
    })();
  </script>

</body>
</html>
