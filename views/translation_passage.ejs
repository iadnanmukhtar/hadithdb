<!doctype html>
<html lang="en">
<head>
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (!locals.noadmin && req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;

    var ref = `${surah.num}:${ayah}`;
    var translationMetaTitle = `Quran | Translations ${surah.name_en} ${ref}`;
    var translationMetaDescription = `Read Quran ${ref}, Surat ${surah.name_en}, with the translations enabled in your Quran settings.`;
    var page = {
      menu: 'Quran',
      title_en: translationMetaTitle,
      description_en: translationMetaDescription,
      subtitle_en: `Quran ${ref}`,
      subtitle: `${surah.name_ar} ${arabic.toArabicDigits(ayah + '')}`,
      canonical: `/quran/translations/${surah.num}/${ayah}`,
      context: {
        quranSearchProxy: true
      }
    };
    var quranNavigatorSurahs = (global.surahs || []).map(function (surah) {
      return {
        num: Number(surah.num),
        name_en: surah.name_en,
        name_ar: surah.name_ar,
        ayahs: Number(surah.ayahs)
      };
    }).filter(function (surah) {
      return Number.isInteger(surah.num);
	    }).sort(function (a, b) {
	      return a.num - b.num;
	    });
	    var translationsPath = '/quran/translations';
	    var quranChapter = locals.chapter;
	    var quranSection = locals.section;
	    var quranChapterHref = quranChapter && quranChapter.path ? utils.quranUrl(req, `/${quranChapter.path}`) : utils.quranUrl(req, `/quran/${surah.num}`);
	    var quranSectionHref = quranSection && quranSection.path ? utils.quranUrl(req, `/${quranSection.path}`) : '';
	    var quranChapterTitleEn = (quranChapter && quranChapter.title_en) || `Surat ${surah.name_en}`;
	    var quranChapterTitleAr = (quranChapter && quranChapter.title) || `سورة ${surah.name_ar}`;
	    var quranCorpusSection = quranSection && quranSection.book_alias === 'quran' && quranSection.h1 && quranSection.h2
	      ? {
	        surah: arabic.toLatinDigits(quranSection.h1.toString()),
	        h2: arabic.toLatinDigits(quranSection.h2.toString())
	      }
	      : null;
	    var quranCorpusUrl = quranCorpusSection ? `/quran/corpus/${quranCorpusSection.surah}/${quranCorpusSection.h2}` : '';
	%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %>
</head>
<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %>

  <div class="container col-lg-8 mx-auto">
    <main class="chapter mt-10 tafsir-only-page translation-only-page"<%- quranCorpusUrl ? ` data-quran-corpus-url="${quranCorpusUrl}"` : '' %>>
	      <heading class="row major">
	        <h2 class="col-md-6 col-sm-12 fs-4 title" lang="en"><a href="<%= quranChapterHref %>">
	          <%= surah.num %>. <span<%- quranChapter ? ` class="_e" data-id="${quranChapter.id}" data-prop="toc.title_en" data-arabizi="true"` : '' %>><%- quranChapterTitleEn %></span>
	        </a>
	        <% if (quranChapter) { %>
	          <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center ms-2" data-heading-id="<%= quranChapter.id %>" title="Bookmark this chapter">
	            <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= quranChapter.id %>"></span>
	          </button>
	        <% } %>
	        </h2>
	        <h2 class="col-md-6 col-sm-12 fs-4 title" lang="ar"><a href="<%= quranChapterHref %>">
	          <%= arabic.toArabicDigits(surah.num + '') %>۔
	          <span<%- quranChapter ? ` class="_e quran-surah-name" data-id="${quranChapter.id}" data-prop="toc.title"` : ' class="quran-surah-name"' %>><%- quranChapterTitleAr %></span>
	        </a></h2>
	      </heading>

	      <section class="row breadcrumbs pagination">
	        <div class="col-md-6 col-sm-12" lang="en">
	          <a title="The Holy Quran" href="<%= utils.quranUrl(req, '/quran') %>">Quran</a>
	          &gt;
	          <a title="<%- quranChapterTitleEn %>" href="<%= quranChapterHref %>">Surah <%= surah.num %></a>
	          <% if (quranSection) { %>
	            &gt;
	            <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-heading-id="<%= quranSection.id %>" title="Bookmark this section">
	              <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= quranSection.id %>"></span>
	            </button>
	            <a title="<%- quranSection.title || quranSection.title_en || 'Section' %>" href="<%= quranSectionHref %>">Section <%= quranSection.h2 %></a>
	          <% } %>
	        </div>
	        <div class="col-md-6 col-sm-12" lang="ar">
	          <a title="القرآن" href="<%= utils.quranUrl(req, '/quran') %>">القرآن</a>
	          &gt;
	          <a title="<%- quranChapterTitleAr %>" href="<%= quranChapterHref %>">السورة <%= arabic.toArabicDigits(surah.num + '') %></a>
	          <% if (quranSection) { %>
	            &gt;
	            <a title="<%- quranSection.title || quranSection.title_en || 'باب' %>" href="<%= quranSectionHref %>">باب <%= arabic.toArabicDigits(quranSection.h2 + '') %></a>
	          <% } %>
	        </div>
	      </section>

      <% if (quranNavigatorSurahs.length > 0) { %>
        <form class="quran-passage-navigator mb-3" action="/quran" method="get" novalidate data-quran-passage-navigator data-tafsir-navigator-base="<%= translationsPath %>" data-tafsir-navigator-query="" data-surahs="<%= JSON.stringify(quranNavigatorSurahs) %>">
          <label class="form-label mb-0">
            <input type="text" class="form-control form-control-sm quran-passage-surah" value="<%= surah.num %>" aria-label="Select Quran surah" autocomplete="off" required>
          </label>
          <div class="input-group input-group-sm quran-passage-ayah-group">
            <input type="text" inputmode="numeric" class="form-control quran-passage-ayah" value="<%= ayah %>" aria-label="Select Quran ayah" autocomplete="off" required>
            <button type="submit" class="btn btn-outline-primary quran-passage-go" title="Open translations" aria-label="Open translations">
              <span class="bi bi-caret-right"></span>
            </button>
          </div>
          <div class="input-group input-group-sm quran-passage-search-group">
            <input role="search" type="text" class="form-control quran-passage-search" placeholder="Search the Qurʿān or tafāsīr" aria-label="Search the Qurʿān or tafāsīr" autocomplete="off">
            <%- include('sub-views/quran_tafsir_search_filter.ejs', { Tafsir: Tafsir }); %>
          </div>
        </form>
      <% } %>

      <%- include('sub-views/quran_ayah_hero.ejs', {
        site: site,
        page: page,
        selectedAyahs: ayahs,
        ayahHref: utils.quranUrl(req, `/quran:${ref}`),
        toolbar: {
          selectedAyahModalIndex: 0,
          selectedAyahId: ayahs[0] && ayahs[0].id,
          viewHref: utils.quranUrl(req, `/quran:${ref}`),
          quranShareId: `Q${ref.replace(/[^A-Za-z0-9_-]/g, '-')}`,
          hideTranslationsAction: true
        }
      }); %>

      <%- include('sub-views/quran_translations.ejs', {
        site: site,
        page: page,
        passage: ayahs,
        selectedAyahs: ayahs,
        translationInstance: 'passage',
        translationSettingsHref: utils.quranUrl(req, '/quran/settings')
      }); %>

      <section class="mt-4">
        <%- include('sub-views/comment_widget.ejs', {
          widgetId: 'comments',
          heading: `Reflect on Quran ${ref}:`,
          targetId: ayahs[0] && ayahs[0].id,
          ref: ayahs[0] && ayahs[0].ref,
          endpoint: '/comments',
          subjectLabel: 'reflection',
          placeholder: `Write a reflection on Quran ${ref}...`
        }); %>
      </section>

      <%- include('sub-views/quran_ayah_modal.ejs', { site: site, page: page, passage: ayahs }); %>
      <%- include('sub-views/quran_modal.ejs', { site: site, page: page, selectedAyahs: ayahs, quranShareId: `Q${ref.replace(/[^A-Za-z0-9_-]/g, '-')}` }); %>

    </main>
  </div>

<%- include('sub-views/mobile_navigation.ejs', {
  site: site,
  page: page,
  prev: navigation.prev,
  next: navigation.next,
  prevTitle: navigation.prevTitle ? `Previous: ${navigation.prevTitle}` : 'Previous',
  nextTitle: navigation.nextTitle ? `Next: ${navigation.nextTitle}` : 'Next'
}); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

</body>
</html>
