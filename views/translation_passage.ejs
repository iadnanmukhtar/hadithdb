<!doctype html>
<html lang="en">
<head>
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (!locals.noadmin && req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;

    var ref = `${surah.num}:${ayah}`;
    var translationHeadingTitle = (locals.section && (locals.section.title_en || locals.section.title)) || '';
    var translationMetaTitle = utils.socialMetadata().quranReaderTitle({surah:surah.name_en, reference:ref, heading:translationHeadingTitle, translations:true});
    var translationMetaDescription = `Compare Quran translations for ${ref}, Surat ${surah.name_en}, alongside the Arabic text and passage context.`;
    translationMetaDescription = utils.socialMetadata().description(`${surah.name_en} ${ref}`, ayahs.map(item => utils.socialMetadata().body(item)), translationMetaDescription);
    var page = {
      menu: 'Section',
      title_en: translationMetaTitle,
      description_en: translationMetaDescription,
      subtitle_en: `Quran ${ref}`,
      subtitle: `${surah.name_ar} ${arabic.toArabicDigits(ayah + '')}`,
      canonical: `/quran/translations/quran:${surah.num}:${ayah}`,
      context: {
        book: { alias: 'quran' },
        chapter: chapter,
        section: section,
        quranSearchProxy: true,
        quranReaderRef: ref
      }
    };
    var quranNavigatorSurahs = (global.surahs || []).map(function (surah) {
      return {
        num: Number(surah.num),
        name_en: surah.name_en,
        name_ar: surah.name_ar,
        ayahs: Number(surah.ayahs)
      };
    }).filter(function (surah) {
      return Number.isInteger(surah.num);
	    }).sort(function (a, b) {
	      return a.num - b.num;
	    });
	    var translationsPath = '/quran/translations/quran:';
	    var quranChapter = locals.chapter;
	    var quranSection = locals.section;
	    var quranChapterHref = quranChapter && quranChapter.path ? utils.quranUrl(req, `/${quranChapter.path}`) : utils.quranUrl(req, `/quran/${surah.num}`);
	    var quranSectionHref = quranSection && quranSection.path ? utils.quranUrl(req, `/${quranSection.path}`) : '';
	    var quranChapterTitleEn = (quranChapter && quranChapter.title_en) || `Surat ${surah.name_en}`;
	    var quranChapterTitleAr = (quranChapter && quranChapter.title) || `سورة ${surah.name_ar}`;
	    var quranChapterBreadcrumbLabel = utils.quranSurahBreadcrumbLabel(surah.num, quranChapterTitleEn);
	    var quranChapterBreadcrumbLabelAr = utils.quranSurahBreadcrumbLabelAr(surah.num, quranChapterTitleAr);
	    var quranSurahRevelation = /^mad/i.test((surah.revelation_en || '').toString()) ? 'madani' : 'makki';
	    var quranChapterSurahNameGlyph = !site.editMode ? utils.quranSurahNameLigature(surah.num) : '';
	    var quranCorpusSection = quranSection && quranSection.book_alias === 'quran' && quranSection.h1 && quranSection.h2
	      ? {
	        surah: arabic.toLatinDigits(quranSection.h1.toString()),
	        h2: arabic.toLatinDigits(quranSection.h2.toString())
	      }
	      : null;
	    var quranCorpusUrl = quranCorpusSection ? `/quran/corpus/${quranCorpusSection.surah}/${quranCorpusSection.h2}` : '';
	%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %>
</head>
<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %>

  <div class="container-fluid quran-heading-layout quran-heading-layout-tafsir">
    <div class="quran-heading-content quran-heading-content-tafsir">
    <main class="chapter mt-10 tafsir-only-page translation-only-page" data-reader-quran-ref="<%= ref %>"<%- quranCorpusUrl ? ` data-quran-corpus-url="${quranCorpusUrl}"` : '' %>>
	      <%- include('sub-views/commentary_surah_heading.ejs', { site, surah, quranChapter, quranChapterHref, quranChapterTitleEn, quranChapterTitleAr, quranChapterSurahNameGlyph, quranSurahRevelation }); %>

	      <section class="row breadcrumbs pagination">
	        <div class="col-md-6 col-sm-12" lang="en">
	          <a title="The Holy Quran" href="<%= utils.quranUrl(req, '/quran') %>">Quran</a>
	          &gt;
	          <a title="<%- quranChapterTitleEn %>" href="<%= quranChapterHref %>"><%= quranChapterBreadcrumbLabel %></a>
	          <% if (quranSection) { %>
	            &gt;
	            <a title="<%- quranSection.title || quranSection.title_en || 'Passage' %>" href="<%= quranSectionHref %>">Passage <%= quranSection.h2 %></a>
	          <% } %>
	        </div>
	        <div class="col-md-6 col-sm-12" lang="ar">
	          <a title="القرآن" href="<%= utils.quranUrl(req, '/quran') %>">القرآن</a>
	          &gt;
	          <a title="<%- quranChapterTitleAr %>" href="<%= quranChapterHref %>"><%= quranChapterBreadcrumbLabelAr %></a>
	          <% if (quranSection) { %>
	            &gt;
	            <a title="<%- quranSection.title || quranSection.title_en || 'مقطع' %>" href="<%= quranSectionHref %>">مقطع <%= arabic.toArabicDigits(quranSection.h2 + '') %></a>
	          <% } %>
	        </div>
	      </section>

      <%- include('sub-views/quran_ayah_hero.ejs', {
        site: site,
        page: page,
        selectedAyahs: ayahs,
        showTranslation: false,
        ayahHref: utils.quranUrl(req, `/quran:${ref}`),
        toolbar: {
          selectedAyahModalIndex: 0,
          selectedAyahId: ayahs[0] && ayahs[0].id,
          viewHref: utils.quranUrl(req, `/quran:${ref}`),
          quranShareId: `Q${ref.replace(/[^A-Za-z0-9_-]/g, '-')}`,
          hideTranslationsAction: true
        }
      }); %>

      <%- include('sub-views/quran_translations.ejs', {
        site: site,
        page: page,
        passage: ayahs,
        selectedAyahs: ayahs,
        translationInstance: 'passage',
        translationSettingsHref: utils.quranUrl(req, '/quran/settings')
      }); %>

      <section class="mt-4">
        <%- include('sub-views/comment_widget.ejs', {
          widgetId: 'comments',
		  heading: 'Reflect on this ayah',
          targetId: ayahs[0] && ayahs[0].id,
          ref: ayahs[0] && ayahs[0].ref,
          endpoint: '/comments',
          subjectLabel: 'reflection',
          placeholder: `Write a reflection on Quran ${ref}...`
        }); %>
      </section>

      <%- include('sub-views/quran_ayah_modal.ejs', { site: site, page: page, passage: ayahs, usePassagePageModalLayout: true }); %>
      <%- include('sub-views/quran_modal.ejs', { site: site, page: page, selectedAyahs: ayahs, quranShareId: `Q${ref.replace(/[^A-Za-z0-9_-]/g, '-')}` }); %>

    </main>
    </div>
    <%- include('sub-views/quran_heading_toc.ejs', {
      quranHeadingOutlines: locals.quranHeadingOutlines,
      quranHeadingInitialSurah: surah.num,
      quranHeadingInitialAyah: ayah,
      quranHeadingTranslations: true,
      quranHeadingBookShortName: 'Quran Translations'
    }); %>
  </div>

<%- include('sub-views/mobile_navigation.ejs', {
  site: site,
  page: page,
  prev: navigation.prev,
  next: navigation.next,
  prevTitle: navigation.prevTitle ? `Previous: ${navigation.prevTitle}` : 'Previous',
  nextTitle: navigation.nextTitle ? `Next: ${navigation.nextTitle}` : 'Next'
}); %>
<%- include('sub-views/page_end.ejs', { site, page }); %>

</body>
</html>
