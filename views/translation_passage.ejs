<!doctype html>
<html lang="en">
<head>
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (!locals.noadmin && req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;

    var ref = `${surah.num}:${ayah}`;
    var translationMetaTitle = `Quran | Translations ${surah.name_en} ${ref}`;
    var translationMetaDescription = `Read Quran ${ref}, Surat ${surah.name_en}, with the translations enabled in your Quran settings.`;
    var page = {
      menu: 'Quran',
      title_en: translationMetaTitle,
      description_en: translationMetaDescription,
      subtitle_en: `Quran ${ref}`,
      subtitle: `${surah.name_ar} ${arabic.toArabicDigits(ayah + '')}`,
      canonical: `/quran/translations/${surah.num}/${ayah}`,
      context: {
        quranSearchProxy: true
      }
    };
    var quranNavigatorSurahs = (global.surahs || []).map(function (surah) {
      return {
        num: Number(surah.num),
        name_en: surah.name_en,
        name_ar: surah.name_ar,
        ayahs: Number(surah.ayahs)
      };
    }).filter(function (surah) {
      return Number.isInteger(surah.num);
    }).sort(function (a, b) {
      return a.num - b.num;
    });
    var translationsPath = '/quran/translations';
%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %>
</head>
<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %>

  <div class="container col-lg-8 mx-auto">
    <main class="chapter mt-10 tafsir-only-page translation-only-page">
      <aside class="row mb-3 pagination tafsir-passage-navigation">
        <div class="col-md-6 col-xs-12 text-start pagination-nav-slot pagination-nav-slot-prev">
          <% if (navigation.prev) { %>
            <a class="pagination-nav-link" href="<%= navigation.prev %>" rel="prev"><span class="pagination-nav-chevron bi bi-chevron-left" aria-hidden="true"></span><span class="pagination-nav-label">&nbsp;Prev: <%= navigation.prevTitle %></span></a>
          <% } %>
        </div>
        <div class="col-md-6 col-xs-12 text-end pagination-nav-slot pagination-nav-slot-next">
          <% if (navigation.next) { %>
            <a class="pagination-nav-link" href="<%= navigation.next %>" rel="next"><span class="pagination-nav-label">Next: <%= navigation.nextTitle %>&nbsp;</span><span class="pagination-nav-chevron bi bi-chevron-right" aria-hidden="true"></span></a>
          <% } %>
        </div>
      </aside>

      <heading class="row major tafsir-passage-title">
        <h2 class="col-md-6 col-sm-12 fs-4 title" lang="en">
          <%= surah.num %>. Surat <%= surah.name_en %>
        </h2>
        <h2 class="col-md-6 col-sm-12 fs-4 title text-md-end quran-surah-name" lang="ar" dir="rtl">
          <%= arabic.toArabicDigits(surah.num + '') %> - سورة <%= surah.name_ar %>
        </h2>
      </heading>

      <section class="row breadcrumbs pagination">
        <div class="col-md-6 col-sm-12" lang="en">
          <a title="Quran translations" href="<%= translationsPath %>/<%= surah.num %>/1">Translations</a>
          &gt;
          <a title="<%- surah.name_en %>" href="<%= translationsPath %>/<%= surah.num %>/1">Surah <%= surah.num %></a>
          &gt;
          <span>Ayah <%= ayah %></span>
        </div>
        <div class="col-md-6 col-sm-12" lang="ar" dir="rtl">
          <a title="ترجمات القرآن" href="<%= translationsPath %>/<%= surah.num %>/1">الترجمات</a>
          &gt;
          <a title="<%- surah.name_ar %>" href="<%= translationsPath %>/<%= surah.num %>/1">السورة <%= arabic.toArabicDigits(surah.num + '') %></a>
          &gt;
          <span>الآية <%= arabic.toArabicDigits(ayah + '') %></span>
        </div>
      </section>

      <% if (quranNavigatorSurahs.length > 0) { %>
        <form class="quran-passage-navigator mb-3" action="/" method="get" novalidate data-quran-passage-navigator data-tafsir-navigator-base="<%= translationsPath %>" data-tafsir-navigator-query="" data-surahs="<%= JSON.stringify(quranNavigatorSurahs) %>">
          <input type="hidden" name="b" value="quran">
          <input type="hidden" name="b" value="commentaries">
          <label class="form-label mb-0">
            <input type="text" class="form-control form-control-sm quran-passage-surah" value="<%= surah.num %>" aria-label="Select Quran surah" autocomplete="off" required>
          </label>
          <div class="input-group input-group-sm quran-passage-ayah-group">
            <input type="text" inputmode="numeric" class="form-control quran-passage-ayah" value="<%= ayah %>" aria-label="Select Quran ayah" autocomplete="off" required>
            <button type="submit" class="btn btn-outline-primary quran-passage-go" title="Open translations" aria-label="Open translations">
              <span class="bi bi-caret-right"></span>
            </button>
          </div>
          <div class="input-group input-group-sm quran-passage-search-group">
            <input role="search" type="text" class="form-control quran-passage-search" placeholder="Search the Qurʿān or tafāsīr" aria-label="Search the Qurʿān or tafāsīr" autocomplete="off">
            <button type="button" class="btn btn-outline-primary quran-passage-search-submit" title="Search the Qurʿān or tafāsīr" aria-label="Search the Qurʿān or tafāsīr">
              <span class="bi bi-search"></span>
            </button>
          </div>
        </form>
      <% } %>

      <%- include('sub-views/quran_ayah_hero.ejs', {
        site: site,
        page: page,
        selectedAyahs: ayahs,
        linkHeroAyah: false,
        toolbar: {
          selectedAyahModalIndex: 0,
          selectedAyahId: ayahs[0] && ayahs[0].id,
          quranShareId: `Q${ref.replace(/[^A-Za-z0-9_-]/g, '-')}`,
          hideTranslationsAction: true
        }
      }); %>

      <%- include('sub-views/quran_translations.ejs', {
        site: site,
        page: page,
        passage: ayahs,
        selectedAyahs: ayahs,
        translationInstance: 'passage',
        hideDefaultTranslation: true,
        translationSettingsHref: utils.quranUrl(req, '/quran/settings')
      }); %>

      <%- include('sub-views/quran_ayah_modal.ejs', { site: site, page: page, passage: ayahs }); %>
      <%- include('sub-views/quran_modal.ejs', { site: site, page: page, selectedAyahs: ayahs, quranShareId: `Q${ref.replace(/[^A-Za-z0-9_-]/g, '-')}` }); %>

      <aside class="row mt-3 mb-3 pagination tafsir-passage-navigation">
        <div class="col-md-6 col-xs-12 text-start pagination-nav-slot pagination-nav-slot-prev">
          <% if (navigation.prev) { %>
            <a class="pagination-nav-link" href="<%= navigation.prev %>" rel="prev"><span class="pagination-nav-chevron bi bi-chevron-left" aria-hidden="true"></span><span class="pagination-nav-label">&nbsp;Prev: <%= navigation.prevTitle %></span></a>
          <% } %>
        </div>
        <div class="col-md-6 col-xs-12 text-end pagination-nav-slot pagination-nav-slot-next">
          <% if (navigation.next) { %>
            <a class="pagination-nav-link" href="<%= navigation.next %>" rel="next"><span class="pagination-nav-label">Next: <%= navigation.nextTitle %>&nbsp;</span><span class="pagination-nav-chevron bi bi-chevron-right" aria-hidden="true"></span></a>
          <% } %>
        </div>
      </aside>
    </main>
  </div>

<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

</body>
</html>
