<!doctype html>
<html lang="en">
<head>
<%
const site = Object.assign({}, global.settings.site, { admin: req.admin, editMode: req.admin && req.editMode });
const title = sharhBook ? (sharhBook.shortName_en || sharhBook.name_en || sharhBook.alias) : 'Sharḥ books';
const canonical = sharhBook ? `/sharh/${encodeURIComponent(sharhBook.alias)}` : '/sharh';
const contents = locals.chapters || [];
const source = locals.selectedBook;
const headingNumber = value => Number.isInteger(Number(value)) ? String(value) : Number(value).toFixed(2);
const bookLabel = book => book.shortName_en || book.name_en || book.alias;
const sourceUrl = book => canonical + '?book=' + encodeURIComponent(book.alias);
const page = { sharhBook, menu: 'Books', schemaType: 'CollectionPage', title_en: title, description_en: source ? `Browse ${title} by chapter and section of ${bookLabel(source)} and open its explanations.` : `Browse ${title} and the hadith collections they explain.`, canonical: source && source !== coveredBooks[0] ? sourceUrl(source) : canonical, subtitle_en: sharhBook ? (sharhBook.shortName_en || sharhBook.name_en || sharhBook.alias) : '', subtitle: sharhBook ? sharhBook.shortName : '', context: {} };
if (sharhBook) {
  const currentIndex = books.findIndex(book => book.id === sharhBook.id);
  const prevBook = currentIndex > 0 ? books[currentIndex - 1] : null;
  const nextBook = currentIndex >= 0 && currentIndex < books.length - 1 ? books[currentIndex + 1] : null;
  if (prevBook) {
    page.prev = `/sharh/${encodeURIComponent(prevBook.alias)}`;
    page.prevTitle = `Previous: ${(prevBook.shortName_en || prevBook.name_en || prevBook.alias)}`;
  }
  if (nextBook) {
    page.next = `/sharh/${encodeURIComponent(nextBook.alias)}`;
    page.nextTitle = `Next: ${(nextBook.shortName_en || nextBook.name_en || nextBook.alias)}`;
  }
}
%>
<%- include('sub-views/head.ejs', { site, page }); %>
  <%- include('sub-views/toc_styles.ejs'); %>
</head>
<body>
<%- include('sub-views/header.ejs', { tocCollection: 'sharh', site, page }); %>
<div class="container-fluid hadith-heading-layout toc-heading-layout">
<div class="container col-lg-8 mx-auto hadith-heading-content toc-heading-content">
<main class="ux-system ux-book-toc toc hadith-toc-page">
  <% if (sharhBook) { %>
    <article>
    <%- include('sub-views/book_metadata.ejs', {
      site, book: sharhBook,
      actions: contents.length ? {
        primaryHref: contents[0].href,
        primaryLabel: 'Read commentary on ' + bookLabel(source)
      } : null,
      tocDisplayBook: sharhBook,
      tocDisplayBookNameEn: sharhBook.name_en || title,
      tocDisplayBookTitle: sharhBook.name || sharhBook.title || sharhBook.shortName,
      showBookLayout: true, showBookMetadata: true,
      quranCommentaryBook: null, isEnglishQuranTranslation: false
    }); %>
    <section aria-labelledby="sharh-chapters">
      <% if (coveredBooks.length > 1) { %>
      <nav class="nav ux-view-selector mb-3" aria-label="Referenced hadith book">
        <% for (const book of coveredBooks) { %>
        <a class="ux-view-option" href="<%= sourceUrl(book) %>" <% if (book === source) { %>aria-current="page"<% } %>><%= bookLabel(book) %></a>
        <% } %>
      </nav>
      <% } %>
      <h2 id="sharh-chapters" class="ux-section-title">Chapters</h2>
      <% if (contents.length) { %>
      <table id="toc" class="table ux-toc-table sharh-toc-table" aria-label="<%= bookLabel(source) %> chapters">
        <colgroup><col class="toc-start-column"><col class="toc-number-column"><col><col></colgroup>
        <tbody>
          <% for (const chapter of contents) {
            const key = 'toc-chapter-' + chapter.id;
            for (const row of [chapter, ...chapter.sections]) {
              const top = row === chapter;
          %>
          <tr <% if (top) { %>class="chapter" id="<%= key %>" data-toc-chapter="<%= key %>" data-toc-heading-target data-toc-heading-key="<%= key %>"<% } else { %>class="title toc-section-row d-none<%= row.level === 3 ? ' toc-subsection-row' : '' %>" id="toc-section-<%= row.id %>" data-toc-parent="<%= key %>" data-toc-level="<%= row.level %>"<% } %>>
            <td><%= row.start %></td>
            <% if (top) { %>
            <td><% if (chapter.sections.length) { %><button type="button" class="toc-expand-btn" data-toc-toggle="<%= key %>" aria-expanded="false" aria-controls="<%= chapter.sections.map(section => 'toc-section-' + section.id).join(' ') %>" title="Show sections"><span class="toc-expand-icon bi bi-chevron-right"></span></button><% } else { %><span class="toc-expand-spacer"></span><% } %> C<%= headingNumber(row.h1) %></td>
            <% } else { %>
            <td class="toc-outline-cell"><span class="toc-section-number">S<%= [row.h1, row.h2, ...(row.level === 3 ? [row.h3] : [])].map(headingNumber).join('.') %></span></td>
            <% } %>
            <td colspan="<%= row.title ? 1 : 2 %>" class="<%= top ? '' : 'toc-outline-cell' %>"><a href="<%= row.href %>"><%= row.title_en || (top ? 'Chapter' : 'Section') %></a></td>
            <% if (row.title) { %><td lang="ar" dir="rtl"><a href="<%= row.href %>"><%= row.title %></a></td><% } %>
          </tr>
          <% } } %>
        </tbody>
      </table>
      <% } else { %><p class="text-muted"><%= source ? 'No linked commentary passages for this book.' : 'No linked books yet.' %></p><% } %>
    </section>
    </article>
  <% } else { %>
    <h1 class="ux-page-title">Sharḥ books</h1>
    <div class="list-group"><% books.forEach(function(book) { %><div class="list-group-item">
      <div class="row" dir="ltr"><a class="col-md-6" href="/sharh/<%= encodeURIComponent(book.alias) %>"><%= (book.shortName_en || book.name_en || book.alias) %></a><span class="col-md-6" lang="ar" dir="rtl"><%= book.shortName || book.title %></span></div>
      <% if (site.editMode) { %><button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-bs-toggle="modal" data-bs-target="#sharh-book-<%= book.id %>">Edit book metadata</button><% } %>
    </div><% }); %></div>
  <% } %>
</main>
</div>
<% if (contents.length) { %>
<%- include('sub-views/toc_heading_rail.ejs', { mode: 'chapters', groups: [{ mode: 'chapters', items: contents.map(chapter => ({ key: 'toc-chapter-' + chapter.id, number: 'C' + headingNumber(chapter.h1), title: chapter.title_en || chapter.title || 'Chapter', href: chapter.href })) }] }); %>
<% } %>
</div>
<% if (site.editMode) { (sharhBook ? [] : books).forEach(function(book) { %><%- include('sub-views/sharh_book_metadata_modal.ejs', { sharhBook: book, modalId: `sharh-book-${book.id}` }); %><% }); } %>
<% if (sharhBook) { %><%- include('sub-views/mobile_navigation.ejs', { site, page }); %><% } %>
<%- include('sub-views/page_end.ejs', { site, page }); %>
</body>
</html>
