<!doctype html>
<html lang="en">
<% var site = Object.assign({}, global.settings.site, { admin: req.admin, editMode: req.admin && req.editMode }); %>
<head>
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
</head>
<body>
  <%- include('sub-views/quran_audio_range_modal.ejs'); %>
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  <% var showQuranHeadingToc = locals.readerShell || !review && locals.quranHeadingOutlines && Object.keys(locals.quranHeadingOutlines).length > 0; %>
  <div<% if (showQuranHeadingToc) { %> class="container-fluid quran-heading-layout quran-heading-layout-mushaf"<% } %>>
  <main class="container col-xl-7 col-lg-8 mx-auto quran-mushaf-reader<%= memorize ? ' quran-memorize-reader' : '' %>" data-quran-mushaf-reader<% if (memorize) { %> data-quran-memorize-reader="1"<% } %><% if (review) { %> data-quran-review-reader="1"<% } %> data-next-url="<%= `/quran/page/${mushaf.number < mushaf.info.number_of_pages ? mushaf.number + 1 : 1}${memorize ? '?memorize' : ''}` %>">
    <h1 class="visually-hidden" data-reader-page-title><%= page.title_en %></h1>
    <% if (memorize && !review) { %>
    <div class="d-flex justify-content-center mb-3" data-quran-memorize-get-started>
      <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#quran-get-started-modal"><i class="bi bi-stars me-1" aria-hidden="true"></i>Get Started</button>
    </div>
    <% } %>
    <% if (locals.readerShell) { %>
    <div data-reader-shell="mushaf" data-page="<%= mushaf.number %>" aria-busy="true"></div>
    <noscript><meta http-equiv="refresh" content="0;url=<%= fallback %>"></noscript>
    <% } else { %><%- include('sub-views/quran_mushaf_page.ejs', { surahs: global.surahs || [] }); %><% } %>
    <div class="quran-mushaf-sentinel text-center py-4" data-quran-mushaf-sentinel role="status" aria-live="polite"></div>
  </main>
  <% if (showQuranHeadingToc && !locals.readerShell) { %>
  <%- include('sub-views/quran_heading_toc.ejs', {
    quranHeadingOutlines: locals.quranHeadingOutlines,
    quranHeadingInitialSurah: firstSurah && firstSurah.num,
    quranHeadingInitialAyah: Number((firstRef || '').split(':')[1]),
    quranHeadingBookShortName: 'Quran'
  }); %>
  <% } %>
  </div>
  <% if (memorize) { %><%- include('sub-views/quran_memorization_help_modal.ejs', { site: site, page: page }); %><% if (!review) { %><%- include('sub-views/quran_memorize_review_modal.ejs', { site: site, page: page }); %><%- include('sub-views/quran_get_started_modal.ejs', { site: site, page: page }); %><% } %><% } %>
  <% if (!memorize && !review) { %>
  <dialog id="mushaf-book" aria-label="Full-screen Mushaf" data-total-pages="<%= mushaf.info.number_of_pages %>">
    <header class="mushaf-book-controls">
      <button type="button" data-turn="2" class="btn btn-sm btn-outline-secondary ux-secondary-action" aria-label="Next spread" title="Next spread (←)"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
      <span data-book-status role="status"></span>
      <button type="button" data-turn="-2" class="btn btn-sm btn-outline-secondary ux-secondary-action" aria-label="Previous spread" title="Previous spread (→)"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
      <div class="mushaf-page-slider">
        <input type="range" tabindex="-1" dir="rtl" min="1" max="<%= mushaf.info.number_of_pages %>" value="<%= mushaf.number %>" aria-label="Go to Mushaf page" data-juz-starts="<%= JSON.stringify(quranHeaderJuzLinks.map(juz => [juz.startPage, juz.num])) %>">
        <span class="mushaf-slider-tip" aria-hidden="true"></span>
      </div>
      <button type="button" class="btn-close" aria-label="Close full-screen Mushaf" autofocus></button>
    </header>
    <div class="mushaf-book-spread" dir="rtl"></div>
  </dialog>
  <script defer src="/static/js/mushaf-book.js?v=<%= utils.scriptAssetVersion() %>"></script>
  <% } %>
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
  <%- include('sub-views/page_end.ejs', { site, page }); %>
  <% if (review && reviewPreviousLines && reviewPreviousLines.length) { %>
  <script>
    (function () {
      var context = document.querySelector('.quran-review-page-continuity');
      if (!context || typeof getQuranTafsirSettings !== 'function')
        return;
      getQuranTafsirSettings().then(function (settings) {
        var script = normalizeQuranScriptChoice(settings && settings.quran && settings.quran.script) || 'uthmani';
        updateQuranAyahMarkersForScript(context, script);
        if (script === 'uthmani')
          return;
        var words = Array.from(context.querySelectorAll('[data-quran-script-text="word-exact"][data-quran-ref][data-quran-word-number]'));
        var refs = Array.from(new Set(words.map(function (word) { return word.getAttribute('data-quran-ref'); }).filter(Boolean)));
        if (refs.length < 1)
          return;
        return fetchQuranScriptRefs(script, refs).then(function (payload) {
          words.forEach(function (word) {
            var ref = word.getAttribute('data-quran-ref') || '';
            var wordNumber = Number(word.getAttribute('data-quran-word-number'));
            var sourceWord = Array.from(payload.wordsByAyah && payload.wordsByAyah[ref] || []).find(function (candidate) {
              return Number(candidate.word) === wordNumber;
            });
            if (!sourceWord)
              return;
            word.textContent = sourceWord.text;
            word.setAttribute('data-quran-word', sourceWord.text);
            word.setAttribute('data-quran-script-applied', script);
          });
          if (typeof scheduleQuranMushafLineFit === 'function')
            scheduleQuranMushafLineFit(context);
        });
      }).catch(function () {});
    }());
  </script>
  <% } %>
</body>
</html>
