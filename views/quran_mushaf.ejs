<!doctype html>
<html lang="en">
<% var site = Object.assign({}, global.settings.site, { admin: req.admin, editMode: req.admin && req.editMode }); %>
<head>
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
</head>
<body>
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  <main class="container col-xl-7 col-lg-8 mx-auto quran-mushaf-reader<%= memorize ? ' quran-memorize-reader' : '' %> mt-10" data-quran-mushaf-reader data-page-help-tour="<%= memorize ? (review ? 'review' : 'memorize') : 'mushaf' %>"<% if (memorize) { %> data-quran-memorize-reader="1"<% } %><% if (review) { %> data-quran-review-reader="1"<% } %> data-next-url="<%= `/quran/page/${mushaf.number < mushaf.info.number_of_pages ? mushaf.number + 1 : 1}${memorize ? '?memorize' : ''}` %>">
    <% if (memorize && !review) { %>
    <div class="d-flex justify-content-center mb-3" data-quran-memorize-get-started>
      <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#quran-get-started-modal"><i class="bi bi-stars me-1" aria-hidden="true"></i>Get Started</button>
    </div>
    <% } %>
    <article class="quran-mushaf-page<%= memorize ? ' quran-memorize-page' : '' %>" data-quran-mushaf-page="<%= mushaf.number %>"<% if (memorize) { %> data-quran-memorize-page="1" data-quran-memorize-auto-hide="false"<% } %> data-quran-infinite-page="1" data-quran-audio-scope="quran-page-<%= mushaf.number %>">
      <div class="quran-selected-ayah-hero" data-quran-selected-ayah-hero data-quran-clear-href="/quran/page/<%= mushaf.number %>"></div>
      <% if (review && reviewPreviousLines && reviewPreviousLines.length) { %>
      <aside class="quran-review-page-continuity quran-mushaf-sheet quran-hafs quran-mushaf-sheet-<%= Number(mushaf.number - 1) % 2 === 0 ? 'even' : 'odd' %>" lang="ar" dir="rtl" aria-label="Final <%= reviewPreviousLines.length %> lines from Mushaf page <%= mushaf.number - 1 %>">
        <span class="quran-review-page-continuity-label" lang="en" dir="ltr">Previous page</span>
        <div class="quran-review-page-continuity-lines">
        <% reviewPreviousLines.forEach(function (line) { %>
          <div class="quran-mushaf-line quran-review-page-continuity-line" data-line-number="<%= line.line_number %>">
          <% line.words.forEach(function (word) { %>
            <% if (word.is_ayah_marker) { %>
            <span class="quran-review-page-continuity-marker quran-ayah-end-marker quran-mushaf-ayah-marker quran-mushaf-passage-tone-<%= word.passageTone === 1 ? 1 : 0 %>" data-quran-script-text="marker" data-quran-ref="<%= word.surah %>:<%= word.ayah %>" data-quran-marker-text="۝<%= arabic.toArabicDigits(word.ayah) %>" aria-label="End of Quran <%= word.surah %>:<%= word.ayah %>">۝<%= arabic.toArabicDigits(word.ayah) %></span>
            <% } else { %>
            <span class="quran-review-page-continuity-word quran-mushaf-passage-tone-<%= word.passageTone === 1 ? 1 : 0 %>" data-quran-script-text="word-exact" data-quran-ref="<%= word.surah %>:<%= word.ayah %>" data-quran-word="<%= word.text %>" data-quran-word-number="<%= word.word %>"><%= word.text %></span>
            <% } %>
          <% }); %>
          </div>
        <% }); %>
        </div>
      </aside>
      <% } %>
      <section class="quran-mushaf-sheet quran-hafs quran-mushaf-sheet-<%= Number(mushaf.number) % 2 === 0 ? 'even' : 'odd' %>" lang="ar" dir="rtl">
        <header class="quran-mushaf-page-heading" lang="en" dir="ltr">
          <% if (memorize) { %>
            <aside class="quran-mushaf-page-toolbar" lang="en" dir="ltr">
              <%- include('sub-views/quran_memorize_controls.ejs', { pageNumber: mushaf.number, showRating: false }); %>
            </aside>
          <% } else if (audioRanges.length) {
            var mushafAudioGroup = { _audioScopeId: `quran-page-${mushaf.number}`, _audioStartAyah: audioRanges[0].from, _audioEndAyah: audioRanges[audioRanges.length - 1].to, _headingAudioLabel: `page ${mushaf.number}` };
          %>
            <aside class="quran-ayah-select-toolbar quran-mushaf-page-toolbar" lang="en" dir="ltr">
              <button type="button" class="quran-mushaf-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-quran-mushaf-bookmark-page="<%= mushaf.number %>" title="Bookmark Mushaf page <%= mushaf.number %>" aria-label="Bookmark Mushaf page <%= mushaf.number %>"><span class="quran-mushaf-bookmark-icon bi bi-bookmark text-accent" aria-hidden="true"></span></button>
              <%- include('sub-views/quran_audio_control.ejs', { audioGroup: mushafAudioGroup, quranSelectionSurah: audioRanges[0].surah, audioRanges: audioRanges, repeatRanges: subsectionAudioRanges, showTranslationSelect: true }); %>
            </aside>
          <% } %>
          <span class="quran-mushaf-page-meta">
            <% if (firstJuz) { %><form data-quran-mushaf-juz-form><label>Juz <span class="visually-hidden">number</span><input type="text" inputmode="text" enterkeyhint="go" value="<%= firstJuz.num %>" aria-label="Juz number. Enter a Juz from 1 through 30."></label></form><% } %>
            <% if (firstJuz && firstSurah) { %><span aria-hidden="true">·</span><% } %>
            <% if (firstSurah) { %>
              <span class="quran-mushaf-surah-picker" lang="ar" dir="rtl"><span class="dropdown quran-mushaf-surah-picker-dropdown"><span class="quran-mushaf-surah-picker-label">سُورَةُ <%= firstSurah.name_ar || firstSurah.name_en || firstSurah.num %></span><button type="button" class="quran-mushaf-surah-picker-toggle dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Choose a Surah"></button><ul class="dropdown-menu quran-mushaf-surah-picker-menu" dir="rtl"><% (global.surahs || []).forEach(function (surah) { %><li><a class="dropdown-item<%= Number(surah.num) === Number(firstSurah.num) ? ' active' : '' %>" href="<%= utils.quranUrl(req, `/quran/${surah.num}?mushaf`) %>"<% if (Number(surah.num) === Number(firstSurah.num)) { %> aria-current="true"<% } %>><span class="quran-mushaf-surah-option-number"><%= surah.num %></span><span><%= surah.name_ar || surah.name_en || surah.num %></span></a></li><% }); %></ul></span></span>
              <span aria-hidden="true">·</span>
              <form data-quran-mushaf-surah-form><label><span class="visually-hidden">Surah number</span><input type="text" inputmode="text" enterkeyhint="go" value="<%= firstSurah.num %>" aria-label="Surah number. Enter a Surah from 1 through 114."></label></form>
            <% } %>
          </span>
          <span class="quran-mushaf-page-number">
            <form action="/quran/page" data-quran-mushaf-page-form>
              <label><span class="visually-hidden">Open Mushaf page 2 through <%= mushaf.info.number_of_pages %></span><input type="text" inputmode="text" enterkeyhint="go" value="<%= mushaf.number %>" aria-label="Mushaf page <%= mushaf.number %>. Enter a page from 2 through <%= mushaf.info.number_of_pages %>." title="Enter a page from 2 through <%= mushaf.info.number_of_pages %>"></label>
            </form>
          </span>
        </header>
      <% var firstMushafContentLine = mushaf.lines.find(function (line) { return line.line_type !== 'basmallah'; }); %>
      <% mushaf.lines.forEach(function (line) { %>
        <% if (line.line_type === 'basmallah') return; %>
        <div class="quran-mushaf-line quran-mushaf-line-<%= line.line_type %><%= line.is_centered ? ' is-centered' : '' %><%= line === firstMushafContentLine ? ' is-page-opening' : '' %>" data-line-number="<%= line.line_number %>">
        <% if (line.line_type === 'surah_name') {
          var surah = (global.surahs || []).find(function (item) { return Number(item.num) === Number(line.surah_number); });
          var memorizationSurahName = (surah && (surah.name_en || surah.name_ar)) || `Surah ${line.surah_number}`;
        %>
          <span class="quran-mushaf-surah-name" title="<%= (surah && surah.name_ar) || `سورة ${line.surah_number}` %>" aria-label="<%= (surah && surah.name_ar) || `سورة ${line.surah_number}` %>">
            <span class="quran-mushaf-surah-cartouche" aria-hidden="true"></span>
            <span class="quran-mushaf-surah-title" style="--quran-mushaf-surah-title-svg: url('<%= utils.quranSurahHeaderSvgPath(line.surah_number) %>');" aria-hidden="true"></span>
          </span>
          <% if (memorize && !review) { %><button type="button" class="quran-mushaf-surah-state-toggle" data-quran-surah-state="<%= line.surah_number %>" data-quran-surah-name="<%= memorizationSurahName %>" aria-haspopup="menu" aria-expanded="false" aria-label="Set the initial memorization self-assessment for <%= memorizationSurahName %>. Current state: Later" lang="en" dir="ltr" hidden><span data-quran-surah-state-current>Later</span><span class="bi bi-chevron-down" aria-hidden="true"></span></button><% } %>
        <% } else { line.words.forEach(function (word) {
          var ref = `${word.surah}:${word.ayah}`;
          if (word.is_ayah_marker) { %>
            <span class="quran-mushaf-ayah-marker-state-wrap"><% if (memorize) { %><span class="quran-ayah-end-marker quran-mushaf-ayah-marker quran-mushaf-passage-tone-<%= word.passageTone === 1 ? 1 : 0 %><%= selectedAyahRef === ref ? ' quran-audio-active-ayah quran-mushaf-search-ayah' : '' %>" data-quran-ref="<%= ref %>" aria-label="End of Quran <%= ref %>">۝<%= arabic.toArabicDigits(word.ayah) %></span><% } else { %><a class="quran-ayah-end-marker quran-mushaf-ayah-marker quran-mushaf-passage-tone-<%= word.passageTone === 1 ? 1 : 0 %><%= selectedAyahRef === ref ? ' quran-audio-active-ayah quran-mushaf-search-ayah' : '' %>" data-quran-ayah-actions="1" data-quran-ref="<%= ref %>" href="<%= utils.quranUrl(req, `/quran:${ref}`) %>" aria-label="Actions for Quran <%= ref %>" aria-haspopup="menu" aria-expanded="false" aria-controls="quran-mushaf-ayah-actions" title="Quran <%= ref %> actions">۝<%= arabic.toArabicDigits(word.ayah) %></a><button type="button" class="quran-ayah-state-toggle quran-mushaf-ayah-actions-toggle" data-quran-ayah-actions="1" data-quran-ref="<%= ref %>" data-quran-href="<%= utils.quranUrl(req, `/quran:${ref}`) %>" aria-haspopup="menu" aria-expanded="false" aria-controls="quran-mushaf-ayah-actions" aria-label="Play or study Quran <%= ref %>"><span class="bi bi-caret-down-square-fill" aria-hidden="true"></span></button><% } %></span>
          <% } else { %>
            <span class="quran-corpus-word quran-mushaf-passage-tone-<%= word.passageTone === 1 ? 1 : 0 %><%= word.juzStart ? ' quran-juz-start-word' : '' %><%= word.juzStartFirst ? ' quran-juz-start-first-word' : '' %><%= selectedAyahRef === ref ? ' quran-audio-active-ayah quran-mushaf-search-ayah' : '' %>" data-quran-script-text="word" data-quran-ref="<%= ref %>" data-quran-word="<%= word.text %>" data-quran-word-number="<%= word.word %>" data-quran-word-translation="<%= word.meaning_en || '' %>" data-quran-word-grammar="<%= word.grammar_parts_of_speech || word.parts_of_speech || '' %>"<% if (word.juzStart) { %> data-quran-juz="<%= word.juzStart %>" title="Beginning of Juz <%= word.juzStart %>"<% } %> tabindex="0"><%= word.text %></span>
          <% }
        }); } %>
        </div>
        <% if (line.line_type === 'surah_name' && ![1, 9].includes(Number(line.surah_number))) { %>
        <div class="quran-mushaf-line quran-mushaf-line-basmallah is-centered" data-quran-basmallah-for="<%= line.surah_number %>" role="img" aria-label="بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ">
          <img class="quran-mushaf-basmallah-svg" src="/static/img/quran/surah-header/basmala.svg" alt="" aria-hidden="true">
        </div>
        <% } %>
      <% }); %>
        <% if (memorize) { %>
        <footer class="quran-mushaf-page-footer quran-memorize-page-footer" lang="en" dir="ltr">
          <%- include('sub-views/quran_memorize_controls.ejs', { pageNumber: mushaf.number, showRating: true }); %>
        </footer>
        <aside class="quran-memorization-state-legend" aria-labelledby="quran-memorization-state-legend-<%= mushaf.number %>" lang="en" dir="ltr" data-quran-page-state-summary>
          <div class="quran-memorization-state-legend-heading"><h2 id="quran-memorization-state-legend-<%= mushaf.number %>"><%= review ? 'Session progress' : 'Page memorization' %> <span <%= review ? 'data-quran-review-session-total' : 'data-quran-page-state-total' %>>—</span></h2><div class="quran-memorization-state-legend-actions"><% if (!review) { %><button type="button" class="quran-mushaf-page-state-toggle" data-quran-page-state="<%= mushaf.number %>" aria-haspopup="menu" aria-expanded="false" aria-controls="quran-page-state-menu" aria-label="Set the initial memorization self-assessment for Mushaf page <%= mushaf.number %>. Current state: Later" hidden><span data-quran-page-state-current>Later</span><span class="bi bi-chevron-down" aria-hidden="true"></span></button><% } %><button type="button" class="quran-memorization-help-trigger" data-page-help-tour-trigger="<%= review ? 'review' : 'memorize' %>"><i class="bi bi-lightbulb" aria-hidden="true"></i> Show tips</button><button type="button" class="quran-memorization-help-trigger" data-bs-toggle="modal" data-bs-target="#quran-memorization-help-modal"><i class="bi bi-question-circle" aria-hidden="true"></i> How it works</button></div></div>
          <% if (review) { %>
          <ul data-quran-review-session-progress aria-label="Review session progress">
            <li class="quran-memorization-state-pill is-again" data-quran-review-session-category="again" hidden><span class="quran-memorization-state-legend-swatch" aria-hidden="true"></span><strong>Again</strong><span class="quran-page-state-count" data-quran-review-session-category-count>—</span></li>
            <% [['learning','Learning'],['weak','Hard'],['review','Good'],['core','Easy'],['suspended','Paused']].forEach(function (item) { %>
            <li class="quran-memorization-state-pill is-<%= item[0] %>" data-quran-review-session-category="<%= item[0] %>" hidden><span class="quran-memorization-state-legend-swatch" aria-hidden="true"></span><strong><%= item[1] %></strong><span class="quran-page-state-count" data-quran-review-session-category-count>—</span></li>
            <% }); %>
          </ul>
          <% } else { %>
          <ul>
            <li class="quran-memorization-state-pill is-learning" title="Actively memorizing"><span class="quran-memorization-state-legend-swatch" aria-hidden="true"></span><strong>Learning</strong><span class="visually-hidden">Actively memorizing</span></li>
            <li class="quran-memorization-state-pill is-weak" title="Hard recall with shorter reviews"><span class="quran-memorization-state-legend-swatch" aria-hidden="true"></span><strong>Hard</strong><span class="visually-hidden">Hard recall with shorter reviews</span></li>
            <li class="quran-memorization-state-pill is-review" title="Good recall under review"><span class="quran-memorization-state-legend-swatch" aria-hidden="true"></span><strong>Good</strong><span class="visually-hidden">Good recall under review</span></li>
            <li class="quran-memorization-state-pill is-core" title="Easy recall with no scheduled reviews"><span class="quran-memorization-state-legend-swatch" aria-hidden="true"></span><strong>Easy</strong><span class="visually-hidden">Easy recall with no scheduled reviews</span></li>
            <li class="quran-memorization-state-pill is-suspended" title="Temporarily inactive"><span class="quran-memorization-state-legend-swatch" aria-hidden="true"></span><strong>Paused</strong><span class="visually-hidden">Temporarily inactive</span></li>
            <li class="quran-memorization-state-pill is-later" title="Not started yet"><span class="quran-memorization-state-legend-swatch" aria-hidden="true"></span><strong>Later</strong><span class="visually-hidden">Not started yet</span></li>
          </ul>
          <% } %>
        </aside>
        <% } else if (pagePassages && pagePassages.length) { %>
        <footer class="quran-mushaf-page-footer" lang="en" dir="ltr">
          <p class="quran-mushaf-page-passage">
          <% pagePassages.forEach(function (passage) {
            var passageTitle = passage.title_en || passage.title || `Passage ${passage.section}`;
          %>
            <% if (passage.showPassageTitle) { %>
            <span class="quran-mushaf-page-passage-ref"><%= passage.surah %>.<%= passage.section %></span>
            <a class="quran-mushaf-page-passage-title" href="<%= utils.quranUrl(req, `/quran/${passage.surah}/${passage.section}`) %>"><%= passageTitle %></a>;
            <% } %><% (passage.subsections || []).forEach(function (subsection) {
              var subsectionTitle = subsection.title_en || subsection.title || `Subsection ${subsection.subsection}`;
            %>
            <span class="quran-mushaf-page-subsection-ref"><%= subsection.surah %>:<%= subsection.start %></span>
            <a href="<%= utils.quranUrl(req, `/quran/${subsection.surah}/${subsection.section}/${subsection.subsection}`) %>"><%= subsectionTitle %></a>;<% }); %>
          <% }); %>
          </p>
        </footer>
        <% } %>
      </section>
    </article>
    <div class="quran-mushaf-sentinel text-center py-4" data-quran-mushaf-sentinel role="status" aria-live="polite"></div>
  </main>
  <% if (memorize) { %><%- include('sub-views/quran_memorization_help_modal.ejs', { site: site, page: page }); %><% if (!review) { %><%- include('sub-views/quran_memorize_review_modal.ejs', { site: site, page: page }); %><%- include('sub-views/quran_get_started_modal.ejs', { site: site, page: page }); %><% } %><% } %>
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page, helpTour: memorize ? (review ? 'review' : 'memorize') : 'mushaf' }); %>
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  <% if (review && reviewPreviousLines && reviewPreviousLines.length) { %>
  <script>
    (function () {
      var context = document.querySelector('.quran-review-page-continuity');
      if (!context || typeof getQuranTafsirSettings !== 'function')
        return;
      getQuranTafsirSettings().then(function (settings) {
        var script = normalizeQuranScriptChoice(settings && settings.quran && settings.quran.script) || 'uthmani';
        updateQuranAyahMarkersForScript(context, script);
        if (script === 'uthmani')
          return;
        var words = Array.from(context.querySelectorAll('[data-quran-script-text="word-exact"][data-quran-ref][data-quran-word-number]'));
        var refs = Array.from(new Set(words.map(function (word) { return word.getAttribute('data-quran-ref'); }).filter(Boolean)));
        if (refs.length < 1)
          return;
        return fetch(`${quranApiPath(`/quran/script/${encodeURIComponent(script)}`)}?refs=${encodeURIComponent(refs.join(','))}`, {
          credentials: 'same-origin',
          cache: 'no-store',
          headers: { 'Accept': 'application/json' }
        }).then(function (response) {
          if (!response.ok)
            throw new Error('Unable to load the selected Quran script.');
          return response.json();
        }).then(function (payload) {
          words.forEach(function (word) {
            var ref = word.getAttribute('data-quran-ref') || '';
            var wordNumber = Number(word.getAttribute('data-quran-word-number'));
            var sourceWord = Array.from(payload.wordsByAyah && payload.wordsByAyah[ref] || []).find(function (candidate) {
              return Number(candidate.word) === wordNumber;
            });
            if (!sourceWord)
              return;
            word.textContent = sourceWord.text;
            word.setAttribute('data-quran-word', sourceWord.text);
            word.setAttribute('data-quran-script-applied', script);
          });
          if (typeof scheduleQuranMushafLineFit === 'function')
            scheduleQuranMushafLineFit(context);
        });
      }).catch(function () {});
    }());
  </script>
  <% } %>
</body>
</html>
