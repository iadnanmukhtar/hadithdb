<!doctype html>
<html lang="en">

<head> 
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;
    
    var page = {
      menu: 'Home',
      title_en: `${site.name} | ${site.desc}`,
      description_en: 'Search and study hadith collections with Arabic text, English translations, references, chapter headings, and related narrations.',
      subtitle_en: 'Home',
      subtitle: null,
      canonical: `/`,
      context: {},
    };
    if (random) {
      page.context.chapter = random.chapter;
      page.context.section = random.section;
      page.context.hadiths = results;
      if (random.prev_ref)
          page.prev = `/${random.prev_ref}`;
      if (random.next_ref)
          page.next = `/${random.next_ref}`;
    }
	var homeHadithItem = random && random.remark != 2 ? random : null;
%> 

<%- include('sub-views/head.ejs', { site: site, page: page }); %> 

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %> 

  <div class="<%= homeHadithItem ? 'container-fluid hadith-heading-layout hadith-metadata-page-layout' : 'container col-lg-8 mx-auto' %>">
    <% if (homeHadithItem) { %><div class="container col-lg-8 mx-auto hadith-heading-content"><% } %>
    
    <main class="search-results">

      <section class="home-quran-announcement" data-home-quran-announcement hidden>
        <div>
          <p class="home-quran-announcement-text">Explore the Qurʾān—and keep your hifz fresh with Mudhakkir</p>
          <p class="home-quran-announcement-blurb mb-0">Read connected passages with classical tafāsīr in English and Arabic, plus highlighting, bookmarks, reflections, and sharing. Mudhakkir adds focused memorization, adaptive spaced-repetition reviews, and progress tracking that stays synced across your devices.</p>
        </div>
        <div class="home-quran-announcement-actions">
          <a class="home-quran-announcement-logo-link" href="/quran:1:1" title="Explore Quran Unlocked">
            <img class="home-quran-announcement-logo" src="/static/img/quran-logo2.svg" width="112" height="112" alt="Quran Unlocked">
          </a>
          <a class="home-quran-announcement-logo-link" href="/quran/review?help" title="Discover Mudhakkir">
            <img class="home-quran-announcement-logo" src="/static/img/quran/mudhakkir.svg" width="112" height="112" alt="Mudhakkir">
          </a>
          <button type="button" class="btn btn-sm btn-outline-secondary home-quran-announcement-close" data-home-quran-announcement-close title="Close announcement" aria-label="Close announcement">
            <span class="bi bi-x" aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <%- include('sub-views/bookNav.ejs'); %> 
      
      <% if (typeof random !== 'undefined') { %>
        <header class="row">
          <h3 class="col-12 fs-4">Random <%= random.remark==2 ? 'āyah' : 'ḥadīth' %> <a class="text-muted" href="/"><i class="bi bi-arrow-clockwise"></i></a></h3>
        </header>
        
        <% if (random.remark == 2) {
          var randomAyahRef = random.en?.num || random.num || random.ref || '';
          var randomAyahHrefRef = arabic.toLatinDigits(randomAyahRef.toString()).replace(/^quran:/, '');
          var randomAyahHref = utils.quranUrl(req, `/quran:${randomAyahHrefRef}`);
          var randomQuranShareId = `Q${randomAyahRef.replace(/[^A-Za-z0-9_-]/g, '-')}`;
        %>
          <%- include('sub-views/quran_ayah_hero.ejs', {
            site: site,
            page: page,
            selectedAyahs: [random],
            ayahHref: randomAyahHref,
            toolbar: {
              selectedAyahModalIndex: 0,
              selectedAyahId: random.id,
              viewHref: randomAyahHref,
              quranShareId: randomQuranShareId
            }
          }); %>
          <%- include('sub-views/quran_ayah_modal.ejs', { site: site, page: page, passage: [random] }); %>
          <%- include('sub-views/quran_modal.ejs', { site: site, page: page, selectedAyahs: [random], quranShareId: randomQuranShareId }); %>
        <% } else { %>
          <%- include('sub-views/hadith.ejs', { site: site, page: page, i: random, main: true, title: true, searchResult: false }); %>
        <% } %>

        <hr>
      <% } %>

      <% if (results) { %>

      <header class="row">
        <h3 class="col-12 fs-4">Recent translations of beautiful and notable aḥādīth</h3>
      </header>

      <% for (var i = 0; i < results.length; i++) { %>

        <% if (i == 2) { %>
        <%#
        <div class="col-12 mt-3 mb-3">
          <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1199080602686133"
            crossorigin="anonymous"></script>
            <ins class="adsbygoogle"
              style="display:block; text-align:center;"
              data-ad-layout="in-article"
              data-ad-format="fluid"
              data-ad-client="ca-pub-1199080602686133"
              data-ad-slot="7623204143"></ins>
          <script>
            (adsbygoogle = window.adsbygoogle || []).push({});
          </script>
        </div>
        %>
        <% } %>

        <%- include('sub-views/hadith.ejs', { site: site, page: page, i: results[i], main: true, title: true, searchResult: false }); %>

      <% }
        } %>

    </main>
    <% if (homeHadithItem) { %></div><%- include('sub-views/hadith_metadata_rail.ejs', { i: homeHadithItem, mobile: false, navigationOnly: true }); %><% } %>
  </div>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

</body>
</html>
