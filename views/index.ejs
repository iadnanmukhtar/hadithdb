<!doctype html>
<html lang="en">

<head> 
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;
    
    var page = {
      menu: 'Home',
      title_en: `${site.name} | ${site.desc}`,
      subtitle_en: 'Home',
      subtitle: null,
      canonical: `/`,
      context: {},
    };
    if (random) {
      page.context.chapter = random.chapter;
      page.context.section = random.section;
      page.context.hadiths = results;
      if (random.prev_ref)
          page.prev = `/${random.prev_ref}`;
      if (random.next_ref)
          page.next = `/${random.next_ref}`;
    }
%> 

<%- include('sub-views/head.ejs', { site: site, page: page }); %> 

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %> 

  <div class="container col-lg-8 mx-auto">
    
    <main class="search-results">

      <section class="home-quran-announcement" data-home-quran-announcement>
        <div>
          <p class="home-quran-announcement-text">A Qurʾān and Tafsīr experience built for students of knowledge</p>
          <p class="home-quran-announcement-blurb mb-0">Read the Qurʾān organized into connected passages for better comprehension, with classical tafāsīr in English and Arabic alongside each āyah. Highlight, bookmark, and reflect on passages as you read, with sharing tools built right in. This is the Qurʾān as a living study companion.</p>
        </div>
        <div class="home-quran-announcement-actions">
          <a class="btn btn-primary btn-sm" href="/quran:1:1">
            <span class="bi bi-book"></span>
            <span>Explore</span>
          </a>
          <button type="button" class="btn btn-sm btn-outline-secondary home-quran-announcement-close" data-home-quran-announcement-close title="Close announcement" aria-label="Close announcement">
            <span class="bi bi-x" aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <form class="form-group" action="/">
        <search class="search container pt-3 mb-3">
          <div class="row justify-content-md-center">
            <div class="col-md-8">
              
              <div class="input-group mb-1">
                <input role="search" id="search-bar" name="q" type="text" class="search-bar form-control" placeholder="Search hadīth, āyāt, or tafāsīr..." autofocus>
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <i class="bi bi-book"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="commentaries" <%= (b.indexOf('commentaries') >= 0) ? 'checked' : '' %>>
                    <label class="form-check-label">Tafāsīr</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="toc" <%= (b.indexOf('toc') >= 0) ? 'checked' : '' %>>
                    <label class="form-check-label">Ḥadīth Chapters</label>
                  </div>
                  <% global.books.filter(b => {return !b.virtual && !b.hidden;}).forEach(bk => { %>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="<%= bk.alias %>" <%=(b.indexOf(bk.alias) >= 0) ? 'checked' : ''%>>
                    <label class="form-check-label"><%=bk.shortName_en%></label>
                  </div>
                  <% if (bk.alias === 'quran') { %>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="sahihayn" <%= (b.indexOf('sahihayn') >= 0) ? 'checked' : '' %>>
                    <label class="form-check-label">Saḥīḥayn</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="b" value="sixbooks" <%= (b.indexOf('sixbooks') >= 0) ? 'checked' : '' %>>
                    <label class="form-check-label">Kutub Sittah</label>
                  </div>
                  <% } %>
                  <% }); %>
                  
                </div>
                <div class="caution partial l2" lang="en">
                  <strong>Caution:</strong>
                  Translations of Quran and Ḥadīth may lead to possible misapplications and misinterpretations.  
                  This site is intended for students of sacred knowledge that are proficient in comprehending 
                  classical Arabic and have a strong foundation in Islamic sciences. Also note that religious 
                  injunctions rely on several aspects beyond what one may glean through reading individual aḥādīth.
                  </footnote>
                </div>
                
              </div>
            </div>
          </div>
        </search>
      </form>

      <%- include('sub-views/bookNav.ejs'); %> 
      
      <% if (typeof random !== 'undefined') { %>
        <header class="row">
          <h3 class="col-12 fs-4">Random <%= random.remark==2 ? 'āyah' : 'ḥadīth' %> <a class="text-muted" href="/"><i class="bi bi-arrow-clockwise"></i></a></h3>
        </header>
        
        <div class="row mb-2 pagination">
          <div class="col-md-6 col-xs-12 text-start pagination-nav-slot pagination-nav-slot-prev">
            <% if (page.prev) { %>
            <a class="pagination-nav-link" rel="prev" href="<%= page.prev %>" title="<%= page.prev %>"><span class="pagination-nav-chevron bi bi-chevron-left" aria-hidden="true"></span><span class="pagination-nav-label">&nbsp;Prev</span></a>
            <% } %>
          </div>
          <div class="col-md-6 col-xs-12 text-end pagination-nav-slot pagination-nav-slot-next">
            <% if (page.next) { %>
              <a class="pagination-nav-link" rel="next" href="<%= page.next %>" title="<%= page.next %>"><span class="pagination-nav-label">Next&nbsp;</span><span class="pagination-nav-chevron bi bi-chevron-right" aria-hidden="true"></span></a>
              <% } %>
            </div>
        </div>
        
        <% if (random.remark == 2) {
          var randomAyahRef = random.en?.num || random.num || random.ref || '';
          var randomAyahHrefRef = arabic.toLatinDigits(randomAyahRef.toString()).replace(/^quran:/, '');
          var randomAyahHref = utils.quranUrl(req, `/quran:${randomAyahHrefRef}`);
          var randomQuranShareId = `Q${randomAyahRef.replace(/[^A-Za-z0-9_-]/g, '-')}`;
        %>
          <%- include('sub-views/quran_ayah_hero.ejs', { site: site, page: page, selectedAyahs: [random] }); %>
          <aside class="tags quran-ayah-hero-toolbar">
            <a href="<%= randomAyahHref %>" title="View random ayah" aria-label="View random ayah" class="quran-ayah-action icon text-decoration-none">
              <span class="bi bi-book"></span><span class="quran-ayah-action-label">View</span>
            </a>
            <a href="#<%= randomQuranShareId %>" type="button" title="Share random ayah image" aria-label="Share random ayah image" class="quran-ayah-action icon text-decoration-none" data-bs-toggle="modal" data-bs-target="#<%= randomQuranShareId %>">
              <span class="bi bi-box-arrow-up"></span><span class="quran-ayah-action-label">Share</span>
            </a>
          </aside>
          <%- include('sub-views/quran_modal.ejs', { site: site, page: page, selectedAyahs: [random], quranShareId: randomQuranShareId }); %>
        <% } else { %>
          <%- include('sub-views/hadith.ejs', { site: site, page: page, i: random, main: true, title: true, searchResult: false }); %>
        <% } %>

        <hr>
      <% } %>

      <% if (results) { %>

      <header class="row">
        <h3 class="col-12 fs-4">Recent translations of beautiful and notable aḥādīth</h3>
      </header>

      <% for (var i = 0; i < results.length; i++) { %>

        <% if (i == 2) { %>
        <%#
        <div class="col-12 mt-3 mb-3">
          <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1199080602686133"
            crossorigin="anonymous"></script>
            <ins class="adsbygoogle"
              style="display:block; text-align:center;"
              data-ad-layout="in-article"
              data-ad-format="fluid"
              data-ad-client="ca-pub-1199080602686133"
              data-ad-slot="7623204143"></ins>
          <script>
            (adsbygoogle = window.adsbygoogle || []).push({});
          </script>
        </div>
        %>
        <% } %>

        <%- include('sub-views/hadith.ejs', { site: site, page: page, i: results[i], main: true, title: true, searchResult: false }); %>

      <% }
        } %>

    </main>
  </div>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

</body>
</html>
