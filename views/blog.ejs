<!doctype html>
<html lang="en">
<head>
<% 
    var site = new Object(global.settings.blog);
    site.admin = false;
    site.editMode = false;
    
    var pagination = locals.pagination || { number: 1, hasPrev: false, hasNext: false, offset: 0, prevOffset: 0, nextOffset: 0 };

    var page = {
      menu: 'Blog',
      title_en: `Pearls of the Deep Blog`,
      description_en: 'Read Pearls of the Deep articles exploring Islamic faith, spiritual growth, Quran, hadith, and lessons for everyday life.',
      subtitle_en: `Blog Posts`,
      subtitle: ``,
      canonical: `/`,
      feed: `${site.url}/feed`,
      rss: `${site.url}/rss`,
      context: {}
    };
    if (pagination.offset) {
      page.canonical += `?o=${pagination.offset}`;
      if (pagination.hasNext || pagination.number > 1) {
        page.title_en += ` | Page ${pagination.number}`;
        page.description_en += ` Browse page ${pagination.number} of the article archive.`;
      }
    }
    if (pagination.hasPrev)
      page.prev = `/blog?o=${pagination.prevOffset}`;
    if (pagination.hasNext)
      page.next = `/blog?o=${pagination.nextOffset}`;
%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %> 

</head>
<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %> 

  <main class="container py-4 community" id="community" data-view="blog">
    <div class="community-heading"><h1>Pearls of the Deep</h1><p class="community-intro"><%= page.description_en %></p></div>
    <p id="community-status" class="small text-muted" role="status" aria-live="polite"></p>
    <div class="community-columns"><section class="community-wall" aria-label="Blog articles">
      <div class="posts community-feed" data-blog-infinite="1" data-blog-current-url="<%= req.originalUrl || req.url || '/blog' %>" data-blog-page-number="<%= pagination.number %>"<% if (page.prev) { %> data-blog-prev-url="<%= page.prev %>"<% } %><% if (page.next) { %> data-blog-next-url="<%= page.next %>"<% } %>>
      <% for (const item of feedItems) { %>
        <div data-blog-feed-entry>
          <script type="application/json" data-blog-feed-item><%- JSON.stringify(item).replace(/</g, '\\u003c') %></script>
          <%- include('sub-views/community_card.ejs', {item}); %>
        </div>
      <% } %>
      </div>
      <div class="reader-infinite-status text-muted small" data-blog-infinite-status aria-live="polite"></div>
      <div class="reader-infinite-sentinel" data-blog-infinite-sentinel aria-hidden="true"></div>
    </section><%- include('sub-views/community_rail.ejs'); %></div>
  </main>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

<script src="<%= utils.staticAssetUrl('/static/js/community-cover-cards.js') %>"></script>
<script src="<%= utils.staticAssetUrl('/static/js/community.js') %>"></script>
<script src="<%= utils.staticAssetUrl('/static/js/community-media.js') %>"></script>
<script src="<%= utils.staticAssetUrl('/static/js/community-social-share.js') %>" defer></script>
</body>
</html>
