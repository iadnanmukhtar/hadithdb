<!doctype html>
<html lang="en">
<head>
<% 
    var site = Object.assign({}, global.settings.site);
    site.admin = (!locals.noadmin && req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;

    var page = {
    menu: 'Books',
    title_en: `Hadith Unlocked | All Books`,
    description_en: 'Browse hadith collections with Arabic source texts, English translations, chapter navigation, references, and downloadable editions.',
    subtitle_en: `Available Books`,
    subtitle: ``,
    canonical: `/books`,
    context: {}
    };
    var initialBookCatalogType = req && req.query && req.query.tab === 'history' ? 'sirah' : 'hadith';
    var tafsirBookUrl = function (tafsir) {
      var slug = tafsir.slug || Tafsir.tafsirSlug(tafsir.alias);
      return utils.quranUrl(req, `/quran/tafsir/${encodeURIComponent(slug)}`);
    };
    var translationBookUrl = function (translation) {
      return utils.quranUrl(req, `/quran/${encodeURIComponent(translation.quranBookSlug || translation.alias)}`);
    };
    var downloadLinksFor = function (book) {
      return BookDownloads.relativeDownloadLinks(book);
    };
    var tafsirDeathLabel = function (tafsir) {
      var death = utils.emptyIfNull(tafsir.death || '').toString().trim();
      if (!death)
        return '';
      if (!/\b(?:AH|H)\b/i.test(death) && !/هـ/u.test(death))
        death = `${death} AH`;
      return /^d\./i.test(death) ? death : `d. ${death}`;
    };
    var tafsirArabicDeathLabel = function (tafsir) {
      var death = utils.emptyIfNull(tafsir.death || '').toString().trim();
      if (!death)
        return '';
      death = death.replace(/\b(?:AH|H)\b/ig, '').replace(/هـ/u, '').trim();
      return `ت. ${death} هـ`;
    };
    var tafsirDeathYear = function (tafsir) {
      var match = utils.emptyIfNull(tafsir.death || '').toString().match(/\d+/);
      return match ? Number(match[0]) : NaN;
    };
    var tafsirPublishedYear = function (tafsir) {
      var match = utils.emptyIfNull(tafsir.published_year || '').toString().match(/\d+/);
      return match ? Number(match[0]) : NaN;
    };
    var tafsirSortName = function (tafsir) {
      return tafsir.shortName_en || tafsir.name_en || tafsir.shortName || tafsir.title || tafsir.alias || '';
    };
    var commentaryPublicationLabel = function (book) {
      return [
        book && book.published_year ? `Pub. ${book.published_year}` : '',
        book && book.publisher ? book.publisher : ''
      ].filter(Boolean).join(', ');
    };
    var translationDeathLabel = function (translation) {
      var death = utils.emptyIfNull(translation.death || '').toString().trim();
      if (!death)
        return '';
      if (!/\bCE\b/i.test(death))
        death = `${death} CE`;
      return /^d\./i.test(death) ? death : `d. ${death}`;
    };
    var tafsirGroups = [
      { key: 'all', heading: 'Tafsir', tafsirs: (tafsirs || []).slice() }
    ].map(function (group) {
      group.tafsirs.sort(function (a, b) {
        if (Tafsir.isDefaultTafsir(a) !== Tafsir.isDefaultTafsir(b))
          return Tafsir.isDefaultTafsir(a) ? -1 : 1;
        var aDeath = tafsirDeathYear(a);
        var bDeath = tafsirDeathYear(b);
        var aHasDeath = Number.isFinite(aDeath) && aDeath > 0;
        var bHasDeath = Number.isFinite(bDeath) && bDeath > 0;
        if (aHasDeath && bHasDeath && aDeath !== bDeath)
          return aDeath - bDeath;
        if (aHasDeath !== bHasDeath)
          return aHasDeath ? -1 : 1;
        if (!aHasDeath && !bHasDeath) {
          var aPublished = tafsirPublishedYear(a);
          var bPublished = tafsirPublishedYear(b);
          var aHasPublished = Number.isFinite(aPublished) && aPublished > 0;
          var bHasPublished = Number.isFinite(bPublished) && bPublished > 0;
          if (aHasPublished && bHasPublished && aPublished !== bPublished)
            return bPublished - aPublished;
          if (aHasPublished !== bHasPublished)
            return aHasPublished ? -1 : 1;
        }
        return tafsirSortName(a).localeCompare(tafsirSortName(b));
      });
      return group;
    });
    var catalogBookGroups = {
      hadith: BookGroups.list('hadith'),
      tafsir: BookGroups.list('tafsir')
    };
    var catalogGroupIds = function (alias, scope) {
      return (catalogBookGroups[scope] || []).filter(function (group) {
        return group.aliases.indexOf(alias) >= 0;
      }).map(function (group) { return group.id; });
    };
    var catalogTabButton = function (id, heading, isActive) {
      return `
        <li class="nav-item" role="presentation">
          <button class="nav-link${isActive ? ' active' : ''}" id="${id}-tab" data-bs-toggle="tab" data-bs-target="#${id}" type="button" role="tab" aria-controls="${id}" aria-selected="${isActive ? 'true' : 'false'}">${heading}</button>
        </li>
      `;
    };
    var bookLanguageBadge = function (book) {
      if (book && book.catalog_language_badge)
        return book.catalog_language_badge;
      var lang = utils.emptyIfNull(book && book.lang || '').toString().toLowerCase();
      if (lang === 'ar-en' || lang === 'en-ar')
        return 'EN-AR';
      if (lang === 'en')
        return 'EN';
      return 'AR';
    };
    var htmlToPlainText = function (value) {
      return utils.emptyIfNull(value || '')
        .toString()
        .replace(/<[^>]*>/g, ' ')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/[*_`#>]+/g, '')
        .replace(/\s+/g, ' ')
        .trim();
    };
    var commentaryDescriptionPreview = function (description) {
      return htmlToPlainText(description.split(/\r?\n/).map(function (line) {
        return line.trim();
      }).find(Boolean) || description);
    };
    var commentaryDescriptionId = function (group, book) {
      return `book-catalog-commentary-description-${group.key}-${utils.emptyIfNull(book.alias || '').replace(/[^A-Za-z0-9_-]+/g, '-')}`;
    };
    var bookDescriptionId = function (book) {
      return `book-catalog-book-description-${utils.emptyIfNull(book.alias || '').replace(/[^A-Za-z0-9_-]+/g, '-')}`;
    };
    var tafsirSizeLabel = function (tafsir) {
      var size = utils.emptyIfNull(tafsir && tafsir.size || '').toString();
      if (size === 'lg')
        return 'Large tafsir';
      if (size === 'md')
        return 'Medium tafsir';
      if (size === 'sm')
        return 'Small tafsir';
      return '';
    };
    var tafsirSizeIndicator = function (tafsir) {
      var size = utils.emptyIfNull(tafsir && tafsir.size || '').toString();
      var label = tafsirSizeLabel(tafsir);
      if (!label)
        return '';
      return `<span class="tafsir-size-indicator tafsir-size-tooltip tafsir-size-indicator-${size}" title="${label}" data-tafsir-size-tooltip="${label}" aria-label="${label}" role="img"></span>`;
    };
    var hadithSizeLabel = function (book) {
      var size = utils.emptyIfNull(book && book.size || '').toString();
      if (size === 'lg')
        return 'Large hadith';
      if (size === 'md')
        return 'Medium hadith';
      if (size === 'sm')
        return 'Small hadith';
      return '';
    };
    var hadithSizeIndicator = function (book) {
      var size = utils.emptyIfNull(book && book.size || '').toString();
      var label = hadithSizeLabel(book);
      if (!label)
        return '';
      return `<span class="hadith-size-indicator tafsir-size-tooltip hadith-size-indicator-${size}" title="${label}" data-tafsir-size-tooltip="${label}" aria-label="${label}" role="img"></span>`;
    };
%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %> 

</head>
<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %> 

  <div class="container col-lg-8 mx-auto">

    <main class="book-catalog-page">

    <%- utils.jsonLdScript({
      '@context': 'https://schema.org',
      '@type': 'Table',
      name: 'Available Books',
      about: 'Available Books of Ḥadīth, History, Tafsīr, and Quran Translations'
    }) %>

    <nav class="h-menu-wrap home-hadith-book-nav book-catalog-group-filters mb-3" aria-label="Filter books">
      <div class="h-menu-scroller">
        <div class="btn-group h-menu text-nowrap" role="group">
          <label class="book-carousel-filter">
            <span class="bi bi-search" aria-hidden="true"></span>
            <input type="search" class="book-carousel-filter-input book-catalog-filter" placeholder="Filter books" aria-label="Filter ḥadīth, tafsīr, and translation books" autocomplete="off" autofocus>
          </label>
          <button type="button" class="btn btn-outline-primary active" data-book-catalog-group-filter="" aria-pressed="true">All</button>
          <button type="button" class="btn btn-outline-primary d-none" data-book-catalog-language-filter="en" data-book-catalog-group-scope="tafsir" aria-pressed="false">English</button>
          <button type="button" class="btn btn-outline-primary d-none" data-book-catalog-language-filter="ar" data-book-catalog-group-scope="tafsir" aria-pressed="false">Arabic</button>
          <% Object.keys(catalogBookGroups).forEach(function (scope) { catalogBookGroups[scope].forEach(function (group) { %>
            <button type="button" class="btn btn-outline-primary<%= scope === 'hadith' ? '' : ' d-none' %>" data-book-catalog-group-filter="<%= group.id %>" data-book-catalog-group-scope="<%= scope %>" aria-pressed="false"><%= group.label %></button>
          <% }); }); %>
        </div>
      </div>
    </nav>

    <section class="book-catalog-tabs-section mb-4">
      <ul class="nav nav-tabs book-catalog-tabs mb-3" role="tablist">
        <% tafsirGroups.forEach(function (group) { %>
          <% var sectionId = `book-catalog-tafsir-${group.key}`; %>
          <%- catalogTabButton(sectionId, group.heading, false) %>
        <% }); %>
        <%- catalogTabButton('book-catalog-translations', 'Translations', false) %>
        <%- catalogTabButton('book-catalog-hadith', 'Hadith', initialBookCatalogType === 'hadith') %>
        <%- catalogTabButton('book-catalog-sirah', 'History &amp; Sirah', initialBookCatalogType === 'sirah') %>
      </ul>
      <div class="tab-content">
        <% ['hadith', 'sirah'].forEach(function (bookType) { %>
        <div id="book-catalog-<%= bookType %>" class="tab-pane fade<%= bookType === initialBookCatalogType ? ' show active' : '' %> book-catalog-section-body book-catalog-tab-pane" role="tabpanel" aria-labelledby="book-catalog-<%= bookType %>-tab">
          <div class="tafsir-book-list">
            <% books.filter(function (book) { return bookType === 'sirah' ? book.type === 'sirah' : book.type !== 'sirah'; }).forEach(function (book) { %>
              <%
                var descriptionMarkdown = utils.emptyIfNull(book.description || '');
                var descriptionHtml = utils.markdownToHtml(descriptionMarkdown);
                var descriptionPreview = commentaryDescriptionPreview(descriptionMarkdown);
                var descriptionId = bookDescriptionId(book);
                var descriptionKey = `${descriptionId}-body`;
              %>
              <% var bookGroupIds = bookType === 'hadith' ? catalogGroupIds(book.alias, 'hadith') : []; %>
              <article class="book-catalog-card tafsir-book-row" data-book-catalog-groups="<%= bookGroupIds.join(' ') %>" data-book-catalog-filter="<%- [
                bookGroupIds.map(function (id) { var group = catalogBookGroups.hadith.find(function (candidate) { return candidate.id === id; }); return group && group.label; }).filter(Boolean).join(' '),
                bookType,
                book.alias,
                book.name_en,
                book.shortName_en,
                book.author_en,
                book.author,
				book.name,
                book.title,
                book.shortName,
                book.description
              ].filter(Boolean).join(' ').toLowerCase() %>">
                <div class="tafsir-book-row-main">
                  <div class="tafsir-book-title-pair">
                    <h3 class="tafsir-book-title-line mb-0">
                      <% if (site.editMode) { %>
                        <a href="<%= utils.urlFor(req, `/${book.alias}`) %>"><span class="_e" data-id="<%= book.id %>" data-prop="book.name_en" data-placeholder="English name"><%- book.name_en || '' %></span></a>
                      <% } else { %>
                        <a href="<%= utils.urlFor(req, `/${book.alias}`) %>"><%- book.shortName_en || book.name_en || book.alias %></a>
                      <% } %><%- hadithSizeIndicator(book) %> <span class="badge rounded-pill text-bg-light border book-language-badge"><%= bookLanguageBadge(book) %></span>
                    </h3>
                    <% if (site.editMode || book.name || book.shortName) { %>
                      <h3 class="tafsir-book-title-line mb-0" lang="ar" dir="rtl">
                        <% if (site.editMode) { %>
                          <a href="<%= utils.urlFor(req, `/${book.alias}`) %>"><span class="_e" data-id="<%= book.id %>" data-prop="book.name" data-placeholder="الاسم العربي"><%- book.name || '' %></span></a>
                        <% } else { %>
                          <a href="<%= utils.urlFor(req, `/${book.alias}`) %>"><%- book.shortName || book.name || '' %></a>
                        <% } %>
                      </h3>
                    <% } %>
                  </div>
                  <% if (site.editMode) { %><div class="tafsir-book-full-name text-muted">
                    <div><span class="_e" data-id="<%= book.id %>" data-prop="book.shortName_en" data-placeholder="English short name"><%- book.shortName_en || '' %></span></div>
                    <div lang="ar" dir="rtl"><span class="_e" data-id="<%= book.id %>" data-prop="book.shortName" data-placeholder="الاسم المختصر"><%- book.shortName || '' %></span></div>
                    <div><span class="_e" data-id="<%= book.id %>" data-prop="book.title_en" data-placeholder="Full English title"><%- book.title_en || '' %></span></div>
                    <div lang="ar" dir="rtl"><span class="_e" data-id="<%= book.id %>" data-prop="book.title" data-placeholder="العنوان الكامل"><%- book.title || '' %></span></div>
                  </div><% } else if (book.title_en || book.title) { %><div class="tafsir-book-full-name text-muted"><% if (book.title_en) { %><div><%- book.title_en %></div><% } %><% if (book.title) { %><div lang="ar" dir="rtl"><%- book.title %></div><% } %></div><% } %>
                  <div class="tafsir-book-meta text-muted">
                    <div>
                      <span <% if (site.editMode) { %>class="_e" data-id="<%= book.id %>" data-prop="book.author_en"<% } %>><%- book.author_en || '' %></span>
                      <% if (book.id > 0) { %>
                        <span>(d. <span <% if (site.editMode) { %>class="_e" data-id="<%= book.id %>" data-prop="book.death" data-placeholder="Death year"<% } %>><%- book.death || '' %></span> AH)</span>
                      <% } %>
                    </div>
                    <% if (site.editMode || book.author) { %>
                      <div lang="ar" dir="rtl">
                        <span <% if (site.editMode) { %>class="_e" data-id="<%= book.id %>" data-prop="book.author"<% } %>><%- book.author || '' %></span>
                      </div>
                    <% } %>
                    <% if (site.editMode || book.aqidah) { %><div><span <% if (site.editMode) { %>class="_e" data-id="<%= book.id %>" data-prop="book.aqidah" data-placeholder="Aqidah"<% } %>><%- book.aqidah || '' %></span></div><% } %>
                  </div>
                  <% if (site.editMode || book.published_year || book.publisher) { %><small class="tafsir-book-publication text-muted">Pub. <span <% if (site.editMode) { %>class="_e" data-id="<%= book.id %>" data-prop="book.published_year" data-placeholder="Year"<% } %>><%- book.published_year || '' %></span><% if (site.editMode || book.publisher) { %>, <span <% if (site.editMode) { %>class="_e" data-id="<%= book.id %>" data-prop="book.publisher" data-placeholder="Publisher"<% } %>><%- book.publisher || '' %></span><% } %></small><% } %>
                  <%
                    var hadithDownloadLinks = downloadLinksFor(book);
                  %>
                  <div class="book-download-links">
                    <a href="<%= hadithDownloadLinks.json %>" rel="nofollow" title="Download JSON" aria-label="Download JSON for <%- book.shortName_en || book.name_en || book.alias %>"><span class="bi bi-filetype-json"></span><span>JSON</span></a>
                    <a href="<%= hadithDownloadLinks.epub %>" rel="nofollow" title="Download EPUB" aria-label="Download EPUB for <%- book.shortName_en || book.name_en || book.alias %>"><span class="bi bi-book"></span><span>EPUB</span></a>
                  </div>
                  <% if (site.editMode) { %>
                    <div id="<%= descriptionId %>" class="toc-book-description-full tafsir-book-description-full">
                      <div class="_e tafsir-book-description-editor" data-id="<%= book.id %>" data-prop="book.description" data-edit-format="md" data-markdown-source="<%= descriptionMarkdown %>" data-markdown-empty-html="&hellip;"><%- descriptionHtml || '&hellip;' %></div>
                    </div>
                  <% } else if (descriptionPreview || descriptionHtml) { %>
                    <button type="button" class="toc-book-description-summary tafsir-book-description-summary text-muted text-start" data-toc-description-summary="<%= descriptionKey %>" data-toc-description-expand="<%= descriptionKey %>" aria-expanded="false" aria-controls="<%= descriptionId %>">
                      <span class="toc-book-description-preview"><%= descriptionPreview %></span>
                      <span class="tafsir-book-description-more">More...</span>
                    </button>
                    <div id="<%= descriptionId %>" class="toc-book-description-full tafsir-book-description-full d-none" data-toc-description-full="<%= descriptionKey %>">
                      <%- descriptionHtml %>
                    </div>
                  <% } %>
                </div>
              </article>
            <% }); %>
          </div>
        </div>

        <% }); %>

        <% tafsirGroups.forEach(function (group) { %>
          <% var sectionId = `book-catalog-tafsir-${group.key}`; %>
          <div id="<%= sectionId %>" class="tab-pane fade book-catalog-section-body book-catalog-tab-pane" role="tabpanel" aria-labelledby="<%= sectionId %>-tab">
            <% if (group.tafsirs.length < 1) { %>
              <p class="text-muted">No <%= group.heading.toLowerCase() %> are currently available.</p>
            <% } else { %>
              <div class="tafsir-book-list">
                <% group.tafsirs.forEach(function (tafsir) { %>
                  <%
                    var descriptionMarkdown = utils.emptyIfNull(tafsir.description || '');
                    var descriptionHtml = utils.markdownToHtml(descriptionMarkdown);
                    var descriptionPreview = commentaryDescriptionPreview(descriptionMarkdown);
                    var descriptionId = commentaryDescriptionId(group, tafsir);
                    var descriptionKey = `${descriptionId}-body`;
                    var browseUrl = tafsirBookUrl(tafsir);
                    var editableBookId = tafsir.id || '';
                  %>
                  <% var bookGroupIds = catalogGroupIds(tafsir.alias, 'tafsir'); %>
                  <article class="book-catalog-card tafsir-book-row" data-book-catalog-language="<%= tafsir.lang || '' %>" data-book-catalog-groups="<%= bookGroupIds.join(' ') %>" data-book-catalog-filter="<%- [
                    bookGroupIds.map(function (id) { var bookGroup = catalogBookGroups.tafsir.find(function (candidate) { return candidate.id === id; }); return bookGroup && bookGroup.label; }).filter(Boolean).join(' '),
                    'tafsir',
                    tafsir.alias,
                    tafsir.name_en,
                    tafsir.shortName_en,
                    tafsir.author_en,
					tafsir.name,
                    tafsir.title,
                    tafsir.shortName,
                    tafsir.author,
                    tafsir.published_year,
                    tafsir.publisher,
                    tafsir.description
                  ].filter(Boolean).join(' ').toLowerCase() %>">
                    <div class="tafsir-book-row-main">
                      <div class="tafsir-book-title-pair">
                        <h3 class="tafsir-book-title-line mb-0">
                          <% if (site.editMode) { %>
                            <a href="<%= browseUrl %>"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.name_en" data-placeholder="English name"><%- tafsir.name_en || '' %></span></a>
                          <% } else { %>
                            <a href="<%= browseUrl %>"><%- tafsir.name_en || tafsir.shortName_en || tafsir.alias %></a>
                          <% } %><%- tafsirSizeIndicator(tafsir) %> <span class="badge rounded-pill text-bg-light border book-language-badge"><%= bookLanguageBadge(tafsir) %></span>
                        </h3>
                        <% if (site.editMode || tafsir.name || tafsir.shortName) { %>
                          <h3 class="tafsir-book-title-line mb-0" lang="ar" dir="rtl">
                            <% if (site.editMode) { %>
                              <a href="<%= browseUrl %>"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.name" data-placeholder="الاسم العربي"><%- tafsir.name || '' %></span></a>
                            <% } else { %>
                              <a href="<%= browseUrl %>"><%- tafsir.name || tafsir.shortName || '' %></a>
                            <% } %>
                          </h3>
                        <% } %>
                      </div>
                      <% if (site.editMode) { %>
                        <div class="tafsir-book-full-name text-muted">
                          <div><span class="_e" data-id="<%= editableBookId %>" data-prop="book.shortName_en" data-placeholder="English short name"><%- tafsir.shortName_en || '' %></span></div>
                          <div lang="ar" dir="rtl"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.shortName" data-placeholder="الاسم المختصر"><%- tafsir.shortName || '' %></span></div>
                          <div><span class="_e" data-id="<%= editableBookId %>" data-prop="book.title_en" data-placeholder="Full English title"><%- tafsir.title_en || '' %></span></div>
                          <div lang="ar" dir="rtl"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.title" data-placeholder="العنوان الكامل"><%- tafsir.title || '' %></span></div>
                        </div>
                      <% } else if (tafsir.title_en || tafsir.title) { %><div class="tafsir-book-full-name text-muted"><% if (tafsir.title_en) { %><div><%- tafsir.title_en %></div><% } %><% if (tafsir.title) { %><div lang="ar" dir="rtl"><%- tafsir.title %></div><% } %></div><% } %>
                      <div class="tafsir-book-meta text-muted">
                        <% if (site.editMode || tafsir.author_en || tafsirDeathLabel(tafsir)) { %>
                          <div>
                            <span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="book.author_en"<% } %>><%- tafsir.author_en || tafsir.author || '' %></span>
                            <% if (site.editMode || tafsirDeathLabel(tafsir)) { %>
                              <% if (site.editMode) { %><span>(d. <span class="_e" data-id="<%= editableBookId %>" data-prop="book.death" data-placeholder="Death year"><%- tafsir.death || '' %></span> AH)</span><% } else { %><span>(<%- tafsirDeathLabel(tafsir) %>)</span><% } %>
                            <% } %>
                          </div>
                        <% } %>
                        <% if (site.editMode || tafsir.author || tafsirArabicDeathLabel(tafsir)) { %>
                          <div lang="ar" dir="rtl">
                            <span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="book.author"<% } %>><%- tafsir.author || tafsir.author_en || '' %></span>
                            <% if (tafsirArabicDeathLabel(tafsir)) { %>
                              <span>(<%- tafsirArabicDeathLabel(tafsir) %>)</span>
                            <% } %>
                          </div>
                        <% } %>
                        <% if (site.editMode || tafsir.aqidah) { %><div><span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="book.aqidah" data-placeholder="Aqidah"<% } %>><%- tafsir.aqidah || '' %></span></div><% } %>
                      </div>
                      <%
                        var tafsirDownloadLinks = downloadLinksFor(tafsir);
                      %>
                      <div class="book-download-links">
                        <a href="<%= tafsirDownloadLinks.json %>" rel="nofollow" title="Download JSON" aria-label="Download JSON for <%- tafsir.shortName_en || tafsir.name_en || tafsir.alias %>"><span class="bi bi-filetype-json"></span><span>JSON</span></a>
                        <a href="<%= tafsirDownloadLinks.epub %>" rel="nofollow" title="Download EPUB" aria-label="Download EPUB for <%- tafsir.shortName_en || tafsir.name_en || tafsir.alias %>"><span class="bi bi-book"></span><span>EPUB</span></a>
                      </div>
                      <% if (site.editMode) { %>
                        <div id="<%= descriptionId %>" class="toc-book-description-full tafsir-book-description-full">
                          <div class="_e tafsir-book-description-editor" data-id="<%= editableBookId %>" data-prop="book.description" data-edit-format="md" data-markdown-source="<%= descriptionMarkdown %>" data-markdown-empty-html="&hellip;"><%- descriptionHtml || '&hellip;' %></div>
                        </div>
                      <% } else if (descriptionPreview || descriptionHtml) { %>
                        <button type="button" class="toc-book-description-summary tafsir-book-description-summary text-muted text-start" data-toc-description-summary="<%= descriptionKey %>" data-toc-description-expand="<%= descriptionKey %>" aria-expanded="false" aria-controls="<%= descriptionId %>">
                          <span class="toc-book-description-preview"><%= descriptionPreview %></span>
                          <span class="tafsir-book-description-more">More...</span>
                        </button>
                        <div id="<%= descriptionId %>" class="toc-book-description-full tafsir-book-description-full d-none" data-toc-description-full="<%= descriptionKey %>">
                          <%- descriptionHtml %>
                        </div>
                      <% } %>
                      <% if (site.editMode || commentaryPublicationLabel(tafsir)) { %>
                        <small class="tafsir-book-publication text-muted">
                          <% if (site.editMode) { %>
                            Pub. <span class="_e" data-id="<%= editableBookId %>" data-prop="book.published_year"><%- tafsir.published_year || '' %></span>, <span class="_e" data-id="<%= editableBookId %>" data-prop="book.publisher"><%- tafsir.publisher || '' %></span>
                          <% } else { %>
                            <%- commentaryPublicationLabel(tafsir) %>
                          <% } %>
                        </small>
                      <% } %>
                      <% if (site.editMode) { %>
                        <div class="tafsir-book-admin-fields text-muted">
                          <label>Size
                            <select class="_e form-select form-select-sm" data-id="<%= editableBookId %>" data-prop="book.size">
                              <option value="" <%= !tafsir.size ? 'selected' : '' %>></option>
                              <option value="sm" <%= tafsir.size === 'sm' ? 'selected' : '' %>>Small</option>
                              <option value="md" <%= tafsir.size === 'md' ? 'selected' : '' %>>Medium</option>
                              <option value="lg" <%= tafsir.size === 'lg' ? 'selected' : '' %>>Large</option>
                            </select>
                          </label>
                        </div>
                      <% } %>
                    </div>
                  </article>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% }); %>

        <div id="book-catalog-translations" class="tab-pane fade book-catalog-section-body book-catalog-tab-pane" role="tabpanel" aria-labelledby="book-catalog-translations-tab">
          <% if (!translations || translations.length < 1) { %>
            <p class="text-muted">No English translations are currently available.</p>
          <% } else { %>
            <div class="tafsir-book-list">
              <% translations.forEach(function (translation) { %>
                <%
                  var group = { key: 'translations' };
                  var descriptionMarkdown = utils.emptyIfNull(translation.description || '');
                  var descriptionHtml = utils.markdownToHtml(descriptionMarkdown);
                  var descriptionPreview = commentaryDescriptionPreview(descriptionMarkdown);
                  var descriptionId = commentaryDescriptionId(group, translation);
                  var descriptionKey = `${descriptionId}-body`;
                  var editableBookId = translation.id || '';
                %>
                <article class="book-catalog-card tafsir-book-row" data-book-catalog-filter="<%- [
                  'translation',
                  translation.alias,
                  translation.name_en,
                  translation.shortName_en,
                  translation.author_en,
				  translation.name,
				  translation.shortName,
				  translation.title,
				  translation.author,
                  translation.published_year,
                  translation.publisher,
                  translation.description
                ].filter(Boolean).join(' ').toLowerCase() %>">
                  <div class="tafsir-book-row-main">
                    <div class="tafsir-book-title-pair">
                      <h3 class="tafsir-book-title-line mb-0">
                        <% if (site.editMode) { %>
                          <a href="<%= translationBookUrl(translation) %>"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.name_en" data-placeholder="English name"><%- translation.name_en || '' %></span></a>
                        <% } else { %>
                          <a href="<%= translationBookUrl(translation) %>"><%- translation.name_en || translation.shortName_en || translation.alias %></a>
                        <% } %> <span class="badge rounded-pill text-bg-light border book-language-badge"><%= bookLanguageBadge(translation) %></span>
                      </h3>
                      <% if (site.editMode || translation.name) { %><h3 class="tafsir-book-title-line mb-0" lang="ar" dir="rtl"><% if (site.editMode) { %><a href="<%= translationBookUrl(translation) %>"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.name" data-placeholder="الاسم العربي"><%- translation.name || '' %></span></a><% } else { %><a href="<%= translationBookUrl(translation) %>"><%- translation.name %></a><% } %></h3><% } %>
                    </div>
                    <% if (site.editMode) { %>
                      <div class="tafsir-book-full-name text-muted">
                        <div><span class="_e" data-id="<%= editableBookId %>" data-prop="book.shortName_en" data-placeholder="English short name"><%- translation.shortName_en || '' %></span></div>
                        <div lang="ar" dir="rtl"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.shortName" data-placeholder="الاسم المختصر"><%- translation.shortName || '' %></span></div>
                        <div><span class="_e" data-id="<%= editableBookId %>" data-prop="book.title_en" data-placeholder="Full English title"><%- translation.title_en || '' %></span></div>
                        <div lang="ar" dir="rtl"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.title" data-placeholder="العنوان الكامل"><%- translation.title || '' %></span></div>
                      </div>
                    <% } else if (translation.title_en || translation.title) { %><div class="tafsir-book-full-name text-muted"><% if (translation.title_en) { %><div><%- translation.title_en %></div><% } %><% if (translation.title) { %><div lang="ar" dir="rtl"><%- translation.title %></div><% } %></div><% } %>
                    <div class="tafsir-book-meta text-muted<%= translation.author ? '' : ' tafsir-book-meta-single' %>">
                      <div>
                        <span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="book.author_en"<% } %>><%- translation.author_en || translation.author || '' %></span>
                        <% if (site.editMode || translationDeathLabel(translation)) { %>
                          <span>(<span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="book.death"<% } %>><%- site.editMode ? translation.death : translationDeathLabel(translation) %></span>)</span>
                        <% } %>
                      </div>
                      <% if (site.editMode || translation.author) { %><div lang="ar" dir="rtl"><span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="book.author" data-placeholder="اسم المؤلف"<% } %>><%- translation.author || '' %></span></div><% } %>
                    </div>
                    <%
                      var translationDownloadLinks = downloadLinksFor(translation);
                    %>
                    <div class="book-download-links">
                      <a href="<%= translationDownloadLinks.json %>" rel="nofollow" title="Download JSON" aria-label="Download JSON for <%- translation.shortName_en || translation.name_en || translation.alias %>"><span class="bi bi-filetype-json"></span><span>JSON</span></a>
                      <a href="<%= translationDownloadLinks.epub %>" rel="nofollow" title="Download EPUB" aria-label="Download EPUB for <%- translation.shortName_en || translation.name_en || translation.alias %>"><span class="bi bi-book"></span><span>EPUB</span></a>
                    </div>
                    <% if (site.editMode) { %>
                      <div id="<%= descriptionId %>" class="toc-book-description-full tafsir-book-description-full">
                        <div class="_e tafsir-book-description-editor" data-id="<%= editableBookId %>" data-prop="book.description" data-edit-format="md" data-markdown-source="<%= descriptionMarkdown %>" data-markdown-empty-html="&hellip;"><%- descriptionHtml || '&hellip;' %></div>
                      </div>
                    <% } else if (descriptionPreview || descriptionHtml) { %>
                      <button type="button" class="toc-book-description-summary tafsir-book-description-summary text-muted text-start" data-toc-description-summary="<%= descriptionKey %>" data-toc-description-expand="<%= descriptionKey %>" aria-expanded="false" aria-controls="<%= descriptionId %>">
                        <span class="toc-book-description-preview"><%= descriptionPreview %></span>
                        <span class="tafsir-book-description-more">More...</span>
                      </button>
                      <div id="<%= descriptionId %>" class="toc-book-description-full tafsir-book-description-full d-none" data-toc-description-full="<%= descriptionKey %>">
                        <%- descriptionHtml %>
                      </div>
                    <% } %>
                    <% if (site.editMode || commentaryPublicationLabel(translation)) { %>
                      <small class="tafsir-book-publication text-muted">
                        <% if (site.editMode) { %>
                          Pub. <span class="_e" data-id="<%= editableBookId %>" data-prop="book.published_year"><%- translation.published_year || '' %></span>, <span class="_e" data-id="<%= editableBookId %>" data-prop="book.publisher"><%- translation.publisher || '' %></span>
                        <% } else { %>
                          <%- commentaryPublicationLabel(translation) %>
                        <% } %>
                      </small>
                    <% } %>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </section>
    <p class="text-muted d-none book-catalog-filter-empty">No matching books found.</p>

    </main>
  </div>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
<script>
  (function () {
    var filter = document.querySelector('.book-catalog-filter');
    if (!filter)
      return;
    filter.focus();
    var normalize = function (value) {
      return window.normalizeContentFilterText(value);
    };
    var cards = Array.from(document.querySelectorAll('.book-catalog-card'));
    var tabPanes = Array.from(document.querySelectorAll('.book-catalog-tab-pane'));
    var groupButtons = Array.from(document.querySelectorAll('[data-book-catalog-group-filter]'));
    var languageButtons = Array.from(document.querySelectorAll('[data-book-catalog-language-filter]'));
    var filterButtons = groupButtons.concat(languageButtons);
    var empty = document.querySelector('.book-catalog-filter-empty');
    var activeGroup = '';
    var activeLanguage = '';
    var activeScope = '<%= initialBookCatalogType %>';

    var getTabButton = function (pane) {
      return document.querySelector('.book-catalog-tabs .nav-link[data-bs-target="#' + pane.id + '"]');
    };

    var activateFirstVisiblePane = function () {
      var firstVisible = tabPanes.find(function (pane) {
        return !pane.classList.contains('d-none');
      });
      if (!firstVisible)
        return;
      var button = getTabButton(firstVisible);
      if (!button)
        return;
      var tab = window.bootstrap && window.bootstrap.Tab ? new window.bootstrap.Tab(button) : null;
      if (tab)
        tab.show();
    };

    var applyFilters = function () {
      var query = normalize(filter.value);
      var visibleCount = 0;
      var hasVisiblePane = false;
      cards.forEach(function (card) {
        var groups = (card.dataset.bookCatalogGroups || '').split(/\s+/).filter(Boolean);
        var match = (!query || normalize(card.dataset.bookCatalogFilter).includes(query))
          && (!activeGroup || groups.indexOf(activeGroup) >= 0)
          && (!activeLanguage || card.dataset.bookCatalogLanguage === activeLanguage);
        card.classList.toggle('d-none', !match);
        if (match)
          visibleCount += 1;
      });
      tabPanes.forEach(function (pane) {
        var paneCards = Array.from(pane.querySelectorAll('.book-catalog-card'));
        var paneHasVisible = paneCards.some(function (card) {
          return !card.classList.contains('d-none');
        });
        if (query && !activeGroup) {
          pane.classList.toggle('d-none', !paneHasVisible);
        } else {
          pane.classList.remove('d-none');
        }
        if (paneHasVisible)
          hasVisiblePane = true;
      });
      if (empty)
        empty.classList.toggle('d-none', visibleCount > 0 || (!query && !activeGroup));
      if (query && !activeGroup && hasVisiblePane)
        activateFirstVisiblePane();
    };

    var setGroupScope = function (paneId) {
      var scope = paneId === 'book-catalog-hadith' ? 'hadith' : (paneId.indexOf('book-catalog-tafsir-') === 0 ? 'tafsir' : '');
      var scopeChanged = scope !== activeScope;
      activeScope = scope;
      if (scopeChanged)
        activeGroup = '';
      if (scopeChanged)
        activeLanguage = '';
      filterButtons.forEach(function (button) {
        var buttonScope = button.dataset.bookCatalogGroupScope || '';
        var isAll = button.hasAttribute('data-book-catalog-group-filter') && !button.dataset.bookCatalogGroupFilter;
        button.classList.toggle('d-none', !isAll && buttonScope !== scope);
        var active = activeLanguage
          ? button.dataset.bookCatalogLanguageFilter === activeLanguage
          : (activeGroup ? button.dataset.bookCatalogGroupFilter === activeGroup : isAll);
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      applyFilters();
    };
    filter.addEventListener('input', applyFilters);
    groupButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        activeGroup = button.dataset.bookCatalogGroupFilter || '';
        activeLanguage = '';
        filterButtons.forEach(function (candidate) {
          var active = candidate === button;
          candidate.classList.toggle('active', active);
          candidate.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        applyFilters();
      });
    });
    languageButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        activeGroup = '';
        activeLanguage = button.dataset.bookCatalogLanguageFilter || '';
        filterButtons.forEach(function (candidate) {
          var active = candidate === button;
          candidate.classList.toggle('active', active);
          candidate.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        applyFilters();
      });
    });
    document.querySelectorAll('.book-catalog-tabs [data-bs-toggle="tab"]').forEach(function (tab) {
      tab.addEventListener('shown.bs.tab', function () {
        setGroupScope((tab.dataset.bsTarget || '').replace(/^#/, ''));
      });
    });
  })();
</script>

</body>
</html>
