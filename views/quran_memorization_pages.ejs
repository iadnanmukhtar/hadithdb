<!doctype html>
<html lang="en">
<%
  var site = Object.assign({}, global.settings.site, { admin: req.admin, editMode: false });
  var helpView = req.query.help !== undefined;
  var helpUrl = utils.quranUrl(req, '/quran/review?help');
%>
<head><%- include('sub-views/head.ejs', { site: site, page: page }); %></head>
<body>
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  <main class="container col-lg-8 mx-auto mt-10 quran-review-top-offset quran-memorization-welcome" id="quran-memorization-welcome"<% if (!helpView) { %> hidden<% } %>>
    <section class="quran-memorization-welcome-hero text-center mx-auto">
      <img class="quran-memorization-welcome-logo" src="/static/img/quran/mudhakkir.svg" width="96" height="96" alt="Mudhakkir">
      <p class="text-primary fw-semibold small mb-2"><span class="badge rounded-pill text-bg-success me-1">Mudhakkir</span> Adaptive spaced repetition for Quran hifz</p>
      <h1 class="fs-2 mb-1">Mudhakkir</h1>
      <p class="fs-5 fw-semibold mb-3">Keep your Quran memorization fresh</p>
      <p class="lead text-muted mx-auto mb-4">The app brings each āyah back for review before it is likely to fade. Your answers adjust future timing, helping keep your hifz strong without unnecessary repetition.</p>
      <div class="d-flex justify-content-center gap-2 flex-wrap">
        <button type="button" class="btn btn-primary" id="quran-memorization-sign-in"><i class="bi bi-person-circle me-1" aria-hidden="true"></i> Sign in to begin memorizing</button>
        <div id="quran-memorization-google-sign-in" hidden></div>
        <a class="btn btn-outline-secondary" href="<%= utils.quranUrl(req, '/quran/page') %>">Explore the Mushaf</a>
      </div>
      <p class="small text-muted mt-3 mb-0">Your memorization progress is saved securely to your account and stays available across your devices.</p>
    </section>
    <section class="row g-3 quran-memorization-welcome-features" aria-label="How Quran memorization works">
      <div class="col-md-4"><article class="quran-memorization-welcome-feature h-100"><i class="bi bi-journal-bookmark text-primary" aria-hidden="true"></i><h2 class="fs-6">Learn at your pace</h2><p>Choose the āyāt and surahs you want to learn, assess them once, and let daily Mudhakkir manage their progress.</p></article></div>
      <div class="col-md-4"><article class="quran-memorization-welcome-feature h-100"><i class="bi bi-arrow-repeat text-success" aria-hidden="true"></i><h2 class="fs-6">Mudhakkir adapts</h2><p>Learning āyāt appear first, then Mudhakkir adjusts review timing to your recall so you can focus on what needs attention.</p></article></div>
      <div class="col-md-4"><article class="quran-memorization-welcome-feature h-100"><i class="bi bi-bar-chart-line text-primary" aria-hidden="true"></i><h2 class="fs-6">See your progress</h2><p>Track Learning, Hard, Good, and Easy ayat from a progress view organized by surah and Mushaf page.</p></article></div>
    </section>
    <section class="quran-memorization-preview-section" aria-labelledby="quran-memorization-preview-title">
      <section class="quran-ayah-hero quran-memorization-preview-ayah row">
        <section class="col-12" lang="ar" dir="rtl">
          <div class="quran-ayah-hero-body">
            <div class="quran-ayah-hero-ayah"><div class="quran-ayah-hero-text"><p>بَلْ هُوَ ءَايَٰتُۢ بَيِّنَٰتࣱ فِي صُدُورِ ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَۚ</p></div></div>
          </div>
        </section>
        <section class="col-12" lang="en">
          <div class="quran-ayah-hero-body">
            <div class="quran-ayah-hero-ayah"><sup>29:49</sup>&nbsp;<div class="quran-ayah-hero-text">But this ˹Quran˺ is ˹a set of˺ clear revelations preserved in the hearts of those gifted with knowledge.</div> <span class="quran-translation-attribution">— Dr. Mustafa Khattab, The Clear Quran</span></div>
          </div>
        </section>
        <aside class="tags quran-ayah-hero-toolbar col-12" aria-label="Quran 29:49 links">
          <a href="<%= utils.quranUrl(req, '/quran:29:49#comments') %>" title="View reflections for Quran 29:49" class="reflection-count-link quran-ayah-action text-accent text-decoration-none">
            <span class="bi bi-chat-right-text" aria-hidden="true"></span><span class="quran-ayah-action-label">Reflections</span>
          </a>
          <a href="<%= utils.quranUrl(req, '/quran/tafsir/ibn-kathir/29/49') %>" title="View tafsir for Quran 29:49" class="quran-ayah-action text-accent text-decoration-none">
            <span class="bi bi-book-half" aria-hidden="true"></span><span class="quran-ayah-action-label">Tafsir</span>
          </a>
          <a href="<%= utils.quranUrl(req, '/quran/translations/quran:29:49') %>" title="View translations for Quran 29:49" class="quran-ayah-action text-accent text-decoration-none">
            <span class="bi bi-translate" aria-hidden="true"></span><span class="quran-ayah-action-label">Translations</span>
          </a>
          <a href="<%= utils.quranUrl(req, '/quran:29:49') %>" title="Study Quran 29:49" class="quran-ayah-action icon text-accent text-decoration-none">
            <span class="bi bi-text-paragraph" aria-hidden="true"></span><span class="quran-ayah-action-label">Study</span>
          </a>
        </aside>
      </section>
      <header class="quran-memorization-preview-header text-center mx-auto">
        <p class="text-primary fw-semibold small mb-2">Designed for focused Quran practice</p>
        <h2 class="fs-4 mb-2" id="quran-memorization-preview-title">Practice, use Mudhakkir, and see your progress</h2>
        <p class="text-muted mb-0">A calm Mushaf experience for every stage of your memorization.</p>
      </header>
      <div class="quran-memorization-preview-gallery" role="list" aria-label="Quran memorization screen previews">
        <figure class="quran-memorization-preview-card" role="listitem">
          <div class="quran-memorization-preview-visual quran-memorization-preview-visual-memorize">
            <div class="quran-memorization-preview-concept">
              <span class="quran-memorization-preview-kicker">Practice</span>
              <strong>Build your hifz, āyah by āyah</strong>
              <span>Assess each āyah once, then use the green Mudhakkir button when you are ready to review.</span>
            </div>
            <div class="quran-memorization-preview-screenshot">
              <img src="/static/img/quran/memorization-memorize-preview.png?v=<%= utils.styleAssetVersion() %>" width="640" height="960" loading="lazy" alt="Cropped Practice mode screenshot of Mushaf page 600, with the original surah headings, basmalahs, Easy controls, hidden word placeholders, and page controls">
            </div>
          </div>
          <figcaption><strong>Practice with clarity</strong><span>Give each Later āyah an honest starting assessment.</span></figcaption>
        </figure>
        <figure class="quran-memorization-preview-card" role="listitem">
          <div class="quran-memorization-preview-visual quran-memorization-preview-visual-review">
            <div class="quran-memorization-preview-concept">
              <span class="quran-memorization-preview-kicker">Mudhakkir</span>
              <strong>Recall before memory fades</strong>
              <span>Focused reviews keep every āyah fresh.</span>
            </div>
            <div class="quran-memorization-preview-screenshot">
              <img src="/static/img/quran/memorization-review-preview.png?v=<%= utils.styleAssetVersion() %>" width="640" height="960" loading="lazy" alt="Mudhakkir mode using the original Mushaf page 599 screenshot, with earlier Quran context visible, the current āyah concealed in place, later text faded, and sticky Again, Hard, Good, Easy, and Skip grading buttons">
            </div>
          </div>
          <figcaption><strong>Recall with focus</strong><span>Recall in Quran order, then let the app choose the next review time.</span></figcaption>
        </figure>
        <figure class="quran-memorization-preview-card" role="listitem">
          <div class="quran-memorization-preview-visual quran-memorization-preview-visual-progress">
            <div class="quran-memorization-preview-concept">
              <span class="quran-memorization-preview-kicker">Progress</span>
              <strong>Know what to review next</strong>
              <span>Your hifz history stays synced across devices.</span>
            </div>
            <div class="quran-memorization-preview-screenshot">
              <img src="/static/img/quran/memorization-progress-preview.svg?v=<%= utils.styleAssetVersion() %>" width="640" height="960" loading="lazy" alt="Memorization Progress showing review activity, Hard, Good, and Easy state totals, and pages grouped by surah">
            </div>
          </div>
          <figcaption><strong>See every step</strong><span>Follow activity, due reviews, and memorization states across the Quran.</span></figcaption>
        </figure>
      </div>
    </section>
    <article class="quran-memorization-help-article text-start mx-auto" aria-labelledby="quran-memorization-help-article-title">
      <header class="quran-memorization-help-article-header">
        <p class="quran-memorization-help-kicker mb-1"><span class="badge rounded-pill text-bg-primary">How it works</span> Quran memorization guide</p>
        <h2 class="fs-4 mb-0" id="quran-memorization-help-article-title">How Quran memorization works</h2>
      </header>
      <div class="quran-memorization-help-body">
        <%- include('sub-views/quran_memorization_help_content.ejs', { helpIdPrefix: 'quran-memorization-help-article' }); %>
      </div>
    </article>
  </main>
  <main class="container col-lg-8 mx-auto mt-10 quran-review-top-offset quran-ayah-progress-page" id="quran-memorization-progress" hidden>
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap">
      <div><h1 class="fs-4 mb-1">Memorization Progress</h1><p class="text-muted small mb-0">Track every memorized āyah, see what is due now, and begin a guided review. Progress is organized by surah and Mushaf page.</p></div>
      <div class="d-flex align-items-center justify-content-end gap-2 ms-auto quran-progress-actions">
        <button type="button" class="btn btn-outline-secondary btn-sm quran-progress-secondary-action" data-bs-toggle="modal" data-bs-target="#quran-fsrs-settings-modal" aria-label="Mudhakkir settings" title="Mudhakkir settings"><i class="bi bi-sliders" aria-hidden="true"></i><span class="quran-progress-secondary-action-label">Mudhakkir settings</span></button>
        <a class="btn btn-outline-secondary btn-sm quran-progress-secondary-action" href="<%= helpUrl %>" aria-label="How Quran memorization works" title="How it works"><i class="bi bi-question-circle" aria-hidden="true"></i><span class="quran-progress-secondary-action-label">How it works</span></a>
        <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#quran-get-started-modal"><i class="bi bi-stars me-1" aria-hidden="true"></i>Get Started</button>
        <div class="dropdown">
          <button type="button" class="btn btn-primary btn-sm dropdown-toggle" id="quran-start-review" data-bs-toggle="dropdown" aria-expanded="false"><span id="quran-start-review-label">Start Mudhakkir</span></button>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="quran-start-review">
            <li><a class="dropdown-item" id="quran-start-regular-review" href="<%= utils.quranUrl(req, '/quran/review?continue=1') %>"><i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i><span id="quran-start-regular-review-label">Regular Mudhakkir</span></a></li>
            <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#quran-memorize-review-modal" data-quran-review-start-kind="surah"><i class="bi bi-book me-2" aria-hidden="true"></i>Surah Mudhakkir</button></li>
          </ul>
        </div>
      </div>
    </div>
    <section class="quran-paused-review-sessions mb-3" id="quran-open-review-sessions" aria-labelledby="quran-open-review-sessions-title" hidden>
      <div class="d-flex justify-content-between align-items-baseline gap-2 mb-2 flex-wrap"><h2 class="fs-6 fw-bold mb-0" id="quran-open-review-sessions-title">Your review sessions</h2><span class="small text-muted">Resume or end a session</span></div>
      <div class="quran-paused-review-session-list" id="quran-open-review-session-list"></div>
    </section>
    <section class="quran-review-activity mb-3" aria-labelledby="quran-review-activity-title">
      <div class="d-flex justify-content-between gap-2 align-items-baseline flex-wrap"><h2 class="fs-6 fw-bold mb-1" id="quran-review-activity-title">Mudhakkir activity</h2><p class="small mb-1" id="quran-review-today-summary">Loading review activity...</p></div>
      <div class="quran-review-heatmap-wrap" aria-label="Mudhakkir activity for the past year"><div class="quran-review-heatmap" id="quran-review-heatmap"></div></div>
      <p class="quran-review-heatmap-detail small text-muted mb-2" id="quran-review-heatmap-detail" role="status" aria-live="polite">Hover over or tap a day to see its review activity.</p>
      <div class="quran-review-stat-row" id="quran-review-stat-row"><span><strong>Daily average</strong> <b data-review-stat="daily_average">0</b> ayat</span><span><strong>Days learned</strong> <b data-review-stat="days_learned_percent">0%</b></span><span><strong>Longest streak</strong> <b data-review-stat="longest_streak">0 days</b></span><span><strong>Current streak</strong> <b data-review-stat="current_streak">0 days</b></span></div>
    </section>
    <section class="quran-memorization-summary mb-3" aria-label="Memorization totals">
      <% [['due_today','Due now'],['learning','Learning'],['weak','Hard'],['review','Good'],['core','Easy'],['suspended','Paused'],['later','Later']].forEach(function (item) { %>
      <button type="button" class="card text-start quran-progress-summary-card" data-progress-filter="<%= item[0] %>" aria-pressed="false"<% if (item[0] === 'later') { %> disabled title="Untouched ayat are counted here but are not listed"<% } %>><span class="quran-progress-summary-label"><%= item[1] %></span><strong class="quran-progress-summary-count" data-progress-count="<%= item[0] %>">—</strong></button>
      <% }); %>
    </section>
    <div class="page-content-filter input-group input-group-sm mb-3 memorization-progress-filter">
      <span class="input-group-text"><i class="bi bi-filter" aria-hidden="true"></i></span>
      <input type="search" class="form-control" id="quran-ayah-progress-filter" placeholder="Filter by page, Juz, Surah, state, or Arabic text" aria-label="Filter memorization progress by page, Juz, Surah, state, or Arabic text" autocomplete="off">
      <button type="button" class="btn btn-outline-secondary" id="quran-ayah-progress-filter-clear" aria-label="Clear progress filter" hidden><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
    <p id="quran-ayah-progress-status" class="text-muted small" role="status" aria-live="polite">Loading ayah progress...</p>
    <div class="table-responsive memorization-progress-table-wrap">
      <table class="table table-hover align-middle mb-0 memorization-progress-table" id="quran-ayah-progress-table" hidden>
        <thead><tr><th><button type="button" class="memorization-progress-sort" data-progress-sort="unit">Unit</button></th><th><button type="button" class="memorization-progress-sort" data-progress-sort="state">State</button></th><th><button type="button" class="memorization-progress-sort" data-progress-sort="start">Starting ayah</button></th><th><button type="button" class="memorization-progress-sort" data-progress-sort="next">Next review</button></th><th><button type="button" class="memorization-progress-sort" data-progress-sort="reviews">Reviews</button></th><th><button type="button" class="memorization-progress-sort" data-progress-sort="difficulty">Difficulty</button></th><th><button type="button" class="memorization-progress-sort" data-progress-sort="stability">Stability</button></th></tr></thead><tbody></tbody>
      </table>
    </div>
  </main>
  <main class="container mt-10 quran-review-top-offset text-center page-loading-page" id="quran-memorization-auth-loading"<% if (helpView) { %> hidden<% } %>>
    <div class="page-loading" role="status" aria-live="polite">
      <span class="spinner-border text-primary" aria-hidden="true"></span>
      <span class="text-muted">Loading Quran memorization...</span>
    </div>
  </main>
  <%- include('sub-views/quran_memorize_review_modal.ejs', { site: site, page: page }); %>
  <%- include('sub-views/quran_get_started_modal.ejs', { site: site, page: page }); %>
  <%- include('sub-views/quran_memorization_help_modal.ejs', { site: site, page: page }); %>
  <%- include('sub-views/quran_fsrs_settings_modal.ejs', { site: site, page: page }); %>
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page, helpTour: helpView ? '' : 'progress' }); %>
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  <script>
    (async function () {
      const labels = window.HadithDbQuranReview.LIFECYCLE_STATE_LABELS;
      const stageOrder = ['learning', 'weak', 'review', 'core', 'suspended'];
      const status = document.getElementById('quran-ayah-progress-status');
      const table = document.getElementById('quran-ayah-progress-table');
      const filter = document.getElementById('quran-ayah-progress-filter');
      const clear = document.getElementById('quran-ayah-progress-filter-clear');
      const startReviewLabel = document.getElementById('quran-start-review-label');
      const regularReview = document.getElementById('quran-start-regular-review');
      const regularReviewLabel = document.getElementById('quran-start-regular-review-label');
      const reviewSessionsSection = document.getElementById('quran-open-review-sessions');
      const reviewSessionsList = document.getElementById('quran-open-review-session-list');
      const reviewHeatmapWrap = document.querySelector('.quran-review-heatmap-wrap');
      const reviewHeatmap = document.getElementById('quran-review-heatmap');
      const reviewHeatmapDetail = document.getElementById('quran-review-heatmap-detail');
      const escapeHtml = value => (value ?? '').toString().replace(/[&<>"']/g, character => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[character]));
      const legacyNotice = <%- JSON.stringify(req.query.complete !== undefined
        ? { type:'success', title:'Mudhakkir complete', message:'You completed this review session.', scrollToTop:true }
        : req.query.paused !== undefined
          ? { type:'info', title:'Mudhakkir paused', message:'Resume it whenever you are ready.', scrollToTop:true }
          : req.query.ended !== undefined
            ? { type:'info', title:'Mudhakkir ended', message:'Completed reviews remain saved.', scrollToTop:true }
            : null) %>;
      const historyNotice = window.history.state && window.history.state.pageNotice;
      const pageNotice = historyNotice || legacyNotice;
      if (pageNotice && pageNotice.scrollToTop) {
        const resetPageScroll = () => window.scrollTo(0, 0);
        if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'manual';
        resetPageScroll();
        window.addEventListener('load', resetPageScroll, { once:true });
        window.addEventListener('pageshow', () => {
          resetPageScroll();
          window.requestAnimationFrame(() => {
            resetPageScroll();
            if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'auto';
          });
        }, { once:true });
      }
      if (pageNotice) {
        const cleanUrl = new URL(window.location.href);
        ['complete','paused','ended'].forEach(key => cleanUrl.searchParams.delete(key));
        const cleanState = Object.assign({}, window.history.state || {});
        delete cleanState.pageNotice;
        window.history.replaceState(cleanState, '', `${cleanUrl.pathname}${cleanUrl.search}${cleanUrl.hash}`);
        window.setTimeout(() => {
          if (!window.toastr) return;
          const method = typeof window.toastr[pageNotice.type] === 'function' ? pageNotice.type : 'info';
          window.toastr[method](pageNotice.message, pageNotice.title);
        }, 0);
      }
      const openingWords = (value, maximum = 4) => { const words=(value||'').trim().split(/\s+/).filter(Boolean); return `${words.slice(0,maximum).join(' ')}${words.length>maximum?' …':''}`; };
      const waitForAuth = async () => { for (let i=0; i<50 && (!window.hadithAuth || !window.hadithAuth.getToken); i++) await new Promise(resolve => setTimeout(resolve,100)); return window.hadithAuth; };
      const auth = await waitForAuth();
      const token = auth && await auth.getToken();
      const loading = document.getElementById('quran-memorization-auth-loading');
      const welcome = document.getElementById('quran-memorization-welcome');
      const progress = document.getElementById('quran-memorization-progress');
      const pageSubtitle = document.querySelector('[data-page-subtitle]');
      if (<%= helpView ? 'true' : 'false' %>) {
        if (loading) loading.hidden = true;
        document.title = 'Mudhakkir: Keep your Quran hifz fresh';
        if (token) {
          const signInButton = document.getElementById('quran-memorization-sign-in');
          if (signInButton) {
            signInButton.dataset.authenticated = '1';
            signInButton.innerHTML = '<i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i> Open my memorization progress';
          }
        }
        return;
      }
      if (!token) {
        if (loading) loading.hidden = true;
        document.title = 'Mudhakkir: Keep your Quran hifz fresh';
        if (welcome) welcome.hidden = false;
        return;
      }
      if (pageSubtitle) pageSubtitle.textContent = 'Progress';
      const request = async (path, options = {}) => { const response=await fetch(quranApiPath(`/memorization${path}`),{credentials:'same-origin',method:options.method||'GET',headers:Object.assign({Authorization:`Bearer ${token}`},options.body?{'Content-Type':'application/json'}:{}),body:options.body?JSON.stringify(options.body):undefined}); const data=await response.json().catch(()=>({})); if(!response.ok) throw new Error(data.error||'Unable to load memorization progress.'); return data; };
      const userSettingsRequest = async (options={}) => { const response=await fetch(quranApiPath('/user-settings'),{credentials:'same-origin',method:options.method||'GET',headers:Object.assign({Authorization:`Bearer ${token}`},options.body?{'Content-Type':'application/json'}:{}),body:options.body?JSON.stringify(options.body):undefined}); const data=await response.json().catch(()=>({})); if(!response.ok) throw new Error(data.error||'Unable to load settings.'); return data; };
      const fsrsControls={retention:document.getElementById('review-fsrs-retention'),learningSpeed:document.getElementById('review-fsrs-learning-speed'),growth:document.getElementById('review-fsrs-growth'),lapse:document.getElementById('review-fsrs-lapse'),sessionLimit:document.getElementById('review-session-limit'),timeBudget:document.getElementById('review-time-budget'),learningLimit:document.getElementById('review-learning-limit'),weakLimit:document.getElementById('review-weak-limit'),memorizedLimit:document.getElementById('review-memorized-limit'),queueOrder:document.getElementById('review-queue-order'),save:document.getElementById('review-fsrs-save'),optimize:document.getElementById('review-fsrs-optimize'),status:document.getElementById('review-fsrs-status')};
      const populateFsrsControls=settings=>{const memorization=settings&&settings.memorization||{};const fsrs=memorization.fsrs||{};fsrsControls.retention.value=String(fsrs.targetRetention||0.9);fsrsControls.learningSpeed.value=fsrs.learningSpeed||'normal';fsrsControls.growth.value=fsrs.intervalGrowth||'standard';fsrsControls.lapse.value=fsrs.lapseRecovery||'standard';fsrsControls.sessionLimit.value=memorization.reviewLimit||10;fsrsControls.timeBudget.value=memorization.reviewTimeBudgetMinutes||0;fsrsControls.learningLimit.value=memorization.learningLimit||3;fsrsControls.weakLimit.value=memorization.weakLimit||3;fsrsControls.memorizedLimit.value=memorization.memorizedLimit||10;fsrsControls.queueOrder.value=memorization.reviewOrder||'due_first';if(fsrs.optimizedAt)fsrsControls.status.textContent=`Last personalized ${new Date(fsrs.optimizedAt).toLocaleDateString()}.`;};
      let reviewUserSettings=null;
      const cacheReviewSettings=async settings=>{if(!window.hadithUserSettingsCache)return;const user=auth.getUser?await auth.getUser():null;if(window.hadithUserSettingsCache.clear)window.hadithUserSettingsCache.clear(user);if(settings&&window.hadithUserSettingsCache.write)window.hadithUserSettingsCache.write(user,settings);};
      const loadFsrsSettings=async()=>{const data=await userSettingsRequest();reviewUserSettings=data.settings||{};populateFsrsControls(reviewUserSettings);};
