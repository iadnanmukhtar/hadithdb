<!doctype html>
<html lang="en">
<% var site = Object.assign({}, global.settings.site, { admin: req.admin, editMode: false }); %>
<head>
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
</head>
<body>
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  <main class="container col-lg-8 mx-auto mt-10">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
      <h1 class="fs-4 mb-0">Memorization Progress</h1>
      <a class="btn btn-primary btn-sm" href="<%= utils.quranUrl(req, '/quran/review?start=1&reset=1') %>">Start Review</a>
    </div>
    <% if (req.query.complete !== undefined) { %><p class="alert alert-success py-2"><%= req.query.limit ? `Review session complete — ${parseInt(req.query.limit, 10) || 0} Good/Easy pages reviewed, plus all selected Hard pages.` : 'You have completed the available reviews.' %></p><% } %>
    <p id="quran-memorization-pages-status" class="text-muted small">Loading memorized pages...</p>
    <div class="page-content-filter input-group input-group-sm mb-3 memorization-progress-filter">
      <span class="input-group-text"><i class="bi bi-filter" aria-hidden="true"></i></span>
      <input type="search" class="form-control" id="quran-memorization-pages-filter" placeholder="Filter by page, Surah, status, ayah, or opening words" aria-label="Filter memorization progress" autocomplete="off">
      <button type="button" class="btn btn-outline-secondary" id="quran-memorization-pages-filter-clear" aria-label="Clear progress filter" hidden><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
    <div class="table-responsive memorization-progress-table-wrap">
      <table class="table table-hover align-middle mb-0 memorization-progress-table" hidden id="quran-memorization-pages-table">
        <thead><tr><th>Page</th><th>Status</th><th>Starts in</th><th>Opening words</th><th>Next review</th><th>Reviews</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </main>
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  <script>
    (async function () {
      const status = document.getElementById('quran-memorization-pages-status');
      const table = document.getElementById('quran-memorization-pages-table');
      const filter = document.getElementById('quran-memorization-pages-filter');
      const filterClear = document.getElementById('quran-memorization-pages-filter-clear');
      const labels = { todo: 'To Do', hard: 'Hard', good: 'Good', easy: 'Easy', never: 'Core' };
      const statusClass = value => `is-${value === 'never' ? 'core' : value}`;
      const escapeHtml = value => (value ?? '').toString().replace(/[&<>"']/g, character => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[character]));
      const statusOptions = page => ['hard', 'good', 'easy', 'never', 'todo'].map(value =>
        `<option value="${value}"${page.status === value ? ' selected' : ''}>${labels[value]}</option>`
      ).join('');
      const nextReview = page => {
        if (page.status === 'never') return 'No review';
        const date = page.next_review_at ? new Date(page.next_review_at) : null;
        return page.due ? 'Due now' : (date ? date.toLocaleDateString(undefined, {
          month: 'numeric',
          day: 'numeric',
          year: '2-digit'
        }) : '—');
      };
      const updateSummary = () => {
        const rows = Array.from(table.querySelectorAll('tbody tr'));
        const visible = rows.filter(row => !row.hidden).length;
        status.textContent = visible
          ? (visible === rows.length
            ? `${visible} page${visible === 1 ? '' : 's'} being memorized.`
            : `${visible} of ${rows.length} pages being memorized.`)
          : (rows.length ? 'No pages match this filter.' : 'No pages are currently being memorized.');
        table.hidden = rows.length === 0;
      };
      const ayahRange = page => {
        if (!page.start_surah || !page.start_ayah || !page.end_surah || !page.end_ayah) return '—';
        return page.start_surah === page.end_surah
          ? `${page.start_surah}:${page.start_ayah}–${page.end_ayah}`
          : `${page.start_surah}:${page.start_ayah}–${page.end_surah}:${page.end_ayah}`;
      };
      try {
        let attempts = 0;
        while ((!window.hadithAuth || !window.hadithAuth.getToken) && attempts < 50) {
          await new Promise(resolve => window.setTimeout(resolve, 100));
          attempts += 1;
        }
        let token = window.hadithAuth && await window.hadithAuth.getToken();
        if (!token && window.hadithAuth && window.hadithAuth.requireToken)
          token = await window.hadithAuth.requireToken('Please sign in to view memorized pages.');
        if (!token) throw new Error('Please sign in to view memorized pages.');
        const response = await fetch(quranApiPath('/memorization/pages'), {
          credentials: 'same-origin',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const responseText = await response.text();
        let data = {};
        try {
          data = responseText ? JSON.parse(responseText) : {};
        } catch (_err) {
          throw new Error('The memorization service returned an invalid response.');
        }
        if (!response.ok) throw new Error(data.error || 'Unable to load memorized pages.');
        const activePages = data.pages.filter(page => page.status !== 'todo');
        table.querySelector('tbody').innerHTML = activePages.map(page => {
          return `<tr data-progress-page="${page.page_number}"><td><a class="memorization-progress-page-link" href="/quran/page/${page.page_number}?memorize">${page.page_number}</a></td><td><select class="form-select form-select-sm ${statusClass(page.status)}" data-progress-status aria-label="Memorization status for page ${page.page_number}">${statusOptions(page)}</select></td><td class="memorization-progress-reference"><span class="memorization-progress-surah">${escapeHtml(page.start_surah_name || `Surah ${page.start_surah || ''}`)}</span><span class="visually-hidden">${escapeHtml(page.start_surah_alternate_names || '')}</span><span class="memorization-progress-ayah-range">${escapeHtml(ayahRange(page))}</span></td><td class="memorization-progress-opening" lang="ar" dir="rtl">${escapeHtml(page.opening_words || '—')}</td><td class="text-nowrap" data-progress-next-review>${escapeHtml(nextReview(page))}</td><td class="text-center" data-progress-review-count>${page.review_count || 0}</td></tr>`;
        }).join('');
        updateSummary();
        const applyFilter = () => {
          const query = filter.value.trim().toLocaleLowerCase();
          table.querySelectorAll('tbody tr').forEach(row => {
            row.hidden = Boolean(query) && !row.textContent.toLocaleLowerCase().includes(query);
          });
          filterClear.hidden = !query;
          updateSummary();
        };
        filter.addEventListener('input', applyFilter);
        filterClear.addEventListener('click', () => {
          filter.value = '';
          applyFilter();
          filter.focus();
        });
        table.addEventListener('change', async event => {
          const select = event.target.closest('[data-progress-status]');
          if (!select) return;
          const row = select.closest('[data-progress-page]');
          const pageNumber = row && row.getAttribute('data-progress-page');
          const previousStatus = activePages.find(page => String(page.page_number) === pageNumber)?.status || '';
          select.disabled = true;
          try {
            const saveResponse = await fetch(quranApiPath(`/memorization/pages/${pageNumber}`), {
              method: 'PUT',
              credentials: 'same-origin',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({ status: select.value, reviewed: false })
            });
            const saved = await saveResponse.json();
            if (!saveResponse.ok) throw new Error(saved.error || 'Unable to update memorization status.');
            if (saved.page.status === 'todo') {
              row.remove();
              updateSummary();
              return;
            }
            select.classList.remove('is-hard', 'is-good', 'is-easy', 'is-core', 'is-todo');
            select.classList.add(statusClass(saved.page.status));
            row.querySelector('[data-progress-next-review]').textContent = nextReview(saved.page);
            row.querySelector('[data-progress-review-count]').textContent = saved.page.review_count || 0;
          } catch (err) {
            select.value = previousStatus;
            status.textContent = err.message || 'Unable to update memorization status.';
          } finally {
            select.disabled = false;
          }
        });
      } catch (err) {
        status.textContent = err.message;
      }
    }());
  </script>
</body>
</html>
