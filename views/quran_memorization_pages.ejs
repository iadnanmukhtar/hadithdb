<!doctype html>
<html lang="en">
<%
  var site = Object.assign({}, global.settings.site, { admin: req.admin, editMode: false });
  var helpView = req.query.help !== undefined;
  var helpUrl = utils.quranUrl(req, '/quran/review?help');
%>
<head><%- include('sub-views/head.ejs', { site: site, page: page }); %></head>
<body>
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  <main class="container col-lg-8 mx-auto mt-10 quran-memorization-welcome" id="quran-memorization-welcome"<% if (!helpView) { %> hidden<% } %>>
    <section class="quran-memorization-welcome-hero text-center mx-auto">
      <span class="quran-memorization-welcome-icon" aria-hidden="true"><i class="bi bi-book"></i></span>
      <p class="text-primary fw-semibold small mb-2"><span class="badge rounded-pill text-bg-primary me-1">Adaptive review</span> Spaced repetition for Quran hifz</p>
      <h1 class="fs-2 mb-3">Keep your Quran memorization fresh</h1>
      <p class="lead text-muted mx-auto mb-4">The app brings each āyah back for review before it is likely to fade. Your answers adjust future timing, helping keep your hifz strong without unnecessary repetition.</p>
      <div class="d-flex justify-content-center gap-2 flex-wrap">
        <button type="button" class="btn btn-primary" id="quran-memorization-sign-in"><i class="bi bi-person-circle me-1" aria-hidden="true"></i> Sign in to begin memorizing</button>
        <a class="btn btn-outline-secondary" href="<%= utils.quranUrl(req, '/quran/page') %>">Explore the Mushaf</a>
      </div>
      <p class="small text-muted mt-3 mb-0">Your memorization progress is saved securely to your account and stays available across your devices.</p>
    </section>
    <section class="row g-3 quran-memorization-welcome-features" aria-label="How Quran memorization works">
      <div class="col-md-4"><article class="quran-memorization-welcome-feature h-100"><i class="bi bi-journal-bookmark text-primary" aria-hidden="true"></i><h2 class="fs-6">Learn at your pace</h2><p>Choose the āyāt and surahs you want to learn, assess them once, and let daily Review manage their progress.</p></article></div>
      <div class="col-md-4"><article class="quran-memorization-welcome-feature h-100"><i class="bi bi-arrow-repeat text-primary" aria-hidden="true"></i><h2 class="fs-6">Reviews that adapt</h2><p>Learning āyāt appear first, then review timing adjusts to your recall so you can focus on what needs attention.</p></article></div>
      <div class="col-md-4"><article class="quran-memorization-welcome-feature h-100"><i class="bi bi-bar-chart-line text-primary" aria-hidden="true"></i><h2 class="fs-6">See your progress</h2><p>Track learning, weak, memorized, and Core ayat from a progress view organized by surah and Mushaf page.</p></article></div>
    </section>
    <section class="quran-memorization-preview-section" aria-labelledby="quran-memorization-preview-title">
      <header class="quran-memorization-preview-header text-center mx-auto">
        <p class="text-primary fw-semibold small mb-2">Designed for focused Quran practice</p>
        <h2 class="fs-4 mb-2" id="quran-memorization-preview-title">Memorize, review, and see your progress</h2>
        <p class="text-muted mb-0">A calm Mushaf experience for every stage of your memorization.</p>
      </header>
      <div class="quran-memorization-preview-gallery" role="list" aria-label="Quran memorization screen previews">
        <figure class="quran-memorization-preview-card" role="listitem">
          <div class="quran-memorization-preview-visual quran-memorization-preview-visual-memorize">
            <div class="quran-memorization-preview-concept">
              <span class="quran-memorization-preview-kicker">Memorize</span>
              <strong>Build your hifz, āyah by āyah</strong>
              <span>Assess each āyah once, then practice as Review guides you.</span>
            </div>
            <div class="quran-memorization-preview-screenshot">
              <img src="/images/quran/memorization-memorize-preview.png" width="640" height="960" loading="lazy" alt="Cropped Memorize mode screenshot of Mushaf page 600, with the original surah headings, basmalahs, Core controls, hidden word placeholders, and page controls">
            </div>
          </div>
          <figcaption><strong>Memorize with clarity</strong><span>Give each Later āyah an honest starting assessment.</span></figcaption>
        </figure>
        <figure class="quran-memorization-preview-card" role="listitem">
          <div class="quran-memorization-preview-visual quran-memorization-preview-visual-review">
            <div class="quran-memorization-preview-concept">
              <span class="quran-memorization-preview-kicker">Review</span>
              <strong>Recall before memory fades</strong>
              <span>Focused reviews keep every āyah fresh.</span>
            </div>
            <div class="quran-memorization-preview-screenshot">
              <img src="/images/quran/memorization-review-preview.png" width="640" height="960" loading="lazy" alt="Review mode using the original Mushaf page 599 screenshot, with earlier Quran context visible, the current āyah concealed in place, later text faded, and sticky recall grading buttons">
            </div>
          </div>
          <figcaption><strong>Review with focus</strong><span>Recall in Quran order, then let the app choose the next review time.</span></figcaption>
        </figure>
        <figure class="quran-memorization-preview-card" role="listitem">
          <div class="quran-memorization-preview-visual quran-memorization-preview-visual-progress">
            <div class="quran-memorization-preview-concept">
              <span class="quran-memorization-preview-kicker">Progress</span>
              <strong>Know what to review next</strong>
              <span>Your hifz history stays synced across devices.</span>
            </div>
            <div class="quran-memorization-preview-screenshot">
              <img src="/images/quran/memorization-progress-preview.svg" width="640" height="960" loading="lazy" alt="Memorization Progress showing review activity, state totals, and pages grouped by surah">
            </div>
          </div>
          <figcaption><strong>See every step</strong><span>Follow activity, due reviews, and memorization states across the Quran.</span></figcaption>
        </figure>
      </div>
    </section>
    <article class="quran-memorization-help-article text-start mx-auto" aria-labelledby="quran-memorization-help-article-title">
      <header class="quran-memorization-help-article-header">
        <p class="quran-memorization-help-kicker mb-1"><span class="badge rounded-pill text-bg-primary">How it works</span> Quran memorization guide</p>
        <h2 class="fs-4 mb-0" id="quran-memorization-help-article-title">How Quran memorization works</h2>
      </header>
      <div class="quran-memorization-help-body">
        <%- include('sub-views/quran_memorization_help_content.ejs', { helpIdPrefix: 'quran-memorization-help-article' }); %>
      </div>
    </article>
  </main>
  <main class="container col-lg-8 mx-auto mt-10 quran-ayah-progress-page" id="quran-memorization-progress" hidden>
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap">
      <div><h1 class="fs-4 mb-1">Memorization Progress</h1><p class="text-muted small mb-0">Track every memorized āyah, see what is due now, and begin a guided review. Progress is organized by surah and Mushaf page.</p></div>
      <div class="d-flex align-items-center justify-content-end gap-2 ms-auto quran-progress-actions">
        <button type="button" class="btn btn-outline-secondary btn-sm quran-progress-secondary-action" data-bs-toggle="modal" data-bs-target="#quran-fsrs-settings-modal" aria-label="Review settings" title="Review settings"><i class="bi bi-sliders" aria-hidden="true"></i><span class="quran-progress-secondary-action-label">Review settings</span></button>
        <a class="btn btn-outline-secondary btn-sm quran-progress-secondary-action" href="<%= helpUrl %>" aria-label="How Quran memorization works" title="How it works"><i class="bi bi-question-circle" aria-hidden="true"></i><span class="quran-progress-secondary-action-label">How it works</span></a>
        <div class="dropdown">
          <button type="button" class="btn btn-primary btn-sm dropdown-toggle" id="quran-start-review" data-bs-toggle="dropdown" aria-expanded="false"><span id="quran-start-review-label">Start Review</span></button>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="quran-start-review">
            <li><a class="dropdown-item" id="quran-start-regular-review" href="<%= utils.quranUrl(req, '/quran/review?continue=1') %>"><i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i><span id="quran-start-regular-review-label">Regular Review</span></a></li>
            <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#quran-surah-review-modal"><i class="bi bi-book me-2" aria-hidden="true"></i>Surah Review</button></li>
          </ul>
        </div>
      </div>
    </div>
    <section class="quran-paused-review-sessions mb-3" id="quran-open-review-sessions" aria-labelledby="quran-open-review-sessions-title" hidden>
      <div class="d-flex justify-content-between align-items-baseline gap-2 mb-2 flex-wrap"><h2 class="fs-6 fw-bold mb-0" id="quran-open-review-sessions-title">Your review sessions</h2><span class="small text-muted">Continue, switch, or end a session</span></div>
      <div class="quran-paused-review-session-list" id="quran-open-review-session-list"></div>
    </section>
    <section class="quran-review-activity mb-3" aria-labelledby="quran-review-activity-title">
      <div class="d-flex justify-content-between gap-2 align-items-baseline flex-wrap"><h2 class="fs-6 fw-bold mb-1" id="quran-review-activity-title">Review activity</h2><p class="small mb-1" id="quran-review-today-summary">Loading review activity...</p></div>
      <div class="quran-review-heatmap-wrap" aria-label="Review activity for the past year"><div class="quran-review-heatmap" id="quran-review-heatmap"></div></div>
      <p class="quran-review-heatmap-detail small text-muted mb-2" id="quran-review-heatmap-detail" role="status" aria-live="polite">Hover over or tap a day to see its review activity.</p>
      <div class="quran-review-stat-row" id="quran-review-stat-row"><span><strong>Daily average</strong> <b data-review-stat="daily_average">0</b> ayat</span><span><strong>Days learned</strong> <b data-review-stat="days_learned_percent">0%</b></span><span><strong>Longest streak</strong> <b data-review-stat="longest_streak">0 days</b></span><span><strong>Current streak</strong> <b data-review-stat="current_streak">0 days</b></span></div>
    </section>
    <section class="quran-memorization-summary mb-3" aria-label="Memorization totals">
      <% [['due_today','Due now'],['learning','Learning'],['weak','Weak'],['review','Memorized'],['core','Core'],['suspended','Paused'],['later','Later']].forEach(function (item) { %>
      <button type="button" class="card text-start quran-progress-summary-card" data-progress-filter="<%= item[0] %>" aria-pressed="false"<% if (item[0] === 'later') { %> disabled title="Untouched ayat are counted here but are not listed"<% } %>><span class="quran-progress-summary-label"><%= item[1] %></span><strong class="quran-progress-summary-count" data-progress-count="<%= item[0] %>">—</strong></button>
      <% }); %>
    </section>
    <div class="page-content-filter input-group input-group-sm mb-3 memorization-progress-filter">
      <span class="input-group-text"><i class="bi bi-filter" aria-hidden="true"></i></span>
      <input type="search" class="form-control" id="quran-ayah-progress-filter" placeholder="Filter by page, Juz, Surah, state, or Arabic text" aria-label="Filter memorization progress by page, Juz, Surah, state, or Arabic text" autocomplete="off">
      <button type="button" class="btn btn-outline-secondary" id="quran-ayah-progress-filter-clear" aria-label="Clear progress filter" hidden><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
    <p id="quran-ayah-progress-status" class="text-muted small" role="status" aria-live="polite">Loading ayah progress...</p>
    <div class="table-responsive memorization-progress-table-wrap">
      <table class="table table-hover align-middle mb-0 memorization-progress-table" id="quran-ayah-progress-table" hidden>
        <thead><tr><th>Unit</th><th>State</th><th>Starting ayah</th><th>Next review</th><th>Reviews</th></tr></thead><tbody></tbody>
      </table>
    </div>
  </main>
  <main class="container mt-10 text-center page-loading-page" id="quran-memorization-auth-loading"<% if (helpView) { %> hidden<% } %>>
    <div class="page-loading" role="status" aria-live="polite">
      <span class="spinner-border text-primary" aria-hidden="true"></span>
      <span class="text-muted">Loading Quran memorization...</span>
    </div>
  </main>
  <div class="modal fade" id="quran-surah-review-modal" tabindex="-1" aria-labelledby="quran-surah-review-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <form class="modal-content" id="quran-surah-review-form">
        <header class="modal-header"><h2 class="modal-title fs-5" id="quran-surah-review-title">Start a Surah Review</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></header>
        <div class="modal-body">
          <label class="form-label" for="quran-surah-review-input"><strong>Surah</strong></label>
          <input type="search" class="form-control" id="quran-surah-review-input" placeholder="Type a surah name or number" aria-label="Choose a surah by English name, Arabic name, or number" autocomplete="off" autocapitalize="none" spellcheck="false" required>
          <input type="hidden" id="quran-surah-review-select" value="">
          <div class="mt-3" id="quran-surah-review-page-choice" hidden>
            <label class="form-label" for="quran-surah-review-page-limit"><strong>How much would you like to review?</strong></label>
            <select class="form-select" id="quran-surah-review-page-limit"></select>
            <p class="form-text mb-0">Pages start from the beginning of the surah. Choose All āyāt to review the complete surah.</p>
          </div>
          <p class="form-text mb-0 mt-3">The selected scope is reviewed in Quran order. Later āyāt become Learning cards and are added to your schedule. Regular session limits and the time budget do not apply.</p>
          <p class="small text-muted mt-3 mb-0" id="quran-surah-review-status" role="status" aria-live="polite"></p>
        </div>
        <footer class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary" id="quran-surah-review-start">Start Surah Review</button></footer>
      </form>
    </div>
  </div>
  <%- include('sub-views/quran_memorization_help_modal.ejs', { site: site, page: page }); %>
  <%- include('sub-views/quran_fsrs_settings_modal.ejs', { site: site, page: page }); %>
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  <script>
    (async function () {
      const labels = { later: 'Later', learning: 'Learning', weak: 'Weak', review: 'Memorized', core: 'Core', relearning: 'Weak', suspended: 'Paused' };
      const stageOrder = ['learning', 'weak', 'review', 'core', 'suspended'];
      const status = document.getElementById('quran-ayah-progress-status');
      const table = document.getElementById('quran-ayah-progress-table');
      const filter = document.getElementById('quran-ayah-progress-filter');
      const clear = document.getElementById('quran-ayah-progress-filter-clear');
      const startReviewLabel = document.getElementById('quran-start-review-label');
      const regularReview = document.getElementById('quran-start-regular-review');
      const regularReviewLabel = document.getElementById('quran-start-regular-review-label');
      const surahReviewForm = document.getElementById('quran-surah-review-form');
      const surahReviewInput = document.getElementById('quran-surah-review-input');
      const surahReviewSelect = document.getElementById('quran-surah-review-select');
      const surahReviewPageChoice = document.getElementById('quran-surah-review-page-choice');
      const surahReviewPageLimit = document.getElementById('quran-surah-review-page-limit');
      const surahReviewStart = document.getElementById('quran-surah-review-start');
      const surahReviewStatus = document.getElementById('quran-surah-review-status');
      const reviewSessionsSection = document.getElementById('quran-open-review-sessions');
      const reviewSessionsList = document.getElementById('quran-open-review-session-list');
      const reviewHeatmapWrap = document.querySelector('.quran-review-heatmap-wrap');
      const reviewHeatmap = document.getElementById('quran-review-heatmap');
      const reviewHeatmapDetail = document.getElementById('quran-review-heatmap-detail');
      const surahCatalog = <%- JSON.stringify((global.surahs || []).map(function (surah) { return { number: Number(surah.num), english: surah.name_en || '', arabic: surah.name_ar || '', aliases: surah.aliases || [] }; })) %>;
      const escapeHtml = value => (value ?? '').toString().replace(/[&<>"']/g, character => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[character]));
      const legacyNotice = <%- JSON.stringify(req.query.complete !== undefined
        ? { type:'success', title:'Review complete', message:'You completed this review session.' }
        : req.query.paused !== undefined
          ? { type:'info', title:'Review paused', message:'Resume it whenever you are ready.' }
          : req.query.ended !== undefined
            ? { type:'info', title:'Review ended', message:'Completed reviews remain saved.' }
            : null) %>;
      const historyNotice = window.history.state && window.history.state.pageNotice;
      const pageNotice = historyNotice || legacyNotice;
      if (pageNotice) {
        const cleanUrl = new URL(window.location.href);
        ['complete','paused','ended'].forEach(key => cleanUrl.searchParams.delete(key));
        const cleanState = Object.assign({}, window.history.state || {});
        delete cleanState.pageNotice;
        window.history.replaceState(cleanState, '', `${cleanUrl.pathname}${cleanUrl.search}${cleanUrl.hash}`);
        window.setTimeout(() => {
          if (!window.toastr) return;
          const method = typeof window.toastr[pageNotice.type] === 'function' ? pageNotice.type : 'info';
          window.toastr[method](pageNotice.message, pageNotice.title);
        }, 0);
      }
      const openingWords = (value, maximum = 4) => { const words=(value||'').trim().split(/\s+/).filter(Boolean); return `${words.slice(0,maximum).join(' ')}${words.length>maximum?' …':''}`; };
      const waitForAuth = async () => { for (let i=0; i<50 && (!window.hadithAuth || !window.hadithAuth.getToken); i++) await new Promise(resolve => setTimeout(resolve,100)); return window.hadithAuth; };
      const auth = await waitForAuth();
      const token = auth && await auth.getToken();
      const loading = document.getElementById('quran-memorization-auth-loading');
      const welcome = document.getElementById('quran-memorization-welcome');
      const progress = document.getElementById('quran-memorization-progress');
      if (loading) loading.hidden = true;
      if (<%= helpView ? 'true' : 'false' %>) {
        document.title = 'Memorize the Quran';
        if (token) {
          const signInButton = document.getElementById('quran-memorization-sign-in');
          if (signInButton) {
            signInButton.dataset.authenticated = '1';
            signInButton.innerHTML = '<i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i> Open my memorization progress';
          }
        }
        return;
      }
      if (!token) {
        document.title = 'Memorize the Quran';
        if (welcome) welcome.hidden = false;
        return;
      }
      if (progress) progress.hidden = false;
      const request = async (path, options = {}) => { const response=await fetch(quranApiPath(`/memorization${path}`),{credentials:'same-origin',method:options.method||'GET',headers:Object.assign({Authorization:`Bearer ${token}`},options.body?{'Content-Type':'application/json'}:{}),body:options.body?JSON.stringify(options.body):undefined}); const data=await response.json().catch(()=>({})); if(!response.ok) throw new Error(data.error||'Unable to load memorization progress.'); return data; };
      const userSettingsRequest = async (options={}) => { const response=await fetch(quranApiPath('/user-settings'),{credentials:'same-origin',method:options.method||'GET',headers:Object.assign({Authorization:`Bearer ${token}`},options.body?{'Content-Type':'application/json'}:{}),body:options.body?JSON.stringify(options.body):undefined}); const data=await response.json().catch(()=>({})); if(!response.ok) throw new Error(data.error||'Unable to load settings.'); return data; };
      let reviewUserSettings=null;
      const fsrsControls={retention:document.getElementById('review-fsrs-retention'),learningSpeed:document.getElementById('review-fsrs-learning-speed'),growth:document.getElementById('review-fsrs-growth'),lapse:document.getElementById('review-fsrs-lapse'),sessionLimit:document.getElementById('review-session-limit'),timeBudget:document.getElementById('review-time-budget'),learningLimit:document.getElementById('review-learning-limit'),relearningLimit:document.getElementById('review-relearning-limit'),weakLimit:document.getElementById('review-weak-limit'),memorizedLimit:document.getElementById('review-memorized-limit'),queueOrder:document.getElementById('review-queue-order'),save:document.getElementById('review-fsrs-save'),optimize:document.getElementById('review-fsrs-optimize'),status:document.getElementById('review-fsrs-status')};
      const cacheReviewSettings=async settings=>{if(!window.hadithUserSettingsCache)return;const user=auth.getUser?await auth.getUser():null;if(window.hadithUserSettingsCache.clear)window.hadithUserSettingsCache.clear(user);if(settings&&window.hadithUserSettingsCache.write)window.hadithUserSettingsCache.write(user,settings);};
      const populateFsrsControls=settings=>{const memorization=settings&&settings.memorization||{};const fsrs=memorization.fsrs||{};fsrsControls.retention.value=String(fsrs.targetRetention||0.9);fsrsControls.learningSpeed.value=fsrs.learningSpeed||'normal';fsrsControls.growth.value=fsrs.intervalGrowth||'standard';fsrsControls.lapse.value=fsrs.lapseRecovery||'standard';fsrsControls.sessionLimit.value=memorization.reviewLimit||10;fsrsControls.timeBudget.value=memorization.reviewTimeBudgetMinutes||0;fsrsControls.learningLimit.value=memorization.learningLimit||3;fsrsControls.relearningLimit.value=memorization.relearningLimit||4;fsrsControls.weakLimit.value=memorization.weakLimit||3;fsrsControls.memorizedLimit.value=memorization.memorizedLimit||10;fsrsControls.queueOrder.value=memorization.reviewOrder||'due_first';if(fsrs.optimizedAt)fsrsControls.status.textContent=`Last personalized ${new Date(fsrs.optimizedAt).toLocaleDateString()}.`;};
      const loadFsrsSettings=async()=>{const data=await userSettingsRequest();reviewUserSettings=data.settings||{};populateFsrsControls(reviewUserSettings);};
      fsrsControls.save.addEventListener('click',async()=>{fsrsControls.save.disabled=true;fsrsControls.status.textContent='Saving...';try{const existing=reviewUserSettings&&reviewUserSettings.memorization||{};const fsrs=existing.fsrs||{};const data=await userSettingsRequest({method:'PUT',body:{settings:{...reviewUserSettings,memorization:{...existing,reviewLimit:fsrsControls.sessionLimit.value,reviewTimeBudgetMinutes:fsrsControls.timeBudget.value,learningLimit:fsrsControls.learningLimit.value,relearningLimit:fsrsControls.relearningLimit.value,weakLimit:fsrsControls.weakLimit.value,memorizedLimit:fsrsControls.memorizedLimit.value,reviewOrder:fsrsControls.queueOrder.value,fsrs:{...fsrs,targetRetention:Number(fsrsControls.retention.value),learningSpeed:fsrsControls.learningSpeed.value,intervalGrowth:fsrsControls.growth.value,lapseRecovery:fsrsControls.lapse.value}}}}});reviewUserSettings=data.settings;await cacheReviewSettings(reviewUserSettings);populateFsrsControls(reviewUserSettings);fsrsControls.status.textContent='Review settings saved.';const modal=bootstrap.Modal.getInstance(document.getElementById('quran-fsrs-settings-modal'));if(modal)modal.hide();}catch(err){fsrsControls.status.textContent=err.message;}finally{fsrsControls.save.disabled=false;}});
      fsrsControls.optimize.addEventListener('click',async()=>{fsrsControls.optimize.disabled=true;fsrsControls.status.textContent='Analyzing your review history...';try{const data=await request('/fsrs/optimize',{method:'POST'});reviewUserSettings=reviewUserSettings||{};reviewUserSettings.memorization={...(reviewUserSettings.memorization||{}),fsrs:data.fsrs};await cacheReviewSettings(reviewUserSettings);populateFsrsControls(reviewUserSettings);fsrsControls.status.textContent=`Personalized from ${Number(data.review_count).toLocaleString()} reviews.`;}catch(err){fsrsControls.status.textContent=err.message;}finally{fsrsControls.optimize.disabled=false;}});
      const scrollHeatmapToToday=()=>{if(!reviewHeatmapWrap)return;window.requestAnimationFrame(()=>{reviewHeatmapWrap.scrollLeft=reviewHeatmapWrap.scrollWidth;});};
      const reviewDuration=totalSeconds=>{const seconds=Math.max(0,Math.round(Number(totalSeconds)||0));if(seconds<60)return `${seconds} second${seconds===1?'':'s'}`;const totalMinutes=Math.round(seconds/60);if(totalMinutes<60)return `${totalMinutes} minute${totalMinutes===1?'':'s'}`;const hours=Math.floor(totalMinutes/60);const minutes=totalMinutes%60;return `${hours} hour${hours===1?'':'s'}${minutes?` ${minutes} minute${minutes===1?'':'s'}`:''}`;};
