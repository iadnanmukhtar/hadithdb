        const [progressData,activeData,openData]=await Promise.all([request('/progress/groups'),request('/review/sessions/active'),request('/review/sessions/open')]);
        Object.entries(progressData.progress||{}).forEach(([key,value])=>{ const element=document.querySelector(`[data-progress-count="${key}"]`); if(element) element.textContent=Number(value).toLocaleString(); });
        const dueNow=Math.max(0,Number(progressData.progress&&progressData.progress.due_today)||0);
        groups=Array.isArray(progressData.groups)?progressData.groups:[];
        const activeSession=activeData&&activeData.session;
        renderReviewSessions(openData&&openData.sessions);
        if(regularReview){
          regularReview.href=quranUrl(`/quran/review?${activeSession?'continue':'start'}=1`);
          startReviewLabel.textContent=activeSession?'Continue Review':'Start Review';
          if(activeSession&&activeSession.session_mode==='surah'){
            const selectedSurah=groups.find(group=>Number(group.surah_number)===Number(activeSession.review_surah_number));
            const surahName=selectedSurah&&selectedSurah.surah_name||`Surah ${activeSession.review_surah_number}`;
            regularReviewLabel.textContent=`Continue ${surahName} Review`;
            regularReview.setAttribute('aria-label',`Continue the active review of ${surahName}`);
          }else if(activeSession&&activeSession.session_mode==='page'){
            regularReviewLabel.textContent=`Continue Page ${activeSession.review_page_number} Review`;
            regularReview.setAttribute('aria-label',`Continue the active review of Mushaf page ${activeSession.review_page_number}`);
          }else{
            regularReviewLabel.textContent='Regular Review';
            regularReview.setAttribute('aria-label',activeSession?`Regular Review, ${dueNow?`${dueNow} ${dueNow===1?'āyah':'āyāt'} due now`:'session in progress'}`:'Regular Review');
          }
        }
        populateSurahReviews();
        updateTileSelection();
        render();
      };
      try { await loadProgress(); } catch(err) { status.textContent=err.message; return; }
      surahReviewForm.addEventListener('submit',async event=>{
        event.preventDefault();
        const surahNumber=Number(surahReviewSelect.value);
        if(!Number.isInteger(surahNumber)){surahReviewInput.classList.add('is-invalid');surahReviewStatus.textContent='Choose a surah from the suggestions.';surahReviewInput.focus();return;}
        const choice=surahReviewChoices.get(surahNumber);
        const needsPageChoice=choice&&choice.pages.length>3;
        const selectedLimit=surahReviewPageLimit.value;
        const pageLimit=needsPageChoice&&selectedLimit!=='all'?Number(selectedLimit):null;
        surahReviewStart.disabled=true;
        surahReviewStatus.textContent=pageLimit?`Preparing a ${pageLimit}-page Surah Review...`:'Preparing all āyāt...';
        if(window.showQuranReviewLoading)window.showQuranReviewLoading('Preparing your review...');
        try{
          await request('/review/sessions',{method:'POST',body:{mode:'surah',surah_number:surahNumber,page_limit:pageLimit}});
          if(window.navigateWithQuranReviewLoading)window.navigateWithQuranReviewLoading(quranUrl('/quran/review?continue=1'),'Loading your review...');
          else window.location.assign(quranUrl('/quran/review?continue=1'));
        }catch(err){if(window.hideQuranReviewLoading)window.hideQuranReviewLoading();surahReviewStatus.textContent=err.message;surahReviewStart.disabled=false;}
      });
      document.querySelectorAll('[data-progress-filter]:not(:disabled)').forEach(button=>button.addEventListener('click',()=>{selectedStage=selectedStage===button.dataset.progressFilter?'':button.dataset.progressFilter;updateStageUrl();updateTileSelection();render();}));
      filter.addEventListener('input',render); clear.addEventListener('click',()=>{filter.value='';render();filter.focus();});
      document.addEventListener('click',async event=>{
        const resume=event.target.closest&&event.target.closest('[data-resume-review-session]');
        if(resume&&reviewSessionsList.contains(resume)){
          event.preventDefault();
          resume.disabled=true;
          if(window.showQuranReviewLoading)window.showQuranReviewLoading(resume.textContent.includes('Switch')?'Switching reviews...':'Loading your review...');
          try{
            await request(`/review/sessions/${encodeURIComponent(resume.dataset.resumeReviewSession)}/resume`,{method:'POST'});
            if(window.navigateWithQuranReviewLoading)window.navigateWithQuranReviewLoading(quranUrl('/quran/review?continue=1'),resume.textContent.includes('Switch')?'Switching reviews...':'Loading your review...');
            else window.location.assign(quranUrl('/quran/review?continue=1'));
          }catch(err){if(window.hideQuranReviewLoading)window.hideQuranReviewLoading();resume.disabled=false;if(window.toastr)window.toastr.error(err.message,'Unable to resume review');else status.textContent=err.message;}
          return;
        }
        const end=event.target.closest&&event.target.closest('[data-end-review-session]');
        if(end&&reviewSessionsList.contains(end)){
          event.preventDefault();
          if(!window.confirm('End this review session? Completed reviews will remain saved, but its remaining queue will be closed.'))return;
          end.disabled=true;
          try{
            await request(`/review/sessions/${encodeURIComponent(end.dataset.endReviewSession)}/end`,{method:'POST'});
            await loadProgress();
            if(window.toastr)window.toastr.success('Review session ended.');
          }catch(err){end.disabled=false;if(window.toastr)window.toastr.error(err.message,'Unable to end review');else status.textContent=err.message;}
          return;
        }
        const trigger=event.target.closest&&event.target.closest('[data-progress-group-state]');
        if(trigger&&table.contains(trigger)){
          event.preventDefault();
          if(!groupStateMenu.hidden&&activeGroupStateTrigger===trigger) closeGroupStateMenu(true);
          else showGroupStateMenu(trigger,event.detail===0);
          return;
        }
        const option=event.target.closest&&event.target.closest('[data-progress-group-state-option]');
        if(option&&groupStateMenu.contains(option)&&activeGroupStateTrigger){
          event.preventDefault();
          const activeTrigger=activeGroupStateTrigger;
          const next=option.dataset.progressGroupStateOption;
          const current=activeTrigger.dataset.currentState||'mixed';
          const groupKey=activeTrigger.dataset.progressGroupState;
          closeGroupStateMenu(true);
          if(!next||next===current) return;
          activeTrigger.disabled=true;
          activeTrigger.setAttribute('aria-busy','true');
          groupStateMenu.querySelectorAll('[data-progress-group-state-option]').forEach(item=>{item.disabled=true;});
          try {
            await request('/progress/groups/state',{method:'PUT',body:{group_key:groupKey,lifecycle_state:next}});
            await loadProgress();
          } catch(err) {
            if(window.toastr) window.toastr.error(err.message);
            else status.textContent=err.message;
            render();
          } finally {
            if(activeTrigger.isConnected){activeTrigger.disabled=false;activeTrigger.removeAttribute('aria-busy');}
          }
          return;
        }
        if(!groupStateMenu.hidden&&!groupStateMenu.contains(event.target)) closeGroupStateMenu(false);
      });
      groupStateMenu.addEventListener('keydown',event=>{
        if(groupStateMenu.hidden) return;
        if(event.key==='Escape'){event.preventDefault();closeGroupStateMenu(true);return;}
        if(event.key==='Tab'){closeGroupStateMenu(false);return;}
        const options=Array.from(groupStateMenu.querySelectorAll('[data-progress-group-state-option]:not([hidden]):not(:disabled)'));
        const index=options.indexOf(document.activeElement);
        let nextIndex=null;
        if(event.key==='ArrowDown') nextIndex=index<0?0:(index+1)%options.length;
        if(event.key==='ArrowUp') nextIndex=index<0?options.length-1:(index-1+options.length)%options.length;
        if(event.key==='Home') nextIndex=0;
        if(event.key==='End') nextIndex=options.length-1;
        if(nextIndex===null||!options.length) return;
        event.preventDefault();
        options[nextIndex].focus();
      });
      window.addEventListener('scroll',()=>{if(!groupStateMenu.hidden) closeGroupStateMenu(false);},{passive:true});
      window.addEventListener('resize',()=>{if(!groupStateMenu.hidden&&activeGroupStateTrigger) positionGroupStateMenu(activeGroupStateTrigger);},{passive:true});
    }());
  </script>
  <script>
    (function () {
      const button = document.getElementById('quran-memorization-sign-in');
      if (!button) return;
      button.addEventListener('click', async function () {
        if (button.dataset.authenticated === '1') {
          window.location.assign(quranUrl('/quran/review'));
          return;
        }
        button.disabled = true;
        for (let attempt = 0; attempt < 50 && (!window.hadithAuth || !window.hadithAuth.openSignIn); attempt += 1)
          await new Promise(resolve => window.setTimeout(resolve, 100));
        const opened = window.hadithAuth && window.hadithAuth.openSignIn
          ? await window.hadithAuth.openSignIn()
          : false;
        if (!opened) {
          if (window.toastr) window.toastr.error('Google sign-in is not available yet. Please try again.', 'Sign-in unavailable');
        }
        window.setTimeout(function () { button.disabled = false; }, 1200);
      });
      document.addEventListener('hadithAuthChanged', function (event) {
        if (!(event.detail && event.detail.user)) return;
        window.setTimeout(function () { window.location.assign(quranUrl('/quran/review')); }, 1800);
      });
    }());
  </script>
</body>
</html>
