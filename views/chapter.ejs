<!doctype html>
<html lang="en">

<head>
  <%
    var site = Object.assign({}, global.settings.site);
    site.admin = (!locals.noadmin && req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;

    var book = chapter.book;
    var isQuranAyatView = book.alias === 'quran' && req.query.ayat !== undefined;
    var chapterPageNumber = chapter.page && chapter.page.number && (chapter.page.hasNext || chapter.page.number > 1)
      ? `, pg. ${chapter.page.number}`
      : '';
    var chapterMetaTitle = utils.truncate(chapter.title_en || chapter.title || '', 55, true);
    var page = {
      menu: 'Chapter',
      title_en: `${book.shortName_en} §${chapter.h1}${chapterPageNumber} | ${chapter.title_en || chapter.title}`,
      description_en: `Read ${book.name_en || book.shortName_en} chapter ${chapter.h1}${chapterMetaTitle ? `, ${chapterMetaTitle}` : ''}, with Arabic text, English translation, and source references.`,
      subtitle_en: `${book.shortName_en}`,
      subtitle: `${book.shortName}`,
      canonical: `${book.alias === 'quran' ? `/${book.alias}/${chapter.h1}` : utils.canonicalHadithHeadingPath(`/${book.alias}/${chapter.h1}`)}${isQuranAyatView ? '' : (req.originalUrl.includes('?') ? '?'+qs.stringify(req.query) : '')}`,
      noindex: isQuranAyatView,
      context: {
        book: book,
        chapter: chapter,
        heading: chapter,
        continued: false
      }
    };
    var readerInfiniteEnabled = book.alias !== 'quran';
    function readerHeadingLabel(direction, heading) {
      if (!heading)
        return direction === 'Prev' ? 'Previous' : 'Next';
      var pageType = page && page.type ? page.type : '';
      if (heading.level == 1)
        return `${direction}${pageType}: ${heading.book.shortName_en} ${heading.h1}`;
      if (heading.level == 2)
        return `${direction}${pageType}: ${heading.book.shortName_en} §${heading.h1}.${heading.h2}`;
      return direction === 'Prev' ? 'Previous' : 'Next';
    }
    if (readerInfiniteEnabled) {
      var readerHeading = page.context.heading;
      var readerHeadingPage = readerHeading && readerHeading.page ? readerHeading.page : {};
      page.type = '';
      if (readerHeadingPage.hasPrev) {
        page.type = ' Page';
        page.prevHeading = readerHeading;
        page.prev = `/${readerHeading.path}?o=${readerHeadingPage.prevOffset}`;
        if (req.query.passage != undefined)
          page.prev += '&passage';
      } else if (readerHeading && readerHeading.prev) {
        page.prevHeading = readerHeading.prev;
        page.prev = `/${page.prevHeading.path}`;
        if (req.query.passage != undefined)
          page.prev += '?passage';
      }
      if (page.prev)
        page.prevTitle = readerHeadingLabel('Prev', page.prevHeading);
      if (readerHeadingPage.hasNext) {
        page.type = ' Page';
        page.nextHeading = readerHeading;
        page.next = `/${readerHeading.path}?o=${readerHeadingPage.nextOffset}`;
        if (req.query.passage != undefined)
          page.next += '&passage';
      } else if (readerHeading && readerHeading.next) {
        page.nextHeading = readerHeading.next;
        page.next = `/${page.nextHeading.path}`;
        if (req.query.passage != undefined)
          page.next += '?passage';
      }
      if (page.next)
        page.nextTitle = readerHeadingLabel('Next', page.nextHeading);
    }
    var readerCurrentUrl = req.originalUrl || req.url || req.path;
    var readerPrevUrl = readerInfiniteEnabled && page.prev ? utils.urlFor(req, page.prev) : '';
    var readerNextUrl = readerInfiniteEnabled && page.next ? utils.urlFor(req, page.next) : '';
    var readerContextKey = `${book.alias}:${chapter.h1}`;
    var hadithChapterPathParts = (chapter.path || '').toString().split('/').filter(Boolean);
    var hadithChapterPathNumber = hadithChapterPathParts[hadithChapterPathParts.length - 1] || chapter.h1;
    var hadithFlatHeadingKey = `${book.alias}:${hadithChapterPathNumber}`;
    var hadithHeadingOutlines = locals.hadithHeadingOutlines || {};
    var hadithHeadingContextKey = hadithHeadingOutlines[readerContextKey] ? readerContextKey : `${book.alias}:flat`;
    var hadithHeadingOutline = hadithHeadingOutlines[hadithHeadingContextKey];
    var showHadithHeadingToc = hadithHeadingOutline && (hadithHeadingOutline.sections || []).length > 0;
    var hadithFlatHeadingRail = Boolean(showHadithHeadingToc && hadithHeadingOutline.flat);
    var hadithHeadingInitialKey = showHadithHeadingToc
      ? (hadithFlatHeadingRail ? hadithFlatHeadingKey : hadithHeadingOutline.sections[0].key)
      : '';
  %>
  
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
  
</head>

<body>
  
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  
  <div class="<%= showHadithHeadingToc ? 'container-fluid hadith-heading-layout' : 'container col-lg-8 mx-auto' %>">
    <% if (showHadithHeadingToc) { %><div class="container col-lg-8 mx-auto hadith-heading-content"><% } %>
    
    <main class="chapter mt-10"<% if (readerInfiniteEnabled) { %> data-reader-infinite="hadith-chapter" data-reader-context-key="<%= readerContextKey %>" data-reader-current-url="<%= readerCurrentUrl %>"<% if (readerPrevUrl) { %> data-reader-prev-url="<%= readerPrevUrl %>" data-reader-prev-title="<%= page.prevTitle || 'Previous' %>"<% } %><% if (readerNextUrl) { %> data-reader-next-url="<%= readerNextUrl %>" data-reader-next-title="<%= page.nextTitle || 'Next' %>"<% } %><% } %>>
      
      <%- include('sub-views/chapterTitle.ejs', {
        site: site,
        page: page,
        hadithFlatHeadingRail: hadithFlatHeadingRail,
        hadithFlatHeadingContext: hadithHeadingContextKey,
        hadithFlatHeadingKey: hadithFlatHeadingKey
      }); %>
              
      <%
      var lastPath = -1;
      var n = -1;
      for (var item of results) {
        n++;
        var showHeading = (item.path != lastPath && item.heading && item.heading.level > 1);
        lastPath = item.path;
      %>
      
      <% if (n === 0 && item.heading && item.heading.level === 3) {
            page.context.continued = true; %>
      <%- include('sub-views/heading.ejs', { site: site, page: page, heading: item.section }); %>
      <%   page.context.continued = false;
          } else {
            page.context.continued = false;
          } %>
      
      <% if (showHeading) { %>
      <%- include('sub-views/heading.ejs', { site: site, page: page, heading: item.heading }); %>
      <% } %>
      
      <% if (item.id) { %>
      <%- include('sub-views/hadith.ejs', { site: site, page: page, i: item, main: false, title: false, searchResult: false, contentTranslationBrowse: true }); %>
      <% } %>
      
      <% } %>
              
    </main>
    <% if (showHadithHeadingToc) { %></div>
    <%- include('sub-views/hadith_heading_toc.ejs', {
      hadithHeadingOutlines: hadithHeadingOutlines,
      hadithHeadingInitialContext: hadithHeadingContextKey,
      hadithHeadingInitialKey: hadithHeadingInitialKey
    }); %>
    <% } %>
  </div>
  
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  
</body>

</html>
