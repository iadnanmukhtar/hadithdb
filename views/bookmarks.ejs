<!doctype html>
<html lang="en">

<head>
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (req.admin);
    site.editMode = false;
%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %>
<style>
  .bookmarks-page {
    padding-bottom: 3rem;
  }
  .bookmarks-page-header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    padding: 1.5rem 0 1rem;
  }
  .bookmark-section {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-top: 1.25rem;
    margin-top: 1.25rem;
  }
  .bookmark-section:not(.d-none) {
    margin-top: 1.25rem;
  }
  .bookmarks-page-header + #bookmarks-loading.d-none + #bookmarks-empty.d-none + .bookmark-section:not(.d-none),
  .bookmarks-page-header + #bookmarks-loading.d-none + #bookmarks-empty.d-none + .bookmark-section.d-none + .bookmark-section:not(.d-none),
  .bookmarks-page-header + #bookmarks-loading.d-none + #bookmarks-empty.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section:not(.d-none),
  .bookmarks-page-header + #bookmarks-loading.d-none + #bookmarks-empty.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section:not(.d-none),
  .bookmarks-page-header + #bookmarks-loading.d-none + #bookmarks-empty.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section:not(.d-none),
  .bookmarks-page-header + #bookmarks-loading.d-none + #bookmarks-empty.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section:not(.d-none),
  .bookmarks-page-header + #bookmarks-loading.d-none + #bookmarks-empty.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section.d-none + .bookmark-section:not(.d-none) {
    border-top: 0;
    margin-top: 0;
  }
  .bookmark-section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .75rem;
  }
  .bookmark-section-title {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin: 0;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .bookmark-section-count {
    color: #6c757d;
    font-size: .85rem;
    white-space: nowrap;
  }
  .bookmark-compact-item {
    display: flex;
    align-items: flex-start;
    gap: .65rem;
  }
  .bookmark-compact-content {
    min-width: 0;
  }
  .bookmark-compact-title {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 .25rem 0;
  }
  .bookmark-compact-title a {
    text-decoration: none;
    color: inherit;
    transition: color .15s ease;
  }
  .bookmark-compact-title a:hover,
  .bookmark-compact-title a:focus {
    color: var(--c-note);
    text-decoration: underline;
  }
  .bookmark-compact-ref {
    color: #6c757d;
    font-size: .85rem;
  }
  .bookmark-compact-ar {
    color: #6c757d;
    margin-top: .15rem;
    text-align: right;
    width: 100%;
  }
  .bookmark-compact-body {
    color: #4f5b66;
    font-size: .95rem;
    line-height: 1.45;
    margin-top: .3rem;
  }
  .bookmark-quran-ayah {
    color: var(--c-black);
    font-size: calc(1.35rem * var(--content-font-scale));
    line-height: 1.8;
    text-align: right;
  }
  .bookmark-quran-ayah .quran-ayah-end-marker {
    font-size: inherit;
    line-height: inherit;
    white-space: nowrap;
  }
  .bookmark-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .bookmark-heading {
    background: #fff;
  }
  .bookmark-heading-title,
  .bookmark-tafsir-title {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
    margin-bottom: .25rem;
  }
  .bookmark-heading-meta,
  .bookmark-tafsir-meta {
    color: #6c757d;
    font-size: .875rem;
  }
  .bookmark-list > :last-child {
    border-bottom: 0 !important;
    padding-bottom: 0 !important;
  }
  @media (max-width: 575.98px) {
    .bookmark-section-header {
      align-items: flex-start;
      flex-direction: column;
      gap: .25rem;
    }
  }
</style>

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %>

  <div class="container col-lg-9 mx-auto bookmarks-page">
    <main class="search-results">
      <div class="bookmarks-page-header">
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
          <div>
            <h1 class="fs-3 mb-1">Bookmarks</h1>
            <p class="text-muted mb-0">Saved Quran pages and passages, tafsir passages, hadith chapters, and hadiths.</p>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm" id="clear-bookmarks-btn">
            <i class="bi bi-trash3 me-1"></i>Clear all
          </button>
        </div>
      </div>

      <div id="bookmarks-loading" class="text-muted mt-3 d-none">Loading...</div>
      <div id="bookmarks-empty" class="alert alert-info mt-3 d-none">You have not bookmarked any content yet.</div>

      <section class="bookmark-section d-none" data-bookmark-section="mushafPages">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Quran Pages</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="mushafPages">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="mushafPages"></div>
      </section>

      <section class="bookmark-section d-none" data-bookmark-section="quran">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Quran Passages</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="quran">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="quran"></div>
      </section>

      <section class="bookmark-section d-none" data-bookmark-section="tafsirs">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Tafsir Passages</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="tafsirs">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="tafsirs"></div>
      </section>

      <section class="bookmark-section d-none" data-bookmark-section="surahs">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Surahs</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="surahs">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="surahs"></div>
      </section>

      <section class="bookmark-section d-none" data-bookmark-section="quranRanges">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Quran Divisions</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="quranRanges">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="quranRanges"></div>
      </section>

      <section class="bookmark-section d-none" data-bookmark-section="headings">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Hadith Chapters</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="headings">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="headings"></div>
      </section>

      <section class="bookmark-section d-none" data-bookmark-section="hadiths">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Hadiths</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="hadiths">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="hadiths"></div>
      </section>
    </main>
  </div>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

<script>
  (function () {
    const sectionKeys = ['mushafPages', 'quran', 'tafsirs', 'surahs', 'quranRanges', 'headings', 'hadiths'];
    const sectionEls = Object.fromEntries(sectionKeys.map(key => [key, document.querySelector(`[data-bookmark-section="${key}"]`)]));
    const listEls = Object.fromEntries(sectionKeys.map(key => [key, document.querySelector(`[data-bookmark-list="${key}"]`)]));
    const sectionCountEls = Object.fromEntries(sectionKeys.map(key => [key, document.querySelector(`[data-bookmark-section-count="${key}"]`)]));
    const loadingEl = document.getElementById('bookmarks-loading');
    const emptyEl = document.getElementById('bookmarks-empty');
    const clearBtn = document.getElementById('clear-bookmarks-btn');
    let metadataBackfillDone = false;
    const quranSurahs = <%- JSON.stringify((global.surahs || []).map(function (surah) {
      return {
        num: Number(surah.num),
        name_en: surah.name_en || '',
        name_ar: surah.name_ar || '',
        ayahs: Number(surah.ayahs) || 0
      };
    }).filter(function (surah) { return Number.isInteger(surah.num); })) %>;

    const pluralizeSaved = (count) => `${count} saved`;

    const waitForBookmarkSettings = async () => {
      const promises = [];
      if (window.hadithBookmarks && window.hadithBookmarks.ready) promises.push(window.hadithBookmarks.ready);
      if (window.headingBookmarks && window.headingBookmarks.ready) promises.push(window.headingBookmarks.ready);
      if (window.tafsirBookmarks && window.tafsirBookmarks.ready) promises.push(window.tafsirBookmarks.ready);
      if (window.mushafPageBookmark && window.mushafPageBookmark.ready) promises.push(window.mushafPageBookmark.ready);
      if (promises.length) await Promise.all(promises);
    };

    const text = (value, fallback = '') => {
      if (value === null || value === undefined) return fallback;
      return String(value);
    };

    const isQuranUrl = (value) => /^\/quran(?:\/|$)/i.test(text(value).trim()) || /^https?:\/\/[^/]*quran[^/]*\//i.test(text(value).trim());

    const quranRef = (value) => {
      value = text(value).trim().replace(/^quran:/i, '');
      const match = value.match(/^(\d{1,3}):(\d{1,3})(?:-(\d{1,3}))?$/);
      return match ? `quran:${match[1]}:${match[2]}${match[3] ? `-${match[3]}` : ''}` : '';
    };

    const quranRefs = (value) => {
      const ref = quranRef(value);
      const match = ref.match(/^quran:(\d{1,3}):(\d{1,3})(?:-(\d{1,3}))?$/i);
      if (!match) return [];
      const surah = Number(match[1]);
      const from = Number(match[2]);
      const to = Number(match[3] || match[2]);
      if (to < from || to - from > 299) return [];
      return Array.from({ length: to - from + 1 }, (_, index) => `${surah}:${from + index}`);
    };

    const toArabicDigits = (value) => text(value).replace(/[0-9]/g, digit => '٠١٢٣٤٥٦٧٨٩'[Number(digit)]);

    const ayahMarkerNumber = (value) => {
      const ref = quranRef(value);
      const match = ref.match(/^quran:\d{1,3}:(\d{1,3})(?:-(\d{1,3}))?$/i);
      return match ? (match[2] || match[1]) : '';
    };

    const tafsirRef = (value) => {
      value = text(value).trim().replace(/^quran:/i, '');
      if (/^\d{1,3}:\d{1,3}(?:-\d{1,3})?$/.test(value)) return quranRef(value);
      const parts = value.split(':');
      if (parts.length < 3) return '';
      const range = text(parts[3] || '').trim();
      return range ? quranRef(`${parts[1]}:${range}`) : quranRef(`${parts[1]}:${parts[2]}`);
    };

    const surahForRef = (value) => {
      const match = text(value).match(/(?:quran:)?(\d{1,3})(?::|$)/i);
      if (!match) return null;
      return quranSurahs.find(surah => Number(surah.num) === Number(match[1])) || null;
    };

    const quranPassageTitle = (value) => {
      const ref = quranRef(value);
      if (!ref) return '';
      const surah = surahForRef(ref);
      if (!surah) return ref;
      return `${surah.name_en || `Surah ${surah.num}`} ${ref.replace(/^quran:/i, '')}`;
    };

    const quranStartTitle = (item) => {
      const source = text(item && (item.startRef || item.url || item.ref || ''), '');
      const match = source.match(/quran:(\d{1,3}):(\d{1,3})/i);
      if (!match) return '';
      const ref = `quran:${match[1]}:${match[2]}`;
      const surah = surahForRef(ref);
      return `${surah && surah.name_en ? surah.name_en : `Surah ${match[1]}`} ${match[1]}:${match[2]}`;
    };

    const headingTitle = (item) => {
      const type = text(item.type).toLowerCase();
      const ref = text(item.ref || item.title || item.id);
      const surah = type === 'surah' || /^quran:\d{1,3}$/i.test(ref.trim()) ? surahForRef(ref) : null;
      if (surah) return { title: surah.name_en || `Surah ${surah.num}`, titleAr: surah.name_ar || '', ref: `${surah.name_en || `Surah ${surah.num}`} ${surah.num}:1` };
      const juz = ref.trim().match(/^juz:(\d{1,3})$/i);
      if (juz) return { title: `Juz ${juz[1]}`, titleAr: text(item.titleAr || '', ''), ref: quranStartTitle(item) || `juz:${juz[1]}` };
      const manzil = ref.trim().match(/^manzil:(\d{1,3})$/i);
      if (manzil) return { title: `Manzil ${manzil[1]}`, titleAr: text(item.titleAr || '', ''), ref: quranStartTitle(item) || `manzil:${manzil[1]}` };
      const hadithChapter = ref.trim().match(/^([A-Za-z0-9_-]+):([0-9]+(?:\.[0-9]+){0,2})$/);
      const displayRef = hadithChapter
        ? `${hadithChapter[1].charAt(0).toUpperCase()}${hadithChapter[1].slice(1)} ${hadithChapter[2]}`
        : ref;
      return {
        title: text(item.title || item.ref || item.id, ''),
        titleAr: text(item.titleAr || '', ''),
        ref: text(displayRef || item.id, '')
      };
    };

    const classifyHadithBookmark = (item) => {
      const type = text(item && item.type).toLowerCase();
      if (type === 'quran' || type === 'ayah' || type === 'passage') return 'quran';
      if (type === 'hadith' || type === 'hadiths') return 'hadiths';
      if (quranRef(item && item.ref)) return 'quran';
      if (isQuranUrl(item && item.url)) return 'quran';
      return 'hadiths';
    };

    const makeNode = (tag, className, value) => {
      const el = document.createElement(tag);
      if (className) el.className = className;
      if (value !== undefined && value !== null) el.textContent = value;
      return el;
    };

    const makeRemoveButton = (section, value) => {
      if (section === 'mushafPages') {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'quran-mushaf-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center';
        btn.dataset.quranMushafBookmarkPage = String(value);
        btn.title = 'Remove bookmark';
        const icon = document.createElement('span');
        icon.className = 'quran-mushaf-bookmark-icon bi bi-bookmark-fill text-accent';
        btn.appendChild(icon);
        return btn;
      }
      if (section === 'headings' || section === 'surahs' || section === 'quranRanges') {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center';
        btn.dataset.headingId = String(value);
        btn.title = 'Remove bookmark';
        const icon = document.createElement('span');
        icon.className = 'heading-bookmark-icon bi bi-bookmark-fill text-accent';
        icon.dataset.headingId = String(value);
        btn.appendChild(icon);
        return btn;
      }
      if (section === 'tafsirs') {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'tafsir-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center';
        btn.dataset.tafsirBookmarkKey = String(value);
        btn.title = 'Remove bookmark';
        const icon = document.createElement('span');
        icon.className = 'tafsir-bookmark-icon bi bi-bookmark-fill text-accent';
        icon.dataset.tafsirBookmarkKey = String(value);
        btn.appendChild(icon);
        return btn;
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'hadith-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center';
      btn.dataset.hadithId = String(value);
      btn.title = 'Remove bookmark';
      const icon = document.createElement('span');
      icon.className = 'hadith-bookmark-icon bi bi-bookmark-fill text-accent';
      icon.dataset.hadithId = String(value);
      btn.appendChild(icon);
      return btn;
    };

    const makeBookmarkItem = (section, item) => {
      const entry = document.createElement('article');
      entry.className = 'bookmark-compact-item';

      const idOrKey = section === 'tafsirs' ? item.key : item.id;
      const button = makeRemoveButton(section, idOrKey);

      const content = makeNode('div', 'bookmark-compact-content');
      const headingMeta = (section === 'headings' || section === 'surahs' || section === 'quranRanges') ? headingTitle(item) : null;
      const quranDisplayRef = section === 'quran' ? quranRef(item.ref || item.title) : '';
      const quranDisplayTitle = section === 'quran' ? quranPassageTitle(item.ref || item.title) : '';
      const tafsirDisplayRef = section === 'tafsirs' ? tafsirRef(item.range || item.key) : '';
      const titleText = headingMeta
        ? headingMeta.title
        : text(quranDisplayTitle || item.title || quranDisplayRef || tafsirDisplayRef || item.ref || item.key || text(idOrKey || ''), '');
      const titleAr = headingMeta ? headingMeta.titleAr : text(item.titleAr || '', '');
      const refText = headingMeta
        ? headingMeta.ref
        : text(quranDisplayRef || tafsirDisplayRef || item.ref || (section === 'tafsirs' ? item.key : text(idOrKey || '')), '');
      const title = makeNode('h3', 'bookmark-compact-title');
      if (item.url) {
        const link = document.createElement('a');
        link.href = item.url;
        link.rel = 'noopener noreferrer';
        link.textContent = titleText;
        title.appendChild(link);
      } else {
        title.textContent = titleText;
      }
      const ref = makeNode('div', 'bookmark-compact-ref', refText);
      content.appendChild(title);
      if (titleAr) {
        const ar = makeNode('div', 'bookmark-compact-ar', titleAr);
        ar.lang = 'ar';
        ar.dir = 'rtl';
        content.appendChild(ar);
      }
      if (refText) content.appendChild(ref);
      if (item.bodyAr) {
        const bodyAr = makeNode('div', section === 'quran' ? 'bookmark-compact-body bookmark-quran-ayah quran-hafs' : 'bookmark-compact-body');
        bodyAr.lang = 'ar';
        bodyAr.dir = 'rtl';
        const scriptRefs = section === 'quran' ? quranRefs(item.ref || item.title) : [];
        const bodyText = makeNode('span', '', item.bodyAr);
        if (scriptRefs.length === 1) {
          bodyText.dataset.quranScriptText = 'ayah';
          bodyText.dataset.quranRef = scriptRefs[0];
        } else if (scriptRefs.length > 1) {
          bodyText.dataset.quranScriptText = 'range';
          bodyText.dataset.quranRefs = scriptRefs.join(',');
        }
        bodyAr.appendChild(bodyText);
        const markerNumber = section === 'quran' ? ayahMarkerNumber(item.ref || item.title) : '';
        const bookmarkRefMatch = section === 'quran' ? quranRef(item.ref || item.title).match(/^quran:(\d+):(\d+)(?:-(\d+))?$/i) : null;
        const bookmarkMarkerRef = bookmarkRefMatch ? `${Number(bookmarkRefMatch[1])}:${Number(bookmarkRefMatch[3] || bookmarkRefMatch[2])}` : '';
        if (bookmarkRefMatch && !bookmarkRefMatch[3]) bodyAr.dataset.quranRef = bookmarkMarkerRef;
        if (markerNumber) {
          bodyAr.appendChild(document.createTextNode(' '));
          const marker = makeNode('button', 'quran-ayah-hero-trigger quran-ayah-end-marker', `۝${toArabicDigits(markerNumber)}`);
          marker.type = 'button';
          marker.dataset.quranAyahActions = '1';
          marker.dataset.quranRef = bookmarkMarkerRef;
          marker.dataset.quranHref = quranUrl(`/quran:${bookmarkMarkerRef}`);
          marker.setAttribute('aria-haspopup', 'menu');
          marker.setAttribute('aria-expanded', 'false');
          marker.setAttribute('aria-label', `Actions for Quran ${bookmarkMarkerRef}`);
          bodyAr.appendChild(marker);
        }
        content.appendChild(bodyAr);
      }
      if (item.body) {
        content.appendChild(makeNode('div', 'bookmark-compact-body', item.body));
      }

      entry.appendChild(button);
      entry.appendChild(content);
      return entry;
    };

    const sortBookmarks = (items, section) => {
      const ordered = [...items];
      if (section === 'tafsirs') {
        ordered.sort((a, b) => String(a.key || '').localeCompare(String(b.key || '')));
      } else {
        ordered.sort((a, b) => (Number(b.id) || 0) - (Number(a.id) || 0));
      }
      return ordered;
    };

    const setSection = (key, nodes, count) => {
      if (!sectionEls[key] || !listEls[key]) return;
      const safeCount = parseInt(count, 10) || 0;
      listEls[key].innerHTML = '';
      (nodes || []).forEach(node => listEls[key].appendChild(node));
      sectionEls[key].dataset.bookmarkCount = safeCount;
      sectionEls[key].classList.toggle('d-none', safeCount < 1);
      if (sectionCountEls[key]) sectionCountEls[key].textContent = pluralizeSaved(safeCount);
    };

    const resetSections = () => {
      sectionKeys.forEach(key => setSection(key, [], 0));
    };

    const buildSections = (hadithItems, headingItems, tafsirItems, mushafPage) => {
      const grouped = {
        quran: [],
        hadiths: [],
        surahs: [],
        quranRanges: [],
        headings: [],
        tafsirs: []
      };
      if (Number.isInteger(mushafPage) && mushafPage >= 1 && mushafPage <= 604) {
        grouped.mushafPages = [{
          id: mushafPage,
          title: `Mushaf Page ${mushafPage}`,
          ref: `Quran page ${mushafPage}`,
          url: `/quran/page/${mushafPage}`
        }];
      } else {
        grouped.mushafPages = [];
      }
      (hadithItems || []).forEach(item => {
        const key = classifyHadithBookmark(item);
        if (key !== 'quran' && key !== 'hadiths') return;
        if (Number.isFinite(Number(item.id))) grouped[key].push(item);
      });
      (headingItems || []).forEach(item => {
        if (!Number.isFinite(Number(item.id))) return;
        const type = text(item.type).toLowerCase();
        const ref = text(item.ref).toLowerCase();
        if (type === 'surah' || /^quran:\d{1,3}$/.test(ref)) {
          grouped.surahs.push(item);
          return;
        }
        if (type === 'quran-range' || /^(juz|manzil):\d{1,3}$/.test(ref)) {
          grouped.quranRanges.push(item);
          return;
        }
        grouped.headings.push(item);
      });
      (tafsirItems || []).forEach(item => {
        if (text(item.key)) grouped.tafsirs.push(item);
      });
      return {
        mushafPages: { items: grouped.mushafPages, count: grouped.mushafPages.length },
        quran: { items: sortBookmarks(grouped.quran, 'quran'), count: grouped.quran.length },
        hadiths: { items: sortBookmarks(grouped.hadiths, 'hadiths'), count: grouped.hadiths.length },
        surahs: { items: sortBookmarks(grouped.surahs, 'surahs'), count: grouped.surahs.length },
        quranRanges: { items: sortBookmarks(grouped.quranRanges, 'quranRanges'), count: grouped.quranRanges.length },
        headings: { items: sortBookmarks(grouped.headings, 'headings'), count: grouped.headings.length },
        tafsirs: { items: sortBookmarks(grouped.tafsirs, 'tafsirs'), count: grouped.tafsirs.length }
      };
    };

    const isWeakValue = (value, fallback) => {
      value = text(value).trim();
      fallback = text(fallback).trim();
      return !value || (fallback && value === fallback);
    };

    const isWeakQuranDivisionMetadata = (item) => {
      const type = text(item && item.type).toLowerCase();
      const ref = text(item && item.ref).toLowerCase();
      const title = text(item && item.title).trim();
      if (type !== 'quran-range' && !/^(juz|manzil):\d{1,3}$/.test(ref)) return false;
      return !title || /^\d{1,3}$/.test(title) || !quranStartTitle(item);
    };

    const backfillMissingMetadata = async (hadithItems, headingItems, tafsirItems) => {
      if (metadataBackfillDone) return false;
      metadataBackfillDone = true;
      const hadithIds = (hadithItems || [])
        .filter(item => isWeakValue(item.title, item.id) || isWeakValue(item.ref, item.id))
        .map(item => item.id);
      const headingIds = (headingItems || [])
        .filter(item => isWeakValue(item.title, item.id) || !text(item.titleAr) || isWeakQuranDivisionMetadata(item))
        .map(item => item.id);
      const tafsirRefs = (tafsirItems || [])
        .filter(item => isWeakValue(item.title, item.key) || !text(item.range || item.ref))
        .map(item => item.key);
      if (!hadithIds.length && !headingIds.length && !tafsirRefs.length) return false;
      const res = await fetch('/api/bookmarks/metadata', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hadithIds, headingIds, tafsirRefs })
      });
      if (!res.ok) return false;
      const metadata = await res.json();
      let wrote = false;
      if (metadata.hadiths && Object.keys(metadata.hadiths).length && window.hadithBookmarks && window.hadithBookmarks.mergeMetadata) {
        await window.hadithBookmarks.mergeMetadata(metadata.hadiths);
        wrote = true;
      }
      if (metadata.headings && Object.keys(metadata.headings).length && window.headingBookmarks && window.headingBookmarks.mergeMetadata) {
        await window.headingBookmarks.mergeMetadata(metadata.headings);
        wrote = true;
      }
      if (metadata.tafsirs && Object.keys(metadata.tafsirs).length && window.tafsirBookmarks && window.tafsirBookmarks.mergeMetadata) {
        await window.tafsirBookmarks.mergeMetadata(metadata.tafsirs);
        wrote = true;
      }
      return wrote;
    };

    const load = async () => {
      await waitForBookmarkSettings();
      let hadithItems = (window.hadithBookmarks && window.hadithBookmarks.getAllWithMeta)
        ? window.hadithBookmarks.getAllWithMeta()
        : [];
      let headingItems = (window.headingBookmarks && window.headingBookmarks.getAllWithMeta)
        ? window.headingBookmarks.getAllWithMeta()
        : [];
      let tafsirItems = (window.tafsirBookmarks && window.tafsirBookmarks.getAllWithMeta)
        ? window.tafsirBookmarks.getAllWithMeta()
        : [];
      const mushafPage = window.mushafPageBookmark && window.mushafPageBookmark.get
        ? window.mushafPageBookmark.get()
        : null;
      let metadataBackfilled = false;
      try {
        metadataBackfilled = await backfillMissingMetadata(hadithItems, headingItems, tafsirItems);
      } catch (err) {
        console.warn('Unable to backfill bookmark metadata.', err);
      }
      if (metadataBackfilled) {
        hadithItems = window.hadithBookmarks && window.hadithBookmarks.getAllWithMeta ? window.hadithBookmarks.getAllWithMeta() : [];
        headingItems = window.headingBookmarks && window.headingBookmarks.getAllWithMeta ? window.headingBookmarks.getAllWithMeta() : [];
        tafsirItems = window.tafsirBookmarks && window.tafsirBookmarks.getAllWithMeta ? window.tafsirBookmarks.getAllWithMeta() : [];
      }
      const sections = buildSections(hadithItems, headingItems, tafsirItems, mushafPage);

      resetSections();
      loadingEl.classList.remove('d-none');
      emptyEl.classList.add('d-none');

      if (!sectionKeys.some(key => sections[key] && sections[key].count)) {
        loadingEl.classList.add('d-none');
        emptyEl.classList.remove('d-none');
        return;
      }

      try {
        sectionKeys.forEach((key) => {
          setSection(
            key,
            sections[key].items.map(item => makeBookmarkItem(key, item)),
            sections[key].count
          );
        });

        const total = sectionKeys.reduce((sum, key) => sum + (parseInt(sectionEls[key]?.dataset.bookmarkCount || '0', 10) || 0), 0);
        emptyEl.classList.toggle('d-none', total > 0);
        if (window.refreshHadithActions) window.refreshHadithActions();
        if (window.refreshHeadingBookmarks) window.refreshHeadingBookmarks();
        if (window.refreshTafsirBookmarks) window.refreshTafsirBookmarks();
      } catch (err) {
        console.warn(err);
        resetSections();
        emptyEl.className = 'alert alert-warning mt-3';
        emptyEl.textContent = 'Unable to load bookmarks. Please try again.';
      } finally {
        loadingEl.classList.add('d-none');
      }
    };

    if (clearBtn) {
      clearBtn.addEventListener('click', async () => {
        if (window.hadithBookmarks && window.hadithBookmarks.clear) {
          await window.hadithBookmarks.clear();
        }
        if (window.headingBookmarks && window.headingBookmarks.clear) {
          await window.headingBookmarks.clear();
        }
        if (window.tafsirBookmarks && window.tafsirBookmarks.clear) {
          await window.tafsirBookmarks.clear();
        }
        if (window.mushafPageBookmark && window.mushafPageBookmark.clear) {
          await window.mushafPageBookmark.clear();
        }
        load();
      });
    }

    document.addEventListener('click', (event) => {
      const mushafBtn = event.target.closest('.quran-mushaf-bookmark-btn[data-quran-mushaf-bookmark-page]');
      if (mushafBtn && document.querySelector('.bookmarks-page')?.contains(mushafBtn)) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        if (window.mushafPageBookmark && window.mushafPageBookmark.remove) {
          window.mushafPageBookmark.remove();
        }
        return;
      }

      const hadithBtn = event.target.closest('.hadith-bookmark-btn[data-hadith-id]');
      if (hadithBtn && document.querySelector('.bookmarks-page')?.contains(hadithBtn)) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        const id = parseInt(hadithBtn.dataset.hadithId, 10);
        if (!Number.isNaN(id) && window.hadithBookmarks && window.hadithBookmarks.remove) {
          window.hadithBookmarks.remove(id);
        }
        return;
      }

      const headingBtn = event.target.closest('.heading-bookmark-btn[data-heading-id]');
      if (headingBtn && document.querySelector('.bookmarks-page')?.contains(headingBtn)) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        const id = parseInt(headingBtn.dataset.headingId, 10);
        if (!Number.isNaN(id) && window.headingBookmarks && window.headingBookmarks.remove) {
          window.headingBookmarks.remove(id);
        }
        return;
      }

      const tafsirBtn = event.target.closest('.tafsir-bookmark-btn[data-tafsir-bookmark-key]');
      if (tafsirBtn && document.querySelector('.bookmarks-page')?.contains(tafsirBtn)) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        const key = String(tafsirBtn.dataset.tafsirBookmarkKey || '').trim();
        if (key && window.tafsirBookmarks && window.tafsirBookmarks.remove) {
          window.tafsirBookmarks.remove(key);
        }
      }
    }, true);

    document.addEventListener('hadithBookmarkToggled', load);
    document.addEventListener('hadithBookmarksCleared', load);
    document.addEventListener('headingBookmarkToggled', load);
    document.addEventListener('headingBookmarksCleared', load);
    document.addEventListener('tafsirBookmarkToggled', load);
    document.addEventListener('tafsirBookmarksCleared', load);
    document.addEventListener('mushafPageBookmarkToggled', load);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', load);
    } else {
      load();
    }
  })();
</script>

</body>
</html>
