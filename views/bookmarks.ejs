<!doctype html>
<html lang="en">

<head>
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (req.admin);
    site.editMode = false;
%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %>
<style>
  .bookmarks-page {
    padding-bottom: 3rem;
  }
  .bookmarks-page-header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    padding: 1.5rem 0 1rem;
  }
  .bookmark-section {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-top: 1.25rem;
    margin-top: 1.25rem;
  }
  .bookmark-section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .75rem;
  }
  .bookmark-section-title {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin: 0;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .bookmark-section-count {
    color: #6c757d;
    font-size: .85rem;
    white-space: nowrap;
  }
  .bookmark-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .bookmark-heading {
    background: #fff;
  }
  .bookmark-heading-title,
  .bookmark-tafsir-title {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
    margin-bottom: .25rem;
  }
  .bookmark-heading-meta,
  .bookmark-tafsir-meta {
    color: #6c757d;
    font-size: .875rem;
  }
  .bookmark-list > :last-child {
    border-bottom: 0 !important;
    padding-bottom: 0 !important;
  }
  @media (max-width: 575.98px) {
    .bookmark-section-header {
      align-items: flex-start;
      flex-direction: column;
      gap: .25rem;
    }
  }
</style>

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %>

  <div class="container col-lg-9 mx-auto bookmarks-page">
    <main class="search-results">
      <div class="bookmarks-page-header">
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
          <div>
            <h1 class="fs-3 mb-1">Bookmarks</h1>
            <p class="text-muted mb-0">Saved Quran passages, tafsir passages, hadith chapters, and hadiths.</p>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm" id="clear-bookmarks-btn">
            <i class="bi bi-trash3 me-1"></i>Clear all
          </button>
        </div>
      </div>

      <div id="bookmarks-loading" class="text-muted mt-3 d-none">Loading...</div>
      <div id="bookmarks-empty" class="alert alert-info mt-3 d-none">You have not bookmarked any content yet.</div>

      <section class="bookmark-section d-none" data-bookmark-section="quran">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Quran Passages</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="quran">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="quran"></div>
      </section>

      <section class="bookmark-section d-none" data-bookmark-section="tafsirs">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Tafsir Passages</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="tafsirs">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="tafsirs"></div>
      </section>

      <section class="bookmark-section d-none" data-bookmark-section="headings">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Chapters</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="headings">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="headings"></div>
      </section>

      <section class="bookmark-section d-none" data-bookmark-section="hadiths">
        <div class="bookmark-section-header">
          <h2 class="bookmark-section-title">Hadiths</h2>
          <span class="bookmark-section-count" data-bookmark-section-count="hadiths">0 saved</span>
        </div>
        <div class="bookmark-list" data-bookmark-list="hadiths"></div>
      </section>
    </main>
  </div>

<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

<script>
  (function () {
    const sectionKeys = ['quran', 'tafsirs', 'headings', 'hadiths'];
    const sectionEls = Object.fromEntries(sectionKeys.map(key => [key, document.querySelector(`[data-bookmark-section="${key}"]`)]));
    const listEls = Object.fromEntries(sectionKeys.map(key => [key, document.querySelector(`[data-bookmark-list="${key}"]`)]));
    const sectionCountEls = Object.fromEntries(sectionKeys.map(key => [key, document.querySelector(`[data-bookmark-section-count="${key}"]`)]));
    const loadingEl = document.getElementById('bookmarks-loading');
    const emptyEl = document.getElementById('bookmarks-empty');
    const clearBtn = document.getElementById('clear-bookmarks-btn');

    const pluralizeSaved = (count) => `${count} saved`;

    const waitForBookmarkSettings = async () => {
      const promises = [];
      if (window.hadithBookmarks && window.hadithBookmarks.ready) promises.push(window.hadithBookmarks.ready);
      if (window.headingBookmarks && window.headingBookmarks.ready) promises.push(window.headingBookmarks.ready);
      if (window.tafsirBookmarks && window.tafsirBookmarks.ready) promises.push(window.tafsirBookmarks.ready);
      if (promises.length) await Promise.all(promises);
    };

    const setSection = (key, html, count) => {
      if (!sectionEls[key] || !listEls[key]) return;
      const safeCount = parseInt(count, 10) || 0;
      listEls[key].innerHTML = html || '';
      sectionEls[key].dataset.bookmarkCount = safeCount;
      sectionEls[key].classList.toggle('d-none', safeCount < 1);
      if (sectionCountEls[key]) sectionCountEls[key].textContent = pluralizeSaved(safeCount);
    };

    const resetSections = () => {
      sectionKeys.forEach(key => setSection(key, '', 0));
    };

    const getSection = (data, key) => {
      return data && data.sections && data.sections[key]
        ? data.sections[key]
        : { html: '', count: 0 };
    };

    const load = async () => {
      await waitForBookmarkSettings();
      const hadithIds = (window.hadithBookmarks && window.hadithBookmarks.getAll) ? window.hadithBookmarks.getAll() : [];
      const headingIds = (window.headingBookmarks && window.headingBookmarks.getAll) ? window.headingBookmarks.getAll() : [];
      const tafsirRefs = (window.tafsirBookmarks && window.tafsirBookmarks.getAll) ? window.tafsirBookmarks.getAll() : [];

      resetSections();
      loadingEl.classList.remove('d-none');
      emptyEl.classList.add('d-none');

      if (!hadithIds.length && !headingIds.length && !tafsirRefs.length) {
        loadingEl.classList.add('d-none');
        emptyEl.classList.remove('d-none');
        return;
      }

      try {
        if (hadithIds.length) {
          const res = await fetch('/bookmarks/list', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: hadithIds })
          });
          if (!res.ok) throw new Error('Failed to load passage and hadith bookmarks');
          const data = await res.json();
          const quran = getSection(data, 'quran');
          const hadiths = getSection(data, 'hadiths');
          setSection('quran', quran.html, quran.count);
          setSection('hadiths', hadiths.html, hadiths.count);
        }

        if (headingIds.length) {
          const headingRes = await fetch('/bookmarks/list-headings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: headingIds })
          });
          if (!headingRes.ok) throw new Error('Failed to load chapter and section bookmarks');
          const headingData = await headingRes.json();
          const headings = getSection(headingData, 'headings');
          setSection('headings', headings.html, headings.count);
        }

        if (tafsirRefs.length) {
          const tafsirRes = await fetch('/bookmarks/list-tafsirs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ refs: tafsirRefs })
          });
          if (!tafsirRes.ok) throw new Error('Failed to load tafsīr bookmarks');
          const tafsirData = await tafsirRes.json();
          setSection('tafsirs', tafsirData.html, tafsirData.count);
        }

        const total = sectionKeys.reduce((sum, key) => sum + (parseInt(sectionEls[key]?.dataset.bookmarkCount || '0', 10) || 0), 0);
        emptyEl.classList.toggle('d-none', total > 0);
        if (window.refreshHadithActions) window.refreshHadithActions();
        if (window.refreshHeadingBookmarks) window.refreshHeadingBookmarks();
        if (window.refreshTafsirBookmarks) window.refreshTafsirBookmarks();
      } catch (err) {
        console.warn(err);
        resetSections();
        emptyEl.className = 'alert alert-warning mt-3';
        emptyEl.textContent = 'Unable to load bookmarks. Please try again.';
      } finally {
        loadingEl.classList.add('d-none');
      }
    };

    if (clearBtn) {
      clearBtn.addEventListener('click', async () => {
        if (window.hadithBookmarks && window.hadithBookmarks.clear) {
          await window.hadithBookmarks.clear();
        }
        if (window.headingBookmarks && window.headingBookmarks.clear) {
          await window.headingBookmarks.clear();
        }
        if (window.tafsirBookmarks && window.tafsirBookmarks.clear) {
          await window.tafsirBookmarks.clear();
        }
        load();
      });
    }

    document.addEventListener('click', (event) => {
      const hadithBtn = event.target.closest('.hadith-bookmark-btn[data-hadith-id]');
      if (hadithBtn && document.querySelector('.bookmarks-page')?.contains(hadithBtn)) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        const id = parseInt(hadithBtn.dataset.hadithId, 10);
        if (!Number.isNaN(id) && window.hadithBookmarks && window.hadithBookmarks.remove) {
          window.hadithBookmarks.remove(id);
        }
        return;
      }

      const headingBtn = event.target.closest('.heading-bookmark-btn[data-heading-id]');
      if (headingBtn && document.querySelector('.bookmarks-page')?.contains(headingBtn)) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        const id = parseInt(headingBtn.dataset.headingId, 10);
        if (!Number.isNaN(id) && window.headingBookmarks && window.headingBookmarks.remove) {
          window.headingBookmarks.remove(id);
        }
        return;
      }

      const tafsirBtn = event.target.closest('.tafsir-bookmark-btn[data-tafsir-bookmark-key]');
      if (tafsirBtn && document.querySelector('.bookmarks-page')?.contains(tafsirBtn)) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        const key = String(tafsirBtn.dataset.tafsirBookmarkKey || '').trim();
        if (key && window.tafsirBookmarks && window.tafsirBookmarks.remove) {
          window.tafsirBookmarks.remove(key);
        }
      }
    }, true);

    document.addEventListener('hadithBookmarkToggled', load);
    document.addEventListener('hadithBookmarksCleared', load);
    document.addEventListener('headingBookmarkToggled', load);
    document.addEventListener('headingBookmarksCleared', load);
    document.addEventListener('tafsirBookmarkToggled', load);
    document.addEventListener('tafsirBookmarksCleared', load);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', load);
    } else {
      load();
    }
  })();
</script>

</body>
</html>
