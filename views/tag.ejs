<!doctype html>
<html lang="en">

<head> 
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (!locals.noadmin && req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;

    var subtitle_en = `${tagIds.join('+')}`;
    var page = {
      menu: 'Tag',
      title_en: `${site.shortName} | Aḥādith with tags ${subtitle_en}`,
      subtitle_en: subtitle_en,
      subtitle: null,
      canonical: `/tag/${tagIds.join('+')}`,
      context: {}
    };
    if (results.offset) {
      page.canonical += `?o=${results.offset}`;
      if (results.pg && results.pg > 1)
        page.title_en += ` P${results.pg}`;
    }
    if (results.page.hasPrev)
      page.prev = `/tag/${tagIds.join('+')}?o=${results.page.prevOffset}`;
    if (results.page.hasNext)
      page.next = `/tag/${tagIds.join('+')}?o=${results.page.nextOffset}`;
%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %> 

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %> 

  <div class="container col-lg-8 mx-auto">
    
    <main class="search-results">

      <aside class="row mb-2 pagination">
        <div class="col-md-6 col-xs-12 text-start pagination-nav-slot pagination-nav-slot-prev">
          <% if (page.prev) { %>
          <a class="pagination-nav-link" href="<%- page.prev %>" rel="prev"><span class="pagination-nav-chevron bi bi-chevron-left" aria-hidden="true"></span><span class="pagination-nav-label">&nbsp;Prev:&nbsp;Page</span></a>
          <% } %>
        </div>
        <div class="col-md-6 col-xs-12 text-end pagination-nav-slot pagination-nav-slot-next">
          <% if (page.next) { %>
            <a class="pagination-nav-link" href="<%- page.next %>" rel="next"><span class="pagination-nav-label">Next:&nbsp;Page&nbsp;</span><span class="pagination-nav-chevron bi bi-chevron-right" aria-hidden="true"></span></a>
          <% } %>
        </div>
      </aside>

      <header class="row">
        <h1 class="col-md-12 col-sm-12 fs-5 title" lang="en">
          <% 
            for (var i = 0; i < tags.length; i++) {
          %>
            <%- `#${tags[i].text_en}` %> <span class="_e" data-id="<%=tags[i].id%>" data-prop="tags.description"><%- `${tags[i].description}` %></span>
          <% 
              if (i < tags.length - 1) {
          %>
            <br>
          <% 
              }
            } 
          %>
          <% if (results.page.hasNext || results.page.number && results.page.number > 1) { %>
            (<%- results.page.number %>)
          <% } %>
        </h1>
      </header>

      <% 
        var lastGroup;
        for (var i = 0; i < results.length; i++) {
          if (i > 0 && results[i].groupNo !== lastGroup) {
      %>
            <hr>
        <% } %>

        <%- include('sub-views/hadith.ejs', { site: site, page: page, i: results[i], main: false, title: true, searchResult: false }); %>

      <% 
          lastGroup = results[i].groupNo; 
        } %>

      <aside class="row mb-2 pagination">
        <div class="col-md-6 col-xs-12 text-start pagination-nav-slot pagination-nav-slot-prev">
          <% if (page.prev) { %>
          <a class="pagination-nav-link" href="<%- page.prev %>" rel="prev"><span class="pagination-nav-chevron bi bi-chevron-left" aria-hidden="true"></span><span class="pagination-nav-label">&nbsp;Prev:&nbsp;Page</span></a>
          <% } %>
        </div>
        <div class="col-md-6 col-xs-12 text-end pagination-nav-slot pagination-nav-slot-next">
          <% if (page.next) { %>
            <a class="pagination-nav-link" href="<%- page.next %>" rel="next"><span class="pagination-nav-label">Next:&nbsp;Page&nbsp;</span><span class="pagination-nav-chevron bi bi-chevron-right" aria-hidden="true"></span></a>
          <% } %>
        </div>
      </aside>

    </main>
  </div>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

</body>
</html>
