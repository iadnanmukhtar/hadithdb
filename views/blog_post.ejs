<!doctype html>
<html lang="en">

<head> 
<%
    var site = new Object(global.settings.blog);
    site.admin = false;
    site.editMode = false;
    const slugVal = (typeof locals !== 'undefined' && locals && typeof locals.slug !== 'undefined') ? locals.slug : req.params.title;

    var page = {
      menu: 'Blog Post',
      title_en: `Pearls | ${attr.title}${attr.authorName ? ' — ' + attr.authorName : ''}`,
      description_en: attr.description || attr.subtitle || site.desc,
      subtitle_en: attr.subtitle || 'Blog Post',
      subtitle: null,
      canonical: `/${slugVal}`,
      feed: `${site.url}/feed`,
      cover: encodeURI(attr.coverUrl),
      context: {},
      ...(attr.socialMetadata || {}),
    };
%> 

<%- include('sub-views/head.ejs', { site: site, page: page }); %> 

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %> 

  <div class="container-fluid community-article-layout">
    <main class="blog-post community" id="community" data-view="blog-article" data-post="<%= attr.postId || '' %>" data-author="<%= attr.authorHandle || '' %>">
      <p id="community-status" class="small text-muted" role="status" aria-live="polite"></p>
      <div class="community-columns community-article-columns">
        <%- include('sub-views/community_author_rail.ejs', { railAuthor: { name: attr.authorName || attr.author, handle: attr.authorHandle, photo: attr.authorPhoto, avatarFallback: attr.authorAvatarFallback } }); %>
        <div class="community-wall">
          <article>
            <%- include('sub-views/blog_cover.ejs', { entry: attr, detail: true }); %>
            <section class="body" data-article-body>
             <%- body %>
            </section>
            <% if (attr.postId) { %><%- include('sub-views/community_post_actions.ejs', { post: {
              id: attr.postId, kind: 'article', isBlog: true, title: attr.title,
              url: attr.shareUrl || ('/blog/' + slugVal), coverUrl: attr.cover,
              excerpt: attr.subtitle || '', author: {handle: attr.authorHandle, name: attr.authorName || attr.author, photo: attr.authorPhoto, avatarFallback: attr.authorAvatarFallback}
            } }); %><% } %>
          </article>
          <%- include('sub-views/comment_widget.ejs', {
            widgetId: 'blog-comments',
            heading: 'Reflections',
            collapsible: true,
            targetId: slugVal,
            ref: slugVal,
            endpoint: '/blog-comments',
            subjectLabel: 'reflection'
          }); %>
        </div>
        <%- include('sub-views/community_rail.ejs'); %>
      </div>
    </main>
  </div>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

<script src="<%= utils.staticAssetUrl('/static/js/community-article-toc.js') %>?v=<%= utils.scriptAssetVersion() %>"></script>
<script src="<%= utils.staticAssetUrl('/static/js/community-bio.js') %>?v=<%= utils.scriptAssetVersion() %>"></script>
<script src="<%= utils.staticAssetUrl('/static/js/community.js') %>?v=<%= utils.scriptAssetVersion() %>"></script>
<script src="<%= utils.staticAssetUrl('/static/js/community-social-share.js') %>" defer></script>
</body>
</html>
