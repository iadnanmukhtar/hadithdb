<!doctype html>
<html lang="en">

<head> 
<%
    var site = new Object(global.settings.blog);
    site.admin = false;
    site.editMode = false;
    const slugVal = (typeof locals !== 'undefined' && locals && typeof locals.slug !== 'undefined') ? locals.slug : req.params.title;

    var page = {
      menu: 'Blog Post',
      title_en: `Pearls | ${attr.title}${attr.authorName ? ' — ' + attr.authorName : ''}`,
      description_en: attr.description || attr.subtitle || site.desc,
      subtitle_en: attr.subtitle || 'Blog Post',
      subtitle: null,
      canonical: `/${slugVal}`,
      feed: `${site.url}/feed`,
      cover: encodeURI(attr.coverUrl),
      context: {},
      ...(attr.socialMetadata || {}),
    };
%> 

<%- include('sub-views/head.ejs', { site: site, page: page }); %> 

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %> 

  <div class="container">
    <main class="blog-post community" id="community" data-view="blog-article">
      <p id="community-status" class="small text-muted" role="status" aria-live="polite"></p>
      <div class="community-columns">
        <div class="community-wall">
          <article>
            <%- include('sub-views/blog_cover.ejs', { entry: attr, detail: true }); %>
            <% if (attr.postId) { %><a hidden data-blog-edit data-author="<%= attr.authorHandle %>" href="/community/write?post=<%= attr.postId %>" class="small text-muted text-decoration-none" aria-label="Edit article"><i class="bi bi-pencil" aria-hidden="true"></i> Edit article</a><% } %>
            <section class="body">
             <%- body %>
            </section>
            <button type="button" class="btn btn-sm btn-outline-secondary my-3" data-community-share-url="<%= attr.shareUrl || ('/blog/' + slugVal) %>" data-community-share-title="<%= attr.title %>" data-community-share-author="<%= attr.authorName || attr.author || '' %>" data-community-share-photo="<%= attr.authorPhoto || '' %>" data-community-share-cover="<%= attr.cover || '' %>" data-community-share-excerpt="<%= attr.subtitle || '' %>"><i class="bi bi-share" aria-hidden="true"></i> Share</button>
          </article>
          <%- include('sub-views/comment_widget.ejs', {
            widgetId: 'blog-comments',
            heading: 'Share your reflection below:',
            targetId: slugVal,
            ref: slugVal,
            endpoint: '/blog-comments',
            subjectLabel: 'reflection'
          }); %>
        </div>
        <%- include('sub-views/community_rail.ejs'); %>
      </div>
    </main>
  </div>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

<script src="<%= utils.staticAssetUrl('/static/js/blog-edit.js') %>" defer></script>
<script src="<%= utils.staticAssetUrl('/static/js/community.js') %>"></script>
<script src="<%= utils.staticAssetUrl('/static/js/community-social-share.js') %>" defer></script>
</body>
</html>
