<!doctype html>
<html lang="en">

<head> 
<%
    var site = new Object(global.settings.blog);
    site.admin = false;
    site.editMode = false;
    const slugVal = (typeof locals !== 'undefined' && locals && typeof locals.slug !== 'undefined') ? locals.slug : req.params.title;

    var page = {
      menu: 'Blog Post',
      title_en: `Pearls | ${attr.title}`,
      subtitle_en: attr.subtitle || 'Blog Post',
      subtitle: null,
      canonical: `${req.path}`,
      feed: `${site.url}/feed`,
      cover: encodeURI(attr.coverUrl),
      context: {},
    };
%> 

<%- include('sub-views/head.ejs', { site: site, page: page }); %> 

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %> 

  <div class="container">
    <main class="blog-post">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
          <article>
            <header>
              <h1 class="fs-3 mb-0"><strong><%= attr.title %></strong></h1>
              <% if (attr.subtitle) { %>
                <h2 class="fs-6 mb-0 text-body-secondary"><%= attr.subtitle %></h2>
              <% } %>
              <p class="fs-6 text-muted"><%= attr.published.toDateString() %></p>
            </header>
            <figure>
              <img class="img-fluid" src="<%- attr.cover %>" alt="<%= attr.title %> cover image">
            </figure>
            <section class="body">
             <%- body %>
            </section>
          </article>
          <%- include('sub-views/comment_widget.ejs', {
            widgetId: 'blog-comments',
            heading: 'Share your reflection below:',
            targetId: slugVal,
            ref: slugVal,
            endpoint: '/blog-comments',
            subjectLabel: 'reflection'
          }); %>
        </div>
      </div>
    </main>
  </div>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

</body>
</html>
