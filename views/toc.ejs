      return (value || '').toString().replace(/\s+/g, ' ').trim();
    }
    function suffixDisplayName(value, suffix) {
      value = displayName(value);
      return new RegExp(`\\b${suffix}$`, 'i').test(value) ? value : `${value} ${suffix}`.trim();
    }
    function prefixDisplayName(value, prefix) {
      value = displayName(value);
      return new RegExp(`^${prefix}\\b`, 'i').test(value) ? value : `${prefix} ${value}`.trim();
    }
