          about: `Chapters Headings for ${book.name_en} (فهرس ${book.title})`
        }) %>
        
        <%
        function formatHeadingNumber(value) {
          if (value === null || value === undefined || value === '')
            return '';
          return value != Math.floor(value) ? Number(value).toFixed(2) : value;
        }
        function truncateTitle(value, length) {
          if (!value)
            return '';
          var title = value.substring(0, length);
          if (value.length > length)
            title += '&hellip;';
          return title;
        }
        function quranHeadingAyahRangeLabel(heading) {
          var startParts = arabic.toLatinDigits((heading.start || '').toString()).split(/:/);
          var startSurah = parseInt(startParts[0], 10);
          var startAyah = parseInt(startParts[1], 10);
          if (!Number.isInteger(startSurah) || !Number.isInteger(startAyah))
            return '';
          var count = parseInt(arabic.toLatinDigits((heading.count || '').toString()), 10);
          var endParts = arabic.toLatinDigits((heading.end || '').toString()).split(/:/);
          var endSurah = parseInt(endParts[0], 10);
          var endAyah = parseInt(endParts[1], 10);
          if (!Number.isInteger(endAyah) && Number.isInteger(count) && count > 0)
            endAyah = startAyah + count - 1;
          if (!Number.isInteger(endSurah))
            endSurah = startSurah;
          if (!Number.isInteger(endAyah) || endAyah < startAyah)
            return `${startSurah}:${startAyah}`;
          if (endSurah !== startSurah)
            return `${startSurah}:${startAyah}-${endSurah}:${endAyah}`;
          return endAyah === startAyah ? `${startSurah}:${startAyah}` : `${startSurah}:${startAyah}-${endAyah}`;
        }
        function tocSectionNumberLabel(section) {
          if (!isQuranToc)
            return `S${section.h1}.${section.h2}`;
          var rangeLabel = quranHeadingAyahRangeLabel(section);
          return `P${section.h2}${rangeLabel ? ` ${rangeLabel}` : ''}`;
        }
        %>

