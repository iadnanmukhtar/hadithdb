    }
    if (isQuranToc && !quranCommentaryBook)
      randomTocItemQueryParts.push('hideTitle=1');
    var randomTocItemSrc = `/${book.alias}/random${randomTocItemQueryParts.length ? `?${randomTocItemQueryParts.join('&')}` : ''}`;
    var quranHeaderJuzLinks = isQuranToc
      ? quranJuzRows.map(function (juz) {
        return {
          num: parseInt(juz && juz.num, 10),
          title: juz && juz.title,
          href: quranJuzStartHref(juz)
        };
      }).filter(function (juz) {
        return Number.isInteger(juz.num) && juz.num >= 1 && juz.num <= 30;
      })
      : [];
	var tocHeadingRailKeys = new Map();
	var tocHeadingRailItems = (Array.isArray(toc) ? toc : []).filter(function (heading) {
	  return heading && heading.h1 !== undefined && heading.h1 !== null && heading.h1 !== ''
	    && (isQuranToc || Number(heading.h1) !== 0)
	    && (!isQuranToc || quranCommentaryHasSurah(heading.h1));
	}).map(function (heading, index) {
	  var number = heading.h1 != Math.floor(heading.h1) ? Number(heading.h1).toFixed(2) : heading.h1.toString();
	  var englishTitle = displayName(heading.title_en || heading.h1_title_en);
	  var arabicTitle = displayName(heading.title || heading.h1_title);
	  var title = englishTitle || arabicTitle || (isQuranToc ? 'Surah' : 'Chapter');
	  var key = `toc-heading-${index}`;
	  tocHeadingRailKeys.set(heading, key);
	  return {
	    key: key,
	    number: number,
	    title: title,
	    titleLang: englishTitle ? 'en' : (arabicTitle ? 'ar' : 'en'),
	    href: quranTocHref(heading)
	  };
	});
	quranCommentaryIntroductionArticles.slice().reverse().forEach(function (article) {
	  if (!utils.trimToEmpty(article.intro) && !utils.trimToEmpty(article.intro_en))
	    return;
	  var articleTitleEn = displayName(article.title_en);
	  var articleTitleAr = displayName(article.title);
	  tocHeadingRailItems.unshift({
	    key: `toc-commentary-introduction-${article.h2}`,
	    number: '',
	    title: articleTitleEn || articleTitleAr || 'Introduction by the author',
	    titleLang: articleTitleEn ? 'en' : (articleTitleAr ? 'ar' : 'en'),
	    href: `${quranCommentaryIntroductionHref}#introduction-${article.h2}`,
	    track: false
	  });
	});
	hadithIntroductionArticles.slice().reverse().forEach(function (article) {
	  if (!hadithIntroductionHref || (!utils.trimToEmpty(article.intro) && !utils.trimToEmpty(article.intro_en)))
	    return;
	  var articleTitleEn = displayName(article.title_en);
	  var articleTitleAr = displayName(article.title);
	  tocHeadingRailItems.unshift({
	    key: `toc-hadith-introduction-${article.h2}`,
	    number: '',
	    title: articleTitleEn || articleTitleAr || 'Introduction',
	    titleLang: articleTitleEn ? 'en' : (articleTitleAr ? 'ar' : 'en'),
	    href: `${hadithIntroductionHref}#introduction-${article.h2}`,
	    track: false
	  });
	});
	var showTocHeadingRail = tocHeadingRailItems.length > 0;
	var tocHeadingRailTitle = tocDisplayBookNameEn || displayName(tocDisplayBook.shortName_en || tocDisplayBook.alias);
	%>
  
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
  
</head>

<body>
  
  <%- include('sub-views/header.ejs', { site: site, page: page, quranHeaderJuzLinks: quranHeaderJuzLinks }); %>
  
  <div class="<%= showTocHeadingRail ? `container-fluid hadith-heading-layout toc-heading-layout${isQuranToc && !quranCommentaryBook ? ' toc-heading-layout-quran' : ''}` : 'container col-lg-8 mx-auto' %>">
    <% if (showTocHeadingRail) { %><div class="container col-lg-8 mx-auto hadith-heading-content toc-heading-content"><% } %>
    
    <main class="toc<%= !isQuranToc ? ' hadith-toc-page' : '' %><%= quranCommentaryBook && quranCommentaryBook.type === 'tafsir' ? ' tafsir-toc-page' : '' %><%= isQuranToc && !quranCommentaryBook ? ' quran-toc-reader-modes' : '' %>"<% if (quranCommentaryBook && quranCommentaryBook.type === 'trans') { %> data-quran-selected-translation-book="<%= quranCommentaryBook.alias %>"<% } %>>
      
      <% if (showHadithBookChrome) { %>
        <%- include('sub-views/bookNav.ejs'); %>
      <% } %>
      <% if (quranCommentaryBook) { %>
        <%- include('sub-views/quran_commentary_book_nav.ejs', { quranCommentaryBook: quranCommentaryBook, quranCommentaryBooks: quranCommentaryBooks, Tafsir: Tafsir }); %>
      <% } %>

      <article>
        <% if (showBookLayout) { %>
        <%
          var editableBookId = site.editMode && tocDisplayBook && tocDisplayBook.id ? tocDisplayBook.id : null;
          var editableBook = Boolean(editableBookId) && site.editMode;
          var publicationLabel = [tocDisplayBook.published_year ? `Pub. ${tocDisplayBook.published_year}` : '', tocDisplayBook.publisher ? tocDisplayBook.publisher : '']
            .filter(Boolean).join(', ');
          var tocSizeType = tocDisplayBook.type === 'tafsir' ? 'tafsir' : (tocDisplayBook.type === 'hadith' ? 'hadith' : '');
          var tocBookSize = tocSizeType ? displayName(tocDisplayBook.size) : '';
          var tocBookSizeLabel = tocBookSize === 'lg' ? `Large ${tocSizeType}` : (tocBookSize === 'md' ? `Medium ${tocSizeType}` : (tocBookSize === 'sm' ? `Small ${tocSizeType}` : ''));
          var tocHeadingNameProp = 'name_en';
          var tocHeadingNameRaw = tocDisplayBook[tocHeadingNameProp] || '';
          var tocHeadingArabicProp = 'name';
          var tocHeadingArabicRaw = tocDisplayBook[tocHeadingArabicProp] || '';
        %>
        <heading class="mb-2">
          <div class="row text-center justify-content-center">
            <h2 class="fs-3<%= quranCommentaryBook && quranCommentaryBook.type === 'trans' ? ' quran-translation-toc-title text-truncate w-100' : '' %>" title="<%- tocHeadingNameRaw || tocDisplayBookNameEn || '' %>"><span<% if (editableBook) { %> class="_e" data-id="<%= editableBookId %>" data-prop="book.<%= tocHeadingNameProp %>" data-placeholder="English name"<% } %>><%- editableBook ? tocHeadingNameRaw : (tocHeadingNameRaw || tocDisplayBookNameEn) %></span><% if (tocSizeType && (editableBook || tocBookSizeLabel)) { %><span class="toc-book-inline-size-editor"><span class="<%= tocSizeType %>-size-indicator tafsir-size-tooltip<%= tocBookSize ? ` ${tocSizeType}-size-indicator-${tocBookSize}` : ' toc-book-size-unset' %>" title="<%= tocBookSizeLabel || `Set ${tocSizeType} size` %>" data-tafsir-size-tooltip="<%= tocBookSizeLabel || `Set ${tocSizeType} size` %>" aria-label="<%= tocBookSizeLabel || `Set ${tocSizeType} size` %>" role="img"></span><% if (editableBook) { %><select class="_e" data-id="<%= editableBookId %>" data-prop="book.size" aria-label="<%= tocSizeType === 'tafsir' ? 'Tafsir' : 'Hadith' %> content size"><option value="" <%= !tocDisplayBook.size ? 'selected' : '' %>>Not set</option><option value="sm" <%= tocDisplayBook.size === 'sm' ? 'selected' : '' %>>Small</option><option value="md" <%= tocDisplayBook.size === 'md' ? 'selected' : '' %>>Medium</option><option value="lg" <%= tocDisplayBook.size === 'lg' ? 'selected' : '' %>>Large</option></select><% } %></span><% } %></h2>
            <% if (!isEnglishQuranTranslation && (editableBook || tocDisplayBookTitle)) { %>
            <h2 class="fs-3 fw-bold text-center" lang="ar" dir="rtl" title="<%- tocHeadingArabicRaw || '' %>"><span<% if (editableBook) { %> class="_e" data-id="<%= editableBookId %>" data-prop="book.<%= tocHeadingArabicProp %>" data-placeholder="الاسم العربي"<% } %>><%- editableBook ? tocHeadingArabicRaw : (tocHeadingArabicRaw || tocDisplayBookTitle) %></span></h2>
            <% } %>
          </div>
        </heading>
        <% } %>

        <% if (showBookMetadata) {
          var tocBookNameEn = displayName(tocDisplayBook.title_en || '');
          var tocBookNameAr = isEnglishQuranTranslation ? '' : displayName(tocDisplayBook.title || '');
          var tocBookAuthorEn = displayName(tocDisplayBook.author_en || (isEnglishQuranTranslation ? '' : tocDisplayBook.author) || '');
          var tocBookAuthorAr = isEnglishQuranTranslation ? '' : displayName(tocDisplayBook.author || '');
          var tocBookDeathEn = commentaryDeathLabel(tocDisplayBook);
          var tocBookDeathAr = tocDisplayBook.type === 'trans' ? '' : commentaryArabicDeathLabel(tocDisplayBook);
        %>
        <div class="tafsir-book-meta text-muted mb-3<%= tocBookNameAr || tocBookAuthorAr || tocBookDeathAr ? '' : ' tafsir-book-meta-single' %>">
          <% if (editableBook) { %>
            <div><span class="_e" data-id="<%= editableBookId %>" data-prop="book.shortName_en" data-placeholder="English short name"><%- tocDisplayBook.shortName_en || '' %></span></div>
            <% if (!isEnglishQuranTranslation) { %><div lang="ar" dir="rtl"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.shortName" data-placeholder="الاسم المختصر"><%- tocDisplayBook.shortName || '' %></span></div><% } %>
            <div><span class="_e" data-id="<%= editableBookId %>" data-prop="book.title_en" data-placeholder="Full English title"><%- tocDisplayBook.title_en || '' %></span></div>
            <% if (!isEnglishQuranTranslation) { %><div lang="ar" dir="rtl"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.title" data-placeholder="العنوان العربي"><%- tocDisplayBook.title || '' %></span></div><% } %>
            <div><span class="_e" data-id="<%= editableBookId %>" data-prop="book.author_en" data-placeholder="Author"><%- tocDisplayBook.author_en || '' %></span> (d. <span class="_e" data-id="<%= editableBookId %>" data-prop="book.death" data-placeholder="Death year"><%- tocDisplayBook.death || '' %></span><%= tocDisplayBook.type === 'trans' ? ' CE' : ' AH' %>)</div>
            <% if (!isEnglishQuranTranslation) { %><div lang="ar" dir="rtl"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.author" data-placeholder="اسم المؤلف"><%- tocDisplayBook.author || '' %></span><% if (tocBookDeathAr) { %> (<%- tocBookDeathAr %>)<% } %></div><% } %>
            <div><span class="_e" data-id="<%= editableBookId %>" data-prop="book.aqidah" data-placeholder="Aqidah"><%- tocDisplayBook.aqidah || '' %></span></div>
            <div aria-hidden="true"></div>
            <div>Pub. <span class="_e" data-id="<%= editableBookId %>" data-prop="book.published_year" data-placeholder="Year"><%- tocDisplayBook.published_year || '' %></span>, <span class="_e" data-id="<%= editableBookId %>" data-prop="book.publisher" data-placeholder="Publisher"><%- tocDisplayBook.publisher || '' %></span></div>
          <% } else { %>
            <% if (tocBookNameEn) { %><div><%- tocBookNameEn %></div><% } %>
            <% if (tocBookNameAr) { %><div lang="ar" dir="rtl"><%- tocBookNameAr %></div><% } %>
            <% if (tocBookAuthorEn || tocBookDeathEn) { %><div><%- tocBookAuthorEn %><% if (tocBookDeathEn) { %> (<%- tocBookDeathEn %>)<% } %></div><% } %>
            <% if (tocBookAuthorAr || tocBookDeathAr) { %><div lang="ar" dir="rtl"><%- tocBookAuthorAr %><% if (tocBookDeathAr) { %> (<%- tocBookDeathAr %>)<% } %></div><% } %>
            <% if (publicationLabel) { %><div><%= publicationLabel %></div><% } %>
            <% if (tocDisplayBook.aqidah) { %><div><%- tocDisplayBook.aqidah %></div><% } %>
          <% } %>
        </div>
        <% } %>

        <% if (showBookLayout) { %>
        <section>
          <%
          const bookDescriptionMarkdown = utils.emptyIfNull(tocDisplayBook.description);
          const bookDescription = utils.markdownToHtml(bookDescriptionMarkdown) || '';
          const bookDescriptionPreview = bookDescriptionMarkdown
            .split(/\r?\n/)
            .map(function (line) { return line.trim(); })
	            .find(Boolean) || '';
          const bookDescriptionPreviewText = bookDescriptionPreview
	            .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
	            .replace(/[*_`#>]+/g, '')
	            .replace(/\s+/g, ' ')
	            .trim();
          const quranCommentaryDescriptionSummary = bookDescriptionPreviewText;
          %>
          <% if (site.editMode) { %>
          <div class="_e mb-1" data-id="<%= editableBookId || book.id %>" data-prop="book.description" data-edit-format="md" data-markdown-source="<%= bookDescriptionMarkdown %>" data-placeholder="Description"><%- bookDescription %></div>
          <% } else if (quranCommentaryDescriptionSummary || bookDescription) { %>
          <p class="toc-book-description-summary text-muted" data-toc-description-summary="book-description">
            <span class="toc-book-description-preview"><%= quranCommentaryDescriptionSummary %></span>
            <a href="#toc-book-description" data-toc-description-expand="book-description" role="button" aria-expanded="false" aria-controls="toc-book-description">More...</a>
          </p>
          <div id="toc-book-description" class="toc-book-description-full d-none" data-toc-description-full="book-description">
            <% if (bookDescription) { %>
            <div class="mb-1"><%- bookDescription %></div>
            <% } %>
          </div>
          <% } %>
        </section>
        <% } %>

        <% if (showBookLayout) { %>
	      <aside class="h"><div class="tags">
        <a class="book-download-link me-3" href="<%= bookDownloadLinks.json %>" type="button" rel="nofollow"><span class="bi bi-filetype-json"></span> Download JSON</a>
        <a class="book-download-link" href="<%= bookDownloadLinks.epub %>" type="button" rel="nofollow"><span class="bi bi-book"></span> Download EPUB</a>
      </div></aside>
        <% } %>

        <% if (showHadithBookChrome) { %>
        <hr class="mt-3">
        <% } %>
        <% if (showRandomTocItem) { %>
        <section data-random-toc-item data-src="<%= utils.urlFor(req, randomTocItemSrc) %>">
          <% if (showRandomTocTitle) { %>
          <header class="row">
            <h3 class="col-12 fs-4">Random <%= isQuranToc ? 'āyah' : 'ḥadīth' %> in <%- quranCommentaryBook ? quranCommentaryBookLabel : book.shortName_en %> <span class="spinner-border spinner-border-sm text-muted" role="status" aria-label="Loading"></span></h3>
          </header>
          <% } %>
        </section>
        <% } %>
        <% if (showHadithBookChrome) { %>
        <hr>
        <% } %>

      <section class="row">
        
        <%- utils.jsonLdScript({
          '@context': 'https://schema.org',
          '@type': 'Table',
          name: `Chapters Headings for ${book.name_en} (فهرس ${book.title})`,
          about: `Chapters Headings for ${book.name_en} (فهرس ${book.title})`
        }) %>
        
        <%
        function formatHeadingNumber(value) {
          if (value === null || value === undefined || value === '')
            return '';
          return value != Math.floor(value) ? Number(value).toFixed(2) : value;
        }
        function truncateTitle(value, length) {
          if (!value)
            return '';
          var title = value.substring(0, length);
          if (value.length > length)
            title += '&hellip;';
          return title;
        }
        function quranHeadingAyahRangeLabel(heading) {
          var startParts = arabic.toLatinDigits((heading.start || '').toString()).split(/:/);
          var startSurah = parseInt(startParts[0], 10);
          var startAyah = parseInt(startParts[1], 10);
          if (!Number.isInteger(startSurah) || !Number.isInteger(startAyah))
            return '';
          var count = parseInt(arabic.toLatinDigits((heading.count || '').toString()), 10);
          var endParts = arabic.toLatinDigits((heading.end || '').toString()).split(/:/);
          var endSurah = parseInt(endParts[0], 10);
          var endAyah = parseInt(endParts[1], 10);
          if (!Number.isInteger(endAyah) && Number.isInteger(count) && count > 0)
            endAyah = startAyah + count - 1;
          if (!Number.isInteger(endSurah))
            endSurah = startSurah;
          if (!Number.isInteger(endAyah) || endAyah < startAyah)
            return `${startSurah}:${startAyah}`;
          if (endSurah !== startSurah)
            return `${startSurah}:${startAyah}-${endSurah}:${endAyah}`;
          return endAyah === startAyah ? `${startSurah}:${startAyah}` : `${startSurah}:${startAyah}-${endAyah}`;
        }
        function tocSectionNumberLabel(section) {
          if (!isQuranToc)
            return `S${section.h1}.${section.h2}`;
          var rangeLabel = quranHeadingAyahRangeLabel(section);
          return `P${section.h2}${rangeLabel ? ` ${rangeLabel}` : ''}`;
        }
        %>

        <% if (quranTocSectionViews) { %>
        <ul class="nav nav-tabs book-catalog-tabs mb-3" id="quran-toc-view-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link <%= quranTocDefaultView === 'juz' ? 'active' : '' %>" id="toc-tab-juz" data-bs-toggle="tab" data-bs-target="#toc-view-juz" type="button" role="tab" aria-controls="toc-view-juz" aria-selected="<%= quranTocDefaultView === 'juz' ? 'true' : 'false' %>">Juz/Siparas</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link <%= quranTocDefaultView === 'surahs' ? 'active' : '' %>" id="toc-tab-surahs" data-bs-toggle="tab" data-bs-target="#toc-view-surahs" type="button" role="tab" aria-controls="toc-view-surahs" aria-selected="<%= quranTocDefaultView === 'surahs' ? 'true' : 'false' %>">Surahs</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link <%= quranTocDefaultView === 'manzils' ? 'active' : '' %>" id="toc-tab-manzils" data-bs-toggle="tab" data-bs-target="#toc-view-manzils" type="button" role="tab" aria-controls="toc-view-manzils" aria-selected="<%= quranTocDefaultView === 'manzils' ? 'true' : 'false' %>">Manzils</button>
          </li>
        </ul>

        <div class="tab-content" id="quran-toc-view-content">
          <div class="tab-pane fade <%= quranTocDefaultView === 'juz' ? 'show active' : '' %>" id="toc-view-juz" role="tabpanel" aria-labelledby="toc-tab-juz">
            <% if (!quranCommentaryBook || quranCommentaryBook.type !== 'trans') { %>
            <div class="page-content-filter toc-content-filter input-group mb-3">
              <span class="input-group-text bi bi-filter" aria-hidden="true"></span>
              <input type="search" class="form-control" placeholder="Filter Juz/Siparas" aria-label="Filter Juz/Siparas" autocomplete="off" data-toc-content-filter="#toc-juz">
            </div>
            <% } %>
            <h2 class="fs-4 mt-2">Juz/Siparas</h2>
            <table id="toc-juz" class="table" title="<%- `Juz and Siparas for ${book.name_en} (فهرس ${book.title})` %>">
              <tbody>
                <% for (var j = 0; j < quranJuzRows.length; j++) {
                  var juz = quranJuzRows[j];
                  var juzSurahLinks = quranJuzSurahLinks(juz);
                  if (juzSurahLinks.length === 0)
                    continue;
                %>
                <tr class="chapter" data-toc-chapter="toc-juz-<%= juz.num %>" data-toc-view="juz">
                  <td><a href="<%= quranJuzStartHref(juz) %>">Juz <%- juz.num %></a></td>
                  <td class="quran-juz-surah-list">
                    <% for (var linkIndex = 0; linkIndex < juzSurahLinks.length; linkIndex++) {
                      var surahLink = juzSurahLinks[linkIndex];
                      var showJuzBookmark = linkIndex === 0 && Number.isInteger(parseInt(juz && juz.id, 10));
                    %>
                    <% if (showJuzBookmark) { %>
                    <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center me-1" data-heading-id="<%= juz.id %>" data-bookmark-type="quran-range" data-bookmark-ref="juz:<%= juz.num %>" data-bookmark-title="Juz <%= juz.num %>" data-bookmark-title-ar="<%= juz.title || '' %>" data-bookmark-url="<%= quranJuzStartHref(juz) %>" title="Bookmark this juz">
                      <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= juz.id %>"></span>
                    </button>
                    <% } %>
                    <% var juzSurahRevelation = quranTocSurahRevelation(surahLink.surah); %>
                    <span class="quran-juz-surah-link"><span class="quran-revelation-icon quran-revelation-icon-<%= juzSurahRevelation %>" role="img" aria-label="<%= juzSurahRevelation === 'madani' ? 'Madani' : 'Makki' %>" title="<%= juzSurahRevelation === 'madani' ? 'Madani' : 'Makki' %>"></span><a href="<%= surahLink.href %>"><%- surahLink.name_en %></a></span><%= linkIndex < juzSurahLinks.length - 1 ? ', ' : '' %>
                    <% } %>
                  </td>
                  <td lang="ar" dir="rtl"><a href="<%= quranJuzStartHref(juz) %>"><%- juz.title || '' %></a></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="tab-pane fade <%= quranTocDefaultView === 'surahs' ? 'show active' : '' %>" id="toc-view-surahs" role="tabpanel" aria-labelledby="toc-tab-surahs">
            <% if (!quranCommentaryBook || quranCommentaryBook.type !== 'trans') { %>
            <div class="page-content-filter toc-content-filter input-group mb-3">
              <span class="input-group-text bi bi-filter" aria-hidden="true"></span>
              <input type="search" class="form-control" placeholder="Filter surahs" aria-label="Filter surahs" autocomplete="off" data-toc-content-filter="#toc-surahs">
            </div>
            <% } %>
            <h2 class="fs-4 mt-2">Surahs</h2>
            <% if (quranCommentaryIntroductionAdminHref && !quranCommentaryIntroductionHref) { %>
            <p class="mb-2"><a class="btn btn-sm btn-outline-primary" href="<%= quranCommentaryIntroductionAdminHref %>"><span class="bi bi-plus-circle"></span> Manage introduction articles</a></p>
            <% } %>
            <table id="toc-surahs" class="table" title="<%- `Surahs for ${book.name_en} (فهرس ${book.title})` %>">
              <tbody>
                <% quranCommentaryIntroductionArticles.forEach(function (article) { %>
                <% if (quranCommentaryIntroductionHref && (utils.trimToEmpty(article.intro) || utils.trimToEmpty(article.intro_en))) { %>
                <tr class="chapter quran-commentary-introduction-link-row" data-toc-view="surahs">
                  <td><span class="toc-expand-spacer"></span>Introduction</td>
                  <td><a href="<%= `${quranCommentaryIntroductionHref}#introduction-${article.h2}` %>"><%= displayName(article.title_en) || 'Introduction by the author' %></a></td>
                  <td lang="ar" dir="rtl"><a href="<%= `${quranCommentaryIntroductionHref}#introduction-${article.h2}` %>"><%= displayName(article.title) || 'مقدمة المؤلف' %></a></td>
                </tr>
                <% } %>
                <% }); %>
                <%
        for (var i = 0; i < toc.length; i++) {
          if (!quranCommentaryHasSurah(toc[i].h1))
            continue;
          toc[i].h1 = formatHeadingNumber(toc[i].h1);
          toc[i].h2 = formatHeadingNumber(toc[i].h2);
          var title_en = truncateTitle(toc[i].title_en, 75);
          var title = truncateTitle(toc[i].title, 150);
          var sections = Array.isArray(toc[i].sections) ? toc[i].sections : [];
          var hasSections = sections.length > 0;
          var chapterRowId = `toc-chapter-${toc[i].id || i}`;
          %>
                  <tr class="chapter" data-toc-chapter="<%= chapterRowId %>" data-toc-view="surahs" data-toc-heading-target data-toc-heading-key="<%= tocHeadingRailKeys.get(toc[i]) %>">
                    <% if (showHadithBookChrome) { %>
                    <td><%- toc[i].start %></td>
                    <% } %>
                    <td>
                      <% if (hasSections) { %>
                      <button type="button" class="toc-expand-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" aria-expanded="false" aria-controls="<%= chapterRowId %>" data-toc-toggle="<%= chapterRowId %>" title="Show sections">
                        <span class="toc-expand-icon bi bi-chevron-right"></span>
                      </button>
                      <% } else { %>
                      <span class="toc-expand-spacer"></span>
                      <% } %>
                      Surah <%- toc[i].h1 %>
                    </td>
                    <% var surahRevelation = quranTocSurahRevelation(toc[i].h1); %>
                    <% if (toc[i].start) { %>
                    <td>
                      <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center me-1" data-heading-id="<%= toc[i].id %>" data-bookmark-type="<%= book.alias === 'quran' ? 'surah' : 'chapter' %>" data-bookmark-ref="<%= book.alias === 'quran' ? `quran:${toc[i].h1}` : `${book.alias}:${toc[i].h1}` %>" data-bookmark-title="<%= toc[i].title_en || title_en || 'Chapter' %>" data-bookmark-title-ar="<%= toc[i].title || title || '' %>" data-bookmark-url="<%= quranTocHref(toc[i]) %>" title="Bookmark this chapter">
                        <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= toc[i].id %>"></span>
                      </button>
                      <span class="quran-revelation-icon quran-revelation-icon-<%= surahRevelation %>" role="img" aria-label="<%= surahRevelation === 'madani' ? 'Madani' : 'Makki' %>" title="<%= surahRevelation === 'madani' ? 'Madani' : 'Makki' %>"></span>
                      <a href="<%= quranTocHref(toc[i]) %>" class="_e" data-id="<%=toc[i].id%>" data-prop="toc.title_en" data-arabizi="true"><%- title_en || 'Chapter' %></a>
                    </td>
                    <td lang="ar"><a href="<%= quranTocHref(toc[i]) %>" class="_e<%= book.alias === 'quran' ? ' quran-surah-name' : '' %>" data-id="<%=toc[i].id%>" data-prop="toc.title"><%- title %></a></td>
                    <% } else { %>
                    <td>
                      <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center me-1" data-heading-id="<%= toc[i].id %>" data-bookmark-type="<%= book.alias === 'quran' ? 'surah' : 'chapter' %>" data-bookmark-ref="<%= book.alias === 'quran' ? `quran:${toc[i].h1}` : `${book.alias}:${toc[i].h1}` %>" data-bookmark-title="<%= toc[i].title_en || title_en || 'Chapter' %>" data-bookmark-title-ar="<%= toc[i].title || title || '' %>" title="Bookmark this chapter">
                        <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= toc[i].id %>"></span>
                      </button>
                      <span class="quran-revelation-icon quran-revelation-icon-<%= surahRevelation %>" role="img" aria-label="<%= surahRevelation === 'madani' ? 'Madani' : 'Makki' %>" title="<%= surahRevelation === 'madani' ? 'Madani' : 'Makki' %>"></span>
                      <span class="_e" data-id="<%=toc[i].id%>" data-prop="toc.title_en" data-arabizi="true"><%- title_en %></span>
                    </td>
                    <td lang="ar" class="_e<%= book.alias === 'quran' ? ' quran-surah-name' : '' %>" data-id="<%=toc[i].id%>" data-prop="toc.title"><%- title %></td>
                    <% } %>
                  </tr>
                  <% for (var sectionIndex = 0; sectionIndex < sections.length; sectionIndex++) {
                    var section = sections[sectionIndex];
                    section.h1 = formatHeadingNumber(section.h1);
                    section.h2 = formatHeadingNumber(section.h2);
                    var sectionTitleEn = truncateTitle(section.title_en, 75);
                    var sectionTitle = truncateTitle(section.title, 150);
                  %>
                  <tr class="title toc-section-row d-none" data-toc-parent="<%= chapterRowId %>" data-toc-view="surahs">
                    <% if (showHadithBookChrome) { %>
                    <td><%- section.start %></td>
                    <% } %>
                    <td><span class="toc-section-number"><%- tocSectionNumberLabel(section) %></span></td>
                    <% if (section.path) { %>
                    <td>
					  <a href="<%= quranTocHref(section) %>" class="_e" data-id="<%=section.id%>" data-prop="toc.title_en" data-arabizi="true"><%- sectionTitleEn || 'Passage' %></a>
                    </td>
                    <td lang="ar"><a href="<%= quranTocHref(section) %>" class="_e" data-id="<%=section.id%>" data-prop="toc.title"><%- sectionTitle %></a></td>
                    <% } else { %>
					<td class="_e" data-id="<%=section.id%>" data-prop="toc.title_en" data-arabizi="true"><%- sectionTitleEn || 'Passage' %></td>
                    <td lang="ar" class="_e" data-id="<%=section.id%>" data-prop="toc.title"><%- sectionTitle %></td>
                    <% } %>
                  </tr>
                  <% }
              }
              %>
              </tbody>
            </table>
          </div>
          <div class="tab-pane fade <%= quranTocDefaultView === 'manzils' ? 'show active' : '' %>" id="toc-view-manzils" role="tabpanel" aria-labelledby="toc-tab-manzils">
            <% if (!quranCommentaryBook || quranCommentaryBook.type !== 'trans') { %>
            <div class="page-content-filter toc-content-filter input-group mb-3">
              <span class="input-group-text bi bi-filter" aria-hidden="true"></span>
              <input type="search" class="form-control" placeholder="Filter Manzils" aria-label="Filter Manzils" autocomplete="off" data-toc-content-filter="#toc-manzils">
            </div>
            <% } %>
            <h2 class="fs-4 mt-2">Manzils</h2>
            <table id="toc-manzils" class="table" title="<%- `Manzils for ${book.name_en} (فهرس ${book.title})` %>">
              <tbody>
                <% for (var m = 0; m < quranManzilRows.length; m++) {
                  var manzil = quranManzilRows[m];
                  var manzilSurahLinks = quranManzilSurahLinks(manzil, m);
                  if (manzilSurahLinks.length === 0)
                    continue;
                %>
                <tr class="chapter" data-toc-chapter="toc-manzil-<%= manzil.num %>" data-toc-view="manzils">
                  <td><a href="<%= quranManzilStartHref(manzil) %>"><%- `${manzil.name}` %></a></td>
                  <td class="quran-juz-surah-list">
                    <% for (var manzilLinkIndex = 0; manzilLinkIndex < manzilSurahLinks.length; manzilLinkIndex++) {
                      var manzilSurahLink = manzilSurahLinks[manzilLinkIndex];
                      var showManzilBookmark = manzilLinkIndex === 0 && Number.isInteger(parseInt(manzil && manzil.id, 10));
                    %>
                    <% if (showManzilBookmark) { %>
                    <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center me-1" data-heading-id="<%= manzil.id %>" data-bookmark-type="quran-range" data-bookmark-ref="manzil:<%= manzil.num %>" data-bookmark-title="<%= manzil.name %>" data-bookmark-title-ar="<%= quranTocSurahArabicName(manzil.startSurah) %>" data-bookmark-url="<%= quranManzilStartHref(manzil) %>" title="Bookmark this manzil">
                      <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= manzil.id %>"></span>
                    </button>
                    <% } %>
                    <% var manzilSurahRevelation = quranTocSurahRevelation(manzilSurahLink.surah); %>
                    <span class="quran-juz-surah-link"><span class="quran-revelation-icon quran-revelation-icon-<%= manzilSurahRevelation %>" role="img" aria-label="<%= manzilSurahRevelation === 'madani' ? 'Madani' : 'Makki' %>" title="<%= manzilSurahRevelation === 'madani' ? 'Madani' : 'Makki' %>"></span><a href="<%= manzilSurahLink.href %>"><%- manzilSurahLink.name_en %></a></span><%= manzilLinkIndex < manzilSurahLinks.length - 1 ? ', ' : '' %>
                    <% } %>
                  </td>
                  <td lang="ar" dir="rtl"><a href="<%= quranManzilStartHref(manzil) %>"><%- quranTocSurahArabicName(manzil.startSurah) %></a></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
        <% } else { %>
        <div class="page-content-filter toc-content-filter input-group mb-3">
          <span class="input-group-text bi bi-filter" aria-hidden="true"></span>
          <input type="search" class="form-control" placeholder="Filter chapter headings" aria-label="Filter chapter headings" autocomplete="off" data-toc-content-filter="#toc">
        </div>

        <h2 class="fs-4 mt-3">Chapters Headings</h2>
		<% if (hadithIntroductionAdminHref && !hadithIntroductionHref) { %>
		<p class="mb-2"><a class="btn btn-sm btn-outline-primary" href="<%= hadithIntroductionAdminHref %>"><span class="bi bi-plus-circle"></span> Manage introduction articles</a></p>
		<% } %>
        
        <table id="toc" class="table" title="<%- `Chapters Headings for ${book.name_en} (فهرس ${book.title})` %>">
          <tbody>
			<% hadithIntroductionArticles.forEach(function (article) { %>
			<% if (hadithIntroductionHref && (utils.trimToEmpty(article.intro) || utils.trimToEmpty(article.intro_en))) { %>
			<tr class="chapter hadith-introduction-link-row">
			  <td></td><td><span class="toc-expand-spacer"></span>Introduction</td>
			  <td><a href="<%= `${hadithIntroductionHref}#introduction-${article.h2}` %>"><%= displayName(article.title_en) || 'Introduction' %></a></td>
			  <td lang="ar" dir="rtl"><a href="<%= `${hadithIntroductionHref}#introduction-${article.h2}` %>"><%= displayName(article.title) || 'المقدمة' %></a></td>
			</tr>
			<% } %>
			<% }); %>
            <%
        for (var i = 0; i < toc.length; i++) {
		  if (Number(toc[i].h1) === 0)
			continue;
          toc[i].h1 = formatHeadingNumber(toc[i].h1);
          toc[i].h2 = formatHeadingNumber(toc[i].h2);
          var title_en = truncateTitle(toc[i].title_en, 75);
          var title = truncateTitle(toc[i].title, 150);
          var sections = Array.isArray(toc[i].sections) ? toc[i].sections : [];
          var hasSections = sections.length > 0;
          var chapterRowId = `toc-chapter-${toc[i].id || i}`;
          %>
            <tr class="chapter" data-toc-chapter="<%= chapterRowId %>" data-toc-heading-target data-toc-heading-key="<%= tocHeadingRailKeys.get(toc[i]) %>">
              <% if (showHadithBookChrome) { %>
              <td><%- toc[i].start %></td>
              <% } %>
              <td>
                <% if (hasSections) { %>
                <button type="button" class="toc-expand-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" aria-expanded="false" aria-controls="<%= chapterRowId %>" data-toc-toggle="<%= chapterRowId %>" title="Show sections">
                  <span class="toc-expand-icon bi bi-chevron-right"></span>
                </button>
                <% } else { %>
                <span class="toc-expand-spacer"></span>
                <% } %>
                C<%- toc[i].h1 %>
              </td>
              <% if (toc[i].start) { %>
              <td>
                <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center me-1" data-heading-id="<%= toc[i].id %>" data-bookmark-type="<%= book.alias === 'quran' ? 'surah' : 'chapter' %>" data-bookmark-ref="<%= book.alias === 'quran' ? `quran:${toc[i].h1}` : `${book.alias}:${toc[i].h1}` %>" data-bookmark-title="<%= toc[i].title_en || title_en || 'Chapter' %>" data-bookmark-title-ar="<%= toc[i].title || title || '' %>" data-bookmark-url="<%= quranTocHref(toc[i]) %>" title="Bookmark this chapter">
                  <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= toc[i].id %>"></span>
                </button>
                <a href="<%= quranTocHref(toc[i]) %>" class="_e" data-id="<%=toc[i].id%>" data-prop="toc.title_en" data-arabizi="true"><%- title_en || 'Chapter' %></a>
              </td>
              <td lang="ar"><a href="<%= quranTocHref(toc[i]) %>" class="_e<%= book.alias === 'quran' ? ' quran-surah-name' : '' %>" data-id="<%=toc[i].id%>" data-prop="toc.title"><%- title %></a></td>
              <% } else { %>
              <td>
                <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center me-1" data-heading-id="<%= toc[i].id %>" data-bookmark-type="<%= book.alias === 'quran' ? 'surah' : 'chapter' %>" data-bookmark-ref="<%= book.alias === 'quran' ? `quran:${toc[i].h1}` : `${book.alias}:${toc[i].h1}` %>" data-bookmark-title="<%= toc[i].title_en || title_en || 'Chapter' %>" data-bookmark-title-ar="<%= toc[i].title || title || '' %>" title="Bookmark this chapter">
                  <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= toc[i].id %>"></span>
                </button>
                <span class="_e" data-id="<%=toc[i].id%>" data-prop="toc.title_en" data-arabizi="true"><%- title_en %></span>
              </td>
              <td lang="ar" class="_e<%= book.alias === 'quran' ? ' quran-surah-name' : '' %>" data-id="<%=toc[i].id%>" data-prop="toc.title"><%- title %></td>
              <% } %>
            </tr>
            <% for (var sectionIndex = 0; sectionIndex < sections.length; sectionIndex++) {
              var section = sections[sectionIndex];
              section.h1 = formatHeadingNumber(section.h1);
              section.h2 = formatHeadingNumber(section.h2);
              var sectionTitleEn = truncateTitle(section.title_en, 75);
              var sectionTitle = truncateTitle(section.title, 150);
            %>
            <tr class="title toc-section-row d-none" data-toc-parent="<%= chapterRowId %>">
              <% if (showHadithBookChrome) { %>
              <td><%- section.start %></td>
              <% } %>
              <td><span class="toc-section-number"><%- tocSectionNumberLabel(section) %></span></td>
              <% if (section.path) { %>
              <td>
				<a href="<%= quranTocHref(section) %>" class="_e" data-id="<%=section.id%>" data-prop="toc.title_en" data-arabizi="true"><%- sectionTitleEn || 'Passage' %></a>
              </td>
              <td lang="ar"><a href="<%= quranTocHref(section) %>" class="_e" data-id="<%=section.id%>" data-prop="toc.title"><%- sectionTitle %></a></td>
              <% } else { %>
			  <td class="_e" data-id="<%=section.id%>" data-prop="toc.title_en" data-arabizi="true"><%- sectionTitleEn || 'Passage' %></td>
              <td lang="ar" class="_e" data-id="<%=section.id%>" data-prop="toc.title"><%- sectionTitle %></td>
              <% } %>
            </tr>
            <% }
        }
        %>
          </tbody>
        </table>
        <% } %>
      </section>
      </article>
      
    </main>
    <% if (showTocHeadingRail) { %></div>
    <%- include('sub-views/toc_heading_rail.ejs', {
      tocHeadingRailItems: tocHeadingRailItems,
      tocHeadingRailTitle: tocHeadingRailTitle,
      tocHeadingRailBookHref: utils.urlFor(req, page.canonical || req.path || '/')
    }); %>
    <% } %>
  </div>
  
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  
</body>

</html>
