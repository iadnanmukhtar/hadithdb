      for (var mappingIndex = 0; mappingIndex < keys.length; mappingIndex++) {
        var mappedSurah = parseInt(keys[mappingIndex], 10);
        if (!Number.isInteger(mappedSurah) || mappedSurah <= 0)
          continue;
        var rangeValue = (mapping[keys[mappingIndex]] || '').toString();
        var firstSegment = rangeValue.split(',')[0] || '';
