<!doctype html>
<html lang="en">

<head>
  <%
    var site = Object.assign({}, global.settings.site);
    site.admin = (!locals.noadmin && req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;
        
    var isQuranToc = book.alias === 'quran';
    var quranCommentaryBook = locals.quranCommentaryBook;
    var quranCommentaryBooks = Array.isArray(locals.quranCommentaryBooks) ? locals.quranCommentaryBooks : [];
    var quranCommentaryBookSlug = quranCommentaryBook && (quranCommentaryBook.quranBookSlug || quranCommentaryBook.slug || quranCommentaryBook.alias);
    var bookDownloadLinks = locals.BookDownloads ? locals.BookDownloads.relativeDownloadLinks(quranCommentaryBook || book) : {
      json: `/${book.alias}.json`,
      epub: `/${book.alias}.epub`
    };
    function displayName(value) {
      return (value || '').toString().replace(/\s+/g, ' ').trim();
    }
    function suffixDisplayName(value, suffix) {
      value = displayName(value);
      return new RegExp(`\\b${suffix}$`, 'i').test(value) ? value : `${value} ${suffix}`.trim();
    }
    function prefixDisplayName(value, prefix) {
      value = displayName(value);
      return new RegExp(`^${prefix}\\b`, 'i').test(value) ? value : `${prefix} ${value}`.trim();
    }
    function prefixArabicDisplayName(value, prefix) {
      value = displayName(value);
      return value.indexOf(prefix) === 0 ? value : `${prefix} ${value}`.trim();
    }
    function commentaryBookShortNameEn(book) {
      return displayName(book && (book.shortName_en || book.name_en || book.shortName || book.title || book.alias));
    }
    function commentaryBookShortNameAr(book) {
      return displayName(book && (book.shortName || book.title || book.shortName_en || book.name_en || book.alias));
    }
    function commentaryBookDisplayNameEn(book) {
      if (!book)
        return '';
      if (book.type === 'trans')
        return displayName(book.name_en || book.title || book.shortName_en || book.shortName || book.alias);
      return prefixDisplayName(commentaryBookShortNameEn(book), 'Tafsir');
    }
    function commentaryBookDisplayNameAr(book) {
      if (!book)
        return '';
      var shortName = commentaryBookShortNameAr(book);
      return book.type === 'tafsir' ? prefixArabicDisplayName(shortName, 'تفسير') : shortName;
    }
    function commentaryBookSubtitleEn(book) {
      if (!book || book.type !== 'trans')
        return '';
      return displayName(book.author_en || book.author || '');
    }
    function commentaryDeathLabel(book) {
      var death = displayName(book && book.death);
      if (!death)
        return '';
      if (book && book.type === 'trans') {
        if (!/\bCE\b/i.test(death))
          death = `${death} CE`;
      } else if (!/\b(?:AH|H)\b/i.test(death) && !/هـ/u.test(death)) {
        death = `${death} AH`;
      }
      return /^d\./i.test(death) ? death : `d. ${death}`;
    }
    function commentaryArabicDeathLabel(book) {
      var death = displayName(book && book.death);
      if (!death)
        return '';
      death = death.replace(/\b(?:AH|H)\b/ig, '').replace(/هـ/u, '').trim();
      return `ت. ${death} هـ`;
    }
    function hasQuranCommentaryDescriptionDetails(book) {
      if (!book)
        return false;
      if (book.type === 'trans')
        return false;
      return !!displayName(book.name_en || book.title || book.shortName_en || book.shortName || book.author_en || book.author || book.death);
    }
    var quranCommentaryBookLabel = quranCommentaryBook ? commentaryBookDisplayNameEn(quranCommentaryBook) : '';
    var quranCommentaryBookTitle = quranCommentaryBook ? commentaryBookDisplayNameAr(quranCommentaryBook) : '';
    var quranCommentaryBookSubtitleEn = quranCommentaryBook ? commentaryBookSubtitleEn(quranCommentaryBook) : '';
    var quranCommentaryHeaderSubtitleEn = quranCommentaryBook && quranCommentaryBook.type === 'trans'
      ? commentaryBookShortNameEn(quranCommentaryBook)
      : quranCommentaryBookLabel;
    var quranCommentaryBookCanonical = quranCommentaryBook
      ? (quranCommentaryBook.type === 'trans' ? `/quran/${quranCommentaryBookSlug}` : `/quran/tafsir/${quranCommentaryBookSlug}`)
      : '';
    var tocDisplayBook = quranCommentaryBook || book;
    var tocDisplayBookNameEn = quranCommentaryBook
      ? quranCommentaryBookLabel
      : displayName(tocDisplayBook.name_en || tocDisplayBook.shortName_en || tocDisplayBook.alias);
    var tocDisplayBookTitle = quranCommentaryBook
      ? (quranCommentaryBook.type === 'trans' ? '' : quranCommentaryBookTitle)
      : displayName(tocDisplayBook.title || tocDisplayBook.shortName || '');
    var showBookLayout = !isQuranToc || !!quranCommentaryBook;
    var showHadithBookChrome = !isQuranToc;
    var showRandomTocItem = !quranCommentaryBook;
    var showRandomTocTitle = !isQuranToc && !quranCommentaryBook;
    var quranCommentaryPageTitleEn = quranCommentaryBook && quranCommentaryBook.type === 'trans'
      ? `Quran | ${commentaryBookShortNameEn(quranCommentaryBook)} | ${quranCommentaryBookLabel}`
      : `Quran | ${quranCommentaryBookLabel}`;
    var pageTitleEn = isQuranToc
      ? (quranCommentaryBook ? quranCommentaryPageTitleEn : 'Quran | Table of Contents')
      : utils.hadithBookTitle(book);
    var pageDescriptionEn = isQuranToc
      ? (quranCommentaryBook
        ? `Browse the Quran table of contents with links to ${quranCommentaryBookLabel} passages.`
        : 'Browse the Quran table of contents by surah and passage, with Arabic text, English translation, and tafsir.')
      : `Browse the table of contents for ${book.name_en || book.shortName_en}.`;
    var page = {
      menu: 'Books',
      title_en: pageTitleEn,
      description_en: pageDescriptionEn,
      subtitle_en: quranCommentaryBook ? quranCommentaryHeaderSubtitleEn : `${book.shortName_en}`,
      subtitle: quranCommentaryBook ? (quranCommentaryBook.type === 'trans' ? '' : quranCommentaryBookTitle) : `${book.shortName}`,
      canonical: quranCommentaryBook ? quranCommentaryBookCanonical : `/${book.alias}`,
      context: {
        book,
        quranCommentaryBook,
      }
    };
    if (showHadithBookChrome && typeof prevBook != 'undefined' && prevBook)
        page.prev = `/${prevBook.alias}`;
    if (showHadithBookChrome && typeof nextBook != 'undefined' && nextBook)
        page.next = `/${nextBook.alias}`;
    var quranNavigatorSurahs = [];
    if (book.alias === 'quran') {
      quranNavigatorSurahs = (global.surahs || []).map(function (surah) {
        return {
          num: Number(surah.num),
          name_en: surah.name_en,
          name_ar: surah.name_ar,
          ayahs: Number(surah.ayahs)
        };
      }).filter(function (surah) {
        return Number.isInteger(surah.num);
      }).sort(function (a, b) {
        return a.num - b.num;
      });
    }
    var quranTocSectionViews = book.alias === 'quran' && (!quranCommentaryBook || quranCommentaryBook.type === 'tafsir');
    var quranTocDefaultView = (locals.quranTocDefaultView || 'juz').toString();
    if (!['surahs', 'juz', 'manzils'].includes(quranTocDefaultView))
      quranTocDefaultView = 'juz';
    var quranJuzRows = Array.isArray(locals.quranJuzRows) ? locals.quranJuzRows : [];
    var quranManzilRows = Array.isArray(locals.quranManzilRows) ? locals.quranManzilRows : [];
    var quranSectionRangesBySurah = (locals.quranSectionRangesBySurah && typeof locals.quranSectionRangesBySurah === 'object')
      ? locals.quranSectionRangesBySurah
      : {};
    var quranSurahJuzPassages = {};
    for (var juzIndex = 0; juzIndex < quranJuzRows.length; juzIndex++) {
      var juzRow = quranJuzRows[juzIndex];
      var mapping = juzRow && juzRow.quran_verse_mapping && typeof juzRow.quran_verse_mapping === 'object' ? juzRow.quran_verse_mapping : {};
      var keys = Object.keys(mapping);
      var juzNum = parseInt(juzRow && juzRow.num, 10);
      if (!Number.isInteger(juzNum) || juzNum <= 0)
        juzNum = juzIndex + 1;
      for (var mappingIndex = 0; mappingIndex < keys.length; mappingIndex++) {
        var mappedSurah = parseInt(keys[mappingIndex], 10);
        if (!Number.isInteger(mappedSurah) || mappedSurah <= 0)
          continue;
        var rangeValue = (mapping[keys[mappingIndex]] || '').toString();
        var firstSegment = rangeValue.split(',')[0] || '';
        var parsedAyah = parseInt(firstSegment.split('-')[0], 10);
        var startAyah = Number.isInteger(parsedAyah) && parsedAyah > 0 ? parsedAyah : 1;
        quranSurahJuzPassages[mappedSurah] = quranSurahJuzPassages[mappedSurah] || [];
        quranSurahJuzPassages[mappedSurah].push({
          juz: juzNum,
          ayah: startAyah
        });
      }
    }
    Object.keys(quranSurahJuzPassages).forEach(function (surahPassageKey) {
      quranSurahJuzPassages[surahPassageKey].sort(function (a, b) {
        if (a.juz !== b.juz)
          return a.juz - b.juz;
        return a.ayah - b.ayah;
      });
    });
    function quranSurahLookup(num) {
      return quranNavigatorSurahs.find(function (row) {
        return row.num === Number(num);
      });
    }
    function quranTocSurahDisplayName(num) {
      var surah = quranSurahLookup(num);
      if (!surah)
        return `Surah ${num}`;
      return `Surah ${surah.name_en}`;
    }
    function quranTocSurahName(num) {
      var surah = quranSurahLookup(num);
      if (!surah)
        return `${num}`;
      return surah.name_en || `${num}`;
    }
    function quranTocSurahArabicName(num) {
      var surah = quranSurahLookup(num);
      if (!surah)
        return '';
      return surah.name_ar || '';
    }
    function quranTocStartRefLabel(item) {
      return `${quranTocSurahDisplayName(item.startSurah)} ${item.startSurah}:${item.startAyah}`;
    }
    function quranTocSurahFirstPassageAyah(surah) {
      surah = Number(surah) || 1;
      var passages = quranSurahJuzPassages[surah];
      if (!Array.isArray(passages) || passages.length === 0)
        return 1;
      return passages[0].ayah || 1;
    }
    function quranTocSurahPassageAyahInJuz(surah, juzNum) {
      surah = Number(surah) || 1;
      var passages = quranSurahJuzPassages[surah];
      var juz = Number(juzNum);
      if (!Array.isArray(passages) || passages.length === 0)
        return 1;
      if (passages.length === 1)
        return passages[0].ayah || 1;
      var exact = passages.find(function (entry) {
        return entry.juz === juz;
      });
      return exact && Number.isInteger(exact.ayah) && exact.ayah > 0
        ? exact.ayah
        : passages[0].ayah || 1;
    }
    function quranTocSurahCutsAcrossJuz(surah) {
      surah = Number(surah) || 1;
      var passages = quranSurahJuzPassages[surah];
      return Array.isArray(passages) && passages.length > 1;
    }
    function quranTocRelevantPassage(surah, juzNum) {
      if (quranTocSurahCutsAcrossJuz(surah))
        return quranTocSurahPassageAyahInJuz(surah, juzNum);
      return quranTocSurahFirstPassageAyah(surah);
    }
    function quranTocNormalizeQuranPath(path) {
      path = (path || '').toString().trim();
      if (!path)
        return '/quran';
      if (path.charAt(0) === '/')
        path = path.substring(1);
      if (/^quran:/.test(path))
        path = path.replace(/^quran:/, 'quran/');
      path = path.replace(/:/g, '/');
      if (/^quran\/|^\d+\//.test(path))
        return `/${path}`;
      return `/quran/${path}`;
    }
    function quranSectionFromAyah(surah, ayah) {
      surah = Number(surah) || 1;
      ayah = Number(ayah) || 1;
      var ranges = Array.isArray(quranSectionRangesBySurah[surah]) ? quranSectionRangesBySurah[surah] : [];
      if (!Array.isArray(ranges) || ranges.length === 0)
        return ayah;
      for (var rangeIndex = 0; rangeIndex < ranges.length; rangeIndex++) {
        var sectionRange = ranges[rangeIndex];
        if (ayah >= sectionRange.start && ayah <= sectionRange.end)
          return sectionRange.section;
      }
      var fallback = ranges[0];
      for (var fallbackIndex = ranges.length - 1; fallbackIndex >= 0; fallbackIndex--) {
        if (ayah >= ranges[fallbackIndex].start) {
          fallback = ranges[fallbackIndex];
          break;
        }
      }
      return fallback && Number.isInteger(fallback.section) ? fallback.section : ayah;
    }
    function quranTocPassageHref(surah, ayah) {
      surah = Number(surah) || 1;
      ayah = Number(ayah) || 1;
      var section = quranSectionFromAyah(surah, ayah);
      if (quranCommentaryBook && quranCommentaryBook.type === 'tafsir')
        return utils.quranUrl(req, `/quran/tafsir/${encodeURIComponent(quranCommentaryBookSlug)}/${surah}/${section}`);
      return utils.quranUrl(req, `/quran/${surah}/${section}`);
    }
    function quranTocStartHref(item) {
      var fallbackAyah = 1;
      return quranTocPassageHref(item.startSurah, quranCommentaryBook && quranCommentaryBook.type === 'tafsir'
        ? Number(item.startAyah) || fallbackAyah
        : 1);
    }
    function quranJuzStartHref(juz) {
      var parts = (juz && juz.start ? juz.start.toString() : '').split(':');
      var surah = parseInt(parts[0], 10) || 1;
      var ayah = parseInt(parts[1], 10) || 1;
      return quranTocPassageHref(surah, ayah);
    }
    function quranJuzSurahLinks(juz) {
      var mapping = juz && juz.quran_verse_mapping && typeof juz.quran_verse_mapping === 'object' ? juz.quran_verse_mapping : {};
      return Object.keys(mapping).sort(function (a, b) {
        return Number(a) - Number(b);
      }).map(function (surahNum) {
        var range = (mapping[surahNum] || '').toString();
        var firstAyah = parseInt(range.split(',')[0].split('-')[0], 10) || 1;
        var juzNum = parseInt(juz && juz.num, 10);
        var relevanceAyah = quranTocRelevantPassage(surahNum, juzNum);
        firstAyah = Number.isInteger(relevanceAyah) ? relevanceAyah : firstAyah;
        return {
          surah: Number(surahNum),
          range: range,
          href: quranTocPassageHref(surahNum, firstAyah),
          name_en: quranTocSurahName(surahNum)
        };
      });
    }
    function quranManzilSurahLinks(manzil, manzilIndex) {
      if (!manzil)
        return [];
      var nextManzil = quranManzilRows[manzilIndex + 1];
      var startSurah = Number(manzil.startSurah) || 1;
      var endSurah = Number.isSafeInteger(parseInt(nextManzil && nextManzil.startSurah, 10)) && nextManzil.startSurah > 0
        ? Number(nextManzil.startSurah) - 1
        : 114;
      if (!Number.isSafeInteger(startSurah) || startSurah > endSurah)
        return [];
      if (startSurah < 1)
        startSurah = 1;
      if (endSurah > 114)
        endSurah = 114;
      var links = [];
      for (var surahNum = startSurah; surahNum <= endSurah; surahNum++) {
        var firstPassageAyah = 1;
        links.push({
          surah: surahNum,
          href: quranTocPassageHref(surahNum, firstPassageAyah),
          name_en: quranTocSurahName(surahNum)
        });
      }
      return links;
    }
    function quranHeadingStartRef(heading) {
      var source = heading && heading.firstSection ? heading.firstSection : heading;
      var start = source && source.start ? source.start.toString() : '';
      var path = source && source.path ? source.path.toString() : '';
      var parts = arabic.toLatinDigits(start.replace(/^quran:/, '')).split(/[:/-]/).filter(Boolean);
      if (parts.length < 2 && path) {
        var pathParts = arabic.toLatinDigits(path.replace(/^\/?quran\/?/, '')).split(/[/:]/).filter(Boolean);
        if (pathParts.length >= 2)
          parts = pathParts;
      }
      var surah = parts[0] || (heading && heading.h1) || 1;
      var ayah = parts[1] || 1;
      return {
        surah: parseInt(surah, 10) || 1,
        ayah: parseInt(ayah, 10) || 1
      };
    }
    function quranHeadingSectionRef(heading) {
      var source = heading && heading.firstSection ? heading.firstSection : heading;
      var path = source && source.path ? source.path.toString() : '';
      var pathParts = path
        ? arabic.toLatinDigits(path.replace(/^\/?quran\/?/, '')).split(/[/:]/).filter(Boolean)
        : [];
      var surah = (source && source.h1) || (heading && heading.h1) || pathParts[0] || 1;
      var section = (source && source.h2) || (heading && heading.h2) || pathParts[1] || 1;
      return {
        surah: parseInt(arabic.toLatinDigits(surah.toString()), 10) || 1,
        section: parseInt(arabic.toLatinDigits(section.toString()), 10) || 1
      };
    }
    function quranTocHref(heading) {
      if (!quranCommentaryBook) {
        var targetPath = heading && heading.firstSection ? heading.firstSection.path : heading.path;
        return utils.urlFor(req, quranTocNormalizeQuranPath(targetPath));
      }
      if (quranCommentaryBook.type === 'trans') {
        var sectionRef = quranHeadingSectionRef(heading);
        return utils.quranUrl(req, `/quran/${encodeURIComponent(quranCommentaryBook.alias)}/${sectionRef.surah}/${sectionRef.section}`);
      }
      var ref = quranHeadingStartRef(heading);
      return utils.quranUrl(req, `/quran/tafsir/${encodeURIComponent(quranCommentaryBookSlug)}/${ref.surah}/${ref.ayah}`);
    }
    function quranCommentaryPaginationSlug(book) {
      if (!book)
        return '';
      if (book.type === 'tafsir')
        return book.slug || Tafsir.tafsirSlug(book.alias);
      return book.quranBookSlug || book.alias;
    }
    function quranCommentaryPaginationHref(book) {
      if (!book)
        return '';
      if (book.type === 'trans')
        return utils.quranUrl(req, `/quran/${encodeURIComponent(quranCommentaryPaginationSlug(book))}`);
      var slug = quranCommentaryPaginationSlug(book);
      var hasLanguageCollision = quranCommentaryBooks.some(function (other) {
        return other && other !== book && other.lang !== book.lang && (other.slug || Tafsir.tafsirSlug(other.alias)) === slug;
      });
      var query = hasLanguageCollision && book.lang
        ? `?lang=${encodeURIComponent(book.lang)}`
        : '';
      return utils.quranUrl(req, `/quran/tafsir/${encodeURIComponent(slug)}${query}`);
    }
    function quranCommentaryPaginationLabel(book) {
      if (!book)
        return '';
      if (book.type === 'trans')
        return displayName(book.name_en || book.shortName_en || book.author_en || book.alias);
      var rawName = Tafsir.rawShortName(book, 'en') || book.shortName_en || book.name_en || book.alias || '';
      var name = rawName.replace(/^tafs[īi]r\s+/i, '').trim();
      return /^tafs[īi]r\b/i.test(name) ? name : `Tafsir ${name}`;
    }
    if (quranCommentaryBook) {
      var quranCommentaryCurrentIndex = quranCommentaryBooks.findIndex(function (row) {
        return row
          && row.alias === quranCommentaryBook.alias
          && (!quranCommentaryBook.lang || row.lang === quranCommentaryBook.lang);
      });
      var quranCommentaryPrevBook = quranCommentaryCurrentIndex > 0 ? quranCommentaryBooks[quranCommentaryCurrentIndex - 1] : null;
      var quranCommentaryNextBook = quranCommentaryCurrentIndex >= 0 && quranCommentaryCurrentIndex < quranCommentaryBooks.length - 1 ? quranCommentaryBooks[quranCommentaryCurrentIndex + 1] : null;
      if (quranCommentaryPrevBook) {
        page.prev = quranCommentaryPaginationHref(quranCommentaryPrevBook);
        page.prevTitle = `Previous: ${quranCommentaryPaginationLabel(quranCommentaryPrevBook)}`;
      }
      if (quranCommentaryNextBook) {
        page.next = quranCommentaryPaginationHref(quranCommentaryNextBook);
        page.nextTitle = `Next: ${quranCommentaryPaginationLabel(quranCommentaryNextBook)}`;
      }
    }
    var quranNavigatorBase = '';
    var quranNavigatorQuery = '';
    var randomTocItemQueryParts = [];
    if (quranCommentaryBook) {
      if (quranCommentaryBook.type === 'trans') {
        quranNavigatorBase = `/quran/${encodeURIComponent(quranCommentaryBook.alias)}`;
      } else {
        quranNavigatorBase = `/quran/tafsir/${encodeURIComponent(quranCommentaryBookSlug)}`;
      }
    }
    if (isQuranToc && !quranCommentaryBook)
      randomTocItemQueryParts.push('hideTitle=1');
    var randomTocItemSrc = `/${book.alias}/random${randomTocItemQueryParts.length ? `?${randomTocItemQueryParts.join('&')}` : ''}`;
	%>
  
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
  
</head>

<body>
  
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  
  <div class="container col-lg-8 mx-auto">
    
    <main class="toc"<% if (quranCommentaryBook && quranCommentaryBook.type === 'trans') { %> data-quran-selected-translation-book="<%= quranCommentaryBook.alias %>"<% } %>>
      
      <% if (showHadithBookChrome) { %>
        <%- include('sub-views/bookNav.ejs'); %>
      <% } %>
      <% if (quranCommentaryBook) { %>
        <%- include('sub-views/quran_commentary_book_nav.ejs', { quranCommentaryBook: quranCommentaryBook, quranCommentaryBooks: quranCommentaryBooks, Tafsir: Tafsir }); %>
      <% } %>

      <article>
        <% if (showBookLayout) { %>
        <heading class="mb-2">
          <div class="row text-center justify-content-center">
            <h2 class="<%= quranCommentaryBook ? '' : '_e ' %>fs-3<%= quranCommentaryBook && quranCommentaryBook.type === 'trans' ? ' quran-translation-toc-title text-truncate w-100' : '' %>" title="<%- tocDisplayBookNameEn || tocDisplayBook.title || tocDisplayBook.name_en || '' %>"<% if (!quranCommentaryBook) { %> data-id="<%=tocDisplayBook.id%>" data-prop="book.name_en" data-arabizi="true"<% } %>><%- tocDisplayBookNameEn %></h2>
            <% if (quranCommentaryBookSubtitleEn) { %>
            <p class="quran-translation-toc-subtitle text-muted fs-5 mb-1"><%- quranCommentaryBookSubtitleEn %></p>
            <% } %>
            <% if (tocDisplayBookTitle) { %>
            <h2 class="<%= quranCommentaryBook ? '' : '_e ' %>fs-3 fw-bold text-center" lang="ar" dir="rtl" title="<%- tocDisplayBook.name_en || '' %>"<% if (!quranCommentaryBook) { %> data-id="<%=tocDisplayBook.id%>" data-prop="book.title"<% } %>><%- tocDisplayBookTitle %></h2>
            <% } %>
            <% if (site.editMode && !quranCommentaryBook) { %>
            <h3>
              <span class="_e fs-5" data-id="<%=tocDisplayBook.id%>" data-prop="book.shortName_en" data-arabizi="true"><%- tocDisplayBook.shortName_en %></span>
              <span class="_e fs-5" lang="ar" dir="rtl" data-id="<%=tocDisplayBook.id%>" data-prop="book.shortName"><%- tocDisplayBook.shortName %></span>
            </h3>
            <% } %>
          </div>
        </heading>
        <% } %>

		      <% if (quranNavigatorSurahs.length > 0 && !quranCommentaryBook) { %>
	      <form class="quran-passage-navigator quran-toc-navigator mb-3" action="/quran" method="get" novalidate data-quran-passage-navigator<% if (quranNavigatorBase) { %> data-tafsir-navigator-base="<%= quranNavigatorBase %>" data-tafsir-navigator-query="<%= quranNavigatorQuery %>"<% } %> data-surahs="<%= JSON.stringify(quranNavigatorSurahs) %>">
	        <label class="form-label mb-0">
	          <input type="text" class="form-control quran-passage-surah" value="1" aria-label="Select Quran surah" autocomplete="off" required>
	        </label>
