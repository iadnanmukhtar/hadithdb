      surah = Number(surah) || 1;
      var passages = quranSurahJuzPassages[surah];
      return Array.isArray(passages) && passages.length > 1;
    }
    function quranTocRelevantPassage(surah, juzNum) {
      if (quranTocSurahCutsAcrossJuz(surah))
        return quranTocSurahPassageAyahInJuz(surah, juzNum);
      return quranTocSurahFirstPassageAyah(surah);
    }
    function quranTocNormalizeQuranPath(path) {
      path = (path || '').toString().trim();
      if (!path)
        return '/quran';
      if (path.charAt(0) === '/')
        path = path.substring(1);
      if (/^quran:/.test(path))
        path = path.replace(/^quran:/, 'quran/');
      path = path.replace(/:/g, '/');
      if (/^quran\/|^\d+\//.test(path))
        return `/${path}`;
      return `/quran/${path}`;
    }
    function quranSectionFromAyah(surah, ayah) {
      surah = Number(surah) || 1;
      ayah = Number(ayah) || 1;
      var ranges = Array.isArray(quranSectionRangesBySurah[surah]) ? quranSectionRangesBySurah[surah] : [];
