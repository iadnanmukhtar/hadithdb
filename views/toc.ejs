              <% } else { %>
              <td>
                <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center me-1" data-heading-id="<%= toc[i].id %>" data-bookmark-type="<%= book.alias === 'quran' ? 'surah' : 'chapter' %>" data-bookmark-ref="<%= book.alias === 'quran' ? `quran:${toc[i].h1}` : `${book.alias}:${toc[i].h1}` %>" data-bookmark-title="<%= toc[i].title_en || title_en || 'Chapter' %>" data-bookmark-title-ar="<%= toc[i].title || title || '' %>" title="Bookmark this chapter">
                  <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= toc[i].id %>"></span>
                </button>
                <span class="_e" data-id="<%=toc[i].id%>" data-prop="toc.title_en" data-arabizi="true"><%- title_en %></span>
              </td>
              <td lang="ar" class="_e<%= book.alias === 'quran' ? ' quran-surah-name' : '' %>" data-id="<%=toc[i].id%>" data-prop="toc.title"><%- title %></td>
              <% } %>
            </tr>
            <% for (var sectionIndex = 0; sectionIndex < sections.length; sectionIndex++) {
              var section = sections[sectionIndex];
              section.h1 = formatHeadingNumber(section.h1);
              section.h2 = formatHeadingNumber(section.h2);
              var sectionTitleEn = truncateTitle(section.title_en, 75);
              var sectionTitle = truncateTitle(section.title, 150);
            %>
            <tr class="title toc-section-row d-none" data-toc-parent="<%= chapterRowId %>">
              <% if (showHadithBookChrome) { %>
              <td><%- section.start %></td>
              <% } %>
              <td><span class="toc-section-number"><%- tocSectionNumberLabel(section) %></span></td>
              <% if (section.path) { %>
              <td>
                <a href="<%= quranTocHref(section) %>" class="_e" data-id="<%=section.id%>" data-prop="toc.title_en" data-arabizi="true"><%- sectionTitleEn || 'Section' %></a>
              </td>
              <td lang="ar"><a href="<%= quranTocHref(section) %>" class="_e" data-id="<%=section.id%>" data-prop="toc.title"><%- sectionTitle %></a></td>
              <% } else { %>
              <td class="_e" data-id="<%=section.id%>" data-prop="toc.title_en" data-arabizi="true"><%- sectionTitleEn || 'Section' %></td>
              <td lang="ar" class="_e" data-id="<%=section.id%>" data-prop="toc.title"><%- sectionTitle %></td>
              <% } %>
            </tr>
            <% }
        }
        %>
          </tbody>
        </table>
        <% } %>
      </section>
      </article>
      
    </main>
  </div>
  
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  
</body>

</html>
