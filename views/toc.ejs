<!doctype html>
<html lang="en">

<head>
  <%
    var site = Object.assign({}, global.settings.site);
    site.admin = (!locals.noadmin && req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;
        
    var isQuranToc = book.alias === 'quran';
    var pageTitleEn = isQuranToc
      ? 'Quran | Table of Contents'
      : utils.hadithBookTitle(book);
    var pageDescriptionEn = isQuranToc
      ? 'Browse the Quran table of contents by surah and passage, with Arabic text, English translation, and tafsir.'
      : `Browse the table of contents for ${book.name_en || book.shortName_en}.`;
    var page = {
      menu: 'Books',
      title_en: pageTitleEn,
      description_en: pageDescriptionEn,
      subtitle_en: `${book.shortName_en}`,
      subtitle: `${book.shortName}`,
      canonical: `/${book.alias}`,
      context: {
        book,
      }
    };
    if (typeof prevBook != 'undefined' && prevBook)
        page.prev = `/${prevBook.alias}`;
    if (typeof nextBook != 'undefined' && nextBook)
        page.next = `/${nextBook.alias}`;
    var quranNavigatorSurahs = [];
    if (book.alias === 'quran') {
      quranNavigatorSurahs = (global.surahs || []).map(function (surah) {
        return {
          num: Number(surah.num),
          name_en: surah.name_en,
          name_ar: surah.name_ar,
          ayahs: Number(surah.ayahs)
        };
      }).filter(function (surah) {
        return Number.isInteger(surah.num);
      }).sort(function (a, b) {
        return a.num - b.num;
      });
    }
%>
  
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
  
</head>

<body>
  
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  
  <div class="container col-lg-8 mx-auto">
    
    <main class="toc">
      
      <%- include('sub-views/bookNav.ejs'); %> 
    
      <aside class="row mb-2 pagination">
        <div class="col-md-6 col-xs-12 text-start">
          <% if (page.prev) { %>
          <a class="pagination-nav-link" href="<%- page.prev %>" rel="prev">&lt;&nbsp;Prev:&nbsp;<%= prevBook.shortName_en %></a>
          <% } %>
        </div>
        <div class="col-md-6 col-xs-12 text-end">
          <% if (page.next) { %>
          <a class="pagination-nav-link" href="<%- page.next %>" rel="next">Next:&nbsp;<%= nextBook.shortName_en %>&nbsp;&gt;</a>
          <% } %>
        </div>
      </aside>

      <article>
      <heading class="mb-2">
        <div class="row text-center justify-content-center">
          <h2 class="_e fs-3" title="<%- book.name %>" data-id="<%=book.id%>" data-prop="book.name_en" data-arabizi="true"><%- book.name_en %></h2>
          <h2 class="_e fs-3 fw-bold text-center" lang="ar" dir="rtl" title="<%- book.name_en %>" data-id="<%=book.id%>" data-prop="book.name"><%- book.name %></h2>
          <% if (site.editMode) { %>
          <h3>
            <span class="_e fs-5" data-id="<%=book.id%>" data-prop="book.shortName_en" data-arabizi="true"><%- book.shortName_en %></span>
            <span class="_e fs-5" lang="ar" dir="rtl" data-id="<%=book.id%>" data-prop="book.shortName"><%- book.shortName %></span>
          </h3>
          <% } %>
        </div>
	      </heading>

	      <% if (quranNavigatorSurahs.length > 0) { %>
	      <form class="quran-passage-navigator quran-toc-navigator mb-3" action="/" method="get" novalidate data-quran-passage-navigator data-surahs="<%= JSON.stringify(quranNavigatorSurahs) %>">
	        <input type="hidden" name="b" value="quran">
	        <input type="hidden" name="b" value="commentaries">
	        <label class="form-label mb-0">
	          <input type="text" class="form-control quran-passage-surah" value="1" aria-label="Select Quran surah" autocomplete="off" required>
	        </label>
	        <div class="input-group quran-passage-ayah-group quran-toc-ayah-group">
	          <input type="text" inputmode="numeric" class="form-control quran-passage-ayah" value="1" aria-label="Select Quran ayah" autocomplete="off" required>
	          <button type="submit" class="btn btn-outline-primary quran-passage-go" title="Open ayah" aria-label="Open ayah">
	            <span class="bi bi-caret-right"></span>
	          </button>
	        </div>
	        <div class="input-group quran-passage-search-group quran-toc-search-group">
	          <input role="search" type="text" class="form-control quran-passage-search quran-toc-search-bar" placeholder="Search the Qurʿān or tafāsīr" aria-label="Search the Qurʿān or tafāsīr" autocomplete="off" autofocus>
	          <button type="button" class="btn btn-outline-primary quran-passage-search-submit" title="Search the Qurʿān or tafāsīr" aria-label="Search the Qurʿān or tafāsīr">
	            <span class="bi bi-search"></span>
	          </button>
	        </div>
	      </form>
	      <% } %>
	      
	      <section>
	        <%
	          const bookDescriptionMarkdown = utils.emptyIfNull(book.description);
	          const bookDescription = utils.markdownToHtml(bookDescriptionMarkdown) || (site.editMode ? '&hellip;' : '');
	          const bookDescriptionPreview = bookDescriptionMarkdown
	            .split(/\r?\n/)
	            .map(function (line) { return line.trim(); })
	            .find(Boolean) || '';
	          const bookDescriptionPreviewText = bookDescriptionPreview
	            .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
	            .replace(/[*_`#>]+/g, '')
	            .replace(/\s+/g, ' ')
	            .trim();
	        %>
	        <% if (bookDescriptionPreviewText || bookDescription) { %>
	          <p class="toc-book-description-summary text-muted" data-toc-description-summary="book-description">
	            <span class="toc-book-description-preview"><%= bookDescriptionPreviewText %></span>
	            <a href="#toc-book-description" data-toc-description-expand="book-description" role="button" aria-expanded="false" aria-controls="toc-book-description">More...</a>
	          </p>
	          <div id="toc-book-description" class="toc-book-description-full d-none" data-toc-description-full="book-description">
	            <div class="_e mb-1" data-id="<%=book.id%>" data-prop="book.description" data-markdown-source="<%= bookDescriptionMarkdown %>" data-markdown-empty-html="&hellip;"><%- bookDescription %></div>
	            <% if (book.id > 0) { %>
	              <small>
	                Author: <span class="_e" data-id="<%=book.id%>" data-prop="book.author"><%- book.author %></span>
	                (d. <span class="_e" data-id="<%=book.id%>" data-prop="book.yearOfDeath"><%- book.yearOfDeath %></span> H)
	              </small>
	            <% } %>
	          </div>
	        <% } else if (site.editMode) { %>
	          <div class="_e mb-1" data-id="<%=book.id%>" data-prop="book.description" data-markdown-source="<%= bookDescriptionMarkdown %>" data-markdown-empty-html="&hellip;"><%- bookDescription %></div>
	        <% } %>
	      </section>
	
	      <aside class="h"><div class="tags">
        <span class="bi bi-download"></span> <a href="<%= utils.urlFor(req, `/${book.alias}?download&tsv`) %>" type="button" rel="nofollow">Download TSV</a>
      </div></aside>

        <hr class="mt-3">
        <section data-random-toc-item data-src="<%= utils.urlFor(req, `/${book.alias}/random`) %>">
          <header class="row">
            <h3 class="col-12 fs-4">Random <%= isQuranToc ? 'āyah' : 'ḥadīth' %> in <%- book.shortName_en %> <span class="spinner-border spinner-border-sm text-muted" role="status" aria-label="Loading"></span></h3>
          </header>
        </section>
        <hr>

      <section class="row">
        
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "Table",
            "name": "<%- `Chapters Headings for ${book.name_en} (فهرس ${book.name})` %>",
            "about": "<%- `Chapters Headings for ${book.name_en} (فهرس ${book.name})` %>"
          }
        </script>
        
        <% if (!isQuranToc) { %>
        <div class="page-content-filter toc-content-filter input-group mb-3">
          <span class="input-group-text bi bi-filter" aria-hidden="true"></span>
          <input type="search" class="form-control" placeholder="Filter chapter headings" aria-label="Filter chapter headings" autocomplete="off" data-toc-content-filter="#toc" autofocus>
        </div>
        <% } %>

        <h2 class="fs-4 mt-3">Chapters Headings</h2>
        
        <table id="toc" class="table" title="<%- `Chapters Headings for ${book.name_en} (فهرس ${book.name})` %>">
          <tbody>
            <%
        function formatHeadingNumber(value) {
          if (value === null || value === undefined || value === '')
            return '';
          return value != Math.floor(value) ? Number(value).toFixed(2) : value;
        }

        function truncateTitle(value, length) {
          if (!value)
            return '';
          var title = value.substring(0, length);
          if (value.length > length)
            title += '&hellip;';
          return title;
        }

        for (var i = 0; i < toc.length; i++) {
          toc[i].h1 = formatHeadingNumber(toc[i].h1);
          toc[i].h2 = formatHeadingNumber(toc[i].h2);
          var title_en = truncateTitle(toc[i].title_en, 75);
          var title = truncateTitle(toc[i].title, 150);
          var sections = Array.isArray(toc[i].sections) ? toc[i].sections : [];
          var hasSections = sections.length > 0;
          var chapterRowId = `toc-chapter-${toc[i].id || i}`;
          %>
            <tr class="chapter" data-toc-chapter="<%= chapterRowId %>">
              <% if (!isQuranToc) { %>
              <td><%- toc[i].start %></td>
              <% } %>
              <td>
                <% if (hasSections) { %>
                <button type="button" class="toc-expand-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" aria-expanded="false" aria-controls="<%= chapterRowId %>" data-toc-toggle="<%= chapterRowId %>" title="Show sections">
                  <span class="toc-expand-icon bi bi-chevron-right"></span>
                </button>
                <% } else { %>
                <span class="toc-expand-spacer"></span>
                <% } %>
                C<%- toc[i].h1 %>
              </td>
              <% if (toc[i].start) { %>
              <td>
                <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center me-1" data-heading-id="<%= toc[i].id %>" title="Bookmark this chapter">
                  <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= toc[i].id %>"></span>
                </button>
                <a href="<%= utils.urlFor(req, `/${toc[i].firstSection ? toc[i].firstSection.path : toc[i].path}`) %>" class="_e" data-id="<%=toc[i].id%>" data-prop="toc.title_en" data-arabizi="true"><%- title_en || 'Chapter' %></a>
              </td>
              <td lang="ar"><a href="<%= utils.urlFor(req, `/${toc[i].firstSection ? toc[i].firstSection.path : toc[i].path}`) %>" class="_e<%= book.alias === 'quran' ? ' quran-surah-name' : '' %>" data-id="<%=toc[i].id%>" data-prop="toc.title"><%- title %></a></td>
              <% } else { %>
              <td>
                <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center me-1" data-heading-id="<%= toc[i].id %>" title="Bookmark this chapter">
                  <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= toc[i].id %>"></span>
                </button>
                <span class="_e" data-id="<%=toc[i].id%>" data-prop="toc.title_en" data-arabizi="true"><%- title_en %></span>
              </td>
              <td lang="ar" class="_e<%= book.alias === 'quran' ? ' quran-surah-name' : '' %>" data-id="<%=toc[i].id%>" data-prop="toc.title"><%- title %></td>
              <% } %>
            </tr>
            <% for (var sectionIndex = 0; sectionIndex < sections.length; sectionIndex++) {
              var section = sections[sectionIndex];
              section.h1 = formatHeadingNumber(section.h1);
              section.h2 = formatHeadingNumber(section.h2);
              var sectionTitleEn = truncateTitle(section.title_en, 75);
              var sectionTitle = truncateTitle(section.title, 150);
            %>
            <tr class="title toc-section-row d-none" data-toc-parent="<%= chapterRowId %>">
              <% if (!isQuranToc) { %>
              <td><%- section.start %></td>
              <% } %>
              <td><span class="toc-section-number">S<%- section.h1 %>.<%- section.h2 %></span></td>
              <% if (section.path) { %>
              <td>
                <a href="<%= utils.urlFor(req, `/${section.path}`) %>" class="_e" data-id="<%=section.id%>" data-prop="toc.title_en" data-arabizi="true"><%- sectionTitleEn || 'Section' %></a>
              </td>
              <td lang="ar"><a href="<%= utils.urlFor(req, `/${section.path}`) %>" class="_e" data-id="<%=section.id%>" data-prop="toc.title"><%- sectionTitle %></a></td>
              <% } else { %>
              <td class="_e" data-id="<%=section.id%>" data-prop="toc.title_en" data-arabizi="true"><%- sectionTitleEn || 'Section' %></td>
              <td lang="ar" class="_e" data-id="<%=section.id%>" data-prop="toc.title"><%- sectionTitle %></td>
              <% } %>
            </tr>
            <% }
        }
        %>
          </tbody>
        </table>
      </section>
      </article>
      
      <aside class="row mt-2 pagination">
        <div class="col-md-6 col-xs-12 text-start">
          <% if (page.prev) { %>
          <a class="pagination-nav-link" href="<%- page.prev %>" rel="prev">&lt;&nbsp;Prev:&nbsp;<%= prevBook.shortName_en %></a>
          <% } %>
        </div>
        <div class="col-md-6 col-xs-12 text-end">
          <% if (page.next) { %>
          <a class="pagination-nav-link" href="<%- page.next %>" rel="next">Next:&nbsp;<%= nextBook.shortName_en %>&nbsp;&gt;</a>
          <% } %>
        </div>
      </aside>
      
    </main>
  </div>
  
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  
</body>

</html>
