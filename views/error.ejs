<!doctype html>
<html lang="en">

<head> 
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = false;
    site.editMode = false;

    var subtitle_en = `Error ${res.statusCode} `;
    var page = {
      menu: 'Error',
      title_en: `${site.shortName} | Error: ${res.statusCode} ${utils.emptyIfNull(message)} `,
      subtitle_en: subtitle_en,
      subtitle: null,
      canonical: '/',
      context: {},
    };
%> 

<%- include('sub-views/head.ejs', { site: site, page: page }); %> 

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %> 

  <div class="container col-lg-8 mx-auto">
    
    <main class="search-results">

      <%- include('sub-views/bookNav.ejs'); %> 

      <div class="row"> 
        <h3><%- res.statusCode %> <%- statusTitle || message %></h3>
        <p><%- friendlyMessage || message %></p>
        <%
          var errorSuggestedPaths = typeof suggestedPaths !== 'undefined' && suggestedPaths
            ? suggestedPaths
            : (typeof suggestedPath !== 'undefined' && suggestedPath ? [suggestedPath] : []);
        %>
        <% if (errorSuggestedPaths.length) { %>
          <p>
            Try
            <% errorSuggestedPaths.forEach(function (suggestedPath, index) { %>
              <a href="<%- suggestedPath %>"><%- suggestedPath %></a><%- index < errorSuggestedPaths.length - 1 ? ' or ' : '' %>
            <% }); %>.
          </p>
        <% } %>
        <% if (message && friendlyMessage && message !== friendlyMessage) { %>
          <p class="text-muted"><small><%- message %></small></p>
        <% } %>
        <% if (res.statusCode >= 500) { %>
          <pre><%- error.stack %></pre>
        <% } %>

      </div>
    </main>
  </div>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

</body>
</html>
