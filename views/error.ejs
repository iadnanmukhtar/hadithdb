<!doctype html>
<html lang="en">

<head> 
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = false;
    site.editMode = false;

    var subtitle_en = typeof errorPageSubtitle === 'string' ? errorPageSubtitle : `Error ${res.statusCode} `;
    var safeStatusTitle = statusTitle || 'Error';
    var safePublicMessage = publicMessage || friendlyMessage || 'An error occurred.';
    var page = {
      menu: 'Error',
      title_en: `Error ${res.statusCode} | ${safeStatusTitle}`,
      subtitle_en: subtitle_en,
      subtitle: null,
      noindex: true,
      nofollow: true,
      canonical: '/',
      context: {},
    };
%> 

<%- include('sub-views/head.ejs', { site: site, page: page }); %> 

</head>

<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %> 

  <main class="container col-lg-8 mx-auto px-4 py-4 ux-system">
    <header class="ux-page-heading"><h1 class="ux-page-title"><%= res.statusCode %> <%= safeStatusTitle %></h1></header>
    <p><%- safePublicMessage %></p>
    <a class="ux-secondary-action" href="/books">Browse the library</a>
  </main>

<%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
<%- include('sub-views/page_end.ejs', { site, page }); %>
<script>
  (function reportErrorToGoogleAnalytics() {
    const statusCode = Number(<%= Number(res.statusCode) || 500 %>);
    const errorRef = <%- JSON.stringify(typeof errorRef === 'string' ? errorRef : '') %>;
    const isServerError = statusCode >= 500;
    if (typeof gtag !== 'function')
      return;
    gtag('event', 'http_error', {
      event_category: 'server_error',
      event_label: errorRef || window.location.pathname,
      status: statusCode,
      ref: errorRef || window.location.pathname,
      fatal: isServerError
    });
  })();
</script>

</body>
</html>
