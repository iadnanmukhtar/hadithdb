<!doctype html>
<html lang="en"><head>
<% var site = Object.assign({}, global.settings.site, { admin: req.admin, editMode: false }); %>
<%- include('sub-views/head.ejs', { site, page }); %>
</head><body>
<%- include('sub-views/header.ejs', { site, page }); %>
<main class="container py-4" id="personal-notebook" data-nosnippet>
  <div class="notebook-layout">
  <section class="notebook-main" aria-label="Private notes">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <h1 class="mb-0">My Notebook</h1>
      <p id="notebook-created-count" class="small text-muted mb-0" aria-live="polite" hidden></p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button id="notebook-new" class="notebook-tool" type="button" title="New note" aria-label="Create a general note"><i class="bi bi-plus-lg" aria-hidden="true"></i><span class="small ms-1">New note</span></button>
      <button class="notebook-tool" type="button" data-bs-toggle="modal" data-bs-target="#notebook-help-modal" title="Notebook help" aria-label="Notebook help"><i class="bi bi-question-circle" aria-hidden="true"></i></button>
      <button id="notebook-download-all" class="notebook-tool" type="button" title="Download notebook as ZIP" aria-label="Download notebook as ZIP" disabled><i class="bi bi-download" aria-hidden="true"></i></button>
    </div>
  </div>
  <div class="small mb-3" data-notebook-drive-panel hidden>
    <%- include('sub-views/notebook_drive_icon.ejs'); %>
    <span data-notebook-drive-message role="status"></span>
    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-notebook-drive-connect hidden>Connect Google Drive</button>
  </div>
  <p id="notebook-signin" class="text-muted mb-3" role="status">Sign-in is required to take notes.</p>
  <p class="small text-muted mb-3">Tip: In addition to creating a general note, you can take notes on hadith, Quran verses, and tafsir using the <i class="bi bi-sticky" aria-hidden="true"></i> note icon beside the content.</p>
  <label class="visually-hidden" for="notebook-search">Search notes</label>
  <input class="form-control mb-3" id="notebook-search" disabled type="search" dir="auto" placeholder="Search all notes by source or text">
  <p id="notebook-list-status" role="status">Loading your notebook…</p>
  <div id="notebook-list"></div>
  <div id="notebook-sentinel" aria-hidden="true" style="height:1px"></div>
  <button class="btn btn-outline-secondary" id="notebook-more" hidden>Retry</button>
  </section>
  <div class="notebook-tag-rail-slot">
  <aside class="notebook-tag-rail" aria-label="Notebook tags">
    <label class="visually-hidden" for="notebook-tag">Filter by tag</label>
    <div class="page-content-filter input-group command-search-filter-find mb-3">
      <span class="input-group-text bi bi-funnel" aria-hidden="true"></span>
      <input class="form-control" id="notebook-tag" disabled type="search" dir="auto" placeholder="Filter by tag">
    </div>
    <div id="notebook-tags" class="nav flex-column"></div>
  </aside>
  </div>
  </div>
</main>
<%- include('sub-views/notebook_help_modal.ejs'); %>
<%- include('sub-views/mobile_navigation.ejs', { site, page }); %>
<%- include('sub-views/footer.ejs', { site, page }); %>
<%- include('sub-views/scripts.ejs', { site, page }); %>
</body></html>
