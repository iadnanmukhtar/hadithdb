<% if (items.length < 1) { %>
  <div class="rag-empty">No similar narrations were found by the chatbot search.</div>
<% } %>

<% for (var i = 0; i < items.length; i++) { 
  var item = items[i];
  var main = true;
%>
  <div class="rag-similar-item" data-match-type="<%= item.matchType || 'rag' %>">
    <% if (item.matchType) { %>
      <div class="rag-match-type"><%= item.matchType === 'linked' ? 'Linked match' : 'Search match' %></div>
    <% } %>
    <% if (!item.doctype || item.doctype == 'hadith') { %>
      <%- include('sub-views/hadith.ejs', { site: site, page: page, i: item, title: true, main: main, searchResult: false, similarSection: true }); %>
    <% } else { %>
      <%- include('sub-views/toc.ejs', { site: site, page: page, toc: item, title: true, main: main, searchResult: false }); %>
    <% } %>
  </div>
<% } %>
