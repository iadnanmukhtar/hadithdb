<!doctype html>
<html lang="en">
<head>
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (!locals.noadmin && req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;

    var tafsirTitle = Tafsir.displayShortName(tafsir, 'en');
    var tafsirPassageTitle = tafsirTitle.replace(/^Tafsir\s+/i, '');
    var tafsirTitleAr = Tafsir.displayShortName(tafsir, 'ar');
	var tafsirPassageTitleAr = tafsirTitleAr.replace(/^تفسير\s+/u, '');
	var tafsirPath = `/quran/tafsir/${encodeURIComponent(tafsir.slug || tafsir.alias)}`;
    var ref = `${surah.num}:${ayah}`;
    var tafsirEntryStart = entries && entries.length ? Math.min.apply(null, entries.map(function (entry) { return Number(entry.startAyah); })) : ayah;
    var tafsirEntryEnd = entries && entries.length ? Math.max.apply(null, entries.map(function (entry) { return Number(entry.endAyah); })) : tafsirEntryStart;
    var tafsirMetaRef = `${surah.num}:${tafsirEntryStart}${tafsirEntryEnd > tafsirEntryStart ? `-${tafsirEntryEnd}` : ''}`;
    var tafsirSectionIdentifier = section && section.h1 && section.h2 ? ` §${section.h1}.${section.h2}` : '';
    var tafsirMetaTitle = `Tafsir ${tafsirPassageTitle}${tafsirSectionIdentifier} | Ayat ${tafsirMetaRef}`;
    var tafsirAuthor = tafsir.author_en || tafsir.author || '';
    var tafsirMetaDescription = `Read ${tafsirTitle}${tafsirAuthor ? ` by ${tafsirAuthor}` : ''} for Quran ${tafsirMetaRef}, Surat ${surah.name_en}, as a dedicated tafsir passage.`;
    var page = {
      menu: 'Section',
      title_en: tafsirMetaTitle,
      description_en: tafsirMetaDescription,
      subtitle_en: tafsirTitle,
      subtitle: tafsirTitleAr,
      canonical: Tafsir.passageUrl(tafsir, surah.num, tafsirEntryStart, tafsirEntryEnd),
      context: {
        book: { alias: 'quran' },
        chapter: chapter,
        section: section,
        quranSearchProxy: true,
        commentaryBook: tafsir,
		quranCommentaryBook: tafsir,
		breadcrumbCatalogName: tafsirPassageTitle,
		breadcrumbCatalogUrl: tafsirPath
      }
    };
    var quranNavigatorSurahs = (global.surahs || []).map(function (surah) {
      return {
        num: Number(surah.num),
        name_en: surah.name_en,
        name_ar: surah.name_ar,
        ayahs: Number(surah.ayahs)
      };
    }).filter(function (surah) {
      return Number.isInteger(surah.num);
    }).sort(function (a, b) {
      return a.num - b.num;
	    });
	    var tafsirPagePath = Tafsir.passageUrl(tafsir, surah.num, tafsirEntryStart, tafsirEntryEnd);
	    var tafsirBookHref = utils.quranUrl(req, tafsirPath);
	    var tafsirSurahHref = utils.quranUrl(req, `${tafsirPath}/${surah.num}`);
	    var tafsirPassageHref = utils.quranUrl(req, tafsirPagePath);
	    var tafsirBookmarkKey = `${tafsir.slug || tafsir.alias}:${surah.num}:${ayah}`;
	    var quranChapter = locals.chapter;
	    var quranSection = locals.section;
	    var quranChapterHref = quranChapter && quranChapter.path ? utils.quranUrl(req, `/${quranChapter.path}`) : utils.quranUrl(req, `/quran/${surah.num}`);
	    var quranSectionHref = quranSection && quranSection.path ? utils.quranUrl(req, `/${quranSection.path}`) : '';
	    var quranChapterTitleEn = (quranChapter && quranChapter.title_en) || `Surat ${surah.name_en}`;
	    var quranChapterTitleAr = (quranChapter && quranChapter.title) || `سورة ${surah.name_ar}`;
	    var quranChapterBreadcrumbLabel = utils.quranSurahBreadcrumbLabel(surah.num, quranChapterTitleEn);
	    var quranChapterBreadcrumbLabelAr = utils.quranSurahBreadcrumbLabelAr(surah.num, quranChapterTitleAr);
	    var quranSurahRevelation = /^mad/i.test((surah.revelation_en || '').toString()) ? 'madani' : 'makki';
	    var quranChapterSurahNameGlyph = !site.editMode ? utils.quranSurahNameLigature(surah.num) : '';
	    var quranAyahModalIndex = ayahs.findIndex(function (item) {
	      return Number(item.ayah) === Number(ayah);
	    });
	    var tafsirReaderNavigation = typeof navigation !== 'undefined' ? navigation : {};
	    var tafsirReaderCurrentUrl = req.originalUrl || req.url || req.path;
	    var tafsirReaderPrevUrl = tafsirReaderNavigation.prev || '';
	    var tafsirReaderNextUrl = tafsirReaderNavigation.next || '';
	    var tafsirReaderPrevTitle = tafsirReaderNavigation.prevTitle ? `Previous: ${tafsirReaderNavigation.prevTitle}` : 'Previous';
	    var tafsirReaderNextTitle = tafsirReaderNavigation.nextTitle ? `Next: ${tafsirReaderNavigation.nextTitle}` : 'Next';
	%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %>
</head>
<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %>

	<div class="container-fluid quran-heading-layout quran-heading-layout-tafsir">
	  <div class="quran-heading-content quran-heading-content-tafsir">
	<main class="chapter mt-10 tafsir-only-page" data-page-help-tour="tafsir" data-reader-infinite="tafsir" data-reader-context-key="<%= surah.num %>" data-reader-quran-ref="<%= surah.num %>:<%= tafsirEntryStart %>" data-reader-current-url="<%= tafsirReaderCurrentUrl %>"<% if (tafsirReaderPrevUrl) { %> data-reader-prev-url="<%= tafsirReaderPrevUrl %>" data-reader-prev-title="<%= tafsirReaderPrevTitle %>"<% } %><% if (tafsirReaderNextUrl) { %> data-reader-next-url="<%= tafsirReaderNextUrl %>" data-reader-next-title="<%= tafsirReaderNextTitle %>"<% } %>>
	      <%- include('sub-views/quran_commentary_book_nav.ejs', {
	        quranCommentaryBook: tafsir,
	        quranCommentaryBooks: tafsirBooks,
	        quranCommentaryPassage: { surah: surah.num, ayah: tafsirEntryStart, endAyah: tafsirEntryEnd },
	        Tafsir: Tafsir
	      }); %>
	      <heading class="row major">
	        <h2 class="col-md-6 col-sm-12 fs-4 title" lang="en"><a href="<%= quranChapterHref %>">
	          <%= surah.num %>. <span<%- quranChapter ? ` class="_e" data-id="${quranChapter.id}" data-prop="toc.title_en" data-arabizi="true"` : '' %>><%- quranChapterTitleEn %></span>
	        </a>
	          <span class="quran-revelation-icon quran-revelation-icon-<%= quranSurahRevelation %>" role="img" aria-label="<%= quranSurahRevelation === 'madani' ? 'Madani' : 'Makki' %>" title="<%= quranSurahRevelation === 'madani' ? 'Madani' : 'Makki' %>"></span>
	          <button type="button" class="tafsir-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center ms-2" data-tafsir-bookmark-key="<%= tafsirBookmarkKey %>" data-bookmark-type="tafsir" data-bookmark-ref="quran:<%= tafsirMetaRef %>" data-bookmark-range="<%= tafsirMetaRef %>" data-bookmark-title="<%= tafsirTitle %>" data-bookmark-title-ar="<%= tafsirTitleAr %>" data-bookmark-url="<%= tafsirPagePath %>" title="Bookmark this tafsīr passage">
	            <span class="tafsir-bookmark-icon bi bi-bookmark text-accent" data-tafsir-bookmark-key="<%= tafsirBookmarkKey %>"></span>
	          </button>
	        </h2>
	        <h2 class="col-md-6 col-sm-12 fs-4 title" lang="ar"><a href="<%= quranChapterHref %>">
	          <%= arabic.toArabicDigits(surah.num + '') %>۔
	          <span<%- quranChapter ? ` class="_e ${quranChapterSurahNameGlyph ? 'quran-surah-name-font' : 'quran-surah-name'}" data-id="${quranChapter.id}" data-prop="toc.title"` : ` class="${quranChapterSurahNameGlyph ? 'quran-surah-name-font' : 'quran-surah-name'}"` %><% if (quranChapterSurahNameGlyph) { %> title="<%= quranChapterTitleAr %>" aria-label="<%= quranChapterTitleAr %>"<% } %>><%- quranChapterSurahNameGlyph || quranChapterTitleAr %></span>
	        </a></h2>
	      </heading>

	      <section class="row breadcrumbs pagination">
	        <div class="col-md-6 col-sm-12" lang="en">
	          <a title="<%- tafsirTitle %>" href="<%= tafsirBookHref %>"><%- tafsirPassageTitle %></a>
	          &gt;
	          <a title="<%- quranChapterTitleEn %>" href="<%= tafsirSurahHref %>"><%= quranChapterBreadcrumbLabel %></a>
	          <% if (quranSection) { %>
	            &gt;
	            <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-heading-id="<%= quranSection.id %>" data-bookmark-type="section" data-bookmark-ref="quran:<%= surah.num %>.<%= quranSection.h2 %>" data-bookmark-title="<%= quranSection.title_en || `Passage ${quranSection.h2}` %>" data-bookmark-title-ar="<%= quranSection.title || '' %>" data-bookmark-url="<%= quranSectionHref %>" title="Bookmark this passage">
	              <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= quranSection.id %>"></span>
	            </button>
	            <a title="<%- quranSection.title || quranSection.title_en || 'Passage' %>" href="<%= tafsirPassageHref %>">Passage <%= quranSection.h2 %></a>
	          <% } %>
	        </div>
	        <div class="col-md-6 col-sm-12" lang="ar">
	          <a title="<%- tafsirTitleAr %>" href="<%= tafsirBookHref %>"><%- tafsirPassageTitleAr %></a>
	          &gt;
	          <a title="<%- quranChapterTitleAr %>" href="<%= tafsirSurahHref %>"><%= quranChapterBreadcrumbLabelAr %></a>
	          <% if (quranSection) { %>
	            &gt;
	            <a title="<%- quranSection.title || quranSection.title_en || 'مقطع' %>" href="<%= tafsirPassageHref %>">مقطع <%= arabic.toArabicDigits(quranSection.h2 + '') %></a>
	          <% } %>
	        </div>
	      </section>

      <%- include('sub-views/quran_commentary_surah_intro.ejs', {
        site: site,
        Tafsir: Tafsir,
        commentaryBook: tafsir,
        heading: locals.commentarySurahHeading,
        surah: surah.num
      }); %>

      <%- include('sub-views/quran_tafsirs.ejs', {
        site: site,
        page: page,
        passage: ayahs,
        selectedAyahs: ayahs,
        selectedTafsirAlias: tafsir.alias,
        selectedTafsirLanguage: tafsir.lang,
        selectedTafsirBook: tafsir,
        initialTafsirEntries: entries,
        tafsirBooks: tafsirBooks,
        tafsirHeading: `${tafsirTitle} ${tafsirMetaRef}${surah.name_en ? ` ${surah.name_en}` : ''}`,
		tafsirHeadingHref: tafsirPassageHref,
        tafsirInstance: 'passage',
        tafsirSettingsHref: utils.quranUrl(req, '/quran/settings'),
        tafsirTranslationsHref: utils.quranUrl(req, `/quran/translations/quran:${surah.num}:${ayah}`),
        tafsirTranslationsModalIndex: quranAyahModalIndex
      }); %>

      <section class="mt-4 reflection-section" data-reflection-section>
        <%- include('sub-views/comment_widget.ejs', {
          widgetId: `tafsir-comments-${ayahs[0] && ayahs[0].id ? ayahs[0].id : `${surah.num}-${tafsirEntryStart}`}`,
		  heading: 'Reflect on this tafsir passage',
          targetId: ayahs[0] && ayahs[0].id,
          ref: ayahs[0] && ayahs[0].ref,
          endpoint: '/comments',
          subjectLabel: 'reflection',
          commentPrefix: `[${tafsirTitle} for Quran ${ref}](${tafsirPagePath})`,
          placeholder: `Write a reflection on Quran ${ref}...`,
          collapsible: true,
          collapsed: true
        }); %>
      </section>

      <%- include('sub-views/quran_ayah_modal.ejs', { site: site, page: page, passage: ayahs, usePassagePageModalLayout: true }); %>

    </main>
	  </div>
	  <%- include('sub-views/quran_heading_toc.ejs', {
	    quranHeadingOutlines: locals.quranHeadingOutlines,
	    quranHeadingInitialSurah: surah.num,
	    quranHeadingInitialAyah: tafsirEntryStart,
	    quranHeadingTafsirBase: tafsirPath,
	    quranHeadingBookShortName: tafsirTitle,
	    commentaryIntroductionArticles: locals.commentaryIntroductionArticles
	  }); %>
  </div>

<%- include('sub-views/mobile_navigation.ejs', {
  site: site,
  page: page,
  prev: tafsirReaderNavigation.prev,
  next: tafsirReaderNavigation.next,
  prevTitle: tafsirReaderPrevTitle,
  nextTitle: tafsirReaderNextTitle,
  helpTour: 'tafsir'
}); %>
<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>

</body>
</html>
