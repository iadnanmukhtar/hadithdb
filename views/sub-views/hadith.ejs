<%
	const en = i.en || {};
	const ar = i.ar || {};
	const isSimilarSection = typeof similarSection !== 'undefined' && similarSection;
%>
<a id="<%= String(i.num || i.num0 || i.id || '').replace(/:/g, '-') %>"></a>
<article class="row mt-3">

	<% if (site.editMode) { %>
		<header class="col-12" lang="ar">
			<h4 class="fs-5" title="Ḥadīth Group"><strong>مجموعة: <span class="_e" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.part"><%- i.part || `&hellip;` %></span></strong></h4>
		</header>
	<% } %>

	<%# Title  ............................................................. %>
	<% if (en.title || site.editMode) { %>
		<header class="col-12" lang="en">
			<h1 lang="en" class="_e fs-5" title="Ḥadīth Title" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.title_en" data-arabizi="true"><%- en.title || `&hellip;` %></h4>
		</header>
	<% } %>
	<% if (ar.title || site.editMode) { %>
		<header class="col-12" lang="ar">
			<h1 lang="ar" class="_e fs-5" title="ذكر الحديث" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.title"><strong><%- ar.title || `&hellip;` %></strong></h4>
		</header>
	<% } %>

	<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: 'en', main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection }); %>

	<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: 'ar', main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection }); %>

	<% if (i.single) { %>
		<%- include('comment_widget.ejs', {
			widgetId: 'comments',
			heading: 'Add your own reflection below:',
			targetId: i.actual ? i.actual.id : i.id,
			ref: i.ref,
			endpoint: '/comments',
			pingUrl: `/do/${i.actual ? i.actual.id : i.id}?cmd=comment`,
			subjectLabel: 'reflection'
		}); %>
	<% } %>

</article>

<%- include('hadith_modal.ejs', { site: site, page: page, i: i }); %>
