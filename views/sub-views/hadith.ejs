<%
	const en = i.en || {};
	const ar = i.ar || {};
	const isSimilarSection = typeof similarSection !== 'undefined' && similarSection;
	const isQuranItem = i.remark == 2 || i.book_alias === 'quran' || (i.actual && i.actual.book_alias === 'quran');
	const paymentFeatureEnabled = locals.paymentFeatureEnabled === true;
	const enableHadithContentLanguage = paymentFeatureEnabled && !site.editMode && !isQuranItem;
	const enableHadithContentTranslation = enableHadithContentLanguage && !isSimilarSection;
	const contentTranslationItemId = i.actual ? i.actual.id : i.id;
	const contentTranslationSourceFields = {
		title: utils.emptyIfNull(ar.title) || utils.emptyIfNull(en.title),
		chain: utils.emptyIfNull(ar.chain) || utils.emptyIfNull(en.chain),
		body: utils.emptyIfNull(ar.body) || utils.emptyIfNull(ar.text) || utils.emptyIfNull(en.body) || utils.emptyIfNull(en.text),
		footnote: utils.emptyIfNull(ar.footnote) || utils.emptyIfNull(en.footnote)
	};
	const contentTranslationEstimate = enableHadithContentTranslation && locals.contentTranslationEstimateFields
		? locals.contentTranslationEstimateFields(contentTranslationSourceFields, 'translate')
		: { points: 0, wordCount: 0 };
%>
<a id="<%= String(i.num || i.num0 || i.id || '').replace(/:/g, '-') %>"></a>
<article class="row mt-3<%= isQuranItem ? ' quran-search-item' : '' %>"<%- isSimilarSection && i.similarCandidate ? ' data-similar-candidate="true"' : '' %><% if (enableHadithContentLanguage) { %> data-content-translation-scope="hadith" data-content-translation-item-id="<%= contentTranslationItemId %>"<% if (isSimilarSection) { %> data-content-translation-auto-only="true"<% } %><% if (enableHadithContentTranslation) { %> data-content-translation-points="<%= contentTranslationEstimate.points %>" data-content-translation-word-count="<%= contentTranslationEstimate.wordCount %>"<% } %><% } %>>

	<% if (site.editMode) { %>
		<header class="col-12" lang="ar">
			<h4 class="fs-5" title="Ḥadīth Group"><strong>مجموعة: <span class="_e" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.part"><%- i.part || `&hellip;` %></span></strong></h4>
		</header>
	<% } %>

	<%# Title  ............................................................. %>
	<% if (site.editMode && Array.isArray(i.contentTranslations) && i.contentTranslations.length) { %>
		<div class="col-12 admin-content-translation-switcher content-translation-language-switcher mb-2" lang="en" dir="ltr">
			<label class="visually-hidden" for="admin-content-translation-<%= i.actual ? i.actual.id : i.id %>">Translation language</label>
			<select id="admin-content-translation-<%= i.actual ? i.actual.id : i.id %>" class="form-select form-select-sm content-translation-language-select" data-admin-content-translation-select="1" aria-label="Translation language">
				<option value="en" selected>EN</option>
				<% i.contentTranslations.forEach(function (translation) { %>
					<% if (translation && translation.code) { %>
						<option value="<%= translation.code %>"><%= translation.label || translation.code.toUpperCase() %></option>
					<% } %>
				<% }); %>
			</select>
		</div>
		<div class="admin-content-translation-panel" data-admin-content-translation-panel="en">
			<% if (en.title || site.editMode) { %>
				<header class="col-12" lang="en">
					<h1 lang="en" class="_e fs-5" title="Ḥadīth Title" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.title_en" data-arabizi="true"><%- en.title || `&hellip;` %></h4>
				</header>
			<% } %>
		</div>
		<% i.contentTranslations.forEach(function (translation) { %>
			<% if (translation && translation.code) { %>
				<div class="admin-content-translation-panel d-none" data-admin-content-translation-panel="<%= translation.code %>">
					<% if (translation.title || site.editMode) { %>
						<header class="col-12<%= translation.fontClass ? ` ${translation.fontClass}` : '' %>" lang="<%= translation.code %>" dir="<%= translation.dir || 'ltr' %>" data-content-language="<%= translation.code %>"<% if (translation.fontClass) { %> data-content-language-font-class="<%= translation.fontClass %>"<% } %>>
							<h1 lang="<%= translation.code %>" dir="<%= translation.dir || 'ltr' %>" data-content-language="<%= translation.code %>"<% if (translation.fontClass) { %> data-content-language-font-class="<%= translation.fontClass %>"<% } %> class="_e fs-5<%= translation.fontClass ? ` ${translation.fontClass}` : '' %>" title="Ḥadīth Title (<%= translation.label || translation.code.toUpperCase() %>)" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="content_translation.<%= translation.code %>.title" data-arabizi="false"><%- translation.title || `&hellip;` %></h1>
						</header>
					<% } %>
				</div>
			<% } %>
		<% }); %>
	<% } else { %>
		<% if (en.title || site.editMode) { %>
			<header class="col-12" lang="en">
				<h1 lang="en" class="_e fs-5" title="Ḥadīth Title" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.title_en" data-arabizi="true"<% if (enableHadithContentLanguage) { %> data-content-translation-field="title"<% } %>><%- en.title || `&hellip;` %></h4>
			</header>
		<% } %>
	<% } %>
	<% if (ar.title || site.editMode) { %>
		<header class="col-12" lang="ar">
			<h1 lang="ar" class="_e fs-5" title="ذكر الحديث" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.title"><strong><%- ar.title || `&hellip;` %></strong></h4>
		</header>
	<% } %>

	<% if (site.editMode && Array.isArray(i.contentTranslations) && i.contentTranslations.length) { %>
		<div class="admin-content-translation-panel" data-admin-content-translation-panel="en">
			<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: 'en', main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection }); %>
		</div>
		<% i.contentTranslations.forEach(function (translation) { %>
			<% if (translation && translation.code) { %>
				<div class="admin-content-translation-panel d-none" data-admin-content-translation-panel="<%= translation.code %>">
					<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: translation.code, main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection }); %>
				</div>
			<% } %>
		<% }); %>
	<% } else { %>
		<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: 'en', main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection }); %>
	<% } %>

	<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: 'ar', main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection }); %>

	<% if (i.single) { %>
		<%- include('comment_widget.ejs', {
			widgetId: 'comments',
			heading: 'Add your own reflection below:',
			targetId: i.actual ? i.actual.id : i.id,
			ref: i.ref,
			endpoint: '/comments',
			subjectLabel: 'reflection'
		}); %>
	<% } %>

</article>

<%- include('hadith_modal.ejs', { site: site, page: page, i: i }); %>
