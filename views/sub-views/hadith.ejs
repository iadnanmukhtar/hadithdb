<%
	const en = i.en || {};
	const ar = i.ar || {};
	const isSimilarSection = typeof similarSection !== 'undefined' && similarSection;
	const isQuranItem = i.remark == 2 || i.book_alias === 'quran' || (i.actual && i.actual.book_alias === 'quran');
	const paymentFeatureEnabled = locals.paymentFeatureEnabled === true;
	const enableHadithContentTranslation = paymentFeatureEnabled && !site.editMode && !isQuranItem && !isSimilarSection;
	const contentTranslationItemId = i.actual ? i.actual.id : i.id;
	const contentTranslationSourceFields = {
		title: utils.emptyIfNull(ar.title) || utils.emptyIfNull(en.title),
		chain: utils.emptyIfNull(ar.chain) || utils.emptyIfNull(en.chain),
		body: utils.emptyIfNull(ar.body) || utils.emptyIfNull(ar.text) || utils.emptyIfNull(en.body) || utils.emptyIfNull(en.text),
		footnote: utils.emptyIfNull(ar.footnote) || utils.emptyIfNull(en.footnote)
	};
	const contentTranslationEstimate = enableHadithContentTranslation && locals.contentTranslationEstimateFields
		? locals.contentTranslationEstimateFields(contentTranslationSourceFields, 'translate')
		: { points: 0, wordCount: 0 };
%>
<a id="<%= String(i.num || i.num0 || i.id || '').replace(/:/g, '-') %>"></a>
<article class="row mt-3<%= isQuranItem ? ' quran-search-item' : '' %>"<%- isSimilarSection && i.similarCandidate ? ' data-similar-candidate="true"' : '' %><% if (enableHadithContentTranslation) { %> data-content-translation-scope="hadith" data-content-translation-item-id="<%= contentTranslationItemId %>" data-content-translation-points="<%= contentTranslationEstimate.points %>" data-content-translation-word-count="<%= contentTranslationEstimate.wordCount %>"<% } %>>

	<% if (site.editMode) { %>
		<header class="col-12" lang="ar">
			<h4 class="fs-5" title="Ḥadīth Group"><strong>مجموعة: <span class="_e" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.part"><%- i.part || `&hellip;` %></span></strong></h4>
		</header>
	<% } %>

	<%# Title  ............................................................. %>
	<% if (en.title || site.editMode) { %>
		<header class="col-12" lang="en">
			<h1 lang="en" class="_e fs-5" title="Ḥadīth Title" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.title_en" data-arabizi="true"<% if (enableHadithContentTranslation) { %> data-content-translation-field="title"<% } %>><%- en.title || `&hellip;` %></h4>
		</header>
	<% } %>
	<% if (ar.title || site.editMode) { %>
		<header class="col-12" lang="ar">
			<h1 lang="ar" class="_e fs-5" title="ذكر الحديث" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.title"><strong><%- ar.title || `&hellip;` %></strong></h4>
		</header>
	<% } %>

	<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: 'en', main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection }); %>

	<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: 'ar', main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection }); %>

	<% if (i.single) { %>
		<%- include('comment_widget.ejs', {
			widgetId: 'comments',
			heading: 'Add your own reflection below:',
			targetId: i.actual ? i.actual.id : i.id,
			ref: i.ref,
			endpoint: '/comments',
			subjectLabel: 'reflection'
		}); %>
	<% } %>

</article>

<%- include('hadith_modal.ejs', { site: site, page: page, i: i }); %>
