<%
	const en = i.en || {};
	const ar = i.ar || {};
	const isSimilarSection = typeof similarSection !== 'undefined' && similarSection;
	const isQuranItem = i.remark == 2 || i.book_alias === 'quran' || (i.actual && i.actual.book_alias === 'quran');
	const paymentFeatureEnabled = locals.paymentFeatureEnabled === true;
	const isContentTranslationBrowse = typeof contentTranslationBrowse !== 'undefined' && contentTranslationBrowse;
	const enableHadithContentLanguage = paymentFeatureEnabled && !site.editMode && !isQuranItem;
	const enableHadithContentTranslation = enableHadithContentLanguage && !isSimilarSection;
	const contentTranslationItemId = i.actual ? i.actual.id : i.id;
	const contentTranslationSourceFields = {
		title: utils.emptyIfNull(ar.title) || utils.emptyIfNull(en.title),
		chain: utils.emptyIfNull(ar.chain) || utils.emptyIfNull(en.chain),
		body: utils.emptyIfNull(ar.body) || utils.emptyIfNull(ar.text) || utils.emptyIfNull(en.body) || utils.emptyIfNull(en.text),
		footnote: utils.emptyIfNull(ar.footnote) || utils.emptyIfNull(en.footnote)
	};
	const contentTranslationEstimate = enableHadithContentTranslation && locals.contentTranslationEstimateFields
		? locals.contentTranslationEstimateFields(contentTranslationSourceFields, 'translate')
		: { points: 0, wordCount: 0 };
	function editClass(classes) {
		return `${site.editMode ? '_e ' : ''}${classes || ''}`.trim();
	}
%>
<a id="<%= String(i.num || i.num0 || i.id || '').replace(/:/g, '-') %>"></a>
<article class="row mt-3<%= isQuranItem ? ' quran-search-item' : ' hadith-language-item' %>"<% if (!isQuranItem) { %> data-reader-language-item="hadith"<% } %><%- isSimilarSection && i.similarCandidate ? ' data-similar-candidate="true"' : '' %><% if (enableHadithContentLanguage) { %> data-content-translation-scope="hadith" data-content-translation-item-id="<%= contentTranslationItemId %>"<% if (isSimilarSection) { %> data-content-translation-auto-only="true"<% } %><% if (enableHadithContentTranslation) { %> data-content-translation-points="<%= contentTranslationEstimate.points %>" data-content-translation-word-count="<%= contentTranslationEstimate.wordCount %>"<% } %><% } %>>

	<% if (site.editMode) { %>
		<header class="col-12" lang="ar">
			<h4 class="fs-5" title="Ḥadīth Group"><strong>مجموعة: <span class="_e" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.part"><%- i.part || `&hellip;` %></span></strong></h4>
		</header>
	<% } %>

	<%# Title  ............................................................. %>
	<% if (site.editMode && Array.isArray(i.contentTranslations) && i.contentTranslations.length) { %>
		<div class="admin-content-translation-panel" data-admin-content-translation-panel="en">
			<% if (en.title || site.editMode) { %>
				<header class="col-12" lang="en" data-reader-language-column="english">
					<h1 lang="en" class="_e fs-5" title="Ḥadīth Title" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.title_en" data-arabizi="true"><%- en.title || `&hellip;` %></h4>
				</header>
			<% } %>
		</div>
		<% i.contentTranslations.forEach(function (translation) { %>
			<% if (translation && translation.code) { %>
				<div class="admin-content-translation-panel d-none" data-admin-content-translation-panel="<%= translation.code %>">
					<% if (translation.title || site.editMode) { %>
						<header class="col-12<%= translation.fontClass ? ` ${translation.fontClass}` : '' %>" lang="<%= translation.code %>" dir="<%= translation.dir || 'ltr' %>" data-reader-language-column="english" data-content-language="<%= translation.code %>"<% if (translation.fontClass) { %> data-content-language-font-class="<%= translation.fontClass %>"<% } %>>
							<h1 lang="<%= translation.code %>" dir="<%= translation.dir || 'ltr' %>" data-content-language="<%= translation.code %>"<% if (translation.fontClass) { %> data-content-language-font-class="<%= translation.fontClass %>"<% } %> class="_e fs-5<%= translation.fontClass ? ` ${translation.fontClass}` : '' %>" title="Ḥadīth Title (<%= translation.label || translation.code.toUpperCase() %>)" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="content_translation.<%= translation.code %>.title" data-arabizi="false"><%- translation.title || `&hellip;` %></h1>
						</header>
					<% } %>
				</div>
			<% } %>
		<% }); %>
	<% } else { %>
		<% if (en.title || site.editMode) { %>
			<header class="col-12" lang="en" data-reader-language-column="english">
				<h1 lang="en" class="<%= editClass('fs-5') %>" title="Ḥadīth Title"<% if (site.editMode) { %> data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.title_en" data-arabizi="true"<% } %><% if (enableHadithContentLanguage) { %> data-content-translation-field="title"<% } %>><%- en.title || `&hellip;` %></h4>
			</header>
		<% } %>
	<% } %>
	<% if (ar.title || site.editMode) { %>
		<header class="col-12" lang="ar" data-reader-language-column="arabic">
			<h1 lang="ar" class="<%= editClass('fs-5') %>" title="ذكر الحديث"<% if (site.editMode) { %> data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.title"<% } %>><strong><%- ar.title || `&hellip;` %></strong></h4>
		</header>
	<% } %>

	<% if (site.editMode && Array.isArray(i.contentTranslations) && i.contentTranslations.length) { %>
		<div class="admin-content-translation-panel" data-admin-content-translation-panel="en">
			<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: 'en', main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection, adminContentTranslationOptions: i.contentTranslations, adminContentTranslationSelected: 'en', adminContentTranslationItemId: contentTranslationItemId }); %>
		</div>
		<% i.contentTranslations.forEach(function (translation) { %>
			<% if (translation && translation.code) { %>
				<div class="admin-content-translation-panel d-none" data-admin-content-translation-panel="<%= translation.code %>">
					<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: translation.code, main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection, adminContentTranslationOptions: i.contentTranslations, adminContentTranslationSelected: translation.code, adminContentTranslationItemId: contentTranslationItemId }); %>
				</div>
			<% } %>
		<% }); %>
	<% } else { %>
		<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: 'en', main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection, contentTranslationBrowse: isContentTranslationBrowse }); %>
	<% } %>

	<%- include('hadith_item.ejs', { site: site, page: page, i: i, lang: 'ar', main: main, title: title, searchResult: searchResult, similarSection: isSimilarSection, contentTranslationBrowse: isContentTranslationBrowse }); %>

	<% if (i.single) { %>
		<% const reflectionMetadataBase = `hadith-metadata-${i.actual ? i.actual.id : i.id}`; %>
		<section class="mt-4 reflection-section col-12" id="<%= reflectionMetadataBase %>-reflection" data-reflection-section data-toc-heading-target data-toc-heading-key="reflection">
			<%- include('comment_widget.ejs', {
				widgetId: 'comments',
				heading: 'Reflect on this hadith',
				targetId: i.actual ? i.actual.id : i.id,
				ref: i.ref,
				endpoint: '/comments',
				subjectLabel: 'reflection',
				placeholder: 'Write a reflection on this Hadith...',
				collapsible: true,
				collapsed: true
			}); %>
		</section>
	<% } %>

	<% if (i.single) { %>
		<%- include('hadith_metadata.ejs', { i: i }); %>
	<% } %>

</article>

<%- include('hadith_modal.ejs', { site: site, page: page, i: i }); %>
