<aside class="modal fade quran-memorize-review-modal" id="quran-memorize-review-modal" tabindex="-1" aria-labelledby="quran-memorize-review-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" data-quran-memorize-review-form>
      <header class="modal-header">
        <h2 class="modal-title fs-5" id="quran-memorize-review-title">Start Review</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </header>
      <div class="modal-body">
        <div data-quran-review-start-context>
          <p class="mb-1 fw-bold">Starting from <span data-quran-review-start-label></span></p>
          <p class="small text-muted mb-0" data-quran-review-start-description></p>
        </div>
        <div class="mt-3" data-quran-review-surah-fields hidden>
          <label class="form-label fw-bold" for="quran-review-surah-input">Surah</label>
          <input type="search" class="form-control" id="quran-review-surah-input" data-quran-review-surah-input placeholder="Type a surah name or number" aria-label="Choose a surah by English name, Arabic name, or number" autocomplete="off" autocapitalize="none" spellcheck="false">
          <input type="hidden" data-quran-review-surah-number>
        </div>
        <fieldset class="mt-3" data-quran-memorize-review-duration-fields>
          <legend class="form-label fw-bold">How much would you like to review?</legend>
          <div class="quran-memorize-review-scope">
            <label><input class="form-check-input" type="radio" name="quran-memorize-review-duration" value="scope" checked> <span><strong data-quran-memorize-review-scope-end>Until this page is complete</strong><small>End review after this selected scope</small></span></label>
            <label><input class="form-check-input" type="radio" name="quran-memorize-review-duration" value="session"> <span><strong>Until I end the session</strong><small data-quran-memorize-review-continue-label>Continue into following pages as you reach them</small></span></label>
          </div>
        </fieldset>
        <fieldset class="mt-3">
          <legend class="form-label fw-bold">How would you like to review?</legend>
          <div class="quran-memorize-review-scope">
            <label><input class="form-check-input" type="radio" name="quran-review-unit" value="ayah" checked> <span><strong>Āyah by āyah</strong><small>Reveal and grade each āyah separately</small></span></label>
            <label><input class="form-check-input" type="radio" name="quran-review-unit" value="passage"> <span><strong>Passage by passage</strong><small>Reveal and grade each Study passage as one unit</small></span></label>
          </div>
        </fieldset>
        <p class="small text-muted mt-3 mb-0">Untouched āyāt are enrolled as Learning when reached. Already enrolled āyāt keep their current state and schedule.</p>
        <p class="small text-muted mt-2 mb-0" data-quran-memorize-review-status role="status" aria-live="polite"></p>
      </div>
      <footer class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" data-quran-memorize-review-submit>Start Review</button>
      </footer>
      <script type="application/json" data-quran-review-surah-catalog><%- JSON.stringify((global.surahs || []).map(function (surah) { return { number: Number(surah.num), english: surah.name_en || '', arabic: surah.name_ar || '', aliases: surah.aliases || [], ayahs: Number(surah.ayahs) || 0 }; })).replace(/</g, '\\u003c') %></script>
    </form>
  </div>
</aside>
