<%
  var quranSubsections = (locals.quranSubsections || []).map(function (heading) {
    var startAyah = parseInt(arabic.toLatinDigits((heading.start || '').toString().split(/:/).pop()), 10);
    var count = parseInt(heading.count, 10);
    heading._startAyah = startAyah;
    heading._endAyah = Number.isInteger(count) && count > 0 ? startAyah + count - 1 : startAyah;
    return heading;
  }).filter(function (heading) {
    return Number.isInteger(heading._startAyah);
  }).sort(function (a, b) {
    if (a._startAyah !== b._startAyah)
      return a._startAyah - b._startAyah;
    return (a.h3 || 0) - (b.h3 || 0);
  });
  quranSubsections.forEach(function (heading, index) {
    var next = quranSubsections[index + 1];
    heading.hasNextQuranSubsection = !!next && Number(next.h2) === Number(heading.h2);
  });

  function ayahNumber(item) {
    var num = (item.en && item.en.num) || item.num || '';
    return parseInt(arabic.toLatinDigits((num || '').toString().split(/:/).pop()), 10);
  }

  var quranGroups = [];
  if (quranSubsections.length > 0) {
    var cursor = 0;
    for (var s = 0; s < quranSubsections.length; s++) {
      var heading = quranSubsections[s];
      var startIndex = passage.findIndex(function (item) {
        return ayahNumber(item) >= heading._startAyah;
      });
      if (startIndex < 0)
        continue;
      var endIndex = passage.findIndex(function (item) {
        return ayahNumber(item) > heading._endAyah;
      });
      if (endIndex < 0)
        endIndex = passage.length;
      if (startIndex > cursor) {
        quranGroups.push({
          passage: passage.slice(cursor, startIndex),
          quranSubsections: []
        });
      }
      if (endIndex > startIndex) {
        quranGroups.push({
          passage: passage.slice(startIndex, endIndex),
          quranSubsections: [heading]
        });
      }
      cursor = Math.max(cursor, endIndex);
    }
    if (cursor < passage.length) {
      quranGroups.push({
        passage: passage.slice(cursor),
        quranSubsections: []
      });
    }
  }
  if (quranGroups.length < 1) {
    quranGroups = [{
      passage: passage,
      quranSubsections: quranSubsections
    }];
  }
  var quranAyahModalItems = locals.quranAyahModalItems || passage;
  var quranSelectionSurah = passage[0] ? ((passage[0].en && passage[0].en.num) || passage[0].num || '').toString().split(/:/)[0] : '';
  var quranHasSelectedAyahHero = locals.selectedAyahs && locals.selectedAyahs.length > 0;
  var quranSelectedAyahClearHref = quranHasSelectedAyahHero && page.context.section ? utils.quranUrl(req, `/${page.context.section.path}`) : '';
  quranGroups.forEach(function (group, index) {
    var groupAudioAyahs = group.passage.map(ayahNumber).filter(function (num) {
      return Number.isInteger(num) && num > 0;
    });
    group._audioStartAyah = groupAudioAyahs.length > 0 ? groupAudioAyahs[0] : NaN;
    group._audioEndAyah = groupAudioAyahs.length > 0 ? groupAudioAyahs[groupAudioAyahs.length - 1] : NaN;
    group._hasSubsection = group.quranSubsections && group.quranSubsections.length > 0;
    group._hasHeadingAudio = (group._hasSubsection || quranSubsections.length < 1) && Number.isInteger(group._audioStartAyah) && Number.isInteger(group._audioEndAyah);
    group._headingAudioLabel = group._hasSubsection ? 'subsection' : 'section';
    group._audioScopeId = group._hasHeadingAudio ? `quran-audio-${index}` : '';
  });
  var quranInlineAudioGroup = quranGroups[0] && quranGroups[0]._hasHeadingAudio ? quranGroups[0] : null;
%>

<% if (passage.length > 0 && quranSelectionSurah) { %>
<aside class="quran-ayah-select-toolbar mb-2<%= quranHasSelectedAyahHero ? ' has-selected-ayah-hero' : '' %>" data-surah="<%= quranSelectionSurah %>">
  <label class="quran-passage-translation-control mb-0">
    <span class="visually-hidden">Translation</span>
    <span class="bi bi-translate quran-passage-translation-icon" aria-hidden="true"></span>
    <select class="form-select form-select-sm quran-passage-translation-select" data-quran-passage-translation-select="1" aria-label="Translation">
      <option value="">Haleem</option>
    </select>
  </label>
  <div class="btn-group btn-group-sm quran-passage-display-toggle" role="group" aria-label="Quran passage display">
    <button type="button" class="btn btn-outline-secondary quran-ayah-select-btn quran-passage-display-btn is-active" data-quran-passage-display-toggle="translation" aria-pressed="true" title="Show translation" aria-label="Show translation">
      <span class="bi bi-translate"></span>
    </button>
    <button type="button" class="btn btn-outline-secondary quran-ayah-select-btn quran-passage-display-btn is-active" data-quran-passage-display-toggle="arabic" aria-pressed="true" title="Show Quran Arabic" aria-label="Show Quran Arabic">
      <span class="bi bi-journal-text"></span>
    </button>
  </div>
  <% if (passage.length > 1) { %>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn quran-ayah-select-toggle"<% if (quranHasSelectedAyahHero) { %> hidden<% } %>>
    <span class="bi bi-check2-square"></span> Select ayat
  </button>
  <button type="button" class="btn btn-sm btn-primary quran-ayah-select-btn quran-ayah-select-open" disabled hidden>
    <span class="bi bi-eye"></span> View selected
  </button>
  <% if (quranSelectedAyahClearHref) { %>
  <a class="btn btn-sm btn-outline-secondary quran-ayah-select-btn quran-ayah-select-clear" href="<%= quranSelectedAyahClearHref %>"<% if (!quranHasSelectedAyahHero) { %> hidden<% } %>>
    <span class="bi bi-x-circle"></span> Clear
  </a>
  <% } else { %>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn quran-ayah-select-clear" disabled hidden>
    <span class="bi bi-x-circle"></span> Clear
  </button>
  <% } %>
  <span class="quran-ayah-select-live small text-muted"></span>
  <% } %>
  <% if (quranInlineAudioGroup) { %>
  <%- include('quran_audio_control.ejs', { audioGroup: quranInlineAudioGroup, quranSelectionSurah: quranSelectionSurah, audioControlClass: 'ms-md-auto d-none d-md-inline-flex' }); %>
  <% } %>
</aside>
<% } %>

<% quranGroups.forEach(function (group) {
  if (!group.passage || group.passage.length < 1)
    return;
  var groupStartAyah = ayahNumber(group.passage[0]);
  var groupEndAyah = ayahNumber(group.passage[group.passage.length - 1]);
  var sectionHeading = page.context.section;
  var canMakeSubsection = site.editMode && sectionHeading && Number(sectionHeading.level) === 2 && (!group.quranSubsections || group.quranSubsections.length < 1) && Number.isInteger(groupStartAyah) && Number.isInteger(groupEndAyah);
  var renderHeadingAudioRow = group._hasHeadingAudio && group !== quranInlineAudioGroup;
%>
<% if (canMakeSubsection) { %>
<aside class="quran-subsection-admin mb-2" data-heading-id="<%= sectionHeading.id %>" data-section-path="/<%= sectionHeading.path %>">
  <div class="d-flex flex-wrap align-items-end gap-2">
    <label class="form-label mb-0 small">
      Unsectioned start
      <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm quran-subsection-start" value="<%= groupStartAyah %>">
    </label>
    <label class="form-label mb-0 small">
      End
      <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm quran-subsection-end" value="<%= groupEndAyah %>">
    </label>
    <label class="form-label mb-0 small quran-subsection-title-wrap">
      Title
      <input type="text" class="form-control form-control-sm quran-subsection-title" value="">
    </label>
    <button type="button" class="btn btn-sm btn-outline-primary quran-subsection-add" data-loading-label="Adding">
      <span class="bi bi-plus-circle"></span> Make subsection
    </button>
  </div>
</aside>
<% } %>
<% if (renderHeadingAudioRow) { %>
<aside class="row quran-heading-audio-toolbar quran-desktop-audio-toolbar mb-1 d-none d-md-flex">
  <div class="col-md-6 col-sm-12 ms-md-auto d-flex justify-content-md-end">
    <%- include('quran_audio_control.ejs', { audioGroup: group, quranSelectionSurah: quranSelectionSurah }); %>
  </div>
</aside>
<% } %>
<article class="row quran-passage-section"<%- group._audioScopeId ? ` data-quran-audio-scope="${group._audioScopeId}"` : '' %>>

<%- include('quran_item.ejs', { site: site, page: page, passage: group.passage, selectedAyah: locals.selectedAyah, selectedAyahs: locals.selectedAyahs, quranSubsections: group.quranSubsections, quranAyahModalItems: quranAyahModalItems, quranShareId: locals.quranShareId, lang: 'en', main: main, title: title, searchResult: searchResult }); %>

<% if (group._hasHeadingAudio) { %>
<aside class="col-12 quran-mobile-audio-toolbar d-md-none">
  <%- include('quran_audio_control.ejs', { audioGroup: group, quranSelectionSurah: quranSelectionSurah, audioControlClass: 'quran-mobile-audio-control' }); %>
</aside>
<% } %>

<%- include('quran_item.ejs', { site: site, page: page, passage: group.passage, selectedAyah: locals.selectedAyah, selectedAyahs: locals.selectedAyahs, quranSubsections: group.quranSubsections, quranAyahModalItems: quranAyahModalItems, quranShareId: locals.quranShareId, lang: 'ar', main: main, title: title, searchResult: searchResult }); %>

<section class="col-12 quran-preferred-translation-footnotes d-none" lang="en" data-quran-selected-translation-footnotes="1"></section>

</article>
<% }); %>

<% if (locals.quranShareId && (!locals.selectedAyahs || locals.selectedAyahs.length <= 1)) { %>
<%- include('quran_modal.ejs', { site: site, page: page, selectedAyahs: locals.selectedAyahs, quranShareId: locals.quranShareId }); %>
<% } %>
