<%
  var quranSubsections = (locals.quranSubsections || []).map(function (heading) {
    var startAyah = parseInt(arabic.toLatinDigits((heading.start || '').toString().split(/:/).pop()), 10);
    var count = parseInt(heading.count, 10);
    heading._startAyah = startAyah;
    heading._endAyah = Number.isInteger(count) && count > 0 ? startAyah + count - 1 : startAyah;
    return heading;
  }).filter(function (heading) {
    return Number.isInteger(heading._startAyah);
  }).sort(function (a, b) {
    if (a._startAyah !== b._startAyah)
      return a._startAyah - b._startAyah;
    return (a.h3 || 0) - (b.h3 || 0);
  });

  function ayahNumber(item) {
    var num = (item.en && item.en.num) || item.num || '';
    return parseInt(arabic.toLatinDigits((num || '').toString().split(/:/).pop()), 10);
  }

  var quranGroups = [];
  if (quranSubsections.length > 0) {
    var cursor = 0;
    for (var s = 0; s < quranSubsections.length; s++) {
      var heading = quranSubsections[s];
      var startIndex = passage.findIndex(function (item) {
        return ayahNumber(item) >= heading._startAyah;
      });
      if (startIndex < 0)
        continue;
      var endIndex = passage.findIndex(function (item) {
        return ayahNumber(item) > heading._endAyah;
      });
      if (endIndex < 0)
        endIndex = passage.length;
      if (startIndex > cursor) {
        quranGroups.push({
          passage: passage.slice(cursor, startIndex),
          quranSubsections: []
        });
      }
      if (endIndex > startIndex) {
        quranGroups.push({
          passage: passage.slice(startIndex, endIndex),
          quranSubsections: [heading]
        });
      }
      cursor = Math.max(cursor, endIndex);
    }
    if (cursor < passage.length) {
      quranGroups.push({
        passage: passage.slice(cursor),
        quranSubsections: []
      });
    }
  }
  if (quranGroups.length < 1) {
    quranGroups = [{
      passage: passage,
      quranSubsections: quranSubsections
    }];
  }
  var quranSelectionSurah = passage[0] ? ((passage[0].en && passage[0].en.num) || passage[0].num || '').toString().split(/:/)[0] : '';
%>

<% if (passage.length > 1 && quranSelectionSurah) { %>
<aside class="quran-ayah-select-toolbar mb-2" data-surah="<%= quranSelectionSurah %>">
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn quran-ayah-select-toggle">
    <span class="bi bi-check2-square"></span> Select ayat
  </button>
  <button type="button" class="btn btn-sm btn-primary quran-ayah-select-btn quran-ayah-select-open" disabled>
    <span class="bi bi-eye"></span> View selected
  </button>
  <% if (locals.selectedAyahs && locals.selectedAyahs.length > 0 && page.context.section) { %>
  <a class="btn btn-sm btn-outline-secondary quran-ayah-select-btn quran-ayah-select-clear" href="/<%= page.context.section.path %>">
    <span class="bi bi-x-circle"></span> Clear
  </a>
  <% } else { %>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn quran-ayah-select-clear" disabled>
    <span class="bi bi-x-circle"></span> Clear
  </button>
  <% } %>
  <span class="quran-ayah-select-live small text-muted"></span>
</aside>
<% } %>

<% quranGroups.forEach(function (group) {
  if (!group.passage || group.passage.length < 1)
    return;
  var groupStartAyah = ayahNumber(group.passage[0]);
  var groupEndAyah = ayahNumber(group.passage[group.passage.length - 1]);
  var sectionHeading = page.context.section;
  var canMakeSubsection = site.editMode && sectionHeading && Number(sectionHeading.level) === 2 && (!group.quranSubsections || group.quranSubsections.length < 1) && Number.isInteger(groupStartAyah) && Number.isInteger(groupEndAyah);
%>
<% if (canMakeSubsection) { %>
<aside class="quran-subsection-admin mb-2" data-heading-id="<%= sectionHeading.id %>" data-section-path="/<%= sectionHeading.path %>">
  <div class="d-flex flex-wrap align-items-end gap-2">
    <label class="form-label mb-0 small">
      Unsectioned start
      <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm quran-subsection-start" value="<%= groupStartAyah %>">
    </label>
    <label class="form-label mb-0 small">
      End
      <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm quran-subsection-end" value="<%= groupEndAyah %>">
    </label>
    <label class="form-label mb-0 small quran-subsection-title-wrap">
      Title
      <input type="text" class="form-control form-control-sm quran-subsection-title" value="">
    </label>
    <button type="button" class="btn btn-sm btn-outline-primary quran-subsection-add" data-loading-label="Adding">
      <span class="bi bi-plus-circle"></span> Make subsection
    </button>
  </div>
</aside>
<% } %>
<article class="row quran-passage-section">

<%- include('quran_item.ejs', { site: site, page: page, passage: group.passage, selectedAyah: locals.selectedAyah, selectedAyahs: locals.selectedAyahs, quranSubsections: group.quranSubsections, quranShareId: locals.quranShareId, lang: 'en', main: main, title: title, searchResult: searchResult }); %>

<%- include('quran_item.ejs', { site: site, page: page, passage: group.passage, selectedAyah: locals.selectedAyah, selectedAyahs: locals.selectedAyahs, quranSubsections: group.quranSubsections, quranShareId: locals.quranShareId, lang: 'ar', main: main, title: title, searchResult: searchResult }); %>

</article>
<% }); %>

<% if (locals.quranShareId && (!locals.selectedAyahs || locals.selectedAyahs.length <= 1)) { %>
<%- include('quran_modal.ejs', { site: site, page: page, selectedAyahs: locals.selectedAyahs, quranShareId: locals.quranShareId }); %>
<% } %>
