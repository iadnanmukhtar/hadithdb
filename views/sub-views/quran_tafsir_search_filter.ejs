<%
  var selectedSearchTafsirAliases = Array.isArray(locals.selectedSearchTafsirAliases)
    ? locals.selectedSearchTafsirAliases
    : (locals.selectedSearchTafsirAlias ? [locals.selectedSearchTafsirAlias] : []);
  var quranChecked = locals.quranChecked === true;
  var tafsirChecked = locals.tafsirChecked === true;
  var searchTafsirRows = locals.searchTafsirs || locals.tafsirs || [];
  if ((!searchTafsirRows || searchTafsirRows.length < 1) && typeof Tafsir !== 'undefined' && Tafsir.visibleTafsirsSync)
    searchTafsirRows = Tafsir.visibleTafsirsSync();
  var seenSearchTafsirs = new Set();
  var searchTafsirOptions = (searchTafsirRows || []).filter(function (tafsir) {
    if (!tafsir || Number(tafsir.hidden) === 1 || tafsir.source !== 'local' || !tafsir.alias || seenSearchTafsirs.has(tafsir.alias))
      return false;
    seenSearchTafsirs.add(tafsir.alias);
    return true;
  }).map(function (tafsir) {
    var label = (typeof Tafsir !== 'undefined' && Tafsir.rawShortName)
      ? Tafsir.rawShortName(tafsir, 'en')
      : (tafsir.shortName_en || tafsir.name_en || tafsir.alias);
    var option = {
      alias: tafsir.alias,
      label: label,
      selected: selectedSearchTafsirAliases.indexOf(tafsir.alias) >= 0
    };
    return option;
  }).sort(function (a, b) {
    var labelOrder = a.label.localeCompare(b.label, 'en', { sensitivity: 'base' });
    if (labelOrder !== 0)
      return labelOrder;
    return a.alias.localeCompare(b.alias, 'en', { sensitivity: 'base' });
  });
%>
<% if (searchTafsirOptions.length > 0) { %>
  <button class="btn btn-outline-primary dropdown-toggle quran-passage-filter-toggle search-filter-toggle" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Search filters" aria-label="Search filters" data-search-filter-toggle>
    <span class="search-filter-icon-wrap">
      <i class="bi bi-book<%= selectedSearchTafsirAliases.length > 0 ? '-fill' : '' %>"></i>
      <span class="search-filter-count-badge badge rounded-pill d-none" data-search-filter-count>0</span>
    </span>
  </button>
  <div class="dropdown-menu dropdown-menu-end quran-tafsir-search-filter">
    <div class="form-check">
      <input class="form-check-input" type="checkbox" name="b" value="quran" <%= quranChecked ? 'checked' : '' %>>
      <label class="form-check-label">Quran</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" name="b" value="tafsir" <%= tafsirChecked ? 'checked' : '' %>>
      <label class="form-check-label">Tafsir</label>
    </div>
    <div class="filter-list-search-wrap px-3 pb-2" data-filter-list-search>
      <input type="search" class="form-control form-control-sm filter-list-search" placeholder="Find book" aria-label="Find tafsir book">
    </div>
    <% searchTafsirOptions.forEach(function (tafsirOption) { %>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" name="tafsir" value="<%= tafsirOption.alias %>" <%= tafsirOption.selected ? 'checked' : '' %>>
      <label class="form-check-label"><%= tafsirOption.label %></label>
    </div>
    <% }); %>
  </div>
<% } %>
