<%
  const names = { chapters: 'chapters', covered: 'covered books', surahs: 'surahs', juz: 'juz', manzils: 'manzils' };
  const resultId = mode === 'chapters' ? 'toc' : 'toc-' + mode;
%>
<aside class="hadith-heading-toc toc-heading-rail d-none d-lg-block" data-toc-heading-rail aria-labelledby="toc-heading-rail-title">
  <div class="hadith-heading-toc-sticky">
    <%- include('rail_title.ejs', { titleId: 'toc-heading-rail-title', title: 'Book contents' }) %>
    <div data-toc-desktop-tools>
      <div class="ux-system ux-rail-filter-slot" data-toc-tools>
        <%- include('rail_search.ejs', { inputId: 'toc-filter', resultsId: resultId, placeholder: 'Search ' + names[mode], label: 'Search ' + names[mode], clearLabel: 'Clear search', tocFilter: true }) %>
        <p class="small text-muted mb-0" role="status" data-toc-empty></p>
      </div>
    </div>
    <nav class="hadith-heading-toc-nav ux-menu-list" data-toc-heading-rail-nav aria-label="Contents">
      <% for (const group of groups) { %>
      <div data-toc-mode="<%= group.mode %>" data-search-label="Search <%= names[group.mode] %>"<% if (group.mode !== mode) { %> hidden<% } %>>
        <% for (const item of group.items) { %>
        <a href="<%= item.href %>" data-toc-index-key="<%= item.key %>"<% if (item.track !== false) { %> data-toc-heading-key="<%= item.key %>"<% } %><% if (item.titleLang === 'ar') { %> lang="ar" dir="rtl"<% } %>><%= [item.number, item.title].filter(Boolean).join(' ') %></a>
        <% } %>
      </div>
      <% } %>
    </nav>
  </div>
</aside>
