<%
  var tocHeadingRailItems = Array.isArray(locals.tocHeadingRailItems) ? locals.tocHeadingRailItems : [];
  var tocHeadingRailTitle = (locals.tocHeadingRailTitle || '').toString();
  var tocHeadingRailBookHref = (locals.tocHeadingRailBookHref || '').toString();
  var tocHeadingRailInitialItem = tocHeadingRailItems.find(function (item) { return item.track !== false; });
  var tocHeadingRailInitialKey = tocHeadingRailInitialItem ? tocHeadingRailInitialItem.key : '';
%>
<% if (tocHeadingRailItems.length > 0) { %>
<aside class="hadith-heading-toc toc-heading-rail d-none d-lg-block" data-toc-heading-rail aria-labelledby="toc-heading-rail-title">
  <div class="hadith-heading-toc-sticky">
    <%- include('toc_rail_header.ejs', { titleId: 'toc-heading-rail-title', title: tocHeadingRailTitle, href: tocHeadingRailBookHref, linkLabel: 'Book overview' }) %>
    <nav class="nav flex-column hadith-heading-toc-nav ux-menu-list" data-toc-heading-rail-nav aria-label="Chapters in <%= tocHeadingRailTitle %>">
      <% tocHeadingRailItems.forEach(function (heading) { %>
      <a class="nav-link hadith-heading-toc-link<%= heading.key === tocHeadingRailInitialKey ? ' active' : '' %>" href="<%= heading.href %>"<% if (heading.track !== false) { %> data-toc-heading-key="<%= heading.key %>"<% } %><% if (heading.titleLang === 'ar') { %> lang="ar" dir="rtl"<% } %><% if (heading.key === tocHeadingRailInitialKey) { %> aria-current="location"<% } %>><% if (heading.number) { %><%= heading.number %> <% } %><%= heading.title %></a>
      <% }); %>
    </nav>
  </div>
</aside>
<% } %>
