<%
  var entryDate = item.publicationDate ? new Date(item.publicationDate+'T12:00:00Z') : new Date(item.activityAt);
  var entryDateLabel = item.publicationDate ? entryDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'}) : entryDate.toLocaleDateString('en-US',{month:'short',day:'numeric',timeZone:'America/Chicago'});
  var isPrivatePost = item.status && item.status !== 'published';
  var entryHref = isPrivatePost ? '/community/write?post=' + item.id : item.url;
  var entryKind = ['title','revision'].includes(item.microinteraction) ? item.microinteraction : item.activity === 'comment' ? 'comment' : item.kind;
  var entryLabel = entryKind === 'like' ? 'Liked' : entryKind === 'comment' ? 'In conversation' : entryKind === 'article' ? 'Article' : 'Post';
%>
<article class="community-entry" data-activity="<%= item.activity %>" data-kind="<%= entryKind %>" data-private="<%= !!isPrivatePost %>">
  <% if (['like','title','revision'].includes(entryKind)) { %>
    <a class="community-avatar" href="/community/@<%= item.author.handle %>" tabindex="-1" aria-hidden="true"><%- include('community_avatar.ejs', { avatar: item.author }) %></a>
    <div class="community-reaction-copy"><a href="/community/@<%= item.author.handle %>" dir="auto"><%= item.author.name %></a> <%= entryKind === 'revision' ? 'revised' : entryKind === 'title' ? 'titled' : 'liked' %> <a href="<%= entryKind !== 'like' ? item.hadithUrl : entryHref %>" dir="auto"><%= entryKind !== 'like' ? item.hadithTitle : (item.title || 'a post').replace(/^Liked\s+/i, '') %></a><% if (entryKind !== 'like') { %> · <%= item.hadithRef %><% } %><% if (item.activityAt) { %> · <time datetime="<%= item.publicationDate || new Date(item.activityAt).toISOString() %>"><%= entryDateLabel %></time><% } %></div>
  <% } else { %>
  <% if (item.repostedBy) { %><div class="community-repost-credit"><i class="bi bi-repeat" aria-hidden="true"></i> Reposted by <a href="/community/@<%= item.repostedBy.handle %>"><%= item.repostedBy.name %></a></div><% } %>
  <div class="community-entry-meta">
    <a class="community-avatar" href="/community/@<%= item.author.handle %>" tabindex="-1" aria-hidden="true"><%- include('community_avatar.ejs', { avatar: item.author }) %></a>
    <div class="community-entry-identity"><a class="community-author" href="/community/@<%= item.author.handle %>" dir="auto"><%= item.author.name %></a>
      <div class="community-entry-subline"><span><%= entryLabel %></span><% if (item.activityAt) { %><span aria-hidden="true">·</span><time datetime="<%= item.publicationDate || new Date(item.activityAt).toISOString() %>"><%= entryDateLabel %></time><% } %></div>
    </div><% if (isPrivatePost) { %><span class="community-entry-state"><%= item.status %></span><% } %>
  </div>
  <% if (entryKind !== 'note' || (item.title && !['Note','Post'].includes(item.title))) { %><h2 class="community-entry-title" dir="auto"><a href="<%= entryHref %>"><%= item.title %></a></h2><% } %>
  <% if (entryKind === 'article' && item.subtitle) { %><p class="community-article-subtitle" dir="auto"><%= item.subtitle %></p><% } %>
  <% if ((entryKind === 'comment' && item.html) || item.feedHtml) { %><div dir="auto" class="notebook-markdown community-reflection-body"><%- entryKind === 'comment' ? item.html : item.feedHtml %></div><% } else { %><p dir="auto" class="community-entry-excerpt"><%= item.excerpt %></p><% } %>
  <% if (item.mediaHtml) { %><div class="community-feed-media"><%- item.mediaHtml %></div><% } %>
  <% if (item.tags) { %><div class="community-entry-tags" dir="auto"><% for (const tag of item.tags.split(',').map(tag => tag.trim()).filter(Boolean).slice(0, 5)) { %><span><%= tag %></span><% } %></div><% } %>
  <div class="community-entry-actions">
    <% if (item.likeSource) { %><span class="community-like" title="Likes" aria-label="<%= item.likeCount || 0 %> likes"><i class="bi bi-<%= item.likeSource === 'post' ? 'heart' : 'hand-thumbs-up' %>" aria-hidden="true"></i><% if (item.likeCount) { %> <%= item.likeCount %><% } %></span><% } %>
    <% if (item.likeSource) { %><span class="community-like" title="Dislikes" aria-label="<%= item.dislikeCount || 0 %> dislikes"><i class="bi bi-hand-thumbs-down" aria-hidden="true"></i><% if (item.dislikeCount) { %> <%= item.dislikeCount %><% } %></span><% } %>
    <a href="<%= entryHref %>" title="<%= isPrivatePost ? 'Open draft' : 'View comments' %>" aria-label="<%= isPrivatePost ? 'Open draft' : 'View comments' %>"><i class="bi bi-<%= isPrivatePost ? 'file-earmark-text' : 'reply' %>" aria-hidden="true"></i><% if (item.commentCount) { %> <%= item.commentCount %><% } %></a>
    <% if (item.likeSource) { %><span class="community-like" title="Reposts" aria-label="<%= item.repostCount || 0 %> reposts"><i class="bi bi-repeat" aria-hidden="true"></i><% if (item.repostCount) { %> <%= item.repostCount %><% } %></span><% } %>
    <% if (item.canEdit) { %><a class="community-entry-secondary community-edit-post" data-edit-kind="<%= item.kind %>" data-edit-id="<%= item.id %>" href="<%= item.kind === 'note' ? '/community/mine?editPost=' : '/community/write?post=' %><%= item.id %>" title="Edit post" aria-label="Edit post"><i class="bi bi-pencil" aria-hidden="true"></i></a><% } %><% if (!isPrivatePost && ['article','note'].includes(entryKind)) { %><a class="community-entry-secondary" href="<%= entryHref %>" title="Open post" aria-label="Open post"><i class="bi bi-arrow-right" aria-hidden="true"></i></a><% } %>
  </div>
  <% } %>
</article>
