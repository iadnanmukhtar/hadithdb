<% 
	hashtag = (toc.book.alias + '_' + toc.num).replace(/[-\:]/, '_');
	var _e = '_e';
	var _p = searchResult ? 'partial' : '';
	const displayLevel = (toc.h3 !== null && toc.h3 !== undefined && toc.h3 !== '') ? 3 :
		((toc.h2 !== null && toc.h2 !== undefined && toc.h2 !== '') ? 2 :
			((toc.h1 !== null && toc.h1 !== undefined && toc.h1 !== '') ? 1 : toc.level));
	const debugDocId = toc.id ?? toc.tId ?? toc.hId ?? toc._id ?? '';
	const debugScore = Number.isFinite(toc._score) ? toc._score : '';
	function linkTitle(title) {
		title = title || '';
		if (!searchResult)
			return title;
		var parts = [];
		if (title)
			parts.push(title);
		parts.push(`doc=${debugDocId}`);
		if (debugScore !== '')
			parts.push(`score=${debugScore}`);
		return parts.join(' | ');
	}
%>

<article class="row">

	<!-- English TOC ----------------------------------------- -->
	<section class="col-md-6 col-sm-12 h" lang="en">
		<section><strong>
			<% if (toc.h2) {
				if (displayLevel == 3) { %>
					<a href="/<%=toc.book.alias%>/<%=toc.h1%><%=toc.h1_offset%>/<%=toc.h2%>/<%=toc.h3%>" title="<%= linkTitle(toc.h3_title_en) %>"><%= `${toc.book.shortName_en}` %> Subsection <%=toc.h1%>.<%=toc.h2%>.<%=toc.h3%></a> –
					<span class="<%=_e%>" data-id="<%=toc.h3_id%>" data-prop="toc.title_en"><%- toc.h3_title_en || 'Subsection' %></span>
				<% } else { %>
					<a href="/<%=toc.path%>" title="<%= linkTitle(toc.h2_title_en) %>"><%= `${toc.book.shortName_en}` %> Section <%=toc.h1%>.<%=toc.h2%></a> –
					<span class="<%=_e%>" data-id="<%=toc.h2_id%>" data-prop="toc.title_en"><%- toc.h2_title_en || 'Section' %></span>
				<% } %>
			<% } else if (toc.h1) { %>
				<a href="/<%=toc.book.alias%>/<%=toc.h1%>" title="<%= linkTitle(toc.h1_title_en) %>"><%= `${toc.book.shortName_en}` %> Chapter <%=toc.h1%></a> –
				<span class="<%=_e%>" data-id="<%=toc.h1_id%>" data-prop="toc.title_en"><%- toc.h1_title_en || 'Chapter' %></span>
			<% } %>
		</strong></section>
		<% if (site.editMode || toc.h1_intro_en || toc.h2_intro_en || toc.h3_intro_en ) { %>
			<section class="body">
				<% if (toc.h2) {
					if (displayLevel == 3) { %>
						<%
							const introEnMarkdown = utils.emptyIfNull(toc.h3_intro_en);
							const introEn = utils.markdownToHtml(toc.h3_intro_en) || '&hellip;';
						%>
						<div class="<%=_e%> <%=_p%>" data-id="<%=toc.h3_id%>" data-prop="toc.intro_en" data-markdown-source="<%= introEnMarkdown %>" data-markdown-empty-html="&hellip;"><%- introEn %></div>
					<% } else { %>
						<%
							const introEnMarkdown = utils.emptyIfNull(toc.h2_intro_en);
							const introEn = utils.markdownToHtml(toc.h2_intro_en) || '&hellip;';
						%>
						<div class="<%=_e%> <%=_p%>" data-id="<%=toc.h2_id%>" data-prop="toc.intro_en" data-markdown-source="<%= introEnMarkdown %>" data-markdown-empty-html="&hellip;"><%- introEn %></div>
					<% } %>
				<% } else if (toc.h1) { %>
					<%
						const introEnMarkdown = utils.emptyIfNull(toc.h1_intro_en);
						const introEn = utils.markdownToHtml(toc.h1_intro_en) || '&hellip;';
					%>
					<div class="<%=_e%> <%=_p%>" data-id="<%=toc.h1_id%>" data-prop="toc.intro_en" data-markdown-source="<%= introEnMarkdown %>" data-markdown-empty-html="&hellip;"><%- introEn %></div>
				<% } %>
			</section>
		<% } %>
		<% if (title && (toc.h1 || toc.h2)) { %>
			<section class="title">
				§ 
				<% if (toc.h2) {
					if (displayLevel == 3) { %>
						<a href="/<%=toc.book.alias%>/<%=toc.h1%><%=toc.h1_offset%>/<%=toc.h2%>/<%=toc.h3%>" title="<%= linkTitle(toc.h3_title_en) %>"><%- utils.truncate(toc.h3_title_en, 30, true) || 'Subsection' %></a>
					<% } else { %>
						<a href="/<%=toc.book.alias%>/<%=toc.h1%><%=toc.h1_offset%>/<%=toc.h2%>" title="<%= linkTitle(toc.h2_title_en) %>"><%- utils.truncate(toc.h2_title_en, 30, true) || 'Section' %></a>
					<% } %>
				<% } %>
				<% if (toc.h1) { %>
					in <a href="/<%=toc.book_alias%>/<%=toc.h1%>" title="<%= linkTitle(toc.h1_title_en) %>"><%- utils.truncate(toc.h1_title_en, 30, true) || 'Chapter' %></a>
				<% } %>
			</section>
		<% } %>
	</section>

	<!-- Arabic TOC ----------------------------------------- -->
	<section class="col-md-6 cols-sm-12 h" lang="ar">
		<p><strong>
			<% if (toc.h2) { 
				if (displayLevel == 3) { %>
					<a href="/<%=toc.book.alias%>/<%=toc.h1%><%=toc.h1_offset%>/<%=toc.h2%>/<%=toc.h3%>" title="<%= linkTitle(toc.h3_title) %>"><%=toc.book.shortName%> <%=arabic.toArabicDigits(toc.h1)%>.<%=arabic.toArabicDigits(toc.h2)%>.<%=arabic.toArabicDigits(toc.h3)%></a> –
					<span class="<%=_e%>" data-id="<%=toc.h3_id%>" data-prop="toc.title"><%- toc.h3_title || 'باب' %></span>
				<% } else { %> 
					<a href="/<%=toc.book.alias%>/<%=toc.h1%><%=toc.h1_offset%>/<%=toc.h2%>" title="<%= linkTitle(toc.h2_title) %>"><%=toc.book.shortName%> <%=arabic.toArabicDigits(toc.h1)%>.<%=arabic.toArabicDigits(toc.h2)%></a> –
					<span class="<%=_e%>" data-id="<%=toc.h2_id%>" data-prop="toc.title"><%- toc.h2_title || 'باب' %></span>
				<% } %>
			<% } else if (toc.h1) { %>
				<a href="/<%=toc.book.alias%>/<%=toc.h1%>" title="<%= linkTitle(toc.h1_title) %>"><%=toc.book.shortName%> <%=arabic.toArabicDigits(toc.h1)%></a> –
				<span class="<%=_e%>" data-id="<%=toc.h1_id%>" data-prop="toc.title"><%- toc.h1_title || 'كتاب' %></span>
			<% } %>
		</strong></p>
		<% if (site.editMode || toc.h1_intro || toc.h2_intro || toc.h3_intro ) { %>
			<section class="body">
				<% if (toc.h2) {
					if (displayLevel == 3) { %>
						<%
							const introArMarkdown = utils.emptyIfNull(toc.h3_intro);
							const introAr = utils.markdownToHtml(toc.h3_intro) || '&hellip;';
						%>
						<div class="<%=_e%> <%=_p%>" data-id="<%=toc.h3_id%>" data-prop="toc.intro" data-markdown-source="<%= introArMarkdown %>" data-markdown-empty-html="&hellip;">
							<%- introAr %>
						</div>
					<% } else { %> 
						<%
							const introArMarkdown = utils.emptyIfNull(toc.h2_intro);
							const introAr = utils.markdownToHtml(toc.h2_intro) || '&hellip;';
						%>
						<div class="<%=_e%> <%=_p%>" data-id="<%=toc.h2_id%>" data-prop="toc.intro" data-markdown-source="<%= introArMarkdown %>" data-markdown-empty-html="&hellip;"><%- introAr %></div>
					<% } %>
				<% } else if (toc.h1) { %>
					<%
						const introArMarkdown = utils.emptyIfNull(toc.h1_intro);
						const introAr = utils.markdownToHtml(toc.h1_intro) || '&hellip;';
					%>
					<div class="<%=_e%> <%=_p%>" data-id="<%=toc.h1_id%>" data-prop="toc.intro" data-markdown-source="<%= introArMarkdown %>" data-markdown-empty-html="&hellip;"><%- introAr %></div>
				<% } %>
			</section>
		<% } %>
		<% if (title && (toc || toc.h2)) { %>
			<section class="title">
			§ 
			<% if (toc.h2) {
				if (displayLevel == 3) { %>
					<a href="/<%=toc.book.alias%>/<%=toc.h1%><%=toc.h1_offset%>/<%=toc.h2%>/<%=toc.h3%>" title="<%= linkTitle(toc.h3_title) %>"><%- utils.truncate(toc.h3_title, 60, true) || 'بَاب' %></a>
				<% } else { %> 
					<a href="/<%=toc.book.alias%>/<%=toc.h1%><%=toc.h1_offset%>/<%=toc.h2%>" title="<%= linkTitle(toc.h2_title) %>"><%- utils.truncate(toc.h2_title, 60, true) || 'بَاب' %></a>
				<% } %> 
			<% } %>
			<% if (toc.h1) { %>
				في <a href="/<%=toc.book_alias%>/<%=toc.h1%>" title="<%= linkTitle(toc.h1_title) %>"><%- utils.truncate(toc.h1_title, 60, true) || 'كِتَاب' %></a>
			<% } %>
			</section>
		<% } %>
	</section>

</article>

<% if (title) { %>
	<hr class="mt-2" />
<% } else { %>
	<div class="mt-2"></div>
<% } %>
