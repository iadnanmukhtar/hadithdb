<% 
    var book = page.context.book;
    var chapter = page.context.chapter;
    var section = page.context.section;
    var heading = page.context.section || chapter;
    var headingPage = heading && heading.page ? heading.page : {};
    var isQuranChapter = book && book.alias === 'quran';
    var chapterBreadcrumbLabelEn = isQuranChapter ? 'Surah' : 'Chapter';
    var chapterBreadcrumbLabelAr = isQuranChapter ? 'السورة' : 'كتاب';
    if (chapter.h1 != Math.floor(chapter.h1))
      chapter.h1 = Number(chapter.h1).toFixed(2);
%>

<%# Chapter Title %>
<heading class="row major">

  <h2 class="col-md-6 col-sm-12 fs-4 title" lang="en"><a href="<%= utils.urlFor(req, `/${chapter.path}`) %>">
    <%- chapter.h1 %>. <span class="_e" data-id="<%= chapter.id %>" data-prop="toc.title_en" data-arabizi="true">
      <%- chapter.title_en || 'Chapter' %>
    </span>
    <% if (headingPage.hasNext || headingPage.number && headingPage.number > 1) { %>
    (<%- headingPage.number %>/<%- Math.ceil(chapter.count/global.settings.search.itemsPerPage)%>)
    <% } %>
  </a>
  <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center ms-2" data-heading-id="<%= chapter.id %>" title="Bookmark this chapter">
    <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= chapter.id %>"></span>
  </button>
  </h2>
  
  <h2 class="col-md-6 col-sm-12 fs-4 title" lang="ar"><a href="<%= utils.urlFor(req, `/${chapter.path}`) %>">
    <%- arabic.toArabicDigits(chapter.h1 + '') %>۔
    <span class="_e<%= isQuranChapter ? ' quran-surah-name' : '' %>" data-id="<%= chapter.id %>" data-prop="toc.title">
      <%- chapter.title %>
    </span>
    <%- (headingPage.hasNext || headingPage.number && headingPage.number > 1) ? `ص ${arabic.toArabicDigits(headingPage.number+'')}` : `` %>
  </a></h2>

</heading>

<%# Chapter Breadcrumbs %>
<section class="row breadcrumbs pagination">

  <div class="col-md-6 col-sm-12" lang="en">
    <a title="<%- book.name_en %>" href="<%= utils.urlFor(req, `/${book.alias}`) %>"><%- book.shortName_en %></a>
    &gt;
    <% if (heading.level == 1) { %>
      <span title="<%- chapter.title %>"><%- chapterBreadcrumbLabelEn %> <%- chapter.h1 %></span>
    <% } else if (heading.level == 2) { %>
      <a title="<%- chapter.title_en || chapterBreadcrumbLabelEn %>" href="<%= utils.urlFor(req, `/${chapter.path}`) %>"><%- chapterBreadcrumbLabelEn %> <%- chapter.h1 %></a>
      &gt;
      <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-heading-id="<%= section.id %>" title="Bookmark this section">
        <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= section.id %>"></span>
      </button>
      <% if (page.context.book && page.context.book.alias === 'quran' && page.context.passage) { %>
        <a title="<%- section.title %>" href="<%= utils.urlFor(req, `/${section.path}`) %>">Section <%- section.h2 %></a>
      <% } else { %>
        <span title="<%- section.title %>">Section <%- section.h2 %></span>
      <% } %>
    <% } %>
  </div>

  <div class="col-md-6 col-sm-12" lang="ar">
    <a title="<%- book.title %>" href="<%= utils.urlFor(req, `/${book.alias}`) %>"><%- book.shortName %></a>
    &gt;
    <% if (heading.level == 1) { %>
      <span title="<%- chapter.title %>"><%- chapterBreadcrumbLabelAr %> <%- arabic.toArabicDigits(chapter.h1) %></span>
    <% } else if (heading.level == 2) { %>
      <a title="<%- chapter.title %>" href="<%= utils.urlFor(req, `/${chapter.path}`) %>"><%- chapterBreadcrumbLabelAr %> <%- arabic.toArabicDigits(chapter.h1) %></a>
      &gt;
      <% if (page.context.book && page.context.book.alias === 'quran' && page.context.passage) { %>
        <a title="<%- section.title %>" href="<%= utils.urlFor(req, `/${section.path}`) %>">باب <%- arabic.toArabicDigits(section.h2) %></a>
      <% } else { %>
        <span title="<%- section.title %>">باب <%- arabic.toArabicDigits(section.h2) %></span>
      <% } %>
    <% } %>
  </div>

</section>

<%# Chapter Intro %>
<% if (heading.level == 1) { %>
<section class="chapter-intro row">

  <section class="_e col-md-6 col-sm-12 intro" lang="en" data-id="<%= chapter.id %>" data-prop="toc.intro_en" data-arabizi="true" data-markdown-source="<%= utils.emptyIfNull(chapter.intro_en) %>" data-markdown-empty-html="&hellip;">
    <% if (chapter.intro_en || site.editMode) { 
        const introEn = utils.markdownToHtml(chapter.intro_en) || '&hellip;';
    %>
    <div>
      <%- introEn %>
    </div>
    <% } %>
  </section>

  <section class="_e col-md-6 col-sm-12 intro" lang="ar" data-id="<%= chapter.id %>" data-prop="toc.intro" data-markdown-source="<%= utils.emptyIfNull(chapter.intro) %>" data-markdown-empty-html="&hellip;">
    <% if (chapter.intro || site.editMode) { 
        const introAr = utils.markdownToHtml(chapter.intro) || '&hellip;';
    %>
    <div>
      <%- introAr %>
    </div>
    <% } %>
    </section>

</section>
<% } %>
