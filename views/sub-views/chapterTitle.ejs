<% 
    var book = page.context.book;
    var chapter = page.context.chapter;
    var section = page.context.section;
    var heading = page.context.section || chapter;
    var firstChapterSection = Array.isArray(chapter.sections)
      ? chapter.sections.find(function (candidate) { return Number(candidate.h2) > 0; })
      : null;
    var isFirstChapterSectionPage = Number(heading.level) === 2 && firstChapterSection && (
      (heading.id !== undefined && firstChapterSection.id !== undefined && String(heading.id) === String(firstChapterSection.id))
      || (heading.path && firstChapterSection.path && heading.path === firstChapterSection.path)
      || Number(heading.h2) === Number(firstChapterSection.h2)
    );
    var hadithFlatHeadingRail = Boolean(locals.hadithFlatHeadingRail);
    var hadithFlatHeadingContext = locals.hadithFlatHeadingContext || '';
    var hadithFlatHeadingKey = locals.hadithFlatHeadingKey || '';
    var isQuranChapter = book && book.alias === 'quran';
    var chapterBreadcrumbLabelEn = isQuranChapter ? 'Surah' : 'Chapter';
    var chapterBreadcrumbLabelAr = isQuranChapter ? 'السورة' : 'كتاب';
    var quranChapterSurah = isQuranChapter ? (global.surahs || []).find(function (surah) {
      return Number(surah.num) === Number(chapter.h1);
    }) : null;
    var quranChapterRevelation = quranChapterSurah && /^mad/i.test((quranChapterSurah.revelation_en || '').toString()) ? 'madani' : 'makki';
	var quranChapterBreadcrumbLabel = isQuranChapter
	  ? utils.quranSurahBreadcrumbLabel(chapter.h1, chapter.title_en || (quranChapterSurah && quranChapterSurah.name_en))
	  : '';
	var quranChapterBreadcrumbLabelAr = isQuranChapter
	  ? utils.quranSurahBreadcrumbLabelAr(chapter.h1, chapter.title || (quranChapterSurah && quranChapterSurah.name_ar))
	  : '';
	var quranBreadcrumbBook = isQuranChapter && page.context.passage
	  ? page.context.quranCommentaryBook
	  : null;
	var quranBreadcrumbBookSlug = quranBreadcrumbBook
	  ? (quranBreadcrumbBook.quranBookSlug || quranBreadcrumbBook.alias)
	  : '';
	var breadcrumbBookLabelEn = quranBreadcrumbBook
	  ? (quranBreadcrumbBook.shortName_en || quranBreadcrumbBook.name_en || quranBreadcrumbBook.alias)
	  : book.shortName_en;
	var breadcrumbBookLabelAr = quranBreadcrumbBook
	  ? (quranBreadcrumbBook.shortName || quranBreadcrumbBook.title || breadcrumbBookLabelEn)
	  : book.shortName;
	var breadcrumbBookTitleEn = quranBreadcrumbBook
	  ? (quranBreadcrumbBook.name_en || breadcrumbBookLabelEn)
	  : book.name_en;
	var breadcrumbBookTitleAr = quranBreadcrumbBook
	  ? (quranBreadcrumbBook.title || breadcrumbBookLabelAr)
	  : book.title;
	var breadcrumbBookHref = quranBreadcrumbBookSlug
	  ? `/quran/${encodeURIComponent(quranBreadcrumbBookSlug)}`
	  : `/${book.alias}`;
    if (chapter.h1 != Math.floor(chapter.h1))
      chapter.h1 = Number(chapter.h1).toFixed(2);
    var quranSurahNameGlyph = isQuranChapter && !site.editMode ? utils.quranSurahNameLigature(chapter.h1) : '';
%>

<%# Chapter Title %>
<heading class="row major"<% if (hadithFlatHeadingRail) { %> data-hadith-heading-target data-hadith-heading-context="<%= hadithFlatHeadingContext %>" data-hadith-heading-key="<%= hadithFlatHeadingKey %>" data-hadith-heading-level="1"<% } %>>

  <h2 class="col-md-6 col-sm-12 fs-4 title" lang="en"><a href="<%= utils.urlFor(req, `/${chapter.path}`) %>">
    <%- chapter.h1 %>. <span class="_e" data-id="<%= chapter.id %>" data-prop="toc.title_en" data-arabizi="true">
      <%- chapter.title_en || 'Chapter' %>
    </span>
  </a>
  <% if (isQuranChapter) { %>
  <span class="quran-revelation-icon quran-revelation-icon-<%= quranChapterRevelation %>" role="img" aria-label="<%= quranChapterRevelation === 'madani' ? 'Madani' : 'Makki' %>" title="<%= quranChapterRevelation === 'madani' ? 'Madani' : 'Makki' %>"></span>
  <% } %>
  <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center ms-2" data-heading-id="<%= chapter.id %>" data-bookmark-type="<%= isQuranChapter ? 'surah' : 'chapter' %>" data-bookmark-ref="<%= isQuranChapter ? `quran:${chapter.h1}` : `${book.alias}:${chapter.h1}` %>" data-bookmark-title="<%= chapter.title_en || chapterBreadcrumbLabelEn %>" data-bookmark-title-ar="<%= chapter.title || '' %>" data-bookmark-url="<%= utils.urlFor(req, `/${chapter.path}`) %>" title="Bookmark this chapter">
    <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= chapter.id %>"></span>
  </button>
  </h2>
  
  <h2 class="col-md-6 col-sm-12 fs-4 title" lang="ar"><a href="<%= utils.urlFor(req, `/${chapter.path}`) %>">
    <%- arabic.toArabicDigits(chapter.h1 + '') %>۔
    <span class="_e<%= quranSurahNameGlyph ? ' quran-surah-name-font' : (isQuranChapter ? ' quran-surah-name' : '') %>" data-id="<%= chapter.id %>" data-prop="toc.title"<% if (quranSurahNameGlyph) { %> title="<%= chapter.title %>" aria-label="<%= chapter.title %>"<% } %>>
      <%- quranSurahNameGlyph || chapter.title %>
    </span>
  </a></h2>

</heading>

<%# Chapter Breadcrumbs %>
<section class="row breadcrumbs pagination">

  <div class="col-md-6 col-sm-12" lang="en">
    <a title="<%- breadcrumbBookTitleEn %>" href="<%= utils.urlFor(req, breadcrumbBookHref) %>"><%- breadcrumbBookLabelEn %></a>
    &gt;
    <% if (heading.level == 1) { %>
	  <% if (isQuranChapter) { %>
	    <span title="<%- chapter.title %>"><%= quranChapterBreadcrumbLabel %></span>
	  <% } else { %>
	    <span title="<%- chapter.title %>"><%- chapterBreadcrumbLabelEn %> <%- chapter.h1 %></span>
	  <% } %>
    <% } else if (heading.level == 2) { %>
	  <a title="<%- chapter.title_en || chapterBreadcrumbLabelEn %>" href="<%= utils.urlFor(req, `/${chapter.path}`) %>"><%- isQuranChapter ? quranChapterBreadcrumbLabel : `${chapterBreadcrumbLabelEn} ${chapter.h1}` %></a>
      &gt;
	  <button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-heading-id="<%= section.id %>" data-bookmark-type="section" data-bookmark-ref="<%= `${book.alias}:${chapter.h1}.${section.h2}` %>" data-bookmark-title="<%= section.title_en || `${isQuranChapter ? 'Passage' : 'Section'} ${section.h2}` %>" data-bookmark-title-ar="<%= section.title || '' %>" data-bookmark-url="<%= utils.urlFor(req, `/${section.path}`) %>" title="Bookmark this <%= isQuranChapter ? 'passage' : 'section' %>">
        <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= section.id %>"></span>
      </button>
      <% if (page.context.book && page.context.book.alias === 'quran' && page.context.passage) { %>
	    <a title="<%- section.title %>" href="<%= utils.urlFor(req, `/${section.path}`) %>">Passage <%- section.h2 %></a>
      <% } else { %>
	    <span title="<%- section.title %>"><%= isQuranChapter ? 'Passage' : 'Section' %> <%- section.h2 %></span>
      <% } %>
    <% } %>
  </div>

  <div class="col-md-6 col-sm-12" lang="ar">
    <a title="<%- breadcrumbBookTitleAr %>" href="<%= utils.urlFor(req, breadcrumbBookHref) %>"><%- breadcrumbBookLabelAr %></a>
    &gt;
    <% if (heading.level == 1) { %>
	  <% if (isQuranChapter) { %>
	    <span title="<%- chapter.title %>"><%= quranChapterBreadcrumbLabelAr %></span>
	  <% } else { %>
	    <span title="<%- chapter.title %>"><%- chapterBreadcrumbLabelAr %> <%- arabic.toArabicDigits(chapter.h1) %></span>
	  <% } %>
    <% } else if (heading.level == 2) { %>
	  <a title="<%- chapter.title %>" href="<%= utils.urlFor(req, `/${chapter.path}`) %>"><%- isQuranChapter ? quranChapterBreadcrumbLabelAr : `${chapterBreadcrumbLabelAr} ${arabic.toArabicDigits(chapter.h1)}` %></a>
      &gt;
      <% if (page.context.book && page.context.book.alias === 'quran' && page.context.passage) { %>
	    <a title="<%- section.title %>" href="<%= utils.urlFor(req, `/${section.path}`) %>">مقطع <%- arabic.toArabicDigits(section.h2) %></a>
      <% } else { %>
	    <span title="<%- section.title %>"><%= isQuranChapter ? 'مقطع' : 'باب' %> <%- arabic.toArabicDigits(section.h2) %></span>
      <% } %>
    <% } %>
  </div>

</section>

<%# Chapter Intro %>
<%
  var chapterIntroShowEn = Boolean(utils.emptyIfNull(chapter.intro_en) || site.editMode);
  var chapterIntroShowAr = Boolean(utils.emptyIfNull(chapter.intro) || site.editMode);
%>
<% if ((heading.level == 1 || isFirstChapterSectionPage) && (chapterIntroShowEn || chapterIntroShowAr)) { %>
<section class="chapter-intro row mt-2">

  <% if (chapterIntroShowEn) { %>
  <section class="_e <%= chapterIntroShowAr ? 'col-md-6 col-sm-12' : 'col-12' %> intro" lang="en" data-id="<%= chapter.id %>" data-prop="toc.intro_en" data-reader-language-column="english" data-arabizi="true" data-markdown-source="<%= utils.emptyIfNull(chapter.intro_en) %>" data-markdown-empty-html="&hellip;">
    <% if (chapter.intro_en || site.editMode) { 
        const introEn = utils.markdownToHtml(chapter.intro_en) || '&hellip;';
    %>
    <div>
      <%- introEn %>
    </div>
    <% } %>
  </section>
  <% } %>

  <% if (chapterIntroShowAr) { %>
  <section class="_e <%= chapterIntroShowEn ? 'col-md-6 col-sm-12' : 'col-12' %> intro" lang="ar" data-id="<%= chapter.id %>" data-prop="toc.intro" data-reader-language-column="arabic" data-markdown-source="<%= utils.emptyIfNull(chapter.intro) %>" data-markdown-empty-html="&hellip;">
    <% if (chapter.intro || site.editMode) { 
        const introAr = utils.markdownToHtml(chapter.intro) || '&hellip;';
    %>
    <div>
      <%- introAr %>
    </div>
    <% } %>
    </section>
  <% } %>

</section>
<% } %>
