<%
  var introductionRailArticles = (locals.commentaryIntroductionArticles || []).filter(function (article) {
    return utils.trimToEmpty(article && article.intro) || utils.trimToEmpty(article && article.intro_en);
  });
  var introductionRailNextH1 = locals.commentaryIntroductionNextH1 || null;
  var introductionRailPreviousPassage = locals.commentaryIntroductionPreviousPassage || null;
  var introductionRailOutlines = locals.quranHeadingOutlines || {};
  var introductionRailTafsirBase = locals.quranHeadingTafsirBase || commentaryBookPath;
%>
<% if (introductionRailArticles.length > 0) { %>
<aside class="quran-heading-toc d-none d-lg-block quran-commentary-introduction-rail" data-quran-heading-toc data-quran-heading-initial-key="" data-quran-heading-tafsir-base="<%= introductionRailTafsirBase %>" aria-labelledby="quran-commentary-introduction-rail-title">
  <div class="quran-heading-toc-sticky">
    <a class="heading-toc-book-name" href="<%= utils.quranUrl(req, commentaryBookPath) %>"><%= commentaryNameEn.toUpperCase() %></a>
    <% introductionRailArticles.forEach(function (article, index) { %>
    <a class="nav-link quran-heading-toc-link quran-commentary-introduction-rail-link<%= index === 0 ? ' active' : '' %>" href="#introduction-<%= article.h2 %>" data-quran-introduction-heading="<%= article.h2 %>"<% if (index === 0) { %> aria-current="location"<% } %>><%= utils.trimToEmpty(article.title_en) || utils.trimToEmpty(article.title) || 'Introduction by the author' %></a>
    <% }); %>
    <a class="nav-link quran-heading-toc-link heading-toc-adjacent-h1 heading-toc-previous-h1" data-quran-heading-h1-prev<% if (introductionRailPreviousPassage) { %> href="<%= utils.quranUrl(req, introductionRailPreviousPassage.href) %>" rel="prev" title="Previous passage: <%= introductionRailPreviousPassage.title %>"><%= introductionRailPreviousPassage.title %><% } else { %> hidden><% } %></a>
    <strong id="quran-commentary-introduction-rail-title" class="quran-heading-toc-title" data-quran-heading-toc-surah>Introduction</strong>
    <nav class="nav flex-column quran-heading-toc-nav" data-quran-heading-toc-nav aria-label="Introduction articles">
      <a class="nav-link quran-heading-toc-link heading-toc-adjacent-h1 heading-toc-next-h1" data-quran-heading-h1-next<% if (introductionRailNextH1) { %> href="<%= utils.quranUrl(req, introductionRailNextH1.href) %>" rel="next" title="Next surah: <%= introductionRailNextH1.number %><%= introductionRailNextH1.title ? ` ${introductionRailNextH1.title}` : '' %>"><%= introductionRailNextH1.number %><% if (introductionRailNextH1.title) { %> <%= introductionRailNextH1.title %><% } %><% } else { %> hidden><% } %></a>
    </nav>
  </div>
  <script type="application/json" data-quran-heading-outlines><%- JSON.stringify(introductionRailOutlines).replace(/</g, '\\u003c') %></script>
</aside>
<% } %>
