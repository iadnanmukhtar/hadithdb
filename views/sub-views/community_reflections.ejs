<section class="community-reading community-reflections mt-4 reflection-section" id="comments" data-reflection-section aria-label="Reflections">
  <details class="reflection-disclosure" id="community-reflections-disclosure" data-reflection-disclosure>
    <summary class="reflection-disclosure-summary">
      <span class="reflection-disclosure-title fs-5">Reflect on this <%= post.kind === 'article' ? 'article' : 'post' %></span>
      <span class="reflection-disclosure-meta">
        <span class="reflection-count-link text-decoration-none" title="View reflections"><span class="bi bi-chat-right-text text-accent" aria-hidden="true"></span><span class="comment-widget-count fw-semibold text-accent" id="community-comments-count" title="0 reflections">0</span></span>
        <span class="reflection-disclosure-chevron bi bi-chevron-down" aria-hidden="true"></span>
      </span>
    </summary>
    <div class="mt-3 comment-feed">
      <div class="comment-feed-shell">
        <div id="community-comments" class="comment-thread"></div>
        <div class="comment-composer mt-3">
          <div class="comment-composer-body">
            <div class="comment-avatar comment-avatar-composer" id="community-comment-avatar" aria-hidden="true"><i class="bi bi-person-fill"></i></div>
            <div class="comment-composer-panel">
              <p id="community-comment-hint" class="comment-auth-hint text-muted small mb-2">Sign in from the top menu to add or reply to reflections.</p>
              <div class="comment-current-user" id="community-comment-user" hidden></div>
              <form id="community-comment-form" class="comment-form">
                <div class="mb-2"><label class="visually-hidden" for="community-comment-text">Your reflection</label><textarea id="community-comment-text" class="form-control comment-input" dir="auto" rows="3" maxlength="10000" placeholder="Write a reflection…" required disabled></textarea></div>
                <div class="comment-form-toolbar">
                  <p id="community-reply-target" class="comment-form-status text-muted small" hidden></p>
                  <div class="comment-form-buttons">
                    <button id="community-cancel-reply" class="btn btn-link btn-sm comment-form-link" type="button" hidden>Cancel reply</button>
                    <button class="btn btn-sm comment-submit-btn" type="submit" disabled title="Post reflection"><i class="bi bi-send-fill" aria-hidden="true"></i><span class="visually-hidden">Post reflection</span></button>
                  </div>
                </div>
                <p id="community-comment-status" class="small text-muted mb-0" role="status" aria-live="polite"></p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </details>
</section>
