<% if (Array.isArray(i.virtualReferences) && i.virtualReferences.length) { %>
<section class="hadith-metadata-section hadith-also-found-section mt-4" id="<%= metadataBase %>-also-found" data-toc-heading-target data-toc-heading-key="also-found">
	<header class="row heading hadith-metadata-heading py-2" dir="ltr"><h3 class="col-md-6 col-sm-12 fs-5 title" lang="en">Also found in</h3><h3 class="col-md-6 col-sm-12 title" lang="ar" dir="rtl">ورد أيضًا في</h3></header>
	<ul class="list-unstyled mb-0" dir="ltr">
		<% i.virtualReferences.forEach(function (ref) { %>
		<li class="py-2 border-bottom text-start">
			<div class="row">
				<div class="col-md-6 col-sm-12" lang="en" dir="ltr"><a class="hadith-also-found-reference fw-bold" href="<%= utils.urlFor(req, '/' + ref.referencePath) %>"><%= ref.book_alias %>:<%= ref.num %></a></div>
				<% if (ref.book_shortName) { %><div class="col-md-6 col-sm-12 text-end" lang="ar" dir="rtl"><a class="hadith-also-found-reference fw-bold" href="<%= utils.urlFor(req, '/' + ref.referencePath) %>"><%= ref.book_shortName %>:<bdi><%= ref.num_ar %></bdi></a></div><% } %>
			</div>
			<div class="row mt-1 hadith-also-found-headings">
				<% ['en', 'ar'].forEach(function (lang) {
					const chapterTitle = lang === 'en' ? (ref.h1_title_en || `Chapter ${utils.formatHadithHeadingNumber(String(ref.h1 ?? ''))}`) : ref.h1_title;
					const sectionTitle = lang === 'en' ? (ref.h2_title_en || (Number(ref.h2) ? `Section ${utils.formatHadithHeadingNumber(String(ref.h2))}` : '')) : ref.h2_title;
					if (!chapterTitle && !sectionTitle) return;
				%>
				<div class="col-md-6 col-sm-12<%= lang === 'ar' ? ' text-end' : '' %>" lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
					§
					<% if (sectionTitle) { %><a href="<%= utils.urlFor(req, '/' + ref.path) %>" title="<%= sectionTitle %>"><%= utils.truncate(sectionTitle, 30, true) %></a><% } %>
					<% if (sectionTitle && chapterTitle) { %><%= lang === 'en' ? 'in' : 'في' %><% } %>
					<% if (chapterTitle) { %><a href="<%= utils.urlFor(req, '/' + ref.book_alias + '/' + utils.formatHadithHeadingNumber(String(ref.h1 ?? ''))) %>" title="<%= chapterTitle %>"><%= utils.truncate(chapterTitle, 30, true) %></a><% } %>
				</div>
				<% }); %>
			</div>
		</li>
		<% }); %>
	</ul>
</section>
<% } %>
