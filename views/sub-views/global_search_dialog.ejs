<%
  var commandHadithBooks = (hadithSearchBooks || []).filter(function (book) {
    return book
      && Number(book.hidden) === 0
      && book.alias !== 'quran'
      && (book.type || book.book_type || book.book_model || 'hadith') === 'hadith';
  }).slice().sort(function (a, b) {
    return Number(a.ordinal || 0) - Number(b.ordinal || 0);
  });
  var seenCommandTafsirs = new Set();
  var commandTafsirBooks = (quranSearchTafsirs || []).filter(function (tafsir) {
    if (!tafsir || !tafsir.alias || Number(tafsir.hidden) === 1 || tafsir.source !== 'local' || seenCommandTafsirs.has(tafsir.alias))
      return false;
    seenCommandTafsirs.add(tafsir.alias);
    return true;
  }).slice().sort(function (a, b) {
    var aLabel = Tafsir.rawShortName(a, 'en') || a.shortName_en || a.name_en || a.alias;
    var bLabel = Tafsir.rawShortName(b, 'en') || b.shortName_en || b.name_en || b.alias;
    return aLabel.localeCompare(bLabel, 'en', { sensitivity: 'base' });
  });
  var seenCommandTranslations = new Set();
  var commandTranslationBooks = (quranSearchTranslations || []).filter(function (translation) {
    if (!translation || !translation.alias || Number(translation.hidden) === 1 || translation.source !== 'local' || seenCommandTranslations.has(translation.alias))
      return false;
    seenCommandTranslations.add(translation.alias);
    return true;
  }).slice().sort(function (a, b) {
    var aLabel = a.shortName_en || a.name_en || a.alias;
    var bLabel = b.shortName_en || b.name_en || b.alias;
    return aLabel.localeCompare(bLabel, 'en', { sensitivity: 'base' });
  });
  var selectedCommandHadithAliases = Array.isArray(hadithSearchBookAliases) ? hadithSearchBookAliases : [];
  var selectedCommandQuranBookFilters = Array.isArray(quranSearchBookFilters) ? quranSearchBookFilters : [];
  var selectedCommandCommentaryAliases = Array.isArray(quranSearchCommentaryAliases) ? quranSearchCommentaryAliases : [];
  var hasCommandSpecificCommentary = selectedCommandCommentaryAliases.length > 0;
  var commandQuranTextSelected = selectedCommandQuranBookFilters.includes('quran');
  var commandAllTafsirSelected = !hasCommandSpecificCommentary && selectedCommandQuranBookFilters.some(function (alias) { return alias === 'tafsir' || alias === 'commentaries'; });
%>
<dialog id="global-search-dialog" class="command-search-dialog" data-command-search-dialog data-initial-search-mode="<%= initialSearchMode %>"
  data-quran-search-context="<%= quranSearchContext || 'quran' %>" data-quran-commentary-alias="<%= quranSearchCommentaryAlias || '' %>"
  data-command-search-results-context="<%= isSearchResultsContext ? '1' : '0' %>">
  <div class="command-search-shell">
    <div class="command-search-heading">
      <div>
        <span class="command-search-kicker">Search the library</span>
        <h2 class="command-search-title">What are you looking for?</h2>
      </div>
      <button type="button" class="btn-close command-search-close" data-command-search-close aria-label="Close search"></button>
    </div>

    <ul class="nav nav-tabs book-catalog-tabs command-search-mode-switch" role="tablist" aria-label="Search collection">
      <li class="nav-item" role="presentation">
        <button type="button" class="nav-link command-search-mode" role="tab" data-command-search-mode="hadith" aria-controls="command-search-hadith-filters">
          <span class="command-search-mode-icon command-search-mode-icon-hadith">
            <%- include('menu_icon.ejs', { type: 'hadith', label: 'Hadith', className: 'me-0' }) %>
          </span>
          <span class="command-search-mode-label">General</span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button type="button" class="nav-link command-search-mode" role="tab" data-command-search-mode="quran" aria-controls="command-search-quran-filters">
          <span class="command-search-mode-icon command-search-mode-icon-quran">
            <%- include('menu_icon.ejs', { type: 'quran', label: 'Quran', className: 'me-0' }) %>
          </span>
          <span class="command-search-mode-label">Quran + Tafsir</span>
        </button>
      </li>
    </ul>

    <form class="command-search-form" action="<%= initialSearchMode === 'quran' ? quranSearchAction : hadithSearchAction %>" method="get"
      data-command-search-form data-hadith-search-action="<%= hadithSearchAction %>" data-quran-search-action="<%= quranSearchAction %>"
      data-quran-tafsir-base="<%= quranSearchTafsirSlug ? `/quran/tafsir/${encodeURIComponent(quranSearchTafsirSlug)}` : '' %>">
      <% if (quranSearchReturnMode) { %><input type="hidden" name="mode" value="<%= quranSearchReturnMode %>" data-command-quran-state><% } %>
      <% if (quranSearchTafsirSlug) { %><input type="hidden" name="tafsirMode" value="<%= quranSearchTafsirSlug %>" data-command-quran-state><% } %>

      <div class="command-search-input-wrap" data-command-search-direction-container dir="<%= /^[\s\u200e\u200f]*[\u0600-\u06ff]/.test(searchQuery || '') ? 'rtl' : 'ltr' %>">
        <i class="bi bi-search<%= /^[\s\u200e\u200f]*[\u0600-\u06ff]/.test(searchQuery || '') ? ' is-rtl-search' : '' %>" data-command-search-icon aria-hidden="true"></i>
        <input role="search" type="search" class="form-control command-search-input<%= /^[\s\u200e\u200f]*[\u0600-\u06ff]/.test(searchQuery || '') ? ' command-search-arabic-text' : '' %>" name="q" value="<%= searchQuery || '' %>" dir="<%= /^[\s\u200e\u200f]*[\u0600-\u06ff]/.test(searchQuery || '') ? 'rtl' : 'ltr' %>" placeholder="Search Hadith, Sharh, Sirah, Tafsir, and Quran..." aria-label="General search" autocomplete="off" autocapitalize="none" spellcheck="false">
        <button type="button" class="btn command-search-funnel-toggle" data-command-filter-toggle aria-label="Search filters" title="Search filters" aria-expanded="false" aria-controls="command-search-filter-options"><i class="bi bi-funnel" aria-hidden="true"></i><span class="badge rounded-pill command-search-filter-count" data-command-search-filter-count aria-live="polite">0</span></button>
      </div>

      <details id="command-search-filter-options" class="command-search-filter-details command-search-combined-filters" data-command-search-combined-filters>
        <summary hidden>Search filters</summary>
        <div class="command-search-filter-popover">
          <label class="page-content-filter input-group command-search-filter-find">
            <span class="input-group-text bi bi-funnel" aria-hidden="true"></span>
            <input type="search" class="form-control" placeholder="Filter books and sources" aria-label="Filter books and sources" data-command-search-filter-search="all" autocomplete="off">
          </label>
          <section id="command-search-hadith-filters" class="command-search-filter-panel" data-command-search-panel="hadith">
            <div class="command-search-source-options">
              <label class="command-search-book-option">
                <input class="form-check-input" type="checkbox" name="b" value="sirah" <%= selectedCommandHadithAliases.includes('sirah') ? 'checked' : '' %> data-command-filter data-command-filter-label="Sirah">
                <span>Sirah</span>
              </label>
              <label class="command-search-book-option">
                <input class="form-check-input" type="checkbox" name="b" value="hadith" <%= selectedCommandHadithAliases.includes('hadith') ? 'checked' : '' %> data-command-filter data-command-filter-label="Hadith">
                <span>Hadith</span>
              </label>
              <label class="command-search-book-option">
                <input class="form-check-input" type="checkbox" name="b" value="sharh" <%= selectedCommandHadithAliases.includes('sharh') ? 'checked' : '' %> data-command-filter data-command-filter-label="Sharh" data-command-all-sharh>
                <span>Sharh</span>
              </label>
            </div>
            <div data-command-search-book-list="hadith">
              <details class="command-search-filter-details command-search-filter-group" data-command-filter-group>
                <summary>
                  <span>Hadith Book Groups</span>
                  <span class="badge rounded-pill command-search-filter-count" data-command-search-filter-count>0</span>
                </summary>
                <div class="command-search-filter-popover">
                  <div class="command-search-book-list" data-command-search-book-list="groups">
                    <% BookGroups.list('hadith').forEach(function (group) { var selected = selectedCommandHadithAliases.indexOf(group.value) >= 0; %>
                    <label class="command-search-book-option" data-command-search-book-option>
                      <input class="form-check-input" type="checkbox" name="b" value="<%= group.value %>" <%= selected ? 'checked' : '' %> data-command-filter data-command-filter-label="<%= group.label %>" data-search-group-aliases="<%= JSON.stringify(group.aliases) %>">
                      <span>
                        <%= group.label %>
                      </span>
                    </label>
                    <% }); %>
                  </div>
                </div>
              </details>
              <details class="command-search-filter-details command-search-filter-group" data-command-filter-group>
                <summary>
                  <span>Hadith Books</span>
                  <span class="badge rounded-pill command-search-filter-count" data-command-search-filter-count>0</span>
                </summary>
                <div class="command-search-filter-popover">
                  <div class="command-search-book-list" data-command-search-book-list="hadith">
                    <% commandHadithBooks.forEach(function (book) { var label = book.shortName_en || book.name_en || book.alias; var selected = selectedCommandHadithAliases.indexOf(book.alias) >= 0; %>
                    <label class="command-search-book-option" data-command-search-book-option>
                      <input class="form-check-input" type="checkbox" name="b" value="<%= book.alias %>" <%= selected ? 'checked' : '' %> data-command-filter data-command-filter-label="<%= label %>">
                      <span>
                        <%= label %>
                      </span>
                    </label>
                    <% }); %>
                  </div>
                </div>
              </details>
              <details class="command-search-filter-details command-search-filter-group" data-command-filter-group>
                <summary><span>Sirah Books</span><span class="badge rounded-pill command-search-filter-count" data-command-search-filter-count>0</span></summary>
                <div class="command-search-filter-popover">
                  <% (global.books || []).filter(function (book) { return book.type === 'sirah' && Number(book.hidden) !== 1; }).forEach(function (book) { %>
                  <label class="command-search-book-option" data-command-search-book-option>
                    <input class="form-check-input" type="checkbox" name="b" value="<%= book.alias %>" <%= selectedCommandHadithAliases.includes(book.alias) ? 'checked' : '' %> data-command-filter data-command-filter-label="<%= book.shortName_en || book.alias %>">
                    <span><%= book.shortName_en || book.alias %></span>
                  </label>
                  <% }); %>
                </div>
              </details>
              <details class="command-search-filter-details command-search-filter-group" data-command-filter-group>
                <summary>
                  <span>Sharh Books</span>
                  <span class="badge rounded-pill command-search-filter-count" data-command-search-filter-count>0</span>
                </summary>
                <div class="command-search-filter-popover">
                  <div class="command-search-book-list" data-command-search-book-list="sharh">
                    <% (global.books || []).filter(function (book) { return book.type === 'sharh'; }).forEach(function (book) { %>
                    <label class="command-search-book-option" data-command-search-book-option>
                      <input class="form-check-input" type="checkbox" name="b" value="<%= book.alias %>" <%= selectedCommandHadithAliases.includes(book.alias) ? 'checked' : '' %> data-command-filter data-command-sharh-book data-command-filter-label="<%= book.shortName_en || book.alias %>">
                      <span>
                        <%= book.shortName_en || book.alias %>
                      </span>
                    </label>
                    <% }); %>
                  </div>
                </div>
              </details>
            </div>
          </section>
          <section id="command-search-quran-filters" class="command-search-filter-panel" data-command-search-panel="quran">
            <div class="command-search-source-options">
              <label class="command-search-book-option">
                <input class="form-check-input" type="checkbox" name="b" value="quran" <%= commandQuranTextSelected ? 'checked' : '' %> data-command-filter data-command-filter-label="Quran">
                <span>Quran</span>
              </label>
              <label class="command-search-book-option">
                <input class="form-check-input" type="checkbox" name="b" value="tafsir" <%= commandAllTafsirSelected ? 'checked' : '' %> data-command-filter data-command-filter-label="Tafsir" data-command-all-tafsir>
                <span>Tafsir</span>
              </label>
            </div>
            <div data-command-search-book-list="quran">
              <% var tafsirGroups = BookGroups.list('tafsir').map(function (group) { return { ...group, aliases: group.aliases.filter(function (alias) { return commandTafsirBooks.some(function (book) { return book.alias === alias; }); }) }; }).filter(function (group) { return group.aliases.length; }); if (tafsirGroups.length) { %>
              <details class="command-search-filter-details command-search-filter-group" data-command-filter-group>
                <summary><span>Tafsir Book Groups</span><span class="badge rounded-pill command-search-filter-count" data-command-search-filter-count>0</span></summary>
                <div class="command-search-filter-popover"><div class="command-search-book-list">
                  <% tafsirGroups.forEach(function (group) { %>
                  <label class="command-search-book-option" data-command-search-book-option>
                    <input class="form-check-input" type="checkbox" name="tafsir" value="<%= group.id %>" data-command-filter data-command-filter-label="<%= group.label %>" data-search-group-aliases="<%= JSON.stringify(group.aliases) %>" <%= selectedCommandCommentaryAliases.includes(group.id) ? 'checked' : '' %>>
                    <span><%= group.label %></span>
                  </label>
                  <% }); %>
                </div></div>
              </details>
              <% } %>
              <details class="command-search-filter-details command-search-filter-group" data-command-filter-group>
                <summary>
                  <span>Tafsir Books</span>
                  <span class="badge rounded-pill command-search-filter-count" data-command-search-filter-count>0</span>
                </summary>
                <div class="command-search-filter-popover">
                  <div class="command-search-book-list" data-command-search-book-list="tafsir">
                    <% commandTafsirBooks.forEach(function (tafsir) {
                    var label = Tafsir.rawShortName(tafsir, 'en') || tafsir.shortName_en || tafsir.name_en || tafsir.alias;
                    var selected = selectedCommandCommentaryAliases.indexOf(tafsir.alias) >= 0;
                    %>
                    <label class="command-search-book-option" data-command-search-book-option>
                      <input class="form-check-input" type="checkbox" name="tafsir" value="<%= tafsir.alias %>" <%= selected ? 'checked' : '' %> data-command-filter data-command-commentary-kind="tafsir" data-command-filter-label="<%= label %>">
                      <span>
                        <%= label %>
                      </span>
                    </label>
                    <% }); %>
                  </div>
                </div>
              </details>
              <details class="command-search-filter-details command-search-filter-group" data-command-filter-group>
                <summary>
                  <span>Translations</span>
                  <span class="badge rounded-pill command-search-filter-count" data-command-search-filter-count>0</span>
                </summary>
                <div class="command-search-filter-popover">
                  <div class="command-search-book-list" data-command-search-book-list="translations">
                    <% commandTranslationBooks.forEach(function (translation) {
                    var label = translation.shortName_en || translation.name_en || translation.alias;
                    var selected = selectedCommandCommentaryAliases.indexOf(translation.alias) >= 0;
                    %>
                    <label class="command-search-book-option" data-command-search-book-option>
                      <input class="form-check-input" type="checkbox" name="tafsir" value="<%= translation.alias %>" <%= selected ? 'checked' : '' %> data-command-filter data-command-commentary-kind="translation" data-command-filter-label="<%= label %>">
                      <span>
                        <%= label %>
                      </span>
                    </label>
                    <% }); %>
                  </div>
                </div>
              </details>
            </div>
          </section>
        </div>
      </details>

      <div class="command-search-selected" data-command-search-selected hidden>
        <span class="command-search-selected-label">Searching in</span>
        <div class="command-search-pills" data-command-search-pills></div>
      </div>

      <p class="command-search-hint mb-0">
        Start typing for suggestions. Use <kbd>↑</kbd><kbd>↓</kbd> to move and <kbd>Enter</kbd> to open.
      </p>
    </form>
  </div>
</dialog>
