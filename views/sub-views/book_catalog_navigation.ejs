<%
  var catalogNavigationType = page.context.bookCatalogInitialType;
  var catalogNavigationTabs = [
    { key: 'mushaf', label: 'Mushaf' },
    { key: 'tafsir-all', query: 'tafsir', label: 'Tafsir' },
    { key: 'translations', query: 'translation', label: 'Translations' },
    { key: 'hadith', label: 'Hadith' },
    { key: 'sharh', label: 'Sharḥ' },
    { key: 'sirah', query: 'history', label: 'History & Sirah' }
  ];
%>
<%- include('section_navigation.ejs', {
  tabs: true, label: 'Book collections', pickerLabel: 'Collection', pickerName: 'Book collection',
  items: catalogNavigationTabs.map(tab => ({
    label: tab.label, href: (page.context.catalogPath || '/books') + '?' + (tab.query || tab.key),
    id: 'book-catalog-' + tab.key, active: tab.key === catalogNavigationType
  }))
}); %>
