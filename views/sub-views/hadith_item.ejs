<%
	hashtag = String(`${i.book_alias || ''}${i.num || i.num0 || i.id || ''}`).replace(/[-\:]/g, '_');
	var isQuranItem = i.remark == 2 || i.book_alias === 'quran' || (i.actual && i.actual.book_alias === 'quran');
	var _p = searchResult && isQuranItem ? 'partial' : '';
	var isContentTranslationLang = lang !== 'en' && lang !== 'ar';
	var langSuff = (lang === 'en') ? '_en' : '';
	function editProp(field) {
		return isContentTranslationLang ? `content_translation.${lang}.${field}` : `hadith.${field}${langSuff}`;
	}
	function editClass(classes) {
		return `${site.editMode ? '_e ' : ''}${classes || ''}`.trim();
	}
	function attrValue(value) {
		return utils.emptyIfNull(value)
			.toString()
			.replace(/&/g, '&amp;')
			.replace(/"/g, '&quot;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;');
	}
	function editAttrs(field, options) {
		if (!site.editMode)
			return '';
		options = options || {};
		const id = options.id || (i.actual ? i.actual.id : i.id);
		const prop = options.prop || editProp(field);
		const arabizi = options.arabizi;
		const markdown = options.markdown;
		const emptyHtml = options.emptyHtml;
		const placeholder = options.placeholder;
		return [
			`data-id="${attrValue(id)}"`,
			`data-prop="${attrValue(prop)}"`,
			arabizi !== undefined ? `data-arabizi="${attrValue(arabizi)}"` : '',
			markdown !== undefined ? `data-markdown-source="${attrValue(markdown)}"` : '',
			emptyHtml !== undefined ? `data-markdown-empty-html="${attrValue(emptyHtml)}"` : '',
			placeholder !== undefined ? `data-placeholder="${attrValue(placeholder)}" aria-label="${attrValue(placeholder)}"` : ''
		].filter(Boolean).join(' ');
	}
	function contentTranslationForLang(code) {
		if (!Array.isArray(i.contentTranslations))
			return {};
		return i.contentTranslations.find(function (translation) {
			return translation && translation.code === code;
		}) || {};
	}
	var chapter = page.context.chapter;
	var sections = [];
	var isSimilarSection = typeof similarSection !== 'undefined' && similarSection;
	var isContentTranslationBrowse = typeof contentTranslationBrowse !== 'undefined' && contentTranslationBrowse;
	var paymentFeatureEnabled = locals.paymentFeatureEnabled === true;
	var langData = isContentTranslationLang ? contentTranslationForLang(lang) : (i[lang] || {});
	var langActual = !isContentTranslationLang && i[lang] ? i[lang].actual : null;
	var langDir = langData.dir || (['ar', 'fa', 'he', 'ur'].includes(lang) ? 'rtl' : 'ltr');
	var langFontClass = langData.fontClass || '';
	var editLanguageLabel = lang === 'ar' ? 'Arabic' : (langData.label || (lang === 'en' ? 'English' : lang.toUpperCase()));
	function editPlaceholder(field) {
		const arabic = { chain: 'سند الحديث', body: 'متن الحديث', footnote: 'حاشية الحديث', note: 'ملاحظة الحديث' };
		const translated = { chain: `${editLanguageLabel} chain`, body: `${editLanguageLabel} hadith text`, footnote: `${editLanguageLabel} footnote`, note: `${editLanguageLabel} note` };
		return lang === 'ar' ? arabic[field] : translated[field];
	}
	var adminContentTranslationOptionsList = Array.isArray(typeof adminContentTranslationOptions !== 'undefined' ? adminContentTranslationOptions : null) ? adminContentTranslationOptions : [];
	var adminContentTranslationSelectedCode = (typeof adminContentTranslationSelected !== 'undefined' ? adminContentTranslationSelected : lang) || 'en';
	var adminContentTranslationId = typeof adminContentTranslationItemId !== 'undefined' ? adminContentTranslationItemId : (i.actual ? i.actual.id : i.id);
	var showAdminContentTranslationSwitcher = site.editMode && lang !== 'ar' && adminContentTranslationOptionsList.length;
	var contentTranslationAttrs = isContentTranslationLang ? ` dir="${langDir}" data-content-language="${lang}"${langFontClass ? ` data-content-language-font-class="${langFontClass}"` : ''}` : '';
	var contentTranslationClass = isContentTranslationLang && langFontClass ? ` ${langFontClass}` : '';
	if (chapter)
		sections = chapter.sections; 
	const debugDocId = i.actual ? i.actual.id : i.id;
	const debugScore = Number.isFinite(i._score) ? i._score : '';
	function linkTitle(title) {
		title = title || '';
		if (!searchResult)
			return title;
		var parts = [];
		if (title)
			parts.push(title);
		parts.push(`doc=${debugDocId}`);
		if (debugScore !== '')
			parts.push(`score=${debugScore}`);
		return parts.join(' | ');
	}
	function plainText(text) {
		return utils.emptyIfNull(text).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
	}
	function bilingualLabel(english, arabic) {
		return [english, arabic].filter(Boolean).join(' — ');
	}
	const sharhBody = !isQuranItem ? plainText(i.ar?.body || '') : '';
	const hadithClassification = i.hdithClassification || i.hdithMetadata || {};
	const hadithClassificationOptions = i.hdithClassificationOptions || i.hdithMetadata || {};
	const sourceHadithNarrator = i.hdithNarrator || (i.hdithMetadata && i.hdithMetadata.narrator ? {
		name: i.hdithMetadata.narrator,
		name_en: i.hdithMetadata.narratorEn
	} : null);
	function hasReturnedSearchHighlight(fields) {
		return !!searchResult && !!i._highlight && fields.some(function (field) {
			return Array.isArray(i._highlight[field]) && i._highlight[field].some(function (fragment) {
				return !!utils.trimToEmpty(fragment);
			});
		});
	}
	const hasReturnedSearchChain = hasReturnedSearchHighlight(lang === 'ar' ? ['chain'] : ['chain_en', 'chain_en_search']);
	const hasReturnedSearchFootnote = hasReturnedSearchHighlight(lang === 'ar' ? ['footnote'] : ['footnote_en', 'footnote_en_search']);
	const hasReturnedSearchText = hasReturnedSearchHighlight(lang === 'ar'
		? ['title', 'title_search_ar', 'chain', 'body', 'body_search_ar', 'body_start', 'footnote']
		: ['title_en', 'title_en_search', 'title_search_en', 'chain_en', 'chain_en_search', 'body_en', 'body_en_search', 'footnote_en', 'footnote_en_search']);
	const compactUnmatchedSearchBody = !!searchResult && !isQuranItem && !hasReturnedSearchText;
	const showPrimaryNarratorOnly = !isQuranItem && i.single !== true
		&& (page && (page.menu === 'Chapter' || page.menu === 'Section')
			|| (!!searchResult && !hasReturnedSearchChain && !hasReturnedSearchFootnote));
	const primaryNarratorText = sourceHadithNarrator
		? (lang === 'ar' ? sourceHadithNarrator.name : (sourceHadithNarrator.name_en || arabic.toALALCName(sourceHadithNarrator.name)))
		: '';
	const narratorEditProp = lang === 'ar' ? 'hdith_metadata.narrator' : 'hdith_metadata.narrator_en';
	const narratorEditPlaceholder = lang === 'ar' ? 'راوي الحديث' : 'Hadith narrator';
	const narratorInlineEditable = site.editMode && (lang === 'ar' || lang === 'en');
	const showPrimaryNarrator = showPrimaryNarratorOnly && !!primaryNarratorText;
	const displayedChain = showPrimaryNarrator ? primaryNarratorText : langData.chain;
	const itemLinkTitleSource = langData.title || langData.body || displayedChain;
	const hadithAttribution = hadithClassification.attribution || null;
	const hadithChainCategories = Array.isArray(hadithClassification.chainCategories) ? hadithClassification.chainCategories : [];
	const hadithAttributionOptions = Array.isArray(hadithClassificationOptions.attributionOptions) ? hadithClassificationOptions.attributionOptions : [];
	const hadithChainCategoryOptions = Array.isArray(hadithClassificationOptions.chainCategoryOptions) ? hadithClassificationOptions.chainCategoryOptions : [];
	const selectedChainCategoryKeys = hadithChainCategoryOptions.filter(function (option) { return hadithChainCategories.some(function (category) { return category.key === option.key; }); }).map(function (category) { return category.key; }).join(',');
	const hadithChainCategorySelections = [{ value: '', label: 'No chain classification — بلا تصنيف للسند' }];
	for (let selectionMask = 1; selectionMask < (1 << hadithChainCategoryOptions.length); selectionMask++) {
		const selection = hadithChainCategoryOptions.filter(function (_category, categoryIndex) { return selectionMask & (1 << categoryIndex); });
		hadithChainCategorySelections.push({
			value: selection.map(function (category) { return category.key; }).join(','),
			label: `${selection.map(function (category) { return category.title_en; }).join(' · ')} — ${selection.map(function (category) { return category.title; }).join(' · ')}`
		});
	}
	const hasHadithClassification = !!hadithAttribution || hadithChainCategories.length > 0;
	const showLegacyInlineGrade = !isQuranItem && (i.single === true || i.randomTocItem === true || isSimilarSection || (page && (page.menu === 'Chapter' || page.menu === 'Section')));
	const legacyGradeOverride = i.legacyGradeOverride || null;
	const showTranslatedLegacyGradeOverride = !legacyGradeOverride || lang !== 'en' || !!(legacyGradeOverride.grade_en && legacyGradeOverride.grader_en);
	const itemRefPath = `/${i.actual ? i.actual.book_alias : i.book_alias}:${i.actual ? i.en?.actual?.num || i.actual?.num || i.num : i.en?.num || i.num}`;
	const quranSearchReturnMode = searchResult && (req.query.mode === 'mushaf' || req.query.mode === 'study') ? req.query.mode : '';
	const itemHref = isQuranItem
		? utils.quranUrl(req, `${itemRefPath}${quranSearchReturnMode === 'mushaf' ? '?mushaf' : ''}`)
		: utils.urlFor(req, itemRefPath);
	const bookmarkRef = `${i.actual ? i.actual.book_alias : i.book_alias}:${i.actual ? i.en?.actual?.num || i.actual?.num || i.num : i.en?.num || i.num}`;
	const bookmarkTitle = langData.title || i.title_en || i.title || bookmarkRef;
	const quranTafsirHref = isQuranItem && i.ref ? utils.quranUrl(req, `/${i.ref}`) : '';
	const itemBookShortName = (() => {
		const shortName = i.actual ? (langActual?.book_shortName || i.actual?.book_shortName || i.book_shortName) : (langData.book_shortName || i.book_shortName);
		if (isQuranItem && lang === 'ar')
			return 'مقطع';
		return shortName;
	})();
	const itemSectionTitle = (() => {
		if (isQuranItem && lang === 'ar')
			return 'مقطع';
		return utils.truncate(langData.h2_title, 30, true) || 'Section';
	})();
	const itemChapterTitle = (() => {
		if (isQuranItem && lang === 'ar')
			return utils.trimToEmpty(langData.h1_title) || 'سورة';
		return utils.truncate(langData.h1_title, 30, true) || 'Chapter';
	})();
	const quranAyahMarkerRef = utils.emptyIfNull(i.ref || i.num || langData.num || '').replace(/^quran:/, '');
	const quranAyahRefParts = arabic.toLatinDigits(quranAyahMarkerRef).split(/[:/-]/).filter(Boolean);
	const canonicalQuranAyahRef = isQuranItem && quranAyahRefParts.length === 2
		&& Number(quranAyahRefParts[0]) >= 1 && Number(quranAyahRefParts[1]) >= 1
		? `${Number(quranAyahRefParts[0])}:${Number(quranAyahRefParts[1])}`
		: '';
	const quranMemorizationAttrs = canonicalQuranAyahRef ? ` data-quran-ref="${canonicalQuranAyahRef}"` : '';
	const quranSearchSurah = isQuranItem && searchResult ? (global.surahs || []).find(function (surah) { return Number(surah.num) === Number(quranAyahRefParts[0] || i.h1); }) : null;
	const quranSearchRevelation = quranSearchSurah && /^mad/i.test((quranSearchSurah.revelation_en || '').toString()) ? 'madani' : 'makki';
	const quranTranslationAttrs = isQuranItem && lang === 'en' && searchResult && quranAyahRefParts.length >= 2
		? ` data-quran-translation-target="1" data-quran-surah="${quranAyahRefParts[0]}" data-quran-ayah="${quranAyahRefParts[1]}"`
		: '';
	const defaultTranslationBook = (global.commentaries || []).find(function (book) {
		return book && book.type === 'trans' && book.source === 'default';
	}) || {};
	const defaultTranslationShortName = defaultTranslationBook.shortName_en || defaultTranslationBook.shortName || 'Abdel Haleem';
	const quranAyahMarkerNum = (() => {
		if (!canonicalQuranAyahRef || lang !== 'ar')
			return '';
		const ayahPart = canonicalQuranAyahRef.split(':')[1] || '';
		return ayahPart ? arabic.toArabicDigits(arabic.toLatinDigits(ayahPart) || ayahPart) : '';
	})();
%>

<section class="col-md-6 col-sm-12 h<%= contentTranslationClass %>" lang="<%=lang%>" data-reader-language-column="<%= lang === 'ar' ? 'arabic' : 'english' %>"<%- contentTranslationAttrs %>>

	<%# Chain  ............................................................. %>
	<section lang="<%=lang%>"<%- contentTranslationClass ? ` class="${contentTranslationClass.trim()}"` : '' %><%- contentTranslationAttrs %>>

		<%# Rating %>
		<%- (lang === 'en' && i.rating !== undefined) ? `<span class="bi bi-reception-${i.rating}"></span>` : '' %>

		<!--
		<%# Verification %>
		<% if (lang === 'en' && site.editMode) { %>
			<input class="_e form-check-input" title="Verified" type="text" size="1" value="<%- i.verified ? 'x' : '' %>"" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.verified">
		<% } else if (lang === 'en') { %>
			<%- i.verified ? `<span title="Verified Translation" class="bi bi-patch-check-fill"></span>` : '' %>
		<% } %>
		-->

		<%# Highlight Date %>
		<% if (lang === 'en' && site.editMode) {
			var hlDate = null;
			try {
				if (i.highlight) {
					if (typeof i.highlight === 'string')
						i.highlight = new Date(i.highlight);
					hlDate = `${i.highlight.getFullYear()}-${i.highlight.getMonth()+1}-${i.highlight.getDate()}`; 
				}
			} catch (e) {
				console.log(i.highlight);
				console.log(typeof i.highlight);
				console.log(e);
			} %>
			<span class="_e form-input" style="width:100px;" title="Highlight Date" type="text" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.highlight" data-placeholder="Highlight date" aria-label="Highlight date"><%- hlDate || '' %></span>
		<% 	
		    } %>

		<%# Virtual Num %>
		<% if (i.book_virtual) { %>
			(<span<% if (site.editMode) { %> class="_e" data-id="<%= i.id %>" data-prop="hadith_virtual.num"<% } %> title="Virtual Num"><%- (langData.num) ? `${langData.num}` : '' %></span>)
		<% } %>

		<%# Admin: Virtul Num 0%>
		<% if (lang === 'en' && site.editMode) { %>
			(<span class="_e" title="Virtual Num0" data-id="<%= i.id %>" data-prop="hadith_virtual.num0" data-placeholder="Internal reference" aria-label="Internal reference"><%- i.num0 || '' %></span>)
			(<span class="_e" title="Num" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.num" data-placeholder="Hadith number" aria-label="Hadith number"><%- i.actual ? (langActual?.num || i.actual?.num || i.num || '') : (langData.num || i.num || '') %></span>)
		<% } %>

		<%# Item Number + Chain %>
		<b><a href="<%= itemHref %>" title="<%= linkTitle(itemLinkTitleSource) %>"><%= `${itemBookShortName}:${i.actual ? (langActual?.num || i.actual?.num || i.num) : (langData.num || i.num)}` %></a></b><% if (displayedChain || site.editMode) { %> –
		<% if (showPrimaryNarrator) { %>
			<% if (narratorInlineEditable) { %><input type="search" class="_e chain hadith-admin-combobox hadith-primary-narrator-input <%= _p %> l3" title="Ḥadīth Narrator" value="<%= displayedChain %>" data-narrator-language="<%= lang %>" autocomplete="off" autocapitalize="none" spellcheck="false" <%- editAttrs('narrator', { prop: narratorEditProp, arabizi: 'false', placeholder: narratorEditPlaceholder }) %>><% } else { %><span class="chain <%= _p %> l3" title="Ḥadīth Narrator"><%= displayedChain %></span><% } %>
		<% } else { %>
			<span class="<%= editClass(`chain ${_p} l3`) %>" title="Ḥadīth Chain"<%- site.editMode ? ` ${editAttrs('chain', { arabizi: isContentTranslationLang ? 'false' : 'true', placeholder: editPlaceholder('chain') })}` : '' %><% if (paymentFeatureEnabled && !site.editMode && !isQuranItem && lang === 'en') { %> data-content-translation-field="chain"<% } %>><%- displayedChain || '' %></span>
		<% } %>
		<% } %>
		<% if (narratorInlineEditable && showPrimaryNarratorOnly && !primaryNarratorText) { %>
			<div class="hadith-narrator-editor <%= _p %> l3"><span class="text-muted"><%= lang === 'ar' ? 'الراوي:' : 'Narrator:' %></span> <input type="search" class="_e hadith-admin-combobox hadith-primary-narrator-input" title="Ḥadīth Narrator" value="" data-narrator-language="<%= lang %>" autocomplete="off" autocapitalize="none" spellcheck="false" <%- editAttrs('narrator', { prop: narratorEditProp, arabizi: 'false', placeholder: narratorEditPlaceholder }) %>></div>
		<% } %>
		<% if (narratorInlineEditable && !isQuranItem && i.single === true) { %>
			<div class="hadith-narrator-editor <%= _p %> l3"><span class="text-muted"><%= lang === 'ar' ? 'الراوي:' : 'Narrator:' %></span> <input type="search" class="_e hadith-admin-combobox hadith-primary-narrator-input" title="Ḥadīth Narrator" value="<%= primaryNarratorText %>" data-narrator-language="<%= lang %>" autocomplete="off" autocapitalize="none" spellcheck="false" <%- editAttrs('narrator', { prop: narratorEditProp, arabizi: 'false', placeholder: narratorEditPlaceholder }) %>></div>
		<% } %>

	</section>

	<%# Body  .............................................................. %>
	<%
		const bodyMarkdown = utils.emptyIfNull(langData.body) || utils.emptyIfNull(langData.text);
		const bodyHtml = utils.markdownToHtml(bodyMarkdown);
		const enableHadithContentLanguage = paymentFeatureEnabled && !site.editMode && !isQuranItem && lang === 'en';
		const contentAvailableTranslations = enableHadithContentLanguage && Array.isArray(i.contentTranslations) ? JSON.stringify(i.contentTranslations) : '';
	%>
	<section lang="<%=lang%>" class="body <%=_p%> l5<%= contentTranslationClass %>" title="Ḥadīth Body"<%- contentTranslationAttrs %><% if (enableHadithContentLanguage) { %> data-content-translation-container="1"<% } %>>
		<div class="<%= editClass(`hadith-body-content ${_p}${compactUnmatchedSearchBody ? ' search-result-unmatched-body' : ''}${isQuranItem && lang === 'ar' ? ' quran-hafs' : ''}${contentTranslationClass}`) %>"<%- quranMemorizationAttrs %><%- quranTranslationAttrs %><%- contentTranslationAttrs %><%- site.editMode ? ` ${editAttrs('body', { arabizi: isContentTranslationLang ? 'false' : 'true', markdown: bodyMarkdown, emptyHtml: editPlaceholder('body'), placeholder: editPlaceholder('body') })}` : '' %><% if (!site.editMode && bodyMarkdown) { %> data-markdown-source="<%= bodyMarkdown %>"<% } %><% if (enableHadithContentLanguage) { %> data-content-translation-item-type="hadith" data-content-translation-item-id="<%= i.actual ? i.actual.id : i.id %>" data-content-translation-language="en" data-content-translation-field="body" data-content-translation-existing="<%= bodyMarkdown ? 'true' : 'false' %>" data-content-available-translations="<%= contentAvailableTranslations %>"<% if (isContentTranslationBrowse) { %> data-content-translation-show-control="true"<% } %><% if (isSimilarSection) { %> data-content-translation-auto-only="true"<% } %><% } %>>
				<% if (isQuranItem && lang === 'ar' && canonicalQuranAyahRef) { %><span data-quran-script-text="ayah" data-quran-ref="<%= canonicalQuranAyahRef %>"><%- bodyHtml %></span><% } else { %><%- bodyHtml %><% } %>
				<% if (quranAyahMarkerNum) { %>&nbsp;<button type="button" class="quran-ayah-hero-trigger quran-ayah-end-marker" data-quran-ayah-actions="1" data-quran-ref="<%= canonicalQuranAyahRef %>" data-quran-href="<%= itemHref %>" aria-haspopup="menu" aria-expanded="false" aria-label="Actions for Quran <%= canonicalQuranAyahRef %>">۝<%= quranAyahMarkerNum %></button><% } %>
			</div>
		<% if (isQuranItem && lang === 'en' && searchResult && langData.body) { %>
			<span class="quran-translation-attribution" data-quran-translation-attribution="1">— <%= defaultTranslationShortName %></span>
		<% } %>
	</section>

	<%# Footer  ............................................................ %>
	<% if ((langData.footnote && !compactUnmatchedSearchBody) || site.editMode) {
		const footnoteMarkdown = utils.emptyIfNull(langData.footnote);
		const footnoteHtml = utils.markdownToHtml(langData.footnote);
		const footnoteContent = footnoteHtml || editPlaceholder('footnote');
	%>
		<footer lang="<%=lang%>" class="<%= editClass(`footnote ${_p} l2${contentTranslationClass}`) %>" title="Ḥadīth Footnote"<%- contentTranslationAttrs %><%- site.editMode ? ` ${editAttrs('footnote', { arabizi: isContentTranslationLang ? 'false' : 'true', markdown: footnoteMarkdown, emptyHtml: editPlaceholder('footnote'), placeholder: editPlaceholder('footnote') })}` : '' %><% if (!site.editMode && footnoteMarkdown) { %> data-markdown-source="<%= footnoteMarkdown %>"<% } %><% if (paymentFeatureEnabled && !site.editMode && !isQuranItem && lang === 'en') { %> data-content-translation-field="footnote"<% } %>>
			<%- footnoteContent %>
		</footer>
	<% } %>

	<% if (i.book_virtual) { %>
		<%# Author Note  ....................................................... %>
		<% if (langData.note || site.editMode) {
			const noteMarkdown = utils.emptyIfNull(langData.note);
			const noteHtml = utils.markdownToHtml(langData.note);
			const noteContent = noteHtml || editPlaceholder('note');
		%>
			<aside lang="<%=lang%>" class="<%= editClass(`note ${_p} l2`) %>" title="Ḥadīth Note"<% if (lang === 'en') { %> data-content-translation-actions-anchor="1"<% } %><% if (site.editMode) { %> data-id="<%= i.id %>" data-prop="hadith_virtual.note<%=langSuff%>" data-arabizi="true" data-markdown-source="<%= noteMarkdown %>" data-markdown-empty-html="<%= editPlaceholder('note') %>" data-placeholder="<%= editPlaceholder('note') %>" aria-label="<%= editPlaceholder('note') %>"<% } %>>
				<%- noteContent %>
			</aside>
		<% }
	} %>

	<% if (showAdminContentTranslationSwitcher) { %>
		<div class="content-translation-actions-row admin-content-translation-actions-row">
			<label class="admin-content-translation-switcher content-translation-language-switcher quran-passage-translation-control mb-0" lang="en" dir="ltr">
				<span class="visually-hidden">Translation language</span>
				<span class="bi bi-translate quran-passage-translation-icon" aria-hidden="true"></span>
				<select id="admin-content-translation-<%= adminContentTranslationId %>-<%= lang %>" class="form-select form-select-sm content-translation-language-select quran-passage-translation-select" data-admin-content-translation-select="1" aria-label="Translation language">
					<option value="en" <%= adminContentTranslationSelectedCode === 'en' ? 'selected' : '' %>>English</option>
					<% adminContentTranslationOptionsList.forEach(function (translation) { %>
						<% if (translation && translation.code) { %>
							<option value="<%= translation.code %>" <%= adminContentTranslationSelectedCode === translation.code ? 'selected' : '' %>><%= translation.label || translation.code.toUpperCase() %></option>
						<% } %>
					<% }); %>
				</select>
			</label>
		</div>
	<% } %>

	<%# Grade  ............................................................. %>
	<% if (i.remark == 0 && !isContentTranslationLang && (hasHadithClassification || (site.editMode && lang === 'en'))) { const classificationParts = [hadithAttribution ? (lang === 'ar' ? hadithAttribution.title : hadithAttribution.title_en) : '', ...hadithChainCategories.map(function (category) { return lang === 'ar' ? category.title : category.title_en; })].filter(Boolean); %>
		<div class="hadith-attribution"><% if (site.editMode && lang === 'en') { %><div class="hadith-classification-editor" dir="ltr"><select class="_e form-select form-select-sm hadith-admin-select" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hdith_metadata.attribution_id" aria-label="Hadith attribution" title="Hadith attribution"><% hadithAttributionOptions.forEach(function (attributionOption) { %><option value="<%= attributionOption.id %>" <%= Number(hadithAttribution && hadithAttribution.id) === attributionOption.id || (!hadithAttribution && attributionOption.id === -1) ? 'selected' : '' %>><%= attributionOption.title_en %> — <%= attributionOption.title %></option><% }); %></select><select class="_e form-select form-select-sm hadith-admin-select" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hdith_metadata.chain_type" aria-label="Chain classification" title="Chain classification"><% hadithChainCategorySelections.forEach(function (chainSelection) { %><option value="<%= chainSelection.value %>" <%= selectedChainCategoryKeys === chainSelection.value ? 'selected' : '' %>><%= chainSelection.label %></option><% }); %></select></div><% } else { %><%= classificationParts.join(' · ') %><% } %></div>
	<% } %>
	<% if (i.remark == 0 && !isContentTranslationLang && showLegacyInlineGrade && showTranslatedLegacyGradeOverride) { %>
		<aside class="hadith-inline-ruling<%= i.single === true ? ' hadith-inline-ruling-single' : '' %>" lang="<%=lang%>">
			<em class="grade">
				<% if (i.legacyGradeColor) { %><span class="hadith-grade-color" style="--hadith-grade-color: <%= i.legacyGradeColor %>" aria-hidden="true"></span><% } %>
				<% if (lang === 'en' && site.editMode) { %>
				<select dir="ltr" class="_e form-select form-select-sm hadith-admin-select" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.gradeId" aria-label="Legacy hadith grade" title="Legacy hadith grade">
					<% global.grades.forEach(function (grade) { %>
						<option value="<%=grade.id%>" <%=(grade.id == (i.grade && i.grade.id)) ? 'selected' :''%>><%= bilingualLabel(grade.grade_en, grade.grade) %></option>
					<% }); %>
				</select>
				(<select class="_e form-select form-select-sm hadith-admin-select" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.graderId" aria-label="Legacy hadith grader" title="Legacy hadith grader">
					<% global.graders.forEach(function (grader) { %>
						<option value="<%=grader.id%>" <%=(grader.id == (i.grader && i.grader.id)) ? 'selected' :''%>><%= bilingualLabel(grader.shortName_en, grader.shortName) %></option>
					<% }); %>
				</select>)
				<% } else { %>
				<% const displayedGrade = legacyGradeOverride ? (lang === 'en' ? legacyGradeOverride.grade_en : legacyGradeOverride.grade) : langData.grade_grade;
				   const displayedGrader = legacyGradeOverride ? (lang === 'en' ? legacyGradeOverride.grader_en : legacyGradeOverride.grader) : langData.grader_shortName;
				   const displayedGraderName = legacyGradeOverride ? (lang === 'en' ? (legacyGradeOverride.grader_name_en || displayedGrader) : (legacyGradeOverride.grader_name || displayedGrader)) : langData.grader_name; %>
				<span class="hadith-inline-ruling-text" title="<%= attrValue(displayedGrade) %>"><%- displayedGrade %></span>&nbsp;(<span title="<%= displayedGraderName %>"><%- displayedGrader %></span>)
				<% } %>
			</em>
		</aside>
	<% } %>
	<%# Nav  ............................................................... %>
	<% if (!isContentTranslationLang && (site.editMode || ((title || i.book_virtual===1) && (i.chapter || i.section)))) { %>
		<aside class="title<%= isQuranItem && lang === 'ar' ? ' quran-search-title' : '' %>">
			§ 
			<% if (lang === 'en' && site.editMode && i.book_virtual===0 && chapter && chapter.sections) { %>
				(<select dir="rtl" class="_e form-select form-select-sm hadith-admin-select" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.tocId">
					<option value="">-- خالي --</option>
					<% for (var section of chapter.sections) { %>
						<option value="<%=section.id%>" <%=(section.path === i.path) ? 'selected' :''%>><%=utils.truncate(section.title, 50, true, false, false)%></option>
					<% }; %>
				</select>)
			<% } else if (isQuranItem && lang === 'ar') { %>
				<% if (i.section) { %>
					<a href="<%= utils.urlFor(req, `/${i.book_alias}/${i.section.h1}/${i.section.h2}`) %>" title="<%= linkTitle(`${itemSectionTitle} في ${itemChapterTitle}`) %>"><%- itemSectionTitle %></a>
				<% } %>
				<% if (i.chapter) { %>
					في <a href="<%= utils.urlFor(req, `/${i.book_alias}/${i.chapter.h1}`) %>" title="<%= linkTitle(itemChapterTitle) %>"><%- itemChapterTitle %></a>
				<% } %>
			<% } else { %>
				<% if (i.section) { %>
					<a href="<%= utils.urlFor(req, `/${i.book_alias}/${i.section.h1}/${i.section.h2}`) %>" title="<%= linkTitle(langData.h2_title) %>"><%- itemSectionTitle %></a>
				<% } %>
				<% if (i.chapter) { %>
					<%= lang == 'en' ? 'in' : 'في' %> 
					<% if (isQuranItem && lang === 'en' && searchResult) { const revelationLabel = quranSearchRevelation === 'madani' ? 'Madani' : 'Makki'; %><span class="quran-revelation-icon quran-revelation-icon-<%= quranSearchRevelation %> quran-revelation-icon-before" role="img" aria-label="<%= revelationLabel %>" title="<%= revelationLabel %>"></span><% } %>
					<a href="<%= utils.urlFor(req, `/${i.book_alias}/${i.chapter.h1}`) %>" title="<%= linkTitle(langData.h1_title) %>"><%- itemChapterTitle %></a>
				<% } %>
			<% } %>
		</aside>
	<% } %>

	<%# Books  ............................................................. %>
	<% if (lang === 'en' && (i.books || (site.editMode && i.single && i.virtualReferences && i.virtualReferences.length))) {
		var books = null;
		if (i.books) {
			books = i.books.replace(/[{}]/g, ' ');
			books = books.trim().split(/ +/).filter(Boolean).map(book => {
				return `<a href="/${book}">${book}</a>`;
			});
			books = books.join(' ');
		}
		%>
		<aside class="tags">
			<% if (books) { %>
				<div>also in: <%- books %></div>
			<% } %>
			<% if (site.editMode && i.single && i.virtualReferences && i.virtualReferences.length) { %>
				<div>referenced in:
					<% i.virtualReferences.forEach((ref, idx) => { %>
						<% if (idx > 0) { %> <span aria-hidden="true">&middot;</span> <% } %>
						<%
							const virtualHeadingTitle = ref.h2_title_en || ref.h1_title_en || `Chapter ${ref.h1}`;
						%>
						<a href="/<%= ref.path %>"><%= ref.book_shortName_en || ref.book_alias %>: <%= virtualHeadingTitle %></a>
					<% }); %>
				</div>
			<% } %>
		</aside>
		<% } %>

		<%# Actions  ........................................................... %>
		<% if (!isSimilarSection) { %>
		<aside class="tags">
	<% if (lang === 'en') { %>
		<button type="button" class="hadith-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>" data-bookmark-type="<%= isQuranItem ? 'quran' : 'hadith' %>" data-bookmark-ref="<%= isQuranItem ? (i.ref || bookmarkRef) : bookmarkRef %>" data-bookmark-title="<%= bookmarkTitle %>" data-bookmark-body="<%= isQuranItem ? utils.emptyIfNull(langData.body) : '' %>" data-bookmark-body-ar="<%= isQuranItem ? utils.emptyIfNull(i.ar && i.ar.body) : '' %>" data-bookmark-url="<%= itemHref %>" title="Bookmark this hadith">
			<span class="hadith-bookmark-icon bi bi-bookmark text-accent" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>"></span>
		</button>
		&nbsp;
		<button type="button" class="hadith-like-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>" data-like-type="hadith" title="Like this hadith">
			<span class="hadith-like-icon bi bi-heart text-danger" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>" data-like-type="hadith"></span>
		</button>
		<span class="hadith-like-count fw-semibold text-danger" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>" data-like-type="hadith">0</span>
		&nbsp;
		<a href="<%= isQuranItem ? utils.quranUrl(req, `/${i.ref}#comments`) : utils.urlFor(req, `/${i.ref}#comments`) %>" class="reflection-count-link text-decoration-none" title="View reflections">
			<span class="bi bi-chat-right-text text-accent"></span><span class="hadith-comment-count fw-semibold text-accent" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>" data-comment-type="hadith" title="0 reflections">0</span>
		</a>
		&nbsp;
		<% if (quranTafsirHref && searchResult) { %>
			<span class="bi bi-book-half"></span>&nbsp;<a href="<%= quranTafsirHref %>" title="Tafsir of this ayah" class="icon" data-open-quran-tafsir="1">Tafsir</a>
			&nbsp;
		<% } %>
		<% if (sharhBody) { %>
			<span class="bi bi-book"></span>&nbsp;<a href="#" title="Sharh of this hadith" class="icon hadith-sharh-link" data-hadith-sharh-body="<%= sharhBody %>">Sharh</a>
			&nbsp;
		<% } %>
		<a href="#H<%= i.id %>" type="button" title="<%= linkTitle(itemLinkTitleSource) %>" class="btn btn-sm icon content-translate-button hadith-share-action-link" data-bs-toggle="modal" data-bs-target="#H<%= i.id %>">
			<span class="bi bi-box-arrow-up content-translate-button-icon" aria-hidden="true"></span>
			<span class="content-translate-button-label">Share</span>
		</a>
		<% } %>
		</aside>
		<% } %>

		<%# Admin  ............................................................. %>
		<% if (site.editMode && lang === "en") { %>
		<aside class="admin hadith-admin-actions">
			<% if (!isSimilarSection) { %>
				<button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" title="Revise this hadith" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.revise" data-loading-label="Revising">
					<span class="bi bi-magic"></span> Revise
				</button>
				<button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" title="Enrich from hdith.com" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.enrich" data-loading-label="Enriching">
					<span class="bi bi-database-add"></span> Enrich
				</button>
				<button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" title="Find similar hadith offline" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.similar" data-loading-label="Starting">
					<span class="bi bi-search"></span> Similar
				</button>
			<% } %>
			<% if (page.menu == 'Chapter' || page.menu == 'Section') { %>
				<button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" title="Move Up" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.moveup" data-loading-label="Moving">
					<span class="bi bi-caret-up-square-fill"></span> Move Up
				</button>
				<button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" title="Move Down" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.movedn" data-loading-label="Moving">
					<span class="bi bi-caret-down-square-fill"></span> Move Down
				</button>
			<% }
			   if (i.book_virtual != 1) { %>
				<% if (isSimilarSection && i.similarCandidate) { %>
					<button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" title="Make actual similar hadith" data-id="<%= i.parentId %>,<%= i.actual ? i.actual.id : i.id %><%= i.similarSecondHopCandidate && i.similarRemoveId1 && i.similarRemoveId2 ? `,${i.similarRemoveId1},${i.similarRemoveId2}` : '' %>" data-prop="hadiths_sim.add" data-loading-label="Adding">
						<span class="bi bi-check2-circle"></span> Make Similar
					</button>
				<% } else if (isSimilarSection && i.similarDemotable) { %>
					<button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" title="Make similar candidate" data-id="<%= i.parentId %>,<%= i.actual ? i.actual.id : i.id %><%= i.similarSecondHopCandidate && i.similarRemoveId1 && i.similarRemoveId2 ? `,${i.similarRemoveId1},${i.similarRemoveId2}` : '' %>" data-prop="hadiths_sim.demote" data-loading-label="Moving">
						<span class="bi bi-arrow-down-circle"></span> Make Candidate
					</button>
				<% } %>
				<% if (isSimilarSection && i.similarRemovable) { %>
					<button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" title="Remove Association" data-id="<%= i.parentId %>,<%= i.actual ? i.actual.id : i.id %><%= i.similarRemoveId1 && i.similarRemoveId2 && (Number(i.similarRemoveId1) !== Number(i.parentId) || Number(i.similarRemoveId2) !== Number(i.actual ? i.actual.id : i.id)) ? `,${i.similarRemoveId1},${i.similarRemoveId2}` : '' %>" data-prop="hadiths_sim.del" data-loading-label="Removing">
						<span class="bi bi-trash"></span> Remove
					</button>
				<% } else if (!isSimilarSection) { %>
					<button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" title="Remove All Similar Candidates" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadiths_sim.delall" data-loading-label="Removing">
						<span class="bi bi-trash"></span> Remove All
					</button>
				<% } %>
		<% } else if (i.book_virtual == 1) { %>
			<button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" title="Delete" data-id="<%= i.id %>" data-prop="hadith_virtual.del" data-loading-label="Deleting">
				<span class="bi bi-trash"></span> Delete
			</button>
			<% if (!isSimilarSection) { %>
				<div class="input-group input-group-sm d-inline-flex align-middle ms-1 mb-1" style="width: 9rem;">
					<button type="button" class="_submit-edit btn btn-outline-secondary hadith-admin-action hadith-admin-action-icon" title="Add Reference" aria-label="Add Reference" data-loading-label="Adding">
						<span class="bi bi-file-plus-fill"></span>
					</button>
					<input class="_e form-control border-secondary" title="Ref Num" aria-label="Ref Num" data-id="<%= i.id %>" data-prop="hadith_virtual.add" data-reset="true">
				</div>
			<% } %>
		<% } %>
		</aside>
	<% } %>
	
</section>
