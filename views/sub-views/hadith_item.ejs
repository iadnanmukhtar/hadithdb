<%
	hashtag = String(`${i.book_alias || ''}${i.num || i.num0 || i.id || ''}`).replace(/[-\:]/g, '_');
	var _p = searchResult ? 'partial' : '';
	var langSuff = (lang === 'en') ? '_en' : '';
	var chapter = page.context.chapter;
    var sections = [];
	var langData = i[lang] || {};
	if (chapter)
		sections = chapter.sections; 
	const debugDocId = i.actual ? i.actual.id : i.id;
	const debugScore = Number.isFinite(i._score) ? i._score : '';
	function linkTitle(title) {
		title = title || '';
		if (!searchResult)
			return title;
		var parts = [];
		if (title)
			parts.push(title);
		parts.push(`doc=${debugDocId}`);
		if (debugScore !== '')
			parts.push(`score=${debugScore}`);
		return parts.join(' | ');
	}
%>

<section class="col-md-6 col-sm-12 h" lang="<%=lang%>">

	<%# Chain  ............................................................. %>
	<section lang="<%=lang%>" >

		<%# Rating %>
		<%- (lang === 'en' && i.rating !== undefined) ? `<span class="bi bi-reception-${i.rating}"></span>` : '' %>

		<!--
		<%# Verification %>
		<% if (lang === 'en' && site.editMode) { %>
			<input class="_e form-check-input" title="Verified" type="text" size="1" value="<%- i.verified ? 'x' : '' %>"" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.verified">
		<% } else if (lang === 'en') { %>
			<%- i.verified ? `<span title="Verified Translation" class="bi bi-patch-check-fill"></span>` : '' %>
		<% } %>
		-->

		<%# Highlight Date %>
		<% if (lang === 'en' && site.editMode) {
			var hlDate = null;
			try {
				if (i.highlight) {
					if (typeof i.highlight === 'string')
						i.highlight = new Date(i.highlight);
					hlDate = `${i.highlight.getFullYear()}-${i.highlight.getMonth()+1}-${i.highlight.getDate()}`; 
				}
			} catch (e) {
				console.log(i.highlight);
				console.log(typeof i.highlight);
				console.log(e);
			} %>
			<span class="_e form-input" style="width:100px;" title="Hightlight Date" type="text" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.highlight"><%- hlDate || '&hellip;' %></span>
		<% 	
		    } %>

		<%# Virtual Num %>
		<% if (i.book_virtual) { %>
			(<span class="_e" title="Virtual Num" data-id="<%= i.id %>" data-prop="hadith_virtual.num"><%- (langData.num) ? `${langData.num}` : '' %></span>)
		<% } %>

		<%# Admin: Virtul Num 0%>
		<% if (lang === 'en' && site.editMode) { %>
			(<span class="_e" title="Virtual Num0" data-id="<%= i.id %>" data-prop="hadith_virtual.num0"><%- i.num0 || '&hellip;' %></span>)
			(<span class="_e" title="Num" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.num"><%- i.actual ? (i[lang]?.actual?.num || i.actual?.num || i.num || '&hellip;') : (langData.num || i.num || '&hellip;') %></span>)
		<% } %>

		<%# Item Number + Chain %>
		<b><a href="/<%= i.actual ? i.actual.book_alias : i.book_alias %>:<%= i.actual ? i.en?.actual?.num || i.actual?.num || i.num : i.en?.num || i.num %>" title="<%= linkTitle(langData.title || langData.body || langData.chain) %>"><%= `${i.actual ? (i[lang]?.actual?.book_shortName || i.actual?.book_shortName || i.book_shortName) : (langData.book_shortName || i.book_shortName)}:${i.actual ? (i[lang]?.actual?.num || i.actual?.num || i.num) : (langData.num || i.num)}` %></a></b> –
		<% if (langData.chain || site.editMode) { %>
			<span class="_e chain <%=_p%> l3" title="Ḥadīth Chain" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.chain<%=langSuff%>" data-arabizi="true"><%- langData.chain || `&hellip;` %></span>
		<% } %>

	</section>

	<%# Body  .............................................................. %>
	<%
		const bodyMarkdown = utils.emptyIfNull(langData.body) || utils.emptyIfNull(langData.text);
		const bodyHtml = utils.markdownToHtml(bodyMarkdown);
	%>
	<section lang="<%=lang%>" class="body <%=_p%> l5" title="Ḥadīth Body">
		<div class="_e hadith-body-content <%=_p%>" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.body<%=langSuff%>" data-arabizi="true" data-markdown-source="<%= bodyMarkdown %>" data-markdown-empty-html="&hellip;">
		<% if (!langData.body) { %>
			<div class="cmd-tr" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>">
				Translation not available.
				<% if (lang === 'en') { %>
					<button type="button" class="hadith-translate-btn btn btn-sm btn-outline-secondary ms-2" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>">
						<span class="bi bi-translate"></span> Translate
					</button>
				<% } %>
			</div>
		<% } %>
			<%- bodyHtml %>
		</div>
		<% if (lang === 'en') { %>
			<a type="button" title="Zoom In" class="icon" data-bs-toggle="modal" data-bs-target="#H<%= i.id %>"><em class="bi bi-zoom-in"></em></a>
		<% } %>
	</section>

	<%# Footer  ............................................................ %>
	<% if (langData.footnote || site.editMode) { 
		const footnoteMarkdown = utils.emptyIfNull(langData.footnote);
		const footnoteHtml = utils.markdownToHtml(langData.footnote);
		const footnoteContent = footnoteHtml || '&hellip;';
	%>
		<footer lang="<%=lang%>" class="footnote _e <%=_p%> l2" title="Ḥadīth Footnote" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.footnote<%=langSuff%>" data-arabizi="true" data-markdown-source="<%= footnoteMarkdown %>" data-markdown-empty-html="&hellip;">
			<%- footnoteContent %>
		</footer>
	<% } %>

	<% if (i.book_virtual) { %>
		<%# Author Note  ....................................................... %>
		<% if (langData.note || site.editMode) { 
			const noteMarkdown = utils.emptyIfNull(langData.note);
			const noteHtml = utils.markdownToHtml(langData.note);
			const noteContent = noteHtml || '&hellip;';
		%>
			<aside lang="<%=lang%>" class="note _e <%=_p%> l2" title="Ḥadīth Note" data-id="<%= i.id %>" data-prop="hadith_virtual.note<%=langSuff%>" data-arabizi="true" data-markdown-source="<%= noteMarkdown %>" data-markdown-empty-html="&hellip;">
				<%- noteContent %>
			</aside>
		<% }
	} %>

	<%# Grade  ............................................................. %>
	<% if (i.remark == 0) { %>
		<aside lang="<%=lang%>" >
		<em class="grade">
			<% if (lang === 'en' && site.editMode) { %>
			<select dir="rtl" class="_e" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.gradeId">
				<% global.grades.forEach(function (grade) { %>
					<option value="<%=grade.id%>" <%=(grade.id == (i.grade && i.grade.id)) ? 'selected' :''%>><%=grade.grade%></option>
				<% }); %>
			</select> 
			(<select class="_e" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.graderId">
				<% global.graders.forEach(function (grader) { %>
					<option value="<%=grader.id%>" <%=(grader.id == (i.grader && i.grader.id)) ? 'selected' :''%>><%=grader.shortName_en%></option>
				<% }); %>
			</select>)
			<% } else { %>
			– <span><%- langData.grade_grade %></span>&nbsp;(<span title="<%=langData.grader_name%>"><%- langData.grader_shortName %></span>)
			<% } %>
		</em>
		</aside>
	<% } %>

	<%# Nav  ............................................................... %>
	<% if (site.editMode || ((title || i.book_virtual===1) && (i.chapter || i.section))) { %>
		<aside class="title">
			§ 
			<% if (lang === 'en' && site.editMode && i.book_virtual===0 && chapter && chapter.sections) { %>
				(<select dir="rtl" class="_e" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.tocId">
					<option value="">-- خالي --</option>
					<% for (var section of chapter.sections) { %>
						<option value="<%=section.id%>" <%=(section.path === i.path) ? 'selected' :''%>><%=utils.truncate(section.title, 50, true, false, false)%></option>
					<% }; %>
				</select>)
			<% } else { %>
				<% if (i.section) { %>
					<a href="/<%- `${i.book_alias}/${i.section.h1}/${i.section.h2}` %>" title="<%= linkTitle(langData.h2_title) %>"><%- utils.truncate(langData.h2_title, 30, true) || 'Section' %></a>
				<% } %>
			<% } %>
			<% if (i.chapter) { %>
				<%= lang == 'en' ? 'in' : 'في' %> 
				<a href="/<%- `${i.book_alias}/${i.chapter.h1}` %>" title="<%= linkTitle(langData.h1_title) %>"><%- utils.truncate(langData.h1_title, 30, true) || 'Chapter' %></a>
			<% } %>
		</aside>
	<% } %>

	<%# Tags  .............................................................. %>
	<% if (lang === 'en' && (i.tags || site.editMode)) {
		var tags = null;
		if (i.tags)
			tags = i.tags.replace(/[{}]/g, '');
		%>
		<aside class="tags">
			<% if (site.editMode) { %>
				<textarea class="_e d-inline-block w-100" placeholder="#hashtag" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.tags"><%= tags %></textarea>
			<% } else {
				tags = tags.split(/ +/).map(tag => {
				return `<a href="/tag/${tag}">${tag}</a>`;
				});
				tags = tags.join(' ');
			%>
				<div><span class="bi bi-hash"></span> <%- tags %></div>
			<% } %>
		</aside>
	<% } %>

	<%# Books  ............................................................. %>
	<% if (lang === 'en' && i.books) {
		var books = null;
		books = i.books.replace(/[{}]/g, ' ');
		books = books.split(/ +/).map(book => {
			return `<a href="/${book}">${book}</a>`;
		});
		books = books.join(' ');
		%>
		<aside class="tags">
			<div>also in: <%- books %></div>
		</aside>
	<% } %>

	<%# Actions  ........................................................... %>
	<aside class="tags">
	<% if (lang === 'en') { %>
		<button type="button" class="hadith-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>" title="Bookmark this hadith">
			<span class="hadith-bookmark-icon bi bi-bookmark text-accent" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>"></span>
		</button>
		&nbsp;
		<button type="button" class="hadith-like-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>" title="Like this hadith">
			<span class="hadith-like-icon bi bi-heart text-danger" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>"></span>
		</button>
		<span class="hadith-like-count fw-semibold text-danger" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>">0</span>
		&nbsp;
		<% if (!i.single) { %>
			<span class="bi bi-chat-right-text"></span>&nbsp;<a href="/<%= i.ref %>" title="<%= linkTitle(langData.title || langData.body || langData.chain) %>">Reflect</a>
			&nbsp;
		<% } %>
		<span class="bi bi-box-arrow-up"></span>&nbsp;<a href="/<%= i.actual ? i.actual.book_alias : i.book_alias %>:<%= i.actual ? i.en?.actual?.num || i.actual?.num || i.num : i.en?.num || i.num %>?sharepreview" type="button" title="<%= linkTitle(langData.title || langData.body || langData.chain) %>" class="icon">Share</a>
	<% } %>
	</aside>

	<%# Admin  ............................................................. %>
	<% if (site.editMode && lang === "en") { %>
		<aside class="admin">
		<span class="bi bi-magic"></span>&nbsp;<a class="_click" title="Revise with AI" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.revise">Revise</a>
		|
		<% if (page.menu == 'Chapter' || page.menu == 'Section') { %>
			<span class="bi bi-caret-up-square-fill"></span>&nbsp;<a class="_click" title="Move Up" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.moveup">Move Up</a>
			|
			<span class="bi bi-caret-down-square-fill"></span>&nbsp;<a class="_click" title="Move Down" data-id="<%= i.actual ? i.actual.id : i.id %>" data-prop="hadith.movedn">Move Down</a>
		<% }
		   if (i.book_virtual == 0) { %>
			<span class="bi bi-trash"></span>&nbsp;<a class="_click" title="Remove Association" data-id="<%= i.parentId %>,<%= i.actual ? i.actual.id : i.id %>" data-prop="hadiths_sim.del">Remove</a>
			<span class="bi bi-trash"></span>&nbsp;<a class="_click" title="Remove All Associations" data-id="<%= i.parentId %>,<%= i.actual ? i.actual.id : i.id %>" data-prop="hadiths_sim.delall">Remove All</a>
			|
			<span class="bi bi-file-plus-fill"></span>&nbsp;<input class="_e" title="Ref Num" data-id="<%= i.id %>" data-prop="hadith.add" data-reset="true">
		<% } else if (i.book_virtual == 1) { %>
			<span class="bi bi-trash"></span>&nbsp;<a class="_click" title="Delete" data-id="<%= i.id %>" data-prop="hadith_virtual.del">Delete</a>
			|
			<span class="bi bi-file-plus-fill"></span>&nbsp;<input class="_e" title="Ref Num" data-id="<%= i.id %>" data-prop="hadith_virtual.add" data-reset="true">
		<% } %>
		</aside>
	<% } %>
	
</section>
