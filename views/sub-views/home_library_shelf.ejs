<%
  const groups = BookGroups.list('hadith', libraryBooks, { membershipOrder: true });
  const members = id => groups.find(group => group.id === id)?.aliases || [];
  const beginner = members('beginner-books');
  const twelve = members('ninebooks').flatMap(alias => alias === 'muslim' ? [alias, 'lulu-marjan'] : [alias]);
  twelve.push('ibnhibban', 'hakim', 'daraqutni', 'mishkat');
  const shelfBooks = libraryBooks.slice().sort((a, b) => (a.name_en || a.alias).localeCompare(b.name_en || b.alias, 'en'));
  const aliases = shelfBooks.map(book => book.alias);
  const history = shelfBooks.filter(book => ['history', 'sirah'].includes(book.type)).map(book => book.alias);
  const assigned = new Set([...beginner, ...twelve]);
  const collections = [
    ['beginner', 'Beginner Books', beginner],
    ['twelve', 'Twelve Books', twelve.filter(alias => aliases.includes(alias))],
    ['other', 'Other', aliases.filter(alias => !assigned.has(alias))]
  ];
  const [initialView, , initialAliases] = collections.find(([, , titles]) => titles.length) || ['all', '', aliases];
  const initialDeck = ['beginner', 'twelve'].includes(initialView);
  const byAlias = new Map(shelfBooks.map(book => [book.alias, book]));
  const firstBooks = initialAliases.map(alias => byAlias.get(alias)).filter(Boolean);
  const selectedBooks = new Set(firstBooks);
  const orderedBooks = [...firstBooks, ...shelfBooks.filter(book => !selectedBooks.has(book))];
%>
<section class="library-shelf ux-system" aria-labelledby="library-shelf-title" data-library-shelf data-directory-order="<%= aliases.join(' ') %>" data-view="<%= initialView %>" data-layout="<%= initialDeck ? 'covers' : 'directory' %>" <%= initialDeck ? 'data-deck' : '' %>>
  <div class="library-shelf-toolbar">
    <div class="library-shelf-tabs" role="group" aria-label="Book collections">
      <% for (const [id, label, titles] of collections) { if (titles.length) { %>
        <button type="button" aria-pressed="<%= id === initialView %>" data-shelf-view="<%= id %>" data-titles="<%= titles.join(' ') %>"><%= label %></button>
      <% } } %>
    </div>
    <div class="library-shelf-tools">
      <%- include('rail_search.ejs', { inputId: 'home-book-search', label: 'Search all books by title or author', placeholder: 'Search books', clearLabel: 'Clear book search', resultsId: 'home-books' }) %>
    </div>
  </div>
  <%- include('library_volumes', { shelfId: 'home-books', shelfLabel: 'Hadith books', shelfBooks: orderedBooks, visibleCount: firstBooks.length, initialDeck, bookHref: book => utils.urlFor(req, '/' + book.alias), bookIcon: book => history.includes(book.alias) ? 'bi-clock-history' : 'bi-book' }) %>
  <p class="library-empty" hidden>No books match your search.</p>
  <span class="visually-hidden" aria-live="polite" data-shelf-status></span>
</section>
