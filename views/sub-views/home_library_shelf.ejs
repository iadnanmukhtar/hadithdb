<%
  const groups = BookGroups.list('hadith', libraryBooks, { membershipOrder: true });
  const members = id => groups.find(group => group.id === id)?.aliases || [];
  const beginner = members('beginner-books');
  const twelve = members('ninebooks').flatMap(alias => alias === 'muslim' ? [alias, 'lulu-marjan'] : [alias]);
  twelve.push('ibnhibban', 'hakim', 'daraqutni', 'mishkat');
  const shelfBooks = libraryBooks.slice().sort((a, b) => (a.shortName_en || a.alias).localeCompare(b.shortName_en || b.alias, 'en'));
  const aliases = shelfBooks.map(book => book.alias);
  const history = shelfBooks.filter(book => ['history', 'sirah'].includes(book.type)).map(book => book.alias);
  const assigned = new Set([...beginner, ...twelve, ...history]);
  const collections = [
    ['beginner', 'Beginner Books', beginner],
    ['twelve', 'Twelve Books', twelve.filter(alias => aliases.includes(alias))],
    ['other', 'Other Hadith Books', aliases.filter(alias => !assigned.has(alias))],
    ['history', 'History & Sirah', history]
  ];
%>
<section class="library-shelf ux-system" aria-labelledby="library-shelf-title" data-library-shelf>
  <div class="library-shelf-heading">
    <h2 id="library-shelf-title">Book collections</h2>
    <div class="library-shelf-tools" hidden>
      <%- include('rail_search.ejs', { inputId: 'home-book-search', label: 'Search all books by title or author', placeholder: 'Search books', clearLabel: 'Clear book search', resultsId: 'home-books' }) %>
    </div>
  </div>
  <div class="library-shelf-tabs" role="group" aria-label="Book collections" hidden>
    <% for (const [id, label, titles] of collections) { if (titles.length) { %>
      <button type="button" data-shelf-view="<%= id %>" data-titles="<%= titles.join(' ') %>"><%= label %></button>
    <% } } %>
  </div>
  <nav id="home-books" class="library-volumes" aria-label="Hadith books">
    <% for (const book of shelfBooks) {
      const arabicTitle = book.shortName || book.title;
    %>
      <a class="library-volume" href="<%= utils.urlFor(req, '/' + book.alias) %>" data-alias="<%= book.alias %>" data-search="<%= [book.alias, book.name_en, book.shortName_en, book.title, book.shortName, book.author_en, book.author].filter(Boolean).join(' ') %>">
        <span class="volume-content">
          <span class="volume-face" aria-hidden="true"><i class="bi <%= history.includes(book.alias) ? 'bi-clock-history' : 'bi-book' %>"></i></span>
          <span class="volume-name"><%= book.name_en || book.shortName_en || book.alias %><%- hadithSizeIndicator(book) %></span>
          <% if (arabicTitle) { %><span class="volume-arabic" lang="ar" dir="rtl"><%= arabicTitle %></span><% } %>
          <span class="volume-author"><%= book.authorShortName_en || book.author_en || '' %></span>
        </span>
      </a>
    <% } %>
  </nav>
  <div class="library-deck-controls" hidden>
    <button type="button" aria-label="Previous book" aria-controls="home-books"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
    <span role="status" aria-atomic="true"></span>
    <button type="button" aria-label="Next book" aria-controls="home-books"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
  </div>
  <p class="library-empty" hidden>No books match your search.</p>
  <span class="visually-hidden" aria-live="polite" data-shelf-status></span>
</section>
