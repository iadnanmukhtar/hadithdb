<%
	const ayahs = locals.selectedAyahs || [];
	const firstAyah = ayahs[0] || {};
	const lastAyah = ayahs[ayahs.length - 1] || firstAyah;
	const firstRef = firstAyah.en?.num || firstAyah.num || '';
	const lastRef = lastAyah.en?.num || lastAyah.num || '';
	const firstRefPart = firstRef.split(/:/)[1] || firstRef;
	const lastRefPart = lastRef.split(/:/)[1] || lastRef;
	const shareRef = firstRef && lastRef && firstRef !== lastRef ? `quran:${firstRef}-${lastRefPart}` : `quran:${firstRef}`;
	const shareTitle = page.context.chapter?.title_en || firstAyah.h1_title_en || firstAyah.en?.h1_title || 'Qurʾān';
%>
<% if (ayahs.length > 0) { %>
<aside class="h modal fade hadith-share-root quran-share-root" id="<%= quranShareId %>" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable modal-xl hadith-share-dialog">
    <div class="modal-content hadith-share-modal">
      <header class="modal-header hadith-share-toolbar">
		<div class="hadith-share-actions">
			<div class="hadith-share-tool-group">
				<button type="button" class="btn btn-sm btn-outline-secondary hadith-share-edit" title="Edit text" aria-label="Edit text" aria-pressed="false">
					<span class="bi bi-pencil"></span>
				</button>
			</div>
			<div class="hadith-share-control-group">
				<div class="form-check form-switch hadith-share-arabic-toggle" title="Show English">
					<input class="form-check-input hadith-share-arabic" type="checkbox" role="switch" id="<%= quranShareId %>-english" data-share-language-toggle="english" checked>
					<label class="form-check-label" for="<%= quranShareId %>-english">English</label>
				</div>
				<div class="hadith-share-size-controls" aria-label="Share image font sizes">
					<label title="English text size">
						<span>English</span>
						<input class="form-range hadith-share-size" type="range" min="70" max="130" step="5" value="100" data-share-size-var="--share-english-tune">
					</label>
					<label title="Arabic text size">
						<span>Arabic</span>
						<input class="form-range hadith-share-size" type="range" min="70" max="130" step="5" value="100" data-share-size-var="--share-arabic-tune">
					</label>
				</div>
			</div>
			<div class="hadith-share-tool-group">
				<button type="button" class="btn btn-sm btn-outline-secondary hadith-share-copy" title="Copy image" aria-label="Copy image">
					<span class="bi bi-clipboard"></span>
				</button>
				<button type="button" class="btn btn-sm btn-outline-secondary hadith-share-native" title="Share image" aria-label="Share image">
					<span class="bi bi-share"></span>
				</button>
			</div>
		</div>
		<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
	  </header>
      <section class="modal-body hadith-share-body">
		<article class="hadith-share-card quran-share-card" data-share-card data-share-ref="<%= shareRef %>">
			<div class="hadith-share-card-inner">
				<h2 class="hadith-share-title share-editable" contenteditable="false"><%= shareTitle %></h2>
				<section class="hadith-share-section hadith-share-arabic-section" lang="ar">
					<div class="body hadith-share-text quran-share-text share-editable" lang="ar" contenteditable="false">
						<p>
							<% ayahs.forEach(function (ayah) {
								const ayahNum = ayah.ar?.num || ayah.num || '';
								const ayahPart = ayahNum.split(/:/)[1] || ayahNum;
							%>
								<span><sup><%= ayahPart %></sup>&nbsp;<%= ayah.ar?.body || '' %>&nbsp;<sup>۝</sup></span>
							<% }); %>
						</p>
					</div>
				</section>
				<section class="hadith-share-section quran-share-english-section" lang="en">
					<div class="body hadith-share-text quran-share-text share-editable" lang="en" contenteditable="false">
						<p>
							<% ayahs.forEach(function (ayah) {
								const ayahNum = ayah.en?.num || ayah.num || '';
								const ayahPart = ayahNum.split(/:/)[1] || ayahNum;
							%>
								<span><sup><%= ayahPart %></sup>&nbsp;<%= ayah.en?.body || '' %></span>
							<% }); %>
						</p>
					</div>
				</section>
				<footer class="hadith-share-footer">
					<div>
						<div class="title share-editable" contenteditable="false">
							<%= firstAyah.book_shortName_en || 'Qurʾān' %>
							<% if (page.context.chapter) { %>
								&gt;
								<%- utils.truncate(page.context.chapter.title_en, 60, true) || `Chapter ${page.context.chapter.h1}` %>
							<% } %>
							<% if (page.context.section) { %>
								&gt;
								§&nbsp;<%- utils.truncate(page.context.section.title_en, 60, true) || `Section ${page.context.section.h2}` %>
							<% } %>
						</div>
					</div>
					<div class="hadith-share-site">
						hadithunlocked.com
					</div>
				</footer>
			</div>
		</article>
	  </section>
    </div>
  </div>
</aside>
<% } %>
