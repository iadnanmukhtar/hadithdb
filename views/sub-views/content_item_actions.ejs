<% const isTafsir = item.source_key.startsWith('tafsir:'); %>
<aside class="tags content-item-actions" data-content-item-id="<%= item.id %>" dir="ltr">
  <button type="button" class="<%= isTafsir ? 'tafsir-bookmark-btn' : 'content-item-bookmark' %> btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" <% if (isTafsir) { %>data-tafsir-bookmark-key="<%= item.source_key.slice(7) %>"<% } else { %>data-content-bookmark-id="<%= item.id %>"<% } %> data-note-key="<%= item.source_key %>" data-note-title="<%= item.title %>" data-note-url="<%= item.url %>" title="Bookmark this item" aria-label="Bookmark this item"><span class="<%= isTafsir ? 'tafsir-bookmark-icon ' : '' %>bi bi-bookmark text-accent"<% if (isTafsir) { %> data-tafsir-bookmark-key="<%= item.source_key.slice(7) %>"<% } %> aria-hidden="true"></span></button>
  <button type="button" class="hadith-like-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= item.id %>" data-like-type="content" title="Like this item" aria-label="Like this item"><span class="hadith-like-icon bi bi-heart text-danger" data-hadith-id="<%= item.id %>" data-like-type="content" aria-hidden="true"></span></button><span class="hadith-like-count fw-semibold text-danger" data-hadith-id="<%= item.id %>" data-like-type="content">0</span>
  <a href="#<%= widgetId %>-disclosure" class="reflection-count-link text-decoration-none" data-reflection-disclosure-trigger="<%= widgetId %>-disclosure" title="View reflections" aria-label="View reflections"><span class="bi bi-chat-right-text text-accent" aria-hidden="true"></span><span class="hadith-comment-count fw-semibold text-accent" data-hadith-id="<%= item.id %>" data-comment-type="content">0</span></a>
  <button type="button" class="btn btn-sm icon content-translate-button hadith-share-action-link content-item-share" data-share-url="<%= item.url %>" data-share-title="<%= item.title %>" title="Share this item"><span class="bi bi-box-arrow-up content-translate-button-icon" aria-hidden="true"></span><span class="content-translate-button-label">Share</span></button>
</aside>
<%- include('comment_widget.ejs', { widgetId, targetId:item.id, targetType:'content', noteSourceKey:item.source_key, ref:item.url, heading:'Reflect on this item', collapsible:true, collapsed:true }); %>
