<div class="quran-ayah-select-toolbar quran-memorize-controls" lang="en" dir="ltr" role="group" aria-label="Memorize page controls">
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-all-toggle aria-pressed="false" aria-label="View all words on page <%= pageNumber %>" title="View all words"><span class="bi bi-eye-slash" data-quran-memorize-all-toggle-icon aria-hidden="true"></span></button>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-autohide-toggle aria-pressed="false" aria-label="Turn on clicked word auto-hide on page <%= pageNumber %>" title="Clicked words stay visible"><span class="bi bi-clock-history" aria-hidden="true"></span></button>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-ayah-hide aria-label="Hide one ayah on page <%= pageNumber %>" title="Hide one ayah"><span class="bi bi-dash" aria-hidden="true"></span></button>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-ayah-reveal aria-label="Reveal one ayah on page <%= pageNumber %>" title="Reveal one ayah"><span class="bi bi-plus" aria-hidden="true"></span></button>
  <% if (quranRecitationFeedbackEnabled) { %>
  <button type="button" class="btn btn-sm btn-danger text-white quran-ayah-select-btn quran-recitation-toggle" data-quran-recitation-toggle aria-pressed="false" aria-label="Start checking recitation on page <%= pageNumber %>" title="Check recitation"><span class="bi bi-mic" data-quran-recitation-icon aria-hidden="true"></span></button>
  <% } %>
</div>
<% if (locals.showRating) { %>
<div class="quran-memorize-rating" data-quran-memorize-rating data-page-number="<%= pageNumber %>">
  <% if (req.query.review === undefined) { %>
  <button type="button" class="btn btn-sm btn-primary quran-memorize-start" data-quran-memorize-start>Memorize Page</button>
  <% } %>
  <div class="quran-memorize-rating-buttons"<% if (req.query.review === undefined) { %> hidden<% } %>>
    <div class="btn-group btn-group-sm" role="group" aria-label="Memorization status for page <%= pageNumber %>">
      <% if (req.query.review === undefined) { %>
      <button type="button" class="btn btn-outline-dark quran-memorize-core-memory" data-quran-memorize-status="never" aria-label="Mark page <%= pageNumber %> as Core Memory" title="Core Memory — memorized and never reviewed"><span aria-hidden="true">🧠</span></button>
      <% } %>
      <button type="button" class="btn <%= req.query.review !== undefined ? 'btn-success' : 'btn-outline-success' %>" data-quran-memorize-status="easy">Easy</button>
      <button type="button" class="btn <%= req.query.review !== undefined ? 'btn-primary' : 'btn-outline-primary' %>" data-quran-memorize-status="good">Good</button>
      <button type="button" class="btn <%= req.query.review !== undefined ? 'btn-danger' : 'btn-outline-danger' %>" data-quran-memorize-status="hard">Hard</button>
      <% if (req.query.review !== undefined) { %>
      <button type="button" class="btn btn-dark" data-quran-memorize-again>Again</button>
      <% } %>
      <% if (req.query.review === undefined) { %>
      <button type="button" class="btn <%= req.query.review !== undefined ? 'btn-secondary' : 'btn-outline-secondary' %>" data-quran-memorize-status="todo">Later</button>
      <% } %>
    </div>
    <% if (req.query.review !== undefined) { %>
    <button type="button" class="btn btn-sm btn-secondary quran-memorize-skip" data-quran-memorize-skip>Skip</button>
    <% } %>
  </div>
  <a class="quran-memorize-list-link" href="/quran/review">Memorization Progress</a>
  <span class="small text-muted" data-quran-memorize-save-status aria-live="polite"></span>
  <% if (quranRecitationFeedbackEnabled) { %>
  <span class="visually-hidden" data-quran-recitation-feedback role="status" aria-live="polite"></span>
  <% } %>
</div>
<% } %>
