<div class="quran-ayah-select-toolbar quran-memorize-controls" lang="en" dir="ltr" role="group" aria-label="Memorize page controls">
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-all-toggle aria-pressed="false" aria-label="View all words on page <%= pageNumber %>" title="View all words"><span class="bi bi-eye-slash" data-quran-memorize-all-toggle-icon aria-hidden="true"></span></button>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-autohide-toggle aria-pressed="false" aria-label="Turn on clicked word auto-hide on page <%= pageNumber %>" title="Clicked words stay visible"><span class="bi bi-clock-history" aria-hidden="true"></span></button>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-ayah-hide aria-label="Hide one ayah on page <%= pageNumber %>" title="Hide one ayah"><span class="bi bi-dash" aria-hidden="true"></span></button>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-ayah-reveal aria-label="Reveal one ayah on page <%= pageNumber %>" title="Reveal one ayah"><span class="bi bi-plus" aria-hidden="true"></span></button>
</div>
