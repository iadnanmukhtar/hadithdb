<div class="quran-ayah-select-toolbar quran-memorize-controls" lang="en" dir="ltr" role="group" aria-label="Memorize page controls">
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-all-toggle aria-pressed="false" aria-label="View all words on page <%= pageNumber %>" title="View all words"><span class="bi bi-eye-slash" data-quran-memorize-all-toggle-icon aria-hidden="true"></span></button>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-autohide-toggle aria-pressed="false" aria-label="Turn on clicked word auto-hide on page <%= pageNumber %>" title="Clicked words stay visible"><span class="bi bi-clock-history" aria-hidden="true"></span></button>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-ayah-hide aria-label="Hide one ayah on page <%= pageNumber %>" title="Hide one ayah"><span class="bi bi-dash" aria-hidden="true"></span></button>
  <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn" data-quran-memorize-ayah-reveal aria-label="Reveal one ayah on page <%= pageNumber %>" title="Reveal one ayah"><span class="bi bi-plus" aria-hidden="true"></span></button>
  <% if (quranRecitationFeedbackEnabled) { %>
  <button type="button" class="btn btn-sm btn-danger text-white quran-ayah-select-btn quran-recitation-toggle" data-quran-recitation-toggle aria-pressed="false" aria-label="Start checking recitation on page <%= pageNumber %>" title="Check recitation"><span class="bi bi-mic" data-quran-recitation-icon aria-hidden="true"></span></button>
  <% } %>
</div>
<% if (locals.showRating && locals.review && locals.reviewRef) { %>
<div class="quran-memorize-rating quran-ayah-review-rating" data-quran-ayah-review-rating data-quran-ref="<%= reviewRef %>" data-review-retry="<%= reviewRetry ? '1' : '0' %>">
  <div class="quran-ayah-review-copy">
    <% if (reviewRetry) { %><span class="badge text-bg-secondary">One-time retry</span><% } %>
    <div class="quran-review-session-actions" role="group" aria-label="Review session actions">
      <button type="button" class="btn btn-sm btn-outline-secondary" data-quran-review-session-pause disabled><span class="bi bi-pause-fill" aria-hidden="true"></span> Pause Session</button>
      <button type="button" class="btn btn-sm btn-outline-danger" data-quran-review-session-end disabled><span class="bi bi-stop-fill" aria-hidden="true"></span> End Session</button>
    </div>
  </div>
  <div class="quran-memorize-rating-buttons quran-ayah-review-buttons">
    <div class="btn-group btn-group-sm" role="group" aria-label="Recall result for Quran <%= reviewRef %>">
      <button type="button" class="btn btn-dark" data-quran-review-grade="again">Again</button>
      <button type="button" class="btn btn-danger" data-quran-review-grade="hard">Hard</button>
      <button type="button" class="btn btn-primary" data-quran-review-grade="good">Good</button>
      <button type="button" class="btn btn-success" data-quran-review-grade="easy">Easy</button>
    </div>
    <button type="button" class="btn btn-sm btn-secondary quran-memorize-skip" data-quran-review-grade="skip">Skip</button>
  </div>
  <span class="small text-muted" data-quran-review-status aria-live="polite"></span>
  <% if (quranRecitationFeedbackEnabled) { %><span class="visually-hidden" data-quran-recitation-feedback role="status" aria-live="polite"></span><% } %>
</div>
<% } else if (locals.showRating) { %>
<div class="quran-memorize-rating quran-memorize-launch-actions"><a class="btn btn-sm btn-outline-secondary quran-memorize-list-link" href="/quran/review"><span class="bi bi-bar-chart-line" aria-hidden="true"></span> Progress</a><button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#quran-memorize-review-modal" data-quran-memorize-review-page="<%= pageNumber %>"><span class="bi bi-arrow-repeat" aria-hidden="true"></span> Review</button><% if (quranRecitationFeedbackEnabled) { %><span class="visually-hidden" data-quran-recitation-feedback role="status" aria-live="polite"></span><% } %></div>
<% } %>
