<% 
  if (page.canonical)
    page.canonical = page.canonical.replace(/\?o=0$/, '');
  var quranCanonicalBaseUrl = utils.quranBaseUrl(req);
  var isQuranHeadPage = page
    && (
      (page.context && page.context.book && page.context.book.alias === 'quran')
      || (page.context && page.context.quranSearchProxy)
      || (page.canonical && (
        page.canonical === '/quran'
        || page.canonical.indexOf('/quran/') === 0
        || page.canonical.indexOf('/quran:') === 0
      ))
    );
  var isQuranCanonicalPage = page && page.canonical && isQuranHeadPage;
  var isQuranPathHeadPage = page
    && (
      (page.context && page.context.quranSearchProxy)
      || (page.canonical && (
        page.canonical === '/quran'
        || page.canonical.indexOf('/quran/') === 0
      ))
    );
  var headTitle = page.title_en || (isQuranPathHeadPage ? 'Quran Unlocked' : site.name);
  var headDescription = page.description_en || page.subtitle_en || site.desc || '';
  var headSiteName = isQuranPathHeadPage ? 'Quran Unlocked' : site.name;
  var headSiteUrl = isQuranPathHeadPage ? quranCanonicalBaseUrl : site.url;
  var headLogo = page.cover || site.logo;
  if (isQuranPathHeadPage)
    headLogo = headLogo.replace(site.url, quranCanonicalBaseUrl);
  function quranCanonicalPath(path) {
    if (!path)
      return path;
    return path;
  }
  function canonicalUrlForPath(path) {
    if (isQuranCanonicalPage)
      return quranCanonicalBaseUrl + quranCanonicalPath(path);
    return site.url + path;
  }
  var headCanonicalPath = isQuranCanonicalPage ? quranCanonicalPath(page.canonical) : page.canonical;
  var headCanonicalBaseUrl = isQuranCanonicalPage ? quranCanonicalBaseUrl : site.url;
  var headCanonicalUrl = headCanonicalBaseUrl + headCanonicalPath;
%>
<title><%= headTitle %></title>

<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<% if (headDescription) { %>
<meta name="description" content="<%= headDescription %>">
<% } %>
<% if (page.noindex) { %>
<meta name="robots" content="noindex,follow">
<% } %>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
<link rel="stylesheet" href="/stylesheets/style.css?v=20260612-tafsir-footnote-spacing-v1" rel="stylesheet">
<% if (page.feed || page.rss) { 
  if (page.feed) { %>
    <link rel="alternate" type="application/atom+xml" title="<%= page.title_en %>" href="<%= page.feed %>" />
  <% }
  if (page.rss) { %>
    <link rel="alternate" type="application/rss+xml" title="<%= page.title_en %>" href="<%= page.rss %>" />
  <% } %>
<% } else { %>
  <link rel="alternate" type="application/atom+xml" title="Recent translations of beautiful and notable aḥādīth" href="<%= site.url %>/highlights/feed" />
  <link rel="alternate" type="application/rss+xml" title="Recent translations of beautiful and notable aḥādīth" href="<%= site.url %>/highlights/rss" />
<% } %>

<link rel="image_src" href="<%= page.cover || site.logo %>" />
<link rel="apple-touch-icon" href="<%= page.cover || site.logo %>" />
<link rel="icon" href="<%= page.cover || site.logo %>" />
<link rel="icon" href="/favicon.ico" />


<link rel="canonical" href="<%= headCanonicalUrl %>" />
<% 	if (page && page.menu !== 'Home') {
		if (page.prev) { %>
<link rel="prev" href="<%= page.prev %>" />
<% 		}
		if (page.next) { %>
<link rel="next" href="<%= page.next %>" />
<% 		}
	} %>

<meta property="og:site_name" content="<%= headSiteName %>">
<meta property="og:locale" content="en">
<meta property="og:image" content="<%= page.cover || site.logo %>">
<meta property="og:url" content="<%= headCanonicalUrl %>">
<meta property="og:title" content="<%= headTitle %>">
<meta property="og:description" content="<%= headDescription %>">
<meta property="og:type" content="article" />

<meta name="twitter:card" content="summary">
<meta name="twitter:image" content="<%= page.cover || site.logo %>">
<meta name="twitter:title" content="<%= headTitle %>">
<meta name="twitter:description" content="<%= headDescription %>">

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": "<%= headSiteName %>",
    "url": "<%= headSiteUrl %>",
    "logo": "<%= headLogo %>"
  }
</script>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "WebSite",
    "name": "<%= headSiteName %>",
    "url": "<%= headSiteUrl %>"
<% if (page.menu === 'Home') { %>
    , "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "<%= site.url %>/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
    }
<% } %>
  }
</script>

<% if (page.context.book !== undefined) { %>
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Book",
    "name": "<%= page.context.book.name_en %>",
    "inLanguage": "English",
    "url": "<%= canonicalUrlForPath(`/${page.context.book.alias}`) %>"
  }
</script>
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Book",
    "name": "<%= page.context.book.name %>",
    "inLanguage": "Arabic",
    "url": "<%= canonicalUrlForPath(`/${page.context.book.alias}`) %>"
  }
</script>
<% } %>

<% if (page.context.book !== undefined && page.context.chapter !== undefined) { %>
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Chapter",
    "name": "<%= `Chapter ${page.context.chapter.h1}: ${page.context.chapter.title_en || ''}` %>",
    "alternateName": "<%= `${page.context.book.shortName}، ${arabic.toArabicDigits(page.context.chapter.h1 + '')}- ${page.context.chapter.title || ''}` %>",
    "pageStart": "<%= page.context.chapter.start0 %>",
    "url": "<%= headCanonicalUrl %>",
    "schema:isPartOf": {
      "@id": "<%= canonicalUrlForPath(`/${page.context.book.alias}`) %>"
    }
  }
</script>
<% } %>

<% if ( page.context.book !== undefined &&  page.context.chapter !== undefined && 
	    page.context.section !== undefined) { %>
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "BreadcrumbList",
    "name": "Books &gt; <%= page.context.book.name_en %> &gt; Chapter <%= page.context.chapter.h1 %>  &gt; Section <%= page.context.section.h2 %>",
    "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Books",
        "item": "<%- `${site.url}/books` %>"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "<%- page.context.book.name_en %>",
        "item": "<%- canonicalUrlForPath(`/${page.context.book.alias}`) %>"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "<%= `${page.context.chapter.h1}. ${page.context.chapter.title_en || 'Chapter'}` %>",
        "item": "<%= canonicalUrlForPath(`/${page.context.book.alias}/${page.context.chapter.h1}`) %>"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": "<%= `${page.context.section.h2}. ${page.context.section.title_en || 'Section'}` %>",
        "item": "<%= canonicalUrlForPath(`/${page.context.book.alias}/${page.context.chapter.h1}/${page.context.section.h2}`) %>"
      }
    ]
  }
</script>
<% } else if ( page.context.book !== undefined &&  page.context.chapter !== undefined) { %>
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "BreadcrumbList",
    "name": "Books &gt; <%= page.context.book.name_en %> &gt; Chapter <%= page.context.chapter.h1 %>",
    "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Books",
        "item": "<%- `${site.url}/books` %>"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "<%= page.context.book.name_en %>",
        "item": "<%= canonicalUrlForPath(`/${page.context.book.alias}`) %>"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "<%= `${page.context.chapter.h1}. ${page.context.chapter.title_en || 'Chapter'}` %>",
        "item": "<%= canonicalUrlForPath(`/${page.context.book.alias}/${page.context.chapter.h1}`) %>"
      }
    ]
  }
</script>
<% } else if ( page.context.book !== undefined) { %>
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "BreadcrumbList",
    "name": "Books &gt; <%= page.context.book.name_en %>",
    "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Books",
        "item": "<%- `${site.url}/books` %>"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "<%- page.context.book.name_en %>",
        "item": "<%- canonicalUrlForPath(`/${page.context.book.alias}`) %>"
      }
    ]
  }
</script>
<% } %>

<% if (page.context.hadiths && !page.context.fromSearch) { %>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "name": "<%- `${page.context.hadiths[0].book.shortName_en} ${page.context.hadiths[0].num}` %>",
    "headline": "<%- `${page.context.hadiths[0].book.shortName_en} ${page.context.hadiths[0].num}` %>",
    "url": "<%- headCanonicalUrl %>",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "<%- headCanonicalUrl %>"
    },
    "genre": "Hadith",
    "author": [{
        "@type": "Book",
        "name": "<%- page.context.hadiths[0].book.name_en %>",
        "url": "<%- canonicalUrlForPath(`/${page.context.hadiths[0].book.alias}`) %>"
      },
      {
        "@type": "Person",
        "name": "<%- page.context.hadiths[0].book.author %>"
      }
    ]
  }
</script>
<% } %>
