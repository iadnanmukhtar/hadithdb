<% 
  function cleanCanonicalPath(path) {
    if (!path)
      return path;
    var parts = path.toString().split('?');
    if (parts.length < 2)
      return path;
    var params = new URLSearchParams(parts.slice(1).join('?'));
    params.delete('flush');
    if (params.get('o') === '0')
      params.delete('o');
    var query = params.toString();
    return query ? `${parts[0]}?${query}` : parts[0];
  }
  if (page.canonical)
    page.canonical = cleanCanonicalPath(page.canonical);
  var quranCanonicalBaseUrl = site.quranUrl || utils.quranBaseUrl(req);
  var hadithCanonicalBaseUrl = site.url || utils.hadithBaseUrl(req);
  var isQuranHeadPage = page
    && (
      (page.context && page.context.book && page.context.book.alias === 'quran')
      || (page.context && page.context.quranSearchProxy)
      || (page.canonical && (
        page.canonical === '/quran'
        || page.canonical.indexOf('/quran/') === 0
        || page.canonical.indexOf('/quran:') === 0
      ))
    );
  var isQuranCanonicalPage = page && page.canonical && isQuranHeadPage;
  var isQuranPathHeadPage = page
    && (
      (page.context && page.context.quranSearchProxy)
      || (page.canonical && (
        page.canonical === '/quran'
        || page.canonical.indexOf('/quran/') === 0
      ))
    );
  var headTitle = page.title_en || (isQuranPathHeadPage ? 'Quran Unlocked' : site.name);
  var headDescription = page.description_en || page.subtitle_en || site.desc || '';
  var headSiteName = isQuranHeadPage ? 'Quran Unlocked' : site.name;
  var headSiteUrl = isQuranHeadPage ? quranCanonicalBaseUrl : site.url;
  var headAppLogo = isQuranHeadPage ? `${quranCanonicalBaseUrl}/images/quran-logo.png` : site.logo;
  var headAppLogoVectorPath = isQuranHeadPage ? '/images/quran-logo2.svg' : '/images/logo2.svg';
  var headAppLogo32Path = isQuranHeadPage ? '/images/quran-logo32.png' : '/images/logo32.png';
  var headAppFavicon16Path = isQuranHeadPage ? '/images/quran-favicon-16x16.png' : '/images/favicon-16x16.png';
  var headAppTouchIconPath = isQuranHeadPage ? '/images/quran-apple-touch-icon.png' : '/images/apple-touch-icon.png';
  var headAppIcoPath = isQuranHeadPage ? '/images/quran-favicon.ico' : '/favicon.ico';
  var headLogo = page.cover || headAppLogo;
  function quranCanonicalPath(path) {
    if (!path)
      return path;
    return path;
  }
  function canonicalUrlForPath(path) {
    if (isQuranCanonicalPage)
      return quranCanonicalBaseUrl + quranCanonicalPath(path);
    return hadithCanonicalBaseUrl + path;
  }
  var headCanonicalPath = isQuranCanonicalPage ? quranCanonicalPath(page.canonical) : page.canonical;
  var headCanonicalBaseUrl = isQuranCanonicalPage ? quranCanonicalBaseUrl : hadithCanonicalBaseUrl;
  var headCanonicalUrl = headCanonicalBaseUrl + headCanonicalPath;
  var pageContext = page.context || {};
  var contextBook = pageContext.book;
  var contextCommentaryBook = pageContext.quranCommentaryBook || pageContext.commentaryBook;
  var contextChapter = pageContext.chapter;
  var contextSection = pageContext.section;
  var isQuranBookContext = contextBook && contextBook.alias === 'quran';
  var contextCatalogName = isQuranBookContext ? 'Quran' : 'Books';
  var contextCatalogUrl = isQuranBookContext ? `${quranCanonicalBaseUrl}/quran` : `${site.url}/books`;
  function chapterLabel(chapter) {
    return isQuranBookContext ? `Surah ${chapter.h1}` : `Chapter ${chapter.h1}`;
  }
  function sectionLabel(section) {
    return isQuranBookContext ? `Section ${section.h2}` : `Section ${section.h2}`;
  }
  function breadcrumbItem(position, name, item) {
    return {
      '@type': 'ListItem',
      position: position,
      name: name,
      item: item
    };
  }
  function contextBookUrl(book) {
    if (!book || !book.alias)
      return '';
    return canonicalUrlForPath(`/${book.alias}`);
  }
  function contextChapterUrl(book, chapter) {
    if (!book || !book.alias || chapter === undefined)
      return '';
    return canonicalUrlForPath(`/${book.alias}/${chapter.h1}`);
  }
  function contextSectionUrl(book, chapter, section) {
    if (!book || !book.alias || chapter === undefined || section === undefined)
      return '';
    return canonicalUrlForPath(`/${book.alias}/${chapter.h1}/${section.h2}`);
  }
%>
<% if (typeof newrelic !== 'undefined' && newrelic && typeof newrelic.getBrowserTimingHeader === 'function') { %>
<%- newrelic.getBrowserTimingHeader() %>
<% } %>
<title><%= headTitle %></title>

<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<% if (headDescription) { %>
<meta name="description" content="<%= headDescription %>">
<% } %>
<% if (page.noindex) { %>
<meta name="robots" content="noindex,<%= page.nofollow ? 'nofollow' : 'follow' %>">
<% } %>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
<link rel="stylesheet" href="/stylesheets/style.css?v=<%= utils.styleAssetVersion() %>" rel="stylesheet">
<% if (page.feed || page.rss) { 
  if (page.feed) { %>
    <link rel="alternate" type="application/atom+xml" title="<%= page.title_en %>" href="<%= page.feed %>" />
  <% }
  if (page.rss) { %>
    <link rel="alternate" type="application/rss+xml" title="<%= page.title_en %>" href="<%= page.rss %>" />
  <% } %>
<% } else { %>
  <link rel="alternate" type="application/atom+xml" title="Recent translations of beautiful and notable aḥādīth" href="<%= site.url %>/highlights/feed" />
  <link rel="alternate" type="application/rss+xml" title="Recent translations of beautiful and notable aḥādīth" href="<%= site.url %>/highlights/rss" />
<% } %>

<link rel="image_src" href="<%= page.cover || headAppLogo %>" />
<link rel="icon" type="image/svg+xml" href="<%= headAppLogoVectorPath %>" />
<link rel="icon" type="image/png" sizes="32x32" href="<%= headAppLogo32Path %>" />
<link rel="icon" type="image/png" sizes="16x16" href="<%= headAppFavicon16Path %>" />
<link rel="apple-touch-icon" sizes="180x180" href="<%= headAppTouchIconPath %>" />
<link rel="icon" href="<%= headAppIcoPath %>" sizes="any" />


<link rel="canonical" href="<%= headCanonicalUrl %>" />
<% 	if (page && page.menu !== 'Home') {
		if (page.prev) { %>
<link rel="prev" href="<%= page.prev %>" />
<% 		}
		if (page.next) { %>
<link rel="next" href="<%= page.next %>" />
<% 		}
	} %>

<meta property="og:site_name" content="<%= headSiteName %>">
<meta property="og:locale" content="en">
<meta property="og:image" content="<%= page.cover || headAppLogo %>">
<meta property="og:url" content="<%= headCanonicalUrl %>">
<meta property="og:title" content="<%= headTitle %>">
<meta property="og:description" content="<%= headDescription %>">
<meta property="og:type" content="article" />

<meta name="twitter:card" content="summary">
<meta name="twitter:image" content="<%= page.cover || headAppLogo %>">
<meta name="twitter:title" content="<%= headTitle %>">
<meta name="twitter:description" content="<%= headDescription %>">

<%- utils.jsonLdScript({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: headSiteName,
  url: headSiteUrl,
  logo: headLogo
}) %>

<%
  var websiteJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: headSiteName,
    url: headSiteUrl
  };
  if (page.menu === 'Home') {
    websiteJsonLd.potentialAction = {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${site.url}/?q={search_term_string}`
      },
      'query-input': 'required name=search_term_string'
    };
  }
%>
<%- utils.jsonLdScript(websiteJsonLd) %>

<%- utils.jsonLdScript({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: headTitle,
  headline: headTitle,
  description: headDescription,
  url: headCanonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: headSiteName,
    url: headSiteUrl
  }
}) %>

<% if (contextCommentaryBook) {
  var commentaryBookName = contextCommentaryBook.type === 'tafsir'
    ? `Tafsir ${contextCommentaryBook.shortName_en || contextCommentaryBook.name_en || contextCommentaryBook.alias}`
    : (contextCommentaryBook.name_en || contextCommentaryBook.title || contextCommentaryBook.shortName_en || contextCommentaryBook.alias);
  var commentaryBookSlug = contextCommentaryBook.quranBookSlug || contextCommentaryBook.slug || contextCommentaryBook.alias;
  var commentaryBookUrl = contextCommentaryBook.type === 'tafsir'
    ? `${quranCanonicalBaseUrl}/quran/tafsir/${commentaryBookSlug}`
    : `${quranCanonicalBaseUrl}/quran/${commentaryBookSlug}`;
%>
<%- utils.jsonLdScript({
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: commentaryBookName,
  author: (contextCommentaryBook.author_en || contextCommentaryBook.author) ? {
    '@type': 'Person',
    name: contextCommentaryBook.author_en || contextCommentaryBook.author
  } : undefined,
  inLanguage: contextCommentaryBook.lang || 'English',
  url: commentaryBookUrl
}) %>
<% } %>

<% if (contextBook !== undefined) { %>
<%- utils.jsonLdScript({
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: contextBook.name_en || contextBook.shortName_en || contextBook.alias || contextBook.name || contextBook.shortName,
  author: (contextBook.author_en || contextBook.author) ? {
    '@type': 'Person',
    name: contextBook.author_en || contextBook.author
  } : undefined,
  inLanguage: 'English',
  url: contextBookUrl(contextBook) || headCanonicalUrl
}) %>
<% if (contextBook.title || contextBook.name || contextBook.shortName) { %>
<%- utils.jsonLdScript({
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: contextBook.title || contextBook.name || contextBook.shortName,
  inLanguage: 'Arabic',
  url: contextBookUrl(contextBook) || headCanonicalUrl
}) %>
<% } %>
<% } %>

<% if (contextBook !== undefined && contextChapter !== undefined) { %>
<%- utils.jsonLdScript({
  '@context': 'https://schema.org',
  '@type': 'Chapter',
  name: `${isQuranBookContext ? `Surah ${contextChapter.title_en || contextChapter.h1}` : `${contextBook.shortName_en || contextBook.name_en || contextBook.alias} ${contextChapter.h1} | ${contextChapter.title_en || ''}`}`.trim(),
  alternateName: `${contextBook.shortName || contextBook.name || ''}، ${arabic.toArabicDigits(contextChapter.h1 + '')}- ${contextChapter.title || ''}`.trim(),
  pageStart: contextChapter.start0,
  url: headCanonicalUrl,
  isPartOf: {
    '@id': contextBookUrl(contextBook) || headCanonicalUrl
  }
}) %>
<% } %>

<%
  var breadcrumbItems = [];
  if (contextBook !== undefined) {
    breadcrumbItems.push(breadcrumbItem(1, contextCatalogName, contextCatalogUrl));
    if (!isQuranBookContext)
      breadcrumbItems.push(breadcrumbItem(2, contextBook.name_en || contextBook.shortName_en || contextBook.alias || contextBook.name || contextBook.shortName, contextBookUrl(contextBook) || headCanonicalUrl));
    if (contextChapter !== undefined) {
      breadcrumbItems.push(breadcrumbItem(breadcrumbItems.length + 1, `${contextChapter.h1}. ${contextChapter.title_en || chapterLabel(contextChapter)}`, contextChapterUrl(contextBook, contextChapter) || headCanonicalUrl));
    }
    if (contextSection !== undefined) {
      breadcrumbItems.push(breadcrumbItem(breadcrumbItems.length + 1, `${contextSection.h2}. ${contextSection.title_en || sectionLabel(contextSection)}`, contextSectionUrl(contextBook, contextChapter, contextSection) || headCanonicalUrl));
    }
  }
%>
<% if (breadcrumbItems.length > 0) { %>
<%- utils.jsonLdScript({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  name: breadcrumbItems.map(function (item) { return item.name; }).join(' > '),
  itemListElement: breadcrumbItems
}) %>
<% } %>

<% if (pageContext.hadiths && !pageContext.fromSearch && pageContext.hadiths[0]) { %>
<%- utils.jsonLdScript({
  '@context': 'https://schema.org',
  '@type': 'Article',
  name: headTitle,
  headline: headTitle,
  url: headCanonicalUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': headCanonicalUrl
  },
  genre: 'Hadith',
  author: [{
      '@type': 'Book',
      name: pageContext.hadiths[0].book.name_en,
      url: canonicalUrlForPath(`/${pageContext.hadiths[0].book.alias}`)
    },
    {
      '@type': 'Person',
      name: pageContext.hadiths[0].book.author_en || pageContext.hadiths[0].book.author
    }
  ]
}) %>
<% } %>
