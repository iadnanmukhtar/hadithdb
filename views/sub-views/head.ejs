<meta charset="utf-8">
<% if (locals.readerShell && locals.readerInitialFiles) { %>
<link rel="preload" as="script" href="/quran/api/<%= req.path.startsWith('/quran/page/') ? 'mushaf' : 'study' %>-templates.js?v=<%= utils.scriptAssetVersion() %>">
<%- include('quran_reader_start.ejs') %>
<% } %>
<% 
  function cleanCanonicalPath(path) {
    if (!path)
      return path;
    var parts = path.toString().split('?');
    if (parts.length < 2)
      return path;
    var rawQuery = parts.slice(1).join('?');
    var hasBareHelp = /(?:^|&)help(?:&|$)/.test(rawQuery);
    var hasBareMemorize = /(?:^|&)memorize(?:&|$)/.test(rawQuery);
    var params = new URLSearchParams(rawQuery);
    params.delete('flush');
    if (params.get('o') === '0')
      params.delete('o');
    var query = params.toString();
    if (hasBareHelp)
      query = query.replace(/(^|&)help=(?=&|$)/, '$1help');
    if (hasBareMemorize)
      query = query.replace(/(^|&)memorize=(?=&|$)/, '$1memorize');
    if (parts[0] === '/books')
      query = query.replace(/(^|&)(hadith|translation|tafsir|sharh|history|mushaf)=(?=&|$)/g, '$1$2');
    return query ? `${parts[0]}?${query}` : parts[0];
  }
  if (page.canonical)
    page.canonical = cleanCanonicalPath(page.canonical);
  if (page.canonical && page.context && page.context.book && page.context.book.alias !== 'quran')
    page.canonical = utils.canonicalHadithHeadingPath(page.canonical);
  var quranCanonicalBaseUrl = site.quranUrl || utils.quranBaseUrl(req);
  var hadithCanonicalBaseUrl = site.url || utils.hadithBaseUrl(req);
  var isQuranHeadPage = page
    && (
      (page.context && page.context.book && page.context.book.alias === 'quran')
      || (page.context && page.context.quranSearchProxy)
      || (page.canonical && (
        page.canonical === '/quran'
        || page.canonical.indexOf('/quran/') === 0
        || page.canonical.indexOf('/quran:') === 0
      ))
    );
  var isQuranCanonicalPage = page && page.canonical && isQuranHeadPage;
  var headRequestPath = req && req.originalUrl ? req.originalUrl.split('?')[0] : (req && req.path ? req.path : '');
  var isMudhakkirHeadPage = headRequestPath === '/quran/review'
    || ((headRequestPath === '/quran/page' || headRequestPath.indexOf('/quran/page/') === 0)
      && req && req.query
      && (req.query.memorize !== undefined || req.query.review !== undefined || req.query.reviewRef !== undefined));
  var quranHeadBrandName = isMudhakkirHeadPage ? 'Mudhakkir' : 'Quran Unlocked';
  var headTitle = utils.socialMetadata().title(page.title_en, '', isQuranHeadPage ? quranHeadBrandName : site.name);
  var headDescription = utils.socialMetadata().excerpt(page.description_en || site.desc || headTitle);
  var headSiteName = isQuranHeadPage ? quranHeadBrandName : site.name;
  var headSiteUrl = isQuranHeadPage ? quranCanonicalBaseUrl : site.url;
  var headAppLogo = isMudhakkirHeadPage
    ? `${quranCanonicalBaseUrl}/static/img/quran/mudhakkir.png`
    : (isQuranHeadPage ? `${quranCanonicalBaseUrl}/static/img/quran-logo.png` : utils.staticAssetUrl(site.logo));
  var headAppLogoVectorPath = isMudhakkirHeadPage ? '/static/img/quran/mudhakkir.svg' : (isQuranHeadPage ? '/static/img/quran-logo2.svg' : '/static/img/logo2.svg');
  var headAppLogo32Path = isMudhakkirHeadPage ? '/static/img/quran/mudhakkir.png' : (isQuranHeadPage ? '/static/img/quran-logo32.png' : '/static/img/logo32.png');
  var headAppFavicon16Path = isQuranHeadPage ? '/static/img/quran-favicon-16x16.png' : '/static/img/favicon-16x16.png';
  var headAppTouchIconPath = isMudhakkirHeadPage ? '/static/img/quran/mudhakkir.png' : (isQuranHeadPage ? '/static/img/quran-apple-touch-icon.png' : '/static/img/apple-touch-icon.png');
  var headAppIcoPath = isMudhakkirHeadPage ? '/static/img/quran/mudhakkir.ico' : (isQuranHeadPage ? '/static/img/quran-favicon.ico' : '/favicon.ico');
  var headLogo = utils.socialMetadata().image(utils.staticAssetUrl(page.cover) || (isMudhakkirHeadPage ? headAppLogo : null), isQuranHeadPage ? quranCanonicalBaseUrl : hadithCanonicalBaseUrl, isQuranHeadPage);
  var headUsesBrandSocialImage = headLogo === utils.socialMetadata().image(null, isQuranHeadPage ? quranCanonicalBaseUrl : hadithCanonicalBaseUrl, isQuranHeadPage);
  var headCanonicalBaseUrl = (isQuranCanonicalPage ? quranCanonicalBaseUrl : hadithCanonicalBaseUrl).replace(/\/$/, '');
  function canonicalUrlForPath(path) {
    return new URL(headCanonicalBaseUrl + path).href;
  }
  var headCanonicalUrl = canonicalUrlForPath(page.canonical || headRequestPath || '/');
  var pageContext = page.context || {};
  var contextBook = pageContext.book;
  var contextCommentaryBook = pageContext.quranCommentaryBook || pageContext.commentaryBook;
  var contextChapter = pageContext.chapter;
  var contextSection = pageContext.section;
  var isQuranBookContext = contextBook && contextBook.alias === 'quran';
	var contextCatalogName = pageContext.breadcrumbCatalogName || (isQuranBookContext ? 'Quran' : 'Books');
	var contextCatalogUrl = pageContext.breadcrumbCatalogUrl
	  ? canonicalUrlForPath(pageContext.breadcrumbCatalogUrl)
	  : (isQuranBookContext ? `${quranCanonicalBaseUrl}/quran` : `${site.url}/books`);
  function chapterLabel(chapter) {
    return isQuranBookContext ? `Surah ${chapter.h1}` : `Chapter ${chapter.h1}`;
  }
  function sectionLabel(section) {
	return isQuranBookContext ? `Passage ${section.h2}` : `Section ${section.h2}`;
  }
  function breadcrumbItem(position, name, item) {
    return {
      '@type': 'ListItem',
      position: position,
      name: name,
      item: item
    };
  }
  function contextBookUrl(book) {
    if (!book || !book.alias)
      return '';
    return canonicalUrlForPath(`/${book.alias}`);
  }
  function contextChapterUrl(book, chapter) {
    if (!book || !book.alias || !chapter)
      return '';
    var path = `/${book.alias}/${chapter.h1}`;
    return canonicalUrlForPath(book.alias === 'quran' ? path : utils.canonicalHadithHeadingPath(path));
  }
  function contextSectionUrl(book, chapter, section) {
    if (!book || !book.alias || !chapter || !section)
      return '';
    var path = `/${book.alias}/${chapter.h1}/${section.h2}`;
    return canonicalUrlForPath(book.alias === 'quran' ? path : utils.canonicalHadithHeadingPath(path));
  }
%>
<% if (typeof newrelic !== 'undefined' && newrelic && typeof newrelic.getBrowserTimingHeader === 'function') { %>
<%- newrelic.getBrowserTimingHeader() %>
<% } %>
<title><%= headTitle %></title>

<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta name="theme-color" content="#174d7c">
