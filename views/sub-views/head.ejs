<link rel="manifest" href="/manifests/<%= webApp.key %>.webmanifest">
<meta name="application-name" content="<%= webApp.name %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="<%= webApp.shortName %>">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<% } %>
<% if (headDescription) { %>
<meta name="description" content="<%= headDescription %>">
<% } %>
<% if (page.noindex) { %>
<meta name="robots" content="noindex,<%= page.nofollow ? 'nofollow' : 'follow' %>">
<% } %>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" integrity="sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="/vendor/toastr/toastr.min.css">
<link rel="stylesheet" href="/static/css/style.css?v=<%= utils.styleAssetVersion() %>">
<link rel="stylesheet" href="/static/css/community.css?v=<%= utils.styleAssetVersion() %>">
<% if (page.feed) { %>
<link rel="alternate" type="application/atom+xml" title="<%= headTitle %>" href="<%= page.feed %>">
<% } %>
<% if (page.rss) { %>
<link rel="alternate" type="application/rss+xml" title="<%= headTitle %>" href="<%= page.rss %>">
<% } %>

<link rel="icon" type="image/svg+xml" href="<%= headAppLogoVectorPath %>" />
<link rel="icon" type="image/png" sizes="32x32" href="<%= headAppLogo32Path %>" />
<link rel="icon" type="image/png" sizes="16x16" href="<%= headAppFavicon16Path %>" />
<link rel="apple-touch-icon" sizes="180x180" href="<%= headAppTouchIconPath %>" />
<link rel="icon" href="<%= headAppIcoPath %>" sizes="any" />


<% if (page.menu !== 'Error') { %>
<link rel="canonical" href="<%= headCanonicalUrl %>" />
<% } %>
<% if (page.menu !== 'Home' && page.prev) { %>
<link rel="prev" href="<%= page.prev %>">
<% } %>
<% if (page.menu !== 'Home' && page.next) { %>
<link rel="next" href="<%= page.next %>">
<% } %>

<% if (page.menu !== 'Error') { %>
<meta property="og:site_name" content="<%= headSiteName %>">
<meta property="og:locale" content="en_US">
<meta property="og:image" content="<%= headLogo %>">
<% if (headUsesBrandSocialImage) { %>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="512">
<meta property="og:image:height" content="512">
<% } %>
<meta property="og:image:alt" content="<%= headSiteName %>">
<meta property="og:url" content="<%= headCanonicalUrl %>">
<meta property="og:title" content="<%= headTitle %>">
<meta property="og:description" content="<%= headDescription %>">
<meta property="og:type" content="<%= page.articleType ? 'article' : 'website' %>" />

<meta name="twitter:card" content="summary">
<meta name="twitter:image" content="<%= headLogo %>">
<meta name="twitter:image:alt" content="<%= headSiteName %>">
<meta name="twitter:title" content="<%= headTitle %>">
<meta name="twitter:description" content="<%= headDescription %>">

<%
  var breadcrumbItems = [];
  if (contextBook) {
    breadcrumbItems.push(breadcrumbItem(1, contextCatalogName, contextCatalogUrl));
    if (page.sharhBreadcrumb)
      breadcrumbItems.push(breadcrumbItem(2, page.sharhBreadcrumb.title, canonicalUrlForPath(page.sharhBreadcrumb.href)));
    else if (!isQuranBookContext)
      breadcrumbItems.push(breadcrumbItem(2, contextBook.name_en || contextBook.shortName_en || contextBook.alias || contextBook.name || contextBook.shortName, contextBookUrl(contextBook) || headCanonicalUrl));
    if (contextChapter) {
	  var contextChapterName = isQuranBookContext
	    ? utils.quranSurahBreadcrumbLabel(contextChapter.h1, contextChapter.title_en)
	    : `${contextChapter.h1}. ${contextChapter.title_en || chapterLabel(contextChapter)}`;
	  breadcrumbItems.push(breadcrumbItem(breadcrumbItems.length + 1, contextChapterName, page.sharhBreadcrumb ? canonicalUrlForPath(page.sharhBreadcrumb.chapterHref) : contextChapterUrl(contextBook, contextChapter) || headCanonicalUrl));
    }
    if (contextSection) {
	  var contextSectionName = isQuranBookContext
	    ? sectionLabel(contextSection)
	    : (contextSection.title_en ? `${contextSection.h2}. ${contextSection.title_en}` : sectionLabel(contextSection));
	  breadcrumbItems.push(breadcrumbItem(breadcrumbItems.length + 1, contextSectionName, page.sharhBreadcrumb ? canonicalUrlForPath(page.sharhBreadcrumb.sectionHref) : contextSectionUrl(contextBook, contextChapter, contextSection) || headCanonicalUrl));
    }
  }
%>
<%
  var commentarySlug = contextCommentaryBook && (contextCommentaryBook.quranBookSlug || contextCommentaryBook.slug || contextCommentaryBook.alias);
  var commentaryUrl = page.sharhBook ? canonicalUrlForPath('/sharh/' + encodeURIComponent(page.sharhBook.alias)) : commentarySlug && quranCanonicalBaseUrl + (contextCommentaryBook.type === 'tafsir' ? '/quran/tafsir/' : '/quran/') + encodeURIComponent(commentarySlug);
  var nodes = utils.socialMetadata().structuredData({
    page, title: headTitle, description: headDescription, image: headLogo, url: headCanonicalUrl,
    siteName: isQuranHeadPage ? 'Quran Unlocked' : site.name, siteUrl: headSiteUrl, logo: utils.socialMetadata().image(null, headSiteUrl, isQuranHeadPage),
    breadcrumbs: breadcrumbItems, bookUrl: contextBookUrl(contextBook),
    chapterUrl: contextChapterUrl(contextBook, contextChapter), commentaryUrl
  });
  for (const node of nodes) { %>
<%- utils.jsonLdScript(node, node['@id'] === headCanonicalUrl) %>
<% } %>

<% } %>
