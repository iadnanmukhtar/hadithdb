<%
  const headingShuruh = Array.isArray(heading && heading.shuruh) ? heading.shuruh : [];
  const renderedHeadingShuruh = headingShuruh.filter(entry => site.editMode || entry.text || entry.text_en);
  const headingSharhBase = `hadith-heading-sharh-${heading.id}`;
%>
<% if (site.editMode || renderedHeadingShuruh.length) { %>
<section class="hadith-heading-sharh hadith-metadata-section mt-3" aria-label="Heading explanations">
  <heading class="row heading hadith-metadata-heading py-2" dir="ltr"><h3 class="col-md-6 col-sm-12 fs-5 title" lang="en">Explanations</h3><h3 class="col-md-6 col-sm-12 title" lang="ar" dir="rtl">الشروح</h3></heading>
  <div<% if (site.editMode) { %> data-hdith-sharh-sort-list data-sharh-owner-id="<%= heading.id %>" data-sharh-update-prop="hdith_toc_sharh.reorder"<% } %>>
  <% renderedHeadingShuruh.forEach(function (entry, entryIndex) { const bodyId = `${headingSharhBase}-body-${entryIndex + 1}`; const englishBodyId = `${bodyId}-en`; %>
  <article class="hadith-sharh-entry hadith-heading-sharh-entry" data-hdith-sharh-id="<%= entry.id %>"<% if (site.editMode) { %> data-hdith-sharh-sort-id="<%= entry.id %>" data-hdith-sharh-order-id="<%= entry.id %>"<% } %>>
    <div class="row hadith-sharh-entry-heading" dir="ltr">
      <div class="col-md-6 col-sm-12" lang="en" data-reader-language-column="english"><h4 class="fs-6"><% if (site.editMode) { %><input type="search" class="_e hadith-admin-combobox hadith-sharh-title-input" value="<%= entry.title_en || '' %>" data-sharh-title-language="en" data-id="<%= entry.id %>" data-prop="hdith_toc_sharh.title_en" placeholder="English book title" aria-label="English book title" autocomplete="off" autocapitalize="none" spellcheck="false"><% } else if (entry.title_en) { %><% if (entry.source_url) { %><a href="<%= entry.source_url %>" target="_blank" rel="noopener noreferrer"><%= entry.title_en %></a><% } else { %><span><%= entry.title_en %></span><% } %><% } %></h4></div>
      <div class="col-md-6 col-sm-12 hadith-sharh-title-ar" lang="ar" dir="rtl" data-reader-language-column="arabic"><h4 class="fs-6"><% if (site.editMode) { %><input type="search" class="_e hadith-admin-combobox hadith-sharh-title-input" value="<%= entry.title || '' %>" data-sharh-title-language="ar" data-id="<%= entry.id %>" data-prop="hdith_toc_sharh.title" placeholder="عنوان كتاب الشرح" aria-label="عنوان كتاب الشرح" autocomplete="off" autocapitalize="none" spellcheck="false"><% } else if (entry.source_url) { %><a href="<%= entry.source_url %>" target="_blank" rel="noopener noreferrer"><%= entry.title %></a><% } else { %><span><%= entry.title %></span><% } %></h4><% if (site.editMode) { %><span class="hadith-sharh-admin-actions"><button type="button" class="btn btn-sm btn-outline-secondary hadith-sharh-drag-handle" title="Drag to reorder" aria-label="Drag explanation to reorder"><span class="bi bi-grip-vertical" aria-hidden="true"></span></button><% if (entry.local) { %><button type="button" class="_click btn btn-sm btn-outline-danger hadith-sharh-delete" data-id="<%= entry.id %>" data-prop="hdith_toc_sharh.delete" data-loading-label="Deleting" title="حذف الشرح" aria-label="حذف الشرح"><span class="bi bi-trash" aria-hidden="true"></span></button><% } %></span><% } %></div>
    </div>
    <div class="row hadith-sharh-columns" dir="ltr">
      <% if (site.editMode) { %><div class="col-md-6 col-sm-12 hadith-sharh-column" lang="en" data-reader-language-column="english"><div class="_e hadith-sharh-body intro" data-id="<%= entry.id %>" data-prop="hdith_toc_sharh.text_en" data-edit-format="md" data-markdown-source="<%= entry.text_en || '' %>" data-markdown-empty-html="English explanation" data-placeholder="English explanation" aria-label="English explanation"><%- entry.text_en ? utils.markdownToHtml(entry.text_en) : 'English explanation' %></div></div><div class="col-md-6 col-sm-12 hadith-sharh-column" lang="ar" dir="rtl" data-reader-language-column="arabic"><div class="_e hadith-sharh-body intro" data-id="<%= entry.id %>" data-prop="hdith_toc_sharh.text" data-edit-format="md" data-markdown-source="<%= entry.text || '' %>" data-markdown-empty-html="نص الشرح" data-placeholder="نص الشرح" aria-label="نص الشرح"><%- entry.text ? utils.markdownToHtml(entry.text) : 'نص الشرح' %></div></div>
      <% } else { %><% if (entry.text_en) { %><div class="<%= entry.text ? 'col-md-6' : 'col-12' %> col-sm-12 hadith-sharh-column" lang="en" data-reader-language-column="english"><div class="hadith-sharh-collapse-wrap"><div class="hadith-sharh-body intro" id="<%= englishBodyId %>" data-hadith-sharh-collapsible><%- utils.markdownToHtml(entry.text_en) %></div><button type="button" class="hadith-sharh-more" data-hadith-sharh-expand aria-expanded="false" aria-controls="<%= englishBodyId %>" hidden>More...</button></div></div><% } %><% if (entry.text) { %><div class="<%= entry.text_en ? 'col-md-6' : 'col-12' %> col-sm-12 hadith-sharh-column" lang="ar" dir="rtl" data-reader-language-column="arabic"><div class="hadith-sharh-collapse-wrap"><div class="hadith-sharh-body intro" id="<%= bodyId %>" data-hadith-sharh-collapsible><%- utils.markdownToHtml(entry.text) %></div><button type="button" class="hadith-sharh-more" data-hadith-sharh-expand aria-expanded="false" aria-controls="<%= bodyId %>" hidden>مزيد...</button></div></div><% } %><% } %>
    </div>
  </article>
  <% }); %>
  </div>
  <% if (site.editMode) { %><div class="d-flex flex-wrap align-items-center gap-2 hadith-sharh-actions"><button type="button" class="_click btn btn-sm btn-outline-primary hadith-sharh-add" data-id="<%= heading.id %>" data-prop="hdith_toc_sharh.add" data-loading-label="Adding"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add explanation</button></div><% } %>
</section>
<% } %>
