<%
	const metadata = i.hdithMetadata || {};
	metadata.grades = Array.isArray(metadata.grades) ? metadata.grades : [];
	metadata.narrators = Array.isArray(metadata.narrators) ? metadata.narrators : [];
	metadata.sharh = Array.isArray(metadata.sharh) ? metadata.sharh : [];
	const renderedSharh = metadata.sharh.filter(entry => site.editMode || entry.text || entry.text_en);
	metadata.gharib = Array.isArray(metadata.gharib) ? metadata.gharib : [];
	metadata.similar = Array.isArray(metadata.similar) ? metadata.similar.filter(reference => reference.internal_ref) : [];
	const metadataBase = `hadith-metadata-${i.actual ? i.actual.id : i.id}`;
	const editableHadithId = i.actual ? i.actual.id : i.id;
	const similarSearchItems = Array.isArray(i.similar) ? i.similar : [];
	const similarSearchExcludeIds = [editableHadithId].concat(similarSearchItems.map(item => item.actual ? item.actual.id : item.id)).filter(Boolean);
	const similarSearchExcludeRefs = [i.actual ? i.actual.ref : i.ref].concat(similarSearchItems.map(item => item.actual ? item.actual.ref : item.ref), metadata.similar.map(reference => reference.internal_ref)).filter(Boolean);
	const gradeColorOptions = Array.isArray(metadata.gradeColors) ? metadata.gradeColors : [];
	function arabicOrdinal(value) { return String(value).replace(/\d/g, digit => '٠١٢٣٤٥٦٧٨٩'[Number(digit)]); }
	function bilingualLabel(english, arabic) { return [english, arabic].filter(Boolean).join(' — '); }
	function legacyGradeColor(gradeId) {
		if (gradeId === null || gradeId === undefined || gradeId === '') return (gradeColorOptions.find(colorOption => colorOption.id === 0) || {}).color || '';
		const id = Number(gradeId);
		const categoryId = Number.isInteger(id) && id >= 0 && id <= 1999 ? (id <= 199 ? 1 : (id <= 499 ? 2 : (id <= 599 ? 3 : 4))) : 0;
		const option = gradeColorOptions.find(colorOption => colorOption.id === categoryId);
		return option ? option.color : '';
	}
%>
<section class="hadith-metadata-panel col-12" aria-label="Hadith metadata">
	<div class="hadith-metadata-content">
		<% if (metadata.grades.length) { %>
		<section class="hadith-metadata-section mt-4" id="<%= metadataBase %>-grades" data-toc-heading-target data-toc-heading-key="grades">
			<heading class="row heading hadith-metadata-heading py-2" dir="ltr"><h3 class="col-md-6 col-sm-12 fs-5 title" lang="en">Scholarly Grades</h3><h3 class="col-md-6 col-sm-12 title" lang="ar" dir="rtl">أحكام المحدّثين</h3></heading>
			<div class="hadith-grade-list"<% if (site.editMode) { %> data-hdith-grade-sort-list data-hadith-id="<%= editableHadithId %>"<% } %>>
				<% metadata.grades.forEach(function (grade) { const hasEnglishGrade = !!(grade.grade_en && grade.grader_en); %>
				<div class="row hadith-grade-opinion<%= grade.primary ? ' hadith-grade-opinion-primary' : '' %>" dir="ltr"<% if (site.editMode && grade.id) { %> data-hdith-grade-order-id="<%= grade.id %>"<% } %><% if (site.editMode && !grade.primary) { %> data-hdith-grade-sort-id="<%= grade.id %>"<% } %>>
					<% if (grade.primary && site.editMode) { %>
					<div class="col-12 hadith-grade-opinion-en hadith-legacy-grade-editor" lang="en">
						<span class="hadith-legacy-grade-color" style="--hadith-grade-color: <%= grade.grade_color || legacyGradeColor(i.grade && i.grade.id) %>" aria-hidden="true"><span class="hadith-grade-color-indicator"></span></span>
						<select class="_e form-select form-select-sm" data-id="<%= editableHadithId %>" data-prop="hadith.gradeId" aria-label="Legacy hadith grade" title="Legacy hadith grade">
							<% global.grades.forEach(function (legacyGrade) { %><option value="<%= legacyGrade.id %>" data-grade-color="<%= legacyGradeColor(legacyGrade.id) %>" <%=(legacyGrade.id == (i.grade && i.grade.id)) ? 'selected' :''%>><%= bilingualLabel(legacyGrade.grade_en, legacyGrade.grade) %></option><% }); %>
						</select>
						<select class="_e form-select form-select-sm" data-id="<%= editableHadithId %>" data-prop="hadith.graderId" aria-label="Legacy hadith grader" title="Legacy hadith grader">
							<% global.graders.forEach(function (legacyGrader) { %><option value="<%= legacyGrader.id %>" <%=(legacyGrader.id == (i.grader && i.grader.id)) ? 'selected' :''%>><%= bilingualLabel(legacyGrader.shortName_en, legacyGrader.shortName) %></option><% }); %>
						</select>
					</div>
					<% } else if (site.editMode) { %>
					<div class="col-md-6 col-sm-12 hadith-grade-opinion-en hadith-scholarly-grade-editor" lang="en">
						<div class="hadith-scholarly-grade-copy"><span class="_e hadith-scholarly-grade-value" data-id="<%= grade.id %>" data-prop="hdith_grade.grade_en" data-placeholder="English grade" aria-label="English grade"><%= grade.grade_en || '' %></span> (<span class="_e hadith-scholarly-grader-value" data-id="<%= grade.id %>" data-prop="hdith_grade.grader_en" data-placeholder="English grader" aria-label="English grader"><%= grade.grader_en || '' %></span>)</div>
					</div>
					<div class="col-md-6 col-sm-12 hadith-grade-opinion-ar hadith-scholarly-grade-editor" lang="ar" dir="rtl">
						<div class="hadith-scholarly-grade-copy"><span class="_e hadith-scholarly-grade-value" data-id="<%= grade.id %>" data-prop="hdith_grade.grade" data-placeholder="الحكم" aria-label="الحكم"><%= grade.grade %></span> (<span class="_e hadith-scholarly-grader-value" data-id="<%= grade.id %>" data-prop="hdith_grade.grader" data-placeholder="المحدّث" aria-label="المحدّث"><%= grade.grader %></span>)</div>
						<span class="hadith-scholarly-grade-actions"><button type="button" class="btn btn-sm btn-outline-secondary hadith-grade-drag-handle" title="Drag to reorder" aria-label="Drag to reorder"><span class="bi bi-grip-vertical" aria-hidden="true"></span></button><span class="hadith-grade-color-editor" style="--hadith-grade-color: <%= grade.grade_color %>"><span class="hadith-grade-color-indicator" data-hdith-grade-color-indicator aria-hidden="true"></span><select class="_e hadith-grade-color-select" data-id="<%= grade.id %>" data-prop="hdith_grade.grade_category_id" aria-label="Grade color" title="Grade color"><% gradeColorOptions.forEach(function (colorOption) { %><option value="<%= colorOption.id %>" data-color="<%= colorOption.color %>" <%= Number(grade.grade_category_id) === colorOption.id ? 'selected' : '' %>><%= colorOption.label %></option><% }); %></select></span><button type="button" class="_click btn btn-sm btn-outline-danger hadith-grade-delete" data-id="<%= grade.id %>" data-prop="hdith_grade.delete" data-loading-label="Deleting" title="Delete scholarly grade"><span class="bi bi-trash" aria-hidden="true"></span></button></span>
					</div>
					<% } else if (hasEnglishGrade) { %>
					<div class="col-md-6 col-sm-12 hadith-grade-opinion-en" lang="en"><span><%= grade.grade_en %></span> (<span<% if (grade.grader_name_en) { %> title="<%= grade.grader_name_en %>"<% } %>><%= grade.grader_en %></span>)</div>
					<% } %>
					<% if (!site.editMode) { %><div class="col-md-6 col-sm-12 hadith-grade-opinion-ar<%= hasEnglishGrade ? '' : ' ms-md-auto' %>" lang="ar" dir="rtl"><% if (grade.grade_color) { %><span class="hadith-grade-color" style="--hadith-grade-color: <%= grade.grade_color %>" aria-hidden="true"></span><% } %><span><%= grade.grade %></span> (<% if (grade.source_url) { %><a href="<%= grade.source_url %>" target="_blank" rel="noopener noreferrer"><%= grade.grader %></a><% } else { %><span<% if (grade.grader_name) { %> title="<%= grade.grader_name %>"<% } %>><%= grade.grader %></span><% } %>)</div><% } %>
				</div>
				<% }); %>
			</div>
			<% if (site.editMode) { %><button type="button" class="_click btn btn-sm btn-outline-primary hadith-grade-add" data-id="<%= editableHadithId %>" data-prop="hdith_grade.add" data-loading-label="Adding"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add scholarly grade</button><% } %>
		</section>
		<% } %>

		<% if (metadata.narrators.length) { %>
		<section class="hadith-metadata-section mt-4" id="<%= metadataBase %>-isnad" data-toc-heading-target data-toc-heading-key="isnad">
			<heading class="row heading hadith-metadata-heading py-2" dir="ltr"><h3 class="col-md-6 col-sm-12 fs-5 title" lang="en">Chain of Narrators</h3><h3 class="col-md-6 col-sm-12 title" lang="ar" dir="rtl">الإسناد</h3></heading>
			<% if (metadata.sourceIsnadHtml) { %><div class="hadith-enriched-isnad enriched-isnad" lang="ar" dir="rtl"><%- metadata.sourceIsnadHtml %></div><% } %>
			<ol class="hadith-narrator-list" lang="ar" dir="rtl"><% metadata.narrators.forEach(function (narrator, narratorIndex) { const narratorAccentDetails = [narrator.reliability].concat(narrator.flags || []).filter(Boolean); %><li><div class="hadith-narrator-death"><% if (narrator.death_text) { %><bdi dir="ltr"><%= arabicOrdinal(narrator.death_text) %></bdi><% } %></div><div class="hadith-narrator-main"><h4 class="hadith-narrator-name"><a href="<%= narrator.source_url %>" target="_blank" rel="noopener noreferrer"><%= narrator.vocalized_name || narrator.name %></a><% if (narrator.display_fullname) { %><span class="hadith-narrator-fullname"><%= narrator.display_fullname %></span><% } %></h4><div class="hadith-narrator-details"><% narratorAccentDetails.forEach(function (detail, detailIndex) { %><% if (detailIndex) { %><span class="hadith-narrator-detail-separator"> · </span><% } %><span class="hadith-narrator-accent-detail"><%= detail %></span><% }); %><% if (narrator.generation_name) { %><% if (narratorAccentDetails.length) { %><span class="hadith-narrator-detail-separator"> · </span><% } %><span class="hadith-narrator-generation"><%= narrator.generation_name %></span><% } %></div></div><div class="hadith-narrator-marker" aria-hidden="true"><span class="hadith-narrator-ordinal"><%= arabicOrdinal(narratorIndex + 1) %></span><% if (narrator.formula && narratorIndex < metadata.narrators.length - 1) { %><span class="hadith-narrator-connector-label"><%= narrator.formula %></span><% } %></div></li><% }); %></ol>
		</section>
		<% } %>

		<% if (site.editMode || renderedSharh.length) { %>
		<section class="hadith-metadata-section mt-4" id="<%= metadataBase %>-sharh" data-toc-heading-target data-toc-heading-key="sharh">
			<heading class="row heading hadith-metadata-heading py-2" dir="ltr"><h3 class="col-md-6 col-sm-12 fs-5 title" lang="en">Explanations</h3><h3 class="col-md-6 col-sm-12 title" lang="ar" dir="rtl">الشرح</h3></heading>
			<div><% renderedSharh.forEach(function (entry, entryIndex) { const sharhBodyId = `${metadataBase}-sharh-body-${entryIndex + 1}`; const sharhEnglishBodyId = `${sharhBodyId}-en`; %><article class="hadith-sharh-entry" data-hdith-sharh-id="<%= entry.id %>"><div class="row hadith-sharh-entry-heading" dir="ltr"><div class="col-md-6 col-sm-12" lang="en"><h4 class="fs-6"><% if (site.editMode) { %><span class="_e" data-id="<%= entry.id %>" data-prop="hdith_sharh.title_en" data-placeholder="English book title" aria-label="English book title"><%= entry.title_en || '' %></span><% } else if (entry.title_en) { %><% if (entry.source_url) { %><a href="<%= entry.source_url %>" target="_blank" rel="noopener noreferrer"><%= entry.title_en %></a><% } else { %><span><%= entry.title_en %></span><% } %><% } %></h4></div><div class="col-md-6 col-sm-12 hadith-sharh-title-ar" lang="ar" dir="rtl"><h4 class="fs-6"><% if (site.editMode) { %><span class="_e" data-id="<%= entry.id %>" data-prop="hdith_sharh.title" data-placeholder="عنوان كتاب الشرح" aria-label="عنوان كتاب الشرح"><%= entry.title %></span><% } else if (entry.source_url) { %><a href="<%= entry.source_url %>" target="_blank" rel="noopener noreferrer"><%= entry.title %></a><% } else { %><span><%= entry.title %></span><% } %></h4><% if (site.editMode && entry.local) { %><button type="button" class="_click btn btn-sm btn-outline-danger hadith-sharh-delete" data-id="<%= entry.id %>" data-prop="hdith_sharh.delete" data-loading-label="Deleting" title="حذف الشرح" aria-label="حذف الشرح"><span class="bi bi-trash" aria-hidden="true"></span></button><% } %></div></div><div class="row hadith-sharh-columns" dir="ltr">
				<% if (site.editMode) { %><div class="col-md-6 col-sm-12 hadith-sharh-column" lang="en"><div class="_e hadith-sharh-body intro" data-id="<%= entry.id %>" data-prop="hdith_sharh.text_en" data-edit-format="md" data-markdown-source="<%= entry.text_en || '' %>" data-markdown-empty-html="English explanation" data-placeholder="English explanation" aria-label="English explanation"><%- entry.text_en ? utils.markdownToHtml(entry.text_en) : 'English explanation' %></div></div><div class="col-md-6 col-sm-12 hadith-sharh-column" lang="ar" dir="rtl"><div class="_e hadith-sharh-body intro" data-id="<%= entry.id %>" data-prop="hdith_sharh.text" data-edit-format="md" data-markdown-source="<%= entry.text || '' %>" data-markdown-empty-html="نص الشرح" data-placeholder="نص الشرح" aria-label="نص الشرح"><%- entry.text ? utils.markdownToHtml(entry.text) : 'نص الشرح' %></div></div>
				<% } else { %><% if (entry.text_en) { %><div class="<%= entry.text ? 'col-md-6' : 'col-12' %> col-sm-12 hadith-sharh-column" lang="en"><div class="hadith-sharh-collapse-wrap"><div class="hadith-sharh-body intro" id="<%= sharhEnglishBodyId %>" data-hadith-sharh-collapsible><%- utils.markdownToHtml(entry.text_en) %></div><button type="button" class="hadith-sharh-more" data-hadith-sharh-expand aria-expanded="false" aria-controls="<%= sharhEnglishBodyId %>" hidden>More...</button></div></div><% } %><% if (entry.text) { %><div class="<%= entry.text_en ? 'col-md-6' : 'col-12' %> col-sm-12 hadith-sharh-column" lang="ar" dir="rtl"><div class="hadith-sharh-collapse-wrap"><div class="hadith-sharh-body intro" id="<%= sharhBodyId %>" data-hadith-sharh-collapsible><%- utils.markdownToHtml(entry.text) %></div><button type="button" class="hadith-sharh-more" data-hadith-sharh-expand aria-expanded="false" aria-controls="<%= sharhBodyId %>" hidden>مزيد...</button></div></div><% } %><% } %>
			</div></article><% }); %></div>
			<% if (site.editMode) { %><div class="d-flex flex-wrap align-items-center gap-2 hadith-sharh-actions"><button type="button" class="_click btn btn-sm btn-outline-primary hadith-sharh-add" data-id="<%= editableHadithId %>" data-prop="hdith_sharh.add" data-loading-label="Adding"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add explanation</button><button type="button" class="_click btn btn-sm btn-outline-primary hadith-sharh-import-dorar" data-id="<%= editableHadithId %>" data-prop="hdith_sharh.import_dorar" data-loading-label="Importing"><span class="bi bi-download" aria-hidden="true"></span> Import from dorar.net</button></div><% } %>
		</section>
		<% } %>

	<% if (metadata.gharib.length) { %>
		<section class="hadith-metadata-section mt-4" id="<%= metadataBase %>-gharib" data-toc-heading-target data-toc-heading-key="gharib">
			<heading class="row heading hadith-metadata-heading py-2" dir="ltr"><h3 class="col-md-6 col-sm-12 fs-5 title" lang="en">Definitions</h3><h3 class="col-md-6 col-sm-12 title" lang="ar" dir="rtl">غريب الحديث</h3></heading>
			<div class="hadith-gharib-list" lang="ar" dir="rtl"><% metadata.gharib.forEach(function (entry) { %><details class="hadith-gharib-entry"><summary class="small"><%= entry.matchedText || entry.term %></summary><% if (entry.lexicon) { %><div class="text-muted small mb-2"><%= entry.lexicon %></div><% } %><% entry.definitions.forEach(function (definition) { %><article class="hadith-gharib-definition small"><% if (definition.book) { %><h4 class="small mb-1"><%= definition.book %></h4><% } %><p><%= definition.content %></p></article><% }); %></details><% }); %></div>
		</section>
		<% } %>

		<% if (site.editMode || (i.similar && i.similar.length) || metadata.similar.length) { %>
		<section class="hadith-metadata-section hadith-mushabihah-section mt-4" id="<%= metadataBase %>-mushabihah" data-toc-heading-target data-toc-heading-key="mushabihah">
			<heading class="row heading hadith-metadata-heading py-2" dir="ltr"><h3 class="col-md-6 col-sm-12 fs-5 title" lang="en">Similar Hadiths</h3><h3 class="col-md-6 col-sm-12 title" lang="ar" dir="rtl">أحاديث مشابهة</h3></heading>
			<% if (site.editMode) { %><div class="hadith-similar-admin-search mb-3" lang="ar" dir="rtl" data-hadith-similar-search data-parent-id="<%= editableHadithId %>" data-exclude-ids="<%= similarSearchExcludeIds.join(',') %>" data-exclude-refs="<%= similarSearchExcludeRefs.join(',') %>"><label class="visually-hidden" for="<%= metadataBase %>-similar-search">إضافة حديث مشابه</label><div class="input-group input-group-sm"><span class="input-group-text" aria-hidden="true"><span class="bi bi-search"></span></span><input id="<%= metadataBase %>-similar-search" type="search" class="form-control hadith-similar-search-input" lang="ar" dir="rtl" placeholder="إضافة حديث مشابه" aria-label="البحث عن حديث مشابه لإضافته" autocomplete="off" autocapitalize="none" spellcheck="false"></div><div class="visually-hidden" data-hadith-similar-search-status aria-live="polite"></div></div><% } %>
			<% if (metadata.similar.length) { %><ul class="hadith-source-similar-list fs-5" lang="ar" dir="rtl"><% metadata.similar.forEach(function (reference) { %><li><a class="hadith-source-similar-reference small" href="<%= utils.urlFor(req, `/${reference.internal_ref}`) %>"><%= reference.source_book_title || `كتاب ${reference.source_book_id}` %><% if (reference.source_num) { %> <bdi dir="ltr"><%= reference.source_num %></bdi><% } %></a><% if (reference.source_body_start) { %><div class="hadith-source-similar-body-start"><%= reference.source_body_start %></div><% } %></li><% }); %></ul><% } %>
			<% if (i.similar && i.similar.length) { %><%- include('hadith_reference_index.ejs', { references: i.similar }); %><% } %>
			<div class="similar-list"><% for (var similarIndex = 0; i.similar && similarIndex < i.similar.length; similarIndex++) { i.similar[similarIndex].rating = Math.round((i.similar[similarIndex].rating - 0.5) * 100 / 50 * 100 / 25); %><%- include('hadith.ejs', { site: site, page: page, i: i.similar[similarIndex], main: true, title: true, searchResult: false, similarSection: true }); %><% } %></div>
		</section>
		<% } %>
	</div>
</section>
