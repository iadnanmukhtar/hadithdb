<%
	const ayahs = locals.selectedAyahs || (locals.selectedAyah ? [locals.selectedAyah] : []);
	const clearHref = locals.clearHref;
	const prevHref = locals.prevHref;
	const nextHref = locals.nextHref;
	const prevLabel = locals.prevLabel || 'Previous ayah';
	const nextLabel = locals.nextLabel || 'Next ayah';
	const ayahHref = locals.ayahHref;
	const linkHeroAyah = ayahHref && !(site && site.editMode);
		const defaultTranslationBook = (global.commentaries || []).find(function (book) {
			return book && book.type === 'trans' && book.source === 'default';
		}) || {};
		const defaultTranslationShortName = defaultTranslationBook.shortName_en || defaultTranslationBook.shortName || 'Abdel Haleem';
		const fixedTranslationAlias = /^[A-Za-z0-9_-]+$/.test((locals.fixedTranslationAlias || '').toString())
			? locals.fixedTranslationAlias.toString()
			: '';
		const fixedTranslationBook = fixedTranslationAlias
			? (global.commentaries || []).find(function (book) {
				return book && book.type === 'trans' && book.alias === fixedTranslationAlias;
			})
			: null;
		const heroTranslationShortName = fixedTranslationBook
			? (fixedTranslationBook.shortName_en || fixedTranslationBook.shortName || fixedTranslationBook.name_en || fixedTranslationBook.alias)
			: defaultTranslationShortName;
	%>
<% if (ayahs.length > 0) { %>
<section class="quran-ayah-hero row<%= prevHref || nextHref ? ' quran-ayah-hero-with-nav' : '' %>">
		<% if (prevHref) { %>
		<a class="quran-ayah-hero-nav quran-ayah-hero-prev" href="<%= prevHref %>" rel="prev" title="<%= prevLabel %>" aria-label="<%= prevLabel %>">
			<span class="bi bi-chevron-left" aria-hidden="true"></span>
		</a>
		<% } %>
		<% if (nextHref) { %>
		<a class="quran-ayah-hero-nav quran-ayah-hero-next" href="<%= nextHref %>" rel="next" title="<%= nextLabel %>" aria-label="<%= nextLabel %>">
			<span class="bi bi-chevron-right" aria-hidden="true"></span>
		</a>
	<% } %>
	<% if (clearHref) { %>
	<a class="quran-ayah-hero-clear" href="<%= clearHref %>" title="Clear ayah selection" aria-label="Clear ayah selection">
		<span class="bi bi-x" aria-hidden="true"></span>
	</a>
	<% } %>
	<section class="col-12" lang="ar">
		<div class="quran-ayah-hero-body">
				<% ayahs.forEach(function (ayah) {
					var ayahNum = ayah.ar?.num || ayah.num || '';
					var ayahPart = ayahNum.split(/:/)[1] || ayahNum;
					var ayahLabel = (ayahs.indexOf(ayah) === 0) ? ayahNum : ayahPart;
					var ayahPartArabic = arabic.toArabicDigits(arabic.toLatinDigits(ayahPart) || ayahPart);
					var ayahBodyMarkdown = utils.emptyIfNull(ayah.ar?.body);
				var ayahBodyHtml = utils.markdownToHtml(ayahBodyMarkdown);
				var ayahRef = ayah.ref || `quran:${ayahNum}`;
				var ayahRefLatin = arabic.toLatinDigits((ayah.num || ayahNum || '').toString());
				var ayahRefParts = ayahRefLatin.split(/:/);
				var quranCorpusAttrs = ayahRefParts.length >= 2
					? ` data-quran-ref="${ayahRefParts[0]}:${ayahRefParts[1]}" data-quran-surah="${ayahRefParts[0]}" data-quran-ayah="${ayahRefParts[1]}"`
					: '';
				%>
						<div class="quran-ayah-hero-ayah">
							<% if (linkHeroAyah) { %><a class="quran-ayah-hero-link" href="<%= ayahHref %>" title="View Quran <%= ayahLabel %>"><% } %><div class="<%= site.editMode ? '_e ' : '' %>quran-ayah-hero-text"<%- quranCorpusAttrs %><% if (site.editMode) { %> data-id="<%= ayah.id %>" data-prop="hadith.body" data-markdown-source="<%= ayahBodyMarkdown %>" data-markdown-empty-html="&hellip;"<% } %>><%- ayahBodyHtml %></div>&nbsp;<span class="quran-ayah-end-marker" aria-label="Quran <%= ayahLabel %>">۝<%= ayahPartArabic %></span><% if (linkHeroAyah) { %></a><% } %>
						</div>
			<% }); %>
		</div>
	</section>
	<section class="col-12" lang="en">
		<div class="quran-ayah-hero-body">
			<% ayahs.forEach(function (ayah) {
				var ayahNum = ayah.en?.num || ayah.num || '';
				var ayahPart = ayahNum.split(/:/)[1] || ayahNum;
				var ayahLabel = (ayahs.indexOf(ayah) === 0) ? ayahNum : ayahPart;
				var ayahBodyMarkdown = utils.emptyIfNull(ayah.en?.body);
				var ayahBodyHtml = utils.markdownToHtml(ayahBodyMarkdown);
				var ayahRefLatin = arabic.toLatinDigits((ayah.num || ayahNum || '').toString());
				var ayahRefParts = ayahRefLatin.split(/:/);
					var quranTranslationAttrs = ayahRefParts.length >= 2
						? ` data-quran-translation-target="1" data-quran-surah="${ayahRefParts[0]}" data-quran-ayah="${ayahRefParts[1]}"`
						: '';
					if (quranTranslationAttrs && fixedTranslationAlias)
						quranTranslationAttrs += ` data-quran-fixed-translation-alias="${fixedTranslationAlias}"`;
					%>
						<div class="quran-ayah-hero-ayah">
								<% if (linkHeroAyah) { %><a class="quran-ayah-hero-link" href="<%= ayahHref %>" title="View Quran <%= ayahLabel %>"><% } %><sup><%= ayahLabel %></sup>&nbsp;<div class="<%= site.editMode ? '_e ' : '' %>quran-ayah-hero-text"<%- quranTranslationAttrs %><% if (site.editMode) { %> data-id="<%= ayah.id %>" data-prop="hadith.body_en" data-arabizi="true" data-markdown-source="<%= ayahBodyMarkdown %>" data-markdown-empty-html="&hellip;"<% } %>><%- ayahBodyHtml %></div> <span class="quran-translation-attribution" data-quran-translation-attribution="1">— <%= heroTranslationShortName %></span><% if (linkHeroAyah) { %></a><% } %>
						</div>
			<% }); %>
		</div>
	</section>
	<% if (locals.toolbar) { %>
		<%- include('quran_ayah_hero_actions.ejs', locals.toolbar); %>
	<% } %>
</section>
<% } %>
