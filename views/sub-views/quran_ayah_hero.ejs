<%
	const ayahs = locals.selectedAyahs || (locals.selectedAyah ? [locals.selectedAyah] : []);
%>
<% if (ayahs.length > 0) { %>
<section class="quran-ayah-hero row">
	<section class="col-12" lang="ar">
		<div class="quran-ayah-hero-body">
			<% ayahs.forEach(function (ayah) {
				var ayahNum = ayah.ar?.num || ayah.num || '';
				var ayahPart = ayahNum.split(/:/)[1] || ayahNum;
				var ayahLabel = (ayahs.indexOf(ayah) === 0) ? ayahNum : ayahPart;
				var ayahBodyMarkdown = utils.emptyIfNull(ayah.ar?.body);
				var ayahBodyHtml = utils.markdownToHtml(ayahBodyMarkdown);
				var ayahRef = ayah.ref || `quran:${ayahNum}`;
				var ayahHref = `/${ayahRef}`;
			%>
				<div class="quran-ayah-hero-ayah">
					<a class="quran-ayah-hero-link" href="<%= ayahHref %>"><sup><%= ayahLabel %></sup>&nbsp;<div class="<%= site.editMode ? '_e ' : '' %>quran-ayah-hero-text"<% if (site.editMode) { %> data-id="<%= ayah.id %>" data-prop="hadith.body" data-markdown-source="<%= ayahBodyMarkdown %>" data-markdown-empty-html="&hellip;"<% } %>><%- ayahBodyHtml %></div>&nbsp;<span class="quran-ayah-end-marker">۝</span></a>
				</div>
			<% }); %>
		</div>
	</section>
	<section class="col-12" lang="en">
		<div class="quran-ayah-hero-body">
			<% ayahs.forEach(function (ayah) {
				var ayahNum = ayah.en?.num || ayah.num || '';
				var ayahPart = ayahNum.split(/:/)[1] || ayahNum;
				var ayahLabel = (ayahs.indexOf(ayah) === 0) ? ayahNum : ayahPart;
				var ayahBodyMarkdown = utils.emptyIfNull(ayah.en?.body);
				var ayahBodyHtml = utils.markdownToHtml(ayahBodyMarkdown);
				var ayahRef = ayah.ref || `quran:${ayahNum}`;
				var ayahHref = `/${ayahRef}`;
			%>
				<div class="quran-ayah-hero-ayah">
					<a class="quran-ayah-hero-link" href="<%= ayahHref %>"><sup><%= ayahLabel %></sup>&nbsp;<div class="<%= site.editMode ? '_e ' : '' %>quran-ayah-hero-text"<% if (site.editMode) { %> data-id="<%= ayah.id %>" data-prop="hadith.body_en" data-arabizi="true" data-markdown-source="<%= ayahBodyMarkdown %>" data-markdown-empty-html="&hellip;"<% } %>><%- ayahBodyHtml %></div></a>
				</div>
			<% }); %>
		</div>
	</section>
</section>
<% } %>
