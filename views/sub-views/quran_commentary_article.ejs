<%
  var article = locals.article || {};
  var articleBook = locals.commentaryBook || {};
  var articleHasEn = Boolean(utils.trimToEmpty(article.intro_en));
  var articleHasAr = Boolean(utils.trimToEmpty(article.intro));
  var articleHasContent = articleHasEn || articleHasAr;
  var articleForceBilingual = Boolean(locals.introductionBilingual);
  var articleEditEmptyAr = site.editMode && !articleForceBilingual && !articleHasContent && articleBook.lang === 'ar';
  var articleEditEmptyEn = site.editMode && !articleHasContent && !articleEditEmptyAr;
  var articleShowEn = articleHasEn || articleEditEmptyEn || site.editMode;
  var articleShowAr = articleHasAr || site.editMode || articleEditEmptyAr;
  var articleShowTitleEn = articleShowEn || (articleForceBilingual && Boolean(utils.trimToEmpty(article.title_en)));
  var articleShowTitleAr = articleShowAr || (articleForceBilingual && Boolean(utils.trimToEmpty(article.title)));
%>
<article class="quran-commentary-introduction-article mt-4" id="introduction-<%= article.h2 %>" data-introduction-article="<%= article.h2 %>" data-quran-introduction-target="<%= article.h2 %>">
  <details class="quran-commentary-introduction-disclosure">
    <summary>
      <heading class="row heading py-2">
        <% if (articleShowTitleEn) { %><h2 class="<%= articleShowTitleAr ? 'col-md-6 col-sm-12' : 'col-12' %> fs-5 title" lang="en"><span class="_e" data-id="<%= article.id %>" data-prop="toc.title_en" data-placeholder="Introduction article title"><%- article.title_en || (site.editMode ? '&hellip;' : '') %></span></h2><% } %>
        <% if (articleShowTitleAr) { %><h2 class="<%= articleShowTitleEn ? 'col-md-6 col-sm-12' : 'col-12' %> fs-5 title" lang="ar" dir="rtl"><span class="_e" data-id="<%= article.id %>" data-prop="toc.title" data-placeholder="عنوان المقدمة"><%- article.title || (site.editMode ? '&hellip;' : '') %></span></h2><% } %>
      </heading>
    </summary>
    <section class="row heading-intro mb-3">
      <% if (articleShowEn) { %><section class="_e <%= articleShowAr ? 'col-md-6 col-sm-12' : 'col-12' %> intro" lang="en" data-id="<%= article.id %>" data-prop="toc.intro_en" data-reader-language-column="english" data-markdown-source="<%= utils.emptyIfNull(article.intro_en) %>" data-markdown-empty-html="&hellip;"><div><%- Tafsir.renderCommentaryText(article.intro_en, '', 'md', { englishQuotationMarks: true, quranBackticks: true, footnoteIdPrefix: `toc-introduction-${article.id}-en` }) || (site.editMode ? '&hellip;' : '') %></div></section><% } %>
      <% if (articleShowAr) { %><section class="_e <%= articleShowEn ? 'col-md-6 col-sm-12' : 'col-12' %> intro" lang="ar" dir="rtl" data-id="<%= article.id %>" data-prop="toc.intro" data-reader-language-column="arabic" data-markdown-source="<%= utils.emptyIfNull(article.intro) %>" data-markdown-empty-html="&hellip;"><div><%- Tafsir.renderCommentaryText(article.intro, '', 'md', { bracketedFootnotes: true, footnoteIdPrefix: `toc-introduction-${article.id}-ar` }) || (site.editMode ? '&hellip;' : '') %></div></section><% } %>
      <% if (site.editMode) { %><div class="col-md-6 col-sm-12<%= articleHasEn ? '' : ' ms-md-auto' %>" lang="en" dir="ltr"><aside class="admin hadith-admin-actions mt-1"><button type="button" class="_click btn btn-sm btn-outline-secondary hadith-admin-action ms-1 mb-1" data-id="<%= article.id %>" data-prop="toc.revise" data-loading-label="Revising" title="Revise this introduction article"><span class="bi bi-magic" aria-hidden="true"></span> Revise</button></aside></div><% } %>
    </section>
  </details>
  <% if (site.editMode && !Number(article.count)) { %>
  <button type="button" class="btn btn-sm btn-outline-danger mt-2" data-delete-introduction-article="<%= article.id %>">Delete article</button>
  <% } %>
</article>
