<dialog id="sunnah-dialog" aria-labelledby="sunnah-dialog-title">
  <header class="modal-header">
    <h2 class="modal-title fs-5" id="sunnah-dialog-title"><%- include('sunnah_icon.ejs') %> Sunnah of the Day</h2>
    <button type="button" data-sunnah-close class="btn-close" aria-label="Close" autofocus></button>
  </header>
  <div data-sunnah-modal-slot></div>
</dialog>
<template id="sunnah-card-template">
  <section class="quran-ayah-hero sunnah-hero row">
    <% for (const lang of ['ar', 'en']) { %>
      <section class="col-12" lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
        <div class="quran-ayah-hero-body"><div class="quran-ayah-hero-ayah">
          <div class="quran-ayah-hero-text" data-sunnah-text="<%= lang %>"></div>
          <a class="sunnah-detail-link" data-sunnah-detail hidden><%= lang === 'ar' ? 'اقرأ الحديث كاملًا' : 'Read full hadith' %></a>
          <% if (lang === 'en') { %><span class="quran-translation-attribution">— <a data-sunnah-ref></a></span><% } %>
        </div></div>
      </section>
    <% } %>
    <aside class="tags reader-social-actions quran-ayah-hero-toolbar col-12">
      <% for (const [action, label, icon] of [['another','Another reminder','arrow-clockwise'],['browse','Browse Mujtaba','book'],['minimize','Minimize','dash-lg'],['restore','Show on homepage','house']]) {
        const tag = action === 'browse' ? 'a' : 'button';
        const name = action === 'minimize' ? 'Minimize Sunnah of the Day' : label;
      %>
        <<%= tag %> <%- action === 'browse' ? 'href="/mujtaba"' : 'type="button"' %> data-sunnah-action="<%= action %>" class="quran-ayah-action icon text-accent" title="<%= name %>" aria-label="<%= name %>">
          <span class="bi bi-<%= icon %>" aria-hidden="true"></span><span class="quran-ayah-action-label"><%= label %></span>
        </<%= tag %>>
      <% } %>
    </aside>
    <span class="visually-hidden" role="status"></span>
  </section>
</template>
<script defer src="/static/js/sunnah-reminder.js?v=<%= utils.scriptAssetVersion() %>"></script>
