<% 
    var heading = page.context.heading;
    var isQuranPassage = page.context.book && page.context.book.alias === 'quran' && page.context.passage;
    function paginationHeadingLabel(direction, heading) {
      if (isQuranPassage) {
        if (heading.level == 1)
          return `${direction}:&nbsp;§${heading.h1}`;
        if (heading.level == 2)
          return `${direction}:&nbsp;§${heading.h1}.${heading.h2}`;
      }
      if (heading.level == 1)
        return `${direction}${page.type}:&nbsp;${heading.book.shortName_en}&nbsp;${heading.h1}`;
      if (heading.level == 2)
        return `${direction}${page.type}:&nbsp;${heading.book.shortName_en}&nbsp;§${heading.h1}.${heading.h2}`;
      return direction;
    }

    if (heading.page.offset) {
      page.canonical += `?o=${heading.page.offset}`;
      if (heading.page.number && (heading.page.hasNext || heading.page.number > 1))
        page.title_en += ` P${heading.page.number}`;
    }

    page.type = '';
    if (heading.page.hasPrev) {
      page.type = ' Page';
      page.prevHeading = heading;
      page.prev = `/${heading.path}?o=${heading.page.prevOffset}`;
      if (req.query.passage != undefined)
        page.prev += '&passage';
    } else if (heading.prev) {
      page.prevHeading = heading.prev;
      page.prev = `/${page.prevHeading.path}`;
      if (req.query.passage != undefined)
        page.prev += '?passage';
    }
    if (page.prev) {
      page.prevTitle = paginationHeadingLabel('Prev', page.prevHeading);
    }

    if (heading.page.hasNext) {
      page.type = ' Page';
      page.nextHeading = heading;
      page.next = `/${heading.path}?o=${heading.page.nextOffset}`;
      if (req.query.passage != undefined)
        page.next += '&passage';
    } else if (heading.next) {
      page.nextHeading = heading.next;
      page.next = `/${page.nextHeading.path}`;
      if (req.query.passage != undefined)
        page.next += '?passage';
    }
    if (page.next) {
      page.nextTitle = paginationHeadingLabel('Next', page.nextHeading);
    }

%>

<aside class="row mb-3 pagination">
  <div class="col-md-6 col-xs-12 text-start pagination-nav-slot pagination-nav-slot-prev">
    <% if (page.prev) { %>
    <a class="pagination-nav-link" title="<%- page.prevHeading.title_en || page.prevHeading.title %>" href="<%- utils.urlFor(req, page.prev) %>" rel="prev"><span class="pagination-nav-chevron bi bi-chevron-left" aria-hidden="true"></span><span class="pagination-nav-label">&nbsp;<%- page.prevTitle %></span></a>
    <% } %>
  </div>
  <div class="col-md-6 col-xs-12 text-end pagination-nav-slot pagination-nav-slot-next">
    <% if (page.next) { %>
    <a class="pagination-nav-link" title="<%- page.nextHeading.title_en || page.nextHeading.title %>" href="<%- utils.urlFor(req, page.next) %>" rel="next"><span class="pagination-nav-label"><%- page.nextTitle %>&nbsp;</span><span class="pagination-nav-chevron bi bi-chevron-right" aria-hidden="true"></span></a>
    <% } %>
  </div>
</aside>
