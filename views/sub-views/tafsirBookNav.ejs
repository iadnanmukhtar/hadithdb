<%
	const tafsirBooks = Array.isArray(tafsirs) ? tafsirs : [];
	const orderedTafsirs = ['en', 'ar'].reduce(function (items, lang) {
		const group = tafsirBooks.filter(function (tafsir) {
			return tafsir.lang === lang;
		}).sort(function (a, b) {
			const ordinal = Number(a.ordinal || 0) - Number(b.ordinal || 0);
			if (ordinal !== 0)
				return ordinal;
			return (a.shortName_en || a.name_en || a.alias).localeCompare(b.shortName_en || b.name_en || b.alias);
		});
		return items.concat(group);
	}, []);
	function tafsirBookHref(tafsir) {
		const slug = tafsir.slug || Tafsir.tafsirSlug(tafsir.alias);
		const hasLanguageCollision = tafsirBooks.some(function (other) {
			return other && other.lang !== tafsir.lang && (other.slug || Tafsir.tafsirSlug(other.alias)) === slug;
		});
		const query = hasLanguageCollision && (tafsir.lang === 'ar' || tafsir.lang === 'en')
			? `?lang=${encodeURIComponent(tafsir.lang)}`
			: '';
		return utils.quranUrl(req, `/quran/tafsir/${encodeURIComponent(slug)}${query}`);
	}
	function tafsirBookLabel(tafsir) {
		return Tafsir.rawShortName(tafsir, 'en').replace(/^tafs[īi]r\s+/i, '').trim();
	}
	function tafsirSizeLabel(tafsir) {
		const size = utils.emptyIfNull(tafsir.size || '').toString();
		if (size === 'lg')
			return 'Large tafsir';
		if (size === 'md')
			return 'Medium tafsir';
		if (size === 'sm')
			return 'Small tafsir';
		return '';
	}
	function tafsirSizeIndicator(tafsir) {
		const size = utils.emptyIfNull(tafsir.size || '').toString();
		const label = tafsirSizeLabel(tafsir);
		if (!label)
			return '';
		return `<span class="tafsir-size-indicator tafsir-size-tooltip tafsir-size-indicator-${size}" title="${label}" data-tafsir-size-tooltip="${label}" aria-label="${label}" role="img"></span>`;
	}
	function tafsirDeathTooltipLabel(tafsir) {
		var death = utils.emptyIfNull(tafsir.death || '').toString().trim();
		if (!death)
			return '';
		if (!/\b(?:AH|H)\b/i.test(death) && !/هـ/u.test(death))
			death = `${death} AH`;
		return /^d\./i.test(death) ? death : `d. ${death}`;
	}
		function tafsirBookTooltip(tafsir) {
			return [
				tafsir.name_en || tafsir.title || tafsir.shortName_en || tafsir.shortName || tafsir.alias,
				tafsir.author_en || tafsir.author,
				tafsirDeathTooltipLabel(tafsir),
				tafsir.published_year ? `Pub. ${tafsir.published_year}` : '',
				tafsir.publisher
			].filter(Boolean).join('\n');
		}
%>
<% if (orderedTafsirs.length > 0) { %>
	<div class="h-menu-wrap mb-3">
		<div class="h-menu-hint d-md-none">
			<i class="bi bi-arrow-left-right"></i> Swipe to browse tafsīr books
		</div>
		<div class="h-menu-scroller">
			<div class="btn-group h-menu text-nowrap" role="group">
				<% orderedTafsirs.forEach(function (tafsir) { %>
					<a class="btn btn-outline-primary text-nowrap tafsir-book-tooltip" href="<%= tafsirBookHref(tafsir) %>" data-tafsir-tooltip="<%= tafsirBookTooltip(tafsir) %>" data-tafsir-book-nav-item data-tafsir-alias="<%= tafsir.alias %>" data-tafsir-lang="<%= tafsir.lang %>" data-tafsir-death="<%= tafsir.death || '' %>" data-tafsir-ordinal="<%= tafsir.ordinal || 0 %>"><%- tafsirBookLabel(tafsir) %><%- tafsirSizeIndicator(tafsir) %></a>
				<% }); %>
			</div>
		</div>
	</div>
<% } %>
