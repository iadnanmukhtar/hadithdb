<%
	const tafsirBooks = Tafsir.uniqueCarouselTafsirs(Array.isArray(tafsirs) ? tafsirs : []);
	const orderedTafsirs = ['en', 'ar'].reduce(function (items, lang) {
		const group = tafsirBooks.filter(function (tafsir) {
			return tafsir.lang === lang;
		}).sort(function (a, b) {
			if (Tafsir.isDefaultTafsir(a) !== Tafsir.isDefaultTafsir(b))
				return Tafsir.isDefaultTafsir(a) ? -1 : 1;
			const ordinal = Number(a.ordinal || 0) - Number(b.ordinal || 0);
			if (ordinal !== 0)
				return ordinal;
			return (a.shortName_en || a.name_en || a.alias).localeCompare(b.shortName_en || b.name_en || b.alias);
		});
		return items.concat(group);
	}, []);
	function tafsirBookHref(tafsir) {
		const slug = tafsir.slug || Tafsir.tafsirSlug(tafsir.alias);
		return utils.quranUrl(req, `/quran/tafsir/${encodeURIComponent(slug)}`);
	}
	function tafsirBookLabel(tafsir) {
		return Tafsir.rawShortName(tafsir, 'en').replace(/^tafs[īi]r\s+/i, '').trim();
	}
	function tafsirSizeLabel(tafsir) {
		const size = utils.emptyIfNull(tafsir.size || '').toString();
		if (size === 'lg')
			return 'Large tafsir';
		if (size === 'md')
			return 'Medium tafsir';
		if (size === 'sm')
			return 'Small tafsir';
		return '';
	}
	function tafsirSizeIndicator(tafsir) {
		const size = utils.emptyIfNull(tafsir.size || '').toString();
		const label = tafsirSizeLabel(tafsir);
		if (!label)
			return '';
		return `<span class="tafsir-size-indicator tafsir-size-indicator-${size}" aria-label="${label}" role="img"></span>`;
	}
%>
<% if (orderedTafsirs.length > 0) { %>
	<div class="h-menu-wrap mb-3">
		<div class="h-menu-hint d-md-none">
			<i class="bi bi-arrow-left-right"></i> Swipe to browse tafsīr books
		</div>
		<div class="h-menu-scroller">
			<div class="btn-group h-menu text-nowrap" role="group">
				<%- include('tafsirCarouselLanguageSwitch') %>
				<%- include('bookCarouselFilter') %>
				<% orderedTafsirs.forEach(function (tafsir) { %>
					<a class="btn btn-outline-primary text-nowrap" href="<%= tafsirBookHref(tafsir) %>" data-book-carousel-item data-book-carousel-search="<%= [tafsir.name_en, tafsir.shortName_en, tafsir.title, tafsir.shortName, tafsir.author_en, tafsir.author, tafsir.alias].filter(Boolean).join(' ') %>" data-tafsir-book-nav-item data-tafsir-alias="<%= tafsir.alias %>" data-tafsir-lang="<%= tafsir.lang %>" data-tafsir-carousel-language="<%= Tafsir.carouselLanguage(tafsir) %>" data-tafsir-death="<%= tafsir.death || '' %>" data-tafsir-ordinal="<%= tafsir.ordinal || 0 %>"><%- tafsirBookLabel(tafsir) %><%- tafsirSizeIndicator(tafsir) %></a>
				<% }); %>
			</div>
		</div>
	</div>
<% } %>
