<details class="hadith-picker-filters mt-2" dir="ltr">
  <summary class="small">Filters</summary>
  <div class="d-flex flex-wrap gap-2 mt-2">
    <div class="small flex-grow-1 hadith-picker-books">
      <label class="d-block">Collections
        <input type="search" class="form-control form-control-sm" data-hadith-picker-book-search aria-label="Search hadith books" placeholder="Type to add books…" autocomplete="off" dir="auto">
      </label>
      <select multiple hidden data-hadith-picker-book aria-label="Selected hadith books">
        <% (global.books || []).filter(b => b.alias !== 'quran' && b.type === 'hadith' && Number(b.hidden) !== 1).forEach(function (b) { %>
          <option value="<%= b.alias %>" data-search-name="<%= [b.alias, b.shortName_en, b.title_en, b.shortName, b.title].filter(Boolean).join(' ') %>"><%= b.shortName_en || b.title_en || b.alias %></option>
        <% }); %>
      </select>
      <div class="d-flex flex-wrap gap-1 mt-1" data-hadith-picker-book-chips aria-live="polite"></div>
      <span class="text-muted" data-hadith-picker-all-books>All collections</span>
    </div>
    <label class="small flex-grow-1">Grade
      <select class="form-select form-select-sm" data-hadith-picker-grade>
        <option value="">All grades</option>
        <% (global.grades || []).forEach(function (g) { %><option value="<%= g.id %>"><%= g.grade_en || g.grade || g.id %></option><% }); %>
      </select>
    </label>
    <button type="button" class="btn btn-sm btn-outline-secondary align-self-end" data-hadith-picker-clear>Clear filters</button>
  </div>
</details>
