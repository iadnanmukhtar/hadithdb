  <nav id="<%= shelfId %>" class="library-volumes" aria-label="<%= shelfLabel %>">
    <% for (const book of shelfBooks) {
      const arabicTitle = book.name;
    %>
      <a class="library-volume" href="<%= bookHref(book) %>" data-alias="<%= book.alias %>" data-search="<%= [book.alias, book.name_en, book.shortName_en, book.name, book.title, book.shortName, book.authorShortName_en, book.authorShortName, book.author_en, book.author].filter(Boolean).join(' ') %>">
        <span class="volume-content">
          <span class="volume-face" aria-hidden="true"><i class="bi <%= bookIcon(book) %>"></i></span>
          <span class="volume-name"><%= book.name_en || book.alias %><%- hadithSizeIndicator(book) %></span>
          <% if (arabicTitle) { %><span class="volume-arabic" lang="ar" dir="rtl"><%= arabicTitle %></span><% } %>
          <span class="volume-author"><%= book.authorShortName_en || book.authorShortName || '' %></span>
        </span>
      </a>
    <% } %>
  </nav>
  <% if (!locals.directoryOnly) { %>
  <div class="library-deck-controls" hidden>
    <button type="button" aria-label="Previous book" aria-controls="<%= shelfId %>"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
    <span role="status" aria-atomic="true"></span>
    <button type="button" aria-label="Next book" aria-controls="<%= shelfId %>"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
  </div>
  <% } %>
