<div class="tafsir-book-list" data-book-catalog-type="Mushaf">
  <% mushafs.forEach(function (book) { %>
    <article class="book-catalog-card tafsir-book-row" data-book-catalog-size="<%= book.size || '' %>" data-book-author-short-en="<%= book.authorShortName_en || '' %>" data-book-author-short-ar="<%= book.authorShortName || '' %>" data-book-death="<%= book.death || '' %>" data-book-catalog-filter="<%= [book.alias, book.name_en, book.name, 'quran mushaf virtual'].join(' ').toLowerCase() %>">
      <div class="tafsir-book-row-main">
        <div class="tafsir-book-title-pair">
          <h3 class="tafsir-book-title-line mb-0"><a href="<%= utils.quranUrl(req, book.href) %>"><%= book.name_en %></a> <span class="badge rounded-pill text-bg-light border book-language-badge">AR</span></h3>
          <h3 class="tafsir-book-title-line mb-0" lang="ar" dir="rtl"><a href="<%= utils.quranUrl(req, book.href) %>"><%= book.name %></a></h3>
        </div>
        <div class="tafsir-book-meta text-muted">Virtual book · Quran</div>
      </div>
    </article>
  <% }); %>
</div>
