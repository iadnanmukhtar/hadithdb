<aside class="hadith-heading-toc toc-heading-rail tafsir-group-rail d-none d-lg-block" data-toc-heading-rail aria-label="Books by group">
  <div class="hadith-heading-toc-sticky">
    <nav class="hadith-heading-toc-nav" data-toc-heading-rail-nav <% if (locals.showCatalogFilters) { %>aria-labelledby="books-rail-title"<% } else { %>aria-label="Book collections"<% } %>>
      <% if (locals.showCatalogFilters) { %>
        <%- include('rail_title.ejs', { titleId: 'books-rail-title', title: 'Book groups' }) %>
        <%- include('book_catalog_filters.ejs') %>
      <% } %>
      <% railCollections.forEach(function (collection) { %>
      <div<% if (collection.pane) { %> data-book-rail-pane="<%= collection.pane %>"<% if (collection.pane !== 'book-catalog-' + initialBookCatalogType) { %> hidden<% } %><% } %>>
        <% if (locals.tocRail) { %><%- include('toc_rail_header.ejs', { titleId: 'book-rail-title', title: railTitle, href: railHomeHref, linkLabel: 'Browse collection' }) %><% } else if (!locals.showCatalogFilters) { %><a class="heading-toc-book-name" href="<%= railHomeHref %>"><%= railTitle %></a><% } %>
        <%- include('book_group_links.ejs', collection); %>
      </div>
      <% }); %>
    </nav>
  </div>
</aside>
