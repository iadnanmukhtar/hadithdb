<%
    var tafsirDeathLabel = function (tafsir) {
      var death = utils.emptyIfNull(tafsir.death || '').toString().trim();
      if (!death)
        return '';
      if (!/\b(?:AH|H)\b/i.test(death) && !/هـ/u.test(death))
        death = `${death} AH`;
      return /^d\./i.test(death) ? death : `d. ${death}`;
    };
    var tafsirArabicDeathLabel = function (tafsir) {
      var death = utils.emptyIfNull(tafsir.death || '').toString().trim();
      if (!death)
        return '';
      death = death.replace(/\b(?:AH|H)\b/ig, '').replace(/هـ/u, '').trim();
      return `ت. ${death} هـ`;
    };
    var commentaryPublicationLabel = function (book) {
      return [
        book && book.published_year ? `Pub. ${book.published_year}` : '',
        book && book.publisher ? book.publisher : ''
      ].filter(Boolean).join(', ');
    };
    var htmlToPlainText = function (value) {
      return utils.emptyIfNull(value || '')
        .toString()
        .replace(/<[^>]*>/g, ' ')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/[*_`#>]+/g, '')
        .replace(/\s+/g, ' ')
        .trim();
    };
    var tafsirDescriptionPreview = function (description) {
      return htmlToPlainText(description.split(/\r?\n/).map(function (line) {
        return line.trim();
      }).find(Boolean) || description);
    };
    var tafsirDescriptionId = function (tafsir) {
      return `sharh-book-description-${utils.emptyIfNull(tafsir.alias || '').replace(/[^A-Za-z0-9_-]+/g, '-')}`;
    };
    var tafsirBookUrl = book => `/sharh/${encodeURIComponent(book.alias)}`;
    var tafsirLanguages = book => String(book.lang || 'ar').split(/[-_,\s]+/).filter(language => ['en', 'ar'].includes(language));
    var tafsirLanguageBadge = book => tafsirLanguages(book).includes('en') ? (tafsirLanguages(book).includes('ar') ? 'EN-AR' : 'EN') : 'AR';
    var catalogTafsirs = (sharhBooks || []).slice().sort(function(a, b) {
      var year = book => Number((String(book.death || '').match(/\d+/) || [])[0]) || Infinity;
      return year(a) - year(b) || (a.name_en || a.alias).localeCompare(b.name_en || b.alias);
    });
%>
<% if (!catalogTafsirs.length) { %><p class="text-muted">No sharḥ books are currently available.</p><% } %>
        <div class="tafsir-book-list" data-book-catalog-type="Sharḥ">
                <% catalogTafsirs.forEach(function (tafsir) { %>
                  <%
                    var descriptionMarkdown = utils.emptyIfNull(tafsir.description || '');
                    var descriptionHtml = utils.markdownToHtml(descriptionMarkdown);
                    var descriptionPreview = tafsirDescriptionPreview(descriptionMarkdown);
                    var descriptionId = tafsirDescriptionId(tafsir);
                    var descriptionKey = `${descriptionId}-body`;
                    var browseUrl = tafsirBookUrl(tafsir);
                    var editableBookId = tafsir.id || '';
                    
                  %>
                  <article class="tafsir-book-card book-catalog-card tafsir-book-row" data-book-catalog-size="<%= tafsir.size || '' %>" data-book-author-short-en="<%= tafsir.authorShortName_en || '' %>" data-book-author-short-ar="<%= tafsir.authorShortName || '' %>" data-book-death="<%= tafsir.death || '' %>" data-tafsir-language="<%= tafsirLanguages(tafsir).join(' ') %>" data-book-catalog-language="<%= tafsirLanguages(tafsir).join(' ') %>" data-tafsir-book-filter="<%= [tafsir.alias, tafsir.name_en, tafsir.shortName_en, tafsir.name, tafsir.title_en, tafsir.title, tafsir.shortName, tafsir.authorShortName_en, tafsir.authorShortName, tafsir.author_en, tafsir.author, tafsir.publisher, tafsir.description].filter(Boolean).join(' ') %>" data-book-catalog-filter="<%= [tafsir.alias, tafsir.name_en, tafsir.shortName_en, tafsir.name, tafsir.title_en, tafsir.title, tafsir.shortName, tafsir.authorShortName_en, tafsir.authorShortName, tafsir.author_en, tafsir.author, tafsir.publisher, tafsir.description].filter(Boolean).join(' ') %>">
                    <div class="tafsir-book-row-main">
                      <div class="tafsir-book-title-pair">
                        <h3 class="tafsir-book-title-line mb-0">
                          <% if (site.editMode) { %>
                            <a href="<%= browseUrl %>"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.name_en" data-placeholder="English name"><%- tafsir.name_en || '' %></span></a>
                          <% } else { %>
                            <a href="<%= browseUrl %>"><%= tafsir.shortName_en || tafsir.name_en || tafsir.alias %></a>
                          <% } %> <span class="badge rounded-pill text-bg-light border book-language-badge"><%= tafsirLanguageBadge(tafsir) %></span>
                        </h3>
                        <% if (site.editMode || tafsir.name || tafsir.shortName) { %>
                          <h3 class="tafsir-book-title-line mb-0" lang="ar" dir="rtl">
                            <% if (site.editMode) { %>
                              <a href="<%= browseUrl %>"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.name" data-placeholder="الاسم العربي"><%- tafsir.name || '' %></span></a>
                            <% } else { %>
                              <a href="<%= browseUrl %>"><%- tafsir.shortName || tafsir.name || '' %></a>
                            <% } %>
                          </h3>
                        <% } %>
                      </div>
                      <% if (site.editMode) { %>
                        <div class="tafsir-book-full-name text-muted">
                          <div><span class="_e" data-id="<%= editableBookId %>" data-prop="book.shortName_en" data-placeholder="English short name"><%- tafsir.shortName_en || '' %></span></div>
                          <div lang="ar" dir="rtl"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.shortName" data-placeholder="الاسم المختصر"><%- tafsir.shortName || '' %></span></div>
                          <div><span class="_e" data-id="<%= editableBookId %>" data-prop="book.title_en" data-placeholder="Full English title"><%- tafsir.title_en || '' %></span></div>
                          <div lang="ar" dir="rtl"><span class="_e" data-id="<%= editableBookId %>" data-prop="book.title" data-placeholder="العنوان الكامل"><%- tafsir.title || '' %></span></div>
                        </div>
                      <% } else if (tafsir.title_en || tafsir.title) { %>
                        <div class="tafsir-book-full-name text-muted">
                          <% if (tafsir.title_en) { %><div><%- tafsir.title_en %></div><% } %>
                          <% if (site.editMode || tafsir.title) { %>
                            <div lang="ar" dir="rtl"><%- tafsir.title %></div>
                          <% } %>
                        </div>
                      <% } %>
                      <div class="tafsir-book-meta text-muted">
                        <% if (site.editMode || tafsir.author_en || tafsirDeathLabel(tafsir)) { %>
                          <div>
                            <span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="book.author_en"<% } %>><%- tafsir.author_en || tafsir.author || '' %></span>
                            <% if (site.editMode || tafsirDeathLabel(tafsir)) { %>
                              <% if (site.editMode) { %><span>(d. <span class="_e" data-id="<%= editableBookId %>" data-prop="book.death" data-placeholder="Death year"><%- tafsir.death || '' %></span> AH)</span><% } else { %><span>(<%- tafsirDeathLabel(tafsir) %>)</span><% } %>
                            <% } %>
                          </div>
                        <% } %>
                        <% if (site.editMode || tafsir.author || tafsirArabicDeathLabel(tafsir)) { %>
                          <div lang="ar" dir="rtl">
                            <span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="book.author"<% } %>><%- tafsir.author || tafsir.author_en || '' %></span>
                            <% if (tafsirArabicDeathLabel(tafsir)) { %>
                              <span>(<%- tafsirArabicDeathLabel(tafsir) %>)</span>
                            <% } %>
                          </div>
                        <% } %>
                        <% if (site.editMode || tafsir.aqidah) { %>
                          <div><span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="book.aqidah" data-placeholder="Aqidah"<% } %>><%- tafsir.aqidah || '' %></span></div>
                        <% } %>
                      </div>
                      <% if (site.editMode) { %>
                        <div id="<%= descriptionId %>" class="toc-book-description-full tafsir-book-description-full">
                          <div class="_e tafsir-book-description-editor" data-id="<%= editableBookId %>" data-prop="book.description" data-edit-format="md" data-markdown-source="<%= descriptionMarkdown %>" data-markdown-empty-html="&hellip;"><%- descriptionHtml || '&hellip;' %></div>
                        </div>
                      <% } else if (descriptionPreview || descriptionHtml) { %>
                        <button type="button" class="toc-book-description-summary tafsir-book-description-summary text-muted text-start" data-toc-description-summary="<%= descriptionKey %>" data-toc-description-expand="<%= descriptionKey %>" aria-expanded="false" aria-controls="<%= descriptionId %>">
                          <span class="toc-book-description-preview"><%= descriptionPreview %></span>
                          <span class="tafsir-book-description-more">More...</span>
                        </button>
                        <div id="<%= descriptionId %>" class="toc-book-description-full tafsir-book-description-full d-none" data-toc-description-full="<%= descriptionKey %>">
                          <%- descriptionHtml %>
                        </div>
                      <% } %>
                      <% if (site.editMode || commentaryPublicationLabel(tafsir)) { %>
                        <small class="tafsir-book-publication text-muted">
                          <% if (site.editMode) { %>
                            Pub. <span class="_e" data-id="<%= editableBookId %>" data-prop="book.published_year"><%- tafsir.published_year || '' %></span>, <span class="_e" data-id="<%= editableBookId %>" data-prop="book.publisher"><%- tafsir.publisher || '' %></span>
                          <% } else { %>
                            <%- commentaryPublicationLabel(tafsir) %>
                          <% } %>
                        </small>
                      <% } %>
                    </div>
                  </article>
                <% }); %>
        </div>
