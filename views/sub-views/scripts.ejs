<% if (site.editMode) { %>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<!-- Inline Editing -->
<script>
  $(function () {

	    toastr.options.closeMethod = 'fadeOut';
	    toastr.options.closeDuration = 300;
	    toastr.options.closeEasing = 'swing';

	    const renderMarkdown = (text) => {
	      if (!text) return '';
	      if (window.marked && window.marked.parse)
	        return window.marked.parse(text);
	      return text;
	    };

	    const isMarkdownProp = (prop) => /body|intro|footnote|note/.test(prop) || prop === 'book.description';

	    const htmlNodeToMarkdown = (node) => {
	      if (!node) return '';
	      if (node.nodeType === Node.TEXT_NODE)
	        return node.nodeValue;
	      if (node.nodeType !== Node.ELEMENT_NODE)
	        return '';
	      const tag = node.tagName.toLowerCase();
	      const children = Array.from(node.childNodes).map(htmlNodeToMarkdown).join('');
	      switch (tag) {
	        case 'br':
	          return '\n';
	        case 'p':
	        case 'div':
	          return `${children}\n\n`;
	        case 'strong':
	        case 'b':
	          return children ? `**${children}**` : '';
	        case 'em':
	        case 'i':
	          return children ? `*${children}*` : '';
	        case 'u':
	          return children ? `__${children}__` : '';
	        case 'a': {
	          const href = node.getAttribute('href') || '';
	          return href ? `[${children || href}](${href})` : children;
	        }
	        case 'ul':
	          return Array.from(node.children).map(li => `- ${htmlNodeToMarkdown(li).trim()}`).join('\n') + '\n\n';
	        case 'ol':
	          return Array.from(node.children).map((li, idx) => `${idx + 1}. ${htmlNodeToMarkdown(li).trim()}`).join('\n') + '\n\n';
	        case 'li':
	          return children;
	        case 'blockquote':
	          return children.split(/\n/).map(line => line ? `> ${line}` : '>').join('\n') + '\n\n';
	        default:
	          return children;
	      }
	    };

	    const htmlToMarkdown = (html) => {
	      if (!html) return '';
	      const parser = new DOMParser();
	      const doc = parser.parseFromString(html, 'text/html');
	      return Array.from(doc.body.childNodes).map(htmlNodeToMarkdown).join('').replace(/\n{3,}/g, '\n\n').trim();
	    };

	    const setElementValue = (el, value) => {
	      const $el = $(el);
	      const prop = ($el.data('prop') || '').toString();
	      const isMarkdownField = isMarkdownProp(prop);

	      if ($el.is('textarea') || $el.is('input')) {
	        $el.val(value);
	      } else if ($el.is('select')) {
	        $el.val(value);
	      } else if (isMarkdownField) {
	        $el.html(renderMarkdown(value));
	      } else {
	        $el.text(value);
	      }
	    };

	    const applyHadithRevision = (id, revised) => {
	      if (!id || !revised)
	        return;
	      const fieldMap = {
	        title_en: 'hadith.title_en',
	        chain: 'hadith.chain',
	        body: 'hadith.body',
	        chain_en: 'hadith.chain_en',
	        body_en: 'hadith.body_en'
	      };
	      Object.entries(fieldMap).forEach(([key, prop]) => {
	        if (typeof revised[key] !== 'string')
	          return;
	        $(`[data-id="${id}"][data-prop="${prop}"]`).each(function () {
	          setElementValue(this, revised[key]);
	        });
	      });
	    };

	    async function changeListener(e) {
	      if (e && typeof e.preventDefault === 'function')
	        e.preventDefault();
	      if ($(this).attr('submitting') == 'true') {
	        e.stopPropagation();
	        return;
	      }
	      if ($(this).attr('editing') == 'true' || $(this).attr('clickable') == 'true') {
	        $(this).attr('submitting', 'true');
	        var id = $(this).data('id');
	        var prop = $(this).data('prop');
	        var arabizi = $(this).data('arabizi');
	        const propStr = prop ? prop.toString() : '';
	        const isMarkdownField = isMarkdownProp(propStr);
	        var value = '';
	        if ($(this).attr('type') == 'checkbox')
	          value = $(this).prop('checked') ? "1" : "0";
	        else if ($(this).is('textarea') || $(this).is('select') || $(this).is('input'))
	          value = $(this).val();
	        else if (isMarkdownField)
	          value = htmlToMarkdown($(this).html());
	        else
	          value = $(this).text();
	        value = (value || '').toString().replace(/&nbsp;/g, ' ').trim();
	        var reqBody = {
	          id: id,
	          prop: prop,
	          arabizi: arabizi,
	          value: value,
        };
        try {
          var resBody = await update(reqBody);
          // update element on success
	          if (resBody.code == 200) {
            value = resBody.value;
	            if (propStr === 'hadith.revise')
	              applyHadithRevision(id, resBody.revised);
	            if ($(this).data('reset') == 'true')
	              value = '';
	            if (!$(this).is('select') && value !== undefined && value !== null)
	              setElementValue(this, value);
	          }
        } finally {
          $(this).removeAttr('submitting');
        }
	      };
	      e.stopPropagation();
	    }

    async function update(reqBody) {
      var resBody = {};
      var res = {
        status: 500,
        statusText: 'Unable to execute update due to an unknown error'
      };
      if (reqBody) {
        res = await fetch(`/update/${reqBody.id}/${reqBody.prop}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: reqBody.id,
            prop: reqBody.prop,
            arabizi: reqBody.arabizi,
            value: reqBody.value,
          })
        });
        resBody = JSON.parse(await res.text());
      } else {
        res.statusText = 'Update request body is not present';
      }
      if (res.status == 200) {
        const successMessage = `Successful update for ${reqBody.id}/${reqBody.prop}`;
        console.log(successMessage);
        toastr.success(`${res.status} ${res.statusText}`, successMessage);
      } else {
        var errMessage = `${res.status} ${res.statusText} ${resBody.message}`;
        console.error(`Update Error\n${errMessage}`);
        toastr.error(errMessage, `Error on update for ${reqBody.id}/${reqBody.prop}`);
      }
      return resBody;
    }

    function split(val) {
      return val.split(/ +/);
    }
    function extractLast(term) {
      return split(term).pop();
    }

    $('._e*').each(function () {
      $(this).attr('contenteditable', 'true');
      $(this).on('input', function () {
        $(this).attr('editing', 'true');
        $(this).removeClass('partial');
      });
      $(this).on('blur', changeListener);
    });

    $('._click').each(function () {
      if (!$(this).attr('href'))
        $(this).attr('href', '#');
      $(this).attr('clickable', 'true');
      $(this).on('click', changeListener);
    });

    $(".tags ._e")
      // don't navigate away from the field on tab when selecting an item
      .on( "keydown", function( event ) {
        if ( event.keyCode === $.ui.keyCode.TAB &&
            $( this ).autocomplete( "instance" ).menu.active ) {
          event.preventDefault();
        }
      })
      .autocomplete({
        source: function( request, response ) {
          $.getJSON('/tag/_list', {
            s: extractLast( request.term )
          }, response );
        },
        search: function() {
          var term = extractLast( $(this).val() );
          if ( term.length < 2 )
            return false;
        },
        focus: function() {
          return false;
        },
        select: function( event, ui ) {
          var terms = split($(this).val());
          terms.pop();
          terms.push(ui.item.value);
          terms.push('');
          $(this).val(terms.join(' '));
          $(this).focus().end();
          return false;
        }
      });
  });
</script> 
<% } %> 

<!-- Social Login -->
<script type="text/javascript">
  async function onAuth(user) {
      var res = {
        status: 403,
        statusText: 'Unable to login'
      };
      res = await fetch(`/login/${user.username}`, {
        method: 'GET'
      });
      var resBody = JSON.parse(await res.text());
      if (res.status == 200) {
        toastr.success('Logged in as ' + user.username);
        window.location.reload();
      } else {
        var errMessage = `${res.status} ${res.statusText} ${resBody.message}`;
        toastr.error(errMessage, `Update Error`);
      }
      return resBody;
  }
</script>

