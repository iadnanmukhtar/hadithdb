<!-- Social Login -->
<script type="text/javascript">
  function getHadithCookie(name) {
      const match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/[.$?*|{}()[\]\\/+^]/g, '\\$&') + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : '';
  }

  function setHadithCookie(name, value, maxAge) {
      const domain = window.HADITH_COOKIE_DOMAIN ? `;domain=${window.HADITH_COOKIE_DOMAIN}` : '';
      const age = Number.isFinite(maxAge) ? `;max-age=${maxAge}` : '';
      document.cookie = `${name}=${encodeURIComponent(value)};path=/${age};samesite=lax${domain}`;
  }

  function randomHadithToken(length = 32) {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
      if (window.crypto && window.crypto.getRandomValues) {
        const values = new Uint8Array(length);
        window.crypto.getRandomValues(values);
        return Array.from(values, value => chars[value % chars.length]).join('');
      }
      let token = '';
      for (let i = 0; i < length; i++)
        token += chars.charAt(Math.floor(Math.random() * chars.length));
      return token;
  }

  function ensureHadithGoogleCsrfToken() {
      const existing = getHadithCookie('g_csrf_token');
      if (existing) return existing;
      const token = randomHadithToken(32);
      setHadithCookie('g_csrf_token', token, 60 * 60);
      return token;
  }

  window.HADITH_SESSION_MAX_AGE = window.HADITH_SESSION_MAX_AGE || 60 * 60 * 24 * 90;
  window.hadithAdmin = <%= site.admin ? 'true' : 'false' %>;
  window.hadithAdminSessionChecked = window.hadithAdmin === true;

  function markHadithAuthSynced(username) {
      if (!username) return;
      sessionStorage.setItem('hadithdb_google_login', '1');
      sessionStorage.setItem(`hadithdb_auth_synced:${username}`, '1');
  }

  function setHadithAdminMode(enabled) {
      const domain = window.HADITH_COOKIE_DOMAIN ? `;domain=${window.HADITH_COOKIE_DOMAIN}` : '';
      document.cookie = `editMode=${enabled ? '1' : '0'};path=/;max-age=${window.HADITH_SESSION_MAX_AGE};samesite=lax${domain}`;
      location.reload();
  }

  function renderHadithAdminGear() {
      if (window.hadithAdmin !== true) {
        if (window.hadithAdminSessionChecked) {
          document.querySelectorAll('.edit-gear').forEach((el) => el.remove());
          const domain = window.HADITH_COOKIE_DOMAIN ? `;domain=${window.HADITH_COOKIE_DOMAIN}` : '';
          document.cookie = `editMode=0;path=/${domain}`;
        }
        return;
      }
      const editMode = Boolean(document.cookie.match(/(?:^|; )editMode=1(?:;|$)/));
      const icon = editMode ? 'bi-gear-fill' : 'bi-gear';
      const desktopList = document.querySelector('.site-navbar menu.d-md-block ul.nav');
      if (desktopList && !desktopList.querySelector('.edit-gear')) {
        const searchItem = desktopList.querySelector('.search-click-toggle');
        const item = document.createElement('li');
        item.className = 'nav-item edit-gear';
        item.innerHTML = `<a class="nav-link" role="button" title="${editMode ? 'Turn off admin mode' : 'Turn on admin mode'}" aria-label="${editMode ? 'Turn off admin mode' : 'Turn on admin mode'}"><i class="bi ${icon}"></i></a>`;
        item.querySelector('a').addEventListener('click', () => setHadithAdminMode(!editMode));
        desktopList.insertBefore(item, searchItem || null);
      }

      const mobileList = document.querySelector('#offcanvas-topnav .offcanvas-col1');
      if (mobileList && !mobileList.querySelector('.edit-gear')) {
        const item = document.createElement('li');
        item.className = 'nav-item edit-gear';
        item.innerHTML = `<a class="nav-link" role="button"><i class="bi ${icon}"></i> <strong>${editMode ? 'View' : 'Edit'}</strong></a>`;
        item.querySelector('a').addEventListener('click', () => setHadithAdminMode(!editMode));
        const separator = document.createElement('li');
        separator.className = 'edit-gear';
        separator.innerHTML = '<hr>';
        mobileList.appendChild(separator);
        mobileList.appendChild(item);
      }
  }

  function hadithLoginPath() {
      if (window.location.hostname.toLowerCase().split('.')[0] === 'quran')
        return '/quran/login/google';
      return '/login/google';
  }

  function hadithLogoutPath() {
      if (window.location.hostname.toLowerCase().split('.')[0] === 'quran')
        return '/quran/login/logout';
      return '/login/logout';
  }

  function hadithSessionPath() {
      if (window.location.hostname.toLowerCase().split('.')[0] === 'quran')
        return '/quran/login/session';
      return '/login/session';
  }

  function hadithApiPath(path) {
      path = String(path || '');
      if (path.charAt(0) !== '/')
        path = `/${path}`;
      const isQuranHost = window.location.hostname.toLowerCase().split('.')[0] === 'quran';
      if (isQuranHost && path !== '/quran' && !path.startsWith('/quran/'))
        return `/quran${path}`;
      return path;
  }

  function needsHadithAuthSync(user) {
      if (!user)
        return false;
      const uid = user.uid || user.userId || user.email || user.username;
      if (uid && getHadithCookie('userId') !== uid)
        return true;
      return window.hadithAdmin !== true && !document.querySelector('.edit-gear');
  }

  async function syncHadithSessionFromCookie() {
    const now = Date.now();
    if (window.hadithSessionSyncPromise)
      return window.hadithSessionSyncPromise;
    if (window.hadithSessionSyncResult && now - (window.hadithSessionSyncAt || 0) < 5000)
      return window.hadithSessionSyncResult;
    window.hadithSessionSyncPromise = (async () => {
      try {
        const res = await fetch(hadithSessionPath(), {
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' }
        });
        if (!res.ok)
          return null;
        const data = await res.json();
        window.hadithSessionSyncResult = data;
        window.hadithSessionSyncAt = Date.now();
        window.hadithAdmin = Boolean(data && data.loggedIn && data.admin);
        window.hadithAdminSessionChecked = true;
        renderHadithAdminGear();
        return data;
      } catch (err) {
        window.hadithAdminSessionChecked = true;
        renderHadithAdminGear();
        return null;
      } finally {
        window.hadithSessionSyncPromise = null;
      }
    })();
    return window.hadithSessionSyncPromise;
  }

  async function onAuth(user, options = {}) {
      const username = user && user.username;
      if (!username)
        return { status: 400, message: 'Missing username' };

      const initialUserId = getHadithCookie('userId');
      const currentUser = window.hadithAuth && window.hadithAuth.getUser ? await window.hadithAuth.getUser() : null;
      const currentUid = currentUser && currentUser.uid ? currentUser.uid : username;

      if (initialUserId === currentUid) {
        const session = await syncHadithSessionFromCookie();
        if (session && session.loggedIn) {
          markHadithAuthSynced(username);
          return { ...session, skipped: true, message: 'User already logged in' };
        }
      }

      if (window.hadithAuthLoginInFlight)
        return window.hadithAuthLoginInFlight;

      window.hadithAuthLoginInFlight = (async () => {
        var res = {
          status: 403,
          statusText: 'Unable to login'
        };
        const token = window.hadithAuth && window.hadithAuth.getToken ? await window.hadithAuth.getToken() : null;
        if (!token) {
          const session = await syncHadithSessionFromCookie();
          if (session && session.loggedIn) {
            markHadithAuthSynced(username);
            return session;
          }
          if (!options.silent)
            toastr.error('Please sign in with Google first.', 'Auth');
          return { status: 401, message: 'Authentication required' };
        }
        const csrfToken = ensureHadithGoogleCsrfToken();
        res = await fetch(hadithLoginPath(), {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            credential: token,
            g_csrf_token: csrfToken
          })
        });
        var resBody = JSON.parse(await res.text());
        if (res.status == 200) {
          markHadithAuthSynced(username);
          window.hadithAdmin = Boolean(resBody.admin);
          renderHadithAdminGear();
          if (!options.silent)
            toastr.success('Logged in as ' + username);
          const userChanged = initialUserId !== (resBody.userId || currentUid);
          if (options.reload !== false && !options.silent && (userChanged || resBody.admin))
            window.location.reload();
        } else {
          var errMessage = `${res.status} ${res.statusText} ${resBody.message}`;
          toastr.error(errMessage, `Update Error`);
        }
        return resBody;
      })();

      try {
        return await window.hadithAuthLoginInFlight;
      } finally {
        window.hadithAuthLoginInFlight = null;
      }
  }

  window.hadithAdmin = window.hadithAdmin === true;
  renderHadithAdminGear();
  syncHadithSessionFromCookie();
</script>

