<!-- Google Auth (shared across pages) -->
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script>
  (function initGoogleAuthGlobal() {
    if (window.hadithAuth) return;
    const googleClientId = '<%= (global.settings.firebase && (global.settings.firebase.googleClientId || global.settings.firebase.clientId || global.settings.firebase.client_id)) || (global.settings.google && (global.settings.google.clientId || global.settings.google.client_id)) || "" %>';
    const tokenKey = 'hadithdb_google_credential';
    const userKey = 'hadithdb_google_user';
    let sessionUserPromise = null;
    const decodeJwt = (token) => {
      try {
        const payload = token.split('.')[1];
        const normalized = payload.replace(/-/g, '+').replace(/_/g, '/');
        const json = decodeURIComponent(atob(normalized).split('').map((c) => `%${(`00${c.charCodeAt(0).toString(16)}`).slice(-2)}`).join(''));
        return JSON.parse(json);
      } catch (err) {
        return null;
      }
    };
    const userFromCredential = (credential) => {
      const payload = decodeJwt(credential);
      if (!payload || !payload.sub) return null;
      return {
        uid: payload.sub,
        email: payload.email || null,
        displayName: payload.name || payload.email || 'User',
        photoURL: payload.picture || 'https://www.gravatar.com/avatar/?d=mp&s=48',
        providerData: [{ providerId: 'google.com' }],
        getIdToken: async () => credential,
        tokenExp: payload.exp || 0
      };
    };
    const storedUser = () => {
      const credential = localStorage.getItem(tokenKey);
      if (!credential) return null;
      const user = userFromCredential(credential);
      if (!user || (user.tokenExp && user.tokenExp * 1000 <= Date.now())) {
        localStorage.removeItem(tokenKey);
        localStorage.removeItem(userKey);
        return null;
      }
      return user;
    };
    const userFromSession = async () => {
      if (!sessionUserPromise) {
        sessionUserPromise = syncHadithSessionFromCookie().then((session) => {
          if (!session || !session.loggedIn || !session.user) return null;
          const user = session.user;
          return {
            uid: user.uid,
            email: user.email || user.uid,
            displayName: user.name || user.email || 'User',
            photoURL: user.photo || 'https://www.gravatar.com/avatar/?d=mp&s=48',
            providerData: [{ providerId: user.provider || 'google.com' }],
            getIdToken: async () => {
              const credentialUser = storedUser();
              return credentialUser ? localStorage.getItem(tokenKey) : null;
            },
            sessionBacked: true
          };
        }).finally(() => {
          setTimeout(() => { sessionUserPromise = null; }, 1000);
        });
      }
      return sessionUserPromise;
    };
    const setCredential = (credential) => {
      const user = userFromCredential(credential);
      if (!user) return null;
      localStorage.setItem(tokenKey, credential);
      localStorage.setItem(userKey, JSON.stringify({
        uid: user.uid,
        email: user.email,
        displayName: user.displayName,
        photoURL: user.photoURL,
        provider: 'google.com',
        tokenExp: user.tokenExp
      }));
      document.dispatchEvent(new CustomEvent('hadithAuthChanged', { detail: { user } }));
      return user;
    };
    const clearCredential = () => {
      localStorage.removeItem(tokenKey);
      localStorage.removeItem(userKey);
      sessionUserPromise = null;
      document.dispatchEvent(new CustomEvent('hadithAuthChanged', { detail: { user: null } }));
    };
    window.hadithAuth = {
      getToken: async () => {
        const user = storedUser();
        return user ? localStorage.getItem(tokenKey) : null;
      },
      requireLogin: () => {
        toastr.error('Please sign in to like or comment.', 'Sign-in required');
        window.hadithAuth.prompt();
      },
      getUser: async () => storedUser() || await userFromSession(),
      setCredential,
      clearCredential,
      prompt: (momentCallback) => {
        if (!window.google?.accounts?.id) return false;
        window.google.accounts.id.prompt((notification) => {
          document.dispatchEvent(new CustomEvent('hadithGooglePromptMoment', { detail: { notification } }));
          if (typeof momentCallback === 'function') momentCallback(notification);
        });
        return true;
      },
      googleClientId
    };
  })();
</script>

<!-- Nav Google Auth UI -->
<script>
  (function initNavAuth() {
    if (window.navAuthInit) return;
    const desktopSlot = document.getElementById('nav-auth-desktop');
    const mobileSlot = document.getElementById('nav-auth-mobile');
    if (!desktopSlot && !mobileSlot) return;
    window.navAuthInit = true;
    let oneTapStarted = false;
    let googleInitialized = false;
    let googleIdApi = null;

    const render = (user) => {
      const avatar = user && (user.photoURL || 'https://www.gravatar.com/avatar/?d=mp&s=48');
      const name = user && (user.displayName || user.email || 'User');
      const profileHtml = `
        <div class="dropdown">
          <button class="btn btn-link p-0 border-0 dropdown-toggle d-flex align-items-center nav-auth-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="${avatar}" alt="${name}" class="rounded-circle" width="32" height="32">
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/settings">My Settings</a></li>
            <li><button type="button" class="dropdown-item nav-signout">Sign out</button></li>
          </ul>
        </div>
      `;
      const loginHtml = `<div class="nav-google-signin"></div>`;
      if (desktopSlot) desktopSlot.innerHTML = user ? profileHtml : loginHtml;
      if (mobileSlot) mobileSlot.innerHTML = user ? profileHtml : loginHtml;
      attachHandlers();
      if (!user) renderGoogleButtons();
    };

    const attachHandlers = () => {
      const signoutBtns = document.querySelectorAll('.nav-signout');
      signoutBtns.forEach(btn => btn.onclick = signOut);
    };

    const waitForGoogleIdentity = () => new Promise(resolve => {
      if (window.google?.accounts?.id) return resolve(window.google.accounts.id);
      let attempts = 0;
      const timer = setInterval(() => {
        attempts += 1;
        if (window.google?.accounts?.id) {
          clearInterval(timer);
          resolve(window.google.accounts.id);
        } else if (attempts >= 40) {
          clearInterval(timer);
          resolve(null);
        }
      }, 100);
    });

    const promptMomentValue = (notification, methodName) => {
      try {
        return notification && typeof notification[methodName] === 'function'
          ? notification[methodName]()
          : null;
      } catch (err) {
        return null;
      }
    };

    const recordOneTapMoment = (notification) => {
      const status = {
        displayed: !!promptMomentValue(notification, 'isDisplayed'),
        notDisplayed: !!promptMomentValue(notification, 'isNotDisplayed'),
        skipped: !!promptMomentValue(notification, 'isSkippedMoment'),
        dismissed: !!promptMomentValue(notification, 'isDismissedMoment'),
        momentType: promptMomentValue(notification, 'getMomentType'),
        notDisplayedReason: promptMomentValue(notification, 'getNotDisplayedReason'),
        skippedReason: promptMomentValue(notification, 'getSkippedReason'),
        dismissedReason: promptMomentValue(notification, 'getDismissedReason')
      };
      window.hadithGoogleOneTapStatus = status;
      if (status.notDisplayed || status.skipped) {
        oneTapStarted = false;
      }
      if (status.notDisplayed || status.skipped || status.dismissed) {
        console.info('Google One Tap moment', status);
      }
      return status;
    };

    const handleGoogleCredential = async (response, options = {}) => {
      if (!response || !response.credential) return;
      try {
        const user = window.hadithAuth.setCredential(response.credential);
        if (user && user.email)
          await onAuth({ username: user.email }, { silent: !!options.silent });
        render(user);
      } catch (err) {
        toastr.error('Sign-in failed. Please try again.', 'Auth');
        console.warn(err);
      }
    };

    const initializeGoogle = async () => {
      if (googleInitialized) return googleIdApi;
      if (!window.hadithAuth?.googleClientId) return null;
      const googleId = await waitForGoogleIdentity();
      if (!googleId) return null;
      const googleConfig = {
        client_id: window.hadithAuth.googleClientId,
        callback: (response) => handleGoogleCredential(response, { silent: true }),
        auto_select: true,
        cancel_on_tap_outside: true,
        itp_support: true
      };
      if (window.HADITH_COOKIE_DOMAIN)
        googleConfig.state_cookie_domain = window.HADITH_COOKIE_DOMAIN.replace(/^\./, '');
      googleId.initialize(googleConfig);
      googleInitialized = true;
      googleIdApi = googleId;
      return googleIdApi;
    };

    const renderGoogleButtons = async () => {
      const googleId = await initializeGoogle();
      if (!googleId) return;
      document.querySelectorAll('.nav-google-signin').forEach((slot) => {
        if (slot.dataset.rendered === '1') return;
        slot.dataset.rendered = '1';
        googleId.renderButton(slot, {
          type: 'icon',
          theme: 'outline',
          shape: 'circle',
          size: 'medium'
        });
      });
    };

    const startGoogleOneTap = async () => {
      if (oneTapStarted)
        return;
      if (!window.hadithAuth?.googleClientId) {
        console.info('Google One Tap disabled: missing Google client id');
        return;
      }
      oneTapStarted = true;

      const currentUser = await window.hadithAuth.getUser();
      if (currentUser) {
        console.info('Google One Tap skipped: user is already signed in');
        return;
      }

      const googleId = await initializeGoogle();
      if (!googleId) {
        console.info('Google One Tap disabled: Google Identity Services did not load');
        oneTapStarted = false;
        return;
      }
      googleId.prompt(recordOneTapMoment);
    };

    const signOut = async () => {
      try {
        window.google?.accounts?.id?.disableAutoSelect();
        window.hadithAuth.clearCredential();
        await fetch(hadithLogoutPath(), { credentials: 'same-origin' });
        document.cookie = 'admin=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT';
        document.cookie = 'adminUser=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT';
        document.cookie = 'adminChecked=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT';
        document.cookie = 'userId=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT';
        document.cookie = 'editMode=0;path=/;';
        location.reload();
      } catch (err) {
        toastr.error('Sign-out failed. Please try again.', 'Auth');
        console.warn(err);
      }
    };

    const syncCurrentUser = async () => {
      const user = await window.hadithAuth.getUser();
      render(user);
      if (user && user.email && needsHadithAuthSync(user)) {
        await onAuth({ username: user.email }, { silent: true });
      } else if (!user) {
        await syncHadithSessionFromCookie();
        startGoogleOneTap();
      } else {
        renderHadithAdminGear();
      }
    };

    document.addEventListener('hadithGooglePromptMoment', (event) => {
      if (event && event.detail) recordOneTapMoment(event.detail.notification);
    });
    document.addEventListener('hadithAuthChanged', syncCurrentUser);
    syncCurrentUser();
  })();
</script>

