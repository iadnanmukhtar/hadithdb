<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script>
  (function initFirebaseGlobal() {
    if (window.firebaseApp) return;
    const firebaseConfig = {
      apiKey: '<%= global.settings.firebase.apiKey || "" %>',
      authDomain: '<%= global.settings.firebase.authDomain || "" %>',
      projectId: '<%= global.settings.firebase.projectId || "" %>',
      appId: '<%= global.settings.firebase.appId || "" %>'
    };
    const googleClientId = '<%= (global.settings.firebase && (global.settings.firebase.googleClientId || global.settings.firebase.clientId || global.settings.firebase.client_id)) || (global.settings.google && (global.settings.google.clientId || global.settings.google.client_id)) || "" %>';
    if (!firebaseConfig.apiKey) return;
    if (!firebase.apps?.length) {
      firebase.initializeApp(firebaseConfig);
    }
    firebase.auth().setPersistence(firebase.auth.Auth.Persistence.LOCAL).catch((err) => {
      console.warn('Could not set Firebase persistence to LOCAL', err);
    });
    const auth = firebase.auth();
    const getUser = () =>
      auth.currentUser ||
      new Promise(resolve => {
        const unsub = auth.onAuthStateChanged(u => {
          unsub();
          resolve(u);
        });
      });
    window.hadithAuth = {
      getToken: async () => {
        const user = await getUser();
        return user ? user.getIdToken() : null;
      },
      requireLogin: () => {
        toastr.error('Please sign in to like or comment.', 'Sign-in required');
      },
      getUser,
      googleClientId
    };
    window.firebaseApp = true;
  })();
</script>

<!-- Nav Google Auth UI -->
<script>
  (function initNavAuth() {
    if (window.navAuthInit) return;
    const desktopSlot = document.getElementById('nav-auth-desktop');
    const mobileSlot = document.getElementById('nav-auth-mobile');
    if (!desktopSlot && !mobileSlot) return;
    window.navAuthInit = true;
    let oneTapStarted = false;

    const render = (user) => {
      const avatar = user && (user.photoURL || 'https://www.gravatar.com/avatar/?d=mp&s=48');
      const name = user && (user.displayName || user.email || 'User');
      const profileHtml = `
        <div class="dropdown">
          <button class="btn btn-link p-0 border-0 dropdown-toggle d-flex align-items-center nav-auth-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="${avatar}" alt="${name}" class="rounded-circle" width="32" height="32">
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="button" class="dropdown-item nav-signout">Sign out</button></li>
          </ul>
        </div>
      `;
      const loginHtml = `<button type="button" class="btn btn-link p-0 nav-signin" title="Sign in"><i class="bi bi-person-circle fs-4"></i></button>`;
      if (desktopSlot) desktopSlot.innerHTML = user ? profileHtml : loginHtml;
      if (mobileSlot) mobileSlot.innerHTML = user ? profileHtml : loginHtml;
      attachHandlers();
    };

    const attachHandlers = () => {
      const signinBtns = document.querySelectorAll('.nav-signin');
      signinBtns.forEach(btn => btn.onclick = signIn);
      const signoutBtns = document.querySelectorAll('.nav-signout');
      signoutBtns.forEach(btn => btn.onclick = signOut);
    };

    const signIn = async () => {
      try {
        const auth = firebase.auth();
        const provider = new firebase.auth.GoogleAuthProvider();
        const result = await auth.signInWithPopup(provider);
        const user = result.user || auth.currentUser;
        if (user && user.email)
          await onAuth({ username: user.email });
      } catch (err) {
        toastr.error('Sign-in failed. Please try again.', 'Auth');
        console.warn(err);
      }
    };

    const waitForGoogleIdentity = () => new Promise(resolve => {
      if (window.google?.accounts?.id) return resolve(window.google.accounts.id);
      let attempts = 0;
      const timer = setInterval(() => {
        attempts += 1;
        if (window.google?.accounts?.id) {
          clearInterval(timer);
          resolve(window.google.accounts.id);
        } else if (attempts >= 40) {
          clearInterval(timer);
          resolve(null);
        }
      }, 100);
    });

    const signInWithOneTapCredential = async (response) => {
      if (!response || !response.credential) return;
      try {
        const auth = firebase.auth();
        const credential = firebase.auth.GoogleAuthProvider.credential(response.credential);
        const result = await auth.signInWithCredential(credential);
        const user = result.user || auth.currentUser;
        if (user && user.email)
          await onAuth({ username: user.email }, { silent: true });
      } catch (err) {
        console.warn('Google One Tap sign-in failed', err);
      }
    };

    const startGoogleOneTap = async () => {
      if (oneTapStarted)
        return;
      if (!window.hadithAuth?.googleClientId) {
        console.info('Google One Tap disabled: missing Google client id');
        return;
      }
      oneTapStarted = true;

      const currentUser = await window.hadithAuth.getUser();
      if (currentUser) {
        console.info('Google One Tap skipped: Firebase user is already signed in');
        return;
      }

      const googleId = await waitForGoogleIdentity();
      if (!googleId) {
        console.info('Google One Tap disabled: Google Identity Services did not load');
        return;
      }

      googleId.initialize({
        client_id: window.hadithAuth.googleClientId,
        callback: signInWithOneTapCredential,
        auto_select: false,
        cancel_on_tap_outside: true,
        itp_support: true
      });
      googleId.prompt();
    };

    const signOut = async () => {
      try {
        window.google?.accounts?.id?.disableAutoSelect();
        await firebase.auth().signOut();
        await fetch('/login/logout', { credentials: 'same-origin' });
        document.cookie = 'admin=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT';
        document.cookie = 'userId=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT';
        document.cookie = 'editMode=0;path=/;';
        location.reload();
      } catch (err) {
        toastr.error('Sign-out failed. Please try again.', 'Auth');
        console.warn(err);
      }
    };

    const auth = firebase.auth();
    auth.onAuthStateChanged((user) => {
      render(user);
      if (!user)
        startGoogleOneTap();
    });
    render(null);
    startGoogleOneTap();
  })();
</script>

