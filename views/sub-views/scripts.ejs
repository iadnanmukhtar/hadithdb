<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
  if (!window.marked) {
    document.write('<script src="/vendor/marked/marked.min.js"><\/script>');
  }
</script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>
  window.HADITH_BASE_URL = <%- JSON.stringify(utils.hadithBaseUrl(req)) %>;
  window.HADITH_QURAN_BASE_URL = <%- JSON.stringify(utils.quranBaseUrl(req)) %>;
  window.HADITH_PAYMENT_FEATURE_ENABLED = <%= locals.paymentFeatureEnabled === true ? 'true' : 'false' %>;
  window.HADITH_TAFSIR_TRANSLATION_ENABLED = <%= locals.tafsirTranslationFeatureEnabled === false ? 'false' : 'true' %>;
  window.HADITH_COOKIE_DOMAIN = (() => {
    try {
      const siteHost = new URL('<%= global.settings.site.url %>').hostname.toLowerCase();
      const host = window.location.hostname.toLowerCase();
      if (!siteHost || siteHost === 'localhost' || !siteHost.includes('.')) return '';
      return (host === siteHost || host.endsWith(`.${siteHost}`)) ? `.${siteHost}` : '';
    } catch (err) {
      return '';
    }
  })();
</script>
<script src="/javascripts/script.js?v=<%= utils.scriptAssetVersion() %>"></script>

<% if (site.editMode) { %>
<!-- Inline Editing -->
<script>
  $(function () {

	    toastr.options.closeMethod = 'fadeOut';
	    toastr.options.closeDuration = 300;
	    toastr.options.closeEasing = 'swing';

	    const renderMarkdown = (text) => {
	      if (!text) return '';
	      if (window.marked && window.marked.parse)
	        return window.marked.parse(text).replace(/<br>/g, '</p><p>').trim();
	      return text;
	    };
	    const stripQuranDisplayFootnotes = (value) => (value || '').toString()
	      .replace(/\r\n?/g, '\n')
	      .replace(/(?:^|\n)[ \t]*\[\^[^\]\n]+\]:[^\n]*(?:\n[ \t]+[^\n]*)*/g, '\n')
	      .replace(/\[\^[^\]\n]+\]/g, '')
	      .replace(/(?:\\\[|\[)(?:\\\[|\[)([\s\S]*?)(?:\\\]|\])(?:\\\]|\])/g, '')
	      .replace(/[ \t]+\n/g, '\n')
	      .replace(/\n{3,}/g, '\n\n')
	      .trim();
	    const stripQuranDisplayFootnoteHtml = (html) => {
	      const wrapper = document.createElement('div');
	      wrapper.innerHTML = html || '';
	      wrapper.querySelectorAll('.footnote-ref, .footnotes-sep, .footnotes, .footnote, hr').forEach((node) => node.remove());
	      return wrapper.innerHTML.trim();
	    };
	    const renderQuranCompactMarkdown = (text) => stripQuranDisplayFootnoteHtml(renderMarkdown(stripQuranDisplayFootnotes(text)));
	    const isQuranCompactMarkdownElement = ($el) => $el.hasClass('quran-ayah-hero-text');

	    const normalizeMarkdownValue = (value) => (value || '').toString().replace(/&nbsp;/g, ' ').replace(/\r\n?/g, '\n');

	    const isMarkdownProp = (prop) => /body|intro|footnote|note/.test(prop) || prop === 'book.description';
	    const hasMarkdownSource = ($el) => $el.is('[data-markdown-source]');
	    const isMarkdownElement = ($el) => isMarkdownProp(($el.data('prop') || '').toString()) || $el.attr('data-edit-format') === 'md';
	    const rtlLanguageCodes = new Set(['ar', 'fa', 'he', 'ur']);
	    const editingDirectionForLanguage = (lang) => rtlLanguageCodes.has((lang || '').toString().toLowerCase()) ? 'rtl' : 'ltr';
	    const applyInlineEditorLanguageContext = ($el) => {
	      const $context = $el.closest('[data-content-language], [lang], [dir]');
	      const lang = ($el.attr('lang') || $el.attr('data-content-language') || $context.attr('data-content-language') || $context.attr('lang') || '').toString().toLowerCase();
	      if (lang) {
	        $el.attr('lang', lang);
	        $el.attr('data-content-language', lang);
	      }
	      const dir = ($el.attr('dir') || $context.attr('dir') || editingDirectionForLanguage(lang)).toString().toLowerCase();
	      if (dir === 'rtl' || dir === 'ltr')
	        $el.attr('dir', dir);
	    };

	    const getMarkdownSource = ($el) => ($el.attr('data-markdown-source') || '').toString();

	    const setMarkdownSource = ($el, value) => {
	      $el.attr('data-markdown-source', (value || '').toString());
	    };

	    const isEnglishTafsirMarkdown = ($el) => isTafsirEditor($el) && $el.attr('data-edit-lang') === 'en';

	    const renderEnglishTafsirMarkdown = (html) => {
	      const $root = $('<div>').html(html || '');
	      $root.find('pre code').each(function () {
	        const text = $(this).text().replace(/\n+$/g, '');
	        const $paragraph = $('<p>');
	        text.split(/\n+/).forEach((line, index) => {
	          if (index > 0)
	            $paragraph.append($('<br>'));
	          $paragraph.append($('<span>').addClass('quran-tafsir-backtick quran-hafs').attr({ lang: 'ar', dir: 'rtl' }).text(line));
	        });
	        $(this).closest('pre').replaceWith($paragraph);
	      });
	      $root.find('code').each(function () {
	        $(this).replaceWith($('<span>').addClass('quran-tafsir-backtick quran-hafs').attr({ lang: 'ar', dir: 'rtl' }).text($(this).text()));
	      });
	      return $root.html();
	    };

	    const setMarkdownPreview = (el, value) => {
	      const $el = $(el);
	      const markdown = (value || '').toString();
	      const emptyHtml = ($el.attr('data-markdown-empty-html') || '').toString();

	      setMarkdownSource($el, markdown);
	      $el.removeClass('markdown-editing');
	      if (markdown) {
	        const html = isQuranCompactMarkdownElement($el) ? renderQuranCompactMarkdown(markdown) : renderMarkdown(markdown);
	        $el.html(isEnglishTafsirMarkdown($el) ? renderEnglishTafsirMarkdown(html) : html);
	      }
	      else if (emptyHtml)
	        $el.html(emptyHtml);
	      else
	        $el.html('');
	    };

	    const enterMarkdownEditMode = (el) => {
	      const $el = $(el);
	      if ($el.hasClass('markdown-editing'))
	        return;
	      $el.addClass('markdown-editing');
	      $el.text(getMarkdownSource($el));
	    };

	    const isTafsirEditor = ($el) => $el.hasClass('quran-tafsir-editor');

	    const isMarkdownBlockNode = (node) => node && node.nodeType === Node.ELEMENT_NODE && /^(p|div|ul|ol|blockquote)$/i.test(node.tagName);

	    const markdownNodesToText = (nodes) => {
	      let text = '';
	      Array.from(nodes || []).forEach((node, idx, arr) => {
	        const segment = htmlNodeToMarkdown(node);
	        if (!segment)
	          return;
	        if (!text) {
	          text = segment;
	          return;
	        }
	        const prevNode = arr[idx - 1];
	        if (isMarkdownBlockNode(prevNode) || isMarkdownBlockNode(node))
	          text += `\n\n${segment}`;
	        else
	          text += segment;
	      });
	      return text;
	    };

	    const htmlNodeToMarkdown = (node) => {
	      if (!node) return '';
	      if (node.nodeType === Node.TEXT_NODE)
	        return node.nodeValue;
	      if (node.nodeType !== Node.ELEMENT_NODE)
	        return '';
	      const tag = node.tagName.toLowerCase();
	      const children = markdownNodesToText(node.childNodes);
	      switch (tag) {
	        case 'br':
	          return '\n\n';
	        case 'p':
	        case 'div':
	          return children;
	        case 'strong':
	        case 'b':
	          return children ? `**${children}**` : '';
	        case 'em':
	        case 'i':
	          return children ? `*${children}*` : '';
	        case 'u':
	          return children ? `__${children}__` : '';
	        case 'a': {
	          const href = node.getAttribute('href') || '';
	          return href ? `[${children || href}](${href})` : children;
	        }
	        case 'ul':
	          return Array.from(node.children).map(li => `- ${htmlNodeToMarkdown(li).trim()}`).join('\n');
	        case 'ol':
	          return Array.from(node.children).map((li, idx) => `${idx + 1}. ${htmlNodeToMarkdown(li).trim()}`).join('\n');
	        case 'li':
	          return children;
	        case 'blockquote':
	          return children.split(/\n/).map(line => line ? `> ${line}` : '>').join('\n');
	        case 'code':
	          return children ? `\`${children.replace(/`/g, '\\`')}\`` : '';
	        case 'pre':
	          return children ? `\`\`\`\n${children.replace(/\n+$/g, '')}\n\`\`\`` : '';
	        case 'span':
	          if (node.classList.contains('quran-tafsir-backtick'))
	            return children ? `\`${children.replace(/`/g, '\\`')}\`` : '';
	          return children;
	        default:
	          return children;
	      }
	    };

	    const htmlToMarkdown = (html) => {
	      if (!html) return '';
	      const parser = new DOMParser();
	      const doc = parser.parseFromString(html, 'text/html');
	      return markdownNodesToText(doc.body.childNodes).replace(/\n{3,}/g, '\n\n').trim();
	    };

	    const setElementValue = (el, value) => {
	      const $el = $(el);
	      const prop = ($el.data('prop') || '').toString();
	      const isMarkdownField = isMarkdownElement($el);

	      if ($el.is('textarea') || $el.is('input')) {
	        $el.val(value);
	      } else if ($el.is('select')) {
	        $el.val(value);
	      } else if (isMarkdownField) {
	        setMarkdownPreview(el, value);
	      } else {
	        $el.text(value);
	      }
	    };

	    const applyHadithRevision = (id, revised) => {
	      if (!id || !revised)
	        return;
	      const fieldMap = {
	        title_en: 'hadith.title_en',
	        chain: 'hadith.chain',
	        body: 'hadith.body',
	        footnote: 'hadith.footnote',
	        chain_en: 'hadith.chain_en',
	        body_en: 'hadith.body_en',
	        footnote_en: 'hadith.footnote_en'
	      };
	      Object.entries(fieldMap).forEach(([key, prop]) => {
	        if (typeof revised[key] !== 'string')
	          return;
	        $(`[data-id="${id}"][data-prop="${prop}"]`).each(function () {
	          setElementValue(this, revised[key]);
	        });
	      });
	    };

	    const setSimilarToggleButton = ($button, promoted) => {
	      if (!$button.length)
	        return null;
	      const nextProp = promoted ? 'hadiths_sim.demote' : 'hadiths_sim.add';
	      const nextTitle = promoted ? 'Make similar candidate' : 'Make actual similar hadith';
	      const nextLoadingLabel = promoted ? 'Moving' : 'Adding';
	      const nextHtml = promoted
	        ? '<span class="bi bi-arrow-down-circle"></span> Make Candidate'
	        : '<span class="bi bi-check2-circle"></span> Make Similar';
	      $button
	        .data('prop', nextProp)
	        .attr('data-prop', nextProp)
	        .data('loading-label', nextLoadingLabel)
	        .attr('data-loading-label', nextLoadingLabel)
	        .attr('title', nextTitle);
	      return nextHtml;
	    };

	    const removeSimilarHadithElement = ($button) => {
	      const $article = $button.closest('article');
	      if (!$article.length)
	        return;
	      const modalTarget = $article.find('[data-bs-target^="#H"]').first().attr('data-bs-target');
	      $article.prev('a[id]').remove();
	      if (modalTarget)
	        $(modalTarget).remove();
	      $article.remove();
	    };

	    const removeSimilarCandidateElements = ($button) => {
	      const $similarList = $button.closest('article').nextAll('.similar-list').first();
	      if (!$similarList.length)
	        return;
	      $similarList.find('article[data-similar-candidate="true"]').each(function () {
	        removeSimilarHadithElement($(this));
	      });
	    };

	    async function changeListener(e) {
	      if (e && typeof e.preventDefault === 'function')
	        e.preventDefault();
	      const $el = $(this);
	      const propStr = (($el.data('prop')) || '').toString();
	      const isMarkdownField = isMarkdownElement($el);
	      if ($(this).attr('submitting') == 'true') {
	        e.stopPropagation();
	        return;
	      }
	      if (isMarkdownField && $(this).attr('editing') != 'true' && $(this).attr('clickable') != 'true' && $(this).hasClass('markdown-editing')) {
	        setMarkdownPreview(this, getMarkdownSource($el));
	        e.stopPropagation();
	        return;
	      }
	      if ($(this).attr('editing') == 'true' || $(this).attr('clickable') == 'true') {
	        $(this).attr('submitting', 'true');
	        const isClickableButton = $(this).attr('clickable') == 'true' && $(this).is('button');
	        const $loadingButton = isClickableButton ? $(this) : $($(this).data('loadingButton'));
	        const hasLoadingButton = $loadingButton.length && $loadingButton.is('button');
	        let finalButtonHtml = hasLoadingButton ? $loadingButton.html() : null;
	        let removeSimilarHadith = false;
	        var id = $(this).data('id');
	        var prop = $(this).data('prop');
	        var arabizi = $(this).data('arabizi');
	        var value = '';
	        if ($(this).attr('type') == 'checkbox')
	          value = $(this).prop('checked') ? "1" : "0";
	        else if ($(this).is('textarea') || $(this).is('select') || $(this).is('input'))
	          value = $(this).val();
	        else if (isMarkdownField)
	          value = $(this).hasClass('markdown-editing') ? htmlToMarkdown($(this).html()) : getMarkdownSource($(this)) || htmlToMarkdown($(this).html());
	        else
	          value = $(this).text();
	        value = isMarkdownField ? normalizeMarkdownValue(value) : (value || '').toString().replace(/&nbsp;/g, ' ').trim();
	        if (isMarkdownField)
	          setMarkdownPreview(this, value);
	        if (hasLoadingButton) {
	          $loadingButton.prop('disabled', true);
	          $loadingButton.html(`<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> ${$loadingButton.data('loading-label') || 'Working'}`);
	        }
	        var reqBody = {
	          id: id,
	          prop: prop,
	          arabizi: arabizi,
	          value: value,
	          quranSectionPath: propStr === 'toc.title_en' && !$el.closest('.quran-subheading').length
	            ? window.location.pathname
	            : '',
	        };
	        try {
	          var resBody = await update(reqBody);
	          // update element on success
	          if (resBody.code == 200) {
	            if (resBody.value !== undefined)
	              value = resBody.value;
	            if (propStr === 'hadith.revise')
	              applyHadithRevision(id, resBody.revised);
	            if (propStr === 'hadiths_sim.add')
	              finalButtonHtml = setSimilarToggleButton($loadingButton, true) || finalButtonHtml;
	            else if (propStr === 'hadiths_sim.demote')
	              finalButtonHtml = setSimilarToggleButton($loadingButton, false) || finalButtonHtml;
	            else if (propStr === 'hadiths_sim.del')
	              removeSimilarHadith = true;
	            else if (propStr === 'hadiths_sim.delall')
	              removeSimilarCandidateElements($loadingButton);
	            if (resBody.id && resBody.id.toString() !== id.toString()) {
	              $(`[data-id="${id}"]`).each(function () {
	                $(this).data('id', resBody.id).attr('data-id', resBody.id);
	              });
	              id = resBody.id;
	            }
	            if ($(this).data('reset') == 'true')
	              value = '';
	            if (!removeSimilarHadith && !$(this).is('select') && value !== undefined && value !== null)
	              setElementValue(this, value);
	          }
	        } finally {
	          if (hasLoadingButton) {
	            $loadingButton.prop('disabled', false);
	            $loadingButton.html(finalButtonHtml);
	          }
	          if (removeSimilarHadith)
	            removeSimilarHadithElement($loadingButton);
	          $(this).removeData('loadingButton');
	          $(this).removeAttr('submitting');
	          $(this).removeAttr('editing');
	        }
	      };
	      e.stopPropagation();
	    }

	    async function update(reqBody) {
	      var resBody = {};
	      var res = {
	        status: 500,
	        statusText: 'Unable to execute update due to an unknown error'
	      };
	      const updateUrl = (id, prop) => {
        return editHadithApiPath(`/update/${id}/${prop}`);
      };
      if (reqBody) {
        const token = window.hadithAuth && window.hadithAuth.getToken ? await window.hadithAuth.getToken() : null;
        const headers = {
          'Content-Type': 'application/json'
        };
        if (token)
          headers.Authorization = `Bearer ${token}`;
        res = await fetch(updateUrl(reqBody.id, reqBody.prop), {
          method: 'POST',
          headers,
          body: JSON.stringify({
            id: reqBody.id,
            prop: reqBody.prop,
            arabizi: reqBody.arabizi,
            value: reqBody.value,
            quranSectionPath: reqBody.quranSectionPath,
          })
        });
        const responseText = await res.text();
        try {
          resBody = JSON.parse(responseText);
        } catch (err) {
          resBody = {
            code: res.status,
            message: `Expected JSON from ${res.url || 'server'}, got ${responseText.trim().substring(0, 120) || res.statusText}`
          };
        }
      } else {
        res.statusText = 'Update request body is not present';
      }
      if (res.status == 200) {
        const successMessage = `Successful update for ${reqBody.id}/${reqBody.prop}`;
        console.log(successMessage);
        toastr.success(`${res.status} ${res.statusText}`, successMessage);
      } else {
        var errMessage = `${res.status} ${res.statusText} ${resBody.message}`;
        console.error(`Update Error\n${errMessage}`);
        toastr.error(errMessage, `Error on update for ${reqBody.id}/${reqBody.prop}`);
      }
      return resBody;
    }

	    function split(val) {
	      return val.split(/ +/);
	    }
	    function extractLast(term) {
	      return split(term).pop();
	    }
	    function editHadithApiPath(path) {
	      path = String(path || '');
	      if (path.charAt(0) !== '/')
	        path = `/${path}`;
	      const isQuranHost = window.location.hostname.toLowerCase().split('.')[0] === 'quran';
	      if (isQuranHost && path !== '/quran' && !path.startsWith('/quran/'))
	        return `/quran${path}`;
	      return path;
	    }

	    const bindInlineEditors = (scope) => {
	      $(scope || document).find('._e').addBack('._e').each(function () {
	        const $el = $(this);
	        if ($el.data('inlineEditorBound'))
	          return;
	        $el.data('inlineEditorBound', true);
	        applyInlineEditorLanguageContext($el);
	        if (!$el.is('textarea, input, select'))
	          $el.attr('contenteditable', 'true');
	        if (isMarkdownElement($el) && !hasMarkdownSource($el))
	          setMarkdownSource($el, htmlToMarkdown($el.html()));
	        $el.on('focusin', function () {
	          if (isMarkdownElement($(this)))
	            enterMarkdownEditMode(this);
	        });
	        $el.on('input', function () {
	          $(this).attr('editing', 'true');
	          $(this).removeClass('partial');
	        });
	        if (isTafsirEditor($el))
	          ensureTafsirSaveButton($el);
	        else
	          $el.on('blur', changeListener);
	      });
	    };

	    const bindAdminContentTranslationSwitchers = (scope) => {
	      $(scope || document).find('[data-admin-content-translation-select="1"]').addBack('[data-admin-content-translation-select="1"]').each(function () {
	        const $select = $(this);
	        if ($select.data('adminContentTranslationSwitcherBound'))
	          return;
	        $select.data('adminContentTranslationSwitcherBound', true);
	        $select.on('change', function () {
	          const code = ($(this).val() || '').toString();
	          const $article = $(this).closest('article');
	          $article.find('[data-admin-content-translation-select="1"]').val(code);
	          const $panels = $article.find('[data-admin-content-translation-panel]');
	          $panels.addClass('d-none');
	          const $active = $panels.filter(function () {
	            return ($(this).attr('data-admin-content-translation-panel') || '').toString() === code;
	          }).removeClass('d-none');
	          bindInlineEditors($active);
	        });
	      });
	    };

	    const ensureTafsirSaveButton = ($el) => {
	      if ($el.next('.quran-tafsir-save').length)
	        return;
	      const $button = $('<button type="button" class="btn btn-sm btn-outline-primary quran-tafsir-save mt-2 mb-3" lang="en" dir="ltr" data-loading-label="Saving"><i class="bi bi-save" aria-hidden="true"></i><span lang="en" dir="ltr">Save</span></button>');
	      $button.on('mousedown', function (e) {
	        e.preventDefault();
	      });
	      $button.on('click', function (e) {
	        e.preventDefault();
	        e.stopPropagation();
	        if ($el.attr('submitting') == 'true')
	          return;
	        $el.data('loadingButton', this);
	        $el.attr('editing', 'true');
	        changeListener.call($el[0], e);
	      });
	      $el.after($button);
	    };
	    window.bindInlineEditors = bindInlineEditors;
	    bindInlineEditors(document);
	    bindAdminContentTranslationSwitchers(document);
	    if (window.selectAdminContentTranslationLanguage && window.readGlobalContentLanguage)
	      window.selectAdminContentTranslationLanguage(window.readGlobalContentLanguage());
	    document.addEventListener('hadithContentLanguageChanged', (event) => {
	      if (window.selectAdminContentTranslationLanguage)
	        window.selectAdminContentTranslationLanguage(event.detail && event.detail.language);
	    });

    $('._click').each(function () {
      if ($(this).is('a') && !$(this).attr('href'))
        $(this).attr('href', '#');
      $(this).attr('clickable', 'true');
      $(this).on('click', changeListener);
    });

    $('._submit-edit').each(function () {
      $(this).on('mousedown', function (e) {
        e.preventDefault();
      });
      $(this).on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const $input = $(this).siblings('._e').first();
        if (!$input.length || $input.attr('submitting') == 'true')
          return;
        $input.data('loadingButton', this);
        $input.attr('editing', 'true');
        changeListener.call($input[0], e);
      });
    });

  });
</script> 
<% } %> 

<!-- Social Login -->
<script type="text/javascript">
  function getHadithCookie(name) {
      const match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/[.$?*|{}()[\]\\/+^]/g, '\\$&') + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : '';
  }

  function setHadithCookie(name, value, maxAge) {
      const domain = window.HADITH_COOKIE_DOMAIN ? `;domain=${window.HADITH_COOKIE_DOMAIN}` : '';
      const age = Number.isFinite(maxAge) ? `;max-age=${maxAge}` : '';
      document.cookie = `${name}=${encodeURIComponent(value)};path=/${age};samesite=lax${domain}`;
  }

  function clearHadithCookie(name) {
      document.cookie = `${name}=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT`;
      if (window.HADITH_COOKIE_DOMAIN)
        document.cookie = `${name}=;path=/;domain=${window.HADITH_COOKIE_DOMAIN};expires=Thu, 01 Jan 1970 00:00:00 GMT`;
  }

  function randomHadithToken(length = 32) {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
      if (window.crypto && window.crypto.getRandomValues) {
        const values = new Uint8Array(length);
        window.crypto.getRandomValues(values);
        return Array.from(values, value => chars[value % chars.length]).join('');
      }
      let token = '';
      for (let i = 0; i < length; i++)
        token += chars.charAt(Math.floor(Math.random() * chars.length));
      return token;
  }

  function ensureHadithGoogleCsrfToken() {
      const existing = getHadithCookie('g_csrf_token');
      if (existing) return existing;
      const token = randomHadithToken(32);
      setHadithCookie('g_csrf_token', token, 60 * 60);
      return token;
  }

  window.HADITH_SESSION_MAX_AGE = window.HADITH_SESSION_MAX_AGE || 60 * 60 * 24 * 30;
  window.hadithAdmin = <%= site.admin ? 'true' : 'false' %>;
  window.hadithEditMode = <%= site.editMode ? 'true' : 'false' %>;
  window.hadithAdminSessionChecked = window.hadithAdmin === true;
  const HADITH_LOGIN_SESSION_CACHE_KEY = 'hadithdb_login_session';

  function normalizeHadithSessionUser(user) {
      if (!user || typeof user !== 'object') return null;
      const uid = (user.uid || user.userId || user.email || '').toString();
      if (!uid) return null;
      return {
        uid,
        provider: user.provider || 'google.com',
        name: user.name || user.displayName || user.email || 'User',
        email: user.email || null,
        photo: user.photo || user.photoURL || null,
        admin: Boolean(user.admin)
      };
  }

  function decodeHadithJwtPayload(token) {
      try {
        const parts = String(token || '').split('.');
        if (parts.length < 2) return null;
        let normalized = parts[1].replace(/-/g, '+').replace(/_/g, '/');
        normalized += '='.repeat((4 - normalized.length % 4) % 4);
        const json = decodeURIComponent(atob(normalized).split('').map((c) => `%${(`00${c.charCodeAt(0).toString(16)}`).slice(-2)}`).join(''));
        return JSON.parse(json);
      } catch (err) {
        return null;
      }
  }

  function isHadithLoginSessionCacheExpired(payload) {
      const token = payload && payload.token;
      const tokenPayload = decodeHadithJwtPayload(token);
      if (!token || !tokenPayload || !Number.isFinite(tokenPayload.exp))
        return true;
      if (tokenPayload.exp * 1000 <= Date.now())
        return true;
      const cachedAt = Number(payload.cachedAt || 0);
      return !Number.isFinite(cachedAt) || cachedAt <= 0 || Date.now() - cachedAt > window.HADITH_SESSION_MAX_AGE * 1000;
  }

  function readHadithLoginSessionCache() {
      try {
        const raw = localStorage.getItem(HADITH_LOGIN_SESSION_CACHE_KEY);
        if (!raw) return null;
        const payload = JSON.parse(raw);
        if (!payload || (payload.__hadithdbLoginSessionCache !== 1 && payload.__hadithLoginSessionCache !== 1))
          throw new Error('Unexpected login session cache payload');
        const user = normalizeHadithSessionUser(payload.user);
        if (!payload.loggedIn || !user)
          throw new Error('Missing login session user');
        if (isHadithLoginSessionCacheExpired(payload))
          throw new Error('Expired login session cache');
        return {
          status: 200,
          loggedIn: true,
          token: payload.token || null,
          userId: user.uid,
          admin: Boolean(user.admin),
          user,
          cached: true
        };
      } catch (err) {
        try { localStorage.removeItem(HADITH_LOGIN_SESSION_CACHE_KEY); } catch (_err) {}
        return null;
      }
  }

  function writeHadithLoginSessionCache(session) {
      const user = normalizeHadithSessionUser(session && (session.user || session));
      if (!user) return;
      try {
        localStorage.setItem(HADITH_LOGIN_SESSION_CACHE_KEY, JSON.stringify({
          __hadithdbLoginSessionCache: 1,
          cachedAt: Date.now(),
          loggedIn: true,
          token: session.token || null,
          user
        }));
      } catch (err) {
        console.warn('Could not cache login session', err);
      }
  }

  function clearHadithLoginSessionCache() {
      try {
        localStorage.removeItem(HADITH_LOGIN_SESSION_CACHE_KEY);
      } catch (err) {
        console.warn('Could not clear login session cache', err);
      }
      clearHadithCookie('admin');
      clearHadithCookie('adminUser');
      clearHadithCookie('adminChecked');
      clearHadithCookie('userId');
      clearHadithCookie('editMode');
  }

  function getHadithEditMode() {
      try {
        return localStorage.getItem('hadithdb_edit_mode') === '1';
      } catch (err) {
        return false;
      }
  }

  function setHadithEditMode(enabled) {
      try {
        localStorage.setItem('hadithdb_edit_mode', enabled ? '1' : '0');
      } catch (err) {
        // Ignore private-mode or blocked storage failures.
      }
      if (enabled)
        setHadithCookie('editMode', '1', window.HADITH_SESSION_MAX_AGE);
      else
        clearHadithCookie('editMode');
  }

  function markHadithAuthSynced(username) {
      if (!username) return;
      sessionStorage.setItem('hadithdb_google_login', '1');
      sessionStorage.setItem(`hadithdb_auth_synced:${username}`, '1');
  }

  function setHadithAdminMode(enabled) {
      setHadithEditMode(enabled);
      location.reload();
  }
  window.setHadithAdminMode = setHadithAdminMode;

  function renderHadithAdminGear() {
      if (window.hadithAdmin !== true) {
        if (window.hadithAdminSessionChecked) {
          document.querySelectorAll('.edit-gear').forEach((el) => el.remove());
          setHadithEditMode(false);
        }
        return;
      }
      const editMode = getHadithEditMode();
      const icon = editMode ? 'bi-gear-fill' : 'bi-gear';
      const desktopList = document.querySelector('.site-navbar menu.d-md-block ul.nav');
      if (desktopList && !desktopList.querySelector('.edit-gear')) {
        const searchItem = desktopList.querySelector('.search-click-toggle');
        const item = document.createElement('li');
        item.className = 'nav-item edit-gear';
        item.innerHTML = `<a class="nav-link" role="button" title="${editMode ? 'Turn off admin mode' : 'Turn on admin mode'}" aria-label="${editMode ? 'Turn off admin mode' : 'Turn on admin mode'}"><i class="bi ${icon}"></i></a>`;
        item.querySelector('a').addEventListener('click', () => setHadithAdminMode(!editMode));
        desktopList.insertBefore(item, searchItem || null);
      }

      const mobileList = document.querySelector('#offcanvas-topnav .offcanvas-col1');
      if (mobileList && !mobileList.querySelector('.edit-gear')) {
        const item = document.createElement('li');
        item.className = 'nav-item edit-gear';
        item.innerHTML = `<a class="nav-link" role="button"><i class="app-menu-icon bi ${icon}" aria-hidden="true"></i> <strong>${editMode ? 'View' : 'Edit'}</strong></a>`;
        item.querySelector('a').addEventListener('click', () => setHadithAdminMode(!editMode));
        const separator = document.createElement('li');
        separator.className = 'edit-gear';
        separator.innerHTML = '<hr>';
        mobileList.appendChild(separator);
        mobileList.appendChild(item);
      }
  }

  function hadithLoginPath() {
      if (window.location.hostname.toLowerCase().split('.')[0] === 'quran')
        return '/quran/login/google';
      return '/login/google';
  }

  function hadithLogoutPath() {
      if (window.location.hostname.toLowerCase().split('.')[0] === 'quran')
        return '/quran/login/logout';
      return '/login/logout';
  }

  function hadithApiPath(path) {
      path = String(path || '');
      if (path.charAt(0) !== '/')
        path = `/${path}`;
      const isQuranHost = window.location.hostname.toLowerCase().split('.')[0] === 'quran';
      if (isQuranHost && path !== '/quran' && !path.startsWith('/quran/'))
        return `/quran${path}`;
      return path;
  }

  function needsHadithAuthSync(user) {
      if (!user)
        return false;
      const uid = user.uid || user.userId || user.email || user.username;
      const cachedSession = readHadithLoginSessionCache();
      if (cachedSession && cachedSession.loggedIn && cachedSession.user) {
        const cachedUid = cachedSession.user.uid || cachedSession.user.email;
        if (!uid || cachedUid === uid || cachedSession.user.email === uid)
          return false;
      }
      return window.hadithAdmin !== true && !document.querySelector('.edit-gear');
  }

  async function syncHadithSessionFromCookie(options = {}) {
    const now = Date.now();
    const cachedSession = readHadithLoginSessionCache();
    if (cachedSession) {
      window.hadithSessionSyncResult = cachedSession;
      window.hadithSessionSyncAt = now;
      window.hadithAdmin = Boolean(cachedSession.admin);
      window.hadithAdminSessionChecked = true;
      renderHadithAdminGear();
      return cachedSession;
    }
    if (window.hadithSessionSyncResult && now - (window.hadithSessionSyncAt || 0) < 5000)
      return window.hadithSessionSyncResult;
    window.hadithSessionSyncResult = null;
    window.hadithSessionSyncAt = now;
    window.hadithAdmin = false;
    window.hadithAdminSessionChecked = true;
    renderHadithAdminGear();
    return null;
  }

  async function onAuth(user, options = {}) {
      const username = user && user.username;
      if (!username)
        return { status: 400, message: 'Missing username' };

      const initialSession = readHadithLoginSessionCache();
      const initialUserId = initialSession && initialSession.user ? initialSession.user.uid : '';
      const currentUser = window.hadithAuth && window.hadithAuth.getUser ? await window.hadithAuth.getUser() : null;
      const currentUid = currentUser && currentUser.uid ? currentUser.uid : username;

      if (initialUserId === currentUid) {
        const session = await syncHadithSessionFromCookie();
        if (session && session.loggedIn) {
          markHadithAuthSynced(username);
          return { ...session, skipped: true, message: 'User already logged in' };
        }
      }

      if (window.hadithAuthLoginInFlight)
        return window.hadithAuthLoginInFlight;

      window.hadithAuthLoginInFlight = (async () => {
        var res = {
          status: 403,
          statusText: 'Unable to login'
        };
        const token = window.hadithAuth && window.hadithAuth.getToken ? await window.hadithAuth.getToken() : null;
        if (!token) {
          const session = await syncHadithSessionFromCookie();
          if (session && session.loggedIn) {
            markHadithAuthSynced(username);
            return session;
          }
          if (!options.silent)
            toastr.error('Please sign in with Google first.', 'Auth');
          return { status: 401, message: 'Authentication required' };
        }
        const csrfToken = ensureHadithGoogleCsrfToken();
        res = await fetch(hadithLoginPath(), {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            credential: token,
            g_csrf_token: csrfToken
          })
        });
        var resBody = JSON.parse(await res.text());
        if (res.status == 200) {
          markHadithAuthSynced(username);
          window.hadithAdmin = Boolean(resBody.admin);
          writeHadithLoginSessionCache({
            loggedIn: true,
            token: resBody.token || null,
            admin: Boolean(resBody.admin),
            user: resBody.user || {
              uid: resBody.userId || currentUid,
              provider: resBody.provider || 'google.com',
              name: resBody.name || (currentUser && currentUser.displayName) || username,
              email: resBody.email || username,
              photo: resBody.photo || (currentUser && currentUser.photoURL) || null,
              admin: Boolean(resBody.admin)
            }
          });
          renderHadithAdminGear();
          if (!options.silent)
            toastr.success('Logged in as ' + username);
          const userChanged = initialUserId !== (resBody.userId || currentUid);
          if (options.reload !== false && !options.silent && (userChanged || resBody.admin))
            window.location.reload();
        } else {
          var errMessage = `${res.status} ${res.statusText} ${resBody.message}`;
          toastr.error(errMessage, `Update Error`);
        }
        return resBody;
      })();

      try {
        return await window.hadithAuthLoginInFlight;
      } finally {
        window.hadithAuthLoginInFlight = null;
      }
  }

  window.hadithAdmin = window.hadithAdmin === true;
  renderHadithAdminGear();
  syncHadithSessionFromCookie();
</script>

