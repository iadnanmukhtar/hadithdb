<script>
  window.HADITH_COOKIE_DOMAIN = (() => {
    try {
      const siteHost = new URL('<%= global.settings.site.url %>').hostname.toLowerCase();
      const host = window.location.hostname.toLowerCase();
      if (!siteHost || siteHost === 'localhost' || !siteHost.includes('.')) return '';
      return (host === siteHost || host.endsWith(`.${siteHost}`)) ? `.${siteHost}` : '';
    } catch (err) {
      return '';
    }
  })();
</script>
