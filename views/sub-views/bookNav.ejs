<div class="h-menu-wrap mb-3">
	<%
		var currentBookAlias = typeof page !== 'undefined' && page.context && page.context.book ? page.context.book.alias : '';
		var bookNavRequestPath = typeof req !== 'undefined' && req.originalUrl ? req.originalUrl.split('?')[0] : '';
		var isQuranBookNav = typeof req !== 'undefined' && req.quranArea === true
			|| bookNavRequestPath === '/quran'
			|| bookNavRequestPath.indexOf('/quran/') === 0;
		if (!currentBookAlias && typeof req !== 'undefined' && req.path)
			currentBookAlias = req.path.split('/').filter(Boolean)[0] || '';
		var isHadithBook = function (book) {
			return book
				&& book.hidden == 0
				&& book.alias !== 'quran'
				&& (book.type || book.book_type || book.book_model || 'hadith') === 'hadith';
		};
		var bookDeathLabel = function (book) {
			if (!book || !book.death)
				return '';
			return `d. ${book.death} AH`;
		};
			var bookTooltip = function (book) {
				return [
					book.name_en || book.title || book.shortName_en || book.shortName || book.alias,
					book.author,
					bookDeathLabel(book),
					book.published_year ? `Pub. ${book.published_year}` : '',
					book.publisher
				].filter(Boolean).join('\n');
			};
	%>
	<div class="h-menu-hint d-md-none">
		<i class="bi bi-arrow-left-right"></i> Swipe to browse <%= isQuranBookNav ? 'tafsīr books' : 'books' %>
	</div>
	<div class="h-menu-scroller">
		<div class="btn-group h-menu text-nowrap" role="group">
			<%- include('bookCarouselFilter') %>
			<% if (isQuranBookNav) {
				var carouselTafsirs = Tafsir.uniqueCarouselTafsirs(Array.isArray(locals.quranNavTafsirs) ? locals.quranNavTafsirs : []);
				for (var carouselTafsir of carouselTafsirs) {
					var carouselTafsirLabel = Tafsir.rawShortName(carouselTafsir, 'en').replace(/^tafs[īi]r\s+/i, '').trim();
					var carouselTafsirSlug = carouselTafsir.slug || Tafsir.tafsirSlug(carouselTafsir.alias);
			%>
			  <a class="btn btn-outline-primary text-nowrap tafsir-book-tooltip" href="<%= utils.quranUrl(req, `/quran/tafsir/${encodeURIComponent(carouselTafsirSlug)}`) %>" data-tafsir-tooltip="<%= bookTooltip(carouselTafsir) %>" data-book-carousel-item data-book-carousel-search="<%= [carouselTafsir.name_en, carouselTafsir.shortName_en, carouselTafsir.title, carouselTafsir.shortName, carouselTafsir.author_en, carouselTafsir.author, carouselTafsir.alias].filter(Boolean).join(' ') %>" data-tafsir-book-nav-item data-tafsir-alias="<%= carouselTafsir.alias %>" data-tafsir-lang="<%= carouselTafsir.lang || '' %>"><%= carouselTafsirLabel %></a>
			<% }
			} else {
			  for (b of books.filter(isHadithBook)) {
				var isCurrentBook = b.alias === currentBookAlias;
			%>
			  <a class="btn btn-outline-primary text-nowrap book-carousel-tooltip<%= isCurrentBook ? ' active' : '' %>"<%- isCurrentBook ? ' aria-current="page" data-current-book="true"' : '' %> href="<%= utils.urlFor(req, `/${b.alias}`) %>" data-book-tooltip="<%= bookTooltip(b) %>" data-book-carousel-item data-book-carousel-search="<%= [b.name_en, b.shortName_en, b.title, b.shortName, b.author_en, b.author, b.alias].filter(Boolean).join(' ') %>"><%= b.shortName_en %></a>
			<% }
			} %>
		</div>
	</div>
</div>
