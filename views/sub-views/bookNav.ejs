<%
	var inlineHadithBookList = typeof inlineHadithBooks !== 'undefined' && inlineHadithBooks;
%>
<div class="h-menu-wrap mb-3<%= inlineHadithBookList ? ' home-hadith-book-nav' : '' %>"<% if (inlineHadithBookList) { %> role="navigation" aria-label="Hadith books"<% } %>>
	<%
		var currentBookAlias = typeof page !== 'undefined' && page.context && page.context.book ? page.context.book.alias : '';
		var bookNavRequestPath = typeof req !== 'undefined' && req.originalUrl ? req.originalUrl.split('?')[0] : '';
		var isQuranBookNav = typeof req !== 'undefined' && req.quranArea === true
			|| bookNavRequestPath === '/quran'
			|| bookNavRequestPath.indexOf('/quran/') === 0;
		if (!currentBookAlias && typeof req !== 'undefined' && req.path)
			currentBookAlias = req.path.split('/').filter(Boolean)[0] || '';
		var isHadithBook = function (book) {
			return book
				&& book.hidden == 0
				&& book.alias !== 'quran'
				&& (book.type || book.book_type || book.book_model || 'hadith') === 'hadith';
		};
		var hadithSizeIndicator = function (book) {
			var size = utils.emptyIfNull(book && book.size || '').toString();
			var label = size === 'lg' ? 'Large hadith' : (size === 'md' ? 'Medium hadith' : (size === 'sm' ? 'Small hadith' : ''));
			if (!label)
				return '';
			return `<span class="hadith-size-indicator hadith-size-indicator-${size}" aria-label="${label}" role="img"></span>`;
		};
	%>
	<% if (!inlineHadithBookList) { %><div class="h-menu-hint d-md-none">
		<i class="bi bi-arrow-left-right"></i> Swipe to browse <%= isQuranBookNav ? 'tafsīr books' : 'books' %>
	</div><% } %>
	<div class="h-menu-scroller">
		<div class="btn-group h-menu text-nowrap" role="group">
			<% if (isQuranBookNav) { %><%- include('tafsirCarouselLanguageSwitch') %><% } %>
			<%- include('bookCarouselFilter') %>
			<% if (isQuranBookNav) {
				var carouselTafsirs = Tafsir.uniqueCarouselTafsirs(Array.isArray(locals.quranNavTafsirs) ? locals.quranNavTafsirs : []);
				for (var carouselTafsir of carouselTafsirs) {
					var carouselTafsirLabel = Tafsir.rawShortName(carouselTafsir, 'en').replace(/^tafs[īi]r\s+/i, '').trim();
					var carouselTafsirSlug = carouselTafsir.slug || Tafsir.tafsirSlug(carouselTafsir.alias);
			%>
			  <a class="btn btn-outline-primary text-nowrap" href="<%= utils.quranUrl(req, `/quran/tafsir/${encodeURIComponent(carouselTafsirSlug)}`) %>" data-book-carousel-item data-book-carousel-search="<%= [carouselTafsir.name_en, carouselTafsir.shortName_en, carouselTafsir.title, carouselTafsir.shortName, carouselTafsir.author_en, carouselTafsir.author, carouselTafsir.alias].filter(Boolean).join(' ') %>" data-tafsir-book-nav-item data-tafsir-alias="<%= carouselTafsir.alias %>" data-tafsir-lang="<%= carouselTafsir.lang || '' %>" data-tafsir-carousel-language="<%= Tafsir.carouselLanguage(carouselTafsir) %>"><%= carouselTafsirLabel %></a>
			<% }
			} else {
			  for (b of books.filter(isHadithBook)) {
				var isCurrentBook = b.alias === currentBookAlias;
			%>
			  <a class="btn btn-outline-primary text-nowrap<%= isCurrentBook ? ' active' : '' %>"<%- isCurrentBook ? ' aria-current="page" data-current-book="true"' : '' %> href="<%= utils.urlFor(req, `/${b.alias}`) %>" data-book-carousel-item data-book-carousel-search="<%= [b.name_en, b.shortName_en, b.title, b.shortName, b.author_en, b.author, b.alias].filter(Boolean).join(' ') %>"><%= b.shortName_en %><%- hadithSizeIndicator(b) %></a>
			<% }
			} %>
		</div>
	</div>
</div>
