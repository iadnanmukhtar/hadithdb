<article class="commentary-search-result row mt-3">
	<section class="col-md-6 col-sm-12 h" lang="en">
		<b><a href="<%= commentary.url %>"><%- commentary.commentary_ref_en %></a></b>
	</section>
	<section class="col-md-6 col-sm-12 h" lang="ar" dir="rtl">
		<b><a href="<%= commentary.url %>"><%- commentary.commentary_ref_ar %></a></b>
	</section>
	<% if (commentary.commentary_is_bilingual) { %>
		<div class="commentary-search-fragment col-md-6 col-sm-12" lang="en"><%- commentary.commentary_fragment_html_en %></div>
		<div class="commentary-search-fragment col-md-6 col-sm-12" lang="ar" dir="rtl"><%- commentary.commentary_fragment_html_ar %></div>
	<% } else if (commentary.commentary_fragment_html_en) { %>
		<div class="commentary-search-fragment col-12" lang="en"><%- commentary.commentary_fragment_html_en %></div>
	<% } else { %>
		<div class="commentary-search-fragment col-12" lang="ar" dir="rtl"><%- commentary.commentary_fragment_html_ar %></div>
	<% } %>
	<section class="col-12 h">
		<aside class="tags">
			<span class="bi bi-book"></span>&nbsp;<a href="<%= commentary.url %>" title="Open tafsir on the ayah page" class="icon">Tafsir</a>
		</aside>
	</section>
	<% if (commentary.commentary_section_url) { %>
		<section class="col-md-6 col-sm-12 h" lang="en">
			<aside class="title">
				§ <a href="<%= commentary.commentary_section_url %>"><%- utils.truncate(commentary.h2_title_en, 30, true) || 'Section' %></a>
			</aside>
		</section>
		<section class="col-md-6 col-sm-12 h" lang="ar" dir="rtl">
			<aside class="title">
				§ <a href="<%= commentary.commentary_section_url %>"><%- utils.truncate(commentary.h2_title, 30, true) || 'مقطع' %></a>
			</aside>
		</section>
	<% } %>
</article>
