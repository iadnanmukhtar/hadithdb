<%
	const commentarySurah = (global.surahs || []).find(function (surah) {
		return Number(surah.num) === Number(commentary.surah);
	});
	const commentarySurahRevelation = commentarySurah && /^mad/i.test((commentarySurah.revelation_en || '').toString()) ? 'madani' : 'makki';
	const commentarySurahRevelationLabel = commentarySurahRevelation === 'madani' ? 'Madani' : 'Makki';
%>
<article class="commentary-search-result row mt-3">
	<section class="col-md-6 col-sm-12 h" lang="en">
		<b><a href="<%= utils.quranUrl(req, commentary.url) %>"><%- commentary.commentary_ref_en %></a></b>
	</section>
	<section class="col-md-6 col-sm-12 h" lang="ar" dir="rtl">
		<b><a href="<%= utils.quranUrl(req, commentary.url) %>"><%- commentary.commentary_ref_ar %></a></b>
	</section>
	<% if (commentary.commentary_ayahs && commentary.commentary_ayahs.length > 0) { %>
		<section class="commentary-search-ayah quran-hafs col-12" lang="ar" dir="rtl">
			<% commentary.commentary_ayahs.forEach(function (ayah) { %>
				<% var commentaryAyahRef = `${Number(commentary.surah)}:${Number(arabic.toLatinDigits(ayah.num))}`; %>
				<span class="ayah" data-quran-ref="<%= commentaryAyahRef %>"><span class="commentary-search-ayah-text" data-quran-script-text="ayah" data-quran-ref="<%= commentaryAyahRef %>"><%= ayah.text %></span>
				<button type="button" class="quran-ayah-hero-trigger quran-ayah-end-marker" data-quran-ayah-actions="1" data-quran-ref="<%= commentaryAyahRef %>" data-quran-href="<%= utils.quranUrl(req, `/quran:${commentaryAyahRef}`) %>" aria-haspopup="menu" aria-expanded="false" aria-label="Actions for Quran <%= commentaryAyahRef %>"><%= ayah.marker %></button></span>
			<% }); %>
		</section>
	<% } %>
	<% if (commentary.commentary_is_bilingual) { %>
		<div class="commentary-search-fragment col-md-6 col-sm-12" lang="en"><%- commentary.commentary_fragment_html_en %></div>
		<div class="commentary-search-fragment col-md-6 col-sm-12" lang="ar" dir="rtl"><%- commentary.commentary_fragment_html_ar %></div>
	<% } else if (commentary.search_lang === 'ar' && commentary.commentary_fragment_html_ar) { %>
		<div class="commentary-search-fragment col-12" lang="ar" dir="rtl"><%- commentary.commentary_fragment_html_ar %></div>
	<% } else if (commentary.search_lang === 'en' && commentary.commentary_fragment_html_en) { %>
		<div class="commentary-search-fragment col-12" lang="en"><%- commentary.commentary_fragment_html_en %></div>
	<% } else if (commentary.commentary_fragment_html_en) { %>
		<div class="commentary-search-fragment col-12" lang="en"><%- commentary.commentary_fragment_html_en %></div>
	<% } else { %>
		<div class="commentary-search-fragment col-12" lang="ar" dir="rtl"><%- commentary.commentary_fragment_html_ar %></div>
	<% } %>
	<% if (commentary.commentary_section_url) { %>
		<section class="col-md-6 col-sm-12 h" lang="en">
			<aside class="title">
				§ <a href="<%= utils.quranUrl(req, commentary.commentary_section_url) %>"><%- utils.truncate(commentary.h2_title_en, 30, true) || 'Section' %></a>
				<% if (commentary.commentary_show_surah_en) { %>
					in <span class="quran-revelation-icon quran-revelation-icon-<%= commentarySurahRevelation %> quran-revelation-icon-before" role="img" aria-label="<%= commentarySurahRevelationLabel %>" title="<%= commentarySurahRevelationLabel %>"></span><a href="<%= utils.quranUrl(req, commentary.commentary_surah_url || commentary.commentary_section_url) %>"><%- commentary.commentary_surah_name_en %></a>
				<% } %>
			</aside>
		</section>
		<section class="col-md-6 col-sm-12 h" lang="ar" dir="rtl">
			<aside class="title">
				§ <a href="<%= utils.quranUrl(req, commentary.commentary_section_url) %>"><%- utils.truncate(commentary.h2_title, 30, true) || 'مقطع' %></a>
				<% if (commentary.commentary_show_surah_ar) { %>
					في <a href="<%= utils.quranUrl(req, commentary.commentary_surah_url || commentary.commentary_section_url) %>"><%- commentary.commentary_surah_name_ar %></a>
				<% } %>
			</aside>
		</section>
	<% } else if (commentary.commentary_show_surah_en || commentary.commentary_show_surah_ar) { %>
		<section class="col-md-6 col-sm-12 h" lang="en">
			<aside class="title">
				§ <% if (commentary.commentary_show_surah_en) { %>in <span class="quran-revelation-icon quran-revelation-icon-<%= commentarySurahRevelation %> quran-revelation-icon-before" role="img" aria-label="<%= commentarySurahRevelationLabel %>" title="<%= commentarySurahRevelationLabel %>"></span><a href="<%= utils.quranUrl(req, commentary.commentary_surah_url || commentary.url) %>"><%- commentary.commentary_surah_name_en %></a><% } %>
			</aside>
		</section>
		<section class="col-md-6 col-sm-12 h" lang="ar" dir="rtl">
			<aside class="title">
				§ <% if (commentary.commentary_show_surah_ar) { %>في <a href="<%= utils.quranUrl(req, commentary.commentary_surah_url || commentary.url) %>"><%- commentary.commentary_surah_name_ar %></a><% } %>
			</aside>
		</section>
	<% } %>
</article>
