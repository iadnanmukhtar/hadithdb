<%
	const passageItems = locals.passage || [];
	const firstPassageItem = passageItems[0];
	const passageSurah = firstPassageItem
		? ((firstPassageItem.en?.num || firstPassageItem.num || '').toString().split(/:/)[0])
		: '';
	const passageAyahs = passageItems.map(function (ayah) {
		const num = ayah.en?.num || ayah.num || '';
		return parseInt(arabic.toLatinDigits(num.toString().split(/:/).pop()), 10);
	}).filter(Number.isInteger);
	const passageAyahText = passageItems.reduce(function (ayahs, ayah) {
		const num = ayah.en?.num || ayah.num || '';
		const ayahNum = parseInt(arabic.toLatinDigits(num.toString().split(/:/).pop()), 10);
		if (Number.isInteger(ayahNum))
			ayahs[ayahNum] = ayah.ar?.body || ayah.body || '';
		return ayahs;
	}, {});
	const tafsirSection = locals.section
		? `${locals.section.h1}${locals.section.level > 1 ? `.${locals.section.h2}` : ''}`
		: passageSurah;
	const selectedAyahNums = (locals.selectedAyahs || []).map(function (ayah) {
		const num = ayah.en?.num || ayah.num || '';
		return parseInt(arabic.toLatinDigits(num.toString().split(/:/).pop()), 10);
	}).filter(Number.isInteger);
	const passageSurahInfo = (global.surahs || []).find(function (surah) {
		return Number(surah.num) === Number(passageSurah);
	});
	const passageAyahHeadingNums = selectedAyahNums.length > 0 ? selectedAyahNums : passageAyahs;
	const passageAyahHeadingStart = Math.min.apply(null, passageAyahHeadingNums);
	const passageAyahHeadingEnd = Math.max.apply(null, passageAyahHeadingNums);
	const passageAyahHeadingRange = passageAyahHeadingStart === passageAyahHeadingEnd
		? passageAyahHeadingStart
		: `${passageAyahHeadingStart}-${passageAyahHeadingEnd}`;
	const passageTafsirHeading = passageAyahHeadingNums.length > 0
		? `${passageSurah}:${passageAyahHeadingRange}${passageSurahInfo?.name_en ? ` ${passageSurahInfo.name_en}` : ''}`
		: `Tafsir of Section ${tafsirSection}`;
	const tafsirHeading = locals.tafsirHeading || passageTafsirHeading;
	const tafsirInstance = locals.tafsirInstance || 'passage';
	const selectedTafsirAlias = locals.selectedTafsirAlias || '';
	const selectedTafsirLanguage = locals.selectedTafsirLanguage || '';
	const tafsirSettingsHref = locals.tafsirSettingsHref || '';
	const tafsirTranslationsHref = locals.tafsirTranslationsHref || '';
	const tafsirTranslationsModalIndex = Number.isInteger(locals.tafsirTranslationsModalIndex) ? locals.tafsirTranslationsModalIndex : -1;
%>
<% if (passageSurah && passageAyahs.length > 0) { %>
<article<%- tafsirInstance === 'passage' ? ' id="tafsir"' : '' %> class="quran-tafsirs mt-4" data-tafsir-instance="<%= tafsirInstance %>" data-surah="<%= passageSurah %>" data-ayahs="<%= passageAyahs.join(',') %>" data-selected-ayahs="<%= selectedAyahNums.join(',') %>"<% if (selectedTafsirAlias) { %> data-selected-tafsir="<%= selectedTafsirAlias %>"<% } %><% if (selectedTafsirLanguage) { %> data-selected-tafsir-language="<%= selectedTafsirLanguage %>"<% } %>>
	<script type="application/json" class="quran-tafsir-ayah-data"><%- JSON.stringify(passageAyahText).replace(/</g, '\\u003c') %></script>
	<heading class="quran-tafsir-heading row heading py-2">
		<h2 class="col-12 fs-5 title quran-section-heading-title mb-0" lang="en">
			<span class="quran-section-heading-text"><%= tafsirHeading %></span>
			<span class="quran-section-heading-actions">
				<% if (tafsirTranslationsModalIndex >= 0) { %>
					<button type="button" class="quran-section-heading-action btn btn-sm btn-outline-secondary quran-ayah-modal-trigger" data-quran-ayah-modal-index="<%= tafsirTranslationsModalIndex %>" data-quran-ayah-modal-type="translations" title="View translations" aria-label="View translations">
						<span class="bi bi-translate" aria-hidden="true"></span><span>Translations</span>
					</button>
				<% } else if (tafsirTranslationsHref) { %>
					<a class="quran-section-heading-action btn btn-sm btn-outline-secondary" href="<%= tafsirTranslationsHref %>" title="Open translations page" aria-label="Open translations page">
						<span class="bi bi-translate" aria-hidden="true"></span><span>Translations</span>
					</a>
				<% } %>
				<% if (tafsirSettingsHref) { %>
					<a class="quran-section-heading-action btn btn-sm btn-outline-secondary" href="<%= tafsirSettingsHref %>" title="My Settings" aria-label="My Settings">
						<span class="bi bi-gear" aria-hidden="true"></span>
					</a>
				<% } %>
				<span class="btn-group btn-group-sm quran-tafsir-language-toggle" role="group" aria-label="Tafsir language">
					<button type="button" class="btn btn-outline-secondary" data-tafsir-language="ar"><span class="quran-tafsir-language-label-full">Arabic</span><span class="quran-tafsir-language-label-short" lang="ar" dir="rtl">ع</span></button>
					<button type="button" class="btn btn-outline-secondary active" data-tafsir-language="en"><span class="quran-tafsir-language-label-full">English</span><span class="quran-tafsir-language-label-short">A</span></button>
				</span>
			</span>
		</h2>
	</heading>
	<div class="h-menu-wrap mb-3">
		<div class="h-menu-hint d-md-none">
			<i class="bi bi-arrow-left-right"></i> Swipe to browse tafsirs
		</div>
		<div class="h-menu-scroller">
			<div class="btn-group h-menu quran-tafsir-tabs text-nowrap" role="tablist">
			</div>
		</div>
	</div>
	<div class="tab-content quran-tafsir-content">
	</div>
</article>
<% } %>
