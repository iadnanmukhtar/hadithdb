<%
	var chapter = page.context.chapter;
	var sections = [];
	if (chapter)
		sections = chapter.sections;
	var selectedAyahs = locals.selectedAyahs || (locals.selectedAyah ? [selectedAyah] : []);
	var selectedAyahRefs = new Set(selectedAyahs.map(ayah => ayah.ref));
	var quranSubsections = locals.quranSubsections || [];
	var quranSubsectionsByStart = new Map();
	quranSubsections.forEach(function (heading) {
		var start = (heading.start || '').toString().split(/:/).pop();
		if (!quranSubsectionsByStart.has(start))
			quranSubsectionsByStart.set(start, []);
		quranSubsectionsByStart.get(start).push(heading);
	});
%>

<section class="col-md-6 col-sm-12 h" lang="<%=lang%>">

	<%# Body  .............................................................. %>
	<aside class="chain">
		<p><%= passage[0][lang].chain %></p>
	</aside>
	<section class="body passage<%= lang === 'ar' ? ' quran-hafs' : '' %>">
		<div class="quran-passage-flow">
			<% for (var i in passage) { %>
				<%
					var langData = passage[i][lang] || {};
					var ayahBody = langData.body;
					if (ayahBody === undefined || ayahBody === null || ayahBody === 'undefined')
						continue;
					var ayahNum = langData.num || passage[i].num || '';
					var ayahPart = ayahNum.split(/:/)[1] || ayahNum;
					var ayahPartLatin = arabic.toLatinDigits(ayahPart);
					var ayahPartArabic = arabic.toArabicDigits(ayahPartLatin || ayahPart);
					var ayahRefLatin = arabic.toLatinDigits((passage[i].num || ayahNum || '').toString());
					var ayahRefParts = ayahRefLatin.split(/:/);
					var quranCorpusAttrs = ayahRefParts.length >= 2
						? ` data-quran-ref="${ayahRefParts[0]}:${ayahRefParts[1]}" data-quran-surah="${ayahRefParts[0]}" data-quran-ayah="${ayahRefParts[1]}"`
						: '';
					if (lang === 'ar' && quranCorpusAttrs)
						quranCorpusAttrs += ' data-quran-script-text="ayah"';
					var quranTranslationAttrs = lang === 'en' && ayahRefParts.length >= 2
						? ` data-quran-translation-target="1" data-quran-translation-display="passage" data-quran-surah="${ayahRefParts[0]}" data-quran-ayah="${ayahRefParts[1]}"`
						: '';
					if (quranTranslationAttrs && Object.prototype.hasOwnProperty.call(req, 'quranServerRenderedTranslationAlias'))
						quranTranslationAttrs += ` data-quran-translation-server-rendered="1" data-quran-fixed-translation-alias="${req.quranServerRenderedTranslationAlias}"`;
					var isPrefatoryAyah = arabic.toLatinDigits(ayahNum) === '1:0';
					var ayahHref = utils.quranUrl(req, `/${passage[i].ref}`);
					var ayahBodyMarkdown = utils.emptyIfNull(ayahBody);
					var ayahBodyHtml = utils.markdownToHtml(ayahBodyMarkdown);
					var ayahBodyProp = (lang === 'en') ? 'hadith.body_en' : 'hadith.body';
					var ayahMarkerAttrs = ` data-quran-ayah-actions="1" data-quran-ref="${ayahRefLatin}" data-quran-href="${ayahHref}" aria-haspopup="menu" aria-expanded="false"`;
					var ayahActionsChevron = `<button type="button" class="quran-ayah-state-toggle quran-mushaf-ayah-actions-toggle" data-quran-ayah-actions="1" data-quran-ref="${ayahRefLatin}" data-quran-href="${ayahHref}" aria-haspopup="menu" aria-expanded="false" aria-controls="quran-mushaf-ayah-actions" aria-label="Play or study Quran ${ayahRefLatin}"><span class="bi bi-chevron-down" aria-hidden="true"></span></button>`;
				%>
				<span class="ayah<%= selectedAyahRefs.has(passage[i].ref) ? ' ayah-selected' : '' %><%= isPrefatoryAyah ? ' quran-prefatory-ayah' : '' %>" data-quran-ref="<%= ayahRefLatin %>" data-quran-href="<%= ayahHref %>">
					<% if (site.editMode) { %>
						<% if (lang === 'en') { %><span class="quran-mushaf-ayah-marker-state-wrap"><button type="button" class="quran-ayah-hero-trigger quran-ayah-number-marker"<%- ayahMarkerAttrs %> data-ayah-number="<%= ayahPart %>" aria-label="Actions for Quran <%= ayahNum %>"><sup><%= (i == 0) ? ayahNum : ayahPart %></sup></button><%- ayahActionsChevron %></span>&nbsp;<% } %><span class="_e quran-ayah-body"<%- lang === 'en' ? quranTranslationAttrs : quranCorpusAttrs %> data-id="<%= passage[i].id %>" data-prop="<%= ayahBodyProp %>" data-arabizi="<%= lang === 'en' ? 'true' : '' %>" data-markdown-source="<%= ayahBodyMarkdown %>" data-markdown-empty-html="&hellip;"><%- ayahBodyHtml %></span><% if (lang === 'ar') { %>&nbsp;<span class="quran-mushaf-ayah-marker-state-wrap"><button type="button" class="quran-ayah-hero-trigger quran-ayah-end-marker"<%- ayahMarkerAttrs %> data-ayah-number="<%= ayahPart %>" aria-label="Actions for Quran <%= ayahNum %>">۝<%= ayahPartArabic %></button><%- ayahActionsChevron %></span><% } %>
					<% } else { %>
						<% if (lang === 'en') { %><span class="quran-mushaf-ayah-marker-state-wrap"><button type="button" class="quran-ayah-hero-trigger quran-ayah-number-marker"<%- ayahMarkerAttrs %> data-ayah-number="<%= ayahPart %>" aria-label="Actions for Quran <%= ayahNum %>"><sup><%= (i == 0) ? ayahNum : ayahPart %></sup></button><%- ayahActionsChevron %></span>&nbsp;<% } %><span class="quran-ayah-body"<%- lang === 'en' ? quranTranslationAttrs : quranCorpusAttrs %>><%- ayahBodyHtml %></span><% if (lang === 'ar') { %>&nbsp;<span class="quran-mushaf-ayah-marker-state-wrap"><button type="button" class="quran-ayah-hero-trigger quran-ayah-end-marker"<%- ayahMarkerAttrs %> data-ayah-number="<%= ayahPart %>" aria-label="Actions for Quran <%= ayahNum %>">۝<%= ayahPartArabic %></button><%- ayahActionsChevron %></span><% } %>
					<% } %>
				</span>
			<% } %>
		</div>
	</section>

</section>
