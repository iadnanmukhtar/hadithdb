<%
	var chapter = page.context.chapter;
	var sections = [];
	if (chapter)
		sections = chapter.sections;
	var selectedAyahs = locals.selectedAyahs || (locals.selectedAyah ? [selectedAyah] : []);
	var selectedAyahRefs = new Set(selectedAyahs.map(ayah => ayah.ref));
	var quranSelectedTranslationAlias = /^[A-Za-z0-9_-]+$/.test((req.query.translation || '').toString().trim())
		? req.query.translation.toString().trim()
		: '';
	var quranPassageHref = function (path) {
		var href = utils.quranUrl(req, path);
		if (!quranSelectedTranslationAlias)
			return href;
		return `${href}${href.indexOf('?') >= 0 ? '&' : '?'}translation=${encodeURIComponent(quranSelectedTranslationAlias)}`;
	};
	var quranSubsections = locals.quranSubsections || [];
	var quranSubsectionsByStart = new Map();
	quranSubsections.forEach(function (heading) {
		var start = (heading.start || '').toString().split(/:/).pop();
		if (!quranSubsectionsByStart.has(start))
			quranSubsectionsByStart.set(start, []);
		quranSubsectionsByStart.get(start).push(heading);
	});
%>

<section class="col-md-6 col-sm-12 h" lang="<%=lang%>">

	<%# Body  .............................................................. %>
	<aside class="chain">
		<p><%= passage[0][lang].chain %></p>
	</aside>
	<section class="body passage<%= lang === 'ar' ? ' quran-hafs' : '' %>">
		<div class="quran-passage-flow">
			<% for (var i in passage) { %>
				<%
					var langData = passage[i][lang] || {};
					var ayahBody = langData.body;
					if (ayahBody === undefined || ayahBody === null || ayahBody === 'undefined')
						continue;
					var ayahNum = langData.num || passage[i].num || '';
					var ayahPart = ayahNum.split(/:/)[1] || ayahNum;
					var ayahPartLatin = arabic.toLatinDigits(ayahPart);
					var ayahPartArabic = arabic.toArabicDigits(ayahPartLatin || ayahPart);
					var ayahRefLatin = arabic.toLatinDigits((passage[i].num || ayahNum || '').toString());
					var ayahRefParts = ayahRefLatin.split(/:/);
					var quranCorpusAttrs = ayahRefParts.length >= 2
						? ` data-quran-ref="${ayahRefParts[0]}:${ayahRefParts[1]}" data-quran-surah="${ayahRefParts[0]}" data-quran-ayah="${ayahRefParts[1]}"`
						: '';
					var quranTranslationAttrs = lang === 'en' && ayahRefParts.length >= 2
						? ` data-quran-translation-target="1" data-quran-translation-display="passage" data-quran-surah="${ayahRefParts[0]}" data-quran-ayah="${ayahRefParts[1]}"`
						: '';
					var isPrefatoryAyah = arabic.toLatinDigits(ayahNum) === '1:0';
					var ayahHref = quranPassageHref(`/${passage[i].ref}`);
					var ayahBodyMarkdown = utils.emptyIfNull(ayahBody);
					var ayahBodyHtml = utils.markdownToHtml(ayahBodyMarkdown);
					var ayahBodyProp = (lang === 'en') ? 'hadith.body_en' : 'hadith.body';
					var ayahHoverLabelRef = arabic.toLatinDigits((ayahNum || '').toString());
					var ayahMarkerAttrs = ` data-quran-href="${ayahHref}" data-quran-ayah-hover-label="Study ${ayahHoverLabelRef}" title="Study ${ayahHoverLabelRef}"`;
				%>
				<% (quranSubsectionsByStart.get(ayahPartLatin) || []).forEach(function (heading) {
					var subsectionTitle = (lang === 'ar') ? heading.title : heading.title_en;
					var subsectionProp = (lang === 'ar') ? 'toc.title' : 'toc.title_en';
					var subsectionFallback = (lang === 'ar') ? 'مقطع' : 'Subsection';
					var hasSubsectionTitle = typeof subsectionTitle === 'string'
						? subsectionTitle.trim().length > 0
						: subsectionTitle !== undefined && subsectionTitle !== null;
					var subsectionStart = (heading.start || '').toString().split(/:/).pop();
					var subsectionCount = parseInt(heading.count, 10);
					var subsectionEnd = parseInt(subsectionStart || '0', 10) + (Number.isInteger(subsectionCount) ? subsectionCount : 1) - 1;
				%>
					<% if (lang !== 'ar' || hasSubsectionTitle) { %>
					<span<%- lang === 'en' ? ` id="S${heading.h2}-${heading.h3}"` : '' %> class="quran-subheading" lang="<%= lang %>">
						<span class="_e" data-id="<%= heading.id %>" data-prop="<%= subsectionProp %>" data-arabizi="<%= lang === 'en' ? 'true' : '' %>"><%- subsectionTitle || subsectionFallback %></span>
						<% if (site.editMode && lang === 'en') { %>
							<span class="quran-subheading-controls" data-subsection-id="<%= heading.id %>">
								<input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm quran-subsection-range-start" value="<%= subsectionStart %>" title="Subsection start ayah">
								<input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm quran-subsection-range-end" value="<%= subsectionEnd %>" title="Subsection end ayah">
								<button type="button" class="btn btn-sm btn-outline-primary quran-subsection-range-save" title="Save subsection range">
									<span class="bi bi-save"></span>
								</button>
								<button type="button" class="btn btn-sm btn-outline-primary quran-subsection-promote" title="Make this subsection and the remaining ayat a new section">
									<span class="bi bi-arrow-up-square"></span>
								</button>
								<% if (heading.hasNextQuranSubsection) { %>
									<button type="button" class="btn btn-sm btn-outline-primary quran-subsection-merge" title="Merge with next subsection and retitle">
										<span class="bi bi-intersect"></span>
									</button>
								<% } %>
								<button type="button" class="btn btn-sm btn-outline-danger quran-subsection-delete" title="Remove subsection division">
									<span class="bi bi-x-circle"></span>
								</button>
							</span>
						<% } %>
					</span>
					<% } %>
				<% }); %>
				<span class="ayah<%= selectedAyahRefs.has(passage[i].ref) ? ' ayah-selected' : '' %><%= isPrefatoryAyah ? ' quran-prefatory-ayah' : '' %>" data-quran-ref="<%= ayahRefLatin %>" data-quran-href="<%= ayahHref %>">
					<% if (site.editMode) { %>
						<% if (lang === 'en') { %><button type="button" class="quran-ayah-hero-trigger quran-ayah-number-marker"<%- ayahMarkerAttrs %> data-ayah-number="<%= ayahPart %>" aria-label="Study Quran <%= ayahNum %>"><sup><%= (i == 0) ? ayahNum : ayahPart %></sup></button>&nbsp;<% } %><span class="_e quran-ayah-body"<%- lang === 'en' ? quranTranslationAttrs : quranCorpusAttrs %> data-id="<%= passage[i].id %>" data-prop="<%= ayahBodyProp %>" data-arabizi="<%= lang === 'en' ? 'true' : '' %>" data-markdown-source="<%= ayahBodyMarkdown %>" data-markdown-empty-html="&hellip;"><%- ayahBodyHtml %></span><% if (lang === 'ar') { %>&nbsp;<button type="button" class="quran-ayah-hero-trigger quran-ayah-end-marker"<%- ayahMarkerAttrs %> data-ayah-number="<%= ayahPart %>" aria-label="Study Quran <%= ayahNum %>">۝<%= ayahPartArabic %></button><% } %>
					<% } else { %>
						<% if (lang === 'en') { %><button type="button" class="quran-ayah-hero-trigger quran-ayah-number-marker"<%- ayahMarkerAttrs %> data-ayah-number="<%= ayahPart %>" aria-label="Study Quran <%= ayahNum %>"><sup><%= (i == 0) ? ayahNum : ayahPart %></sup></button>&nbsp;<% } %><span class="quran-ayah-body"<%- lang === 'en' ? quranTranslationAttrs : quranCorpusAttrs %>><%- ayahBodyHtml %></span><% if (lang === 'ar') { %>&nbsp;<button type="button" class="quran-ayah-hero-trigger quran-ayah-end-marker"<%- ayahMarkerAttrs %> data-ayah-number="<%= ayahPart %>" aria-label="Study Quran <%= ayahNum %>">۝<%= ayahPartArabic %></button><% } %>
					<% } %>
				</span>
			<% } %>
		</div>
	</section>

</section>
