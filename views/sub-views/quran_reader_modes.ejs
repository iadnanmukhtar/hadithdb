<%
  var modePassageHref = locals.passageHref || utils.quranUrl(req, req.path);
  var modeMushafHref = locals.mushafHref || utils.quranUrl(req, '/quran/page');
  var modeTafsirHref = locals.tafsirHref || utils.urlFor(req, '/books?tafsir');
  var modeMemorizeHref = locals.memorizeHref || `${modeMushafHref}${modeMushafHref.indexOf('?') >= 0 ? '&' : '?'}memorize`;
  var modeReviewHref = utils.quranUrl(req, '/quran/review');
%>
<span class="quran-reader-modes ux-view-selector" role="group" aria-label="Quran reading mode">
  <span class="quran-script-switcher dropdown" data-quran-script-switcher>
    <button type="button" class="ux-view-option dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Choose Quran script">
      <i class="bi bi-fonts" aria-hidden="true"></i><span data-quran-script-label>Script</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-start">
      <li><button type="button" class="dropdown-item" data-quran-script-choice="uthmani">Uthmani</button></li>
      <li><button type="button" class="dropdown-item" data-quran-script-choice="indo-pak">Indo-Pak</button></li>
      <li><button type="button" class="dropdown-item" data-quran-script-choice="warsh">Warsh</button></li>
    </ul>
  </span>
  <% const modes = [
    ['passage', 'Study', 'text-paragraph', modePassageHref],
    ['tafsir', 'Tafsir', 'book-half', modeTafsirHref],
    ['mushaf', 'Mushaf', 'book', modeMushafHref],
    ['memorize', 'Practice', 'eye-slash', modeMemorizeHref],
    ['review', 'Mudhakkir', 'arrow-repeat', modeReviewHref]
  ]; %>
  <% const selectedMode = readerMode === 'translations' ? 'passage' : readerMode; %>
  <% for (const [key, label, icon, href] of modes) { %>
    <a class="ux-view-option" href="<%= href %>" data-quran-reader-mode-link="<%= key %>"<% if (selectedMode === key) { %> aria-current="page"<% } %>><i class="bi bi-<%= icon %>" aria-hidden="true"></i><span><%= label %></span></a>
  <% } %>
  <select class="quran-mode-picker ux-view-option" aria-label="Quran reading mode" hidden>
    <% if (!modes.some(([key]) => key === selectedMode)) { %><option value="" selected disabled>Mode</option><% } %>
    <% for (const [key, label] of modes) { %><option value="<%= key %>"<% if (selectedMode === key) { %> selected<% } %>><%= label %></option><% } %>
  </select>
</span>
