<%
  var modePassageHref = locals.passageHref || utils.quranUrl(req, req.path);
  var modeMushafHref = locals.mushafHref || utils.quranUrl(req, '/quran/page');
  var modeTafsirHref = locals.tafsirHref || utils.quranUrl(req, '/quran/tafsir');
  var modeMemorizeHref = locals.memorizeHref || `${modeMushafHref}${modeMushafHref.indexOf('?') >= 0 ? '&' : '?'}memorize`;
  var modeReviewHref = locals.reviewHref || utils.quranUrl(req, '/quran/review');
  var commentaryReaderMode = ['translation', 'trans'].indexOf(locals.readerMode) >= 0;
%>
<span class="quran-reader-modes btn-group btn-group-sm" role="group" aria-label="Quran reading mode">
  <% if (commentaryReaderMode) { %>
  <a class="btn btn-outline-secondary<%= locals.readerMode === 'passage' ? ' active' : '' %>" data-quran-reader-mode-link="passage" href="<%= modePassageHref %>" title="Study"<% if (locals.readerMode === 'passage') { %> aria-current="page"<% } %>><i class="bi bi-text-paragraph" aria-hidden="true"></i><span>Study</span></a>
  <a class="btn btn-outline-secondary<%= locals.readerMode === 'tafsir' ? ' active' : '' %>" data-quran-reader-mode-link="tafsir" href="<%= modeTafsirHref %>" title="Tafsir"<% if (locals.readerMode === 'tafsir') { %> aria-current="page"<% } %>><i class="bi bi-book-half" aria-hidden="true"></i><span>Tafsir</span></a>
  <a class="btn btn-outline-secondary<%= locals.readerMode === 'mushaf' ? ' active' : '' %>" data-quran-reader-mode-link="mushaf" href="<%= modeMushafHref %>" title="Mushaf view"<% if (locals.readerMode === 'mushaf') { %> aria-current="page"<% } %>><i class="bi bi-book" aria-hidden="true"></i><span>Mushaf</span></a>
  <% } else { %>
  <span class="quran-script-switcher btn-group" data-quran-script-switcher>
    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Quran script" aria-label="Choose Quran script">
      <i class="bi bi-fonts" aria-hidden="true"></i><span class="quran-script-label-long" data-quran-script-label>Script</span><span class="quran-script-label-short" data-quran-script-short-label aria-hidden="true">Scr</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-start">
      <li><button type="button" class="dropdown-item" data-quran-script-choice="uthmani">Uthmani</button></li>
      <li><button type="button" class="dropdown-item" data-quran-script-choice="indo-pak">Indo-Pak</button></li>
      <li><button type="button" class="dropdown-item" data-quran-script-choice="warsh">Warsh</button></li>
    </ul>
  </span>
  <a class="btn btn-outline-secondary<%= locals.readerMode === 'passage' ? ' active' : '' %>" data-quran-reader-mode-link="passage" href="<%= modePassageHref %>" title="Study"<% if (locals.readerMode === 'passage') { %> aria-current="page"<% } %>><i class="bi bi-text-paragraph" aria-hidden="true"></i><span>Study</span></a>
  <a class="btn btn-outline-secondary<%= locals.readerMode === 'tafsir' ? ' active' : '' %>" data-quran-reader-mode-link="tafsir" href="<%= modeTafsirHref %>" title="Tafsir"<% if (locals.readerMode === 'tafsir') { %> aria-current="page"<% } %>><i class="bi bi-book-half" aria-hidden="true"></i><span>Tafsir</span></a>
  <a class="btn btn-outline-secondary<%= locals.readerMode === 'mushaf' ? ' active' : '' %>" data-quran-reader-mode-link="mushaf" href="<%= modeMushafHref %>" title="Mushaf view"<% if (locals.readerMode === 'mushaf') { %> aria-current="page"<% } %>><i class="bi bi-book" aria-hidden="true"></i><span>Mushaf</span></a>
  <a class="btn btn-outline-secondary<%= locals.readerMode === 'memorize' ? ' active' : '' %>" data-quran-reader-mode-link="memorize" href="<%= modeMemorizeHref %>" title="Practice view"<% if (locals.readerMode === 'memorize') { %> aria-current="page"<% } %>><i class="bi bi-eye-slash" aria-hidden="true"></i><span>Practice</span></a>
  <a class="btn btn-outline-success<%= locals.readerMode === 'review' ? ' active' : '' %>" data-quran-reader-mode-link="review" href="<%= modeReviewHref %>" title="Mudhakkir test review"<% if (locals.readerMode === 'review') { %> aria-current="page"<% } %>><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span>Mudhakkir</span></a>
  <% } %>
</span>
