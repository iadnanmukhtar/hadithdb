<%
  var modePassageHref = locals.passageHref || utils.quranUrl(req, req.path);
  var modeAyahHref = locals.ayahHref || `${utils.quranUrl(req, req.path)}?ayat`;
  var modeMushafHref = locals.mushafHref || `${utils.quranUrl(req, req.path)}?mushaf`;
%>
<span class="quran-reader-modes btn-group btn-group-sm" role="group" aria-label="Quran reading mode">
  <a class="btn btn-outline-secondary<%= locals.readerMode === 'passage' ? ' active' : '' %>" href="<%= modePassageHref %>" title="Passage view"<% if (locals.readerMode === 'passage') { %> aria-current="page"<% } %>><i class="bi bi-text-paragraph" aria-hidden="true"></i><span>Passage</span></a>
  <a class="btn btn-outline-secondary<%= locals.readerMode === 'ayah' ? ' active' : '' %>" href="<%= modeAyahHref %>" title="Ayah view"<% if (locals.readerMode === 'ayah') { %> aria-current="page"<% } %>><i class="bi bi-record-circle" aria-hidden="true"></i><span>Ayah</span></a>
  <a class="btn btn-outline-secondary<%= locals.readerMode === 'mushaf' ? ' active' : '' %>" href="<%= modeMushafHref %>" title="Mushaf view"<% if (locals.readerMode === 'mushaf') { %> aria-current="page"<% } %>><i class="bi bi-book" aria-hidden="true"></i><span>Mushaf</span></a>
</span>
