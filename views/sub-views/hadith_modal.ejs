<%
	const en = i.en || {};
	const ar = i.ar || {};
	const enActual = en.actual || {};
	const enChain = utils.emptyIfNull(en.chain);
	const enNarrators = enChain.split(/(>|&gt;)/).filter(part => !part.match(/^(>|&gt;)$/) && utils.emptyIfNull(part) !== '');
	const enNarrator = enNarrators.length > 0 ? utils.emptyIfNull(enNarrators[enNarrators.length - 1]).trim() : '';
	const arNarrator = enNarrator ? arabic.toArabic(enNarrator) : '';
	const shareRef = i.ref || `${i.actual ? i.actual.book_alias : i.book_alias}:${i.actual ? en.actual?.num || i.actual?.num || i.num : en.num || i.num}`;
	const paymentFeatureEnabled = locals.paymentFeatureEnabled === true;
	const shareContentTranslations = Array.isArray(i.contentTranslations) ? i.contentTranslations : [];
%>
<aside class="h modal fade hadith-share-root" id="H<%= i.id %>" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable modal-xl hadith-share-dialog">
    <div class="modal-content hadith-share-modal">
      <header class="modal-header hadith-share-toolbar">
		<div class="hadith-share-actions">
			<div class="hadith-share-tool-group">
				<button type="button" class="btn btn-sm btn-outline-secondary hadith-share-edit" title="Edit text" aria-label="Edit text" aria-pressed="false">
					<span class="bi bi-pencil"></span>
				</button>
			</div>
			<div class="hadith-share-control-group">
				<% if (paymentFeatureEnabled) { %>
				<div class="dropdown hadith-share-language-control" title="Share languages">
					<button class="btn btn-sm btn-outline-secondary dropdown-toggle hadith-share-language-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" data-share-language-toggle-button="1">
						Translations
					</button>
					<div class="dropdown-menu dropdown-menu-end hadith-share-language-menu" data-share-language-menu="1" aria-label="Share languages"></div>
				</div>
				<% } %>
				<div class="hadith-share-size-controls" aria-label="Share image font sizes">
					<label title="Arabic text size">
						<span>Arabic</span>
						<input class="form-range hadith-share-size" type="range" min="0" max="130" step="5" value="100" data-share-size-var="--share-arabic-tune" data-share-size-disable-target="arabic">
					</label>
					<label title="Translation text size">
						<span>Translation</span>
						<input class="form-range hadith-share-size" type="range" min="0" max="130" step="5" value="100" data-share-size-var="--share-translation-tune" data-share-size-disable-target="translation">
					</label>
				</div>
			</div>
			<div class="hadith-share-tool-group">
				<button type="button" class="btn btn-sm btn-outline-secondary hadith-share-copy-text" title="Copy text" aria-label="Copy text">
					<span class="bi bi-card-text"></span>
				</button>
				<button type="button" class="btn btn-sm btn-outline-secondary hadith-share-copy" title="Copy image" aria-label="Copy image">
					<span class="bi bi-clipboard"></span>
				</button>
				<button type="button" class="btn btn-sm btn-outline-secondary hadith-share-native" title="Share image" aria-label="Share image">
					<span class="bi bi-share"></span>
				</button>
			</div>
		</div>
		<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
	  </header>
      <section class="modal-body hadith-share-body">
		<article class="hadith-share-card" data-share-card data-share-ref="<%= shareRef %>"<% if (paymentFeatureEnabled) { %> data-share-generated-item-type="hadith" data-share-generated-item-id="<%= i.actual ? i.actual.id : i.id %>" data-share-available-translations="<%= JSON.stringify(shareContentTranslations) %>"<% } %>>
			<div class="hadith-share-card-inner">
				<% if (en.title || ar.title) { %>
					<h2 class="hadith-share-title share-editable" contenteditable="false" data-share-generated-title="1"><%= en.title %></h2>
				<% } %>
				<% if (ar.body) { %>
					<section class="hadith-share-section hadith-share-arabic-section" lang="ar">
						<div class="hadith-share-ref share-editable" contenteditable="false" data-share-ref-editor="1">
							<%= ar.book_shortName || i.book_shortName || '' %> <%= ar.num || i.num || '' %>:
							<% if (i.remark === 0 && arNarrator) { %>
								عن <span><%= arNarrator %></span> —
							<% } %>
						</div>
						<div class="body hadith-share-text share-editable" lang="ar" contenteditable="false" data-markdown-source="<%= utils.emptyIfNull(ar.body) %>">
							<%- utils.markdownToHtml(ar.body) %>
						</div>
					</section>
				<% } %>
				<% if (en.body || ar.body) { %>
					<section class="hadith-share-section hadith-share-translation-section" lang="en" data-share-copy-section="translation">
						<div class="hadith-share-ref share-editable" contenteditable="false" data-share-ref-editor="1">
							<% if (i.book_virtual) { %>
								<%= String(enActual.book_shortName || i.book_shortName_en || '').toUpperCase() %> <%= en.num || i.num || '' %>:
							<% } else { %>
								<%= String(en.book_shortName || i.book_shortName_en || '').toUpperCase() %> <%= en.num || i.num || '' %>:
							<% } %>
							<% if (i.remark === 0 && enNarrator) { %>
								from <em><%= enNarrator %></em> —
							<% } %>
						</div>
						<div class="body hadith-share-text share-editable" lang="en" contenteditable="false" data-share-generated-body="1" data-markdown-source="<%= utils.emptyIfNull(en.body) %>">
							<%- utils.markdownToHtml(en.body) %>
						</div>
					</section>
				<% } %>
				<footer class="hadith-share-footer">
					<div>
						<% if (i.remark === 0) { %>
							<div class="grade share-editable" contenteditable="false">
								<span><%= en.grade_grade || '' %></span>&nbsp;(<span title="<%= en.grader_name || '' %>"><%= en.grader_shortName || '' %></span>)
							</div>
						<% } %>
						<div class="title share-editable" contenteditable="false">
							<%= i.book_shortName_en || '' %>
							<% if (i.chapter) { %>
							&gt;
							<%- utils.truncate(en.h1_title, 60, true) || 'Chapter' %>
							<% } %>
							<% if (i.section) { %>
								&gt;
								§&nbsp;<%- utils.truncate(en.h2_title, 60, true) || 'Section' %>
							<% } %>
						</div>
					</div>
					<div class="hadith-share-brand" style="display:flex;align-items:center;justify-content:space-between;gap:9px;width:100%;min-width:0;">
						<div class="hadith-share-site share-editable" contenteditable="false" data-share-site-editor="1">
							hadithunlocked.com
						</div>
						<div class="hadith-share-logo" data-share-logo style="position:relative;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;width:34px;height:34px;max-width:34px;max-height:34px;">
							<img src="/images/logo2.svg" width="34" height="34" alt="Hadith Unlocked" loading="lazy" style="display:block;width:34px;height:34px;max-width:34px;max-height:34px;object-fit:contain;">
							<button type="button" class="hadith-share-logo-remove" aria-label="Remove logo" title="Remove logo" hidden style="display:none;position:absolute;top:-8px;right:-8px;width:20px;height:20px;padding:0;border:1px solid #cfc7bc;border-radius:999px;background:#fff;color:#333;line-height:1;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,.16);">
								<span class="bi bi-x"></span>
							</button>
						</div>
					</div>
				</footer>
			</div>
		</article>
	  </section>
    </div>
  </div>
</aside>
