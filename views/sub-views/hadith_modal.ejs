<%
	const en = i.en || {};
	const ar = i.ar || {};
	const enActual = en.actual || {};
	const enChain = utils.emptyIfNull(en.chain);
	const enNarrators = enChain.split(/(>|&gt;)/).filter(part => !part.match(/^(>|&gt;)$/) && utils.emptyIfNull(part) !== '');
	const enNarrator = enNarrators.length > 0 ? utils.emptyIfNull(enNarrators[enNarrators.length - 1]).trim() : '';
	const arNarrator = enNarrator ? arabic.toArabic(enNarrator) : '';
%>
<aside class="h modal fade" id="H<%= i.id %>" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <header class="modal-header">
		<h1 class="modal-title fs-5" contenteditable="true"><%= en.title || '' %></h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
	  </header>
      <section class="modal-body">
		<% if (en.body) { %>
        <p>
			<div class="text-muted">
				<% if (i.book_virtual) { %>
					<%= String(enActual.book_shortName || i.book_shortName_en || '').toUpperCase() %> <%= en.num || i.num || '' %>:
				<% } else { %>
					<%= String(en.book_shortName || i.book_shortName_en || '').toUpperCase() %> <%= en.num || i.num || '' %>:
				<% } %>
				<% if (i.remark === 0 && enNarrator) { %>
					from <em contenteditable="true"><%= enNarrator %></em> —
				<% } %>
			</div>
			<div class="body" lang="en" contenteditable="true">
				<%- utils.markdownToHtml(en.body) %>
			</div>
		</p>
		<% } %>
        <p class="mt-2">
			<div class="text-muted" lang="ar">
				<%= ar.book_shortName || i.book_shortName || '' %> <%= ar.num || i.num || '' %>:
				<% if (i.remark === 0 && arNarrator) { %>
					عن <span contenteditable="true"><%= arNarrator %></span> —
				<% } %>
			</div>
			<div class="body" lang="ar" contenteditable="true">
				<%- utils.markdownToHtml(ar.body) %>
			</div>
		</p>
		<div class="text-muted">
			<small>hadithunlocked.com</small>
		</div>
	  </section>
      <footer class="modal-footer hanging-indent">
		<% if (i.remark === 0) { %>
			<div class="grade">
				<span contenteditable="true"><%= en.grade_grade || '' %></span>&nbsp;(<span title="<%= en.grader_name || '' %>" contenteditable="true"><%= en.grader_shortName || '' %></span>)
			</div>
		<% } %>
		<div class="title" contenteditable="true">
			<%= i.book_shortName_en || '' %>
			<% if (i.chapter) { %>
				&gt;
				<%- utils.truncate(en.h1_title, 60, true) || 'Chapter' %>
			<% } %>
			<% if (i.section) { %>
				&gt;
				§&nbsp;<%- utils.truncate(en.h2_title, 60, true) || 'Section' %>
			<% } %>
		</div>
	  </footer>
    </div>
  </div>
</aside>
