<%
	const en = i.en || {};
	const ar = i.ar || {};
	const enActual = en.actual || {};
	const enChain = utils.emptyIfNull(en.chain);
	const enNarrators = enChain.split(/(>|&gt;)/).filter(part => !part.match(/^(>|&gt;)$/) && utils.emptyIfNull(part) !== '');
	const enNarrator = enNarrators.length > 0 ? utils.emptyIfNull(enNarrators[enNarrators.length - 1]).trim() : '';
	const arNarrator = enNarrator ? arabic.toArabic(enNarrator) : '';
	const shareRef = i.ref || `${i.actual ? i.actual.book_alias : i.book_alias}:${i.actual ? en.actual?.num || i.actual?.num || i.num : en.num || i.num}`;
%>
<aside class="h modal fade hadith-share-root" id="H<%= i.id %>" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable modal-xl hadith-share-dialog">
    <div class="modal-content hadith-share-modal">
      <header class="modal-header hadith-share-toolbar">
		<div class="hadith-share-actions">
			<div class="hadith-share-tool-group">
				<button type="button" class="btn btn-sm btn-outline-secondary hadith-share-edit" title="Edit text" aria-label="Edit text" aria-pressed="false">
					<span class="bi bi-pencil"></span>
				</button>
			</div>
			<div class="hadith-share-control-group">
				<div class="form-check form-switch hadith-share-arabic-toggle" title="Show Arabic">
					<input class="form-check-input hadith-share-arabic" type="checkbox" role="switch" id="H<%= i.id %>-arabic" checked>
					<label class="form-check-label" for="H<%= i.id %>-arabic">Arabic</label>
				</div>
				<div class="hadith-share-size-controls" aria-label="Share image font sizes">
					<label title="English text size">
						<span>English</span>
						<input class="form-range hadith-share-size" type="range" min="70" max="130" step="5" value="100" data-share-size-var="--share-english-tune">
					</label>
					<label title="Arabic text size">
						<span>Arabic</span>
						<input class="form-range hadith-share-size" type="range" min="70" max="130" step="5" value="100" data-share-size-var="--share-arabic-tune">
					</label>
				</div>
			</div>
			<div class="hadith-share-tool-group">
				<button type="button" class="btn btn-sm btn-outline-secondary hadith-share-copy" title="Copy image" aria-label="Copy image">
					<span class="bi bi-clipboard"></span>
				</button>
				<button type="button" class="btn btn-sm btn-outline-secondary hadith-share-native" title="Share image" aria-label="Share image">
					<span class="bi bi-share"></span>
				</button>
			</div>
		</div>
		<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
	  </header>
      <section class="modal-body hadith-share-body">
		<article class="hadith-share-card" data-share-card data-share-ref="<%= shareRef %>">
			<div class="hadith-share-card-inner">
				<% if (en.title) { %>
					<h2 class="hadith-share-title share-editable" contenteditable="false"><%= en.title %></h2>
				<% } %>
				<% if (en.body) { %>
					<section class="hadith-share-section" lang="en">
						<div class="hadith-share-ref">
							<% if (i.book_virtual) { %>
								<%= String(enActual.book_shortName || i.book_shortName_en || '').toUpperCase() %> <%= en.num || i.num || '' %>:
							<% } else { %>
								<%= String(en.book_shortName || i.book_shortName_en || '').toUpperCase() %> <%= en.num || i.num || '' %>:
							<% } %>
							<% if (i.remark === 0 && enNarrator) { %>
								from <em class="share-editable" contenteditable="false"><%= enNarrator %></em> —
							<% } %>
						</div>
						<div class="body hadith-share-text share-editable" lang="en" contenteditable="false" data-markdown-source="<%= utils.emptyIfNull(en.body) %>">
							<%- utils.markdownToHtml(en.body) %>
						</div>
					</section>
				<% } %>
				<% if (ar.body) { %>
					<section class="hadith-share-section hadith-share-arabic-section" lang="ar">
						<div class="hadith-share-ref">
							<%= ar.book_shortName || i.book_shortName || '' %> <%= ar.num || i.num || '' %>:
							<% if (i.remark === 0 && arNarrator) { %>
								عن <span class="share-editable" contenteditable="false"><%= arNarrator %></span> —
							<% } %>
						</div>
						<div class="body hadith-share-text share-editable" lang="ar" contenteditable="false" data-markdown-source="<%= utils.emptyIfNull(ar.body) %>">
							<%- utils.markdownToHtml(ar.body) %>
						</div>
					</section>
				<% } %>
				<footer class="hadith-share-footer">
					<div>
						<% if (i.remark === 0) { %>
							<div class="grade">
								<span class="share-editable" contenteditable="false"><%= en.grade_grade || '' %></span>&nbsp;(<span title="<%= en.grader_name || '' %>" class="share-editable" contenteditable="false"><%= en.grader_shortName || '' %></span>)
							</div>
						<% } %>
						<div class="title share-editable" contenteditable="false">
							<%= i.book_shortName_en || '' %>
							<% if (i.chapter) { %>
								&gt;
								<%- utils.truncate(en.h1_title, 60, true) || 'Chapter' %>
							<% } %>
							<% if (i.section) { %>
								&gt;
								§&nbsp;<%- utils.truncate(en.h2_title, 60, true) || 'Section' %>
							<% } %>
						</div>
					</div>
					<div class="hadith-share-site">
						hadithunlocked.com
					</div>
				</footer>
			</div>
		</article>
	  </section>
    </div>
  </div>
</aside>
