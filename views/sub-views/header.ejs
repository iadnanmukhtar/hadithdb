    var isQuranReviewArea = requestPath === '/quran/review' || (isQuranMushafArea && (req.query.review !== undefined || req.query.reviewRef !== undefined));
    var isQuranMemorizeArea = isQuranMushafArea && (req.query.memorize !== undefined || isQuranReviewArea);
    var isMudhakkirArea = isQuranReviewArea || isQuranMemorizeArea;
    var isQuranStudyArea = /^\/quran\/\d+(?:\/|$)/.test(requestPath);
