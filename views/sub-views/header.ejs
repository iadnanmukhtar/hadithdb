    var quranSearchReturnMode = isQuranMushafArea || isQuranReviewArea ? 'mushaf' : (isQuranStudyArea ? 'study' : requestedQuranSearchReturnMode);
    var isBooksArea = !isQuranArea && (requestPath === '/books' || requestPath.indexOf('/books/') === 0);
    var isBlogArea = requestPath === '/blog' || requestPath.indexOf('/blog/') === 0 || pageMenu === 'Blog';
