    var isCommentedArea = requestPath === '/commented' || requestPath.indexOf('/commented/') === 0;
    var isHighlightsArea = requestPath === '/highlights' || requestPath.indexOf('/highlights/') === 0;
    var isTitledArea = requestPath === '/titled' || requestPath.indexOf('/titled/') === 0;
    var isSettingsArea = requestPath === '/settings' || requestPath.indexOf('/settings/') === 0
      || requestPath === '/quran/settings' || requestPath.indexOf('/quran/settings/') === 0;
    if (isQuranArea)
