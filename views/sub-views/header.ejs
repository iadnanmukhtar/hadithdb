<!--hadithdb-cache:header:start-->
<nav class="navbar site-navbar fixed-top container col-lg-8 mx-auto">
  <%
    var currentSearch = '';
    if (req && req.query && req.query.q)
      currentSearch = req.query.q;
    var navSearchAction = typeof utils.globalSearchBaseUrl === 'function'
      ? utils.globalSearchBaseUrl(req)
      : ((typeof utils.hadithBaseUrl === 'function' && utils.hadithBaseUrl(req)) || site.urlLocal || site.url || '/');
    var requestPath = req && req.originalUrl ? req.originalUrl.split('?')[0] : (req && req.path ? req.path : '');
    var pageMenu = page && page.menu ? page.menu : '';
    var pageBook = page && page.context ? page.context.book : null;
    var isQuranArea = requestPath === '/quran'
      || requestPath.indexOf('/quran/') === 0
      || (pageBook && pageBook.alias === 'quran')
      || (page.context && page.context.quranSearchProxy);
    var isQuranTranslationsArea = requestPath === '/quran/translations' || requestPath.indexOf('/quran/translations/') === 0;
    var isQuranTafsirArea = requestPath === '/quran/tafsir' || requestPath.indexOf('/quran/tafsir/') === 0;
    var isBooksArea = !isQuranArea && (requestPath === '/books' || requestPath.indexOf('/books/') === 0);
    var isBlogArea = requestPath === '/blog' || requestPath.indexOf('/blog/') === 0 || pageMenu === 'Blog';
    var isBookmarksArea = requestPath === '/bookmarks' || requestPath.indexOf('/bookmarks/') === 0;
    var isLikedArea = requestPath === '/liked' || requestPath.indexOf('/liked/') === 0;
    var isCommentedArea = requestPath === '/commented' || requestPath.indexOf('/commented/') === 0;
    var isHighlightsArea = requestPath === '/highlights' || requestPath.indexOf('/highlights/') === 0;
    var isTitledArea = requestPath === '/titled' || requestPath.indexOf('/titled/') === 0;
    var isSettingsArea = requestPath === '/settings' || requestPath.indexOf('/settings/') === 0
      || requestPath === '/quran/settings' || requestPath.indexOf('/quran/settings/') === 0;
    var settingsHref = isQuranArea || requestPath.indexOf('/quran/settings') === 0
      ? utils.quranUrl(req, '/quran/settings')
      : utils.urlFor(req, '/settings');
    var isMoreArea = ['/settings', '/quran/settings', '/bookmarks', '/liked', '/commented', '/highlights', '/titled'].some(function (path) {
      return requestPath === path || requestPath.indexOf(`${path}/`) === 0;
    });
    var isHadithArea = !isQuranArea && !isBooksArea && !isBlogArea && !isMoreArea;
    var headerLogo = isQuranArea ? '/images/quran-logo2.svg' : '/images/logo2.svg';
    var headerLogoAlt = isQuranArea ? 'Quran Unlocked' : site.name;
    function activeNavAttrs(active) {
      return active ? ' active" aria-current="page' : '';
    }
  %>
  <div class="row g-0 site-navbar-main">
    
    <header class="col col-md-4 d-flex site-header-brand">
      <a href="<%= utils.urlFor(req, '/') %>"><img class="logo me-2" src="<%= headerLogo %>" width="56" height="56" alt="<%= headerLogoAlt %>"></a>
      <div>
        <h6 class="title fs-4 mb-0">
          <a href="<%= utils.urlFor(req, '/') %>" class="text-dark text-decoration-none">
          <% if ((page.context.book && page.context.book.alias === 'quran') || page.context.quranSearchProxy) { %>
            Quran Unlocked
          <% } else { %>
            <%= site.name %>
          <% } %>
          </a>
        </h6>
        <% if (page.subtitle_en) { %>
        <div class="subtitle fs-6 text-muted">
          <%- page.subtitle_en %>
          <%- page.subtitle ? `<span lang="ar">${page.subtitle}</span>` : '' %>
        </div>
        <% } %>
      </div>
    </header>

    <!--hadithdb-cache:top-menu:start-->
    <menu class="col d-md-block d-none">
      
      <ul class="nav container-fluid justify-content-end">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle<%- activeNavAttrs(isQuranArea) %>" data-bs-toggle="dropdown" href="<%= utils.quranUrl(req, '/quran') %>" role="button" aria-expanded="false">Quran</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item<%- activeNavAttrs(isQuranArea && !isQuranTranslationsArea && !isQuranTafsirArea) %>" href="<%= utils.quranUrl(req, '/quran') %>"><%- include('menu_icon.ejs', { type: 'quran', label: 'Quran' }) %> Quran</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isQuranTranslationsArea) %>" href="<%= utils.quranUrl(req, '/quran/translations/1/1') %>"><i class="bi bi-translate"></i> Translations</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isQuranTafsirArea) %>" href="<%= utils.quranUrl(req, '/quran/tafsir') %>"><%- include('menu_icon.ejs', { type: 'tafsir', label: 'Tafsir' }) %> Tafsir</a></li>
          </ul>
        </li>
        <li class="nav-item"><a class="nav-link<%- activeNavAttrs(isHadithArea) %>" href="<%= utils.hadithBaseUrl(req) %>">Hadith</a></li>
        <li class="nav-item"><a class="nav-link<%- activeNavAttrs(isBooksArea) %>" href="<%= utils.urlFor(req, '/books') %>">Books</a></li>
        <li class="nav-item"><a class="nav-link<%- activeNavAttrs(isBlogArea) %>" href="<%= utils.urlFor(req, '/blog') %>">Blog</a></li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle<%- activeNavAttrs(isMoreArea) %>" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">More</a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item<%- activeNavAttrs(isSettingsArea) %>" href="<%= settingsHref %>"><i class="bi bi-gear"></i> My Settings</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isBookmarksArea) %>" href="<%= utils.urlFor(req, '/bookmarks') %>"><i class="bi bi-bookmark"></i> My Bookmarks</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isLikedArea) %>" href="<%= utils.urlFor(req, '/liked') %>"><i class="bi bi-heart"></i> Liked</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isCommentedArea) %>" href="<%= utils.urlFor(req, '/commented') %>"><i class="bi bi-chat-right-text"></i> Latest Reflections</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isHighlightsArea) %>" href="<%= utils.urlFor(req, '/highlights') %>"><i class="bi bi-star"></i> Highlighted</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isTitledArea) %>" href="<%= utils.urlFor(req, '/titled') %>"><i class="bi bi-card-heading"></i> Titled</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a class="nav-link top-nav-icon-link" href="<%= utils.urlFor(req, '/liked') %>" title="Favorites" aria-label="Favorites">
            <i class="bi bi-heart<%= isLikedArea ? '-fill' : '' %>"></i>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link top-nav-icon-link" href="<%= utils.urlFor(req, '/bookmarks') %>" title="Bookmarks" aria-label="Bookmarks">
            <i class="bi bi-bookmark<%= isBookmarksArea ? '-fill' : '' %>"></i>
          </a>
        </li>
        <% if (site.admin) { %>
        <li class="nav-item edit-gear"><a class="nav-link" onclick="var editMode=(document.cookie ? document.cookie.match(/editMode=1/) : false); editMode ? document.cookie='editMode=0;path=/;max-age=7776000;samesite=lax' : document.cookie='editMode=1;path=/;max-age=7776000;samesite=lax'; console.log(document.cookie); location.reload();">
            <i class="bi bi-gear<%=site.editMode ? '-fill' : ''%>"></i></a>
        </li>
        <% } %>
        <li class="nav-item search-click-toggle">
          <form action="<%= navSearchAction %>">
          <input role="search" type="text" class="form-control search-click" name="q" placeholder="Search hadīth, āyāt, or tafāsīr..." value="<%= currentSearch %>" />
          </form>
          <a class="nav-link"><i class="bi bi-search"></i></a>
        </li>
        <li class="nav-item">
          <a type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-topnav">
            <i id="icon-menu" class="bi bi-list"></i>
          </a>
        </li>
        <li class="nav-item d-flex align-items-center" id="nav-auth-desktop"></li>
      </ul>
      
    </menu>
    <!--hadithdb-cache:top-menu:end-->

    <menu class="col-auto d-md-none d-block">
      <div class="nav container-fluid justify-content-end align-items-center gap-2 top-nav-mobile-actions">
        <button type="button" class="btn btn-sm nav-auth-btn" id="nav-auth-mobile">Sign in</button>
        <a type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-topnav">
          <i id="icon-menu" class="bi bi-list"></i>
        </a>
      </div>
    </menu>

    <!--hadithdb-cache:left-rail:start-->
    <nav id="offcanvas-topnav" class="offcanvas offcanvas-start collapse" tabindex="-1" data-bs-static="true" data-bs-backdrop="true">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title fs-4" id="offcanvasLabel">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
      </div>
      <div class="offcanvas-body">
        <form action="<%= navSearchAction %>">
          <input role="search" type="text" class="form-control mb-2" name="q" placeholder="Search hadīth, āyāt, or tafāsīr..." value="<%= currentSearch %>" />
        </form>
        <div class="row">
          <%- include('offcanvas_primary_nav.ejs', {
            activeNavAttrs: activeNavAttrs,
            isQuranArea: isQuranArea,
            isQuranTranslationsArea: isQuranTranslationsArea,
            isQuranTafsirArea: isQuranTafsirArea,
            isHadithArea: isHadithArea,
            isBooksArea: isBooksArea,
            isBlogArea: isBlogArea,
            isSettingsArea: isSettingsArea,
            isBookmarksArea: isBookmarksArea,
            isLikedArea: isLikedArea,
            isCommentedArea: isCommentedArea,
            isHighlightsArea: isHighlightsArea,
            isTitledArea: isTitledArea,
            settingsHref: settingsHref
          }) %>
          <ul class="col-5 nav flex-column offcanvas-col2">
            <% for (b of books.filter(b => !b.hidden && b.alias !== 'quran')) { %>
              <li class="nav-item"><a class="nav-link" title="<%= b.shortName %>" href="<%= utils.urlFor(req, `/${b.alias}`) %>"><%= b.shortName_en %></a></li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>
    <!--hadithdb-cache:left-rail:end-->
    
  </div>
  
  <% if (page.menu === 'Chapter' || page.menu === 'Section') { 
      var book = page.context.book;
      var chapter = page.context.chapter;
      var sections = chapter.sections; 
      var isQuranToc = book && book.alias === 'quran';
  %>
  <nav class="row g-0 chapter-toc">
    <%# --- TABLE OF CONTENTS --- %>
    <div class="col-12 d-flex justify-content-center">
      <% if (sections && sections.length > 0) { %>
        <a data-bs-toggle="collapse" href="#toc2" title="Click to show sections">Section Menu <i class="bi bi-caret-down-square"></i></a>
        <% if (page.context.book && page.context.book.alias === 'quran' && (page.menu === 'Chapter' || page.menu === 'Section')) {
             var isPassage = req.query.passage != undefined || page.context.passage || (page.menu === 'Section' && req.query.ayat == undefined);
             if (!isPassage) { %>
                &nbsp;|&nbsp; <a href="<%= page.menu === 'Section' ? req.path : `${req.path}?passage` %>" title="Passage View"><i class="bi bi-text-paragraph"></i> Passage</a>
             <% } else { %>
              &nbsp;|&nbsp; <a href="<%= utils.urlFor(req, `/${(page.context.section || page.context.chapter).path}?ayat`) %>" title="Āyah View"><i class="bi bi-blockquote-left"></i> Āyāt</a>
        <%   }
           } %>
      <% } else { %>
        <!-- <a>No sections in this chapter</a> -->
      <% } %>
    </div>
    <div id="toc2" class="col-12 toc2 collapse">
      <table class="table">
        <tbody>
          <%
				for (var section of sections) {
					if (section.level < 3) {
						title_en = utils.truncate(utils.emptyIfNull(section.title_en).toString(), 75);
						title = utils.truncate(utils.emptyIfNull(section.title).toString(), 150); %>
          <tr class="title">
            <% if (!isQuranToc) { %>
            <td><%- section.start %></td>
            <% } %>
            <% if (section.start) { %>
            <td>
              <a href="<%= utils.urlFor(req, `/${section.path}`) %>">
                <%= `§${section.h2 + (section.h3 ? `-${section.h3}` : '')}` %>
                <%- title_en || `Section ${section.h2 + (section.h3 ? `-${section.h3}` : '')}` %> (<%=section.count%>)
              </a>
              <% if (page.context.book && page.context.book.alias === 'quran') { %>
                &nbsp;<a href="<%= utils.urlFor(req, `/${section.path}`) %>" title="Passage View"><i class="bi bi-text-paragraph"></i></a>
              <% } %>
            </td>
            <td lang="ar"><a href="<%= utils.urlFor(req, `/${section.path}`) %>"><%- title %></a></td>
            <% } else { %>
            <td><%- title_en || 'Section' %></td>
            <td lang="ar"><%- title %></td>
            <% } %>
          </tr>
          <%    }
					}  %>
        </tbody>
      </table>
    </div>
  </nav>
  <% } %>

</nav>
<!--hadithdb-cache:header:end-->
