    var headerLogo = isMudhakkirArea ? '/static/img/quran/mudhakkir.svg' : (isQuranArea ? '/static/img/quran-logo2.svg' : '/static/img/logo2.svg');
    var headerBrandName = isMudhakkirArea ? 'Mudhakkir' : (isQuranArea ? 'Quran Unlocked' : site.name);
    var headerLogoAlt = headerBrandName;
    var headerBrandHref = isQuranArea ? utils.quranUrl(req, '/quran') : utils.urlFor(req, '/');
    var alternateModeLabel = isQuranArea ? 'Hadith' : 'Quran';
    var alternateModeHref = isQuranArea ? utils.hadithBaseUrl(req) : utils.quranUrl(req, '/quran');
    var navSearchPlaceholder = isQuranArea ? 'Search the Qurʿān or tafāsīr...' : 'Search hadīth...';
    function activeNavAttrs(active) {
      return active ? ' active" aria-current="page' : '';
    }
  %>
  <div class="container-fluid d-block">
  <div class="row g-0 site-navbar-main">
    
    <header class="col col-md-4 d-flex site-header-brand">
      <span class="site-header-logo-wrap">
        <a href="<%= headerBrandHref %>"><img class="logo" src="<%= headerLogo %>" width="56" height="56" alt="<%= headerLogoAlt %>"></a>
        <a class="site-mode-switch" href="<%= alternateModeHref %>" aria-label="Switch to <%= alternateModeLabel %>" title="Switch to <%= alternateModeLabel %>">
          <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
        </a>
      </span>
      <div>
        <h6 class="title fs-4 mb-0">
          <a href="<%= headerBrandHref %>" class="text-dark text-decoration-none">
            <%= headerBrandName %>
          </a>
        </h6>
<!--hadithdb-cache:header:end-->
        <% if (page.subtitle_en) { %>
        <div class="subtitle fs-6 text-muted" data-page-subtitle>
          <%- page.subtitle_en %>
          <%- page.subtitle ? `<span lang="ar">${page.subtitle}</span>` : '' %>
        </div>
        <% } %>
      </div>
    </header>

    <!--hadithdb-cache:top-menu:start-->
    <menu class="col d-md-block d-none">
      
      <ul class="nav container-fluid justify-content-end top-nav-desktop-actions">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle<%- activeNavAttrs(isQuranArea) %>" data-bs-toggle="dropdown" href="<%= utils.quranUrl(req, '/quran') %>" role="button" aria-expanded="false">Quran</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item<%- activeNavAttrs(isQuranArea && !isQuranStudyArea && !isQuranTranslationsArea && !isQuranTafsirArea && !isQuranMushafArea && !isQuranReviewArea) %>" href="<%= utils.quranUrl(req, '/quran') %>"><%- include('menu_icon.ejs', { type: 'quran', label: 'Quran' }) %> Quran</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isQuranStudyArea) %>" href="<%= utils.quranUrl(req, '/quran/1') %>"><i class="bi bi-text-paragraph"></i> Study</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isQuranMushafArea && !isQuranMemorizeArea) %>" href="<%= utils.quranUrl(req, '/quran/page') %>"><i class="bi bi-book"></i> Mushaf</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isQuranTranslationsArea) %>" href="<%= utils.quranUrl(req, '/quran/translations') %>"><i class="bi bi-translate"></i> Translations</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isQuranTafsirArea) %>" href="<%= utils.quranUrl(req, '/quran/tafsir') %>"><i class="bi bi-book-half"></i> Tafsir</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isQuranMemorizeArea && !isQuranReviewArea) %>" href="<%= utils.quranUrl(req, '/quran/page?memorize') %>"><i class="bi bi-eye-slash"></i> Practice</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isQuranReviewArea) %>" href="<%= utils.quranUrl(req, '/quran/review') %>"><i class="bi bi-arrow-repeat"></i> Mudhakkir</a></li>
          </ul>
        </li>
        <li class="nav-item"><a class="nav-link<%- activeNavAttrs(isHadithArea) %>" href="<%= utils.hadithBaseUrl(req) %>">Hadith</a></li>
        <li class="nav-item"><a class="nav-link<%- activeNavAttrs(isBooksArea) %>" href="<%= utils.urlFor(req, '/books') %>">Books</a></li>
        <li class="nav-item"><a class="nav-link<%- activeNavAttrs(isBlogArea) %>" href="<%= utils.urlFor(req, '/blog') %>">Blog</a></li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle<%- activeNavAttrs(isMoreArea) %>" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">More</a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item<%- activeNavAttrs(isSettingsArea) %>" href="<%= settingsHref %>"><i class="bi bi-sliders"></i> My Settings</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isBookmarksArea) %>" href="<%= utils.urlFor(req, '/bookmarks') %>"><i class="bi bi-bookmark"></i> My Bookmarks</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isLikedArea) %>" href="<%= utils.urlFor(req, '/liked') %>"><i class="bi bi-heart"></i> Liked</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isCommentedArea) %>" href="<%= utils.urlFor(req, '/commented') %>"><i class="bi bi-chat-right-text"></i> Latest Reflections</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isHighlightsArea) %>" href="<%= utils.urlFor(req, '/highlights') %>"><i class="bi bi-star"></i> Highlighted</a></li>
            <li><a class="dropdown-item<%- activeNavAttrs(isTitledArea) %>" href="<%= utils.urlFor(req, '/titled') %>"><i class="bi bi-card-heading"></i> Titled</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a class="nav-link top-nav-icon-link" href="<%= utils.urlFor(req, '/bookmarks') %>" title="Bookmarks" aria-label="Bookmarks">
            <i class="bi bi-bookmark<%= isBookmarksArea ? '-fill' : '' %>"></i>
          </a>
        </li>
        <% if (!isQuranArea) { %>
        <li class="nav-item top-nav-language-item">
          <div class="dropdown global-content-language-dropdown" data-global-content-language-dropdown="1">
            <button id="global-content-language-select" class="btn btn-sm btn-outline-secondary dropdown-toggle global-content-language-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Content language" title="Content language" data-global-content-language-button="1">EN</button>
            <div class="dropdown-menu dropdown-menu-end global-content-language-menu" data-global-content-language-menu="1" aria-labelledby="global-content-language-select">
              <button class="dropdown-item global-content-language-option active" type="button" data-global-content-language-option="en"><span class="global-content-language-code">EN</span><span class="global-content-language-name">English</span></button>
            </div>
          </div>
        </li>
        <% } %>
        <% if (site.admin) { %>
        <li class="nav-item edit-gear"><a class="nav-link" onclick="var editMode=(document.cookie ? document.cookie.match(/(?:^|; )editMode=1(?:;|$)/) : false); if (window.setHadithAdminMode) { setHadithAdminMode(!editMode); } else { try { localStorage.setItem('hadithdb_edit_mode', editMode ? '0' : '1'); } catch (err) {} if (editMode) { document.cookie='editMode=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT'; if (window.HADITH_COOKIE_DOMAIN) document.cookie='editMode=;path=/;domain='+window.HADITH_COOKIE_DOMAIN+';expires=Thu, 01 Jan 1970 00:00:00 GMT'; } else { var domain=window.HADITH_COOKIE_DOMAIN ? ';domain='+window.HADITH_COOKIE_DOMAIN : ''; document.cookie='editMode=1;path=/;max-age=7776000;samesite=lax'+domain; } location.reload(); }">
            <i class="bi bi-gear<%=site.editMode ? '-fill' : ''%>"></i></a>
        </li>
        <% } %>
        <li class="nav-item search-click-toggle">
          <form action="<%= navSearchAction %>">
          <% if (quranSearchReturnMode) { %><input type="hidden" name="mode" value="<%= quranSearchReturnMode %>"><% } %>
          <input role="search" type="text" class="form-control search-click" name="q" placeholder="<%= navSearchPlaceholder %>" autocomplete="off" autocapitalize="none" spellcheck="false" />
          </form>
          <a class="nav-link"><i class="bi bi-search"></i></a>
        </li>
        <li class="nav-item d-flex align-items-center" id="nav-auth-desktop"></li>
      </ul>
      
    </menu>
    <!--hadithdb-cache:top-menu:end-->

    <menu class="col-auto d-md-none d-block">
      <div class="nav container-fluid justify-content-end align-items-center gap-2 top-nav-mobile-actions">
        <% if (!isQuranArea) { %>
        <div class="dropdown global-content-language-dropdown" data-global-content-language-dropdown="1">
          <button id="global-content-language-select-mobile" class="btn btn-sm btn-outline-secondary dropdown-toggle global-content-language-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Content language" title="Content language" data-global-content-language-button="1">EN</button>
          <div class="dropdown-menu dropdown-menu-end global-content-language-menu" data-global-content-language-menu="1" aria-labelledby="global-content-language-select-mobile">
            <button class="dropdown-item global-content-language-option active" type="button" data-global-content-language-option="en"><span class="global-content-language-code">EN</span><span class="global-content-language-name">English</span></button>
          </div>
        </div>
        <% } %>
        <a class="nav-link top-nav-icon-link" href="<%= utils.urlFor(req, '/bookmarks') %>" title="Bookmarks" aria-label="Bookmarks">
          <i class="bi bi-bookmark<%= isBookmarksArea ? '-fill' : '' %>"></i>
        </a>
        <div class="search-click-toggle">
          <form action="<%= navSearchAction %>">
            <% if (quranSearchReturnMode) { %><input type="hidden" name="mode" value="<%= quranSearchReturnMode %>"><% } %>
            <input role="search" type="text" class="form-control search-click" name="q" placeholder="<%= navSearchPlaceholder %>" autocomplete="off" autocapitalize="none" spellcheck="false" />
          </form>
          <a class="nav-link top-nav-icon-link" role="button" title="Search" aria-label="Search"><i class="bi bi-search"></i></a>
        </div>
        <button type="button" class="btn btn-sm nav-auth-btn" id="nav-auth-mobile">Sign in</button>
      </div>
    </menu>

    <div class="col-auto d-flex align-items-center site-navbar-menu-toggle">
      <button type="button" class="btn btn-link p-0 border-0 top-nav-menu-toggle" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-topnav" aria-controls="offcanvas-topnav" aria-label="Open menu">
        <i id="icon-menu" class="bi bi-list"></i>
      </button>
    </div>

    <!--hadithdb-cache:left-rail:start-->
    <nav id="offcanvas-topnav" class="offcanvas offcanvas-start collapse" tabindex="-1" data-bs-static="true" data-bs-backdrop="true">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title fs-4" id="offcanvasLabel">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
      </div>
      <div class="offcanvas-body">
        <form action="<%= navSearchAction %>">
          <% if (quranSearchReturnMode) { %><input type="hidden" name="mode" value="<%= quranSearchReturnMode %>"><% } %>
          <input role="search" type="text" class="form-control mb-2" name="q" placeholder="<%= navSearchPlaceholder %>" autocomplete="off" autocapitalize="none" spellcheck="false" />
        </form>
        <div class="offcanvas-quick-actions" role="navigation" aria-label="Quick links">
          <a class="offcanvas-quick-action<%- activeNavAttrs(isBookmarksArea) %>" href="<%= utils.urlFor(req, '/bookmarks') %>" title="My Bookmarks" aria-label="My Bookmarks">
            <i class="bi bi-bookmark<%= isBookmarksArea ? '-fill' : '' %>" aria-hidden="true"></i>
          </a>
          <a class="offcanvas-quick-action<%- activeNavAttrs(isLikedArea) %>" href="<%= utils.urlFor(req, '/liked') %>" title="Liked" aria-label="Liked">
            <i class="bi bi-heart<%= isLikedArea ? '-fill' : '' %>" aria-hidden="true"></i>
          </a>
          <a class="offcanvas-quick-action<%- activeNavAttrs(isCommentedArea) %>" href="<%= utils.urlFor(req, '/commented') %>" title="Latest Reflections" aria-label="Latest Reflections">
            <i class="bi bi-chat-right-text" aria-hidden="true"></i>
          </a>
          <a class="offcanvas-quick-action<%- activeNavAttrs(isHighlightsArea) %>" href="<%= utils.urlFor(req, '/highlights') %>" title="Highlighted" aria-label="Highlighted">
            <i class="bi bi-star<%= isHighlightsArea ? '-fill' : '' %>" aria-hidden="true"></i>
          </a>
          <a class="offcanvas-quick-action<%- activeNavAttrs(isTitledArea) %>" href="<%= utils.urlFor(req, '/titled') %>" title="Titled" aria-label="Titled">
            <i class="bi bi-card-heading" aria-hidden="true"></i>
          </a>
          <a class="offcanvas-quick-action<%- activeNavAttrs(isSettingsArea) %>" href="<%= settingsHref %>" title="My Settings" aria-label="My Settings">
            <i class="bi bi-sliders" aria-hidden="true"></i>
          </a>
        </div>
        <div class="row">
          <%- include('offcanvas_primary_nav.ejs', {
            activeNavAttrs: activeNavAttrs,
            isQuranArea: isQuranArea,
            isQuranStudyArea: isQuranStudyArea,
            isQuranMushafArea: isQuranMushafArea,
            isQuranMemorizeArea: isQuranMemorizeArea,
            isQuranReviewArea: isQuranReviewArea,
            isQuranTranslationsArea: isQuranTranslationsArea,
            isQuranTafsirArea: isQuranTafsirArea,
            isHadithArea: isHadithArea,
            isBooksArea: isBooksArea,
            isBlogArea: isBlogArea,
            isSettingsArea: isSettingsArea,
            isBookmarksArea: isBookmarksArea,
            isLikedArea: isLikedArea,
            isCommentedArea: isCommentedArea,
            isHighlightsArea: isHighlightsArea,
            isTitledArea: isTitledArea,
            settingsHref: settingsHref
          }) %>
          <ul class="col-5 nav flex-column offcanvas-col2">
            <% if (isQuranArea) {
              var railTafsirs = Array.isArray(locals.quranNavTafsirs) ? locals.quranNavTafsirs : [];
              for (var railTafsir of railTafsirs) {
                var railTafsirLabel = Tafsir.rawShortName(railTafsir, 'en').replace(/^tafs[īi]r\s+/i, '').trim();
                var railTafsirSlug = railTafsir.slug || Tafsir.tafsirSlug(railTafsir.alias);
            %>
              <li class="nav-item"><a class="nav-link" title="<%= railTafsir.name_en || railTafsirLabel %>" href="<%= utils.quranUrl(req, `/quran/tafsir/${encodeURIComponent(railTafsirSlug)}`) %>"><%= railTafsirLabel %></a></li>
            <% }
            } else {
              var railHadithBooks = books.filter(function (book) {
                return book
                  && Number(book.hidden) === 0
                  && book.alias !== 'quran'
                  && (book.type || book.book_type || book.book_model || 'hadith') === 'hadith';
              }).slice().sort(function (a, b) {
                return (a.shortName_en || a.name_en || a.alias || '').localeCompare(
                  b.shortName_en || b.name_en || b.alias || '',
                  'en',
                  { sensitivity: 'base' }
                );
              });
              for (b of railHadithBooks) { %>
                <li class="nav-item"><a class="nav-link" title="<%= b.shortName %>" href="<%= utils.urlFor(req, `/${b.alias}`) %>"><%= b.shortName_en %></a></li>
              <% }
            } %>
          </ul>
        </div>
      </div>
    </nav>
    <!--hadithdb-cache:left-rail:end-->
    
  </div>
  
  <% if (page.menu === 'Chapter' || page.menu === 'Section') { 
      var book = page.context.book;
      var chapter = page.context.chapter;
      var sections = chapter.sections; 
      var isQuranToc = book && book.alias === 'quran';
	  var quranTafsirMenuBase = isQuranTafsirArea && pageQuranCommentaryBook
	    ? `/quran/tafsir/${encodeURIComponent(pageQuranCommentaryBook.slug || pageQuranCommentaryBook.alias)}`
	    : '';
	  var quranSectionMenuHref = function (section) {
	    if (!quranTafsirMenuBase)
	      return utils.urlFor(req, `/${section.path}`);
	    var startParts = String(section.start || '').split(':');
	    var startAyah = Number(startParts[startParts.length - 1]);
	    var sectionSurah = Number(section.h1 || chapter.h1);
	    return utils.quranUrl(req, `${quranTafsirMenuBase}/quran:${sectionSurah}:${startAyah}`);
	  };
	  var quranSectionMenuTocHref = quranTafsirMenuBase
	    ? utils.quranUrl(req, quranTafsirMenuBase)
	    : utils.quranUrl(req, '/quran');
      var isQuranMushafSectionMenu = requestPath.indexOf('/quran/page/') === 0
        && Array.isArray(locals.quranHeaderJuzLinks)
        && locals.quranHeaderJuzLinks.length > 0;
      var currentMushafHeaderJuz = isQuranMushafSectionMenu
        ? locals.quranHeaderJuzLinks.find(function (juz) { return juz.current; })
        : null;
  %>
  <nav class="row g-0 chapter-toc">
    <%# --- TABLE OF CONTENTS --- %>
    <div class="col-12 chapter-toc-toolbar">
      <% if (sections && sections.length > 0) { %>
		<a class="chapter-toc-toggle" data-bs-toggle="collapse" href="#toc2" role="button" aria-expanded="false" aria-controls="toc2" title="<%= isQuranMushafSectionMenu ? 'Show juz' : (isQuranToc ? 'Show passages' : 'Show sections') %>">
          <i class="bi bi-list-ul" aria-hidden="true"></i>
		  <span><%= isQuranMushafSectionMenu ? 'Juz' : (isQuranToc ? 'Passages' : 'Sections') %></span>
		  <% if (isQuranMushafSectionMenu && currentMushafHeaderJuz) { %><span class="chapter-toc-current" data-quran-mushaf-current-juz><%= currentMushafHeaderJuz.num %> · <%= currentMushafHeaderJuz.progress %>%</span><% } else if (page.context.section && page.context.section.h2) { %><span class="chapter-toc-current">§<%= page.context.section.h2 %></span><% } %>
          <i class="bi bi-chevron-down chapter-toc-chevron" aria-hidden="true"></i>
        </a>
        <% if (page.context.book && page.context.book.alias === 'quran' && page.menu === 'Section') {
             var quranSectionPath = utils.quranUrl(req, `/${(page.context.section || page.context.chapter).path}`);
             var quranReaderMode = isQuranTafsirArea ? 'tafsir' : (requestPath.indexOf('/quran/translations/quran:') === 0 ? 'trans' : (requestPath.indexOf('/quran/page/') === 0 ? (isQuranReviewArea ? 'review' : (isQuranMemorizeArea ? 'memorize' : 'mushaf')) : 'passage'));
             var quranMappedPage = page.context.section && page.context.section.mushafPage;
        %>
          <span class="chapter-toc-reader-modes">
            <%- include('quran_reader_modes.ejs', {
              readerMode: quranReaderMode,
              passageHref: quranSectionPath,
              ayahHref: `${quranSectionPath}?ayat`,
              mushafHref: utils.quranUrl(req, '/quran/page'),
              tafsirHref: isQuranTafsirArea ? requestPath : utils.quranUrl(req, '/quran/tafsir'),
              memorizeHref: `${utils.quranUrl(req, `/quran/page/${quranMappedPage || 1}`)}?memorize`
            }); %>
          </span>
        <% } %>
      <% } else { %>
        <!-- <a>No sections in this chapter</a> -->
      <% } %>
    </div>
    <div id="toc2" class="col-12 toc2 collapse chapter-toc-panel">
      <table class="table chapter-toc-table">
        <tbody>
          <% if (!isQuranMushafSectionMenu) { %>
          <% if (isQuranToc) { %>
          <tr class="title" data-quran-menu-href="<%= quranSectionMenuTocHref %>">
            <td><a href="<%= quranSectionMenuTocHref %>">Table of Contents</a></td>
            <td lang="ar" dir="rtl"><a href="<%= quranSectionMenuTocHref %>">الفهرس</a></td>
          </tr>
          <% } %>
          <%
				for (var section of sections) {
					if (section.level < 3) {
						title_en = utils.truncate(utils.emptyIfNull(section.title_en).toString(), 75);
						title = utils.truncate(utils.emptyIfNull(section.title).toString(), 150); %>
          <tr class="title<%= page.context.section && Number(page.context.section.h2) === Number(section.h2) ? ' is-current' : '' %>"<% if (isQuranToc && section.start) { %> data-quran-menu-href="<%= quranSectionMenuHref(section) %>"<% } %>>
            <% if (!isQuranToc) { %>
            <td><%- section.start %></td>
            <% } %>
            <% if (section.start) { %>
            <td>
              <a href="<%= quranSectionMenuHref(section) %>">
				<%= `§${section.h2 + (section.h3 ? `-${section.h3}` : '')}` %>
				<%- title_en || `${isQuranToc ? 'Passage' : 'Section'} ${section.h2 + (section.h3 ? `-${section.h3}` : '')}` %> (<%=section.count%>)
              </a>
              <% if (page.context.book && page.context.book.alias === 'quran') { %>
                &nbsp;<a href="<%= utils.urlFor(req, `/${section.path}`) %>" title="Study"><i class="bi bi-text-paragraph"></i></a>
              <% } %>
            </td>
            <td lang="ar"><a href="<%= quranSectionMenuHref(section) %>"><%- title %></a></td>
            <% } else { %>
			<td><%- title_en || (isQuranToc ? 'Passage' : 'Section') %></td>
            <td lang="ar"><%- title %></td>
            <% } %>
          </tr>
          <%    }
					}  %>
          <% } %>
          <% if (isQuranMushafSectionMenu) { %>
          <tr class="title" data-quran-menu-href="<%= utils.quranUrl(req, '/quran') %>">
            <td><a href="<%= utils.quranUrl(req, '/quran') %>">Table of Contents</a></td>
            <td lang="ar" dir="rtl"><a href="<%= utils.quranUrl(req, '/quran') %>">الفهرس</a></td>
          </tr>
          <% for (var mushafHeaderJuz of locals.quranHeaderJuzLinks) { %>
          <tr class="title<%= mushafHeaderJuz.current ? ' is-current' : '' %>" data-quran-mushaf-header-juz="<%= mushafHeaderJuz.num %>" data-quran-mushaf-juz-href="<%= mushafHeaderJuz.href %>" data-quran-mushaf-juz-start-page="<%= mushafHeaderJuz.startPage %>" data-quran-mushaf-juz-end-page="<%= mushafHeaderJuz.endPage %>">
            <td><a href="<%= mushafHeaderJuz.href %>"<% if (mushafHeaderJuz.current) { %> aria-current="page"<% } %>>Juz <%= mushafHeaderJuz.num %></a></td>
            <td lang="ar" dir="rtl"><a href="<%= mushafHeaderJuz.href %>"<% if (mushafHeaderJuz.current) { %> aria-current="page"<% } %>><%- mushafHeaderJuz.title || '' %></a></td>
          </tr>
          <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </nav>
  <% } %>

  <% if ((requestPath === '/quran' || requestPath === '/quran/review' || pageQuranCommentaryBook) && Array.isArray(locals.quranHeaderJuzLinks) && locals.quranHeaderJuzLinks.length > 0) { %>
  <nav class="row g-0 chapter-toc">
    <div class="col-12 chapter-toc-toolbar">
      <a class="chapter-toc-toggle" data-bs-toggle="collapse" href="#toc2" role="button" aria-expanded="false" aria-controls="toc2" title="Show juz sections">
        <i class="bi bi-list-ul" aria-hidden="true"></i>
        <span>Juz</span>
        <i class="bi bi-chevron-down chapter-toc-chevron" aria-hidden="true"></i>
      </a>
      <span class="chapter-toc-reader-modes">
        <%- include('quran_reader_modes.ejs', {
          readerMode: pageQuranCommentaryBook && pageQuranCommentaryBook.type === 'tafsir' ? 'tafsir' : (requestPath === '/quran/review' ? 'review' : undefined),
          passageHref: utils.quranUrl(req, '/quran/1'),
          ayahHref: `${utils.quranUrl(req, '/quran/1')}?ayat`,
          mushafHref: utils.quranUrl(req, '/quran/page'),
          tafsirHref: pageQuranCommentaryBook && pageQuranCommentaryBook.type === 'tafsir' ? requestPath : utils.quranUrl(req, '/quran/tafsir'),
          memorizeHref: `${utils.quranUrl(req, '/quran/page/1')}?memorize`
        }); %>
      </span>
    </div>
    <div id="toc2" class="col-12 toc2 collapse chapter-toc-panel">
      <table class="table chapter-toc-table">
        <tbody>
          <tr class="title" data-quran-menu-href="<%= utils.quranUrl(req, '/quran') %>">
            <td><a href="<%= utils.quranUrl(req, '/quran') %>">Table of Contents</a></td>
            <td lang="ar" dir="rtl"><a href="<%= utils.quranUrl(req, '/quran') %>">الفهرس</a></td>
          </tr>
          <% for (var quranHeaderJuz of (Array.isArray(locals.quranHeaderJuzLinks) ? locals.quranHeaderJuzLinks : [])) { %>
          <tr class="title">
            <td><a href="<%= quranHeaderJuz.href %>">Juz <%= quranHeaderJuz.num %></a></td>
            <td lang="ar" dir="rtl"><a href="<%= quranHeaderJuz.href %>"><%- quranHeaderJuz.title || '' %></a></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </nav>
  <% } %>

  </div>
</nav>
