	    return utils.quranUrl(req, utils.quranStudySectionPath(section, quranStudyTranslationMenuSlug));
	  };
	  var quranSectionMenuHref = function (section) {
	    if (isQuranStudyArea)
	      return utils.quranUrl(req, utils.quranStudySectionPath(section, quranStudyTranslationMenuSlug));
	    if (!quranTafsirMenuBase && !quranTranslationMenuBase)
	      return utils.urlFor(req, `/${section.path}`);
	    var startParts = String(section.start || '').split(':');
	    var startAyah = Number(startParts[startParts.length - 1]);
	    var sectionSurah = Number(section.h1 || chapter.h1);
	    return utils.quranUrl(req, `${quranTafsirMenuBase || quranTranslationMenuBase}/quran:${sectionSurah}:${startAyah}`);
	  };
	  var quranSectionMenuTocHref = isQuranStudyArea || quranTafsirMenuBase || quranTranslationMenuBase
	    ? utils.quranUrl(req, isQuranStudyArea ? utils.quranStudySectionPath(null, quranStudyTranslationMenuSlug) : (quranTafsirMenuBase || quranTranslationMenuBase))
	    : utils.quranUrl(req, '/quran');
      var isQuranMushafSectionMenu = requestPath.indexOf('/quran/page/') === 0
        && Array.isArray(locals.quranHeaderJuzLinks)
        && locals.quranHeaderJuzLinks.length > 0;
      var currentMushafHeaderJuz = isQuranMushafSectionMenu
        ? locals.quranHeaderJuzLinks.find(function (juz) { return juz.current; })
        : null;
  %>
  <nav class="row g-0 chapter-toc<%= isQuranToc ? ' quran-section-menu' : '' %>">
    <%# --- TABLE OF CONTENTS --- %>
    <div class="col-12 chapter-toc-toolbar">
      <% if (sections && sections.length > 0) { %>
		<a class="chapter-toc-toggle" data-bs-toggle="collapse" href="#toc2" role="button" aria-expanded="false" aria-controls="toc2" title="<%= isQuranMushafSectionMenu ? 'Show juz' : (isQuranToc ? 'Show passages' : 'Show sections') %>">
          <i class="bi bi-list-ul" aria-hidden="true"></i>
		  <span><%= isQuranMushafSectionMenu ? 'Juz' : (isQuranToc ? 'Passages' : 'Sections') %></span>
		  <% if (isQuranMushafSectionMenu && currentMushafHeaderJuz) { %><span class="chapter-toc-current" data-quran-mushaf-current-juz><%= currentMushafHeaderJuz.num %> · <%= currentMushafHeaderJuz.progress %>%</span><% } else if (page.context.section && page.context.section.h2) { %><span class="chapter-toc-current">§<%= page.context.section.h2 %></span><% } %>
          <i class="bi bi-chevron-down chapter-toc-chevron" aria-hidden="true"></i>
        </a>
	        <% if (page.context.book && page.context.book.alias === 'quran' && page.menu === 'Section') {
	             var quranSectionPath = quranStudySectionMenuHref(page.context.section || page.context.chapter);
             var quranReaderMode = isQuranTafsirArea ? 'tafsir' : (requestPath.indexOf('/quran/translations/quran:') === 0 ? 'trans' : (requestPath.indexOf('/quran/page/') === 0 ? (isQuranReviewArea ? 'review' : (isQuranMemorizeArea ? 'memorize' : 'mushaf')) : 'passage'));
             var quranMappedPage = page.context.section && page.context.section.mushafPage;
             var quranMappedMushafHref = utils.quranUrl(req, `/quran/page/${quranMappedPage || 1}`);
        %>
          <span class="chapter-toc-reader-modes">
            <%- include('quran_reader_modes.ejs', {
              readerMode: quranReaderMode,
              passageHref: quranSectionPath,
              ayahHref: `${quranSectionPath}?ayat`,
              mushafHref: quranMappedMushafHref,
              tafsirHref: isQuranTafsirArea ? requestPath : utils.quranUrl(req, '/quran/tafsir'),
              memorizeHref: `${quranMappedMushafHref}?memorize`
            }); %>
          </span>
        <% } %>
      <% } else { %>
        <!-- <a>No sections in this chapter</a> -->
      <% } %>
    </div>
    <div id="toc2" class="col-12 toc2 collapse chapter-toc-panel">
      <table class="table chapter-toc-table">
        <tbody>
          <% if (!isQuranMushafSectionMenu) { %>
          <% if (isQuranToc) { %>
          <tr class="title" data-quran-menu-href="<%= quranSectionMenuTocHref %>">
            <td><a href="<%= quranSectionMenuTocHref %>">Table of Contents</a></td>
            <td lang="ar" dir="rtl"><a href="<%= quranSectionMenuTocHref %>">الفهرس</a></td>
          </tr>
          <% } %>
          <%
				for (var section of sections) {
					if (section.level < 3) {
						title_en = utils.truncate(utils.emptyIfNull(section.title_en).toString(), 75);
						title = utils.truncate(utils.emptyIfNull(section.title).toString(), 150); %>
          <tr class="title<%= page.context.section && Number(page.context.section.h2) === Number(section.h2) ? ' is-current' : '' %>"<% if (isQuranToc && section.start) { %> data-quran-menu-href="<%= quranSectionMenuHref(section) %>"<% } %>>
            <% if (!isQuranToc) { %>
            <td><%- section.start %></td>
            <% } %>
            <% if (section.start) { %>
            <td>
              <a href="<%= quranSectionMenuHref(section) %>">
				<%= `§${section.h2 + (section.h3 ? `-${section.h3}` : '')}` %>
				<%- title_en || `${isQuranToc ? 'Passage' : 'Section'} ${section.h2 + (section.h3 ? `-${section.h3}` : '')}` %> (<%=section.count%>)
              </a>
              <% if (page.context.book && page.context.book.alias === 'quran') { %>
                &nbsp;<a href="<%= quranStudySectionMenuHref(section) %>" title="Study"><i class="bi bi-text-paragraph"></i></a>
              <% } %>
            </td>
            <td lang="ar"><a href="<%= quranSectionMenuHref(section) %>"><%- title %></a></td>
            <% } else { %>
			<td><%- title_en || (isQuranToc ? 'Passage' : 'Section') %></td>
            <td lang="ar"><%- title %></td>
            <% } %>
          </tr>
          <%    }
					}  %>
          <% } %>
          <% if (isQuranMushafSectionMenu) { %>
          <tr class="title" data-quran-menu-href="<%= utils.quranUrl(req, '/quran') %>">
            <td><a href="<%= utils.quranUrl(req, '/quran') %>">Table of Contents</a></td>
            <td lang="ar" dir="rtl"><a href="<%= utils.quranUrl(req, '/quran') %>">الفهرس</a></td>
          </tr>
          <% for (var mushafHeaderJuz of locals.quranHeaderJuzLinks) { %>
          <tr class="title<%= mushafHeaderJuz.current ? ' is-current' : '' %>" data-quran-mushaf-header-juz="<%= mushafHeaderJuz.num %>" data-quran-mushaf-juz-href="<%= mushafHeaderJuz.href %>" data-quran-mushaf-juz-start-page="<%= mushafHeaderJuz.startPage %>" data-quran-mushaf-juz-end-page="<%= mushafHeaderJuz.endPage %>">
            <td><a href="<%= mushafHeaderJuz.href %>"<% if (mushafHeaderJuz.current) { %> aria-current="page"<% } %>>Juz <%= mushafHeaderJuz.num %></a></td>
            <td lang="ar" dir="rtl"><a href="<%= mushafHeaderJuz.href %>"<% if (mushafHeaderJuz.current) { %> aria-current="page"<% } %>><%- mushafHeaderJuz.title || '' %></a></td>
          </tr>
          <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </nav>
  <% } %>

  <% if ((requestPath === '/quran' || requestPath === '/quran/review' || pageQuranCommentaryBook) && Array.isArray(locals.quranHeaderJuzLinks) && locals.quranHeaderJuzLinks.length > 0) { %>
  <nav class="row g-0 chapter-toc quran-section-menu">
    <div class="col-12 chapter-toc-toolbar">
      <a class="chapter-toc-toggle" data-bs-toggle="collapse" href="#toc2" role="button" aria-expanded="false" aria-controls="toc2" title="Show juz sections">
        <i class="bi bi-list-ul" aria-hidden="true"></i>
        <span>Juz</span>
        <i class="bi bi-chevron-down chapter-toc-chevron" aria-hidden="true"></i>
      </a>
      <span class="chapter-toc-reader-modes">
        <%- include('quran_reader_modes.ejs', {
          readerMode: pageQuranCommentaryBook && pageQuranCommentaryBook.type === 'tafsir' ? 'tafsir' : (requestPath === '/quran/review' ? 'review' : undefined),
          passageHref: utils.quranUrl(req, '/quran/1'),
          ayahHref: `${utils.quranUrl(req, '/quran/1')}?ayat`,
          mushafHref: utils.quranUrl(req, '/quran/page'),
          tafsirHref: pageQuranCommentaryBook && pageQuranCommentaryBook.type === 'tafsir' ? requestPath : utils.quranUrl(req, '/quran/tafsir'),
          memorizeHref: `${utils.quranUrl(req, '/quran/page/1')}?memorize`
        }); %>
      </span>
    </div>
    <div id="toc2" class="col-12 toc2 collapse chapter-toc-panel">
      <table class="table chapter-toc-table">
        <tbody>
          <tr class="title" data-quran-menu-href="<%= utils.quranUrl(req, '/quran') %>">
            <td><a href="<%= utils.quranUrl(req, '/quran') %>">Table of Contents</a></td>
            <td lang="ar" dir="rtl"><a href="<%= utils.quranUrl(req, '/quran') %>">الفهرس</a></td>
          </tr>
          <% for (var quranHeaderJuz of (Array.isArray(locals.quranHeaderJuzLinks) ? locals.quranHeaderJuzLinks : [])) { %>
          <tr class="title">
            <td><a href="<%= quranHeaderJuz.href %>">Juz <%= quranHeaderJuz.num %></a></td>
            <td lang="ar" dir="rtl"><a href="<%= quranHeaderJuz.href %>"><%- quranHeaderJuz.title || '' %></a></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </nav>
  <% } %>

  <div class="col-12 d-none d-md-flex site-navbar-search-row" role="search">
    <button type="button" class="command-search-trigger" data-command-search-open data-command-search-direction-container dir="<%= headerSearchIsRtl ? 'rtl' : 'ltr' %>" aria-haspopup="dialog" aria-controls="global-search-dialog" aria-label="Search Hadith or Quran and Tafsir (Command or Control K)">
      <i class="bi bi-search<%= headerSearchIsRtl ? ' is-rtl-search' : '' %>" data-command-search-icon aria-hidden="true"></i>
      <span class="command-search-trigger-label<%= headerSearchIsRtl ? ' command-search-arabic-text' : '' %>" data-command-search-trigger-label data-empty-label="Search Hadith or Quran + Tafsir" dir="<%= headerSearchIsRtl ? 'rtl' : 'ltr' %>"><%= headerSearchTerm || 'Search Hadith or Quran + Tafsir' %></span>
      <kbd class="command-search-shortcut" aria-hidden="true"><span data-command-key-modifier>⌘</span><span>K</span></kbd>
    </button>
  </div>

  </div>
</nav>
