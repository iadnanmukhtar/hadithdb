<dialog id="community-share-dialog" class="community-quick-dialog community-share-dialog" aria-label="Share a Community post">
  <form id="community-share-form" class="community-composer">
    <button type="button" class="btn-close community-composer-close" data-community-share-close aria-label="Close post editor"></button>
    <div class="community-composer-heading"><span class="community-avatar" aria-hidden="true"><i class="bi bi-people"></i></span><div><span class="community-composer-name" id="community-share-name">Share a post</span><span class="community-composer-audience"><i class="bi bi-globe2" aria-hidden="true"></i> Public post</span></div></div>
    <label class="visually-hidden" for="community-share-text">Post text</label>
    <textarea id="community-share-text" rows="4" maxlength="10000" dir="auto" placeholder="Add your thoughts…" aria-describedby="community-share-status"></textarea>
    <div id="community-share-preview" class="community-link-preview"></div>
    <div class="community-composer-footer"><a href="/community" target="_blank" rel="noopener">Community</a><div class="community-posting-actions"><button type="button" class="btn btn-sm btn-outline-secondary" data-community-share-close>Cancel</button><button id="community-share-post" type="submit" class="btn btn-sm btn-primary">Post <i class="bi bi-arrow-up" aria-hidden="true"></i></button></div></div>
    <p id="community-share-status" class="community-composer-status" role="status" aria-live="polite"></p>
  </form>
</dialog>
