<div id="community-post-actions" class="community-entry-actions mt-3"><button type="button" class="community-like" title="Share" aria-label="Share" data-community-share-url="<%= post.shareUrl || post.url %>" data-community-share-handle="<%= post.author.handle %>" data-community-share-author="<%= post.author.name %>" data-community-share-photo="<%= post.author.photo || post.author.avatarFallback || '' %>" data-community-share-cover="<%= post.coverUrl || '' %>" data-community-share-excerpt="<%= post.excerpt || '' %>" data-community-share-title="<%= post.shareTitle || post.title || 'Community post' %>"><i class="bi bi-share" aria-hidden="true"></i></button><details class="community-secondary-menu community-post-menu"><summary class="community-like" title="More actions" aria-label="More actions"><i class="bi bi-three-dots" aria-hidden="true"></i></summary><div class="community-secondary-panel"><button type="button" class="community-like" data-community-print="<%= post.id %>" title="Print / Save as PDF" aria-label="Print / Save as PDF"><i class="bi bi-printer" aria-hidden="true"></i>Print</button><button id="community-report-post" class="community-like" type="button" title="Report" aria-label="Report"><i class="bi bi-flag" aria-hidden="true"></i>Report</button><a id="community-edit-post" class="community-entry-secondary" title="Edit" aria-label="Edit" data-generated="<%= !!post.generatedActivity %>" href="<%= post.kind === 'note' ? '/community/mine?editPost=' : '/community/write?post=' %><%= post.id %>" hidden><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a></div></details></div>
