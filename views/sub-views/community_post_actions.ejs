<div id="community-post-actions" class="community-entry-actions mt-3"><button type="button" class="community-like" title="Share" aria-label="Share post" data-community-share-url="<%= post.shareUrl || post.url %>" data-community-share-handle="<%= post.author.handle %>" data-community-share-author="<%= post.author.name %>" data-community-share-photo="<%= post.author.photo || post.author.avatarFallback || '' %>" data-community-share-cover="<%= post.coverUrl || '' %>" data-community-share-excerpt="<%= post.excerpt || '' %>" data-community-share-title="<%= post.shareTitle || post.title || 'Community post' %>"><i class="bi bi-share" aria-hidden="true"></i></button><button id="community-report-post" class="community-like" type="button" title="Report" aria-label="Report post"><i class="bi bi-flag" aria-hidden="true"></i></button><a id="community-edit-post" class="community-entry-secondary" title="Edit post" aria-label="Edit post" data-generated="<%= !!post.generatedActivity %>" href="<%= post.kind === 'note' ? '/community/mine?editPost=' : '/community/write?post=' %><%= post.id %>" hidden><i class="bi bi-pencil" aria-hidden="true"></i></a></div>
