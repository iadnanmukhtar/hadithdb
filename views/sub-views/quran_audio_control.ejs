<%
  var audioGroup = locals.audioGroup;
  var audioLabel = audioGroup && audioGroup._headingAudioLabel ? audioGroup._headingAudioLabel : 'passage';
  var audioControlClass = locals.audioControlClass || '';
%>
<div class="quran-passage-audio-control <%= audioControlClass %>" data-quran-passage-audio="1" data-quran-audio-scope="<%= audioGroup._audioScopeId %>" data-surah="<%= quranSelectionSurah %>" data-from="<%= audioGroup._audioStartAyah %>" data-to="<%= audioGroup._audioEndAyah %>"<% if (locals.audioRanges && locals.audioRanges.length) { %> data-quran-audio-ranges="<%= JSON.stringify(locals.audioRanges) %>"<% } %><% if (locals.repeatRanges && locals.repeatRanges.length) { %> data-quran-audio-repeat-ranges="<%= JSON.stringify(locals.repeatRanges) %>"<% } %>>
  <% if (locals.showTranslationSelect) { %>
  <span class="dropdown quran-passage-reciter-control quran-audio-translation-control">
    <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn quran-passage-reciter-toggle quran-audio-translation-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Choose translation" title="Choose translation">
      <span class="bi bi-translate" aria-hidden="true"></span>
    </button>
    <select class="visually-hidden" data-quran-audio-translation-select="1" aria-label="Translation" tabindex="-1">
      <option value="">Abdel Haleem</option>
    </select>
    <ul class="dropdown-menu quran-passage-reciter-menu quran-audio-translation-menu" data-quran-audio-translation-menu="1"></ul>
  </span>
  <% } %>
  <span class="dropdown quran-passage-reciter-control">
    <button type="button" class="btn btn-sm btn-outline-secondary quran-ayah-select-btn quran-passage-reciter-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Choose reciter" title="Choose reciter">
      <span class="bi bi-mic-fill" aria-hidden="true"></span>
    </button>
    <select class="visually-hidden quran-passage-reciter-select" data-quran-passage-reciter-select="1" aria-label="Reciter" tabindex="-1">
      <option value="juhani">Juhani</option>
    </select>
    <ul class="dropdown-menu quran-passage-reciter-menu" data-quran-passage-reciter-menu="1"></ul>
  </span>
  <div class="btn-group btn-group-sm" role="group" aria-label="Quran <%= audioLabel %> audio">
    <button type="button" class="btn btn-outline-secondary quran-ayah-select-btn quran-passage-audio-play" data-quran-passage-audio-play title="Play <%= audioLabel %>" aria-label="Play <%= audioLabel %>">
      <span class="bi bi-play-fill"></span>
    </button>
    <button type="button" class="btn btn-outline-secondary quran-ayah-select-btn quran-passage-audio-stop" data-quran-passage-audio-stop title="Stop audio" aria-label="Stop audio" disabled>
      <span class="bi bi-stop-fill"></span>
    </button>
    <button type="button" class="btn btn-outline-secondary quran-ayah-select-btn quran-passage-audio-repeat" data-quran-passage-audio-repeat title="Repeat Quran passage" aria-label="Repeat Quran passage" aria-pressed="false">
      <span class="bi bi-repeat"></span>
    </button>
  </div>
  <span class="visually-hidden" aria-live="polite" data-quran-passage-audio-status></span>
</div>
