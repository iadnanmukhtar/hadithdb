<form id="community-email-form" hidden>
  <section aria-labelledby="email-notifications-title">
    <h2 class="ux-section-title" id="email-notifications-title">Email notifications</h2>
    <div class="ux-inset-card">
      <div class="form-check form-switch email-master">
        <input id="community-email-enabled" class="form-check-input" type="checkbox" role="switch" name="enabled">
        <label class="form-check-label ux-emphasis" for="community-email-enabled">Receive email notifications</label>
      </div>
      <fieldset id="community-email-categories">
        <legend>Email me about</legend>
        <% for (const [key,label] of Object.entries({likes:'Likes',reflections:'Reflections and comments',replies:'Replies',reactions:'Reactions',articles:'Notes and articles from authors I follow'})) { %>
        <div class="form-check form-switch email-category">
          <input id="community-email-<%= key %>" class="form-check-input" type="checkbox" role="switch" name="<%= key %>">
          <label class="form-check-label" for="community-email-<%= key %>"><%= label %></label>
        </div>
        <% } %>
      </fieldset>
      <div class="email-actions">
        <button type="submit" class="ux-primary-action">Save preferences</button>
        <button id="community-email-stop" type="button" class="ux-text-action">Unsubscribe from all emails</button>
      </div>
      <p id="community-email-result" class="email-feedback" role="status"></p>
    </div>
  </section>
  <section aria-labelledby="email-authors-title">
    <h2 class="ux-section-title" id="email-authors-title">Author subscriptions</h2>
    <p>Choose whose notes and articles arrive by email. Enable notes and articles notifications above to receive them.</p>
    <div class="ux-inset-card">
      <div id="community-email-authors"></div>
      <p id="community-email-author-result" class="email-feedback" role="status"></p>
    </div>
  </section>
</form>
