		const setTypedCommentCount = (id, type, count) => {
			type = likeType(type);
			const safeCount = Number(count) || 0;
			loadedCommentCounts[likeKey(id, type)] = safeCount;
			Array.from(document.querySelectorAll(`.hadith-comment-count[data-hadith-id="${id}"]`)).filter(badge => getCommentElementType(badge) === type).forEach(badge => {
