<!--hadithdb-cache:footer:start-->
<%
	const hideBuyMeCoffeeFooter = typeof req !== 'undefined'
		&& req
		&& (
			req.path === '/quran/review'
			|| /^\/quran\/page(?:\/|$)/.test(req.path || '')
			|| (req.query && (
				req.query.mushaf !== undefined
				|| req.query.memorize !== undefined
				|| req.query.review !== undefined
			))
		);
%>
<footer class="col-lg-8 mx-auto p-3 py-md-5 text-center">
	<aside class="mb-1">
		<small class="fs-7 text-muted">
			<i class="bi bi-instagram"></i> <a class="text-muted" href="https://linktr.ee/i.adnan.mukhtar">@i.adnan.mukhtar</a>
			&nbsp;
			<i class="bi bi-rss-fill"></i> <a class="text-muted" href="/highlights/feed">Highlights RSS</a>
			&nbsp;
			<i class="bi bi-rss-fill"></i> <a class="text-muted" href="/liked/feed">Liked RSS</a>
		</small>
	</aside>
	<% if (!hideBuyMeCoffeeFooter) { %><aside class="mt-3" data-buy-me-coffee>
		<a href="https://www.buymeacoffee.com/adnanmukhtar"><img src="https://img.buymeacoffee.com/button-api/?text=Buy me a coffee&emoji=&slug=adnanmukhtar&button_colour=FF5F5F&font_colour=ffffff&font_family=Cookie&outline_colour=000000&coffee_colour=FFDD00" width="200" /></a>
	</aside><% } %>
</footer>

<script>
	(function () {
		if (!window.hadithUserSettingsCache) {
			const USER_SETTINGS_CACHE_PREFIX = 'hadithdb_user_settings:';
			const LEGACY_USER_SETTINGS_CACHE_PREFIX = 'hadithUserSettings:';
			const USER_SETTINGS_CACHE_MAX_AGE_MS = 60 * 60 * 1000;
			const settingsCacheStore = () => {
				try {
					return window.sessionStorage || null;
				} catch (_err) {
					return null;
				}
			};
			const clearLegacySettingsCache = (key, legacyKey) => {
				try { if (key) localStorage.removeItem(key); } catch (_err) {}
				try { if (legacyKey) localStorage.removeItem(legacyKey); } catch (_err) {}
			};
			const settingsUserId = (user) => {
				if (!user || typeof user !== 'object') return '';
				return (user.uid || user.userId || user.email || user.username || '').toString();
			};
			const settingsCacheKey = (user) => {
				const id = settingsUserId(user);
				return id ? `${USER_SETTINGS_CACHE_PREFIX}${id}` : '';
			};
			window.hadithUserSettingsShouldBypassCache = () => {
				const path = window.location && window.location.pathname ? window.location.pathname : '';
				return path === '/bookmarks' || path === '/bookmarks/';
			};
			const legacySettingsCacheKey = (user) => {
				const id = settingsUserId(user);
				return id ? `${LEGACY_USER_SETTINGS_CACHE_PREFIX}${id}` : '';
			};
			window.hadithUserSettingsCache = {
				read(user) {
					const key = settingsCacheKey(user);
					const legacyKey = legacySettingsCacheKey(user);
					if (!key) return null;
					const store = settingsCacheStore();
					if (!store) return null;
					clearLegacySettingsCache(key, legacyKey);
					try {
						const raw = store.getItem(key);
						if (!raw) return null;
						const payload = JSON.parse(raw);
						if (payload && payload.__hadithdbUserSettingsCache === 1) {
							if (!Number.isFinite(payload.cachedAt) || Date.now() - payload.cachedAt > USER_SETTINGS_CACHE_MAX_AGE_MS) {
								store.removeItem(key);
								return null;
							}
							return payload.settings || {};
						}
						store.removeItem(key);
						return null;
					} catch (err) {
						console.warn('Could not read cached user settings', err);
						try { store.removeItem(key); } catch (_err) {}
						return null;
					}
				},
				write(user, settings) {
					const key = settingsCacheKey(user);
					if (!key) return;
					const store = settingsCacheStore();
					if (!store) return;
					try {
						clearLegacySettingsCache(key, legacySettingsCacheKey(user));
						store.setItem(key, JSON.stringify({
							__hadithdbUserSettingsCache: 1,
							cachedAt: Date.now(),
							settings: settings || {}
						}));
					} catch (err) {
						console.warn('Could not cache user settings', err);
					}
				},
				clear(user) {
					const key = settingsCacheKey(user);
					const legacyKey = legacySettingsCacheKey(user);
					if (!key) return;
					const store = settingsCacheStore();
					try {
						if (store) store.removeItem(key);
						clearLegacySettingsCache(key, legacyKey);
					} catch (err) {
						console.warn('Could not clear cached user settings', err);
					}
				}
			};
		}
		if (window.hadithActionsInit) return;
		window.hadithActionsInit = true;
		const likedMap = {};
		const bookmarkMap = {};
		const headingBookmarkMap = {};
		const tafsirBookmarkMap = {};
		let mushafBookmarkPage = null;
		const bookmarkMetadata = {
			hadiths: {},
			headings: {},
			tafsirs: {}
		};
		const BOOKMARK_METADATA_SETTINGS_KEY = 'bookmarkMetadata';
		const BOOKMARK_METADATA_MAX_ENTRIES = 500;
		const loadedLikeIds = new Set();
		const pendingLikeIds = new Set();
		const loadingLikeIds = new Set();
		const loadedCommentCounts = {};
		const pendingCommentCountIds = new Set();
		const loadingCommentCountIds = new Set();
		const LIKE_KEY = 'hadithdb_liked_map';
		const LEGACY_LIKE_KEY = 'hadithLikedMap';
		const quranApiPath = (path) => {
			path = String(path || '');
			if (/^https?:\/\//i.test(path)) return path;
			if (path.charAt(0) !== '/') path = `/${path}`;
			const hostname = (window.location.hostname || '').toLowerCase();
			const isQuran = hostname.split('.')[0] === 'quran' || window.location.pathname === '/quran' || window.location.pathname.startsWith('/quran/');
			if (path === '/quran') path = '/';
			else if (path.startsWith('/quran/')) path = path.substring('/quran'.length);
			return `${isQuran ? '/quran/api' : '/api'}${path}`;
		};
		const USER_SETTINGS_ENDPOINT = quranApiPath('/user-settings');
		const USER_SETTINGS_OPTIONAL_ENDPOINT = `${USER_SETTINGS_ENDPOINT}?optional=1`;
		let userSettings = {};
		let bookmarkSettingsLoaded = false;
		const commentCountObserver = ('IntersectionObserver' in window) ? new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (!entry.isIntersecting) return;
				commentCountObserver.unobserve(entry.target);
				queueTypedCommentCount(entry.target.dataset.hadithId, entry.target.dataset.commentType);
			});
		}, { rootMargin: '250px 0px' }) : null;
		const likeObserver = ('IntersectionObserver' in window) ? new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (!entry.isIntersecting) return;
				likeObserver.unobserve(entry.target);
				queueLikeFetch(entry.target.dataset.hadithId, entry.target.dataset.likeType);
			});
		}, { rootMargin: '250px 0px' }) : null;

		const loadMap = (key, target, legacyKey) => {
			try {
				let raw = localStorage.getItem(key);
				const fromLegacy = !raw && legacyKey && localStorage.getItem(legacyKey);
				if (!raw && fromLegacy)
					raw = fromLegacy;
				if (raw) Object.assign(target, JSON.parse(raw));
				if (fromLegacy) {
					localStorage.setItem(key, raw);
					localStorage.removeItem(legacyKey);
				}
			} catch (err) {
				console.warn(`Could not load map for ${key}`, err);
			}
		};

		const persistMap = (key, map) => {
			try {
				if (Object.keys(map).length) {
					localStorage.setItem(key, JSON.stringify(map));
				} else {
					localStorage.removeItem(key);
				}
			} catch (err) {
				console.warn(`Could not persist map for ${key}`, err);
			}
		};

		const idsFromMap = (map) => Object.keys(map)
			.map(id => parseInt(id, 10))
			.filter(id => Number.isInteger(id) && id > 0);

		const tafsirRefsFromMap = (map) => Object.keys(map)
			.map(ref => String(ref || '').trim())
			.filter(ref => /^[A-Za-z0-9_-]+:[0-9]{1,3}:[0-9]{1,3}$/.test(ref));

		const replaceMap = (target, ids) => {
			Object.keys(target).forEach(key => delete target[key]);
			(Array.isArray(ids) ? ids : []).forEach(id => {
				const parsed = parseInt(id, 10);
				if (Number.isInteger(parsed) && parsed > 0) target[parsed] = true;
			});
		};

		const replaceStringMap = (target, values, pattern) => {
			Object.keys(target).forEach(key => delete target[key]);
			(Array.isArray(values) ? values : []).forEach(value => {
				value = String(value || '').trim();
				if (!pattern || pattern.test(value)) target[value] = true;
			});
		};

		const selectorValue = (value) => (window.CSS && CSS.escape) ? CSS.escape(value) : String(value).replace(/["\\]/g, '\\$&');

		const normalizeSettings = (settings) => {
			const source = settings && typeof settings === 'object' && !Array.isArray(settings) ? settings : {};
			const bookmarks = source.bookmarks && typeof source.bookmarks === 'object' && !Array.isArray(source.bookmarks)
				? source.bookmarks
				: {};
			const storedMetadata = source[BOOKMARK_METADATA_SETTINGS_KEY] && typeof source[BOOKMARK_METADATA_SETTINGS_KEY] === 'object' && !Array.isArray(source[BOOKMARK_METADATA_SETTINGS_KEY])
				? source[BOOKMARK_METADATA_SETTINGS_KEY]
				: {};
			return {
				...source,
				bookmarks: {
					hadiths: Array.from(new Set((Array.isArray(bookmarks.hadiths) ? bookmarks.hadiths : [])
						.map(id => parseInt(id, 10))
						.filter(id => Number.isInteger(id) && id > 0))),
					headings: Array.from(new Set((Array.isArray(bookmarks.headings) ? bookmarks.headings : [])
						.map(id => parseInt(id, 10))
						.filter(id => Number.isInteger(id) && id > 0))),
					tafsirs: Array.from(new Set((Array.isArray(bookmarks.tafsirs) ? bookmarks.tafsirs : [])
						.map(ref => String(ref || '').trim())
						.filter(ref => /^[A-Za-z0-9_-]+:[0-9]{1,3}:[0-9]{1,3}$/.test(ref)))),
					mushafPage: (() => {
						const page = parseInt(bookmarks.mushafPage, 10);
						return Number.isInteger(page) && page >= 1 && page <= 604 ? page : null;
					})()
				},
				bookmarkMetadata: {
					hadiths: normalizeBookmarkMetadata(storedMetadata.hadiths),
					headings: normalizeBookmarkMetadata(storedMetadata.headings),
					tafsirs: normalizeBookmarkMetadata(storedMetadata.tafsirs)
				}
			};
		};

		const settingsFromBookmarkMaps = () => normalizeSettings({
			...userSettings,
			bookmarks: {
				hadiths: idsFromMap(bookmarkMap),
				headings: idsFromMap(headingBookmarkMap),
				tafsirs: tafsirRefsFromMap(tafsirBookmarkMap),
				mushafPage: mushafBookmarkPage
			},
			[BOOKMARK_METADATA_SETTINGS_KEY]: {
				hadiths: bookmarkMetadata.hadiths,
				headings: bookmarkMetadata.headings,
				tafsirs: bookmarkMetadata.tafsirs
			}
		});

		const waitForHadithAuth = () => new Promise(resolve => {
			if (window.hadithAuth && window.hadithAuth.getToken) return resolve(window.hadithAuth);
			let attempts = 0;
			const timer = window.setInterval(() => {
				attempts += 1;
				if (window.hadithAuth && window.hadithAuth.getToken) {
					window.clearInterval(timer);
					resolve(window.hadithAuth);
				} else if (attempts >= 50) {
					window.clearInterval(timer);
					resolve(null);
				}
			}, 100);
		});

		const getSettingsToken = async (forceRefresh = false) => {
			const auth = await waitForHadithAuth();
			return auth && auth.getToken ? auth.getToken(forceRefresh) : null;
		};

		const getSettingsUser = async () => {
			const auth = await waitForHadithAuth();
			return auth && auth.getUser ? auth.getUser() : null;
		};

		const authHeaders = (token, extra = {}) => {
			return token ? { ...extra, 'Authorization': `Bearer ${token}` } : extra;
		};

		const syncMushafBookmarkCookie = () => {
			if (Number.isInteger(mushafBookmarkPage) && mushafBookmarkPage >= 1 && mushafBookmarkPage <= 604) {
				setHadithCookie('quranMushafBookmarkPage', mushafBookmarkPage, window.HADITH_SESSION_MAX_AGE);
			} else {
				clearHadithCookie('quranMushafBookmarkPage');
			}
		};

		const fetchUserSettings = async () => {
			let token = await getSettingsToken(true);
			let res = await fetch(USER_SETTINGS_OPTIONAL_ENDPOINT, {
				credentials: 'same-origin',
				headers: authHeaders(token)
			});
			if (res.status === 401) {
				token = await getSettingsToken(true);
				if (token) {
					res = await fetch(USER_SETTINGS_OPTIONAL_ENDPOINT, {
						credentials: 'same-origin',
						headers: authHeaders(token)
					});
				}
			}
			return res;
		};

		const saveBookmarkSettings = async () => {
			const settingsUser = await getSettingsUser();
			const token = await getSettingsToken();
			const settings = settingsFromBookmarkMaps();
			const res = await fetch(USER_SETTINGS_ENDPOINT, {
				method: 'PUT',
				credentials: 'same-origin',
				headers: authHeaders(token, { 'Content-Type': 'application/json' }),
				body: JSON.stringify({ settings })
			});
			if (!res.ok) throw new Error('Failed to save user settings');
			const data = await res.json();
			userSettings = normalizeSettings(data.settings || settings);
			window.hadithUserSettingsCache.write(settingsUser, userSettings);
			return true;
		};

		const applyBookmarkSettings = (settings) => {
			userSettings = normalizeSettings(settings);
			replaceMap(bookmarkMap, userSettings.bookmarks.hadiths);
			replaceMap(headingBookmarkMap, userSettings.bookmarks.headings);
			replaceStringMap(tafsirBookmarkMap, userSettings.bookmarks.tafsirs, /^[A-Za-z0-9_-]+:[0-9]{1,3}:[0-9]{1,3}$/);
			mushafBookmarkPage = userSettings.bookmarks.mushafPage;
			bookmarkMetadata.hadiths = normalizeBookmarkMetadata(userSettings.bookmarkMetadata && userSettings.bookmarkMetadata.hadiths);
			bookmarkMetadata.headings = normalizeBookmarkMetadata(userSettings.bookmarkMetadata && userSettings.bookmarkMetadata.headings);
			bookmarkMetadata.tafsirs = normalizeBookmarkMetadata(userSettings.bookmarkMetadata && userSettings.bookmarkMetadata.tafsirs);
			pruneBookmarkMetadata('hadiths', userSettings.bookmarks.hadiths);
			pruneBookmarkMetadata('headings', userSettings.bookmarks.headings);
			pruneBookmarkMetadata('tafsirs', userSettings.bookmarks.tafsirs);
			syncMushafBookmarkCookie();
		};

		const loadBookmarkSettings = async () => {
			try {
				const settingsUser = await getSettingsUser();
				const cachedSettings = window.hadithUserSettingsShouldBypassCache && window.hadithUserSettingsShouldBypassCache() ? null : window.hadithUserSettingsCache.read(settingsUser);
				if (cachedSettings) {
					applyBookmarkSettings(cachedSettings);
					return;
				}
				const res = await fetchUserSettings();
				if (!res) return;
				if (res.status === 401) {
					applyBookmarkSettings({});
					return;
				}
				if (!res.ok) throw new Error('Failed to load user settings');
				const data = await res.json();
				const settings = data.settings || {};
				applyBookmarkSettings(settings);
				window.hadithUserSettingsCache.write(settingsUser, normalizeSettings(settings));
			} catch (err) {
				console.warn('Could not load bookmark settings', err);
				toastr.warning('Unable to load saved bookmarks.', 'Bookmarks');
			} finally {
				bookmarkSettingsLoaded = true;
				initBookmarks();
				initHeadingBookmarks();
				initTafsirBookmarks();
				document.dispatchEvent(new CustomEvent('bookmarkSettingsLoaded'));
			}
		};

		const getButtons = () => Array.from(document.querySelectorAll('.hadith-like-btn[data-hadith-id]'));
		const getBookmarkButtons = () => Array.from(document.querySelectorAll('.hadith-bookmark-btn[data-hadith-id]'));
		const getHeadingBookmarkButtons = () => Array.from(document.querySelectorAll('.heading-bookmark-btn[data-heading-id]'));
		const getTafsirBookmarkButtons = () => Array.from(document.querySelectorAll('.tafsir-bookmark-btn[data-tafsir-bookmark-key]'));
		const getMushafBookmarkButtons = () => Array.from(document.querySelectorAll('.quran-mushaf-bookmark-btn[data-quran-mushaf-bookmark-page]'));
		const getCommentCountBadges = () => Array.from(document.querySelectorAll('.hadith-comment-count[data-hadith-id]'));
		const likeType = (value) => value === 'toc' ? 'toc' : 'hadith';
		const likeKey = (id, type) => `${likeType(type)}:${id}`;
		const commentWidgetOwnsCount = (id, type) => Array.from(document.querySelectorAll('.comment-feed[data-target-id][data-target-type]')).some(feed => {
			return String(feed.dataset.targetId) === String(id)
				&& likeType(feed.dataset.targetType) === likeType(type);
		});
		const getLikeElementType = (el) => likeType(el && el.dataset ? el.dataset.likeType : '');
		const getIcons = (id, type) => Array.from(document.querySelectorAll(`.hadith-like-icon[data-hadith-id="${id}"]`)).filter(icon => getLikeElementType(icon) === likeType(type));
		const getBookmarkIcons = (id) => Array.from(document.querySelectorAll(`.hadith-bookmark-icon[data-hadith-id="${id}"]`));
		const getHeadingBookmarkIcons = (id) => Array.from(document.querySelectorAll(`.heading-bookmark-icon[data-heading-id="${id}"]`));
		const getTafsirBookmarkIcons = (key) => Array.from(document.querySelectorAll(`.tafsir-bookmark-icon[data-tafsir-bookmark-key="${selectorValue(key)}"]`));
		const getCounts = (id, type) => Array.from(document.querySelectorAll(`.hadith-like-count[data-hadith-id="${id}"]`)).filter(count => getLikeElementType(count) === likeType(type));

		const isLiked = (id, type) => {
			const key = likeKey(id, type);
			if (likedMap[key] !== undefined) return !!likedMap[key];
			return likeType(type) === 'hadith' ? !!likedMap[id] : false;
		};

		const setLiked = (id, type, liked) => {
			likedMap[likeKey(id, type)] = !!liked;
			if (likeType(type) === 'hadith' && likedMap[id] !== undefined) delete likedMap[id];
		};

		const setState = (id, type, liked, likes) => {
			getIcons(id, type).forEach(icon => {
				icon.className = liked ? 'hadith-like-icon bi bi-heart-fill text-danger' : 'hadith-like-icon bi bi-heart text-danger';
			});
			if (typeof likes === 'number') {
				getCounts(id, type).forEach(countEl => countEl.textContent = likes);
			}
		};

		const setBookmarkState = (id, bookmarked) => {
			getBookmarkIcons(id).forEach(icon => {
				icon.className = bookmarked ? 'hadith-bookmark-icon bi bi-bookmark-fill text-accent' : 'hadith-bookmark-icon bi bi-bookmark text-accent';
			});
		};

		const setHeadingBookmarkState = (id, bookmarked) => {
			getHeadingBookmarkIcons(id).forEach(icon => {
				icon.className = bookmarked ? 'heading-bookmark-icon bi bi-bookmark-fill text-accent' : 'heading-bookmark-icon bi bi-bookmark text-accent';
			});
		};

		const setTafsirBookmarkState = (key, bookmarked) => {
			getTafsirBookmarkIcons(key).forEach(icon => {
				icon.className = bookmarked ? 'tafsir-bookmark-icon bi bi-bookmark-fill text-accent' : 'tafsir-bookmark-icon bi bi-bookmark text-accent';
			});
		};

		const setMushafBookmarkState = () => {
			syncMushafBookmarkCookie();
			getMushafBookmarkButtons().forEach(button => {
				const page = parseInt(button.dataset.quranMushafBookmarkPage, 10);
				const bookmarked = page === mushafBookmarkPage;
				const icon = button.querySelector('.quran-mushaf-bookmark-icon');
				if (icon) icon.className = bookmarked ? 'quran-mushaf-bookmark-icon bi bi-bookmark-fill text-accent' : 'quran-mushaf-bookmark-icon bi bi-bookmark text-accent';
				button.setAttribute('aria-pressed', bookmarked ? 'true' : 'false');
				button.title = `${bookmarked ? 'Remove bookmark from' : 'Bookmark'} Mushaf page ${page}`;
			});
		};

		const setCommentCount = (id, count) => {
			return setTypedCommentCount(id, 'hadith', count);
		};

		const getCommentElementType = (el) => likeType(el && el.dataset ? el.dataset.commentType : '');

		const textMetadataValue = (value) => {
			if (value === undefined || value === null) return '';
			return String(value)
				.replace(/\s+/g, ' ')
				.trim();
		};

		const normalizeBookmarkMetadata = (raw) => {
			if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return {};
			const normalized = {};
			Object.keys(raw).forEach((key) => {
				const value = raw[key];
				if (!value || typeof value !== 'object' || Array.isArray(value))
					return;
				const title = textMetadataValue(value.title);
				const titleAr = textMetadataValue(value.titleAr);
				const ref = textMetadataValue(value.ref);
				const url = textMetadataValue(value.url);
				const type = textMetadataValue(value.type);
				const body = textMetadataValue(value.body);
				const bodyAr = textMetadataValue(value.bodyAr);
				const range = textMetadataValue(value.range);
				const entry = {};
				if (title) entry.title = title;
				if (titleAr) entry.titleAr = titleAr;
				if (ref) entry.ref = ref;
				if (url) entry.url = url;
				if (type) entry.type = type;
				if (body) entry.body = body;
				if (bodyAr) entry.bodyAr = bodyAr;
				if (range) entry.range = range;
				if (Object.keys(entry).length) normalized[String(key)] = entry;
			});
			return normalized;
		};

		const cloneBookmarkMetadata = (category) => {
			const source = bookmarkMetadata[category] || {};
			return Object.keys(source).reduce((acc, key) => {
				acc[key] = { ...source[key] };
				return acc;
			}, {});
		};

		const restoreBookmarkMetadata = (category, entries) => {
			bookmarkMetadata[category] = {};
			Object.keys(entries || {}).forEach(key => {
				bookmarkMetadata[category][key] = { ...(entries[key] || {}) };
			});
		};

		const pruneBookmarkMetadata = (category, validIds) => {
			const valid = new Set((Array.isArray(validIds) ? validIds : []).map(id => String(id)));
			const source = bookmarkMetadata[category];
			if (!source) return;
			Object.keys(source).forEach((id) => {
				if (!valid.has(id)) delete source[id];
			});
		};

		const syncBookmarkMetadataState = (category, key, value) => {
			if (!bookmarkMetadata[category]) return;
			const id = String(key);
			const normalized = normalizeBookmarkMetadata({ [id]: value })[id];
			if (!normalized) {
				delete bookmarkMetadata[category][id];
				return;
			}
			bookmarkMetadata[category][id] = normalized;
		};

		const setBookmarkMetadata = (category, key, value) => {
			if (!bookmarkMetadata[category]) return;
			syncBookmarkMetadataState(category, key, value);
			if (value) truncateMetadataMap(category);
		};

		const truncateMetadataMap = (category) => {
			const source = bookmarkMetadata[category];
			if (!source) return;
			const ids = Object.keys(source);
			while (ids.length > BOOKMARK_METADATA_MAX_ENTRIES) {
				const removedId = ids.shift();
				delete source[removedId];
			}
		};

		const resolveBookmarkMetadataFromButton = (button, fallback = {}) => {
			if (!button) return fallback;
			const fromDataset = {
				ref: textMetadataValue(button.dataset.bookmarkRef),
				title: textMetadataValue(button.dataset.bookmarkTitle),
				titleAr: textMetadataValue(button.dataset.bookmarkTitleAr),
				url: textMetadataValue(button.dataset.bookmarkUrl),
				type: textMetadataValue(button.dataset.bookmarkType),
				body: textMetadataValue(button.dataset.bookmarkBody),
				bodyAr: textMetadataValue(button.dataset.bookmarkBodyAr),
				range: textMetadataValue(button.dataset.bookmarkRange)
			};
			if (fromDataset.title || fromDataset.titleAr || fromDataset.ref || fromDataset.url || fromDataset.type || fromDataset.body || fromDataset.bodyAr || fromDataset.range) return fromDataset;
			const container = button.closest('article, section, tr, .chapter, .heading, .row') || button.parentElement;
			if (!container) return fallback;
			const anchor = container.querySelector('a[href]');
			const title = textMetadataValue(anchor && anchor.title ? anchor.title : (anchor ? anchor.textContent : ''));
			const linkRef = textMetadataValue(anchor ? anchor.getAttribute('href') : '');
			const resolved = {
				ref: fromDataset.ref || linkRef || title,
				title: fromDataset.title || textMetadataValue(anchor ? anchor.textContent : ''),
				titleAr: fromDataset.titleAr,
				url: fromDataset.url || linkRef,
				type: fromDataset.type,
				body: fromDataset.body,
				bodyAr: fromDataset.bodyAr,
				range: fromDataset.range
			};
			return resolved.title || resolved.ref ? resolved : fallback;
