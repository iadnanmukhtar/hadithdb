<footer class="col-lg-8 mx-auto p-3 py-md-5 text-center">
	<aside class="mb-1">
		<small class="fs-7 text-muted">
			<i class="bi bi-instagram"></i> <a class="text-muted" href="https://linktr.ee/i.adnan.mukhtar">@i.adnan.mukhtar</a>
			&nbsp;
			<i class="bi bi-rss-fill"></i> <a class="text-muted" href="/highlights/feed">Highlights RSS</a>
			&nbsp;
			<i class="bi bi-rss-fill"></i> <a class="text-muted" href="/liked/feed">Liked RSS</a>
		</small>
	</aside>
	<aside class="mt-3">
		<a href="https://www.buymeacoffee.com/adnanmukhtar"><img src="https://img.buymeacoffee.com/button-api/?text=Buy me a coffee&emoji=&slug=adnanmukhtar&button_colour=FF5F5F&font_colour=ffffff&font_family=Cookie&outline_colour=000000&coffee_colour=FFDD00" width="200" /></a>
	</aside>
</footer>

<script>
	(function () {
		if (!window.hadithUserSettingsCache) {
			const USER_SETTINGS_CACHE_PREFIX = 'hadithUserSettings:';
			const settingsUserId = (user) => {
				if (!user || typeof user !== 'object') return '';
				return (user.uid || user.userId || user.email || user.username || '').toString();
			};
			const settingsCacheKey = (user) => {
				const id = settingsUserId(user);
				return id ? `${USER_SETTINGS_CACHE_PREFIX}${id}` : '';
			};
			window.hadithUserSettingsCache = {
				read(user) {
					const key = settingsCacheKey(user);
					if (!key) return null;
					try {
						const raw = localStorage.getItem(key);
						return raw ? JSON.parse(raw) : null;
					} catch (err) {
						console.warn('Could not read cached user settings', err);
						return null;
					}
				},
				write(user, settings) {
					const key = settingsCacheKey(user);
					if (!key) return;
					try {
						localStorage.setItem(key, JSON.stringify(settings || {}));
					} catch (err) {
						console.warn('Could not cache user settings', err);
					}
				},
				clear(user) {
					const key = settingsCacheKey(user);
					if (!key) return;
					try {
						localStorage.removeItem(key);
					} catch (err) {
						console.warn('Could not clear cached user settings', err);
					}
				}
			};
		}
		if (window.hadithActionsInit) return;
		window.hadithActionsInit = true;
		const likedMap = {};
		const bookmarkMap = {};
		const headingBookmarkMap = {};
		const tafsirBookmarkMap = {};
		const loadedLikeIds = new Set();
		const pendingLikeIds = new Set();
		const loadingLikeIds = new Set();
		const loadedCommentCounts = {};
		const pendingCommentCountIds = new Set();
		const loadingCommentCountIds = new Set();
		const LIKE_KEY = 'hadithLikedMap';
		const quranApiPath = (path) => {
			path = String(path || '');
			if (path.charAt(0) !== '/') path = `/${path}`;
			const hostname = (window.location.hostname || '').toLowerCase();
			if (hostname.split('.')[0] !== 'quran' || path === '/quran' || path.startsWith('/quran/')) return path;
			return `/quran${path}`;
		};
		const USER_SETTINGS_ENDPOINT = quranApiPath('/user-settings');
		const USER_SETTINGS_OPTIONAL_ENDPOINT = `${USER_SETTINGS_ENDPOINT}?optional=1`;
		let userSettings = {};
		let bookmarkSettingsLoaded = false;
		const commentCountObserver = ('IntersectionObserver' in window) ? new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (!entry.isIntersecting) return;
				commentCountObserver.unobserve(entry.target);
				queueCommentCount(entry.target.dataset.hadithId);
			});
		}, { rootMargin: '250px 0px' }) : null;
		const likeObserver = ('IntersectionObserver' in window) ? new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (!entry.isIntersecting) return;
				likeObserver.unobserve(entry.target);
				queueLikeFetch(entry.target.dataset.hadithId);
			});
		}, { rootMargin: '250px 0px' }) : null;

		const loadMap = (key, target) => {
			try {
				const raw = localStorage.getItem(key);
				if (raw) Object.assign(target, JSON.parse(raw));
			} catch (err) {
				console.warn(`Could not load map for ${key}`, err);
			}
		};

		const persistMap = (key, map) => {
			try {
				if (Object.keys(map).length) {
					localStorage.setItem(key, JSON.stringify(map));
				} else {
					localStorage.removeItem(key);
				}
			} catch (err) {
				console.warn(`Could not persist map for ${key}`, err);
			}
		};

		const idsFromMap = (map) => Object.keys(map)
			.map(id => parseInt(id, 10))
			.filter(id => Number.isInteger(id) && id > 0);

		const tafsirRefsFromMap = (map) => Object.keys(map)
			.map(ref => String(ref || '').trim())
			.filter(ref => /^[A-Za-z0-9_-]+:[0-9]{1,3}:[0-9]{1,3}$/.test(ref));

		const replaceMap = (target, ids) => {
			Object.keys(target).forEach(key => delete target[key]);
			(Array.isArray(ids) ? ids : []).forEach(id => {
				const parsed = parseInt(id, 10);
				if (Number.isInteger(parsed) && parsed > 0) target[parsed] = true;
			});
		};

		const replaceStringMap = (target, values, pattern) => {
			Object.keys(target).forEach(key => delete target[key]);
			(Array.isArray(values) ? values : []).forEach(value => {
				value = String(value || '').trim();
				if (!pattern || pattern.test(value)) target[value] = true;
			});
		};

		const selectorValue = (value) => (window.CSS && CSS.escape) ? CSS.escape(value) : String(value).replace(/["\\]/g, '\\$&');

		const normalizeSettings = (settings) => {
			const source = settings && typeof settings === 'object' && !Array.isArray(settings) ? settings : {};
			const bookmarks = source.bookmarks && typeof source.bookmarks === 'object' && !Array.isArray(source.bookmarks)
				? source.bookmarks
				: {};
			return {
				...source,
				bookmarks: {
					hadiths: Array.from(new Set((Array.isArray(bookmarks.hadiths) ? bookmarks.hadiths : [])
						.map(id => parseInt(id, 10))
						.filter(id => Number.isInteger(id) && id > 0))),
					headings: Array.from(new Set((Array.isArray(bookmarks.headings) ? bookmarks.headings : [])
						.map(id => parseInt(id, 10))
						.filter(id => Number.isInteger(id) && id > 0))),
					tafsirs: Array.from(new Set((Array.isArray(bookmarks.tafsirs) ? bookmarks.tafsirs : [])
						.map(ref => String(ref || '').trim())
						.filter(ref => /^[A-Za-z0-9_-]+:[0-9]{1,3}:[0-9]{1,3}$/.test(ref))))
				}
			};
		};

		const settingsFromBookmarkMaps = () => normalizeSettings({
			...userSettings,
			bookmarks: {
				hadiths: idsFromMap(bookmarkMap),
				headings: idsFromMap(headingBookmarkMap),
				tafsirs: tafsirRefsFromMap(tafsirBookmarkMap)
			}
		});

		const waitForHadithAuth = () => new Promise(resolve => {
			if (window.hadithAuth && window.hadithAuth.getToken) return resolve(window.hadithAuth);
			let attempts = 0;
			const timer = window.setInterval(() => {
				attempts += 1;
				if (window.hadithAuth && window.hadithAuth.getToken) {
					window.clearInterval(timer);
					resolve(window.hadithAuth);
				} else if (attempts >= 50) {
					window.clearInterval(timer);
					resolve(null);
				}
			}, 100);
		});

		const getSettingsToken = async (forceRefresh = false) => {
			const auth = await waitForHadithAuth();
			return auth && auth.getToken ? auth.getToken(forceRefresh) : null;
		};

		const getSettingsUser = async () => {
			const auth = await waitForHadithAuth();
			return auth && auth.getUser ? auth.getUser() : null;
		};

		const authHeaders = (token, extra = {}) => {
			return token ? { ...extra, 'Authorization': `Bearer ${token}` } : extra;
		};

		const fetchUserSettings = async () => {
			let token = await getSettingsToken(true);
			let res = await fetch(USER_SETTINGS_OPTIONAL_ENDPOINT, {
				credentials: 'same-origin',
				headers: authHeaders(token)
			});
			if (res.status === 401) {
				token = await getSettingsToken(true);
				if (token) {
					res = await fetch(USER_SETTINGS_OPTIONAL_ENDPOINT, {
						credentials: 'same-origin',
						headers: authHeaders(token)
					});
				}
			}
			return res;
		};

		const saveBookmarkSettings = async () => {
			const settingsUser = await getSettingsUser();
			const token = await getSettingsToken();
			const settings = settingsFromBookmarkMaps();
			const res = await fetch(USER_SETTINGS_ENDPOINT, {
				method: 'PUT',
				credentials: 'same-origin',
				headers: authHeaders(token, { 'Content-Type': 'application/json' }),
				body: JSON.stringify({ settings })
			});
			if (!res.ok) throw new Error('Failed to save user settings');
			const data = await res.json();
			userSettings = normalizeSettings(data.settings || settings);
			window.hadithUserSettingsCache.write(settingsUser, userSettings);
			return true;
		};

		const applyBookmarkSettings = (settings) => {
			userSettings = normalizeSettings(settings);
			replaceMap(bookmarkMap, userSettings.bookmarks.hadiths);
			replaceMap(headingBookmarkMap, userSettings.bookmarks.headings);
			replaceStringMap(tafsirBookmarkMap, userSettings.bookmarks.tafsirs, /^[A-Za-z0-9_-]+:[0-9]{1,3}:[0-9]{1,3}$/);
		};

		const loadBookmarkSettings = async () => {
			try {
				const settingsUser = await getSettingsUser();
				const cachedSettings = window.hadithUserSettingsCache.read(settingsUser);
				if (cachedSettings) {
					applyBookmarkSettings(cachedSettings);
					return;
				}
				const res = await fetchUserSettings();
				if (!res) return;
				if (res.status === 401) {
					applyBookmarkSettings({});
					return;
				}
				if (!res.ok) throw new Error('Failed to load user settings');
				const data = await res.json();
				const settings = data.settings || {};
				applyBookmarkSettings(settings);
				window.hadithUserSettingsCache.write(settingsUser, normalizeSettings(settings));
			} catch (err) {
				console.warn('Could not load bookmark settings', err);
				toastr.warning('Unable to load saved bookmarks.', 'Bookmarks');
			} finally {
				bookmarkSettingsLoaded = true;
				initBookmarks();
				initHeadingBookmarks();
				initTafsirBookmarks();
				document.dispatchEvent(new CustomEvent('bookmarkSettingsLoaded'));
			}
		};

		const getButtons = () => Array.from(document.querySelectorAll('.hadith-like-btn[data-hadith-id]'));
		const getBookmarkButtons = () => Array.from(document.querySelectorAll('.hadith-bookmark-btn[data-hadith-id]'));
		const getHeadingBookmarkButtons = () => Array.from(document.querySelectorAll('.heading-bookmark-btn[data-heading-id]'));
		const getTafsirBookmarkButtons = () => Array.from(document.querySelectorAll('.tafsir-bookmark-btn[data-tafsir-bookmark-key]'));
		const getCommentCountBadges = () => Array.from(document.querySelectorAll('.hadith-comment-count[data-hadith-id]'));
		const getIcons = (id) => Array.from(document.querySelectorAll(`.hadith-like-icon[data-hadith-id="${id}"]`));
		const getBookmarkIcons = (id) => Array.from(document.querySelectorAll(`.hadith-bookmark-icon[data-hadith-id="${id}"]`));
		const getHeadingBookmarkIcons = (id) => Array.from(document.querySelectorAll(`.heading-bookmark-icon[data-heading-id="${id}"]`));
		const getTafsirBookmarkIcons = (key) => Array.from(document.querySelectorAll(`.tafsir-bookmark-icon[data-tafsir-bookmark-key="${selectorValue(key)}"]`));
		const getCounts = (id) => Array.from(document.querySelectorAll(`.hadith-like-count[data-hadith-id="${id}"]`));

		const setState = (id, liked, likes) => {
			getIcons(id).forEach(icon => {
				icon.className = liked ? 'hadith-like-icon bi bi-heart-fill text-danger' : 'hadith-like-icon bi bi-heart text-danger';
			});
			if (typeof likes === 'number') {
				getCounts(id).forEach(countEl => countEl.textContent = likes);
			}
		};

		const setBookmarkState = (id, bookmarked) => {
			getBookmarkIcons(id).forEach(icon => {
				icon.className = bookmarked ? 'hadith-bookmark-icon bi bi-bookmark-fill text-accent' : 'hadith-bookmark-icon bi bi-bookmark text-accent';
			});
		};

		const setHeadingBookmarkState = (id, bookmarked) => {
			getHeadingBookmarkIcons(id).forEach(icon => {
				icon.className = bookmarked ? 'heading-bookmark-icon bi bi-bookmark-fill text-accent' : 'heading-bookmark-icon bi bi-bookmark text-accent';
			});
		};

		const setTafsirBookmarkState = (key, bookmarked) => {
			getTafsirBookmarkIcons(key).forEach(icon => {
				icon.className = bookmarked ? 'tafsir-bookmark-icon bi bi-bookmark-fill text-accent' : 'tafsir-bookmark-icon bi bi-bookmark text-accent';
			});
		};

		const setCommentCount = (id, count) => {
			const safeCount = Number(count) || 0;
			loadedCommentCounts[id] = safeCount;
			Array.from(document.querySelectorAll(`.hadith-comment-count[data-hadith-id="${id}"]`)).forEach(badge => {
				badge.textContent = safeCount;
				badge.title = `${safeCount} reflection${safeCount === 1 ? '' : 's'}`;
			});
		};

		const scheduleCommentCountFlush = () => {
			if (window.requestIdleCallback) {
				window.requestIdleCallback(loadQueuedCommentCounts, { timeout: 1000 });
			} else {
				window.setTimeout(loadQueuedCommentCounts, 75);
			}
		};

		const queueCommentCount = (rawId) => {
			const id = parseInt(rawId);
			if (Number.isNaN(id) || loadedCommentCounts[id] !== undefined || loadingCommentCountIds.has(id)) return;
			const shouldSchedule = pendingCommentCountIds.size === 0;
			pendingCommentCountIds.add(id);
			if (shouldSchedule) scheduleCommentCountFlush();
		};

		const loadQueuedCommentCounts = async () => {
			const ids = Array.from(pendingCommentCountIds).filter(id => !loadingCommentCountIds.has(id));
			if (!ids.length) return;
			ids.forEach(id => {
				pendingCommentCountIds.delete(id);
				loadingCommentCountIds.add(id);
			});
			try {
				const counts = {};
				for (let offset = 0; offset < ids.length; offset += 100) {
						const res = await fetch(quranApiPath(`/comments/counts?ids=${ids.slice(offset, offset + 100).join(',')}`));
					if (!res.ok) throw new Error('Failed reflection count fetch');
					const data = await res.json();
					Object.assign(counts, data.counts || {});
				}
				ids.forEach(id => setCommentCount(id, counts[id]));
			} catch (err) {
				console.warn('Could not load reflection counts', err);
			} finally {
				ids.forEach(id => loadingCommentCountIds.delete(id));
			}
		};

		const initCommentCounts = () => {
			getCommentCountBadges().forEach(badge => {
				const id = parseInt(badge.dataset.hadithId);
				if (Number.isNaN(id)) return;
				if (loadedCommentCounts[id] !== undefined) {
					setCommentCount(id, loadedCommentCounts[id]);
					return;
				}
				if (badge.dataset.commentCountLazyInit === '1') return;
				badge.dataset.commentCountLazyInit = '1';
				if (commentCountObserver) {
					commentCountObserver.observe(badge);
				} else {
					queueCommentCount(id);
				}
			});
		};

		const refreshVisibleCommentCounts = () => {
			getCommentCountBadges().forEach(badge => {
				const box = badge.getBoundingClientRect();
				if (box.width > 0 && box.height > 0 && box.bottom >= -250 && box.top <= window.innerHeight + 250) {
					queueCommentCount(badge.dataset.hadithId);
				}
			});
		};

		document.addEventListener('shown.bs.modal', refreshVisibleCommentCounts);
		document.addEventListener('hadithCommentCountChanged', event => {
			const id = parseInt(event.detail && event.detail.hadithId);
			const count = Number(event.detail && event.detail.count);
			if (!Number.isNaN(id) && Number.isFinite(count)) {
				setCommentCount(id, count);
			}
		});

		const requireLogin = () => {
			if (window.hadithAuth && window.hadithAuth.requireLogin) window.hadithAuth.requireLogin();
			toastr.error('Please sign in to like or comment.', 'Sign-in required');
		};

		const requireBookmarkLogin = () => {
			toastr.error('Please sign in to save bookmarks.', 'Sign-in required');
		};

		const waitForBookmarkSettingsLoad = async () => {
			if (!bookmarkSettingsLoaded && bookmarkSettingsReady)
				await bookmarkSettingsReady;
		};

		const queueLikeFetch = (rawId) => {
			const id = parseInt(rawId);
			if (Number.isNaN(id) || loadedLikeIds.has(id) || pendingLikeIds.has(id) || loadingLikeIds.has(id)) return;
			pendingLikeIds.add(id);
			const load = () => {
				pendingLikeIds.delete(id);
				fetchLikes(id);
			};
			if (window.requestIdleCallback) window.requestIdleCallback(load, { timeout: 1000 });
			else window.setTimeout(load, 75);
		};

		const refreshVisibleLikes = () => {
			getButtons().forEach(btn => {
				const box = btn.getBoundingClientRect();
				if (box.width > 0 && box.height > 0 && box.bottom >= -250 && box.top <= window.innerHeight + 250) {
					queueLikeFetch(btn.dataset.hadithId);
				}
			});
		};

		document.addEventListener('shown.bs.modal', refreshVisibleLikes);

		const fetchLikes = async (id) => {
			if (loadedLikeIds.has(id) || loadingLikeIds.has(id)) return;
			loadingLikeIds.add(id);
			const token = window.hadithAuth && window.hadithAuth.getToken ? await window.hadithAuth.getToken() : null;
			try {
				const res = await fetch(quranApiPath(`/likes/${id}`), {
					credentials: 'same-origin',
					headers: authHeaders(token)
				});
				if (!res.ok) throw new Error('Failed likes fetch');
				const data = await res.json();
				if (typeof data.liked === 'boolean') {
					likedMap[id] = data.liked;
					persistMap(LIKE_KEY, likedMap);
				}
				setState(id, !!likedMap[id], data.likes ?? 0);
				loadedLikeIds.add(id);
			} catch (err) {
				console.warn('Could not load likes', err);
			} finally {
				loadingLikeIds.delete(id);
			}
		};

		const toggleLike = async (id, btn) => {
			const action = likedMap[id] ? 'unlike' : 'like';
			const token = window.hadithAuth && window.hadithAuth.getToken ? await window.hadithAuth.getToken() : null;
			const user = window.hadithAuth && window.hadithAuth.getUser ? await window.hadithAuth.getUser() : null;
			if (!token && !user) {
				requireLogin();
				return;
			}
			try {
				btn.disabled = true;
				const res = await fetch(quranApiPath(`/likes/${id}`), {
					method: 'POST',
					credentials: 'same-origin',
					headers: authHeaders(token, { 'Content-Type': 'application/json' }),
					body: JSON.stringify({ action })
				});
				if (!res.ok) throw new Error('Failed like');
				const data = await res.json();
				if (typeof data.liked === 'boolean') likedMap[id] = data.liked;
				persistMap(LIKE_KEY, likedMap);
				loadedLikeIds.add(id);
				setState(id, !!likedMap[id], data.likes ?? null);
			} catch (err) {
				console.warn('Could not like', err);
			} finally {
				btn.disabled = false;
			}
		};

		const toggleBookmark = async (id) => {
			await waitForBookmarkSettingsLoad();
			const token = await getSettingsToken();
			const user = window.hadithAuth && window.hadithAuth.getUser ? await window.hadithAuth.getUser() : null;
			if (!token && !user) {
				requireBookmarkLogin();
				return;
			}
			const bookmarked = !bookmarkMap[id];
			if (bookmarked) bookmarkMap[id] = true;
			else delete bookmarkMap[id];
			setBookmarkState(id, bookmarked);
			document.dispatchEvent(new CustomEvent('hadithBookmarkToggled', {
				detail: { hadithId: id, bookmarked }
			}));
			try {
				await saveBookmarkSettings();
			} catch (err) {
				if (bookmarked) delete bookmarkMap[id];
				else bookmarkMap[id] = true;
				setBookmarkState(id, !bookmarked);
				document.dispatchEvent(new CustomEvent('hadithBookmarkToggled', {
					detail: { hadithId: id, bookmarked: !bookmarked }
				}));
				toastr.error('Could not save bookmark. Please try again.', 'Bookmarks');
				console.warn('Could not save bookmark', err);
			}
		};

		const removeBookmark = async (id) => {
			await waitForBookmarkSettingsLoad();
			if (!bookmarkMap[id]) return;
			delete bookmarkMap[id];
			setBookmarkState(id, false);
			document.dispatchEvent(new CustomEvent('hadithBookmarkToggled', {
				detail: { hadithId: id, bookmarked: false }
			}));
			try {
				await saveBookmarkSettings();
			} catch (err) {
				bookmarkMap[id] = true;
				setBookmarkState(id, true);
				document.dispatchEvent(new CustomEvent('hadithBookmarkToggled', {
					detail: { hadithId: id, bookmarked: true }
				}));
				toastr.error('Could not remove bookmark. Please try again.', 'Bookmarks');
				console.warn('Could not remove bookmark', err);
			}
		};

		const toggleHeadingBookmark = async (id) => {
			await waitForBookmarkSettingsLoad();
			const token = await getSettingsToken();
			const user = window.hadithAuth && window.hadithAuth.getUser ? await window.hadithAuth.getUser() : null;
			if (!token && !user) {
				requireBookmarkLogin();
				return;
			}
			const bookmarked = !headingBookmarkMap[id];
			if (bookmarked) headingBookmarkMap[id] = true;
			else delete headingBookmarkMap[id];
			setHeadingBookmarkState(id, bookmarked);
			document.dispatchEvent(new CustomEvent('headingBookmarkToggled', {
				detail: { headingId: id, bookmarked }
			}));
			try {
				await saveBookmarkSettings();
			} catch (err) {
				if (bookmarked) delete headingBookmarkMap[id];
				else headingBookmarkMap[id] = true;
				setHeadingBookmarkState(id, !bookmarked);
				document.dispatchEvent(new CustomEvent('headingBookmarkToggled', {
					detail: { headingId: id, bookmarked: !bookmarked }
				}));
				toastr.error('Could not save bookmark. Please try again.', 'Bookmarks');
				console.warn('Could not save heading bookmark', err);
			}
		};

		const removeHeadingBookmark = async (id) => {
			await waitForBookmarkSettingsLoad();
			if (!headingBookmarkMap[id]) return;
			delete headingBookmarkMap[id];
			setHeadingBookmarkState(id, false);
			document.dispatchEvent(new CustomEvent('headingBookmarkToggled', {
				detail: { headingId: id, bookmarked: false }
			}));
			try {
				await saveBookmarkSettings();
			} catch (err) {
				headingBookmarkMap[id] = true;
				setHeadingBookmarkState(id, true);
				document.dispatchEvent(new CustomEvent('headingBookmarkToggled', {
					detail: { headingId: id, bookmarked: true }
				}));
				toastr.error('Could not remove bookmark. Please try again.', 'Bookmarks');
				console.warn('Could not remove heading bookmark', err);
			}
		};

		const toggleTafsirBookmark = async (key) => {
			await waitForBookmarkSettingsLoad();
			const token = await getSettingsToken();
			const user = window.hadithAuth && window.hadithAuth.getUser ? await window.hadithAuth.getUser() : null;
			if (!token && !user) {
				requireBookmarkLogin();
				return;
			}
			const bookmarked = !tafsirBookmarkMap[key];
			if (bookmarked) tafsirBookmarkMap[key] = true;
			else delete tafsirBookmarkMap[key];
			setTafsirBookmarkState(key, bookmarked);
			document.dispatchEvent(new CustomEvent('tafsirBookmarkToggled', {
				detail: { tafsirKey: key, bookmarked }
			}));
			try {
				await saveBookmarkSettings();
			} catch (err) {
				if (bookmarked) delete tafsirBookmarkMap[key];
				else tafsirBookmarkMap[key] = true;
				setTafsirBookmarkState(key, !bookmarked);
				document.dispatchEvent(new CustomEvent('tafsirBookmarkToggled', {
					detail: { tafsirKey: key, bookmarked: !bookmarked }
				}));
				toastr.error('Could not save bookmark. Please try again.', 'Bookmarks');
				console.warn('Could not save tafsir bookmark', err);
			}
		};

		const removeTafsirBookmark = async (key) => {
			await waitForBookmarkSettingsLoad();
			if (!tafsirBookmarkMap[key]) return;
			delete tafsirBookmarkMap[key];
			setTafsirBookmarkState(key, false);
			document.dispatchEvent(new CustomEvent('tafsirBookmarkToggled', {
				detail: { tafsirKey: key, bookmarked: false }
			}));
			try {
				await saveBookmarkSettings();
			} catch (err) {
				tafsirBookmarkMap[key] = true;
				setTafsirBookmarkState(key, true);
				document.dispatchEvent(new CustomEvent('tafsirBookmarkToggled', {
					detail: { tafsirKey: key, bookmarked: true }
				}));
				toastr.error('Could not remove bookmark. Please try again.', 'Bookmarks');
				console.warn('Could not remove tafsir bookmark', err);
			}
		};

		const initLikes = () => {
			getButtons().forEach(btn => {
				const id = parseInt(btn.dataset.hadithId);
				if (Number.isNaN(id)) return;
				setState(id, !!likedMap[id], null);
				if (btn.dataset.hadithLikeInit === '1') return;
				btn.dataset.hadithLikeInit = '1';
				btn.addEventListener('click', () => toggleLike(id, btn));
				if (likeObserver) {
					likeObserver.observe(btn);
				} else {
					queueLikeFetch(id);
				}
			});
		};

		const initBookmarks = () => {
			getBookmarkButtons().forEach(btn => {
				const id = parseInt(btn.dataset.hadithId);
				if (Number.isNaN(id)) return;
				setBookmarkState(id, !!bookmarkMap[id]);
				if (btn.dataset.hadithBookmarkInit === '1') return;
				btn.dataset.hadithBookmarkInit = '1';
				btn.addEventListener('click', () => toggleBookmark(id));
			});
		};

		const initHeadingBookmarks = () => {
			getHeadingBookmarkButtons().forEach(btn => {
				const id = parseInt(btn.dataset.headingId);
				if (Number.isNaN(id)) return;
				setHeadingBookmarkState(id, !!headingBookmarkMap[id]);
				if (btn.dataset.headingBookmarkInit === '1') return;
				btn.dataset.headingBookmarkInit = '1';
				btn.addEventListener('click', () => toggleHeadingBookmark(id));
			});
		};

		const initTafsirBookmarks = () => {
			getTafsirBookmarkButtons().forEach(btn => {
				const key = String(btn.dataset.tafsirBookmarkKey || '').trim();
				if (!/^[A-Za-z0-9_-]+:[0-9]{1,3}:[0-9]{1,3}$/.test(key)) return;
				setTafsirBookmarkState(key, !!tafsirBookmarkMap[key]);
				if (btn.dataset.tafsirBookmarkInit === '1') return;
				btn.dataset.tafsirBookmarkInit = '1';
				btn.addEventListener('click', () => toggleTafsirBookmark(key));
			});
		};

		const init = () => {
			initLikes();
			initBookmarks();
			initHeadingBookmarks();
			initTafsirBookmarks();
			initCommentCounts();
		};

		loadMap(LIKE_KEY, likedMap);
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init);
		} else {
			init();
		}
		const bookmarkSettingsReady = loadBookmarkSettings();
		window.refreshHadithActions = init;
		window.refreshHeadingBookmarks = initHeadingBookmarks;
		window.refreshTafsirBookmarks = initTafsirBookmarks;
		window.hadithBookmarks = {
			ready: bookmarkSettingsReady,
			getAll: () => Object.keys(bookmarkMap).map(id => parseInt(id, 10)).filter(id => !Number.isNaN(id)),
			remove: removeBookmark,
			clear: async () => {
				await waitForBookmarkSettingsLoad();
				const previous = { ...bookmarkMap };
				Object.keys(bookmarkMap).forEach(key => delete bookmarkMap[key]);
				initBookmarks();
				document.dispatchEvent(new CustomEvent('hadithBookmarksCleared'));
				try {
					await saveBookmarkSettings();
				} catch (err) {
					replaceMap(bookmarkMap, idsFromMap(previous));
					initBookmarks();
					document.dispatchEvent(new CustomEvent('hadithBookmarkToggled'));
					toastr.error('Could not clear bookmarks. Please try again.', 'Bookmarks');
					console.warn('Could not clear hadith bookmarks', err);
				}
			}
		};
		window.headingBookmarks = {
			ready: bookmarkSettingsReady,
			getAll: () => Object.keys(headingBookmarkMap).map(id => parseInt(id, 10)).filter(id => !Number.isNaN(id)),
			remove: removeHeadingBookmark,
			clear: async () => {
				await waitForBookmarkSettingsLoad();
				const previous = { ...headingBookmarkMap };
				Object.keys(headingBookmarkMap).forEach(key => delete headingBookmarkMap[key]);
				initHeadingBookmarks();
				document.dispatchEvent(new CustomEvent('headingBookmarksCleared'));
				try {
					await saveBookmarkSettings();
				} catch (err) {
					replaceMap(headingBookmarkMap, idsFromMap(previous));
					initHeadingBookmarks();
					document.dispatchEvent(new CustomEvent('headingBookmarkToggled'));
					toastr.error('Could not clear bookmarks. Please try again.', 'Bookmarks');
					console.warn('Could not clear heading bookmarks', err);
				}
			}
		};
		window.tafsirBookmarks = {
			ready: bookmarkSettingsReady,
			getAll: () => tafsirRefsFromMap(tafsirBookmarkMap),
			remove: removeTafsirBookmark,
			clear: async () => {
				await waitForBookmarkSettingsLoad();
				const previous = { ...tafsirBookmarkMap };
				Object.keys(tafsirBookmarkMap).forEach(key => delete tafsirBookmarkMap[key]);
				initTafsirBookmarks();
				document.dispatchEvent(new CustomEvent('tafsirBookmarksCleared'));
				try {
					await saveBookmarkSettings();
				} catch (err) {
					replaceStringMap(tafsirBookmarkMap, tafsirRefsFromMap(previous), /^[A-Za-z0-9_-]+:[0-9]{1,3}:[0-9]{1,3}$/);
					initTafsirBookmarks();
					document.dispatchEvent(new CustomEvent('tafsirBookmarkToggled'));
					toastr.error('Could not clear bookmarks. Please try again.', 'Bookmarks');
					console.warn('Could not clear tafsir bookmarks', err);
				}
			}
		};
	})();
</script>
