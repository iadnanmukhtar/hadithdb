		const queueTypedCommentCount = (rawId, rawType) => {
			const id = parseInt(rawId);
			const type = likeType(rawType);
			const key = likeKey(id, type);
			if (commentWidgetOwnsCount(id, type)) return;
			if (Number.isNaN(id) || loadedCommentCounts[key] !== undefined || loadingCommentCountIds.has(key)) return;
			const shouldSchedule = pendingCommentCountIds.size === 0;
			pendingCommentCountIds.add(key);
			if (shouldSchedule) scheduleCommentCountFlush();
		};

		const loadQueuedCommentCounts = async () => {
			const keys = Array.from(pendingCommentCountIds).filter(key => {
				const parts = key.split(':');
				const type = likeType(parts[0]);
				const id = parseInt(parts[1], 10);
				return loadedCommentCounts[key] === undefined && !loadingCommentCountIds.has(key) && !commentWidgetOwnsCount(id, type);
			});
			Array.from(pendingCommentCountIds).forEach(key => {
				const parts = key.split(':');
				const type = likeType(parts[0]);
				const id = parseInt(parts[1], 10);
				if (loadedCommentCounts[key] !== undefined || commentWidgetOwnsCount(id, type)) pendingCommentCountIds.delete(key);
			});
			if (!keys.length) return;
			keys.forEach(key => {
				pendingCommentCountIds.delete(key);
				loadingCommentCountIds.add(key);
			});
			try {
				const grouped = keys.reduce((acc, key) => {
					const parts = key.split(':');
					const type = likeType(parts[0]);
					const id = parseInt(parts[1], 10);
					if (!Number.isNaN(id)) (acc[type] || (acc[type] = [])).push(id);
					return acc;
				}, {});
				for (const type of Object.keys(grouped)) {
					const ids = grouped[type];
					const counts = {};
					for (let offset = 0; offset < ids.length; offset += 100) {
						const res = await fetch(quranApiPath(`/comments/counts?type=${encodeURIComponent(type)}&ids=${ids.slice(offset, offset + 100).join(',')}`), { cache: 'no-store' });
						if (!res.ok) throw new Error('Failed reflection count fetch');
						const data = await res.json();
						Object.assign(counts, data.counts || {});
					}
					ids.forEach(id => setTypedCommentCount(id, type, counts[id]));
				}
			} catch (err) {
				console.warn('Could not load reflection counts', err);
			} finally {
				keys.forEach(key => loadingCommentCountIds.delete(key));
			}
		};

		const initCommentCounts = () => {
