			if (loadedLikeIds.has(key) || loadingLikeIds.has(key)) return;
			loadingLikeIds.add(key);
			const token = window.hadithAuth && window.hadithAuth.getToken ? await window.hadithAuth.getToken() : null;
			try {
				const res = await fetch(quranApiPath(`/likes/${id}?type=${encodeURIComponent(type)}`), {
					credentials: 'same-origin',
					headers: authHeaders(token)
				});
				if (!res.ok) throw new Error('Failed likes fetch');
				const data = await res.json();
				if (typeof data.liked === 'boolean') {
					setLiked(id, type, data.liked);
					persistMap(LIKE_KEY, likedMap);
				}
				setState(id, type, isLiked(id, type), data.likes ?? 0);
				loadedLikeIds.add(key);
