<%
	const passageItems = locals.passage || [];
	const firstPassageItem = passageItems[0];
	const passageSurah = firstPassageItem
		? ((firstPassageItem.en?.num || firstPassageItem.num || '').toString().split(/:/)[0])
		: '';
	const passageAyahs = passageItems.map(function (ayah) {
		const num = ayah.en?.num || ayah.num || '';
		return parseInt(arabic.toLatinDigits(num.toString().split(/:/).pop()), 10);
	}).filter(Number.isInteger);
	const selectedAyahNums = (locals.selectedAyahs || []).map(function (ayah) {
		const num = ayah.en?.num || ayah.num || '';
		return parseInt(arabic.toLatinDigits(num.toString().split(/:/).pop()), 10);
	}).filter(Number.isInteger);
	const passageSurahInfo = (global.surahs || []).find(function (surah) {
		return Number(surah.num) === Number(passageSurah);
	});
	const passageAyahHeadingNums = selectedAyahNums.length > 0 ? selectedAyahNums : passageAyahs;
	const passageAyahHeadingStart = Math.min.apply(null, passageAyahHeadingNums);
	const passageAyahHeadingEnd = Math.max.apply(null, passageAyahHeadingNums);
	const passageAyahHeadingRange = passageAyahHeadingStart === passageAyahHeadingEnd
		? passageAyahHeadingStart
		: `${passageAyahHeadingStart}-${passageAyahHeadingEnd}`;
	const translationHeading = passageAyahHeadingNums.length > 0
		? `${passageSurah}:${passageAyahHeadingRange}${passageSurahInfo?.name_en ? ` ${passageSurahInfo.name_en}` : ''}`
		: 'Translations';
	const translationInstance = locals.translationInstance || 'passage';
	const hideDefaultTranslation = locals.hideDefaultTranslation === true;
	const translationSettingsHref = locals.translationSettingsHref || '';
	const showAyahModalModeToggle = locals.showAyahModalModeToggle === true;
	const defaultTranslationBook = (global.commentaries || []).find(function (book) {
		return book && book.type === 'trans' && book.source === 'default';
	}) || {
		shortName_en: 'Abdel Haleem',
		name_en: 'The Qur\'an: A New Translation',
		author_en: 'M. A. S. Abdel Haleem'
	};
	const defaultTranslationMeta = [
		defaultTranslationBook.author_en || defaultTranslationBook.author,
		defaultTranslationBook.published_year ? `Pub. ${defaultTranslationBook.published_year}` : '',
		defaultTranslationBook.publisher || ''
	].filter(Boolean).join(', ');
	const defaultTranslationTitle = defaultTranslationBook.name_en || defaultTranslationBook.title || 'The Qur\'an: A New Translation';
	const defaultTranslationHtml = passageItems.map(function (ayah) {
		return utils.markdownToHtml(utils.emptyIfNull(ayah.en?.body || ayah.body_en));
	}).filter(Boolean).join('\n');
%>
<% if (passageSurah && passageAyahs.length > 0) { %>
<article class="quran-translations mt-4" data-translation-instance="<%= translationInstance %>" data-surah="<%= passageSurah %>" data-ayahs="<%= passageAyahs.join(',') %>">
		<heading class="quran-translation-heading row heading py-2">
			<h2 class="col-12 fs-5 title quran-section-heading-title mb-0" lang="en">
				<span class="quran-section-heading-text"><%= translationHeading %></span>
				<% if (translationSettingsHref || showAyahModalModeToggle) { %>
					<span class="quran-section-heading-actions">
						<% if (translationSettingsHref) { %>
							<a class="quran-section-heading-action btn btn-sm btn-outline-secondary" href="<%= utils.quranUrl(req, `/quran:${passageSurah}:${passageAyahHeadingStart}`) %>" title="Study" aria-label="Study">
								<span class="bi bi-text-paragraph" aria-hidden="true"></span><span>Study</span>
							</a>
							<button type="button" class="quran-section-heading-action btn btn-sm btn-outline-secondary quran-ayah-modal-trigger" data-quran-ayah-modal-index="0" data-quran-ayah-modal-type="tafsirs" title="View tafsir" aria-label="View tafsir">
								<span class="bi bi-book-half" aria-hidden="true"></span><span>Tafsir</span>
							</button>
							<a class="quran-section-heading-action btn btn-sm btn-outline-secondary" href="<%= translationSettingsHref %>" title="My Settings" aria-label="My Settings">
								<span class="bi bi-gear" aria-hidden="true"></span>
							</a>
						<% } %>
						<% if (showAyahModalModeToggle) { %>
							<span class="btn-group btn-group-sm quran-ayah-modal-mode-toggle" role="group" aria-label="Quran modal view">
								<button type="button" class="btn btn-outline-secondary quran-ayah-modal-switch" data-quran-ayah-modal-switch="tafsirs"><span class="bi bi-book-half" aria-hidden="true"></span><span>Tafsir</span></button>
								<button type="button" class="btn btn-outline-secondary active" aria-pressed="true"><span class="bi bi-translate" aria-hidden="true"></span><span>Translations</span></button>
							</span>
						<% } %>
					</span>
				<% } %>
			</h2>
		</heading>
	<div class="quran-translation-list">
		<% if (!hideDefaultTranslation && defaultTranslationHtml) { %>
			<details class="quran-translation-entry quran-translation-default" lang="en" dir="ltr" data-translation-alias="default" draggable="false" open>
				<summary class="quran-translation-source">
					<span class="quran-translation-chevron bi bi-chevron-right" aria-hidden="true"></span>
					<strong class="quran-translation-source-author" title="<%= defaultTranslationBook.shortName_en || 'Abdel Haleem' %>"><%= defaultTranslationBook.shortName_en || 'Abdel Haleem' %></strong>
					<button type="button" class="translation-preference-heart btn btn-link p-0" data-quran-translation-preference-heart="1" data-quran-translation-preference-alias="" data-quran-translation-preference-label="<%= defaultTranslationBook.shortName_en || 'Abdel Haleem' %>" title="Use <%= defaultTranslationBook.shortName_en || 'Abdel Haleem' %> as the default hero translation" aria-label="Use <%= defaultTranslationBook.shortName_en || 'Abdel Haleem' %> as the default hero translation" aria-pressed="false">
						<i class="bi bi-heart" aria-hidden="true"></i>
					</button>
						<span class="quran-translation-source-title" title="<%= [defaultTranslationMeta, defaultTranslationTitle].filter(Boolean).join(' ') %>">
							<span class="quran-translation-source-full-author" title="<%= defaultTranslationMeta %>"><%= defaultTranslationMeta || 'M. A. S. Abdel Haleem' %></span>
							<span class="quran-translation-source-book-title" title="<%= defaultTranslationTitle %>"><%= defaultTranslationTitle %></span>
						</span>
				</summary>
				<div class="quran-translation-text" lang="en"><%- defaultTranslationHtml %></div>
			</details>
		<% } %>
		<p class="quran-translation-status text-muted">Loading translations...</p>
	</div>
</article>
<% } %>
