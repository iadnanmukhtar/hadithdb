<nav class="row g-0 chapter-toc settings-navigation" aria-label="Settings sections">
  <div class="col-12 chapter-toc-toolbar">
    <ul class="nav nav-tabs">
      <% groups.forEach(group => { %>
      <li class="nav-item"><a class="nav-link" href="#<%= group.id %>"><%= group.title %></a></li>
      <% }); %>
    </ul>
    <label class="settings-category-picker" hidden>Category
      <select aria-label="Settings category">
        <option value="">Choose category</option>
        <% groups.forEach(group => { %><option value="#<%= group.id %>"><%= group.title %></option><% }); %>
      </select>
    </label>
  </div>
</nav>
