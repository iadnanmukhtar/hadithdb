<div class="ux-rail-filter-slot book-catalog-group-filters catalog-tools">
  <%- include('rail_search.ejs', { inputId: 'book-catalog-filter', placeholder: 'Search books', label: 'Search books in this collection', clearLabel: 'Clear book filter', resultsId: 'book-catalog-results' }) %>
  <details class="catalog-facets"><summary>Filters<span class="catalog-facet-selection"></span></summary>
    <div class="catalog-options" role="group" aria-label="Collection filters">
      <button type="button" class="btn btn-outline-primary active" data-book-catalog-group-filter="" aria-pressed="true">All</button>
      <button type="button" class="btn btn-outline-primary d-none" data-book-catalog-language-filter="ar" data-book-catalog-group-scope="tafsir" aria-pressed="false">Arabic</button>
      <button type="button" class="btn btn-outline-primary d-none" data-book-catalog-language-filter="en" data-book-catalog-group-scope="sharh" aria-pressed="false">English</button>
      <% ['en-ar', 'ar', 'en'].forEach(function (label) { %>
        <button type="button" class="btn btn-outline-primary d-none" data-catalog-badge-filter="<%= label.toLowerCase() %>" aria-pressed="false"><%= label %></button>
      <% }); %>
      <% Object.keys(catalogBookGroups).forEach(function (scope) { catalogBookGroups[scope].forEach(function (group) { %>
        <button type="button" class="btn btn-outline-primary<%= scope === 'hadith' ? '' : ' d-none' %>" data-book-catalog-group-filter="<%= group.id %>" data-book-catalog-group-scope="<%= scope %>" aria-pressed="false"><%= group.label %></button>
      <% }); }); %>
    </div>
  </details>
</div>
