<%
  const ctx = (typeof locals !== 'undefined' && locals) ? locals : {};
  const widgetId = typeof ctx.widgetId === 'string' ? ctx.widgetId : 'comments';
  const heading = typeof ctx.heading === 'string' ? ctx.heading : 'Add your own reflection below:';
  const targetId = typeof ctx.targetId !== 'undefined' ? ctx.targetId : '';
  const ref = typeof ctx.ref !== 'undefined' ? ctx.ref : '';
  const endpoint = typeof ctx.endpoint === 'string' && ctx.endpoint.trim() ? ctx.endpoint : '/comments';
  const pingUrl = typeof ctx.pingUrl === 'string' ? ctx.pingUrl : '';
  const subjectLabel = typeof ctx.subjectLabel === 'string' && ctx.subjectLabel.trim() ? ctx.subjectLabel : 'reflection';
  const placeholder = typeof ctx.placeholder === 'string' ? ctx.placeholder : 'Write a comment...';
  const lazyLoad = !!ctx.lazyLoad;
%>

<% if (targetId) { %>
  <h4 class="fs-5">
    <%= heading %>
    <a href="#<%= widgetId %>" class="reflection-count-link text-decoration-none" title="View reflections">
      <span class="bi bi-chat-right-text text-accent"></span><span class="comment-widget-count fw-semibold text-accent" id="<%= widgetId %>-count" title="0 reflections">0</span>
    </a>
  </h4>
  <section class="mt-3 comment-feed" id="<%= widgetId %>" data-ref="<%= ref %>" data-target-id="<%= targetId %>" data-endpoint="<%= endpoint %>" data-ping-url="<%= pingUrl %>" data-subject-label="<%= subjectLabel %>" data-lazy-load="<%= lazyLoad ? '1' : '0' %>">
    <div class="comment-feed-shell">
      <div id="<%= widgetId %>-thread" class="comment-thread"></div>
      <div class="comment-composer mt-3" id="<%= widgetId %>-auth">
        <div class="comment-composer-body">
          <div class="comment-avatar comment-avatar-composer" id="<%= widgetId %>-avatar" aria-hidden="true">
            <i class="bi bi-person-fill"></i>
          </div>
          <div class="comment-composer-panel">
            <p class="comment-auth-hint text-muted small mb-2" id="<%= widgetId %>-hint">Sign in from the top menu to add or reply to reflections.</p>
            <div class="comment-current-user d-none" id="<%= widgetId %>-user"></div>
            <form class="comment-form" id="<%= widgetId %>-form">
              <div class="mb-2">
                <label class="visually-hidden" for="<%= widgetId %>-text">Your reflection</label>
                <textarea class="form-control comment-input" id="<%= widgetId %>-text" rows="3" placeholder="<%= placeholder %>" maxlength="10000" required disabled></textarea>
              </div>
              <input type="hidden" id="<%= widgetId %>-parent">
              <div class="comment-form-toolbar">
                <div class="comment-form-status text-muted small d-none" id="<%= widgetId %>-status"></div>
                <div class="comment-form-buttons">
                  <button type="button" class="btn btn-link btn-sm comment-form-link d-none" id="<%= widgetId %>-cancel-reply">Cancel reply</button>
                  <button type="button" class="btn btn-link btn-sm comment-form-link d-none" id="<%= widgetId %>-cancel-edit">Cancel edit</button>
                  <button type="submit" class="btn btn-sm comment-submit-btn" disabled title="Post reflection">
                    <i class="bi bi-send-fill" aria-hidden="true"></i>
                    <span class="visually-hidden">Post reflection</span>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <script>
      (function () {
        const container = document.getElementById('<%= widgetId %>');
        if (!container) return;
        const authHint = document.getElementById('<%= widgetId %>-hint');
        const composerAvatar = document.getElementById('<%= widgetId %>-avatar');
        const targetId = container.dataset.targetId;
        const quranApiPath = (path) => {
          path = String(path || '');
          if (path.charAt(0) !== '/') path = `/${path}`;
          const hostname = (window.location.hostname || '').toLowerCase();
          if (hostname.split('.')[0] !== 'quran' || path === '/quran' || path.startsWith('/quran/')) return path;
          return `/quran${path}`;
        };
        const endpoint = quranApiPath(container.dataset.endpoint || '/comments').replace(/\/$/, '');
        const rawPingUrl = container.dataset.pingUrl || '';
        const pingUrl = rawPingUrl ? quranApiPath(rawPingUrl) : '';
        const subjectLabel = container.dataset.subjectLabel || 'reflection';
        const lazyLoad = container.dataset.lazyLoad === '1';
        const countBadge = document.getElementById('<%= widgetId %>-count');
        const threadEl = document.getElementById('<%= widgetId %>-thread');
        const form = document.getElementById('<%= widgetId %>-form');
        const textarea = document.getElementById('<%= widgetId %>-text');
        const parentInput = document.getElementById('<%= widgetId %>-parent');
        const cancelReply = document.getElementById('<%= widgetId %>-cancel-reply');
        const cancelEdit = document.getElementById('<%= widgetId %>-cancel-edit');
        const formStatus = document.getElementById('<%= widgetId %>-status');
        const submitBtn = form.querySelector('button[type="submit"]');
        const userBox = document.getElementById('<%= widgetId %>-user');
        let currentUser = null;
        let comments = [];
        let editingId = null;
        let loaded = false;

        if (!targetId) return;

        const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (ch) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        }[ch] || ch));

        const getInitials = (name) => {
          const parts = String(name || 'User').trim().split(/\s+/).filter(Boolean).slice(0, 2);
          if (!parts.length) return 'U';
          return parts.map((part) => part.charAt(0).toUpperCase()).join('');
        };

        const formatProvider = (provider) => {
          const raw = String(provider || 'google.com').trim().toLowerCase();
          if (!raw) return 'Member';
          if (raw === 'google.com') return 'Google';
          if (raw === 'facebook.com') return 'Facebook';
          if (raw === 'password') return 'Email';
          const label = raw.replace('.com', '').replace(/[-_]/g, ' ');
          return label.charAt(0).toUpperCase() + label.slice(1);
        };

        const renderAvatarMarkup = (name, photoUrl = '') => {
          if (photoUrl) {
            return `<img src="${escapeHtml(photoUrl)}" alt="${escapeHtml(name)} avatar" loading="lazy">`;
          }
          return `<span>${escapeHtml(getInitials(name))}</span>`;
        };

        const setFormStatus = (message = '') => {
          formStatus.textContent = message;
          formStatus.classList.toggle('d-none', !message);
        };

        const setSubmitButton = (mode = 'post') => {
          const label = mode === 'edit' ? `Update ${subjectLabel}` : `Post ${subjectLabel}`;
          submitBtn.title = label;
          submitBtn.innerHTML = `
            <i class="bi bi-send-fill" aria-hidden="true"></i>
            <span class="visually-hidden">${escapeHtml(label)}</span>
          `;
        };

        const waitForHadithAuth = (timeoutMs = 5000) => new Promise(resolve => {
          const start = Date.now();
          const check = () => {
            if (window.hadithAuth && window.hadithAuth.getUser && window.hadithAuth.getToken) return resolve(window.hadithAuth);
            if (Date.now() - start > timeoutMs) return resolve(false);
            setTimeout(check, 50);
          };
          check();
        });

        const getActiveUser = async () => {
          if (window.hadithAuth && window.hadithAuth.getUser) {
            return await window.hadithAuth.getUser();
          }
          return null;
        };

        const renderUser = async () => {
          currentUser = await getActiveUser();
          if (!currentUser) {
            userBox.classList.add('d-none');
            userBox.innerHTML = '';
            authHint.classList.remove('d-none');
            composerAvatar.innerHTML = '<i class="bi bi-person-fill"></i>';
            textarea.disabled = true;
            submitBtn.disabled = true;
            setSubmitButton('post');
            return;
          }
          const providerId = currentUser.providerData && currentUser.providerData[0] ? currentUser.providerData[0].providerId : 'google.com';
          const isFirstGoogleLogin = providerId === 'google.com' && !sessionStorage.getItem('hadithdb_google_login');
          if (isFirstGoogleLogin) {
            console.log('Google sign-in detected');
            await onAuth({ username: currentUser.email }, { silent: true, reload: false });
          }
          const name = currentUser.displayName || currentUser.email || 'User';
          const photo = currentUser.photoURL || 'https://www.gravatar.com/avatar/?d=mp&s=64';
          userBox.classList.remove('d-none');
          authHint.classList.add('d-none');
          composerAvatar.innerHTML = renderAvatarMarkup(name, photo);
          userBox.innerHTML = `
            <div class="comment-current-user-meta">
              <span class="text-muted small">Posting as</span>
              <span class="fw-semibold">${escapeHtml(name)}</span>
              <span class="comment-provider-chip">${escapeHtml(formatProvider(providerId))}</span>
            </div>
            <button type="button" class="btn btn-link btn-sm p-0 comment-form-link ms-auto" id="<%= widgetId %>-logout">Sign out</button>
          `;
          textarea.disabled = false;
          submitBtn.disabled = false;
          setSubmitButton(editingId ? 'edit' : 'post');
          const logoutBtn = document.getElementById('<%= widgetId %>-logout');
          logoutBtn.onclick = async () => {
            window.google?.accounts?.id?.disableAutoSelect();
            if (window.hadithAuth && window.hadithAuth.clearCredential) window.hadithAuth.clearCredential();
            currentUser = null;
            renderUser();
          };
        };

        const formatDate = (ts) => {
          const d = (typeof ts === 'string' || typeof ts === 'number') ? new Date(ts) : ts;
          if (!(d instanceof Date) || Number.isNaN(d.getTime())) {
            return { shortLabel: '', fullLabel: '' };
          }
          const diffMs = Date.now() - d.getTime();
          const diffMinutes = Math.floor(diffMs / 60000);
          const diffHours = Math.floor(diffMs / 3600000);
          const diffDays = Math.floor(diffMs / 86400000);
          let shortLabel = d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
          if (diffMinutes < 1) shortLabel = 'Just now';
          else if (diffMinutes < 60) shortLabel = `${diffMinutes}m`;
          else if (diffHours < 24) shortLabel = `${diffHours}h`;
          else if (diffDays < 7) shortLabel = `${diffDays}d`;
          return {
            shortLabel,
            fullLabel: d.toLocaleString()
          };
        };

        const resetFormState = (clearText = false) => {
          editingId = null;
          parentInput.value = '';
          setSubmitButton('post');
          cancelReply.classList.add('d-none');
          cancelEdit.classList.add('d-none');
          setFormStatus('');
          if (clearText) textarea.value = '';
        };

        const renderComments = () => {
          const commentCount = comments.filter((comment) => !comment.deleted).length;
          countBadge.textContent = commentCount;
          countBadge.title = `${commentCount} reflection${commentCount === 1 ? '' : 's'}`;
          document.dispatchEvent(new CustomEvent('hadithCommentCountChanged', {
            detail: { hadithId: targetId, count: commentCount }
          }));
          threadEl.innerHTML = '';
          if (!comments.length) {
            threadEl.innerHTML = '<div class="comment-empty-state small">No reflections yet. Be the first to share.</div>';
            return;
          }
          const byParent = {};
          comments.forEach((c) => {
            const key = c.parentId || 'root';
            if (!byParent[key]) byParent[key] = [];
            byParent[key].push(c);
          });
          const build = (parentId, depth) => {
            (byParent[parentId || 'root'] || []).forEach((c) => {
              const item = document.createElement('div');
              item.className = `comment-thread-item${depth ? ' comment-thread-reply' : ''}`;
              item.style.setProperty('--comment-depth', depth);
              const deleted = !!c.deleted;
              const upVote = typeof c.upVote === 'number' ? c.upVote : 0;
              const downVote = typeof c.downVote === 'number' ? c.downVote : 0;
              const userVote = c.userVote || null;
              const userName = c.user && c.user.name ? c.user.name : 'Community Member';
              const userPhoto = c.user && c.user.photo ? c.user.photo : '';
              const dateMeta = formatDate(c.ts);
              const reactionCount = upVote + downVote;
              const reactionBadge = reactionCount > 0 ? `
                <div class="comment-reactions-badge" title="${reactionCount} reactions">
                  ${upVote > 0 ? '<span class="comment-reaction-icon comment-reaction-like"><i class="bi bi-hand-thumbs-up-fill"></i></span>' : ''}
                  ${downVote > 0 ? '<span class="comment-reaction-icon comment-reaction-disagree"><i class="bi bi-hand-thumbs-down-fill"></i></span>' : ''}
                  <span class="comment-reaction-count">${reactionCount}</span>
                </div>
              ` : '';
              const voteControls = deleted ? '' : `
                <button type="button" class="comment-action comment-vote${userVote === 'up' ? ' is-active' : ''}" data-id="${c.id}" data-direction="up" aria-pressed="${userVote === 'up' ? 'true' : 'false'}" aria-label="Like" title="Like">
                  <i class="bi ${userVote === 'up' ? 'bi-hand-thumbs-up-fill' : 'bi-hand-thumbs-up'}" aria-hidden="true"></i>
                </button>
                <button type="button" class="comment-action comment-vote comment-action-negative${userVote === 'down' ? ' is-active' : ''}" data-id="${c.id}" data-direction="down" aria-pressed="${userVote === 'down' ? 'true' : 'false'}" aria-label="Disagree" title="Disagree">
                  <i class="bi ${userVote === 'down' ? 'bi-hand-thumbs-down-fill' : 'bi-hand-thumbs-down'}" aria-hidden="true"></i>
                </button>
              `;
              const editControls = deleted ? '' : (c.canEdit ? `<button type="button" class="comment-action comment-edit" data-id="${c.id}" aria-label="Edit" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>` : '');
              const deleteControls = deleted ? '' : (c.canDelete ? `<button type="button" class="comment-action comment-delete comment-action-delete" data-id="${c.id}" aria-label="Delete" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button>` : '');
              const replyControls = deleted ? '' : `<button type="button" class="comment-action comment-reply" data-id="${c.id}" aria-label="Reply" title="Reply"><i class="bi bi-reply" aria-hidden="true"></i></button>`;
              item.innerHTML = `
                <div class="comment-row">
                  <div class="comment-avatar">${renderAvatarMarkup(userName, userPhoto)}</div>
                  <div class="comment-entry">
                    <div class="comment-bubble-wrap">
                      <div class="comment-bubble">
                        <div class="comment-meta">
                          <div class="comment-author-wrap">
                            <span class="comment-author">${escapeHtml(userName)}</span>
                          </div>
                        </div>
                        ${deleted ? '<p class="comment-deleted">This reflection was deleted.</p>' : '<div class="comment-text"></div>'}
                      </div>
                      ${reactionBadge}
                    </div>
                    ${deleted ? '' : `<div class="comment-actions">
                      <span class="comment-time" title="${escapeHtml(dateMeta.fullLabel)}">${escapeHtml(dateMeta.shortLabel)}</span>
                      ${voteControls}
                      ${replyControls}
                      ${editControls}
                      ${deleteControls}
                    </div>`}
                  </div>
                </div>
              `;
              if (!deleted) {
                item.querySelector('.comment-text').innerHTML = c.html || c.text;
              }
              threadEl.appendChild(item);
              build(c.id, depth + 1);
            });
          };
          build(null, 0);
          threadEl.querySelectorAll('.comment-vote').forEach((btn) => {
            btn.onclick = () => {
              const commentId = parseInt(btn.dataset.id);
              const direction = btn.dataset.direction;
              if (!Number.isNaN(commentId) && (direction === 'up' || direction === 'down')) {
                submitVote(commentId, direction);
              }
            };
          });
          threadEl.querySelectorAll('.comment-reply').forEach((btn) => {
            btn.onclick = () => {
              resetFormState();
              parentInput.value = btn.dataset.id;
              const parentComment = comments.find((c) => String(c.id) === btn.dataset.id);
              cancelReply.classList.remove('d-none');
              setFormStatus(`Replying to ${parentComment && parentComment.user && parentComment.user.name ? parentComment.user.name : 'this reflection'}`);
              textarea.focus();
            };
          });
          threadEl.querySelectorAll('.comment-edit').forEach((btn) => {
            btn.onclick = () => {
              const commentId = parseInt(btn.dataset.id);
              const comment = comments.find((c) => c.id === commentId);
              if (!comment) return;
              resetFormState();
              editingId = comment.id;
              textarea.value = comment.text;
              setSubmitButton('edit');
              cancelEdit.classList.remove('d-none');
              setFormStatus('Editing your reflection');
              textarea.focus();
            };
          });
          threadEl.querySelectorAll('.comment-delete').forEach((btn) => {
            btn.onclick = () => {
              const commentId = parseInt(btn.dataset.id);
              if (Number.isNaN(commentId)) return;
              deleteComment(commentId);
            };
          });
        };

        const listUrl = `${endpoint}/${encodeURIComponent(targetId)}`;

        const fetchComments = async (authToken = null) => {
          try {
            const res = await fetch(listUrl, {
              headers: authToken ? { Authorization: `Bearer ${authToken}` } : {}
            });
            if (!res.ok) throw new Error('Unable to load comments');
            const data = await res.json();
            comments = data.map((c) => ({
              ...c,
              upVote: typeof c.upVote === 'number' ? c.upVote : 0,
              downVote: typeof c.downVote === 'number' ? c.downVote : 0,
              userVote: c.userVote || null,
              canEdit: !!c.canEdit,
              canDelete: !!c.canDelete,
              deleted: !!c.deleted
            }));
          } catch (e) {
            threadEl.innerHTML = '<div class="comment-error-state small">Failed to load comments. Please try again later.</div>';
            return;
          }
          renderComments();
        };

        cancelReply.onclick = () => {
          parentInput.value = '';
          cancelReply.classList.add('d-none');
          if (!editingId) setFormStatus('');
        };

        cancelEdit.onclick = () => {
          resetFormState(true);
        };

        const deleteComment = async (commentId) => {
          const user = currentUser;
          if (!user) { renderUser(); return; }
          if (!window.confirm(`Delete this ${subjectLabel}? This cannot be undone.`)) return;
          try {
            const idToken = await user.getIdToken();
            const res = await fetch(`${endpoint}/${commentId}`, {
              method: 'DELETE',
              headers: {
                Authorization: `Bearer ${idToken}`
              }
            });
            if (!res.ok) throw new Error('Unable to delete comment');
            const data = await res.json();
            const idx = comments.findIndex((c) => c.id === data.id);
            if (idx >= 0) {
              comments[idx] = { ...comments[idx], ...data, deleted: true, canEdit: false, canDelete: false };
            }
            if (editingId === commentId) resetFormState(true);
            renderComments();
          } catch (err) {
            console.error('Could not delete comment', err);
            alert('Could not delete comment right now. Please try again.');
          }
        };

        const submitVote = async (commentId, direction) => {
          const user = currentUser;
          if (!user) { renderUser(); return; }
          const comment = comments.find((c) => c.id === commentId);
          if (!comment || comment.deleted) return;
          try {
            const idToken = await user.getIdToken();
            const res = await fetch(`${endpoint}/${commentId}/vote`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Authorization: `Bearer ${idToken}`
              },
              body: JSON.stringify({ direction })
            });
            if (!res.ok) throw new Error('Unable to record vote');
            const data = await res.json();
            const idx = comments.findIndex((c) => c.id === data.id);
            if (idx >= 0) {
              comments[idx].upVote = data.upVote;
              comments[idx].downVote = data.downVote;
              comments[idx].userVote = data.userVote || direction;
            }
            renderComments();
          } catch (err) {
            alert('Could not record your vote right now. Please try again.');
            console.error(err);
          }
        };

        form.onsubmit = async (e) => {
          e.preventDefault();
          const user = currentUser;
          if (!user) { renderUser(); return; }
          const text = textarea.value.trim();
          if (!text) return;
          const isEditing = !!editingId;
          try {
            const idToken = await user.getIdToken();
            const errorMsg = isEditing ? `Unable to update ${subjectLabel}` : `Unable to post ${subjectLabel}`;
            const res = await fetch(isEditing ? `${endpoint}/${editingId}` : listUrl, {
              method: isEditing ? 'PUT' : 'POST',
              headers: {
                'Content-Type': 'application/json',
                Authorization: `Bearer ${idToken}`
              },
              body: JSON.stringify({
                text,
                parentId: isEditing ? null : (parentInput.value || null)
              })
            });
            if (!res.ok) throw new Error(errorMsg);
            const data = await res.json();
            if (isEditing) {
              const idx = comments.findIndex((c) => c.id === data.id);
              if (idx >= 0) {
                comments[idx] = { ...comments[idx], ...data, canEdit: true };
              } else {
                comments.push({ ...data, canEdit: true });
              }
            } else {
              comments.push(data);
              if (pingUrl) {
                fetch(pingUrl, { method: 'GET', keepalive: true }).catch(() => {});
              }
            }
            resetFormState(true);
            renderComments();
          } catch (err) {
            console.error('Could not submit comment', err);
            alert(isEditing ? `Could not update ${subjectLabel} right now. Please try again.` : `Could not post ${subjectLabel} right now. Please try again.`);
          }
        };

        const loadWidget = async () => {
          if (loaded) return;
          loaded = true;
          await waitForHadithAuth();
          fetchComments();
          const user = await getActiveUser();
          await renderUser();
          if (user) {
            try {
              const token = await user.getIdToken();
              fetchComments(token);
            } catch (err) {
              console.warn('Could not fetch comments with auth token', err);
              fetchComments();
            }
          } else {
            fetchComments();
          }
        };

        document.addEventListener('hadithAuthChanged', async () => {
          await renderUser();
          const user = await getActiveUser();
          if (!user) {
            fetchComments();
            return;
          }
          try {
            fetchComments(await user.getIdToken());
          } catch (err) {
            fetchComments();
          }
        });

        document.addEventListener('hadithCommentWidgetLoad', event => {
          if (!event.detail) return;
          if (event.detail.widgetId === '<%= widgetId %>' || String(event.detail.hadithId) === String(targetId)) {
            loadWidget();
          }
        });

        if (!lazyLoad) {
          loadWidget();
        }
      })();
    </script>
  </section>
<% } %>
