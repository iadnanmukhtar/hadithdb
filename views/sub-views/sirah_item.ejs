<%
  const sirahHasEnglish = Boolean(utils.emptyIfNull(i.body_en).replace(/<[^>]*>/g, '').trim());
  const sirahColumns = sirahHasEnglish ? 'col-md-6 col-sm-12' : 'col-12';
  const sirahShowTitle = typeof title === 'undefined' || title;
%>
<a id="<%= String(i.num || i.id).replace(/:/g, '-') %>"></a>
<article class="row mt-3 sirah-item hadith-language-item" data-content-type="sirah" data-reader-language-item="hadith" data-sirah-translated="<%= sirahHasEnglish ? '1' : '0' %>">
  <% if (sirahHasEnglish) { %>
  <section class="col-md-6 col-sm-12 h" lang="en" dir="ltr" data-reader-language-column="english">
    <% if (sirahShowTitle && i.title_en) { %><h2 class="fs-5 title"><%- i.title_en %></h2><% } %>
    <b><a href="/<%= i.ref %>"><%= i.book_alias || i.book_shortName_en %>:<%= i.num %></a></b>
    <section class="body l5"><div><%- utils.markdownToHtml(i.body_en || '') %></div></section>
    <% if (i.footnote_en) { %><footer class="footnote l2"><%- utils.markdownToHtml(i.footnote_en) %></footer><% } %>
  </section>
  <% } else if (sirahShowTitle && i.title_en) { %>
  <header class="col-12" lang="en"><h2 class="fs-5 title"><%- i.title_en %></h2></header>
  <% } %>
  <section class="<%= sirahColumns %> h" lang="ar" dir="rtl" data-reader-language-column="arabic">
    <% if (sirahShowTitle && i.title) { %><h2 class="fs-5 title"><%- i.title %></h2><% } %>
    <b><a href="/<%= i.ref %>"><%= i.book_shortName || i.book_shortName_en %>:<%= arabic.toArabicDigits(String(i.num || '')) %></a></b>
    <section class="body l5"><div><%- utils.markdownToHtml(i.body || i.text || '') %></div></section>
    <% if (i.footnote) { %><footer class="footnote l2"><%- utils.markdownToHtml(i.footnote) %></footer><% } %>
  </section>
  <footer class="col-12 h"><aside class="tags sirah-item-actions">
    <button type="button" class="hadith-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= i.id %>" data-bookmark-type="sirah" data-bookmark-ref="<%= i.ref %>" data-bookmark-title="<%= i.title_en || `${i.book_alias || i.book_shortName_en || 'sirah'}:${i.num}` %>" data-bookmark-title-ar="<%= i.title || '' %>" data-bookmark-url="/<%= i.ref %>" title="Bookmark this passage">
      <span class="hadith-bookmark-icon bi bi-bookmark text-accent" data-hadith-id="<%= i.id %>"></span>
    </button>
    &nbsp;
    <button type="button" class="hadith-like-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= i.id %>" data-like-type="hadith" title="Like this passage">
      <span class="hadith-like-icon bi bi-heart text-danger" data-hadith-id="<%= i.id %>" data-like-type="hadith"></span>
    </button>
    <span class="hadith-like-count fw-semibold text-danger" data-hadith-id="<%= i.id %>" data-like-type="hadith">0</span>
    &nbsp;
    <a href="#sirah-comments-<%= i.id %>-disclosure" class="reflection-count-link text-decoration-none" data-reflection-disclosure-trigger="sirah-comments-<%= i.id %>-disclosure" title="View reflections">
      <span class="bi bi-chat-right-text text-accent"></span><span class="hadith-comment-count fw-semibold text-accent" data-hadith-id="<%= i.id %>" data-comment-type="hadith" title="0 reflections">0</span>
    </a>
  </aside></footer>
</article>
<section class="mt-4 reflection-section col-12" data-reflection-section>
  <%- include('comment_widget.ejs', {
    widgetId: `sirah-comments-${i.id}`,
    heading: 'Reflect on this passage',
    targetId: i.id,
    ref: i.ref,
    endpoint: '/comments',
    subjectLabel: 'reflection',
    placeholder: 'Write a reflection on this passage...',
    collapsible: true,
    collapsed: true
  }); %>
</section>
