<% const markdownPlaceholder = `Write your note using Markdown:

# Main heading
## Section heading
**bold** · *italic* · __underline__ · ==highlight==
Arabic || English (two equal columns)
- A bullet point
1. A numbered point
> A quotation
[Link text](https://example.com)
[[Note title]] links to another note

Optional YAML frontmatter at the top:
---
topic: Patience
links:
  - bukhari:1
  - quran:2:255
---

Leave a blank line between paragraphs. Preview to see formatting.`; %>
<div class="modal fade" id="notebook-modal" data-nosnippet tabindex="-1" aria-labelledby="notebook-modal-title" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header py-2">
      <h2 class="modal-title fs-6" id="notebook-modal-title"><i class="bi bi-sticky me-2" aria-hidden="true"></i><a id="notebook-source" dir="auto">Note</a></h2>
      <button id="notebook-share" type="button" class="notebook-tool ms-auto" title="Share note" aria-label="Share note" aria-controls="notebook-share-panel" aria-expanded="false"><i class="bi bi-box-arrow-up" aria-hidden="true"></i></button>
      <button id="notebook-lock" type="button" class="notebook-tool" title="Lock note" aria-label="Lock note" aria-pressed="false"><i class="bi bi-unlock" aria-hidden="true"></i></button>
      <button id="notebook-print" type="button" class="notebook-tool" title="Print / Save as PDF" aria-label="Print / Save as PDF"><i class="bi bi-printer" aria-hidden="true"></i></button>
      <button id="notebook-float" type="button" class="notebook-tool" title="Float note while browsing" aria-label="Float note while browsing" aria-pressed="false"><i class="bi bi-pin-angle" aria-hidden="true"></i></button>
      <button id="notebook-minimize" type="button" class="notebook-tool" title="Minimize note" aria-label="Minimize note" hidden><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
      <button id="notebook-fullscreen" type="button" class="notebook-tool me-2" title="Expand note" aria-label="Expand note" aria-pressed="false"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <section id="notebook-share-panel" class="px-3 py-2" aria-label="Share note" hidden>
      <p class="small mb-2">Anyone with the link can see your name, profile image, and this note’s title and latest saved text without signing in. Your other notes and Google Drive remain private.</p>
      <button id="notebook-share-enable" type="button" class="btn btn-sm btn-outline-secondary">Create public link</button>
      <div id="notebook-share-active" hidden>
        <label class="visually-hidden" for="notebook-share-url">Public read-only link</label>
        <input id="notebook-share-url" type="url" class="form-control form-control-sm mb-2" readonly>
        <button id="notebook-share-copy" type="button" class="btn btn-sm btn-outline-secondary">Copy link</button>
        <a id="notebook-share-open" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">Open link</a>
        <button id="notebook-share-revoke" type="button" class="btn btn-sm btn-outline-danger">Stop sharing</button>
      </div>
      <p id="notebook-share-status" class="small mb-0 mt-1" role="status" aria-live="polite"></p>
    </section>
    <div class="modal-body">
      <nav id="notebook-navigator" aria-label="Recent notes" hidden>
        <div class="notebook-sidebar-header">
          <div class="notebook-outline-label">Recent notes</div>
          <button type="button" class="notebook-tool notebook-sidebar-toggle" data-notebook-sidebar="notebook-navigator" aria-controls="notebook-navigator-content" aria-expanded="true" aria-label="Collapse recent notes" title="Collapse recent notes"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
        </div>
        <div id="notebook-navigator-content" class="notebook-sidebar-content">
        <button id="notebook-expanded-new" type="button" class="btn btn-sm btn-outline-secondary w-100 mb-3"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New note</button>
        <ol id="notebook-navigator-items"></ol>
        <p id="notebook-navigator-status" class="small" role="status"></p>
        <button id="notebook-navigator-more" type="button" class="btn btn-sm btn-outline-secondary" hidden>More notes</button>
        </div>
        <div class="notebook-sidebar-resize" data-notebook-resize="notebook-navigator" role="separator" tabindex="0" aria-label="Resize recent notes sidebar" aria-orientation="vertical" aria-controls="notebook-navigator" aria-valuemin="140" aria-valuemax="420" aria-valuenow="256"></div>
      </nav>
      <div id="notebook-surface">
        <div class="small mb-2" data-notebook-drive-panel data-notebook-drive-compact hidden>
          <%- include('notebook_drive_icon.ejs'); %>
          <span data-notebook-drive-message role="status"></span>
          <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-notebook-drive-connect hidden>Connect Google Drive</button>
          <a data-notebook-drive-folder target="_blank" rel="noopener" class="notebook-drive-action ms-1" hidden>Open folder</a>
        </div>
        <div id="notebook-associated-notes" class="d-flex gap-2 flex-wrap mb-2" aria-live="polite"></div>
        <div class="notebook-metadata-tools">
          <button id="notebook-frontmatter" type="button" class="notebook-metadata-toggle notebook-fm-toggle" title="Show frontmatter" aria-label="Show frontmatter" aria-controls="notebook-frontmatter-panel" aria-expanded="false"><span aria-hidden="true">FM</span></button>
        <details id="notebook-attachments" hidden>
          <summary class="notebook-metadata-toggle"><span>Linked items</span><span id="notebook-attachment-count" class="notebook-metadata-count" hidden></span></summary>
          <div class="notebook-attachment-content">
          <p class="notebook-metadata-hint">Link this note to a hadith or ayah.</p>
          <div id="notebook-attached-items" class="my-2"></div>
          <label for="notebook-attachment-reference">Hadith or ayah reference</label>
          <div class="input-group input-group-sm my-1">
            <input id="notebook-attachment-reference" class="form-control" placeholder="bukhari:1 or quran:2:255" dir="ltr" maxlength="100">
            <button id="notebook-attachment-add" type="button" class="btn btn-outline-secondary">Link</button>
          </div>
          <div id="notebook-attach-existing" class="mt-2" hidden>
            <label for="notebook-attachment-search">Link an existing note to this item</label>
            <input id="notebook-attachment-search" class="form-control form-control-sm" placeholder="Search notes by title" maxlength="500" dir="auto">
            <div id="notebook-attachment-results" class="d-flex flex-column align-items-start gap-1 mt-2"></div>
          </div>
          <p id="notebook-attachment-status" class="mb-0 mt-1" role="status" aria-live="polite"></p>
          </div>
        </details>
        <section id="notebook-frontmatter-panel" aria-label="Editable frontmatter" hidden>
          <div class="notebook-frontmatter-heading"><label for="notebook-frontmatter-editor">Frontmatter</label><span aria-hidden="true">YAML</span></div>
          <textarea id="notebook-frontmatter-editor" class="form-control form-control-sm" dir="ltr" rows="7" spellcheck="false" aria-describedby="notebook-frontmatter-status"></textarea>
          <div id="notebook-frontmatter-status" class="small" role="status" aria-live="polite"></div>
        </section>
        </div>
        <div id="notebook-title-row">
          <a id="notebook-drive-file" target="_blank" rel="noopener" title="Open note in Google Drive" aria-label="Open note in Google Drive" hidden><%- include('notebook_drive_icon.ejs'); %></a>
          <input id="notebook-title-editor" class="form-control mb-2" dir="auto" maxlength="500" required aria-label="Note title" placeholder="Note title" hidden>
          <div id="notebook-note-title" dir="auto" role="button" tabindex="0" aria-label="Edit note title" hidden></div>
        </div>
        <textarea id="notebook-editor" class="form-control" dir="auto" rows="8" aria-label="Edit Markdown note" aria-autocomplete="list" aria-controls="notebook-wiki-options" aria-expanded="false" placeholder="<%= markdownPlaceholder %>" hidden></textarea>
        <div id="notebook-wiki-options" role="listbox" aria-label="Link to a note" hidden></div>
        <div id="notebook-preview" class="notebook-markdown" tabindex="0" aria-label="Note preview" data-placeholder="<%= markdownPlaceholder %>"></div>
      </div>
      <nav id="notebook-outline" aria-label="Note heading outline" hidden>
        <div class="notebook-sidebar-header">
          <button type="button" class="notebook-tool notebook-sidebar-toggle" data-notebook-sidebar="notebook-outline" aria-controls="notebook-outline-content" aria-expanded="true" aria-label="Collapse heading outline" title="Collapse heading outline"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
          <div class="notebook-outline-label">On this note</div>
        </div>
        <div id="notebook-outline-content" class="notebook-sidebar-content"><ol id="notebook-outline-items"></ol></div>
        <div class="notebook-sidebar-resize" data-notebook-resize="notebook-outline" role="separator" tabindex="0" aria-label="Resize heading outline sidebar" aria-orientation="vertical" aria-controls="notebook-outline" aria-valuemin="140" aria-valuemax="420" aria-valuenow="256"></div>
      </nav>
    </div>
    <div id="notebook-tag-bar" class="px-3 py-2">
      <div id="notebook-note-tags" class="d-flex flex-wrap gap-2" role="button" tabindex="0" aria-label="Edit note tags"></div>
      <label class="visually-hidden" for="notebook-tag-editor">Tags separated by spaces</label>
      <input id="notebook-tag-editor" class="form-control form-control-sm mt-2" dir="auto" placeholder="Add tags separated by spaces" aria-describedby="notebook-tag-help" hidden>
      <small id="notebook-tag-help" class="text-muted" hidden>Separate tags with spaces. Hashtags in your note also appear here.</small>
    </div>
    <div class="modal-footer py-1 gap-1">
      <a data-notebook-auth href="/notebook" class="notebook-tool me-auto" title="My Notebook" aria-label="My Notebook"><i class="bi bi-sticky" aria-hidden="true"></i></a>
      <span id="notebook-status" class="small me-2" role="status" aria-live="polite"></span>
      <div id="notebook-zoom-control">
        <label for="notebook-zoom">Text size</label>
        <input id="notebook-zoom" type="range" min="75" max="200" step="5" value="100" aria-describedby="notebook-zoom-value">
        <output id="notebook-zoom-value" for="notebook-zoom">100%</output>
      </div>
      <details id="notebook-dates" hidden>
        <summary class="notebook-tool" title="Note dates" aria-label="Note dates"><i class="bi bi-info-circle" aria-hidden="true"></i></summary>
        <div id="notebook-dates-content" role="status"></div>
      </details>
      <button id="notebook-tags-toggle" type="button" class="notebook-tool" title="Hide tags" aria-label="Hide tags" aria-controls="notebook-tag-bar" aria-expanded="true"><i class="bi bi-tags" aria-hidden="true"></i></button>
      <button id="notebook-preview-button" type="button" class="notebook-tool" title="Edit Markdown" aria-label="Edit Markdown"><i class="bi bi-eye" aria-hidden="true"></i></button>
      <button id="notebook-download" type="button" class="notebook-tool" title="Download Markdown" aria-label="Download Markdown"><i class="bi bi-download" aria-hidden="true"></i></button>
      <button id="notebook-delete" type="button" class="notebook-tool" title="Delete note" aria-label="Delete note" hidden><i class="bi bi-trash" aria-hidden="true"></i></button>
      <button id="notebook-save" type="button" class="notebook-tool" title="Save now" aria-label="Save now"><i class="bi bi-check2" aria-hidden="true"></i></button>
    </div>
  </div></div>
</div>
<style>
<%- include('notebook_content_styles.ejs') %>
body:has(#notebook-modal.show) :is(#bmc-wbtn, #bmc-iframe) { display: none !important; }
#notebook-attachments :is(a, button), #notebook-associated-notes button { max-width: 100%; overflow-wrap: anywhere; }
#notebook-associated-notes > .text-muted { width: 100%; }
#notebook-attachment-results { max-height: 14rem; overflow-y: auto; }
/* Compact metadata controls share the note's paper and ink colors. */
.notebook-metadata-tools { position: relative; flex-shrink: 0; margin-bottom: .85rem; font-family: system-ui, sans-serif; font-size: .78rem; }
.notebook-metadata-tools:has(#notebook-attachments[hidden]) { padding-top: 2rem; }
.notebook-metadata-toggle { display: inline-flex; align-items: center; gap: .45rem; min-height: 2rem; padding: .3rem .6rem; border: 1px solid transparent; border-radius: .45rem; color: var(--note-ink, #805d00); background: transparent; font: inherit; font-weight: 500; cursor: pointer; }
.notebook-metadata-toggle:hover, .notebook-metadata-toggle[aria-expanded="true"], #notebook-attachments[open] > summary { background: rgba(212,167,44,.1); border-color: var(--note-edge, #d4a72c); }
.notebook-metadata-toggle:focus-visible { outline: 2px solid var(--note-edge, #d4a72c); outline-offset: 2px; }
#notebook-attachments > summary { list-style: none; margin-inline-end: 3.5rem; }
#notebook-attachments > summary::-webkit-details-marker { display: none; }
#notebook-attachments > summary::after { content: ''; width: .4rem; height: .4rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); margin: -.2rem .15rem 0 .25rem; }
#notebook-attachments[open] > summary::after { transform: rotate(225deg); margin-top: .2rem; }
.notebook-fm-toggle { position: absolute; inset-inline-end: 0; top: 0; font-size: .7rem; letter-spacing: .04em; font-weight: 650; min-width: 2.5rem; }
.notebook-metadata-count { min-width: 1.15rem; padding: .05rem .3rem; border-radius: 1rem; background: rgba(212,167,44,.15); font-size: .68rem; text-align: center; }
.notebook-attachment-content, #notebook-frontmatter-panel { margin-top: .55rem; padding: .7rem .8rem; border: 1px solid var(--note-edge, #d4a72c); border-radius: .55rem; background: rgba(255,255,255,.25); }
.notebook-metadata-hint { margin: 0 0 .6rem; opacity: .75; }
.notebook-frontmatter-heading { display: flex; justify-content: space-between; align-items: center; gap: .5rem; margin-bottom: .5rem; }
.notebook-frontmatter-heading label { font-weight: 600; margin: 0; }
.notebook-frontmatter-heading > span { font-size: .62rem; letter-spacing: .08em; opacity: .6; }
#notebook-frontmatter-editor { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .78rem; line-height: 1.65; resize: vertical; min-height: 9rem; max-height: 32vh; padding: .6rem; color: inherit; background: rgba(255,255,255,.3); border: 1px solid transparent; border-radius: .35rem; box-shadow: none; }
#notebook-attachments input { color: inherit; background: rgba(255,255,255,.3); border-color: var(--note-edge, #d4a72c); }
#notebook-attachments input:focus, #notebook-frontmatter-editor:focus { border-color: var(--note-edge, #d4a72c); outline: 2px solid rgba(212,167,44,.15); outline-offset: 1px; box-shadow: none; }
#notebook-frontmatter-status:not(:empty) { margin-top: .5rem; }
[data-bs-theme="dark"] .notebook-attachment-content, [data-bs-theme="dark"] #notebook-frontmatter-panel, [data-bs-theme="dark"] #notebook-frontmatter-editor { background: rgba(0,0,0,.1); }

#notebook-editor { font-family: var(--content-language-latin-font, Georgia), Kitab, Quran, serif; unicode-bidi: plaintext; text-align: start; line-height: 1.8; }
#notebook-wiki-options { max-height: 12rem; overflow-y: auto; border: 1px solid var(--bs-border-color, #ccc); border-radius: .35rem; background: var(--bs-body-bg, white); margin-block: .25rem; }
#notebook-wiki-options [role="option"] { padding: .3rem .65rem; cursor: pointer; }
#notebook-wiki-options [aria-selected="true"] { background: var(--bs-secondary-bg, #eee); color: var(--bs-body-color, #222); }
#notebook-modal .modal-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#notebook-modal .modal-dialog { height: calc(100vh - 2rem); height: calc(100dvh - 2rem); margin-block: 1rem; }
body.notebook-page-open > .modal-backdrop { display: none; }
#notebook-modal.notebook-page { padding: 0 !important; background: var(--note-paper, var(--bs-body-bg)); }
#notebook-modal.notebook-page .modal-content { border: 0; border-radius: 0; }
#notebook-modal .modal-dialog.modal-fullscreen { width: 100%; max-width: none; height: 100vh; height: 100dvh; margin: 0; }
@media (max-width: 575.98px) {
  #notebook-modal:not(.notebook-floating) .modal-dialog { width: 100%; max-width: none; height: 100dvh; max-height: 100dvh; margin: 0; }
  #notebook-modal:not(.notebook-floating) .modal-content { border-radius: 0; }
  #notebook-modal .modal-body { padding: .5rem .75rem; }
  #notebook-modal #notebook-note-title { margin-bottom: .4rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #notebook-modal #notebook-tag-bar { padding-block: .35rem !important; }
}

#notebook-modal .modal-header { align-items: center; }
#notebook-modal .modal-header > button { flex-shrink: 0; box-sizing: border-box; width: 2.25rem; height: 2.25rem; padding: .45rem; line-height: 1; }
#notebook-modal .modal-header .btn-close { margin: 0; background-size: 1em; }
#notebook-modal .modal-content { height: 100%; }
#notebook-modal .modal-body { display: flex; min-height: 0; overflow: hidden; }
#notebook-surface { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; }
#notebook-outline, #notebook-navigator { position: relative; display: flex; flex-direction: column; flex: 0 0 var(--sidebar-width, clamp(10rem, 18vw, 16rem)); min-width: 0; min-height: 0; overflow: hidden; }
.notebook-sidebar-header { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; gap: .5rem; margin-bottom: .5rem; }
.notebook-sidebar-header .notebook-outline-label { padding: 0; }
.notebook-sidebar-toggle { flex-shrink: 0; width: 2rem; height: 2rem; }
.notebook-sidebar-content { min-height: 0; overflow: auto; flex: 1; }
#notebook-modal :is(#notebook-outline, #notebook-navigator).notebook-sidebar-collapsed { flex-basis: 2.25rem; padding: 0; margin-inline: .5rem; }
.notebook-sidebar-collapsed .notebook-sidebar-header { justify-content: center; }
.notebook-sidebar-collapsed :is(.notebook-outline-label, .notebook-sidebar-resize) { display: none; }
.notebook-sidebar-content[hidden] { display: none; }
.notebook-sidebar-resize { position: absolute; top: 0; bottom: 0; width: .5rem; cursor: col-resize; touch-action: none; }
#notebook-navigator .notebook-sidebar-resize { right: 0; }
#notebook-outline .notebook-sidebar-resize { left: 0; }
.notebook-sidebar-resize:hover, .notebook-sidebar-resize:focus-visible { background: rgba(212, 167, 44, .3); outline: 1px solid var(--note-edge); outline-offset: -1px; }
#notebook-modal.notebook-sidebar-dragging { cursor: col-resize; user-select: none; }
#notebook-outline { border-left: 1px solid var(--note-edge); padding-left: 1rem; margin-left: 1.25rem; }
#notebook-navigator { border-right: 1px solid var(--note-edge); padding-right: 1rem; margin-right: 1.25rem; }
#notebook-navigator[hidden] { display: none; }
#notebook-navigator-items { list-style: none; padding: 0; margin: 0; }
#notebook-navigator-items button { display: block; width: 100%; border: 0; border-left: 2px solid transparent; border-radius: .2rem; padding: .5rem; background: transparent; color: inherit; font: inherit; font-size: .85rem; text-align: start; overflow-wrap: anywhere; }
#notebook-navigator-items button:hover, #notebook-navigator-items button[aria-current="page"] { background: rgba(212, 167, 44, .15); border-left-color: var(--note-edge); }
#notebook-navigator-items button:focus-visible { outline: 2px solid var(--note-edge); outline-offset: -2px; }
#notebook-navigator-items button { font-family: var(--content-language-latin-font, Georgia), NotebookKitab, Kitab, serif; }
#notebook-navigator-items button { display: flex; align-items: baseline; gap: .45rem; }
#notebook-navigator-items button > .bi { flex: 0 0 auto; font-size: .8em; color: var(--note-ink); }
#notebook-navigator-items button > span { min-width: 0; }
#notebook-outline[hidden] { display: none; }
.notebook-outline-label { position: sticky; top: 0; padding-bottom: .5rem; background: var(--note-paper); color: var(--note-ink); font-size: .8rem; font-weight: 600; }
#notebook-outline-items { list-style: none; padding: 0; margin: 0; }
#notebook-outline-items button { display: block; width: 100%; border: 0; border-inline-start: 2px solid transparent; border-radius: .2rem; padding: .35rem .5rem; padding-inline-start: calc(.5rem + var(--outline-depth) * .7rem); background: transparent; color: inherit; font: inherit; font-size: .85rem; text-align: start; overflow-wrap: anywhere; }
#notebook-outline-items button:hover, #notebook-outline-items button[aria-current="location"] { background: rgba(212, 167, 44, .15); color: var(--note-ink); border-inline-start-color: var(--note-edge); }
#notebook-outline-items button:focus-visible { outline: 2px solid var(--note-edge); outline-offset: -2px; }
#notebook-outline-items button { display: flex; align-items: baseline; gap: .4rem; }
#notebook-outline-items .notebook-outline-level { flex: 0 0 auto; font: 600 .6rem/1.5 system-ui, sans-serif; color: var(--note-ink); opacity: .7; }
#notebook-outline-items .notebook-outline-text { min-width: 0; }
#notebook-outline-items .notebook-outline-arabic { font-family: NotebookKitab, Kitab, Quran, serif; font-size: 1.2em; line-height: 2; }
@media (max-width: 767.98px) {
  #notebook-fullscreen { display: none; }
  #notebook-modal .modal-fullscreen .modal-body { flex-direction: column; }
  #notebook-outline, #notebook-navigator { flex: 0 0 auto; max-height: 18dvh; border: 0; border-bottom: 1px solid var(--note-edge); padding: 0 0 .5rem; margin: 0 0 .5rem; }
  #notebook-modal :is(#notebook-outline, #notebook-navigator).notebook-sidebar-collapsed { flex-basis: auto; margin: 0 0 .5rem; }
  .notebook-sidebar-resize { display: none; }
  .notebook-sidebar-collapsed .notebook-sidebar-header { justify-content: space-between; }
  .notebook-sidebar-collapsed .notebook-outline-label { display: block; }
  #notebook-outline { order: 1; }
  #notebook-surface { order: 2; }
  #notebook-navigator { order: 0; }
}
#notebook-editor, #notebook-preview { flex: 1; min-height: 0; overflow: auto; }
#notebook-editor { resize: none; }
#notebook-zoom-control { display: none; align-items: center; justify-content: flex-end; gap: .6rem; width: auto; flex: 0 1 auto; margin-inline-end: .65rem; font-size: .75rem; white-space: nowrap; color: var(--note-ink); }
#notebook-modal .modal-fullscreen #notebook-zoom-control { display: flex; }
#notebook-zoom { width: clamp(4rem, 12vw, 10rem); min-width: 4rem; accent-color: var(--note-edge); }
#notebook-zoom-value { min-width: 3em; font-variant-numeric: tabular-nums; }
#notebook-modal .modal-fullscreen :is(#notebook-preview, #notebook-editor) { font-size: var(--notebook-font-size, 1rem); }
#notebook-preview:empty::before { content: attr(data-placeholder); white-space: pre-wrap; opacity: .55; }
.notebook-tool { border: 0; background: transparent; color: #805d00; padding: .45rem; display: inline-flex; align-items: center; justify-content: center; border-radius: .3rem; }
.notebook-tool:hover, .notebook-tool:focus-visible { background: #ffe69c; }
.notebook-tool:disabled { opacity: .45; }
#notebook-modal .modal-footer > a[data-notebook-auth] { margin-inline-end: auto; }
#notebook-modal .modal-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: .25rem; }
#notebook-modal .modal-footer > .notebook-tool, #notebook-dates { flex: 0 0 auto; }
#notebook-status:empty { display: none; }
#notebook-share-panel { flex-shrink: 0; max-height: 40dvh; overflow-y: auto; border-bottom: 1px solid var(--note-edge); }
#notebook-share-url { direction: ltr; }
.personal-note-actions { display: inline-flex; align-items: center; gap: .5rem; vertical-align: middle; }
.quran-ayah-hero-toolbar > .personal-note-actions { gap: .75rem; }
.personal-note-btn { color: var(--note-icon-yellow); }
.personal-note-btn:hover, .personal-note-btn:focus-visible { color: var(--note-icon-yellow); background: transparent; }
.personal-note-btn .bi { pointer-events: none; }
/* Personal notes use a consistent amber paper color. */
#notebook-modal, #personal-notebook { --note-paper: #fff8db; --note-ink: #634800; --note-edge: #d4a72c; }


#notebook-modal .modal-content { background: var(--note-paper); border: 1px solid var(--note-edge); }
#notebook-modal .modal-header { border-bottom-color: var(--note-edge); }
#notebook-modal #notebook-editor { background: #fffdf3; border-color: var(--note-edge); color: #302a1b; }

#notebook-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: 1rem; margin-bottom: 1rem; }
.notebook-tile { display: flex; flex-direction: column; align-items: stretch; min-width: 0; background: var(--note-paper); border: 1px solid var(--note-edge); border-radius: .65rem; color: #302a1b; }
.notebook-tile-open { display: flex; flex-direction: column; gap: .8rem; width: 100%; flex: 1; min-height: 10rem; padding: 1rem; border: 0; border-radius: inherit; background: transparent; color: inherit; text-align: start; }
.notebook-tile-open:hover { background: rgba(212, 167, 44, .09); }
.notebook-tile-open:focus-visible { outline: 2px solid var(--note-edge); outline-offset: 3px; }
.notebook-tile-title { display: flex; align-items: start; gap: .65rem; width: 100%; color: var(--note-ink); font-weight: 600; }
.notebook-tile-title > .bi { flex: none; color: var(--note-edge); }
.notebook-tile-title > span:last-child { min-width: 0; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; }
.notebook-tile-preview { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; width: 100%; font-size: .9rem; line-height: 1.6; opacity: .8; }
.notebook-tile-preview .notebook-arabic { line-height: inherit; }
#notebook-list-status:empty { display: none; }
#personal-notebook h1, #notebook-modal .modal-title { color: var(--note-ink); }
[data-bs-theme="dark"] #notebook-modal, [data-bs-theme="dark"] #personal-notebook { --note-paper: #302b1b; --note-ink: #ffe69c; --note-edge: #a88732; }
[data-bs-theme="dark"] #notebook-list > article, [data-bs-theme="dark"] #notebook-modal #notebook-editor { background: #302b1b; color: #fff3bf; }
#notebook-list > .notebook-tile-new { background: #fffdf0; border-color: #e6d99c; }
[data-bs-theme="dark"] #notebook-list > .notebook-tile-new { background: #403a24; border-color: #a29359; }
.notebook-tile-tags { display: flex; flex-wrap: wrap; gap: .35rem; padding: 0 .75rem .75rem; }
#notebook-note-tags { cursor: text; min-height: 1.4rem; font-size: .75rem; }
#notebook-note-tags:focus-visible { outline: 2px solid var(--note-edge); outline-offset: 3px; }
#notebook-tag-bar { cursor: text; flex-shrink: 0; border-top: 1px solid var(--note-edge); }
.notebook-tag-chip { color: var(--note-ink); background: rgba(212, 167, 44, .12); border: 0; border-radius: 999px; padding: .15rem .55rem; font-size: .72rem; line-height: 1.4; overflow-wrap: anywhere; }
.notebook-layout { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 2rem; }
.notebook-main { min-width: 0; }
.notebook-tag-rail-slot { min-width: 0; }
.notebook-tag-rail { position: fixed; z-index: 20; width: 15rem; top: calc(var(--site-fixed-header-height, 5rem) + .75rem); border-inline-start: 1px solid var(--bs-border-color, #ddd); padding-inline-start: 1rem; max-height: calc(100dvh - var(--site-fixed-header-height, 5rem) - 1.5rem); overflow-y: auto; }
.notebook-tag-rail .notebook-tag-option { display: flex; justify-content: space-between; gap: .5rem; width: 100%; text-align: start; overflow-wrap: anywhere; }
.notebook-tag-rail #notebook-tag { font-size: .75rem; }
.notebook-tag-rail .notebook-tag-option { background: transparent; border-top: 0; border-right: 0; border-bottom: 0; }
.notebook-tag-rail .notebook-tag-option > .text-muted { font-size: .68rem; }
@media (max-width: 991.98px) {
  .notebook-layout { display: flex; flex-direction: column; gap: 1rem; }
  .notebook-tag-rail-slot { display: none; }
  .notebook-tag-rail { position: static; width: 100%; max-height: none; overflow-y: visible; border-inline-start: 0; padding: .25rem .5rem .75rem; }
}
#notebook-title-editor { flex-shrink: 0; }
#notebook-note-title { font-size: 1.1rem; font-weight: 600; margin-bottom: .75rem; overflow-wrap: anywhere; flex-shrink: 0; cursor: text; }
#notebook-title-row { display: flex; align-items: baseline; gap: .5rem; }
#notebook-title-row :is(#notebook-title-editor, #notebook-note-title) { min-width: 0; flex: 1; }
#notebook-drive-file { flex-shrink: 0; }
#notebook-drive-file .notebook-drive-icon { filter: none; opacity: 1; margin: 0; }
#notebook-dates { position: relative; font-size: inherit; line-height: inherit; text-align: start; }
#notebook-dates summary { list-style: none; cursor: pointer; }
#notebook-dates summary::-webkit-details-marker { display: none; }
#notebook-dates-content { position: absolute; bottom: calc(100% + .5rem); left: 50%; transform: translateX(-50%); width: max-content; max-width: min(22rem, 75vw); padding: .65rem .8rem; border: 1px solid var(--note-edge); border-radius: .4rem; background: var(--note-paper); color: var(--note-ink); box-shadow: 0 .2rem .6rem #0002; z-index: 5; white-space: pre-line; }
#personal-notebook.notebook-signed-out .notebook-tile { opacity: .55; }
#personal-notebook .notebook-tile-open:disabled { cursor: not-allowed; }
#personal-notebook .notebook-tile-open:disabled:hover { background: transparent; }
</style>
