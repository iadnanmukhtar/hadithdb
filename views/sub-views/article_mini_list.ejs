    <div class="article-recommendation-list">
      <% for (const article of articles) { %>
      <a class="article-recommendation" href="<%= article.url %>">
        <img src="<%= article.coverUrl %>" alt="" width="52" height="52" loading="lazy" decoding="async">
        <span class="article-recommendation-copy">
          <span class="article-recommendation-title" dir="auto" title="<%= article.title %>"><%= article.title %></span>
          <% if (article.category || article.authorHandle) { %>
          <span class="article-recommendation-meta">
            <% if (article.category) { %><span class="article-mini-pill"><%= article.category %></span><% } %>
          <% if (article.authorHandle) { %><span class="article-recommendation-author" dir="ltr">@<%= article.authorHandle %></span><% } %>
          </span>
          <% } %>
        </span>
      </a>
      <% } %>
    </div>
