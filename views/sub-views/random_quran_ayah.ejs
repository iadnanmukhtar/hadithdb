<%
  var randomAyahRef = random.en?.num || random.num || random.ref || '';
  var randomQuranShareId = `Q${randomAyahRef.replace(/[^A-Za-z0-9_-]/g, '-')}`;
%>
<header class="row">
  <h3 class="col-12 fs-4">Random āyah in <%- book.shortName_en %> <button type="button" class="btn btn-link text-muted p-0 align-baseline" data-random-quran-ayah-refresh title="Load another random ayah" aria-label="Load another random ayah"><i class="bi bi-arrow-clockwise"></i></button></h3>
</header>
<%- include('quran_ayah_hero.ejs', {
  site: site,
  page: page,
  selectedAyahs: [random],
  toolbar: {
    selectedAyahModalIndex: 0,
    selectedAyahId: random.id,
    quranShareId: randomQuranShareId
  }
}); %>
<%- include('quran_ayah_modal.ejs', { site: site, page: page, passage: [random] }); %>
<%- include('quran_modal.ejs', { site: site, page: page, selectedAyahs: [random], quranShareId: randomQuranShareId }); %>
