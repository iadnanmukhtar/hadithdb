        <select id="<%= styleId %>" aria-label="Text style"><option value="0">Normal</option><% for (let level=1;level<=6;level++) { %><option value="<%= level %>">Heading <%= level %></option><% } %><option value="subtext">Subtext</option></select>
        <% for (const [action,label,icon] of [['bold','Bold','type-bold'],['italic','Italic','type-italic'],['propheticSpeech','Prophetic speech',null],['underline','Underline','type-underline'],['strike','Strikethrough','type-strikethrough'],['subscript','Subscript',null],['superscript','Superscript',null],['highlight','Highlight','brush'],['center','Align center','text-center'],['numbered','Numbered list','list-ol'],['bullets','Bullet list','list-ul'],['quote','Quotation','quote'],['divider','Insert divider','hr'],['footnote','Insert footnote',null],['link','Insert link','link-45deg'],['wiki','Insert or edit internal note link','journal-bookmark'],['clear','Clear formatting','eraser']]) { %>
        <button type="button" data-format="<%= action %>" title="<%= label %>" aria-label="<%= label %>"><% if (action === 'subscript' || action === 'superscript') { %><span class="community-script-icon" dir="ltr" aria-hidden="true">x<% if (action === 'subscript') { %><sub>2</sub><% } else { %><sup>2</sup><% } %></span><% } else if (action === 'propheticSpeech') { %><span aria-hidden="true">ﷺ</span><% } else if (action === 'footnote') { %><span class="community-footnote-icon" dir="ltr" aria-hidden="true">A<sup>1</sup></span><% } else { %><i class="bi bi-<%= icon %>" aria-hidden="true"></i><% } %></button><% } %>
        <button type="button" data-format="parallel" title="Parallel English and Arabic text" aria-label="Parallel English and Arabic text"><span class="community-parallel-icon" dir="ltr" aria-hidden="true">a|ج</span></button>
