<%
  var hadithHeadingOutlines = locals.hadithHeadingOutlines || {};
  var hadithHeadingOutlineKeys = Object.keys(hadithHeadingOutlines);
  var hadithHeadingInitialContext = locals.hadithHeadingInitialContext || hadithHeadingOutlineKeys[0] || '';
  var hadithHeadingOutline = hadithHeadingOutlines[hadithHeadingInitialContext];
  var hadithHeadingInitialKey = locals.hadithHeadingInitialKey || '';
  var hadithHeadingTitle = hadithHeadingOutline
    ? (hadithHeadingOutline.flat
      ? hadithHeadingOutline.nameEn
      : `${hadithHeadingOutline.chapter}${hadithHeadingOutline.nameEn ? ` ${hadithHeadingOutline.nameEn}` : ''}`)
    : '';
  var hadithHeadingBookShortName = hadithHeadingOutline && !hadithHeadingOutline.flat
    ? (hadithHeadingOutline.bookShortName || hadithHeadingOutline.bookAlias || '').toString().trim()
    : '';
  if (!hadithHeadingInitialKey && hadithHeadingOutline && hadithHeadingOutline.sections && hadithHeadingOutline.sections.length > 0)
    hadithHeadingInitialKey = hadithHeadingOutline.sections[0].key;
  function hadithHeadingHref(heading) {
    return utils.urlFor(req, `/${heading.path}`);
  }
  function hadithHeadingLabel(heading) {
    if (Number(heading.level) === 3)
      return heading.title || 'Subsection';
    return `${heading.section} ${heading.title || 'Section'}`;
  }
  function hadithHeadingH1Label(heading) {
    return `${heading.number}${heading.title ? ` ${heading.title}` : ''}`;
  }
  function hadithHeadingH1Href(heading) {
    return utils.urlFor(req, `/${heading.path}`);
  }
  var hadithHeadingBookHref = hadithHeadingOutline
    ? utils.urlFor(req, `/${hadithHeadingOutline.bookAlias}`)
    : '';
%>
<% if (hadithHeadingOutline && (hadithHeadingOutline.sections || []).length > 0) { %>
<aside class="hadith-heading-toc d-none d-lg-block" data-hadith-heading-toc data-hadith-heading-initial-context="<%= hadithHeadingInitialContext %>" data-hadith-heading-initial-key="<%= hadithHeadingInitialKey %>" aria-labelledby="hadith-heading-toc-title">
  <div class="hadith-heading-toc-sticky">
    <% if (hadithHeadingBookShortName) { %><a class="heading-toc-book-name" href="<%= hadithHeadingBookHref %>" data-hadith-heading-toc-book><%= hadithHeadingBookShortName.toUpperCase() %></a><% } %>
    <a class="nav-link hadith-heading-toc-link heading-toc-adjacent-h1 heading-toc-previous-h1" data-hadith-heading-h1-prev<% if (hadithHeadingOutline.previousH1 && !hadithHeadingOutline.flat) { %> href="<%= hadithHeadingH1Href(hadithHeadingOutline.previousH1) %>" rel="prev" title="Previous chapter: <%= hadithHeadingH1Label(hadithHeadingOutline.previousH1) %>"<% if (hadithHeadingOutline.previousH1.titleLang === 'ar') { %> lang="ar" dir="rtl"<% } %>><%= hadithHeadingH1Label(hadithHeadingOutline.previousH1) %><% } else { %> hidden><% } %></a>
    <% if (hadithHeadingOutline.flat) { %><a id="hadith-heading-toc-title" class="hadith-heading-toc-title heading-toc-book-title-link" href="<%= hadithHeadingBookHref %>" data-hadith-heading-toc-chapter><%= hadithHeadingTitle %></a><% } else { %><strong id="hadith-heading-toc-title" class="hadith-heading-toc-title" data-hadith-heading-toc-chapter><%= hadithHeadingTitle %></strong><% } %>
    <nav class="nav flex-column hadith-heading-toc-nav" data-hadith-heading-toc-nav aria-label="<%= hadithHeadingOutline.flat ? `Chapters in ${hadithHeadingOutline.nameEn}` : `Headings in chapter ${hadithHeadingOutline.chapter}` %>">
      <% (hadithHeadingOutline.sections || []).forEach(function (heading) { %>
      <a class="nav-link hadith-heading-toc-link<%= hadithHeadingInitialKey === heading.key ? ' active' : '' %>" href="<%= hadithHeadingHref(heading) %>" data-hadith-heading-key="<%= heading.key %>"<% if (heading.titleLang === 'ar') { %> lang="ar" dir="rtl"<% } %><% if (hadithHeadingInitialKey === heading.key) { %> aria-current="location"<% } %>><%= hadithHeadingLabel(heading) %></a>
      <% if ((heading.subsections || []).length > 0) { %>
      <nav class="nav flex-column hadith-heading-toc-subnav" aria-label="Subheadings in chapter <%= heading.chapter %>, section <%= heading.section %>">
        <% heading.subsections.forEach(function (subheading) { %>
        <a class="nav-link hadith-heading-toc-link hadith-heading-toc-sublink<%= hadithHeadingInitialKey === subheading.key ? ' active' : '' %>" href="<%= hadithHeadingHref(subheading) %>" data-hadith-heading-key="<%= subheading.key %>" data-hadith-heading-parent-key="<%= heading.key %>"<% if (subheading.titleLang === 'ar') { %> lang="ar" dir="rtl"<% } %><% if (hadithHeadingInitialKey === subheading.key) { %> aria-current="location"<% } %>><%= hadithHeadingLabel(subheading) %></a>
        <% }); %>
      </nav>
      <% } %>
      <% }); %>
      <a class="nav-link hadith-heading-toc-link heading-toc-adjacent-h1 heading-toc-next-h1" data-hadith-heading-h1-next<% if (hadithHeadingOutline.nextH1 && !hadithHeadingOutline.flat) { %> href="<%= hadithHeadingH1Href(hadithHeadingOutline.nextH1) %>" rel="next" title="Next chapter: <%= hadithHeadingH1Label(hadithHeadingOutline.nextH1) %>"<% if (hadithHeadingOutline.nextH1.titleLang === 'ar') { %> lang="ar" dir="rtl"<% } %>><%= hadithHeadingH1Label(hadithHeadingOutline.nextH1) %><% } else { %> hidden><% } %></a>
    </nav>
  </div>
  <script type="application/json" data-hadith-heading-outlines><%- JSON.stringify(hadithHeadingOutlines).replace(/</g, '\\u003c') %></script>
</aside>
<% } %>
