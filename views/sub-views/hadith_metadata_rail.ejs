<%
	const railMetadata = i.hdithMetadata || {};
	const railNavigationOnly = typeof navigationOnly !== 'undefined' && navigationOnly;
	const railGrades = Array.isArray(railMetadata.grades) ? railMetadata.grades : [];
	const railNarrators = Array.isArray(railMetadata.narrators) ? railMetadata.narrators : [];
	const railSharh = Array.isArray(railMetadata.sharh) ? railMetadata.sharh : [];
	const railGharib = Array.isArray(railMetadata.gharib) ? railMetadata.gharib : [];
	const railBase = `hadith-metadata-${i.actual ? i.actual.id : i.id}`;
	const railGroups = (railNavigationOnly ? [] : [
		{ key: 'reflection', label: 'Reflection', count: null, always: true },
		{ key: 'grades', label: 'Scholarly Grades', count: railGrades.length },
		{ key: 'isnad', label: 'Chain of Narrators', count: railNarrators.length },
		{ key: 'sharh', label: 'Explanations', count: railSharh.length },
		{ key: 'gharib', label: 'Definitions', count: railGharib.length },
		{ key: 'mushabihah', label: 'Similar References', count: Array.isArray(i.similar) ? i.similar.length : 0 }
	]).filter(group => group.always || group.count);
	const railInitialKey = railGroups.length ? railGroups[0].key : '';
	const railBookName = (i.book_shortName_en || (i.book && (i.book.shortName_en || i.book.name_en)) || i.book_alias || '').toString().trim();
	const railBookHref = utils.urlFor(req, `/${i.book_alias}`);
	const railChapter = i.chapter || {};
	const railChapterTitle = (railChapter.title_en || i.h1_title_en || '').toString().trim();
	const railChapterLabel = `${railChapter.h1 || i.h1 || ''}${railChapterTitle ? ` ${railChapterTitle}` : ''}`.trim();
	const railChapterHref = utils.urlFor(req, `/${railChapter.path || `${i.book_alias}/${utils.formatHadithHeadingNumber(railChapter.h1 || i.h1)}`}`);
	const railSection = i.section || {};
	const railSectionTitle = (railSection.title_en || i.h2_title_en || '').toString().trim();
	const railSectionLabel = `${railSection.h2 || i.h2 || ''}${railSectionTitle ? ` ${railSectionTitle}` : ''}`.trim();
	const railSectionHref = utils.urlFor(req, `/${railSection.path || `${i.book_alias}/${utils.formatHadithHeadingNumber(railSection.h1 || i.h1)}/${utils.formatHadithHeadingNumber(railSection.h2 || i.h2)}`}`);
%>
<aside class="hadith-heading-toc hadith-metadata-rail hadith-metadata-side-rail d-none d-lg-block" data-toc-heading-rail aria-label="Hadith sections in <%= railBookName %>">
	<div class="hadith-heading-toc-sticky">
		<% if (railBookName) { %><a class="heading-toc-book-name" href="<%= railBookHref %>"><%= railBookName.toUpperCase() %></a><% } %>
		<% if (railChapterLabel) { %><a class="hadith-heading-toc-title heading-toc-book-title-link" href="<%= railChapterHref %>"><%= railChapterLabel %></a><% } %>
		<nav class="nav flex-column hadith-heading-toc-nav" data-toc-heading-rail-nav aria-label="Hadith and metadata sections">
			<% if (railSectionLabel) { %><a class="nav-link hadith-heading-toc-link" href="<%= railSectionHref %>"><%= railSectionLabel %></a><% } %>
			<% railGroups.forEach(function (group) { %><a class="nav-link hadith-heading-toc-link<%= group.key === railInitialKey ? ' active' : '' %>" href="#<%= railBase %>-<%= group.key %>" data-toc-heading-key="<%= group.key %>"<% if (group.key === 'reflection') { %> data-reflection-disclosure-trigger="comments-disclosure"<% } %><% if (group.key === railInitialKey) { %> aria-current="location"<% } %>><%= group.label %> <% if (group.key === 'reflection') { %><span class="badge text-bg-secondary hadith-comment-count" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>" data-comment-type="hadith" title="0 reflections">0</span><% } else { %><span class="badge text-bg-secondary"><%= group.count %></span><% } %></a><% }); %>
		</nav>
		<% if (!railNavigationOnly && railMetadata.sourceUrl) { %><a class="hadith-metadata-source-link small" href="<%= railMetadata.sourceUrl %>" target="_blank" rel="noopener noreferrer">hdith.com source <span class="bi bi-box-arrow-up-right" aria-hidden="true"></span></a><% } %>
	</div>
</aside>
