<%
	const railMetadata = i.hdithMetadata || {};
	const railEditMode = typeof site !== 'undefined' ? !!site.editMode : !!(typeof req !== 'undefined' && req.admin && req.editMode);
	const railNavigationOnly = typeof navigationOnly !== 'undefined' && navigationOnly;
	const railTopMenu = typeof topMenu !== 'undefined' && topMenu;
	const railGrades = Array.isArray(railMetadata.grades) ? railMetadata.grades : [];
	const railNarrators = Array.isArray(railMetadata.narrators) ? railMetadata.narrators : [];
	const railSharh = Array.isArray(railMetadata.sharh) ? railMetadata.sharh : [];
	const railGharib = Array.isArray(railMetadata.gharib) ? railMetadata.gharib : [];
	const railSourceSimilar = Array.isArray(railMetadata.similar) ? railMetadata.similar.filter(reference => reference.internal_ref) : [];
	const railBase = `hadith-metadata-${i.actual ? i.actual.id : i.id}`;
	const railGroups = (railNavigationOnly ? [] : [
		{ key: 'hadith', label: 'Hadith', count: null, always: true },
		{ key: 'reflection', label: 'Reflection', count: null, always: true },
		{ key: 'grades', label: 'Scholarly Grades', count: railGrades.length },
		{ key: 'isnad', label: 'Chain of Narrators', count: railNarrators.length },
		{ key: 'sharh', label: 'Explanations', count: railSharh.length },
		{ key: 'gharib', label: 'Definitions', count: railGharib.length },
		{ key: 'mushabihah', label: 'Similar Hadiths', count: (Array.isArray(i.similar) ? i.similar.length : 0) + railSourceSimilar.length, always: railEditMode }
	]).filter(group => group.always || group.count);
	const railInitialKey = railGroups.length ? railGroups[0].key : '';
	const railBookName = (i.book_shortName_en || (i.book && (i.book.shortName_en || i.book.name_en)) || i.book_alias || '').toString().trim();
	const railBookHref = utils.urlFor(req, `/${i.book_alias}`);
	const railChapter = i.chapter || {};
	const railChapterTitle = (railChapter.title_en || i.h1_title_en || '').toString().trim();
	const railChapterLabel = `${railChapter.h1 || i.h1 || ''}${railChapterTitle ? ` ${railChapterTitle}` : ''}`.trim();
	const railChapterHref = utils.urlFor(req, `/${railChapter.path || `${i.book_alias}/${utils.formatHadithHeadingNumber(railChapter.h1 || i.h1)}`}`);
	const railSection = i.section || {};
	const railSectionTitle = (railSection.title_en || i.h2_title_en || '').toString().trim();
	const railSectionLabel = `${railSection.h2 || i.h2 || ''}${railSectionTitle ? ` ${railSectionTitle}` : ''}`.trim();
	const railSectionHref = utils.urlFor(req, `/${railSection.path || `${i.book_alias}/${utils.formatHadithHeadingNumber(railSection.h1 || i.h1)}/${utils.formatHadithHeadingNumber(railSection.h2 || i.h2)}`}`);
	const railTopMenuId = railTopMenu ? 'toc2' : `${railBase}-section-menu`;
%>
<% if (railTopMenu) { %>
<nav class="row g-0 chapter-toc hadith-detail-section-menu" aria-label="Hadith sections in <%= railBookName %>">
	<div class="col-12 chapter-toc-toolbar">
		<a class="chapter-toc-toggle" data-bs-toggle="collapse" href="#<%= railTopMenuId %>" role="button" aria-expanded="false" aria-controls="<%= railTopMenuId %>" title="Show hadith sections">
			<i class="bi bi-list-ul" aria-hidden="true"></i>
			<span>Sections</span>
			<span class="chapter-toc-current">Hadith</span>
			<i class="bi bi-chevron-down chapter-toc-chevron" aria-hidden="true"></i>
		</a>
	</div>
	<div id="<%= railTopMenuId %>" class="col-12 toc2 collapse chapter-toc-panel">
		<table class="table chapter-toc-table">
			<tbody>
				<% if (railBookName) { %><tr class="title" data-quran-menu-href="<%= railBookHref %>"><td><a href="<%= railBookHref %>"><%= railBookName %></a></td></tr><% } %>
				<% if (railChapterLabel) { %><tr class="title" data-quran-menu-href="<%= railChapterHref %>"><td><a href="<%= railChapterHref %>"><%= railChapterLabel %></a></td></tr><% } %>
				<% if (railSectionLabel) { %><tr class="title" data-quran-menu-href="<%= railSectionHref %>"><td><a href="<%= railSectionHref %>"><%= railSectionLabel %></a></td></tr><% } %>
				<% railGroups.forEach(function (group) { %><tr class="title<%= group.key === railInitialKey ? ' is-current' : '' %>" data-toc-heading-scroll="<%= group.key %>"<% if (group.key === 'reflection') { %> data-reflection-disclosure-trigger="comments-disclosure"<% } %>><td><button type="button" class="hadith-detail-section-control" data-toc-heading-key="<%= group.key %>"<% if (group.key === 'reflection') { %> data-reflection-disclosure-trigger="comments-disclosure"<% } %><% if (group.key === railInitialKey) { %> aria-current="location"<% } %>><%= group.label %><% if (group.key === 'reflection') { %> <span class="badge text-bg-secondary hadith-comment-count" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>" data-comment-type="hadith" title="0 reflections">0</span><% } else if (group.count !== null) { %> <span class="badge text-bg-secondary"><%= group.count %></span><% } %></button></td></tr><% }); %>
			</tbody>
		</table>
	</div>
</nav>
<% } else { %>
<aside class="hadith-heading-toc hadith-metadata-rail hadith-metadata-side-rail d-none d-lg-block" data-toc-heading-rail aria-label="Hadith sections in <%= railBookName %>">
	<div class="hadith-heading-toc-sticky">
		<% if (railBookName) { %><a class="heading-toc-book-name" href="<%= railBookHref %>"><%= railBookName.toUpperCase() %></a><% } %>
		<% if (railChapterLabel) { %><a class="hadith-heading-toc-title heading-toc-book-title-link" href="<%= railChapterHref %>"><%= railChapterLabel %></a><% } %>
		<nav class="nav flex-column hadith-heading-toc-nav" data-toc-heading-rail-nav aria-label="Hadith and metadata sections">
			<% if (railSectionLabel) { %><a class="nav-link hadith-heading-toc-link" href="<%= railSectionHref %>"><%= railSectionLabel %></a><% } %>
			<% railGroups.forEach(function (group) { %><button type="button" class="nav-link hadith-heading-toc-link<%= group.key === railInitialKey ? ' active' : '' %>" data-toc-heading-key="<%= group.key %>"<% if (group.key === 'reflection') { %> data-reflection-disclosure-trigger="comments-disclosure"<% } %><% if (group.key === railInitialKey) { %> aria-current="location"<% } %>><%= group.label %><% if (group.key === 'reflection') { %> <span class="badge text-bg-secondary hadith-comment-count" data-hadith-id="<%= i.actual ? i.actual.id : i.id %>" data-comment-type="hadith" title="0 reflections">0</span><% } else if (group.count !== null) { %> <span class="badge text-bg-secondary"><%= group.count %></span><% } %></button><% }); %>
		</nav>
		<% if (railEditMode && !railNavigationOnly && railMetadata.sourceUrl) { %><a class="hadith-metadata-source-link small" href="<%= railMetadata.sourceUrl %>" target="_blank" rel="noopener noreferrer">hdith.com source <span class="bi bi-box-arrow-up-right" aria-hidden="true"></span></a><% } %>
	</div>
</aside>
<% } %>
