<aside class="tags quran-ayah-hero-toolbar col-12">
  <% if (selectedAyahId) { %>
    <button type="button" class="hadith-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= selectedAyahId %>" title="Bookmark this ayah">
      <span class="hadith-bookmark-icon bi bi-bookmark text-accent" data-hadith-id="<%= selectedAyahId %>"></span>
    </button>
    <span class="quran-ayah-action">
      <button type="button" class="hadith-like-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= selectedAyahId %>" data-like-type="hadith" title="Like this ayah">
        <span class="hadith-like-icon bi bi-heart text-danger" data-hadith-id="<%= selectedAyahId %>" data-like-type="hadith"></span>
      </button>
      <span class="hadith-like-count fw-semibold text-danger" data-hadith-id="<%= selectedAyahId %>" data-like-type="hadith">0</span>
    </span>
  <% } %>
  <% if (selectedAyahModalIndex >= 0) { %>
    <button type="button" class="quran-ayah-modal-trigger reflection-count-link text-accent" data-quran-ayah-modal-index="<%= selectedAyahModalIndex %>" data-quran-ayah-modal-type="reflections" title="View reflections">
      <span class="bi bi-chat-right-text"></span><span class="hadith-comment-count fw-semibold" data-hadith-id="<%= selectedAyahId %>" title="0 reflections">0</span>
    </button>
    <button type="button" class="quran-ayah-modal-trigger quran-ayah-action text-accent" data-quran-ayah-modal-index="<%= selectedAyahModalIndex %>" data-quran-ayah-modal-type="tafsirs" title="View tafsir" aria-label="View tafsir">
      <span class="bi bi-book-half"></span><span class="quran-ayah-action-label">Tafsir</span>
    </button>
    <% if (!locals.hideTranslationsAction) { %>
      <button type="button" class="quran-ayah-modal-trigger quran-ayah-action text-accent" data-quran-ayah-modal-index="<%= selectedAyahModalIndex %>" data-quran-ayah-modal-type="translations" title="View translations" aria-label="View translations">
        <span class="bi bi-translate"></span><span class="quran-ayah-action-label">Translations</span>
      </button>
    <% } %>
  <% } %>
  <% if (locals.viewHref) { %>
    <a href="<%= viewHref %>" title="View selected ayah" aria-label="View selected ayah" class="quran-ayah-action icon text-decoration-none">
      <span class="bi bi-eye"></span><span class="quran-ayah-action-label">View</span>
    </a>
  <% } %>
  <a href="#<%= quranShareId %>" type="button" title="Share selected ayah image" aria-label="Share selected ayah image" class="quran-ayah-action icon text-decoration-none" data-bs-toggle="modal" data-bs-target="#<%= quranShareId %>">
    <span class="bi bi-box-arrow-up"></span><span class="quran-ayah-action-label">Share</span>
  </a>
</aside>
