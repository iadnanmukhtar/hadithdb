<%
    var book = page.context.book;
    var chapter = page.context.chapter;
    var section = page.context.section;
    var headingEnglishOnly = locals.headingEnglishOnly;
    var quranHeadingAyahModalIndex = Number.isInteger(locals.quranHeadingAyahModalIndex) ? locals.quranHeadingAyahModalIndex : -1;
    var showQuranHeadingModalActions = quranHeadingAyahModalIndex >= 0;
    var isQuranHeading = book && book.alias === 'quran' && heading && Number(heading.level) >= 2;
	var isHadithHeading = book && book.alias !== 'quran' && heading && Number(heading.level) >= 2;
	var isHadithHeadingTarget = isHadithHeading && !page.context.continued;
	var headingKindEn = heading && Number(heading.level) === 3 ? 'Subsection' : (isQuranHeading ? 'Passage' : 'Section');
    var quranHeadingKey = isQuranHeading ? `${heading.h1}.${heading.h2}${heading.h3 ? `.${heading.h3}` : ''}` : '';
	var hadithHeadingKey = isHadithHeading ? `${book.alias}:${heading.h1}.${heading.h2}${heading.h3 ? `.${heading.h3}` : ''}` : '';
    if (chapter.h1 != Math.floor(chapter.h1))
      chapter.h1 = Number(chapter.h1).toFixed(2);
%>

<a id="S<%- heading.h2 + (heading.h3 ? `-${heading.h3}` : '') %>"></a>

<%# Heading Title %>
<article class="col-12 mt-4"<% if (isQuranHeading) { %> id="quran-heading-<%= quranHeadingKey.replace(/\./g, '-') %>" data-quran-heading-target data-quran-heading-key="<%= quranHeadingKey %>" data-quran-heading-surah="<%= heading.h1 %>"<% } else if (isHadithHeading) { %> id="hadith-heading-<%= hadithHeadingKey.replace(/[^A-Za-z0-9_-]/g, '-') %>"<% if (isHadithHeadingTarget) { %> data-hadith-heading-target<% } %> data-hadith-heading-key="<%= hadithHeadingKey %>" data-hadith-heading-context="<%= `${book.alias}:${heading.h1}` %>" data-hadith-heading-level="<%= heading.level %>"<% if (Number(heading.level) === 3) { %> data-hadith-heading-parent-key="<%= `${book.alias}:${heading.h1}.${heading.h2}` %>"<% } %><% } %>>

  <heading class="row heading py-2">
    
    <h3 class="<%= headingEnglishOnly ? 'col-12' : 'col-md-6 col-sm-12' %> fs-5 title<%= showQuranHeadingModalActions ? ' quran-section-heading-title' : '' %>" lang="en">
      <span class="quran-section-heading-text">
		<button type="button" class="heading-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center me-1" data-heading-id="<%= heading.id %>" data-bookmark-type="<%= heading.level === 3 ? 'subsection' : 'section' %>" data-bookmark-ref="<%= `${book.alias}:${heading.h1}.${heading.h2}${heading.h3 ? `.${heading.h3}` : ''}` %>" data-bookmark-title="<%= heading.title_en || headingKindEn %>" data-bookmark-title-ar="<%= heading.title || '' %>" data-bookmark-url="<%= utils.urlFor(req, `/${heading.path}`) %>" title="Bookmark this <%= headingKindEn.toLowerCase() %>">
          <span class="heading-bookmark-icon bi bi-bookmark text-accent" data-heading-id="<%= heading.id %>"></span>
        </button>
        <% if (site.editMode) { %>
        (<span class="_e" title="Start Num" data-id="<%= heading.id %>" data-prop="toc.start">
          <%- heading.start || '&hellip;' %>
        </span>) (<span class="_e" title="Start Num0" data-id="<%= heading.id %>" data-prop="toc.start0">
          <%- heading.start0 || '&hellip;' %>
        </span>)
        <% } %>
        <%- `${heading.h1}.${heading.h2}` + (heading.h3 ? `.${heading.h3}` : '') %>
        <% if (page.menu === 'Chapter')  { %>
        <a href="<%= utils.urlFor(req, `/${heading.path}`) %>" class="_e" data-id="<%= heading.id %>" data-prop="toc.title_en" data-arabizi="true">
		  <%- heading.title_en || headingKindEn %>
        </a>
        <% } else { %>
        <span href="<%= utils.urlFor(req, `/${heading.path}`) %>" class="_e" data-id="<%= heading.id %>" data-prop="toc.title_en" data-arabizi="true">
		  <%- heading.title_en || headingKindEn %>
        </span>
        <% } %>
        <% if (page.context.continued) { %>
        <small class="text-muted">(contd &hellip;)</small>
        <% } %>
      </span>
      <% if (showQuranHeadingModalActions) { %>
      <span class="quran-section-heading-actions">
        <button type="button" class="quran-ayah-modal-trigger quran-section-heading-action btn btn-sm btn-outline-secondary" data-quran-ayah-modal-index="<%= quranHeadingAyahModalIndex %>" data-quran-ayah-modal-type="tafsirs" title="View tafsir" aria-label="View tafsir">
          <span class="bi bi-book-half" aria-hidden="true"></span><span>Tafsir</span>
        </button>
        <button type="button" class="quran-ayah-modal-trigger quran-section-heading-action btn btn-sm btn-outline-secondary" data-quran-ayah-modal-index="<%= quranHeadingAyahModalIndex %>" data-quran-ayah-modal-type="translations" title="View translations" aria-label="View translations">
          <span class="bi bi-translate" aria-hidden="true"></span><span>Translations</span>
        </button>
      </span>
      <% } %>
    </h3>
    
    <% if (!headingEnglishOnly) { %>
    <h3 class="col-md-6 col-sm-12 title" lang="ar">
      <%- `${arabic.toArabicDigits(heading.h1 + '')}۔${arabic.toArabicDigits(heading.h2 + '')}` + (heading.h3 ? `۔${arabic.toArabicDigits(heading.h3+'')}` : '') %>
      <% if (page.menu === 'Chapter')  { %>
        <a href="<%= utils.urlFor(req, `/${heading.path}`) %>" class="_e" data-id="<%= heading.id %>" data-prop="toc.title" data-arabizi="true">
          <%- heading.title || (heading.level === 3 ? 'مقطع' : 'مقطع') %>
        </a>
        <% } else { %>
        <span href="<%= utils.urlFor(req, `/${heading.path}`) %>" class="_e" data-id="<%= heading.id %>" data-prop="toc.title" data-arabizi="true">
          <%- heading.title || (heading.level === 3 ? 'مقطع' : 'مقطع') %>
        </span>
      <% } %>
    </h3>
    <% } %>

  </heading>

  <%# Heading Intro %>
  <%
    var headingIntroShowEn = Boolean(utils.emptyIfNull(heading.intro_en) || site.editMode);
    var headingIntroShowAr = Boolean(utils.emptyIfNull(heading.intro) || site.editMode);
  %>
  <% if (headingIntroShowEn || headingIntroShowAr) { %>
  <section class="col-12">
    <div class="row heading-intro mb-3">

      <% if (headingIntroShowEn) { %>
      <section class="_e <%= headingIntroShowAr ? 'col-md-6 col-sm-12' : 'col-12' %> intro" lang="en" data-id="<%= heading.id %>" data-prop="toc.intro_en" data-reader-language-column="english" data-arabizi="true" data-markdown-source="<%= utils.emptyIfNull(heading.intro_en) %>" data-markdown-empty-html="&hellip;">
        <% if (heading.intro_en || site.editMode) { 
            const introEn = utils.markdownToHtml(heading.intro_en) || '&hellip;';
        %>
        <div>
          <%- introEn %>
        </div>
        <% } %>
      </section>
      <% } %>

      <% if (headingIntroShowAr) { %>
      <section class="_e <%= headingIntroShowEn ? 'col-md-6 col-sm-12' : 'col-12' %> intro" lang="ar" data-id="<%= heading.id %>" data-prop="toc.intro" data-reader-language-column="arabic" data-markdown-source="<%= utils.emptyIfNull(heading.intro) %>" data-markdown-empty-html="&hellip;">
        <% if (heading.intro || site.editMode) { 
            const introAr = utils.markdownToHtml(heading.intro) || '&hellip;';
        %>
        <div>
          <%- introAr %>
        </div>
        <% } %>
      </section>
      <% } %>

    </div>
  </section>
  <% } %>

</article>
