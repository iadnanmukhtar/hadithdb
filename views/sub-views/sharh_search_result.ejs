<article class="commentary-search-result sharh-search-result row mt-3" data-reader-language-item="hadith" data-sharh-book-id="<%= commentary.bookId %>">
  <%- include('search_result_header.ejs', { resultKind: 'Sharh' }); %>
  <% if (commentary.commentary_is_bilingual) { %>
    <div class="commentary-search-fragment col-md-6 col-sm-12" lang="en" data-reader-language-column="english"><div class="search-result-reference"><a href="<%= commentary.url %>"><%= commentary.commentary_ref_en %></a></div><%- commentary.commentary_fragment_html_en %></div>
    <div class="commentary-search-fragment col-md-6 col-sm-12" lang="ar" data-reader-language-column="arabic" dir="rtl"><div class="search-result-reference"><a href="<%= commentary.url %>"><%= commentary.commentary_ref_ar %></a></div><%- commentary.commentary_fragment_html_ar %></div>
  <% } else if (commentary.commentary_fragment_html_en) { %>
    <div class="commentary-search-fragment col-12" lang="en" data-reader-language-column="english"><div class="search-result-reference"><a href="<%= commentary.url %>"><%= commentary.commentary_ref_en %></a></div><%- commentary.commentary_fragment_html_en %></div>
  <% } else { %>
    <div class="commentary-search-fragment col-12" lang="ar" data-reader-language-column="arabic" dir="rtl"><div class="search-result-reference"><a href="<%= commentary.url %>"><%= commentary.commentary_ref_ar %></a></div><%- commentary.commentary_fragment_html_ar %></div>
  <% } %>
  <% if (commentary.id) { %><%- include('notebook_anchor.ejs', { noteKey: `sharh:${commentary.id}`, noteTitle: commentary.commentary_ref_en || commentary.ref, noteUrl: commentary.url }); %><% } %>
</article>
