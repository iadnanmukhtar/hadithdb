<%
  const groups = [
    ['Read & study', [
      ['Quran', utils.quranUrl(req, '/quran'), 'quran'],
      ['Study by ayah', utils.quranUrl(req, '/quran/1'), 'text-paragraph'],
      ['Mushaf', utils.quranUrl(req, '/quran/page'), 'mushaf'],
      ['Translations', utils.urlFor(req, '/books?translation'), 'translation'],
      ['Tafsir', utils.urlFor(req, '/books?tafsir'), 'tafsir'],
      ['Hadith', utils.hadithBaseUrl(req), 'hadith'],
      ['Sirah', utils.urlFor(req, '/ibnhisham'), 'sirah']
    ]],
    ['Memorize', [
      ['Practice', utils.quranUrl(req, '/quran/page?memorize'), 'eye-slash'],
      ['Mudhakkir review', utils.quranUrl(req, '/quran/review'), 'arrow-repeat']
    ]],
    ['Community', [
      ['Community feed', utils.urlFor(req, '/community'), 'people'],
      ['Blog', utils.urlFor(req, '/blog'), 'newspaper']
    ]],
    ['Personal', [
      ['Profile', profileHref, 'person'],
      ['My Notebook', utils.urlFor(req, '/notebook'), 'sticky'],
      ['My Bookmarks', utils.urlFor(req, '/bookmarks'), 'bookmark'],
      ['Settings', settingsHref, 'gear']
    ]]
  ];
%>
<% for (const [group, entries] of groups) { %>
<section class="ux-menu-group ux-menu-list"><h2><%= group %></h2>
  <ul class="<%= group === 'Personal' ? 'offcanvas-col1' : '' %>">
    <% for (const [label, href, icon] of entries) { %>
    <li<% if (label === 'Profile') { %> data-drawer-profile hidden<% } else if (label === 'My Notebook') { %> data-notebook-auth<% } %>><a href="<%= href %>"<% if ((label === 'Settings' && isSettingsArea) || (page.context?.bookCatalogInitialType && ((icon === 'translation' && page.context?.bookCatalogInitialType === 'translations') || (icon === 'tafsir' && page.context?.bookCatalogInitialType === 'tafsir-all')))) { %> aria-current="page"<% } %>>
      <% if (['quran', 'tafsir', 'hadith', 'sirah', 'mushaf', 'translation'].includes(icon)) { %><%- include('menu_icon.ejs', { type: icon, label }) %><% } else { %><i class="app-menu-icon bi bi-<%= icon %>" aria-hidden="true"></i><% } %><%= label %>
    </a></li>
    <% } %>
  </ul>
</section>
<% } %>
