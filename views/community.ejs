<!doctype html>
<html lang="en"><head>
<% var site = Object.assign({}, global.settings.site, { admin: false, editMode: false }); %>
<%- include('sub-views/head.ejs', { site, page: view === 'everyone' ? { ...page, title_en: 'Hadith Unlocked Community' } : page }); %>
<style><%- include('sub-views/notebook_content_styles.ejs'); %></style>
</head><body class="community-page">
<%- include('sub-views/header.ejs', { site, page }); %>
<% if (view === 'email-preferences') { %><div class="container col-lg-8 mx-auto"><% } %>
<main class="<%= view === 'email-preferences' ? 'search-results settings-page' : view === 'post' ? 'container-fluid community-article-layout' : 'container' %> py-4 community" id="community" data-view="<%= view %>" data-author="<%= author?.handle || '' %>" data-post="<%= post?.id || '' %>">
  <% if (view !== 'post' || post.title?.trim()) { %>
  <div class="<%= view === 'email-preferences' ? 'settings-page-heading mb-3' : 'community-heading' %>">
    <% if (view === 'email-preferences') { %><a href="/settings#settings-email-section" class="btn btn-link btn-sm p-0 mb-3"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to My Settings</a><% } %>
    <div><h1 class="<%= view === 'email-preferences' ? 'fs-4 mb-1' : '' %>" id="community-page-title" dir="auto"><%= view === 'post' ? post.title : view === 'author' ? author.name : page.title_en %></h1>
    <% if (['everyone','following','mine'].includes(view)) { %><p class="community-intro"><%= view === 'mine' ? 'Your posts, articles, reflections, comments, and publication drafts.' : view === 'following' ? 'The latest writing and conversations from authors you follow.' : 'Posts, articles, and discussions from the community.' %></p><% } %>
    </div>
  </div>
  <% } %>
  <p id="community-status" class="small text-muted" role="status" aria-live="polite"></p>
  <% if (view === 'mine') { %>
  <section id="community-wall-profile" class="community-profile mb-4" aria-label="My profile" hidden>
    <span id="community-wall-avatar" class="community-avatar community-avatar-large" aria-hidden="true"></span>
    <div class="community-profile-copy">
      <div class="community-profile-identity">
        <strong id="community-wall-name" dir="auto"></strong><span id="community-wall-handle" class="small text-muted"></span>
      </div>
      <p id="community-wall-bio" class="mb-1 mt-2" dir="auto"></p><p id="community-wall-stats" class="small text-muted mb-0"></p>
      <p id="community-wall-federation" class="small text-muted mt-2 mb-0" hidden></p>
    </div>
    <div class="community-profile-actions"><button id="community-edit-profile" type="button" class="btn btn-sm btn-outline-secondary" aria-haspopup="dialog" aria-controls="community-profile-dialog">Edit profile</button></div>
  </section>
  <% } %>
  <% if (author && ['author','post'].includes(view)) { %>
  <section id="community-author-profile" class="community-profile mb-4" aria-label="About the author"<% if (view === 'author') { %> hidden<% } %>>
    <span id="community-author-avatar" class="community-avatar community-avatar-large" aria-hidden="true"><%- include('sub-views/community_avatar.ejs', { avatar: author }) %></span>
    <div class="community-profile-copy"><div class="community-profile-identity"><a id="community-author-name" class="fw-semibold" href="/community/@<%= author.handle %>" dir="auto"><%= author.name %></a><span class="small text-muted">@<%= author.handle %></span></div>
    <% if (view === 'author') { %><p id="community-author-bio" class="mb-1 mt-2" dir="auto"></p><p id="community-author-stats" class="small text-muted mb-0"></p><p id="community-author-federation" class="small text-muted mt-2 mb-0" hidden></p><% } %></div>
    <div id="community-follow-controls" data-author-follow-controls class="community-profile-actions d-flex flex-wrap gap-2"><button class="btn btn-sm btn-outline-primary" id="community-follow" data-author-follow type="button">Follow</button></div>
  </section>
  <% } %>
  <% if (['everyone','following','mine','author'].includes(view)) { %>
  <div class="community-columns"<% if (view === 'author') { %> id="community-author-content" hidden<% } %>><section class="community-wall" aria-label="Activity wall">
    <% if (['everyone', 'following', 'mine','author'].includes(view)) { %>
    <button id="community-quick-open" type="button" class="community-quick-prompt" aria-haspopup="dialog" aria-controls="community-quick-dialog"><span class="community-avatar" id="community-prompt-avatar" aria-hidden="true"><i class="bi bi-person"></i></span><span>What's on your mind?</span></button>
    <dialog id="community-quick-dialog" class="community-quick-dialog" aria-label="Write a public post">
    <form id="community-quick-form" class="community-composer" aria-label="Create or edit a post">
      <button type="button" class="btn-close community-composer-close" data-close-quick aria-label="Close editor"></button>
      <div class="community-composer-heading"><span class="community-avatar" id="community-quick-avatar" aria-hidden="true"><i class="bi bi-person"></i></span><div><span class="community-composer-name" id="community-quick-name">Share a post</span><span id="community-quick-audience" class="community-composer-audience"><i class="bi bi-globe2" aria-hidden="true"></i> Public post</span></div></div>
      <label class="visually-hidden" for="community-quick-text">What's on your mind?</label>
      <details id="community-quick-options" class="community-post-options"><summary>Title and cover <span class="text-muted">(optional)</span></summary>
      <label for="community-quick-title" class="small text-muted">Title (optional)</label><input id="community-quick-title" class="form-control form-control-sm mb-2" maxlength="240" dir="auto" placeholder="Leave blank for no visible title">
      <div id="community-quick-cover" class="community-editor-cover" hidden></div>
      <label class="small text-muted">Cover image <input id="community-quick-cover-file" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control form-control-sm"></label>
      </details>
      <textarea data-short-editor id="community-quick-text" rows="6" maxlength="10000" required dir="auto" placeholder="What's on your mind?" aria-describedby="community-quick-status"></textarea>
      <div class="community-media-toolbar" data-media-editor="quick-text"><button type="button" data-add-image title="Add image"><i class="bi bi-image" aria-hidden="true"></i> Image</button><button type="button" data-add-link title="Add webpage preview"><i class="bi bi-link-45deg" aria-hidden="true"></i> Link</button><button type="button" data-add-video title="Add video preview"><i class="bi bi-play-btn" aria-hidden="true"></i> Video</button><input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple hidden><span class="community-media-status" role="status"></span></div>
      <div id="community-quick-attachments" class="community-attachment-list"></div>
      <div id="community-quick-preview" class="notebook-markdown" hidden></div>
      <div class="community-composer-footer"><a id="community-quick-new-article" href="/community/write?kind=article"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Write an article</a><div class="community-posting-actions"><button id="community-quick-preview-button" type="button" class="community-preview-action" hidden>Preview</button><button type="button" class="btn btn-sm btn-outline-secondary" data-close-quick>Cancel</button><button id="community-quick-post" class="btn btn-sm btn-primary" type="submit" disabled>Post</button></div></div>
      <div id="community-quick-edit-actions" class="community-maintenance-actions" hidden><button id="community-quick-convert" type="button" class="btn btn-sm btn-link community-secondary-action">Convert to Article</button><button id="community-quick-delete" type="button" class="btn btn-sm btn-link text-danger">Delete post</button></div>
      <p id="community-quick-status" class="community-composer-status" role="status" aria-live="polite"></p>
    </form>
    </dialog>
    <% } %>
    <% if (view === 'following') { %>
    <section id="community-alerts" class="community-alerts mb-4" aria-labelledby="community-alerts-heading" hidden>
      <h2 id="community-alerts-heading" class="fs-5">New alerts</h2>
      <p class="small text-muted">Activity from people you follow, and replies or reactions to your contributions.</p>
      <div data-community-alert-list></div>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-community-alert-more hidden>Show more alerts</button>
      <p class="small text-muted" data-community-alert-status role="status"></p>
    </section>
    <% } %>
    <div class="community-feed-toolbar"><h2><%= view === 'mine' ? 'Your activity' : view === 'following' ? 'From authors you follow' : view === 'author' ? 'Writing & conversations' : 'In the community' %></h2>
    <label class="visually-hidden" for="community-filter">Filter activity</label><select class="form-select form-select-sm community-filter" id="community-filter"><option value="all">All activity</option><% if (view === 'mine') { %><option value="draft">Drafts</option><option value="hidden">Hidden</option><% } %><option value="article">Articles</option><option value="note">Posts</option><option value="comment">Comments</option><option value="like">Likes</option></select></div>
    <div id="community-feed" class="community-feed"><% if (initial) { %><%- include('sub-views/community_feed.ejs', { items: initial.items }); %><% if (!initial.items.length) { %><p class="community-empty">No public posts yet. Start a reflection or share an article.</p><% } } %></div>
    <div id="community-feed-sentinel" class="community-feed-sentinel" aria-hidden="true"></div>
    <p id="community-feed-status" class="small text-muted" role="status" aria-live="polite"></p>
    <button class="btn btn-sm btn-outline-secondary community-more" id="community-more" type="button" hidden>Load more</button>
  </section><%- include('sub-views/community_rail.ejs'); %></div>
  <% } %>
  <% if (view === 'mine') { %>
  <dialog id="community-profile-dialog" class="community-quick-dialog community-profile-dialog" aria-labelledby="community-profile-dialog-title">
    <div class="d-flex justify-content-between align-items-center"><h2 id="community-profile-dialog-title">Edit profile</h2><button type="button" class="btn btn-sm btn-link text-muted" data-close-profile-dialog aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    <form id="community-profile-form" class="mt-3">
      <div class="community-photo-editor mb-3">
        <img id="community-photo-preview" class="community-profile-photo-preview" alt="Profile photo preview">
        <label class="form-label" for="community-photo-file">Profile picture</label>
        <input id="community-photo-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="form-control mb-2">
        <button id="community-photo-remove" type="button" class="btn btn-sm btn-outline-secondary" disabled>Use account photo</button>
        <div id="community-photo-crop" hidden>
          <p class="small text-muted mt-2">Drag to position your photo, or use the sliders. Your picture appears in a circle.</p>
          <canvas id="community-photo-canvas" width="512" height="512" aria-label="Profile picture crop preview"></canvas>
          <label for="community-photo-zoom">Zoom</label><input id="community-photo-zoom" type="range" min="1" max="4" step="0.01" value="1">
          <label for="community-photo-x">Horizontal position</label><input id="community-photo-x" type="range" min="0" max="100" step="0.1" value="50">
          <label for="community-photo-y">Vertical position</label><input id="community-photo-y" type="range" min="0" max="100" step="0.1" value="50">
          <div class="d-flex gap-2"><button id="community-photo-reset" type="button" class="btn btn-sm btn-outline-secondary" disabled>Reset crop</button><button id="community-photo-apply" type="button" class="btn btn-sm btn-primary" disabled>Apply crop</button></div>
        </div>
        <p id="community-photo-error" class="small mt-2" role="status" aria-live="polite"></p>
      </div>
      <label class="form-label" for="community-name">Community display name</label><input id="community-name" class="form-control mb-2" maxlength="120" required dir="auto">
      <p class="small text-muted">Your custom display name is shown as entered. If it matches your Google name, others see only your first name.</p>
      <label class="form-label" for="community-handle">Handle</label><div class="d-flex align-items-center gap-2 mb-2"><input id="community-handle" aria-describedby="community-handle-status" class="form-control" pattern="[a-zA-Z0-9_.\-]{3,40}" maxlength="40" required><i id="community-handle-icon" class="bi" aria-hidden="true" hidden></i></div><p id="community-handle-status" class="small" role="status" aria-live="polite"></p><p class="small text-muted">Use 3–40 letters, numbers, periods, underscores, or hyphens. Choose once; this becomes your permanent public address.</p>
      <label class="form-label" for="community-bio">Bio</label><textarea id="community-bio" class="form-control" rows="3" dir="auto" aria-describedby="community-bio-help community-bio-count"></textarea>
      <div class="d-flex justify-content-between gap-2 mb-3 small text-muted"><span id="community-bio-help">Up to 150 characters, 3 lines, and 5 web links. Plain text only.</span><span id="community-bio-count" class="text-nowrap">0 / 150</span></div>
      <div class="form-check form-switch mb-2">
        <input id="community-visibility" class="form-check-input" type="checkbox" role="switch" aria-describedby="community-visibility-help">
        <label class="form-check-label" for="community-visibility">Public profile</label>
      </div>
      <p id="community-visibility-help" class="small text-muted">On: signed-in users can view your profile. Off: only you can view it. Published posts and comments remain visible in Community.</p>
      <% if (page.context && page.context.federationEnabled) { %><p class="small text-muted">With a public profile, your public activity is also shared with fediverse followers. Making your profile private stops sharing and requests removal of previously shared activity.</p><% } %>
      <p id="community-profile-error" class="small text-danger" role="status"></p>
      <div class="d-flex justify-content-end gap-2"><button type="button" class="btn btn-sm btn-outline-secondary" data-close-profile-dialog>Cancel</button><button class="btn btn-sm btn-primary" type="submit">Save profile</button></div>
    </form>
  </dialog>
  <dialog id="community-people-dialog" class="community-quick-dialog community-profile-dialog" aria-labelledby="community-people-title">
    <div class="d-flex justify-content-between align-items-center"><h2 id="community-people-title">Followers</h2><button type="button" class="btn btn-sm btn-link text-muted" id="community-people-close" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    <div id="community-followers" class="mt-3 small" aria-live="polite"></div><div id="community-subscriptions" class="mt-3 small" hidden></div>
  </dialog>
  <% } %>
  <% if (view === 'write') { %>
  <section class="community-editor" aria-label="Publication editor">
    <button type="button" class="btn-close community-editor-close" data-close-editor aria-label="Close editor"></button>
    <div class="community-editor-top"><div><span class="community-editor-eyebrow">Your next article</span><p>Write, preview, and share with the community.</p></div><button id="community-import" class="btn btn-sm btn-outline-secondary" type="button"><i class="bi bi-journal-text" aria-hidden="true"></i> From My Notebook</button></div>
    <form id="community-editor-form">
      <input id="community-kind" type="hidden" value="article">
      <div id="community-import-panel" class="community-card" hidden><label class="form-label" for="community-notebook-search">Find a saved note</label><input id="community-notebook-search" class="form-control mb-2" type="search" dir="auto"><div id="community-notebook-results"></div><button id="community-notebook-more" class="btn btn-sm btn-outline-secondary mt-2" type="button" hidden>More notes</button></div>
      <label class="visually-hidden" for="community-title">Article title (optional)</label><input id="community-title" class="form-control community-article-title mb-4" maxlength="240" dir="auto" placeholder="Article title (optional)">
      <details id="community-article-options" class="community-post-options community-article-options"><summary>Subtitle and cover <span class="text-muted">(optional)</span></summary>
      <label class="form-label" for="community-subtitle">Subtitle <span class="text-muted">(optional)</span></label><input id="community-subtitle" class="form-control mb-4" maxlength="1000" dir="auto" placeholder="Add a short introduction to your article">
      <div class="mb-4" id="community-cover-controls"><input id="community-cover-url" type="hidden"><label class="form-label d-block" for="community-cover-file">Cover image</label><input id="community-cover-file" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control form-control-sm"><button id="community-cover-remove" type="button" class="btn btn-sm btn-link text-muted" hidden>Remove cover</button><span id="community-cover-status" class="small text-muted" role="status"></span></div>
      </details>
      <div class="community-media-toolbar" data-media-editor="markdown"><button type="button" data-add-image title="Add image"><i class="bi bi-image" aria-hidden="true"></i> Image</button><button type="button" data-add-link title="Add webpage preview"><i class="bi bi-link-45deg" aria-hidden="true"></i> Link</button><button type="button" data-add-video title="Add video preview"><i class="bi bi-play-btn" aria-hidden="true"></i> Video</button><input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple hidden><span class="community-media-status" role="status"></span></div>
      <div id="community-article-attachments" class="community-attachment-list"></div>
      <div class="community-writing-label"><label class="form-label" for="community-markdown">Article</label><span id="community-markdown-help">Use the formatting bar · Markdown available</span></div>
      <div id="community-format-toolbar" class="community-format-toolbar" role="group" aria-label="Article formatting">
        <select id="community-format-style" aria-label="Text style"><option value="0">Normal</option><% for (let level=1;level<=6;level++) { %><option value="<%= level %>">Heading <%= level %></option><% } %><option value="subtext">Subtext</option></select>
        <% for (const [action,label,icon] of [['bold','Bold','type-bold'],['italic','Italic','type-italic'],['underline','Underline','type-underline'],['strike','Strikethrough','type-strikethrough'],['subscript','Subscript',null],['superscript','Superscript',null],['highlight','Highlight','brush'],['center','Align center','text-center'],['numbered','Numbered list','list-ol'],['bullets','Bullet list','list-ul'],['quote','Quotation','quote'],['divider','Insert divider','hr'],['footnote','Insert footnote',null],['link','Insert link','link-45deg'],['clear','Clear formatting','eraser']]) { %>
        <button type="button" data-format="<%= action %>" title="<%= label %>" aria-label="<%= label %>"><% if (action === 'subscript' || action === 'superscript') { %><span class="community-script-icon" dir="ltr" aria-hidden="true">x<% if (action === 'subscript') { %><sub>2</sub><% } else { %><sup>2</sup><% } %></span><% } else if (action === 'footnote') { %><span class="community-footnote-icon" dir="ltr" aria-hidden="true">A<sup>1</sup></span><% } else { %><i class="bi bi-<%= icon %>" aria-hidden="true"></i><% } %></button><% } %>
        <button type="button" data-format="parallel" title="Parallel English and Arabic text" aria-label="Parallel English and Arabic text"><span class="community-parallel-icon" dir="ltr" aria-hidden="true">a|ج</span></button>
        <button type="button" class="community-format-help" data-bs-toggle="modal" data-bs-target="#community-markdown-help-modal" title="Markdown help" aria-label="Markdown help"><i class="bi bi-question-circle" aria-hidden="true"></i></button>
      </div>
      <textarea data-short-editor data-article-editor id="community-markdown" class="form-control mb-3" rows="16" dir="auto" required aria-label="Article" aria-describedby="community-markdown-help" placeholder="Start writing your article…"></textarea>
      <input id="community-tags" type="hidden" value="">
      <div id="community-blog-control" class="form-check form-switch mb-3" hidden><input id="community-blog-toggle" class="form-check-input" type="checkbox" role="switch"><label class="form-check-label" for="community-blog-toggle">Blog post</label><small id="community-blog-help" class="d-block text-muted">Publish the article first to add it to the Blog.</small></div>
      <div class="community-editor-actions">
        <div class="community-publishing-actions"><button id="community-publish" class="btn btn-primary" type="submit" data-action="publish">Publish</button><button class="btn btn-sm btn-outline-secondary" type="submit" data-action="draft">Save draft</button><button id="community-preview-button" class="btn btn-sm btn-outline-secondary" type="button">Preview</button><button type="button" class="btn btn-sm btn-link community-secondary-action" data-close-editor>Cancel</button></div>
        <div class="community-maintenance-actions"><button id="community-convert-note" type="button" class="btn btn-sm btn-link community-secondary-action" hidden>Convert to Post</button><button id="community-unpublish" class="btn btn-sm btn-link text-danger" type="button" hidden>Unpublish</button><button id="community-delete" class="btn btn-sm btn-link text-danger" type="button" hidden><i class="bi bi-trash" aria-hidden="true"></i> Delete post</button></div>
      </div>
      <p class="small text-muted mt-2" id="community-editor-status" role="status">Drafts save automatically as you write. Your first publication will be reviewed by a moderator.</p>
    </form><section id="community-preview-panel" class="community-card mt-4" hidden aria-label="Public preview"><h2 class="h5">Public preview</h2><p class="small text-muted">Check that this contains only what you want to share publicly.</p><h3 id="community-preview-title" dir="auto"></h3><p id="community-preview-subtitle" class="community-article-subtitle" dir="auto"></p><div id="community-preview" class="notebook-markdown"></div></section>
  </section>
  <% } %>
  <% if (view === 'post') { %>
  <div class="community-columns <%= post.kind === 'article' ? 'community-article-columns' : 'community-short-post-columns' %>"><%- include('sub-views/community_author_rail.ejs', { railAuthor: post.author }); %><div class="community-wall">
  <article class="community-card community-reading"><p class="small text-muted"><%= post.kind === 'article' ? 'Article' : 'Post' %> · Community contribution · <time datetime="<%= new Date(post.publishedAt).toISOString() %>"><%= new Date(post.publishedAt).toLocaleDateString('en-US', { timeZone: 'America/Chicago' }) %></time></p>
    <% if (post.subtitle) { %><p class="community-article-subtitle" dir="auto"><%= post.subtitle %></p><% } %>
    <% if (post.coverUrl) { %><figure class="community-editor-cover"><img src="<%= post.coverUrl %>" alt="Article cover"></figure><% } %>
    <div class="notebook-markdown community-reflection-body" dir="auto"<% if (post.kind === 'article') { %> data-article-body<% } %>><%- post.html %></div><% if (post.tags) { %><div class="community-entry-tags mt-4" dir="auto"><% for (const tag of post.tags.split(',').map(tag => tag.trim()).filter(Boolean)) { %><span><%= tag %></span><% } %></div><% } %>
    <%- include('sub-views/community_post_actions.ejs', { post }); %>
  </article>
  <%- include('sub-views/community_reflections.ejs', { post }); %>
  </div><%- include('sub-views/community_rail.ejs'); %></div>
  <% } %>
  <% if (view === 'moderation') { %><p class="text-muted">Review first publications and reported content. Approval allows the author’s future posts to publish immediately.</p><div id="community-moderation"></div><% } %>
  <% if (view === 'email-preferences') { %>
  <p class="text-muted small mb-3">Choose which emails you receive and manage your author subscriptions.</p>
  <form id="community-email-form" class="settings-page" hidden>
    <section>
      <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <div><h2 class="fs-5 fw-bold mb-1">Email notifications</h2><p class="text-muted small mb-0">Turn email notifications on or off.</p></div>
        <div class="form-check form-switch m-0"><input id="community-email-enabled" class="form-check-input" type="checkbox" role="switch" name="enabled" aria-label="Receive email notifications"></div>
      </div>
      <fieldset id="community-email-categories" class="border-top pt-3">
        <legend class="visually-hidden">Email me about</legend>
        <% for (const [key,label] of Object.entries({likes:'Likes',reflections:'Reflections and comments',replies:'Replies',reactions:'Reactions',articles:'Articles from authors I follow'})) { %>
        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
          <label class="form-check-label" for="community-email-<%= key %>"><%= label %></label>
          <div class="form-check form-switch m-0"><input id="community-email-<%= key %>" class="form-check-input" type="checkbox" role="switch" name="<%= key %>"></div>
        </div>
        <% } %>
      </fieldset>
      <div class="d-flex flex-wrap align-items-center gap-2 border-top pt-3 mt-3">
        <button type="submit" class="btn btn-primary btn-sm">Save preferences</button>
        <button id="community-email-stop" type="button" class="btn btn-outline-secondary btn-sm">Unsubscribe from all emails</button>
      </div>
      <p id="community-email-result" class="small text-muted mt-2 mb-0" role="status" aria-live="polite"></p>
    </section>
    <section>
      <div class="mb-3"><h2 class="fs-5 fw-bold mb-1">Author subscriptions</h2>
      <p class="small text-muted mb-0">Choose whose articles arrive by email. Enable article notifications above to receive them.</p></div>
      <div id="community-email-authors" class="d-flex flex-column gap-2"></div>
    </section>
  </form>
  <% } %>
  <% if (view === 'email-unsubscribe') { %>
  <section class="community-card">
    <% if (unsubscribed) { %><p>You’re unsubscribed from <%= emailCategory.toLowerCase() %> emails.</p>
