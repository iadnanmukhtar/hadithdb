<!doctype html>
<html lang="en"><head>
<% var site = Object.assign({}, global.settings.site, { admin: false, editMode: false }); %>
<%- include('sub-views/head.ejs', { site, page: view === 'everyone' ? { ...page, title_en: 'Hadith Unlocked Community' } : page }); %>
<style><%- include('sub-views/notebook_content_styles.ejs'); %></style>
</head><body class="community-page">
<%- include('sub-views/header.ejs', { site, page }); %>
<main class="container py-4 community" id="community" data-view="<%= view %>" data-author="<%= author?.handle || '' %>" data-post="<%= post?.id || '' %>">
  <div class="community-heading">
    <div><h1 dir="auto"><%= view === 'author' ? author.name : page.title_en %></h1>
    <% if (['everyone','following','mine'].includes(view)) { %><p class="community-intro"><%= view === 'mine' ? 'Your posts, articles, reflections, comments, and publication drafts.' : view === 'following' ? 'The latest writing and conversations from authors you follow.' : 'Posts, articles, and discussions from the community.' %></p><% } %>
    </div>
  </div>
  <p id="community-status" class="small text-muted" role="status" aria-live="polite"></p>
  <% if (view === 'mine') { %>
  <section id="community-wall-profile" class="community-profile mb-4" aria-label="My profile" hidden>
    <span id="community-wall-avatar" class="community-avatar community-avatar-large" aria-hidden="true"></span>
    <div class="community-profile-copy"><strong id="community-wall-name" dir="auto"></strong><span id="community-wall-handle" class="small text-muted ms-2"></span><p id="community-wall-bio" class="mb-1 mt-2" dir="auto"></p><p id="community-wall-stats" class="small text-muted mb-0"></p><button id="community-edit-profile" type="button" class="btn btn-sm btn-outline-secondary mt-2" aria-haspopup="dialog" aria-controls="community-profile-dialog">Edit profile</button></div>
  </section>
  <% } %>
  <% if (author && ['author','post'].includes(view)) { %>
  <section class="community-profile mb-4" aria-label="About the author">
    <span class="community-avatar community-avatar-large" aria-hidden="true"><%- include('sub-views/community_avatar.ejs', { avatar: author }) %></span>
    <div class="community-profile-copy"><a class="fw-semibold" href="/community/@<%= author.handle %>" dir="auto"><%= author.name %></a><span class="small text-muted ms-2">@<%= author.handle %></span>
    <p class="mb-1 mt-2" dir="auto"><%= author.bio %></p><p class="small text-muted mb-0"><%= author.followers %> <%= Number(author.followers) === 1 ? 'follower' : 'followers' %> · <%= author.following %> following · <%= author.posts %> <%= Number(author.posts) === 1 ? 'post' : 'posts' %> · <%= author.comments %> reflections</p></div>
    <div id="community-follow-controls" class="d-flex flex-wrap gap-2"><button class="btn btn-outline-primary" id="community-follow" type="button">Follow</button></div>
  </section>
  <% } %>
  <% if (['everyone','following','mine','author'].includes(view)) { %>
  <div class="community-columns"><section class="community-wall" aria-label="Activity wall">
    <% if (['everyone', 'following', 'mine','author'].includes(view)) { %>
    <button id="community-quick-open" type="button" class="community-quick-prompt" aria-haspopup="dialog" aria-controls="community-quick-dialog"><span class="community-avatar" id="community-prompt-avatar" aria-hidden="true"><i class="bi bi-person"></i></span><span>What's on your mind?</span></button>
    <dialog id="community-quick-dialog" class="community-quick-dialog" aria-label="Write a public post">
    <form id="community-quick-form" class="community-composer" aria-label="Create or edit a post">
      <button type="button" class="btn-close community-composer-close" data-close-quick aria-label="Close editor"></button>
      <div class="community-composer-heading"><span class="community-avatar" id="community-quick-avatar" aria-hidden="true"><i class="bi bi-person"></i></span><div><span class="community-composer-name" id="community-quick-name">Share a post</span><span id="community-quick-audience" class="community-composer-audience"><i class="bi bi-globe2" aria-hidden="true"></i> Public post</span></div></div>
      <label class="visually-hidden" for="community-quick-text">What's on your mind?</label>
      <textarea id="community-quick-text" rows="6" maxlength="10000" required dir="auto" placeholder="What's on your mind?" aria-describedby="community-quick-status"></textarea>
      <div class="community-media-toolbar" data-media-editor="quick-text"><button type="button" data-add-image title="Add image"><i class="bi bi-image" aria-hidden="true"></i> Image</button><button type="button" data-add-link title="Add webpage preview"><i class="bi bi-link-45deg" aria-hidden="true"></i> Link</button><button type="button" data-add-video title="Add video preview"><i class="bi bi-play-btn" aria-hidden="true"></i> Video</button><input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple hidden><span class="community-media-status" role="status"></span></div>
      <div id="community-quick-attachments" class="community-attachment-list"></div>
      <div id="community-quick-cover" class="community-editor-cover" hidden></div>
      <label class="small text-muted">Cover image <input id="community-quick-cover-file" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control form-control-sm"></label>
      <div id="community-quick-edit-actions" hidden><div id="community-quick-conversion-title" hidden><label for="community-quick-title" class="small text-muted">Article title</label><input id="community-quick-title" class="form-control form-control-sm" maxlength="240"></div><div class="d-flex flex-wrap gap-2 my-2"><button id="community-quick-convert" type="button" class="btn btn-sm btn-outline-secondary">Convert to article draft</button><button id="community-quick-delete" type="button" class="btn btn-sm btn-outline-danger">Delete post</button></div></div>
      <div id="community-quick-preview" class="notebook-markdown" hidden></div>
      <div class="community-composer-footer"><a id="community-quick-new-article" href="/community/write?kind=article"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Write an article</a><div class="d-flex align-items-center gap-2"><button id="community-quick-preview-button" type="button" class="community-preview-action" hidden>Preview</button><button type="button" class="btn btn-sm btn-outline-secondary" data-close-quick>Cancel</button><button id="community-quick-post" class="btn btn-sm btn-primary" type="submit" disabled>Post <i class="bi bi-arrow-up" aria-hidden="true"></i></button></div></div>
      <p id="community-quick-status" class="community-composer-status" role="status" aria-live="polite"></p>
    </form>
    </dialog>
    <% } %>
    <div class="community-feed-toolbar"><h2><%= view === 'mine' ? 'Your activity' : view === 'following' ? 'From authors you follow' : view === 'author' ? 'Writing & conversations' : 'In the community' %></h2>
    <% if (view !== 'mine') { %><label class="visually-hidden" for="community-filter">Filter activity</label><select class="form-select form-select-sm community-filter" id="community-filter"><option value="all">All activity</option><option value="article">Articles</option><option value="note">Posts</option><option value="comment">Comments</option><option value="like">Likes</option></select><% } %></div>
    <div id="community-feed" class="community-feed"><% if (initial) { %><%- include('sub-views/community_feed.ejs', { items: initial.items }); %><% if (!initial.items.length) { %><p class="community-empty">No public posts yet. Start a reflection or share an article.</p><% } } %></div>
    <div id="community-feed-sentinel" class="community-feed-sentinel" aria-hidden="true"></div>
    <p id="community-feed-status" class="small text-muted" role="status" aria-live="polite"></p>
    <button class="btn btn-sm btn-outline-secondary community-more" id="community-more" type="button" hidden>Load more</button>
  </section><div class="community-rail-slot"><aside class="community-aside" aria-label="Community contributors">
    <section class="community-contributors-section" aria-labelledby="community-contributors-heading">
      <h2 id="community-contributors-heading" class="hadith-heading-toc-title">Top contributors</h2>
      <p class="community-rail-caption">Public posts, reflections, and comments</p>
      <div id="community-contributors" aria-live="polite"><p class="community-rail-caption">Loading contributors…</p></div>
    </section>
    <a class="community-notebook-link" href="/notebook"><i class="bi bi-journal-text" aria-hidden="true"></i><span><strong>My Notebook</strong><small>Your private reading notes</small></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
    <p class="community-sidebar-footnote">Writing here reflects the author’s perspective. Community posts are not scholarly verification.</p>
  </aside></div></div>
  <% } %>
  <% if (view === 'mine') { %>
  <dialog id="community-profile-dialog" class="community-quick-dialog community-profile-dialog" aria-labelledby="community-profile-dialog-title">
    <div class="d-flex justify-content-between align-items-center"><h2 id="community-profile-dialog-title">Edit profile</h2><button type="button" class="btn btn-sm btn-link text-muted" data-close-profile-dialog aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    <form id="community-profile-form" class="mt-3">
      <label class="form-label" for="community-name">Display name</label><input id="community-name" class="form-control mb-2" maxlength="120" required dir="auto">
      <label class="form-label" for="community-handle">Handle</label><input id="community-handle" class="form-control mb-2" pattern="[a-zA-Z0-9_.\-]{3,40}" maxlength="40" required><p class="small text-muted">Use 3–40 letters, numbers, periods, underscores, or hyphens. Choose once; this becomes your permanent public address.</p>
      <label class="form-label" for="community-bio">Bio</label><textarea id="community-bio" class="form-control mb-3" maxlength="1000" dir="auto"></textarea>
      <p id="community-profile-error" class="small text-danger" role="status"></p>
      <div class="d-flex justify-content-end gap-2"><button type="button" class="btn btn-sm btn-outline-secondary" data-close-profile-dialog>Cancel</button><button class="btn btn-sm btn-primary" type="submit">Save profile</button></div>
    </form>
  </dialog>
  <dialog id="community-people-dialog" class="community-quick-dialog community-profile-dialog" aria-labelledby="community-people-title">
    <div class="d-flex justify-content-between align-items-center"><h2 id="community-people-title">Followers</h2><button type="button" class="btn btn-sm btn-link text-muted" id="community-people-close" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    <div id="community-followers" class="mt-3 small" aria-live="polite"></div><div id="community-subscriptions" class="mt-3 small" hidden></div>
  </dialog>
  <% } %>
  <% if (view === 'write') { %>
  <section class="community-editor" aria-label="Publication editor">
    <div class="community-editor-top"><div><span class="community-editor-eyebrow">Your next article</span><p>Write, preview, and share with the community.</p></div><button id="community-import" class="btn btn-sm btn-outline-secondary" type="button"><i class="bi bi-journal-text" aria-hidden="true"></i> From My Notebook</button></div>
    <form id="community-editor-form">
      <input id="community-kind" type="hidden" value="article">
      <div id="community-import-panel" class="community-card" hidden><label class="form-label" for="community-notebook-search">Find a saved note</label><input id="community-notebook-search" class="form-control mb-2" type="search" dir="auto"><div id="community-notebook-results"></div><button id="community-notebook-more" class="btn btn-sm btn-outline-secondary mt-2" type="button" hidden>More notes</button></div>
      <label class="form-label" for="community-title">Article title</label><input id="community-title" class="form-control community-article-title mb-4" maxlength="240" dir="auto" required placeholder="Give your article a title">
      <div class="mb-4" id="community-cover-controls"><input id="community-cover-url" type="hidden"><label class="form-label d-block" for="community-cover-file">Cover image</label><input id="community-cover-file" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control form-control-sm"><button id="community-cover-remove" type="button" class="btn btn-sm btn-link text-muted" hidden>Remove cover</button><span id="community-cover-status" class="small text-muted" role="status"></span></div>
      <label class="form-label" for="community-subtitle">Subtitle <span class="text-muted">(optional)</span></label><input id="community-subtitle" class="form-control mb-4" maxlength="1000" dir="auto" placeholder="Add a short introduction to your article">
      <div class="community-media-toolbar" data-media-editor="markdown"><button type="button" data-add-image title="Add image"><i class="bi bi-image" aria-hidden="true"></i> Image</button><button type="button" data-add-link title="Add webpage preview"><i class="bi bi-link-45deg" aria-hidden="true"></i> Link</button><button type="button" data-add-video title="Add video preview"><i class="bi bi-play-btn" aria-hidden="true"></i> Video</button><input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple hidden><span class="community-media-status" role="status"></span></div>
      <div id="community-article-attachments" class="community-attachment-list"></div>
      <div class="community-writing-label"><label class="form-label" for="community-markdown">Article</label><span id="community-markdown-help">Markdown supported · Preview optional</span></div>
      <div id="community-format-toolbar" class="community-format-toolbar" role="group" aria-label="Article formatting">
        <select id="community-format-style" aria-label="Text style"><option value="0">Normal</option><% for (let level=1;level<=6;level++) { %><option value="<%= level %>">Heading <%= level %></option><% } %></select>
        <% for (const [action,label,icon] of [['bold','Bold','type-bold'],['italic','Italic','type-italic'],['underline','Underline','type-underline'],['strike','Strikethrough','type-strikethrough'],['highlight','Highlight','brush'],['numbered','Numbered list','list-ol'],['bullets','Bullet list','list-ul'],['quote','Quotation','quote'],['link','Insert link','link-45deg'],['clear','Clear formatting','eraser']]) { %>
        <button type="button" data-format="<%= action %>" title="<%= label %>" aria-label="<%= label %>"><i class="bi bi-<%= icon %>" aria-hidden="true"></i></button><% } %>
        <button type="button" class="community-format-help" data-bs-toggle="modal" data-bs-target="#community-markdown-help-modal" title="Markdown help" aria-label="Markdown help"><i class="bi bi-question-circle" aria-hidden="true"></i></button>
      </div>
      <textarea id="community-markdown" class="form-control mb-3" rows="16" dir="auto" required aria-describedby="community-markdown-help" placeholder="Start with your opening paragraph…

## A section heading

Use **bold** for emphasis and *italics* for a title.

> Add a quotation here.

- Your first point
- Your next point

[Link text](https://example.com)

العربية والإنجليزية مدعومتان."></textarea>
      <input id="community-tags" type="hidden" value="">
      <div id="community-blog-control" class="form-check form-switch mb-3" hidden><input id="community-blog-toggle" class="form-check-input" type="checkbox" role="switch"><label class="form-check-label" for="community-blog-toggle">Blog post</label><small id="community-blog-help" class="d-block text-muted">Publish the article first to add it to the Blog.</small></div>
      <div class="community-editor-actions"><button class="btn btn-sm btn-outline-secondary" type="submit" data-action="draft">Save draft</button><button id="community-preview-button" class="btn btn-sm btn-outline-secondary" type="button">Preview article</button><button id="community-publish" class="btn btn-sm btn-primary" type="submit" data-action="publish">Publish</button><button id="community-unpublish" class="btn btn-outline-danger" type="button" hidden>Unpublish</button><button id="community-delete" class="btn btn-sm btn-outline-danger" type="button" hidden><i class="bi bi-trash" aria-hidden="true"></i> Delete post</button></div>
      <p class="small text-muted mt-2" id="community-editor-status" role="status">Drafts are private. Your first publication will be reviewed by a moderator.</p>
    </form><section id="community-preview-panel" class="community-card mt-4" hidden aria-label="Public preview"><h2 class="h5">Public preview</h2><p class="small text-muted">Check that this contains only what you want to share publicly.</p><h3 id="community-preview-title" dir="auto"></h3><p id="community-preview-subtitle" class="community-article-subtitle" dir="auto"></p><div id="community-preview" class="notebook-markdown"></div></section>
  </section>
  <% } %>
  <% if (view === 'post') { %>
  <article class="community-card community-reading"><p class="small text-muted"><%= post.kind === 'article' ? 'Article' : 'Post' %> · Community contribution · <time datetime="<%= new Date(post.publishedAt).toISOString() %>"><%= new Date(post.publishedAt).toLocaleDateString('en-US', { timeZone: 'America/Chicago' }) %></time></p>
    <% if (post.subtitle) { %><p class="community-article-subtitle" dir="auto"><%= post.subtitle %></p><% } %>
    <% if (post.coverUrl) { %><figure class="community-editor-cover"><img src="<%= post.coverUrl %>" alt="Article cover"></figure><% } %>
    <div class="notebook-markdown"><%- post.html %></div><% if (post.tags) { %><p class="small text-muted mt-4" dir="auto"><%= post.tags %></p><% } %>
    <div class="d-flex gap-3 flex-wrap small mt-3"><div id="community-blog-control" class="form-check form-switch community-blog-control" hidden><input id="community-blog-toggle" class="form-check-input" type="checkbox" role="switch" data-kind="<%= post.kind %>"<% if (post.isBlog) { %> checked<% } %>><label class="form-check-label" for="community-blog-toggle">Blog post</label></div><button id="community-report-post" class="btn btn-sm btn-link p-0" type="button">Report</button><a id="community-edit-post" data-generated="<%= !!post.generatedActivity %>" href="<%= post.kind === 'note' ? '/community/mine?editPost=' : '/community/write?post=' %><%= post.id %>" hidden>Edit post</a></div>
  </article>
  <section class="community-reading mt-4" id="comments" aria-label="Discussion"><h2 class="h4">Discussion</h2><div id="community-comments"></div>
    <form id="community-comment-form" class="community-card"><p id="community-reply-target" class="small text-muted" hidden></p><button id="community-cancel-reply" class="btn btn-sm btn-link mb-2" type="button" hidden>Cancel reply</button><label class="form-label" for="community-comment-text">Join the conversation</label><textarea id="community-comment-text" class="form-control mb-3" dir="auto" rows="3" maxlength="10000" required></textarea><button class="btn btn-primary" type="submit">Post comment</button></form>
  </section>
  <% } %>
  <% if (view === 'moderation') { %><p class="text-muted">Review first publications and reported content. Approval allows the author’s future posts to publish immediately.</p><div id="community-moderation"></div><% } %>
  <% if (view === 'unsubscribe') { %><section class="community-card"><% if (unsubscribed) { %><p class="mb-0">You have unsubscribed from this author’s emails. You still follow their posts in your feed.</p><% } else { %><p>Stop email updates from this author? You will still follow their posts.</p><form method="post"><button class="btn btn-primary" type="submit">Unsubscribe from emails</button></form><% } %></section><% } %>
  <dialog id="community-media-dialog" class="community-media-dialog" aria-labelledby="community-media-dialog-title"><form id="community-media-link-form"><h2 id="community-media-dialog-title">Add a link</h2><label for="community-media-url">Webpage or video URL</label><input id="community-media-url" class="form-control" type="url" required placeholder="https://…"><p class="small text-muted">YouTube, Vimeo, direct video links, and webpages.</p><div class="d-flex justify-content-end gap-2"><button type="button" class="btn btn-sm btn-outline-secondary" id="community-media-cancel">Cancel</button><button type="submit" class="btn btn-sm btn-primary">Add preview</button></div><p id="community-media-error" class="small text-muted" role="status"></p></form></dialog>
</main>
<% if (view === 'write') { %>
<div class="modal fade" id="community-markdown-help-modal" tabindex="-1" aria-labelledby="community-markdown-help-title" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable modal-fullscreen-sm-down"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title fs-5" id="community-markdown-help-title">Markdown help</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close help"></button></div>
    <div class="modal-body"><%- include('sub-views/markdown_help_content.ejs', { articleHelp: true }); %></div>
    <div class="modal-footer"><button type="button" class="btn btn-sm btn-primary" data-bs-dismiss="modal">Got it</button></div>
  </div></div>
</div>
<% } %>
<%- include('sub-views/mobile_navigation.ejs', { site, page }); %>
<%- include('sub-views/footer.ejs', { site, page }); %>
<% if (view !== 'unsubscribe') { %>
<%- include('sub-views/scripts.ejs', { site, page }); %>
<script src="/static/js/community.js?v=<%= utils.scriptAssetVersion() %>"></script>
<script src="/static/js/community-media.js?v=<%= utils.scriptAssetVersion() %>"></script><% } %>
<% if (view === 'write') { %><script src="/static/js/community-formatting.js?v=<%= utils.scriptAssetVersion() %>" defer></script><% } %>
</body></html>
