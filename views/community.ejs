  <dialog id="community-media-dialog" class="community-media-dialog" aria-labelledby="community-media-dialog-title"><form id="community-media-link-form"><h2 id="community-media-dialog-title">Add a link</h2><label for="community-media-url">Webpage or video URL</label><input id="community-media-url" class="form-control" type="url" required placeholder="https://…"><p class="small text-muted">YouTube, Vimeo, direct video links, and webpages.</p><div class="d-flex justify-content-end gap-2"><button type="button" class="btn btn-sm btn-outline-secondary" id="community-media-cancel">Cancel</button><button type="submit" class="btn btn-sm btn-primary">Add preview</button></div><p id="community-media-error" class="small text-muted" role="status"></p></form></dialog>
</main>
