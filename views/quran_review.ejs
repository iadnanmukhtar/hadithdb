<!doctype html>
<html lang="en">
<% var site = Object.assign({}, global.settings.site, { admin: req.admin, editMode: false }); %>
<head>
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
</head>
<body>
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  <main class="container col-lg-7 mx-auto mt-10 quran-review-top-offset<%= req.query.complete === undefined ? ' page-loading-page' : '' %>">
    <h1 class="fs-4">Quran Review</h1>
    <% if (req.query.complete === undefined) { %>
    <div class="page-loading" id="quran-review-loading" role="status" aria-live="polite">
      <span class="spinner-border text-primary" aria-hidden="true"></span>
      <p id="quran-review-status" class="text-muted mb-0">Loading your next ayah...</p>
    </div>
    <% } else { %>
    <p id="quran-review-status" class="text-muted">You have completed this review session.</p>
    <% } %>
    <p><a class="btn btn-primary" href="<%= utils.quranUrl(req, '/quran/page?memorize') %>">Open Memorize</a>
      <a class="btn btn-outline-secondary" href="<%= utils.quranUrl(req, '/quran/review') %>">Memorization Progress</a></p>
  </main>
  <%- include('sub-views/mobile_navigation.ejs', { site: site, page: page }); %>
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  <% if (req.query.complete === undefined) { %>
  <script>
    (async function () {
      const status = document.getElementById('quran-review-status');
      window.history.replaceState(window.history.state, '', quranUrl('/quran/review'));
      try {
        let attempts = 0;
        while ((!window.hadithAuth || !window.hadithAuth.getToken) && attempts < 50) {
          await new Promise(resolve => window.setTimeout(resolve, 100));
          attempts += 1;
        }
        let token = window.hadithAuth && await window.hadithAuth.getToken();
        if (!token) {
          window.location.replace(quranUrl('/quran/review?signedOut=1'));
          return;
        }
        const startSession = async () => {
          const response = await fetch(quranApiPath('/memorization/review/sessions'), {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: '{}'
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || 'Unable to start a review session.');
          if (window.trackQuranAnalyticsEvent) window.trackQuranAnalyticsEvent('quran_review_session_start', {
            session_mode: data.session && data.session.session_mode || 'regular',
            ayah_count: data.session && data.session.queued || 0
          });
          return data.session && data.session.session_id;
        };
        let sessionId = '';
        <% if (req.query.start !== undefined || req.query.reset !== undefined) { %>
        sessionId = await startSession();
        <% } else { %>
        const activeResponse = await fetch(quranApiPath('/memorization/review/sessions/active'), {
          credentials: 'same-origin',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const activeData = await activeResponse.json().catch(() => ({}));
        if (!activeResponse.ok) throw new Error(activeData.error || 'Unable to resume the review session.');
        sessionId = activeData.session && activeData.session.session_id;
        if (sessionId && window.trackQuranAnalyticsEvent) window.trackQuranAnalyticsEvent('quran_review_session_resume', {
          resume_source: 'review_route',
          session_mode: activeData.session.session_mode || 'regular'
        });
        if (!sessionId) sessionId = await startSession();
        <% } %>
        if (!sessionId) {
          window.location.replace('/quran/review');
          return;
        }
        const localReviewDayStart = window.HadithDbQuranReview.localDayStart();
        const response = await fetch(quranApiPath(`/memorization/review/sessions/${encodeURIComponent(sessionId)}/next?day_start=${encodeURIComponent(localReviewDayStart)}`), {
          credentials: 'same-origin',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          if (response.status === 404 || response.status === 409) {
            window.location.replace(quranUrl('/quran/review'));
            return;
          }
          throw new Error(data.error || 'Unable to load reviews.');
        }
        const nextTarget = window.HadithDbQuranReview.nextItemTarget(data);
        if (nextTarget.complete) {
          const state = Object.assign({}, window.history.state || {}, {
            pageNotice: { type:'success', title:'Review complete', message:'You completed this review session.', scrollToTop:true }
          });
          window.history.replaceState(state, '', quranUrl('/quran/review'));
          if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'manual';
          window.scrollTo(0, 0);
          window.location.reload();
          return;
        }
        const ayah = data.ayah;
        const query = [`review=${nextTarget.ref}`];
        if (data.passage && Array.isArray(data.passage.ayahs)) {
          const endPage = Math.max(...data.passage.ayahs.map(item => Number(item.page_number) || 0));
          if (endPage > Number(ayah.page_number || 1)) query.push(`reviewPassageEndPage=${endPage}`);
        }
        if (ayah.retry) query.push('reviewRetry=1');
        window.location.replace(quranUrl(`/quran/page/${ayah.page_number || 1}?${query.join('&')}`));
      } catch (err) {
        const loading = document.getElementById('quran-review-loading');
        const spinner = loading && loading.querySelector('.spinner-border');
        if (spinner) spinner.hidden = true;
        status.textContent = err.message;
      }
    }());
  </script>
  <% } %>
</body>
</html>
