<!doctype html>
<html lang="en">

<head>
  <% 
    var site = new Object(global.settings.site);
    site.admin = (!locals.noadmin && req.cookies.admin == admin.key);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.cookies.editMode == 1);
    else
      site.editMode = false;
    
    var chapter = locals.chapter || section.chapter || section;
    var book = chapter.book || section.book;
    var selectedAyahs = locals.selectedAyahs || (locals.selectedAyah ? [locals.selectedAyah] : []);
    var firstSelectedAyah = selectedAyahs[0];
    var lastSelectedAyah = selectedAyahs[selectedAyahs.length - 1] || firstSelectedAyah;
    var firstSelectedRef = firstSelectedAyah ? (firstSelectedAyah.en.num || firstSelectedAyah.num || '') : '';
    var lastSelectedRef = lastSelectedAyah ? (lastSelectedAyah.en.num || lastSelectedAyah.num || '') : '';
    var firstSelectedPart = firstSelectedRef.split(/:/)[1] || firstSelectedRef;
    var lastSelectedPart = lastSelectedRef.split(/:/)[1] || lastSelectedRef;
    var selectedTitle = firstSelectedRef && lastSelectedRef && firstSelectedRef !== lastSelectedRef ? `Quran ${firstSelectedRef}-${lastSelectedPart}` : `Quran ${firstSelectedRef}`;
    var quranShareId = selectedAyahs.length > 0 ? `Q${(firstSelectedRef + '-' + lastSelectedPart).replace(/[^A-Za-z0-9_-]/g, '-')}` : '';
    var selectedAyahPrevHref = selectedAyahs.length === 1 && firstSelectedAyah && firstSelectedAyah.prev_ref ? `/${firstSelectedAyah.prev_ref}` : undefined;
    var selectedAyahNextHref = selectedAyahs.length === 1 && firstSelectedAyah && firstSelectedAyah.next_ref ? `/${firstSelectedAyah.next_ref}` : undefined;
    var quranAyahModalItems = [];
    var quranAyahModalRefs = new Set();
    var quranAyahModalNumber = function (ayah) {
      var num = ayah ? (ayah.numInChapter || ayah.en?.num || ayah.num || '') : '';
      return parseInt(arabic.toLatinDigits(num.toString()).split(/:/).pop(), 10);
    };
    selectedAyahs.concat(results).forEach(function (ayah) {
      if (!ayah || !ayah.ref || quranAyahModalRefs.has(ayah.ref))
        return;
      quranAyahModalRefs.add(ayah.ref);
      quranAyahModalItems.push(ayah);
    });
    quranAyahModalItems.sort(function (a, b) {
      var aNum = quranAyahModalNumber(a);
      var bNum = quranAyahModalNumber(b);
      if (!Number.isInteger(aNum) || !Number.isInteger(bNum))
        return 0;
      return aNum - bNum;
    });
    if (selectedAyahs.length === 1 && firstSelectedAyah && (!selectedAyahPrevHref || !selectedAyahNextHref)) {
      var selectedAyahIndex = results.findIndex(function (ayah) {
        return ayah.ref === firstSelectedAyah.ref;
      });
      if (selectedAyahIndex >= 0) {
        if (!selectedAyahPrevHref && results[selectedAyahIndex - 1])
          selectedAyahPrevHref = `/${results[selectedAyahIndex - 1].ref}`;
        if (!selectedAyahNextHref && results[selectedAyahIndex + 1])
          selectedAyahNextHref = `/${results[selectedAyahIndex + 1].ref}`;
      }
    }
    var footnoteItems = results;
    var page = {
      menu: 'Section',
      title_en: `${site.shortName} | ${book.shortName_en} ${chapter.h1}${section.level > 1 ? ` §${section.h1}.${section.h2}` : ''} ${section.title_en || section.title}`,
      subtitle_en: `${book.shortName_en}`,
      subtitle: `${book.shortName}`,
      canonical: section.level > 1 ? `/${book.alias}/${chapter.h1}/${section.h2}` : `/${book.alias}/${chapter.h1}?passage`,
      context: {
        book: book,
        chapter: chapter,
        section: section.level > 1 ? section : undefined,
        heading: section,
        passage: true,
        continued: false
      }
    };
  %>
  
  <%- include('sub-views/head.ejs', { site: site, page: page }); %>
  
</head>

<body>
  
  <%- include('sub-views/header.ejs', { site: site, page: page }); %>
  
  <div class="container col-lg-8 mx-auto">
    
    <main class="chapter mt-10">
      
      <%- include('sub-views/pagination.ejs', { site: site, page: page }); %>
      
      <%- include('sub-views/chapterTitle.ejs', { site: site, page: page }); %>
      
      <% if (selectedAyahs.length > 0) { %>
        <% var selectedAyahModalIndex = quranAyahModalItems.findIndex(ayah => firstSelectedAyah && ayah.ref === firstSelectedAyah.ref); %>
        <% var selectedAyahId = firstSelectedAyah && firstSelectedAyah.id; %>
        <% var selectedAyahCommentCount = firstSelectedAyah ? (firstSelectedAyah.comment_count ?? firstSelectedAyah.commented ?? 0) : 0; %>
      <%- include('sub-views/quran_ayah_hero.ejs', {
        site: site,
        page: page,
        selectedAyahs: selectedAyahs,
        clearHref: page.context.section ? `/${page.context.section.path}` : undefined,
        prevHref: selectedAyahPrevHref,
        nextHref: selectedAyahNextHref,
        toolbar: quranShareId ? {
          selectedAyahModalIndex: selectedAyahModalIndex,
          selectedAyahId: selectedAyahId,
          selectedAyahCommentCount: selectedAyahCommentCount,
          quranShareId: quranShareId
        } : undefined
      }); %>
      <% } %>
                          
      <% if (selectedAyahs.length > 1) { %>
        <%- include('sub-views/quran_modal.ejs', { site: site, page: page, selectedAyahs: selectedAyahs, quranShareId: quranShareId }); %>
      <% } %>
        <% if (results.length > 0) { %>
          <%- include('sub-views/heading.ejs', { site: site, page: page, heading: section, headingEnglishOnly: true }); %>
          <% if (site.editMode && book.alias === 'quran' && section && section.level === 2) {
            var rangeHeading = section;
            var rangeStart = (rangeHeading.start || '').toString().split(/:/).pop();
            var rangeCount = parseInt(rangeHeading.count || results.length, 10);
            var rangeEnd = parseInt(rangeStart || '0', 10) + (Number.isInteger(rangeCount) ? rangeCount : results.length) - 1;
            if (!Number.isInteger(rangeEnd) || rangeEnd < parseInt(rangeStart || '0', 10))
              rangeEnd = rangeStart;
          %>
            <aside class="quran-range-admin mb-3" data-heading-id="<%= rangeHeading.id %>" data-surah="<%= rangeHeading.h1 %>" data-section-path="/<%= rangeHeading.path %>">
              <div class="d-flex flex-wrap align-items-end gap-2">
                <label class="form-label mb-0 small">
                  Start
                  <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm quran-range-start" value="<%= rangeStart %>">
                </label>
                <label class="form-label mb-0 small">
                  End
                  <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm quran-range-end" value="<%= rangeEnd %>">
                </label>
                <span class="quran-range-live small text-muted">Quran <%= rangeHeading.h1 %>:<%= rangeStart %>-<%= rangeEnd %></span>
                <button type="button" class="btn btn-sm btn-primary quran-range-save" data-loading-label="Saving">
                  <span class="bi bi-save"></span> Save range
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger quran-section-delete" data-loading-label="Removing">
                  <span class="bi bi-trash"></span> Delete section
                </button>
              </div>
              <div class="quran-range-preview mt-2 d-none">
                <div class="quran-range-preview-ar" lang="ar"></div>
                <div class="quran-range-preview-en" lang="en"></div>
              </div>
            </aside>
          <% } %>
        <% } %>
        <%- include('sub-views/quran.ejs', { site: site, page: page, passage: results, selectedAyah: locals.selectedAyah, selectedAyahs: selectedAyahs, quranSubsections: locals.quranSubsections, quranAyahModalItems: quranAyahModalItems, quranShareId: quranShareId, main: false, title: false, searchResult: false }); %>
        <%- include('sub-views/quran_ayah_modal.ejs', { site: site, page: page, passage: quranAyahModalItems }); %>
        <% if (results.length > 0 && results[0].id) { %>
          <% var passageCommentCount = results[0].comment_count ?? results[0].commented ?? 0; %>
          <aside class="tags quran-passage-actions mt-2">
            <button type="button" class="hadith-bookmark-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= results[0].id %>" title="Bookmark this Quran passage">
              <span class="hadith-bookmark-icon bi bi-bookmark text-accent" data-hadith-id="<%= results[0].id %>"></span>
            </button>
            &nbsp;
            <button type="button" class="hadith-like-btn btn btn-sm p-0 border-0 bg-transparent d-inline-flex align-items-center" data-hadith-id="<%= results[0].id %>" title="Like this Quran passage">
              <span class="hadith-like-icon bi bi-heart text-danger" data-hadith-id="<%= results[0].id %>"></span>
            </button>
            <span class="hadith-like-count fw-semibold text-danger" data-hadith-id="<%= results[0].id %>">0</span>
            &nbsp;
            <a href="#quran-passage-comments" class="reflection-count-link text-decoration-none" title="View reflections">
              <span class="bi bi-chat-right-text text-accent"></span><span class="hadith-comment-count fw-semibold text-accent" data-hadith-id="<%= results[0].id %>" title="<%= passageCommentCount %> reflection<%= passageCommentCount === 1 ? '' : 's' %>"><%= passageCommentCount %></span>
            </a>
            &nbsp;
            <span class="bi bi-box-arrow-up text-accent"></span>&nbsp;<button type="button" class="quran-passage-share-btn quran-passage-link icon" title="Copy and share this Quran passage URL">Share</button>
          </aside>
        <% } %>
        <% if (site.editMode && book.alias === 'quran' && section && section.level === 2) { %>
          <aside class="quran-section-admin mt-3 mb-3" data-heading-id="<%= rangeHeading.id %>" data-surah="<%= rangeHeading.h1 %>">
            <div class="d-flex flex-wrap align-items-end gap-2">
              <label class="form-label mb-0 small">
                New section
                <select class="form-select form-select-sm quran-section-position">
                  <option value="after" selected>After this section</option>
                  <option value="before">Before this section</option>
                </select>
              </label>
              <label class="form-label mb-0 small">
                Start
                <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm quran-section-start" value="<%= rangeEnd %>">
              </label>
              <label class="form-label mb-0 small">
                End
                <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm quran-section-end" value="<%= rangeEnd %>">
              </label>
              <label class="form-label mb-0 small quran-section-title-wrap">
                Title
                <input type="text" class="form-control form-control-sm quran-section-title" value="">
              </label>
              <button type="button" class="btn btn-sm btn-outline-primary quran-section-add" data-loading-label="Adding">
                <span class="bi bi-plus-circle"></span> Add section
              </button>
            </div>
          </aside>
        <% } %>

      <div class="mt-4 mb-4">
        <%- include('sub-views/pagination.ejs', { site: site, page: page }); %>
      </div>

      <%- include('sub-views/quran_tafsirs.ejs', { site: site, page: page, section: section, footnoteItems: footnoteItems, selectedAyahs: selectedAyahs, passage: results }); %>

      <div class="mt-4 mb-4">
        <%- include('sub-views/pagination.ejs', { site: site, page: page }); %>
      </div>

      <% if (results.length > 0 && results[0].id) { %>
        <div class="mt-4">
          <%- include('sub-views/comment_widget.ejs', {
            widgetId: 'quran-passage-comments',
            heading: 'Add your own reflection on this passage below:',
            targetId: results[0].id,
            ref: results[0].ref,
            endpoint: '/comments',
            subjectLabel: 'reflection',
            placeholder: 'Write a reflection on this Quran passage...'
          }); %>
        </div>
      <% } %>
      
      <% if (results.length == 0 || !results[0].id) { %>
        <footer class="col-12">
          <p>This is an empty section.</p>
        </footer>
      <% } %>
      
    </main>
  </div>
  
  <%- include('sub-views/footer.ejs', { site: site, page: page }); %>
  <%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
  <% if (site.editMode) { %>
  <script>
    const refreshAfterQuranHeadingUpdate = (targetUrl) => {
      const target = new URL(targetUrl, window.location.origin);
      if (target.pathname === window.location.pathname && target.search === window.location.search) {
        if (target.hash)
          window.location.hash = target.hash;
        window.location.reload();
        return;
      }
      window.location.href = `${target.pathname}${target.search}${target.hash}`;
    };

    document.querySelectorAll('.quran-range-admin').forEach((container) => {
      const startInput = container.querySelector('.quran-range-start');
      const endInput = container.querySelector('.quran-range-end');
      const liveLabel = container.querySelector('.quran-range-live');
      const saveButton = container.querySelector('.quran-range-save');
      const deleteButton = container.querySelector('.quran-section-delete');
      const preview = container.querySelector('.quran-range-preview');
      const previewAr = container.querySelector('.quran-range-preview-ar');
      const previewEn = container.querySelector('.quran-range-preview-en');
      const surah = container.dataset.surah;
      const headingId = container.dataset.headingId;
      let previewTimer = null;

      const getRange = () => ({
        startAyah: parseInt(startInput.value, 10),
        endAyah: parseInt(endInput.value, 10)
      });

      const setButtonLoading = (loading) => {
        if (!saveButton)
          return;
        if (loading) {
          saveButton.dataset.originalHtml = saveButton.innerHTML;
          saveButton.disabled = true;
          saveButton.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Saving';
        } else {
          saveButton.disabled = false;
          saveButton.innerHTML = saveButton.dataset.originalHtml || '<span class="bi bi-save"></span> Save range';
        }
      };

      const setActionLoading = (button, label, loading) => {
        if (!button)
          return;
        if (loading) {
          button.dataset.originalHtml = button.innerHTML;
          button.disabled = true;
          button.innerHTML = `<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> ${label}`;
        } else {
          button.disabled = false;
          button.innerHTML = button.dataset.originalHtml || button.innerHTML;
        }
      };

      const rangeInputFocused = () => document.activeElement === startInput || document.activeElement === endInput;

      const hidePreview = () => {
        window.clearTimeout(previewTimer);
        preview.classList.add('d-none');
      };

      const updateLive = (highlightRange = false) => {
        const range = getRange();
        const valid = Number.isInteger(range.startAyah) && Number.isInteger(range.endAyah) && range.startAyah > 0 && range.endAyah >= range.startAyah;
        liveLabel.textContent = valid ? `Quran ${surah}:${range.startAyah}-${range.endAyah}` : 'Invalid range';
        saveButton.disabled = !valid;
        container.classList.toggle('is-invalid', !valid);
        document.querySelectorAll('.body.passage .ayah').forEach((ayah) => {
          const link = ayah.querySelector('[data-ayah-number]');
          const ayahNumber = link ? parseInt(link.dataset.ayahNumber, 10) : NaN;
          ayah.classList.toggle('quran-range-live-selected', highlightRange && valid && ayahNumber >= range.startAyah && ayahNumber <= range.endAyah);
        });
        window.clearTimeout(previewTimer);
        if (valid && rangeInputFocused())
          previewTimer = window.setTimeout(() => updatePreview(range), 300);
        else
          preview.classList.add('d-none');
      };

      const updatePreview = async (range) => {
        try {
          if (!rangeInputFocused())
            return hidePreview();
          const res = await fetch(`/passage:${surah}:${range.startAyah}-${range.endAyah}?json=1`);
          if (!res.ok)
            throw new Error(await res.text());
          const item = (await res.json())[0] || {};
          previewAr.textContent = item.body || item.ar?.body || '';
          previewEn.textContent = item.body_en || item.en?.body || '';
          preview.classList.toggle('d-none', !rangeInputFocused() || !(previewAr.textContent || previewEn.textContent));
        } catch (err) {
          preview.classList.add('d-none');
        }
      };

      const saveRange = async () => {
        const range = getRange();
        setButtonLoading(true);
        try {
          const res = await fetch(`/update/${headingId}/toc.passageRange`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: range })
          });
          const body = await res.json();
          if (!res.ok || body.code !== 200)
            throw new Error(body.message || res.statusText);
          if (window.toastr)
            toastr.success(`${body.value.start} (${body.value.count} ayahs)`, 'Quran range saved');
          refreshAfterQuranHeadingUpdate(container.dataset.sectionPath);
        } catch (err) {
          if (window.toastr)
            toastr.error(err.message, 'Quran range save failed');
          else
            alert(err.message);
        } finally {
          setButtonLoading(false);
        }
      };

      const deleteSection = async () => {
        if (!window.confirm('Remove this section division and its subsections? The ayahs will remain in the surah, and later sections will be renumbered.'))
          return;
        setActionLoading(deleteButton, 'Removing', true);
        try {
          const res = await fetch(`/update/${headingId}/toc.sectionDelete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: '1' })
          });
          const body = await res.json();
          if (!res.ok || body.code !== 200)
            throw new Error(body.message || res.statusText);
          if (window.toastr)
            toastr.success('Later sections were renumbered', 'Quran section removed');
          refreshAfterQuranHeadingUpdate(body.value.redirectPath || `/quran/${surah}`);
        } catch (err) {
          if (window.toastr)
            toastr.error(err.message, 'Quran section remove failed');
          else
            alert(err.message);
        } finally {
          setActionLoading(deleteButton, 'Removing', false);
        }
      };

      startInput.addEventListener('input', () => updateLive(true));
      endInput.addEventListener('input', () => updateLive(true));
      startInput.addEventListener('focus', () => updateLive(false));
      endInput.addEventListener('focus', () => updateLive(false));
      startInput.addEventListener('blur', () => window.setTimeout(() => {
        if (!rangeInputFocused())
          hidePreview();
      }, 0));
      endInput.addEventListener('blur', () => window.setTimeout(() => {
        if (!rangeInputFocused())
          hidePreview();
      }, 0));
      saveButton.addEventListener('click', saveRange);
      deleteButton.addEventListener('click', deleteSection);
      updateLive();
    });

    document.querySelectorAll('.quran-subsection-admin').forEach((container) => {
      const startInput = container.querySelector('.quran-subsection-start');
      const endInput = container.querySelector('.quran-subsection-end');
      const titleInput = container.querySelector('.quran-subsection-title');
      const addButton = container.querySelector('.quran-subsection-add');
      const headingId = container.dataset.headingId;

      const setButtonLoading = (loading) => {
        if (!addButton)
          return;
        if (loading) {
          addButton.dataset.originalHtml = addButton.innerHTML;
          addButton.disabled = true;
          addButton.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Adding';
        } else {
          addButton.disabled = false;
          addButton.innerHTML = addButton.dataset.originalHtml || '<span class="bi bi-plus-circle"></span> Make subsection';
        }
      };

      const getRange = () => ({
        startAyah: parseInt(startInput.value, 10),
        endAyah: parseInt(endInput.value, 10)
      });

      const updateValid = () => {
        const range = getRange();
        const valid = Number.isInteger(range.startAyah) && Number.isInteger(range.endAyah) && range.startAyah > 0 && range.endAyah >= range.startAyah;
        addButton.disabled = !valid;
        container.classList.toggle('is-invalid', !valid);
      };

      const addSubsection = async () => {
        const range = getRange();
        setButtonLoading(true);
        try {
          const res = await fetch(`/update/${headingId}/toc.subsectionAdd`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              value: {
                startAyah: range.startAyah,
                endAyah: range.endAyah,
                title_en: titleInput.value
              }
            })
          });
          const body = await res.json();
          if (!res.ok || body.code !== 200)
            throw new Error(body.message || res.statusText);
          if (window.toastr)
            toastr.success(body.value.path, 'Quran subsection added');
          refreshAfterQuranHeadingUpdate(`${container.dataset.sectionPath}#S${body.value.h2}-${body.value.h3}`);
        } catch (err) {
          if (window.toastr)
            toastr.error(err.message, 'Quran subsection add failed');
          else
            alert(err.message);
        } finally {
          setButtonLoading(false);
        }
      };

      startInput.addEventListener('input', updateValid);
      endInput.addEventListener('input', updateValid);
      addButton.addEventListener('click', addSubsection);
      updateValid();
    });

    document.querySelectorAll('.quran-section-admin').forEach((container) => {
      const positionInput = container.querySelector('.quran-section-position');
      const startInput = container.querySelector('.quran-section-start');
      const endInput = container.querySelector('.quran-section-end');
      const titleInput = container.querySelector('.quran-section-title');
      const addButton = container.querySelector('.quran-section-add');
      const headingId = container.dataset.headingId;

      const setButtonLoading = (loading) => {
        if (!addButton)
          return;
        if (loading) {
          addButton.dataset.originalHtml = addButton.innerHTML;
          addButton.disabled = true;
          addButton.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Adding';
        } else {
          addButton.disabled = false;
          addButton.innerHTML = addButton.dataset.originalHtml || '<span class="bi bi-plus-circle"></span> Add section';
        }
      };

      const getRange = () => ({
        startAyah: parseInt(startInput.value, 10),
        endAyah: parseInt(endInput.value, 10)
      });

      const updateValid = () => {
        const range = getRange();
        const valid = Number.isInteger(range.startAyah) && Number.isInteger(range.endAyah) && range.startAyah > 0 && range.endAyah >= range.startAyah;
        addButton.disabled = !valid;
        container.classList.toggle('is-invalid', !valid);
      };

      const addSection = async () => {
        const range = getRange();
        setButtonLoading(true);
        try {
          const res = await fetch(`/update/${headingId}/toc.sectionAdd`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              value: {
                startAyah: range.startAyah,
                endAyah: range.endAyah,
                title_en: titleInput.value,
                position: positionInput.value
              }
            })
          });
          const body = await res.json();
          if (!res.ok || body.code !== 200)
            throw new Error(body.message || res.statusText);
          if (window.toastr)
            toastr.success(body.value.path, 'Quran section added');
          refreshAfterQuranHeadingUpdate(`/${body.value.path}`);
        } catch (err) {
          if (window.toastr)
            toastr.error(err.message, 'Quran section add failed');
          else
            alert(err.message);
        } finally {
          setButtonLoading(false);
        }
      };

      startInput.addEventListener('input', updateValid);
      endInput.addEventListener('input', updateValid);
      addButton.addEventListener('click', addSection);
      updateValid();
    });

    document.querySelectorAll('.quran-subheading-controls').forEach((container) => {
      const startInput = container.querySelector('.quran-subsection-range-start');
      const endInput = container.querySelector('.quran-subsection-range-end');
      const saveButton = container.querySelector('.quran-subsection-range-save');
      const promoteButton = container.querySelector('.quran-subsection-promote');
      const deleteButton = container.querySelector('.quran-subsection-delete');
      const subsectionId = container.dataset.subsectionId;

      const range = () => ({
        startAyah: parseInt(startInput.value, 10),
        endAyah: parseInt(endInput.value, 10)
      });

      const validRange = () => {
        const next = range();
        return Number.isInteger(next.startAyah) && Number.isInteger(next.endAyah) && next.startAyah > 0 && next.endAyah >= next.startAyah;
      };

      const updateValid = () => {
        saveButton.disabled = !validRange();
        container.classList.toggle('is-invalid', !validRange());
      };

      const setButtonLoading = (button, label, loading) => {
        if (!button)
          return;
        if (loading) {
          button.dataset.originalHtml = button.innerHTML;
          button.disabled = true;
          button.innerHTML = `<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> ${label}`;
        } else {
          button.disabled = false;
          button.innerHTML = button.dataset.originalHtml || button.innerHTML;
        }
      };

      const saveRange = async () => {
        const next = range();
        setButtonLoading(saveButton, '', true);
        try {
          const res = await fetch(`/update/${subsectionId}/toc.subsectionRange`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: next })
          });
          const body = await res.json();
          if (!res.ok || body.code !== 200)
            throw new Error(body.message || res.statusText);
          if (window.toastr)
            toastr.success(`${body.value.start} (${body.value.count} ayahs)`, 'Quran subsection saved');
          refreshAfterQuranHeadingUpdate(`${location.pathname}#S${body.value.h2}-${body.value.h3}`);
        } catch (err) {
          if (window.toastr)
            toastr.error(err.message, 'Quran subsection save failed');
          else
            alert(err.message);
        } finally {
          setButtonLoading(saveButton, '', false);
        }
      };

      const deleteSubsection = async () => {
        if (!window.confirm('Remove this subsection division? The ayahs will remain in the parent section.'))
          return;
        setButtonLoading(deleteButton, '', true);
        try {
          const res = await fetch(`/update/${subsectionId}/toc.subsectionDelete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: '1' })
          });
          const body = await res.json();
          if (!res.ok || body.code !== 200)
            throw new Error(body.message || res.statusText);
          if (window.toastr)
            toastr.success('Ayahs remain in the parent section', 'Quran subsection removed');
          refreshAfterQuranHeadingUpdate(location.pathname);
        } catch (err) {
          if (window.toastr)
            toastr.error(err.message, 'Quran subsection remove failed');
          else
            alert(err.message);
        } finally {
          setButtonLoading(deleteButton, '', false);
        }
      };

      const promoteSubsection = async () => {
        if (!window.confirm('Make this subsection and every following ayah a new section? The current section will end immediately before this subsection.'))
          return;
        setButtonLoading(promoteButton, '', true);
        try {
          const res = await fetch(`/update/${subsectionId}/toc.subsectionPromote`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: '1' })
          });
          const body = await res.json();
          if (!res.ok || body.code !== 200)
            throw new Error(body.message || res.statusText);
          if (window.toastr)
            toastr.success(body.value.path, 'Quran subsection promoted');
          refreshAfterQuranHeadingUpdate(`/${body.value.path}`);
        } catch (err) {
          if (window.toastr)
            toastr.error(err.message, 'Quran subsection promote failed');
          else
            alert(err.message);
        } finally {
          setButtonLoading(promoteButton, '', false);
        }
      };

      startInput.addEventListener('input', updateValid);
      endInput.addEventListener('input', updateValid);
      saveButton.addEventListener('click', saveRange);
      promoteButton.addEventListener('click', promoteSubsection);
      deleteButton.addEventListener('click', deleteSubsection);
      updateValid();
    });
  </script>
  <% } %>
  
</body>

</html>
