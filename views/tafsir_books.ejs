<!doctype html>
<html lang="en">
<head>
<%
    var site = Object.assign({}, global.settings.site);
    site.admin = (!locals.noadmin && req.admin);
    if (!locals.noadmin)
      site.editMode = (site.admin && req.editMode);
    else
      site.editMode = false;
    site.name = 'Quran Unlocked';
    site.shortName = 'Quran';

    var page = {
      menu: 'Books',
      title_en: `Quran | Tafsīr Books`,
      subtitle_en: `Tafsīr Books`,
      subtitle: ``,
      canonical: `/quran/tafsir`,
      context: {
        quranSearchProxy: true
      }
    };
    var tafsirBrowseUrl = function (tafsir) {
      return utils.quranUrl(req, Tafsir.browseUrl(tafsir, tafsir.firstSurah || 1, tafsir.firstAyah || 1, tafsirs));
    };
    var tafsirDeathLabel = function (tafsir) {
      var death = utils.emptyIfNull(tafsir.death || '').toString().trim();
      if (!death)
        return '';
      if (!/\b(?:AH|H)\b/i.test(death) && !/هـ/u.test(death))
        death = `${death} AH`;
      return /^d\./i.test(death) ? death : `d. ${death}`;
    };
    var tafsirArabicDeathLabel = function (tafsir) {
      var death = utils.emptyIfNull(tafsir.death || '').toString().trim();
      if (!death)
        return '';
      death = death.replace(/\b(?:AH|H)\b/ig, '').replace(/هـ/u, '').trim();
      return `ت. ${death} هـ`;
    };
    var commentaryPublicationLabel = function (book) {
      return [
        book && book.published_year ? `Pub. ${book.published_year}` : '',
        book && book.publisher ? book.publisher : ''
      ].filter(Boolean).join(', ');
    };
    var tafsirDeathYear = function (tafsir) {
      var match = utils.emptyIfNull(tafsir.death || '').toString().match(/\d+/);
      return match ? Number(match[0]) : NaN;
    };
    var tafsirPublishedYear = function (tafsir) {
      var match = utils.emptyIfNull(tafsir.published_year || '').toString().match(/\d+/);
      return match ? Number(match[0]) : NaN;
    };
    var tafsirSortName = function (tafsir) {
      return tafsir.shortName_en || tafsir.name_en || tafsir.shortName || tafsir.name || tafsir.alias || '';
    };
    var groups = [
      { key: 'en', lang: 'en', heading: 'English Tafāsīr' },
      { key: 'ar', lang: 'ar', heading: 'Arabic Tafāsīr' }
    ].map(function (group) {
      group.tafsirs = (tafsirs || []).filter(function (tafsir) {
        return tafsir.lang === group.lang;
      }).sort(function (a, b) {
        var aDeath = tafsirDeathYear(a);
        var bDeath = tafsirDeathYear(b);
        var aHasDeath = Number.isFinite(aDeath) && aDeath > 0;
        var bHasDeath = Number.isFinite(bDeath) && bDeath > 0;
        if (aHasDeath && bHasDeath && aDeath !== bDeath)
          return aDeath - bDeath;
        if (aHasDeath !== bHasDeath)
          return aHasDeath ? -1 : 1;
        if (!aHasDeath && !bHasDeath) {
          var aPublished = tafsirPublishedYear(a);
          var bPublished = tafsirPublishedYear(b);
          var aHasPublished = Number.isFinite(aPublished) && aPublished > 0;
          var bHasPublished = Number.isFinite(bPublished) && bPublished > 0;
          if (aHasPublished && bHasPublished && aPublished !== bPublished)
            return bPublished - aPublished;
          if (aHasPublished !== bHasPublished)
            return aHasPublished ? -1 : 1;
        }
        return tafsirSortName(a).localeCompare(tafsirSortName(b));
      });
      return group;
    });
    var tafsirSectionHeading = function (id, heading) {
      return `
        <h2 class="h4 mb-3">
          <button class="book-catalog-section-toggle tafsir-book-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#${id}" aria-expanded="true" aria-controls="${id}">
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
            <span>${heading}</span>
          </button>
        </h2>
      `;
    };
    var htmlToPlainText = function (value) {
      return utils.emptyIfNull(value || '')
        .toString()
        .replace(/<[^>]*>/g, ' ')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/[*_`#>]+/g, '')
        .replace(/\s+/g, ' ')
        .trim();
    };
    var tafsirDescriptionPreview = function (description) {
      return htmlToPlainText(description.split(/\r?\n/).map(function (line) {
        return line.trim();
      }).find(Boolean) || description);
    };
    var tafsirDescriptionId = function (group, tafsir) {
      return `tafsir-book-description-${group.key}-${utils.emptyIfNull(tafsir.alias || '').replace(/[^A-Za-z0-9_-]+/g, '-')}`;
    };
    var tafsirSizeLabel = function (tafsir) {
      var size = utils.emptyIfNull(tafsir && tafsir.size || '').toString();
      if (size === 'lg')
        return 'Large tafsir';
      if (size === 'md')
        return 'Medium tafsir';
      if (size === 'sm')
        return 'Small tafsir';
      return '';
    };
    var tafsirSizeIndicator = function (tafsir) {
      var size = utils.emptyIfNull(tafsir && tafsir.size || '').toString();
      var label = tafsirSizeLabel(tafsir);
      if (!label)
        return '';
      return `<span class="tafsir-size-indicator tafsir-size-tooltip tafsir-size-indicator-${size}" title="${label}" data-tafsir-size-tooltip="${label}" aria-label="${label}" role="img"></span>`;
    };
%>

<%- include('sub-views/head.ejs', { site: site, page: page }); %>
</head>
<body>

  <%- include('sub-views/header.ejs', { site: site, page: page }); %>

  <div class="container col-lg-8 mx-auto">
    <main>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Table",
          "name" : "Available Books of Tafsīr",
          "about": "Available Books of Tafsīr"
        }
      </script>

      <div class="page-content-filter input-group mb-3">
        <span class="input-group-text bi bi-filter" aria-hidden="true"></span>
        <input type="search" class="form-control tafsir-book-filter" placeholder="Filter tafsīr books" aria-label="Filter tafsīr books" autocomplete="off" autofocus>
      </div>

      <% groups.forEach(function (group) { %>
        <section class="mb-4 tafsir-book-section">
          <% var sectionId = `tafsir-book-section-${group.key}`; %>
          <%- tafsirSectionHeading(sectionId, group.heading) %>
          <div id="<%= sectionId %>" class="collapse show tafsir-book-section-body">
          <% if (group.tafsirs.length < 1) { %>
            <p class="text-muted">No <%= group.heading.toLowerCase() %> are currently available.</p>
          <% } else { %>
	            <div class="tafsir-book-list">
	              <% group.tafsirs.forEach(function (tafsir) { %>
	                <%
	                  var descriptionMarkdown = utils.emptyIfNull(tafsir.description || '');
	                  var descriptionHtml = utils.markdownToHtml(descriptionMarkdown);
	                  var descriptionPreview = tafsirDescriptionPreview(descriptionMarkdown);
	                  var descriptionId = tafsirDescriptionId(group, tafsir);
	                  var descriptionKey = `${descriptionId}-body`;
	                  var browseUrl = tafsirBrowseUrl(tafsir);
	                  var editableBookId = tafsir.id || '';
	                %>
	                <article class="tafsir-book-card tafsir-book-row" data-tafsir-book-filter="<%= [
	                  tafsir.alias,
	                  tafsir.name_en,
	                  tafsir.shortName_en,
	                  tafsir.author_en,
	                  tafsir.name,
	                  tafsir.shortName,
	                  tafsir.author,
	                  tafsir.published_year,
	                  tafsir.publisher,
	                  tafsir.description
	                ].filter(Boolean).join(' ').toLowerCase() %>">
	                  <div class="tafsir-book-row-main">
	                    <div class="tafsir-book-title-pair">
	                      <h3 class="tafsir-book-title-line mb-0">
	                        <% if (site.editMode) { %>
	                          <span class="_e" data-id="<%= editableBookId %>" data-prop="commentary_book.shortName_en"><%- tafsir.shortName_en || tafsir.name_en || tafsir.alias %></span>
	                        <% } else { %>
	                          <a href="<%= browseUrl %>"><%- tafsir.shortName_en || tafsir.name_en || tafsir.alias %></a>
	                        <% } %><%- tafsirSizeIndicator(tafsir) %>
	                      </h3>
	                      <% if (site.editMode || tafsir.shortName || tafsir.name) { %>
	                        <h3 class="tafsir-book-title-line mb-0" lang="ar" dir="rtl">
	                          <% if (site.editMode) { %>
	                            <span class="_e" data-id="<%= editableBookId %>" data-prop="commentary_book.shortName"><%- tafsir.shortName || tafsir.name || '' %></span>
	                          <% } else { %>
	                            <a href="<%= browseUrl %>"><%- tafsir.shortName || tafsir.name || '' %></a>
	                          <% } %>
	                        </h3>
	                      <% } %>
	                    </div>
	                    <% if (site.editMode || tafsir.name_en || tafsir.name) { %>
	                      <div class="tafsir-book-full-name">
	                        <div <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="commentary_book.name_en"<% } %>><%- tafsir.name_en || tafsir.name || '' %></div>
	                        <% if (site.editMode || tafsir.name) { %>
	                          <div lang="ar" dir="rtl" <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="commentary_book.name"<% } %>><%- tafsir.name %></div>
	                        <% } %>
	                      </div>
	                    <% } %>
	                    <div class="tafsir-book-meta text-muted">
	                      <% if (site.editMode || tafsir.author_en || tafsirDeathLabel(tafsir)) { %>
	                        <div>
	                          <span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="commentary_book.author_en"<% } %>><%- tafsir.author_en || tafsir.author || '' %></span>
	                          <% if (site.editMode || tafsirDeathLabel(tafsir)) { %>
	                            <span>(<span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="commentary_book.death"<% } %>><%- site.editMode ? tafsir.death : tafsirDeathLabel(tafsir) %></span>)</span>
	                          <% } %>
	                        </div>
	                      <% } %>
	                      <% if (site.editMode || tafsir.author || tafsirArabicDeathLabel(tafsir)) { %>
	                        <div lang="ar" dir="rtl">
	                          <span <% if (site.editMode) { %>class="_e" data-id="<%= editableBookId %>" data-prop="commentary_book.author"<% } %>><%- tafsir.author || tafsir.author_en || '' %></span>
	                          <% if (tafsirArabicDeathLabel(tafsir)) { %>
	                            <span>(<%- tafsirArabicDeathLabel(tafsir) %>)</span>
	                          <% } %>
	                        </div>
	                      <% } %>
	                    </div>
	                    <% if (site.editMode) { %>
	                      <div id="<%= descriptionId %>" class="toc-book-description-full tafsir-book-description-full">
	                        <div class="_e tafsir-book-description-editor" data-id="<%= editableBookId %>" data-prop="commentary_book.description" data-edit-format="md" data-markdown-source="<%= descriptionMarkdown %>" data-markdown-empty-html="&hellip;"><%- descriptionHtml || '&hellip;' %></div>
	                      </div>
	                    <% } else if (descriptionPreview || descriptionHtml) { %>
	                      <button type="button" class="toc-book-description-summary tafsir-book-description-summary text-muted text-start" data-toc-description-summary="<%= descriptionKey %>" data-toc-description-expand="<%= descriptionKey %>" aria-expanded="false" aria-controls="<%= descriptionId %>">
	                        <span class="toc-book-description-preview"><%= descriptionPreview %></span>
	                        <span class="tafsir-book-description-more">More...</span>
	                      </button>
	                      <div id="<%= descriptionId %>" class="toc-book-description-full tafsir-book-description-full d-none" data-toc-description-full="<%= descriptionKey %>">
	                        <%- descriptionHtml %>
	                      </div>
	                    <% } %>
	                    <% if (site.editMode || commentaryPublicationLabel(tafsir)) { %>
	                      <small class="tafsir-book-publication text-muted">
	                        <% if (site.editMode) { %>
	                          Pub. <span class="_e" data-id="<%= editableBookId %>" data-prop="commentary_book.published_year"><%- tafsir.published_year || '' %></span>, <span class="_e" data-id="<%= editableBookId %>" data-prop="commentary_book.publisher"><%- tafsir.publisher || '' %></span>
	                        <% } else { %>
	                          <%- commentaryPublicationLabel(tafsir) %>
	                        <% } %>
	                      </small>
	                    <% } %>
	                    <% if (site.editMode) { %>
	                      <div class="tafsir-book-admin-fields text-muted">
	                        <label>Size
	                          <select class="_e form-select form-select-sm" data-id="<%= editableBookId %>" data-prop="commentary_book.size">
	                            <option value="" <%= !tafsir.size ? 'selected' : '' %>></option>
	                            <option value="sm" <%= tafsir.size === 'sm' ? 'selected' : '' %>>Small</option>
	                            <option value="md" <%= tafsir.size === 'md' ? 'selected' : '' %>>Medium</option>
	                            <option value="lg" <%= tafsir.size === 'lg' ? 'selected' : '' %>>Large</option>
	                          </select>
	                        </label>
	                        <label>Aqidah
	                          <span class="_e" data-id="<%= editableBookId %>" data-prop="commentary_book.aqidah"><%- tafsir.aqidah || '' %></span>
	                        </label>
	                      </div>
	                    <% } %>
	                  </div>
	                </article>
	              <% }); %>
            </div>
          <% } %>
          </div>
        </section>
      <% }); %>
      <p class="text-muted d-none tafsir-book-filter-empty">No matching tafsīr books found.</p>
    </main>
  </div>

<%- include('sub-views/footer.ejs', { site: site, page: page }); %>
<%- include('sub-views/scripts.ejs', { site: site, page: page }); %>
<script>
  (function () {
    var filter = document.querySelector('.tafsir-book-filter');
    if (!filter)
      return;
    filter.focus();
    var normalize = function (value) {
      return (value || '').toString().toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '').trim();
    };
    var cards = Array.from(document.querySelectorAll('.tafsir-book-card'));
    var sections = Array.from(document.querySelectorAll('.tafsir-book-section'));
    var empty = document.querySelector('.tafsir-book-filter-empty');
    filter.addEventListener('input', function () {
      var query = normalize(filter.value);
      var visibleCount = 0;
      cards.forEach(function (card) {
        var match = !query || normalize(card.dataset.tafsirBookFilter).includes(query);
        card.classList.toggle('d-none', !match);
        if (match)
          visibleCount += 1;
      });
      sections.forEach(function (section) {
        var hasVisibleCard = Array.from(section.querySelectorAll('.tafsir-book-card')).some(function (card) {
          return !card.classList.contains('d-none');
        });
        section.classList.toggle('d-none', !hasVisibleCard && !!query);
        if (query && hasVisibleCard) {
          var sectionBody = section.querySelector('.tafsir-book-section-body');
          var sectionToggle = section.querySelector('.tafsir-book-section-toggle');
          if (sectionBody)
            sectionBody.classList.add('show');
          if (sectionToggle)
            sectionToggle.setAttribute('aria-expanded', 'true');
        }
      });
      if (empty)
        empty.classList.toggle('d-none', visibleCount > 0 || !query);
    });
  })();
</script>

</body>
</html>
