{
  "name": "hadithdb",
  "version": "1.0.0",
  "description": "Express app and database tooling for the HadithDB project.",
  "private": true,
  "main": "app.js",
  "scripts": {
    "start": "node -r dotenv/config -r newrelic ./bin/www",
    "dev": "nodemon --exec \"node -r dotenv/config -r newrelic\" ./bin/www",
    "test": "jest",
    "build:knowledge": "node ./bin/buildHadithKnowledge.js",
    "build:commentaries-index": "node ./bin/buildCommentariesIndex.js",
    "import:quran-mushaf": "node ./bin/importQuranMushaf.js",
    "migrate:books:mongo": "node ./bin/migrateBooksToMongo.js",
    "update:hadith-translation-availability": "node ./bin/updateHadithTranslationAvailability.js",
    "update:hadith-translation-view": "node ./bin/updateHadithTranslationIndexView.js"
  },
  "keywords": [
    "hadith",
    "quran",
    "blog"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iadnanmukhtar/hadithdb.git"
  },
  "bugs": {
    "url": "https://github.com/iadnanmukhtar/hadithdb/issues"
  },
  "homepage": "https://github.com/iadnanmukhtar/hadithdb#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "0.5.14",
    "axios": "1.7.2",
    "body-parser": "1.20.2",
    "cheerio": "1.0.0-rc.12",
    "cookie-parser": "1.4.6",
    "debug": "4.3.5",
    "dotenv": "16.4.5",
    "ejs": "3.1.10",
    "express": "^4.20.0",
    "express-rate-limit": "7.3.1",
    "fast-csv": "5.0.1",
    "front-matter": "4.0.2",
    "google-auth-library": "^9.15.1",
    "http-errors": "2.0.0",
    "markdown-it": "14.1.0",
    "markdown-it-attrs": "4.1.6",
    "markdown-it-bracketed-spans": "1.0.1",
    "markdown-it-fence": "0.1.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-obsidian-images": "1.0.1",
    "markdown-it-toc": "1.1.0",
    "markdown-it-wikilinks": "1.4.0",
    "marked": "^13.0.2",
    "marked-bidi": "^1.0.10",
    "mongodb": "6.20.0",
    "mysql": "2.18.1",
    "natural": "^7.1.0",
    "newrelic": "^14.1.0",
    "nodemailer": "^6.9.14",
    "request-ip": "3.3.0",
    "sqlite3": "^5.1.7",
    "string-similarity": "4.0.4",
    "stripe": "^22.3.0",
    "sync-request": "6.1.0"
  },
  "devDependencies": {
    "@openai/codex": "^0.139.0",
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "nodemon": "^3.1.4",
    "playwright": "^1.60.0"
  },
  "allowScripts": {
    "protobufjs@7.6.4": true,
    "github:jsepia/reurl#a3210117636c115fb139517fcfb2ea929025cded": true,
    "sqlite3@5.1.7": true,
    "@datadog/pprof@5.15.0": true,
    "fsevents@2.3.3": true
  }
}
